# --- Caddy / TLS ------------------------------------------------------
TUN_SITE_ADDRESS=tun.example.net      # bare hostname => automatic HTTPS; ":8080" for local testing over plain HTTP
TUN_PUBLIC_BASE=https://tun.example.net
OTA_TOKEN=<openssl rand -hex 32>      # bootstrap token baked into the APK

# --- Postgres (hub + builder's shared schema) --------------------------
POSTGRES_PASSWORD=<a password for the mjolnir postgres user>
# --- hub-builder-ooperator auth-----------
# Required in practt it, /mjolnir/* and
# /builder/* are rehe hostname. Typethis in
# at /mjolnir/loginbrowser.
OPERATOR_AUTH_TOKEN=<a long random token>

# --- builder -> stits own bearer token)
----
STABBUR_BASE_URL=ht wherever stabbur is
reachable from this
STABBUR_AUTH_TOKEN=<stabbur's shared bearer token — same value
stabbur's own .env

# --- hub: optionals page's "open note"
link
STABBUR_UI_BASE=htt

# --- local/dev onlPS-----------------------
# ALLOW_HTTP=1
# ALLOW_NO_COMPANION=1
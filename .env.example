# --- Caddy / TLS ------------------------------------------------------
TUN_SITE_ADDRESS=tun.example.net      # bare hostname => automatic HTTPS; ":8080" for local testing over plain HTTP
TUN_PUBLIC_BASE=https://tun.example.net
OTA_TOKEN=<openssl rand -hex 32>      # bootstrap token baked into the APK

# --- Postgres (hub + builder's shared schema) --------------------------
POSTGRES_PASSWORD=<a password for the mjolnir postgres user>

# --- hub-builder-operator-console: D-H6 shared operator token ----------
# Required in practice for a real deploy: without it, /mjolnir/* and
# /builder/* are reachable by anyone who finds the host — set a real value
# and enter it once per browser at /mjolnir/login and /builder/login.
OPERATOR_AUTH_TOKEN=<a long random token>

# --- builder -> stabbur (D85: stabbur requires a bearer token on every ---
# path except /ui and /blob/*, same shared-token middleware as smia)
# This is builder's own OUTBOUND fetch target (pullNotes/pullGrammarRules) —
# it must be reachable from INSIDE the builder container, not from a
# browser. Use the same value/network as STABBUR_UPSTREAM below (e.g.
# "http://backend:5056" via the tun-shared network) — do NOT put a public
# hostname here just because that's what a browser would use; that's
# STABBUR_UI_BASE's job, immediately below, and the two are not
# interchangeable (confirmed: setting this to a browser-facing URL like
# "https://localhost" causes ECONNREFUSED from inside the container on
# every scheduled run).
STABBUR_BASE_URL=http://backend:5056
STABBUR_AUTH_TOKEN=<stabbur's shared bearer token — STABBUR_AUTH_TOKEN in stabbur's own .env>

# --- hub: only used to build the Cards page's "open note" link, which a
# human clicks in their own browser — this MUST be the public URL through
# Caddy's /stabbur/* route (STABBUR_UPSTREAM/STABBUR_BASE_URL's Docker
# service name is meaningless to a browser). Without it, links are simply
# omitted — not a required var.
STABBUR_UI_BASE=https://stabbur.example.net/ui

# --- Caddy -> stabbur (the /stabbur/* UI proxy, caddy/Caddyfile) --------
# Pick exactly one, matching how stabbur is actually deployed relative to
# this stack — see caddy/Caddyfile's own comment on this var for the full
# reasoning. No safe default; an unset value fails the caddy container
# loudly at startup rather than silently 502ing every /stabbur/* request.
#   STABBUR_UPSTREAM=backend:5056   # RECOMMENDED: two independent `docker
#                                   # compose up` stacks, joined by the
#                                   # shared `tun-shared` external network
#                                   # (see this file's compose.yaml) — run
#                                   # `docker network create tun-shared`
#                                   # once, before bringing either stack up.
#                                   # Same value, no extra setup, if deployed
#                                   # via tun/compose.yaml's `include:` (D94).
#   STABBUR_UPSTREAM=host.docker.internal:5056  # fallback: stabbur's own
#                                   # stack, no shared network, reached via
#                                   # its host-published port. Depends on
#                                   # the host's NAT/hairpin routing, which
#                                   # is not reliable everywhere.
#   STABBUR_UPSTREAM=stabbur.example.net:443    # stabbur deployed elsewhere
STABBUR_UPSTREAM=backend:5056

# --- local/dev only — never set either on the VPS -----------------------
# ALLOW_HTTP=1
# ALLOW_NO_COMPANION=1

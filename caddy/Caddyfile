# mjolnir — the only thing the phone talks to (D84: single deployable
# stack, owned entirely by this repo — `tun` ships no deployable artifacts).
#
# P1 serves everything device-facing straight off disk (D55). Python/Node is
# never in the path of the 6 MB bundle or the audio blobs.
#
# Frozen-contract rules enforced here — see tun/docs/11-ota-contract.md:
#   D49  gzip is TRANSPORT-level only. sha256/size in current.json describe
#        the UNCOMPRESSED bundle. Never serve a pre-gzipped file as an opaque
#        body: the hash would never match and native can never be fixed.
#   P23  the /ota/* token is GET-only.
#   D26  rollback = rewriting current.json. So it must never be cached.
#
# No global options block: `email` with an empty value is a parse error, and
# Let's Encrypt does not require one. To get expiry warnings, add by hand:
#     { email you@example.net }

{$TUN_SITE_ADDRESS} {
	log {
		output stdout
		format console
	}

	encode gzip

	# ---- /ota/* : token-gated, read-only -------------------------------
	handle /ota/* {
		@bad_token not header Authorization "Bearer {$OTA_TOKEN}"
		respond @bad_token "unauthorized" 401 {
			close
		}

		@not_read not method GET HEAD
		respond @not_read "method not allowed" 405 {
			close
		}

		# Rollback must take effect on the next launch, never later.
		header /ota/current.json Cache-Control "no-store"

		# A buildId is permanent and its bundle is immutable.
		header /ota/bundle/* Cache-Control "public, max-age=31536000, immutable"

		root * /srv
		# No `precompressed`: D49 requires transport-level gzip only, so the
		# body native hashes is always the uncompressed bundle.
		file_server
	}

	# ---- /blob/<sha256> : content-addressed, immutable ------------------
	# Unguessable by construction; the hash in the url IS the capability.
	handle /blob/* {
		@not_read not method GET HEAD
		respond @not_read "method not allowed" 405 {
			close
		}
		header Cache-Control "public, max-age=31536000, immutable"
		root * /srv
		file_server
	}

	# ---- service UIs, mounted as each is written (D46) ------------------
	# D-H6: uncommented only after the shared-bearer-token auth check on
	# both services was verified working (task 7.3) — never the other way
	# around. Both services 401/redirect-to-/login on their own for any
	# request without a valid token or cookie; Caddy adds nothing auth-wise
	# here, it only routes.
	#
	# MUST be `handle` blocks, not bare `reverse_proxy` directives. Every
	# other route in this file (/ota, /blob, /stabbur, the final catch-all)
	# is a `handle` block, and Caddy sequences all `handle` blocks together,
	# first-match-wins, in the order written. A bare directive mixed into a
	# file that otherwise uses `handle` throughout does NOT slot into that
	# same sequence — Caddy's global default directive ordering places
	# `reverse_proxy` after the `handle` group regardless of where it's
	# written in the file, so it silently never runs: the unconditional
	# `handle {}` catch-all at the end matches every request first and the
	# bare `reverse_proxy` lines are unreachable. Confirmed via
	# `caddy adapt --adapter caddyfile`: a bare `reverse_proxy /mjolnir/*`
	# compiled to route index 6, two full positions after the catch-all's
	# index 4 — every request to /mjolnir/* or /builder/* 404'd before this
	# fix, regardless of path (bare, trailing-slash, or deep).
	#
	# Two path patterns per block, not one: Caddy's `/mjolnir/*` matcher
	# requires the literal "/" before the wildcard, so it does NOT match the
	# bare path a person actually types (`/mjolnir`, no trailing slash) —
	# only `/mjolnir/` and anything deeper. hub's own route handler already
	# treats both forms as equivalent (`url.pathname === "/mjolnir" ||
	# url.pathname === "/mjolnir/"`); without the bare pattern here, that
	# branch of hub's code is simply unreachable from outside the container.
	@mjolnir path /mjolnir /mjolnir/*
	handle @mjolnir {
		reverse_proxy mjolnir-hub:8000
	}
	@builder path /builder /builder/*
	handle @builder {
		reverse_proxy mjolnir-builder:8001
	}

	# stabbur serves its own routes (/ui, /api/*, /blob/*, /blobs) unprefixed
	# — handle_path strips /stabbur before forwarding, so stabbur's own code
	# never needs to know the prefix exists. X-Forwarded-Prefix tells
	# stabbur's /ui page what prefix the browser is actually using, so it
	# can template its own asset/API URLs to match (app.py's ui_index()).
	#
	# The upstream is configurable, not hardcoded, because this repo's own
	# compose.yaml is deployable more than one way (D94), and a bare Docker
	# service name only resolves when both stacks share a network. Set
	# STABBUR_UPSTREAM in .env to whichever applies — in order of preference:
	#   - "backend:5056"  — RECOMMENDED, verified working. Two fully
	#     independent `docker compose up` stacks, joined by one shared
	#     external network (`tun-shared` in compose.yaml, both this
	#     service and stabbur's `backend` service attached to it — one
	#     `docker network create tun-shared` the first time, nothing else
	#     changes about either stack). This is what "run two docker
	#     compose, configure .env of both" actually resolves to.
	#   - "backend:5056"  — same value when deployed via tun's `include:`
	#     instead (D94), but NOT "no extra setup": `include:` cannot clear
	#     an included file's `external: true` network declaration back off
	#     (confirmed, D104), so the one-time `docker network create
	#     tun-shared` is still required under this mode too.
	#   - "host.docker.internal:5056" — stabbur's own stack, no shared
	#     network, reached via its host-published port instead (needs the
	#     caddy service's extra_hosts entry below). Depends on the host's
	#     NAT/hairpin routing actually reaching a published port from a
	#     bridge network, which is not reliable in every environment —
	#     confirmed to fail inside at least one nested-Docker sandbox.
	#     Fall back to this only if joining a shared network isn't an option.
	#   - a real hostname/IP — stabbur deployed elsewhere entirely.
	# `handle_path` needs a single literal prefix to strip, so it can't take
	# the two-pattern form `handle`/`@matcher` above use for the bare-path
	# case — there's nothing meaningful to strip from a bare `/stabbur`
	# anyway. Redirect it to the trailing-slash form instead, which
	# `handle_path /stabbur/*` already matches correctly.
	redir /stabbur /stabbur/ 308
	handle_path /stabbur/* {
		reverse_proxy {$STABBUR_UPSTREAM} {
			header_up X-Forwarded-Prefix /stabbur
		}
	}
	# reverse_proxy /smia/*    smia:8000
	# reverse_proxy /phonexa/* phonexa:8000

	# ---- /adminer : tun/compose.yaml's shared Adminer (D-T3) -------------
	# Only reachable this way when deployed via tun's `include:` unification
	# (D94/D101) — that's the only compose file defining a service literally
	# named "adminer"; mjolnir's own compose.yaml does not, so this route
	# simply 502s (same as /stabbur above when stabbur isn't up) under any
	# other deployment mode. `handle_path` strips the prefix before
	# forwarding, same reasoning as /stabbur above: Adminer generates its
	# own links relative to wherever it's mounted and has no equivalent of
	# stabbur's X-Forwarded-Prefix handling, so it must see itself as
	# mounted at "/", not "/adminer".
	#
	# No auth here, same as today's direct `8082:8080` host port mapping in
	# tun/compose.yaml (D-H6's OPERATOR_AUTH_TOKEN gates hub/builder, not
	# this) — this route is a path convenience, not a new exposure. Add a
	# Caddy `basicauth` block here (or drop the 8082 port mapping) if the
	# bare port is meant to go away too.
	redir /adminer /adminer/ 308
	handle_path /adminer/* {
		reverse_proxy adminer:8080
	}

	handle {
		respond "mjolnir" 404
	}
}

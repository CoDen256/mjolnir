,{Card:"C16019N",P:"N"},{Card:"C16020N",P:"N"},{Card:"C16007E",P:"N"},{Card:"C16021N",P:"N"},{Card:"C16008E",P:"N"},{Card:"C16022N",P:"N"},{Card:"C16023N",P:"N"},{Card:"C16009E",P:"N"},{Card:"C16024N",P:"N"},{Card:"C16010E",P:"N"},{Card:"C16025N",P:"N"},{Card:"C16026N",P:"N"},{Card:"C16011E",P:"N"},{Card:"C16027N",P:"N"},{Card:"C16012E",P:"N"},{Card:"C16028N",P:"N"},{Card:"C16029N",P:"N"},{Card:"C16013E",P:"N"},{Card:"C16030N",P:"N"},{Card:"C16014E",P:"N"},{Card:"C16031N",P:"N"},{Card:"C16032N",P:"N"},{Card:"C16015E",P:"N"},{Card:"C16033N",P:"N"},{Card:"C16016E",P:"N"},{Card:"C16034N",P:"N"},{Card:"C16035N",P:"N"},{Card:"C16017E",P:"N"},{Card:"C16036N",P:"N"},{Card:"C16018E",P:"N"},{Card:"C16037N",P:"N"},{Card:"C16038N",P:"N"},{Card:"C16019E",P:"N"},{Card:"C16039N",P:"N"},{Card:"C16020E",P:"N"},{Card:"C16040N",P:"N"},{Card:"C16041N",P:"N"},{Card:"C16021E",P:"N"},{Card:"C16042N",P:"N"},{Card:"C16022E",P:"N"},{Card:"C16043N",P:"N"},{Card:"C16044N",P:"N"},{Card:"C16023E",P:"N"},{Card:"C16045N",P:"N"},{Card:"C16024E",P:"N"},{Card:"C16046N",P:"N"},{Card:"C16047N",P:"N"},{Card:"C16025E",P:"N"},{Card:"C16048N",P:"N"},{Card:"C16026E",P:"N"},{Card:"C16049N",P:"N"},{Card:"C16050N",P:"N"},{Card:"C16027E",P:"N"},{Card:"C16028E",P:"N"},{Card:"C16029E",P:"N"},{Card:"C16030E",P:"N"},{Card:"C16031E",P:"N"},{Card:"C16032E",P:"N"},{Card:"C16033E",P:"N"},{Card:"C16034E",P:"N"},{Card:"C16035E",P:"N"},{Card:"C16036E",P:"N"},{Card:"C16037E",P:"N"},{Card:"C16038E",P:"N"},{Card:"C16039E",P:"N"},{Card:"C16040E",P:"N"},{Card:"C16041E",P:"N"},{Card:"C16042E",P:"N"},{Card:"C16043E",P:"N"},{Card:"C16044E",P:"N"},{Card:"C16045E",P:"N"},{Card:"C16046E",P:"N"},{Card:"C16047E",P:"N"},{Card:"C16048E",P:"N"},{Card:"C16049E",P:"N"},{Card:"C16050E",P:"N"}]},{ID:43,PullCounter:0,Name:"C17",Code:"17",Enabled:!0,Title:"IT Literacy & Numeracy",Description:"TEASER: Here is a variety of terms related to IT literacy, which is very important given how much technology we use. It is also useful for all the jobs that rely on using computers.",Counter1:"50 cards",Counter2:"<b>\xd72</b> (front, back)",MaxInterval:10,AutoTickStreak:1,AutoHammerCount:2,Cards:[{Card:"C17001N",P:"N"},{Card:"C17002N",P:"N"},{Card:"C17003N",P:"N"},{Card:"C17004N",P:"N"},{Card:"C17005N",P:"N"},{Card:"C17006N",P:"N"},{Card:"C17007N",P:"N"},{Card:"C17008N",P:"N"},{Card:"C17009N",P:"N"},{Card:"C17010N",P:"N"},{Card:"C17011N",P:"N"},{Card:"C17001E",P:"N"},{Card:"C17012N",P:"N"},{Card:"C17002E",P:"N"},{Card:"C17013N",P:"N"},{Card:"C17014N",P:"N"},{Card:"C17003E",P:"N"},{Card:"C17015N",P:"N"},{Card:"C17004E",P:"N"},{Card:"C17016N",P:"N"},{Card:"C17017N",P:"N"},{Card:"C17005E",P:"N"},{Card:"C17018N",P:"N"},{Card:"C17006E",P:"N"},{Card:"C17019N",P:"N"},{Card:"C17020N",P:"N"},{Card:"C17007E",P:"N"},{Card:"C17021N",P:"N"},{Card:"C17008E",P:"N"},{Card:"C17022N",P:"N"},{Card:"C17023N",P:"N"},{Card:"C17009E",P:"N"},{Card:"C17024N",P:"N"},{Card:"C17010E",P:"N"},{Card:"C17025N",P:"N"},{Card:"C17026N",P:"N"},{Card:"C17011E",P:"N"},{Card:"C17027N",P:"N"},{Card:"C17012E",P:"N"},{Card:"C17028N",P:"N"},{Card:"C17029N",P:"N"},{Card:"C17013E",P:"N"},{Card:"C17030N",P:"N"},{Card:"C17014E",P:"N"},{Card:"C17031N",P:"N"},{Card:"C17032N",P:"N"},{Card:"C17015E",P:"N"},{Card:"C17033N",P:"N"},{Card:"C17016E",P:"N"},{Card:"C17034N",P:"N"},{Card:"C17035N",P:"N"},{Card:"C17017E",P:"N"},{Card:"C17036N",P:"N"},{Card:"C17018E",P:"N"},{Card:"C17037N",P:"N"},{Card:"C17038N",P:"N"},{Card:"C17019E",P:"N"},{Card:"C17039N",P:"N"},{Card:"C17020E",P:"N"},{Card:"C17040N",P:"N"},{Card:"C17041N",P:"N"},{Card:"C17021E",P:"N"},{Card:"C17042N",P:"N"},{Card:"C17022E",P:"N"},{Card:"C17043N",P:"N"},{Card:"C17044N",P:"N"},{Card:"C17023E",P:"N"},{Card:"C17045N",P:"N"},{Card:"C17024E",P:"N"},{Card:"C17046N",P:"N"},{Card:"C17047N",P:"N"},{Card:"C17025E",P:"N"},{Card:"C17048N",P:"N"},{Card:"C17026E",P:"N"},{Card:"C17049N",P:"N"},{Card:"C17050N",P:"N"},{Card:"C17027E",P:"N"},{Card:"C17028E",P:"N"},{Card:"C17029E",P:"N"},{Card:"C17030E",P:"N"},{Card:"C17031E",P:"N"},{Card:"C17032E",P:"N"},{Card:"C17033E",P:"N"},{Card:"C17034E",P:"N"},{Card:"C17035E",P:"N"},{Card:"C17036E",P:"N"},{Card:"C17037E",P:"N"},{Card:"C17038E",P:"N"},{Card:"C17039E",P:"N"},{Card:"C17040E",P:"N"},{Card:"C17041E",P:"N"},{Card:"C17042E",P:"N"},{Card:"C17043E",P:"N"},{Card:"C17044E",P:"N"},{Card:"C17045E",P:"N"},{Card:"C17046E",P:"N"},{Card:"C17047E",P:"N"},{Card:"C17048E",P:"N"},{Card:"C17049E",P:"N"},{Card:"C17050E",P:"N"}]}]},2111,[]);
__d(function(g,r,i,a,m,e,d){var t=r(d[0]);Object.defineProperty(e,"__esModule",{value:!0}),e.default=void 0;var u=t(r(d[1])),n=t(r(d[2])),s=t(r(d[3])),f=new((function(){return(0,n.default)(function t(){(0,u.default)(this,t),this.cards=this.indexById(s.default)},[{key:"indexById",value:function(t){var u={};for(var n of t)n.ID&&(u[n.ID]=n);return u}},{key:"getCard",value:function(t){return 6==t.length?this.cards[t]:this.cards[t.substr(0,6)]}},{key:"getAllCards",value:function(){return Object.values(this.cards)}}])})());e.default=f},2112,[1,17,18,2113]);
__d(function(e,s,i,a,t,n,l){t.exports=[{DECK_ID:"Z01",ID:"Z01001",N:"<div class=\"center\">Does Norwegian have<br><b class=\"bold\">long</b> and <b class=\"bold green\">short</b> vowels?</div>",E:"<div class=\"center\"><div class=\"left\">Yes. <b class=\"bold\">Long</b> stressed vowels are <span class=\"italic\">mostly</span> followed by <b class=\"bold\">one consonant</b> or <b class=\"bold\">no other letter</b>.<br><b class=\"bold green\">Short</b> stressed vowels are <span class=\"italic\">mostly</span> followed by <b class=\"bold green\">two consonants</b>.</div></div>",D:"BASIC PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\"><p>Listen to the examples below:</p> <p>l<b class=\"bold\">e</b>ge / l<b class=\"bold green\">e</b>gge<br>s<b class=\"bold\">a</b>me / s<b class=\"bold green\">a</b>mme<br>f<b class=\"bold\">i</b>ne / f<b class=\"bold green\">i</b>nne</p>The first word has the <b class=\"bold\">long vowel</b>, whilst the second has the <b class=\"bold green\">short vowel</b>.<br>Finally, unstressed vowels (e.g. the last vowels in the example words) are short.</div></div>",A:"X"},{DECK_ID:"Z01",ID:"Z01002",N:"<div class=\"center\">Do I have to pronounce <br><b class=\"bold\">double consonants</b> <br>with a longer sound in Norwegian?</div>",E:"<div class=\"center\"><div class=\"left\"><p>Yes, almost invariably. This can actually happen in composite words in English, such as \"roo<b class=\"bold\">mm</b>ate\" or \"mi<b class=\"bold\">dd</b>ay\".</p>Also, think of the S sound in \"thi<b class=\"bold\">s</b> age\" (short) vs \"thi<b class=\"bold\">s s</b>age\" (long).</div></div>",D:"BASIC PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\"><p>Listen to the examples below:</p><p>ba<b class=\"bold green\">k</b>e / ba<b class=\"bold\">kk</b>e<br>vi<b class=\"bold green\">s</b>e / vi<b class=\"bold\">ss</b>e<br>\xe5 fly<b class=\"bold green\">t</b>e / \xe5 fly<b class=\"bold\">tt</b>e</p>Also, the stressed vowel before a single consonant tends to be long, whilst the one before a double consonant short.</div></div>",A:"X"},{DECK_ID:"Z01",ID:"Z01003",N:"<div class=\"center\">What is the sound of <b class=\"bold\">\xc6</b> / <b class=\"bold\">\xe6</b>?</div>",E:"<div class=\"center\"><p>You can hear it here:</p><p><span class=\"italic\">\xc6, v\xe6rt, l\xe6re</span></p>The first full word has the short vowel, the second has the long vowel.</div>",D:"BASIC PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">It is the same as the <b class=\"bold\">A</b> in \"b<b class=\"bold\">a</b>g\" or \"h<b class=\"bold\">a</b>nd\".</div></div>",A:"E"},{DECK_ID:"Z01",ID:"Z01004",N:"<div class=\"center\">What is the sound of <b class=\"bold\">\xd8</b> / <b class=\"bold\">\xf8</b>?</div>",E:"<div class=\"center\"><p>You can hear it here:</p><p><span class=\"italic\">\xd8, skj\xf8nner, f\xf8r</span></p>The first full word has the short vowel, the second has the long vowel.</div>",D:"BASIC PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">The sound of <b class=\"bold\">\xd8</b> is <span class=\"italic\">similar</span> to the <b class=\"bold\">I</b> in \"b<b class=\"bold\">i</b>rd\" or \"g<b class=\"bold\">i</b>rl\".</div></div>",A:"E"},{DECK_ID:"Z01",ID:"Z01005",N:"<div class=\"center\">What is the sound of <b class=\"bold\">\xc5</b> / <b class=\"bold\">\xe5</b>?</div>",E:"<div class=\"center\"><p>You can hear it here:</p><p><span class=\"italic\">\xc5, s\xe5nn, m\xe5</span></p>The first full word has the short vowel, the second has the long vowel.</div>",D:"BASIC PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">The sound of <b class=\"bold\">\xc5</b> is <span class=\"italic\">similar</span> to the <b class=\"bold\">AW</b> in \"<b class=\"bold\">aw</b>esome\" or \"h<b class=\"bold\">aw</b>k\".</div></div>",A:"E"},{DECK_ID:"Z01",ID:"Z01006",N:"<div class=\"center\">What is the sound of J?</div>",E:"<div class=\"center\"><p>You can hear it in these words:</p><p><span class=\"italic\">jente, ja</span>.</p></div>",D:"BASIC PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\"><p>The <b class=\"bold\">J</b> is pronounced <b class=\"bold\">like</b> the <b class=\"bold\">Y</b> in \"<b class=\"bold\">y</b>ou\" or \"<b class=\"bold\">y</b>es\".</p> It is <span class=\"italic\">never</span> pronounced like the J in the English words \"joker\" or \"Juliet\".</div></div>",A:"E"},{DECK_ID:"Z01",ID:"Z01007",N:"<div class=\"center\"><div class=\"left\">What is the sound of <b class=\"bold\">EG</b> at the end of a word and of <b class=\"bold\">EI</b>?</div></div>",E:"<div class=\"center\"><p>You can hear it in these words:</p><p><span class=\"italic\">jeg, deg, hei, nei</span>.</p></div>",D:"BASIC PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">These two clusters are pronounced like an <b class=\"bold\">\xc6</b> followed by <b class=\"bold\">I</b>.</div></div>",A:"E"},{DECK_ID:"Z01",ID:"Z01008",N:"<div class=\"center\">What is the sound of <b class=\"bold\">Y</b>?</div>",E:"<div class=\"center\"><p>You can hear it here:</p><p><span class=\"italic\">Y, nytt, ny</span></p>The first full word has the short vowel, the second has the long vowel.</div>",D:"BASIC PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\"><p>The <b class=\"bold\">Y</b> in Norwegian is pronounced like an <b class=\"bold\">EE but with rounded lips</b>.</p>It is <span class=\"italic\">never</span> pronounced like in the English words \"you\" or \"my\".</div></div>",A:"E"},{DECK_ID:"Z01",ID:"Z01009",N:"<div class=\"center\">What is the sound of the <br><b class=\"bold\">T</b> at the <b class=\"bold\">end of a word</b>?</div>",E:"<div class=\"center\"><p>At times it can be silent:</p><p><span class=\"italic\">det, livet, huset</span></p></div>",D:"BASIC PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\"><p>The final <b class=\"bold\">T</b> is <b class=\"bold\">silent</b> if it indicates the definite form of nouns of the <span class=\"italic\">intetkj\xf8nn</span>/neuter gender.</p>We'll give you more details about this soon, for now learn to keep an eye on it.</div></div>",A:"E"},{DECK_ID:"Z01",ID:"Z01010",N:"<div class=\"center\">What is the sound of <b class=\"bold\">SJ</b> and <b class=\"bold\">SKJ</b>?</div>",E:"<div class=\"center\"><p>You can hear it in these words:</p><p><span class=\"italic\">sj\xf8, skj\xf8nne, kanskje</span></p></div>",D:"BASIC PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">These two clusters are pronounced very similarly to the <b class=\"bold\">SH</b> cluster in \"<b class=\"bold\">sh</b>e\" or \"<b class=\"bold\">sh</b>eep\".</div></div>",A:"E"},{DECK_ID:"Z01",ID:"Z01011",N:"<div class=\"center\">What is the sound of <b class=\"bold\">KJ</b> and <b class=\"bold\">TJ</b>?</div>",E:"<div class=\"center\"><p>You can hear it in these words:</p><p><span class=\"italic\">kjenner, tjue</span></p></div>",D:"BASIC PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\"><p>It is <span class=\"italic\">similar</span> to the <b class=\"bold\">H</b> in \"<b class=\"bold\">h</b>ue\" and \"<b class=\"bold\">h</b>uge\", or the CH of \"nicht\" in German.</p>Saying \"SH\" while smiling will get you close enough for now.</div></div>",A:"E"},{DECK_ID:"Z01",ID:"Z01012",N:"<div class=\"center\">What is the sound of <b class=\"bold\">GJ</b>?</div>",E:"<div class=\"center\"><p>You can hear it in these words:</p><p><span class=\"italic\">gjennom, gj\xf8r</span></p></div>",D:"BASIC PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">The <b class=\"bold\">G in this cluster is silent</b> and you only pronounce the <b class=\"bold\">J</b>.</div></div>",A:"E"},{DECK_ID:"Z01",ID:"Z01013",N:"<div class=\"center\">What is the sound of <b class=\"bold\">GI</b> and <b class=\"bold\">GY</b>?</div>",E:"<div class=\"center\"><p>You can hear it in these words:</p><p><span class=\"italic\">gi, gikk, begynne</span></p></div>",D:"BASIC PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">The <b class=\"bold\">G</b> in GI and GY is pronounced <b class=\"bold\">like a J</b>.</div></div>",A:"E"},{DECK_ID:"Z01",ID:"Z01014",N:"<div class=\"center\">What is the sound of the <b class=\"bold\">H</b>?</div>",E:"<div class=\"center\"><p>You can hear it in these words:</p><p><span class=\"italic\">har, h\xe5r, hva, hjem</span></p></div>",D:"BASIC PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\"><p>The <b class=\"bold\">H</b> is mostly pronounced like you would in English (e.g. \"<b class=\"bold\">h</b>ouse\" or \"<b class=\"bold\">h</b>at\"), which you can hear in the first two words. </p>It is silent when followed by V or J (i.e. the last two words in the example).</div></div>",A:"E"},{DECK_ID:"Z01",ID:"Z01015",N:"<div class=\"center\">What is the sound of <br><b class=\"bold\">IG</b> at the <b class=\"bold\">end of a word</b>?</div>",E:"<div class=\"center\"><p>The G is actually silent:</p><p><span class=\"italic\">virkelig, veldig</span></p></div>",D:"BASIC PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">IG is a typical ending for adjectives (and adverbs) and the <b class=\"bold\">G is silent</b>.</div></div>",A:"E"},{DECK_ID:"Z01",ID:"Z01016",N:"<div class=\"center\">What is the sound of <b class=\"bold\">A</b>?</div>",E:"<div class=\"center\"><p>You can hear it in these words:</p><p><span class=\"italic\">alle, dag</span></p>The first word has the short vowel, the second has the long vowel.</div>",D:"BASIC PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\"><p>The long sound comes from further back in your mouth than that of the A of most other languages.</p> Also, note that A is <span class=\"italic\">never</span> pronounced like in the English words \"fake\" or \"day\".</div></div>",A:"E"},{DECK_ID:"Z01",ID:"Z01017",N:"<div class=\"center\">What is the sound of <b class=\"bold\">E</b>?</div>",E:"<div class=\"center\"><p>You can hear it in these words:</p><p><span class=\"italic\">etter, hele</span></p>The first word has the short vowel, the second has the long vowel.</div>",D:"BASIC PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\"><p>It is <span class=\"italic\">similar</span> to the <b class=\"bold\">E</b> in \"b<b class=\"bold\">e</b>d\" or \"h<b class=\"bold\">e</b>n\".</p><p>For the long sound your lips will be less open than for the short sound.</p>Finally, note that E is <span class=\"italic\">never</span> pronounced like in the English words \"me\" or \"see\".</div></div>",A:"E"},{DECK_ID:"Z01",ID:"Z01018",N:"<div class=\"center\">What is the sound of <b class=\"bold\">I</b>?</div>",E:"<div class=\"center\"><p>You can hear it in these words:</p><p><span class=\"italic\">ikke, siden</span></p>The first word has the short vowel, the second has the long vowel.</div>",D:"BASIC PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\"><p>It is the same sound as the <b class=\"bold\">I</b> in \"<b class=\"bold\">i</b>t\" (short) or the <b class=\"bold\">EE</b> in \"b<b class=\"bold\">ee</b>\" (long).</p>Note that I is <span class=\"italic\">never</span> pronounced like in the English words \"rice\" or \"mine\".</div></div>",A:"E"},{DECK_ID:"Z01",ID:"Z01019",N:"<div class=\"center\">What is the sound of <b class=\"bold\">O</b>?</div>",E:"<div class=\"center\"><p>You can hear it in these words:</p><p><span class=\"italic\">for, noe</span></p>The first word has the short vowel, the second has the long vowel.</div>",D:"BASIC PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\"><p>It is mostly <span class=\"italic\">similar</span> to the <b class=\"bold\">O</b> in \"d<b class=\"bold\">o</b>g\" when short.</p>It is the same as the <b class=\"bold\">OO</b> in \"f<b class=\"bold\">oo</b>l\" when long.</div></div>",A:"E"},{DECK_ID:"Z01",ID:"Z01020",N:"<div class=\"center\">What is the sound of <b class=\"bold\">U</b>?</div>",E:"<div class=\"center\"><p>You can hear it in these words:</p><p><span class=\"italic\">kunne, du</span></p>The first word has the short vowel, the second has the long vowel.</div>",D:"BASIC PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">It is mostly <span class=\"italic\">similar</span> to the <b class=\"bold\">OO</b> in \"m<b class=\"bold\">oo</b>n\" but with <b class=\"bold\">slightly rounded lips</b>.</div></div>",A:"E"},{DECK_ID:"Z01",ID:"Z01021",N:"<div class=\"center\">What is the sound of <br><b class=\"bold\">D</b> at the <b class=\"bold\">end of some words</b>?</div>",E:"<div class=\"center\"><p>It is actually silent:</p><span class=\"italic\">god, r\xf8d, med, <br>land, kveld, Hellerud</span></div>",D:"BASIC PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">The <b class=\"bold\">final D is silent</b> in many short, common words, and in surnames or names of places ending in -RUD.</div></div>",A:"E"},{DECK_ID:"Z01",ID:"Z01022",N:"<div class=\"center\">What is the sound of <b class=\"bold\">RS</b>?</div>",E:"<div class=\"center\"><p>You can hear it in these words:</p><p><span class=\"italic\">norsk, er s\xe5</span></p></div>",D:"BASIC PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">RS is pronounced very similarly to the <b class=\"bold\">SH</b> in \"<b class=\"bold\">sh</b>e\" or \"<b class=\"bold\">sh</b>eep\", even across separate words.</div></div>",A:"E"},{DECK_ID:"Z01",ID:"Z01023",N:"<div class=\"center\">What is the sound of <b class=\"bold\">LV</b> <br>at the <b class=\"bold\">end of a word</b>?</div>",E:"<div class=\"center\"><p>You can hear it in these words:</p><p><span class=\"italic\">halv, tolv, selv</span></p></div>",D:"BASIC PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">LV is pronounced like a <b class=\"bold\">long L</b> and the <b class=\"bold\">V is silent</b>.</div></div>",A:"E"},{DECK_ID:"Z01",ID:"Z01024",N:"<div class=\"center\">What is the sound of <b class=\"bold\">NG</b>?</div>",E:"<div class=\"center\"><p>You can hear it in these words:</p><p><span class=\"italic\">lenge, mange</span></p></div>",D:"BASIC PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">It is the same nasal sound as the <b class=\"bold\">NG</b> in \"ki<b class=\"bold\">ng</b>\" or \"ri<b class=\"bold\">ng</b>\".</div></div>",A:"E"},{DECK_ID:"Z01",ID:"Z01025",N:"<div class=\"center\">What is the sound of <b class=\"bold\">ER</b>?</div>",E:"<div class=\"center\"><p>You can hear it in these words:</p><p><span class=\"italic\">person, er</span></p></div>",D:"BASIC PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\"><p>ER is <span class=\"italic\">often</span> pronounced as if it was <b class=\"bold\">\xc6R</b> when it's in the middle of a word or for the verb <span class=\"italic\">er</span>.</p><p>However, this does not apply when -ER is the ending of verbs in the present tense or the indefinite plural of nouns.</p> This is the last card of Basic Pronunciation: consider adding Intermediate Pronunciation to your topics already, if you want to front-load this aspect of the language.</div></div>",A:"E"},{DECK_ID:"Z02",ID:"Z02001",N:"<div class=\"center\">hei</div>",E:"<div class=\"center\">hi</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\">Approximate pronunciation: HAY</div>",A:"N"},{DECK_ID:"Z02",ID:"Z02002",N:"<div class=\"center\">jeg</div>",E:"<div class=\"center\">I<br><br>(as in: <b class=\"bold\">I</b> am)</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\"><p>Approximate pronunciation: YAY</p><p>The <b class=\"bold\">J</b> is pronounced <b class=\"bold\">like</b> the <b class=\"bold\">Y</b> in \"<b class=\"bold\">y</b>ou\" or \"<b class=\"bold\">y</b>es\".</p> It is never pronounced like the J in the English words \"joker\" or \"Juliet\".</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02003",N:"<div class=\"center\">jeg heter</div>",E:"<div class=\"center\">I am called<br>(my name is)</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\">Note how Norwegian requires the \"person\" (e.g. I, you, he etc.) to be present with the verb, like English and, for instance, French but unlike Italian or Spanish.</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02004",N:"<div class=\"center\">Hei! Jeg heter Anna</div>",E:"<div class=\"center\">Hi! My name is Anna</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\"><p>The verb <span class=\"italic\">heter</span> does not have a direct translation in English, it could be translated as \"to be called\".</p> Also, note that <b class=\"bold\">double consonants</b> (in this case NN) are mostly pronounced with a <b class=\"bold\">longer sound</b> (think of \"uNNecessary\" in English).</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02005",N:"<div class=\"center\">tusen takk</div>",E:"<div class=\"center\">thanks a lot</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\">Literally: (a) thousand thanks</div>",A:"N"},{DECK_ID:"Z02",ID:"Z02006",N:"<div class=\"center\">ja</div>",E:"<div class=\"center\">yes</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\"><p>Note how the A sound comes from the back of your mouth.</p><p>Also, remember that the <b class=\"bold\">J</b> is pronounced <b class=\"bold\">like</b> the <b class=\"bold\">Y</b> in \"<b class=\"bold\">y</b>ou\" or \"<b class=\"bold\">y</b>es\".</p> It is never pronounced like the J in the English words \"joker\" or \"Juliet\".</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02007",N:"<div class=\"center\">nei</div>",E:"<div class=\"center\">no</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\">Approximate pronunciation: NAY</div>",A:"N"},{DECK_ID:"Z02",ID:"Z02008",N:"<div class=\"center\">hva</div>",E:"<div class=\"center\">what</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\">The <b class=\"bold\">H is silent</b> when the word begins with <b class=\"bold\">HV-</b>.</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02009",N:"<div class=\"center\">du</div>",E:"<div class=\"center\">you (singular)</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\"><p>Norwegian differentiates between the singular \"you\" (<span class=\"italic\">du</span>) and the plural \"you\" (<span class=\"italic\">dere</span>).</p>More on this later.</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02010",N:"<div class=\"center\">Hva heter du?</div>",E:"<div class=\"center\">What's your name?</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\">Literally: what are you called?</div>",A:"N"},{DECK_ID:"Z02",ID:"Z02011",N:"<div class=\"center\">v\xe6r s\xe5 god</div>",E:"<div class=\"center\">you're welcome</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\"><p>Literally: be so good</p><p>Approximate pronunciation:</p>VEH SHO GOO</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02012",N:"<div class=\"center\">v\xe6r s\xe5 snill</div>",E:"<div class=\"center\">please</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\"><p>Literally: be so nice</p><p>Approximate pronunciation:</p>VEH SHO SNILL</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02013",N:"<div class=\"center\">unnskyld</div>",E:"<div class=\"center\">excuse me</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\"><p>Approximate pronunciation: OON-SHILL</p>The <b class=\"bold\">letter Y</b> is never pronounced like in the English words \"my\" or \"why\". It's rather an <b class=\"bold\">EE with rounded lips</b>, somehow similar to the German \xdc.</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02014",N:"<div class=\"center\">beklager</div>",E:"<div class=\"center\">sorry</div>",D:"YOUR FIRST 100 STEPS",X:"",A:"N"},{DECK_ID:"Z02",ID:"Z02015",N:"<div class=\"center\">hyggelig</div>",E:"<div class=\"center\">nice</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\"><p>The <b class=\"bold\">G is silent</b> in words that <b class=\"bold\">end in -IG</b>.</p>The <b class=\"bold\">letter Y</b> is never pronounced like in the English words \"my\" or \"why\". It's rather an <b class=\"bold\">EE with rounded lips</b>, somehow similar to the German \xdc.</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02016",N:"<div class=\"center\">\xe5 m\xf8te</div>",E:"<div class=\"center\">to meet</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\"><p>Like in English, the infinitive is made of two parts, with \"to\" translated by <span class=\"italic\">\xe5</span>.</p><p>The \xc5 is <span class=\"italic\">similar</span> to the English AW of \"hawk\" and \"awesome\".</p>The \xd8 is close to the I in \"bird\" or \"girl\".</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02017",N:"<div class=\"center\">deg</div>",E:"<div class=\"center\">you (object)</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\">The object of a sentence is the answer to the question \"what?\" or \"whom?\".</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02018",N:"<div class=\"center\">Hyggelig \xe5 m\xf8te deg!</div>",E:"<div class=\"center\">Nice to meet you!</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\"><p>Here you can see how Norwegian and English can <span class=\"italic\">often</span> be very close to each other in terms of word order.</p>Moreover, the two-part English infinitive (e.g. \"to meet\") also has two parts in Norwegian (e.g. <span class=\"italic\">\xe5 m\xf8te</span>).</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02019",N:"<div class=\"center\">sa</div>",E:"<div class=\"center\">said</div>",D:"YOUR FIRST 100 STEPS",X:"",A:"N"},{DECK_ID:"Z02",ID:"Z02020",N:"<div class=\"center\">Hva sa du?</div>",E:"<div class=\"center\">What did you say?</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\"><p>Norwegian does not require \"do\" as a help verb to make questions.</p><span class=\"italic\">Hva sa du?</span> translates directly as \"what said you?\".</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02021",N:"<div class=\"center\">hvordan</div>",E:"<div class=\"center\">how</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\"><p>Approximate pronunciation: VOORDAN</p>The H is silent when the word begins with HV-.</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02022",N:"<div class=\"center\">har</div>",E:"<div class=\"center\">have (present tense)</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\"><p>Norwegian verbs do not change for the different subjects.</p><span class=\"italic\">har</span> covers both \"have\" and \"has\".</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02023",N:"<div class=\"center\">det</div>",E:"<div class=\"center\">it, that</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\">The T is silent</div>",A:"N"},{DECK_ID:"Z02",ID:"Z02024",N:"<div class=\"center\">Hvordan har du det?</div>",E:"<div class=\"center\">How are you?</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\"><p>Literally: how have you it?</p>Remember that Norwegian does not require \"do\" as a help verb to make questions.</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02025",N:"<div class=\"center\">er</div>",E:"<div class=\"center\">am/is/are (present tense)</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\"><p>Norwegian verbs do not change for the different subjects.</p><span class=\"italic\">er</span> covers \"am\", \"are\" and \"is\".</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02026",N:"<div class=\"center\">Det er ok</div>",E:"<div class=\"center\">It's ok</div>",D:"YOUR FIRST 100 STEPS",X:"",A:"N"},{DECK_ID:"Z02",ID:"Z02027",N:"<div class=\"center\">g\xe5r</div>",E:"<div class=\"center\">go (present tense)</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\"><p>Norwegian verbs do not change for the different subjects.</p><span class=\"italic\">g\xe5r</span> covers both \"go\" and \"goes\"</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02028",N:"<div class=\"center\">Hvordan g\xe5r det?</div>",E:"<div class=\"center\">How is it going?</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\"><p>Literally: how goes it?</p>Note how Norwegian doesn't quite translate the continuous form with -ING of English, it just tends to use the present instead.</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02029",N:"<div class=\"center\">bra</div>",E:"<div class=\"center\">good, well</div>",D:"YOUR FIRST 100 STEPS",X:"",A:"N"},{DECK_ID:"Z02",ID:"Z02030",N:"<div class=\"center\">Det g\xe5r bra</div>",E:"<div class=\"center\">It's going well</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\"><p>Literally: it goes well</p>Note how Norwegian doesn't quite translate the continuous form with -ING of English, it just tends to use the present instead.</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02031",N:"<div class=\"center\">Ha det!</div>",E:"<div class=\"center\">Good bye!</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\">Literally: have it!</div>",A:"N"},{DECK_ID:"Z02",ID:"Z02032",N:"<div class=\"center\">vi</div>",E:"<div class=\"center\">we</div>",D:"YOUR FIRST 100 STEPS",X:"",A:"N"},{DECK_ID:"Z02",ID:"Z02033",N:"<div class=\"center\">Vi ses!</div>",E:"<div class=\"center\">See you!</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\"><p>Literally: we see each other</p>The S at the end of the verb entails a reciprocal action.<br>More on this later.</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02034",N:"<div class=\"center\">hvor</div>",E:"<div class=\"center\">where</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\"><p>Approximate pronunciation: VOOR</p>The H is silent when the word begins with HV-.</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02035",N:"<div class=\"center\">kommer</div>",E:"<div class=\"center\">come, comes <br>(present tense)</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\"><p>The present tense of a verb will most often end in -R, learn to recognise it.</p>Also, note that <b class=\"bold\">double consonants</b> (in this case MM) are mostly pronounced with a <b class=\"bold\">longer sound</b> (think of \"rooMMate\" or \"miDDay\" in English).</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02036",N:"<div class=\"center\">fra</div>",E:"<div class=\"center\">from</div>",D:"YOUR FIRST 100 STEPS",X:"",A:"N"},{DECK_ID:"Z02",ID:"Z02037",N:"<div class=\"center\">Hvor kommer du fra?</div>",E:"<div class=\"center\">Where do you come from?</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\"><p>Literally: Where come you from?</p>Remember also that <b class=\"bold\">double consonants</b> (in this case MM) are mostly pronounced with a <b class=\"bold\">longer sound</b> (think of \"rooMMate\" or \"miDDay\" in English).</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02038",N:"<div class=\"center\">Jeg kommer fra England</div>",E:"<div class=\"center\">I come from England</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\">Note how Norwegian requires the \"person\" (e.g. I, you, he etc.) to be present with the verb, like English and, for instance, French but unlike Italian or Spanish.</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02039",N:"<div class=\"center\">bor</div>",E:"<div class=\"center\">to live, to be resident <br>(present tense)</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\">Approximate pronunciation: BOOR</div>",A:"N"},{DECK_ID:"Z02",ID:"Z02040",N:"<div class=\"center\">i</div>",E:"<div class=\"center\">in</div>",D:"YOUR FIRST 100 STEPS",X:"",A:"N"},{DECK_ID:"Z02",ID:"Z02041",N:"<div class=\"center\">n\xe5</div>",E:"<div class=\"center\">now</div>",D:"YOUR FIRST 100 STEPS",X:"",A:"N"},{DECK_ID:"Z02",ID:"Z02042",N:"<div class=\"center\">Jeg bor i Oslo n\xe5</div>",E:"<div class=\"center\">I live in Oslo now</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\">Note how Norwegian requires the \"person\" (e.g. I, you, he etc.) to be present with the verb, like English and, for instance, French but unlike Italian or Spanish.</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02043",N:"<div class=\"center\">ikke</div>",E:"<div class=\"center\">not</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\">Remember that <b class=\"bold\">double consonants</b> (in this case KK) are mostly pronounced with a <b class=\"bold\">longer sound</b>.</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02044",N:"<div class=\"center\">norsk</div>",E:"<div class=\"center\">Norwegian</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">norsk</span> covers both \"Norwegian\" as a language and \"Norwegian\" as the adjective for the nationality.</p>Note that it's in lower case, whereas you'd need the uppercase initial in English.</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02045",N:"<div class=\"center\">Jeg er ikke norsk</div>",E:"<div class=\"center\">I am not Norwegian</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\">Negative sentences are another case where Norwegian and English can <span class=\"italic\">often</span> be very close to each other in terms of word order.</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02046",N:"<div class=\"center\">kan</div>",E:"<div class=\"center\">can (verb)</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\">Just like in English, this verb can support other verbs.</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02047",N:"<div class=\"center\">snakke</div>",E:"<div class=\"center\">(to) speak, (to) talk</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\">This is the bare infinitive of the verb <span class=\"italic\">\xe5 snakke</span>.</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02048",N:"<div class=\"center\">engelsk</div>",E:"<div class=\"center\">English</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\">Note that <span class=\"italic\">engelsk</span> covers both \"English\" as a language and \"English\" as the adjective for the nationality.<br>Lower case initial.</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02049",N:"<div class=\"center\">Kan vi snakke engelsk, v\xe6r s\xe5 snill?</div>",E:"<div class=\"center\">Can we speak English, please?</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\"><p>Infinitives lose the <span class=\"italic\">\xe5</span> (and become \"bare infinitives\") when used after the Norwegian modal verbs.</p>The same happens in English, with infinitives losing the \"to\" when used with modal verbs such as \"can\", \"will\", \"must\".</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02050",N:"<div class=\"center\">langsomt</div>",E:"<div class=\"center\">slowly</div>",D:"YOUR FIRST 100 STEPS",X:"",A:"N"},{DECK_ID:"Z02",ID:"Z02051",N:"<div class=\"center\">Kan du snakke langsomt?</div>",E:"<div class=\"center\">Can you speak slowly?</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\"><p>Infinitives lose the <span class=\"italic\">\xe5</span> (and become \"bare infinitives\") when used after the Norwegian modal verbs.</p>The same happens in English, with infinitives losing the \"to\" when used with modal verbs such as \"can\", \"will\", \"must\".</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02052",N:"<div class=\"center\">jeg s\xf8ker</div>",E:"<div class=\"center\">I search</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\">Note how Norwegian requires the \"person\" (e.g. I, you, he etc.) to be present with the verb, like English and, for instance, French but unlike Italian or Spanish.</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02053",N:"<div class=\"center\">etter</div>",E:"<div class=\"center\">after, for</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\">Remember that <b class=\"bold\">double consonants</b> (in this case TT) are mostly pronounced with a <b class=\"bold\">longer sound</b> (unlike in English).</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02054",N:"<div class=\"center\">(en) jobb</div>",E:"<div class=\"center\">(a) job</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\"><p>Approximate pronunciation: (EN) YOBB</p><p>The noun <span class=\"italic\">jobb</span> belongs to the \"masculine\" gender and therefore requires the article <span class=\"italic\">en</span>.</p>More on this later.</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02055",N:"<div class=\"center\">Jeg s\xf8ker etter jobb</div>",E:"<div class=\"center\">I am looking for a job</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\"><p>Literally: I search after job</p>Norwegian might omit the article (i.e. \"a\") whereas English has it.</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02056",N:"<div class=\"center\">vil</div>",E:"<div class=\"center\">will, want (verb)</div>",D:"YOUR FIRST 100 STEPS",X:"",A:"N"},{DECK_ID:"Z02",ID:"Z02057",N:"<div class=\"center\">dere</div>",E:"<div class=\"center\">you (plural)</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\">Norwegian differentiates between the singular \"you\" (<span class=\"italic\">du</span>) and the plural \"you\" (<span class=\"italic\">dere</span>).</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02058",N:"<div class=\"center\">noe</div>",E:"<div class=\"center\">something, anything</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\">Note that the O in <span class=\"italic\">noe</span> is pronounced like the O in \"do\" or \"to\".</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02059",N:"<div class=\"center\">Vil dere ha noe?</div>",E:"<div class=\"center\">Do you (guys) want anything?</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\"><p>Literally:</p>Will/want you (guys) have anything?</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02060",N:"<div class=\"center\">en, et</div>",E:"<div class=\"center\">a/an</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\"><p>Norwegian has two main genders: a masculine gender and a neuter gender.</p>The indefinite article \"a/an\" of English will become <span class=\"italic\">en</span> or <span class=\"italic\">et</span> according to the gender.</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02061",N:"<div class=\"center\">til</div>",E:"<div class=\"center\">to, for</div>",D:"YOUR FIRST 100 STEPS",X:"",A:"N"},{DECK_ID:"Z02",ID:"Z02062",N:"<div class=\"center\">min</div>",E:"<div class=\"center\">my</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\">The I in <span class=\"italic\">min</span> is short, even if it's followed by a single consonant.</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02063",N:"<div class=\"center\">venn</div>",E:"<div class=\"center\">friend</div>",D:"YOUR FIRST 100 STEPS",X:"",A:"N"},{DECK_ID:"Z02",ID:"Z02064",N:"<div class=\"center\">\xf8l</div>",E:"<div class=\"center\">beer</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\">\xd8 is similar to the I in \"bird\" or \"girl\"</div>",A:"N"},{DECK_ID:"Z02",ID:"Z02065",N:"<div class=\"center\">kaffe</div>",E:"<div class=\"center\">coffee</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\">Remember that <b class=\"bold\">double consonants</b> (in this case FF) are mostly pronounced with a <b class=\"bold\">longer sound</b> (unlike in English).</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02066",N:"<div class=\"center\">og</div>",E:"<div class=\"center\">and</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><p>Approximate pronunciation:</p>AW (the G is silent)</div>",A:"N"},{DECK_ID:"Z02",ID:"Z02067",N:"<div class=\"center\">meg</div>",E:"<div class=\"center\">me</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\">Approximate pronunciation: MAY</div>",A:"N"},{DECK_ID:"Z02",ID:"Z02068",N:"<div class=\"center\">En \xf8l til min venn og en kaffe til meg</div>",E:"<div class=\"center\">A beer for my friend and a coffee for me</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\">Again, Norwegian and English can <span class=\"italic\">often</span> be very close to each other in terms of word order.</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02069",N:"<div class=\"center\">jeg vet</div>",E:"<div class=\"center\">I know</div>",D:"YOUR FIRST 100 STEPS",X:"",A:"N"},{DECK_ID:"Z02",ID:"Z02070",N:"<div class=\"center\">skal</div>",E:"<div class=\"center\">shall, will</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\">Just like in English, this verb can support other verbs.</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02071",N:"<div class=\"center\">\xe5 gj\xf8re</div>",E:"<div class=\"center\">to do</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\">The G is silent when the word begins with GJ-</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02072",N:"<div class=\"center\">Jeg vet ikke hva jeg skal gj\xf8re</div>",E:"<div class=\"center\">I don't know what I shall do</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\"><p>Infinitives lose the <span class=\"italic\">\xe5</span> (and become \"bare infinitives\") when used after the Norwegian modal verbs.</p>The same happens in English, with infinitives losing the \"to\" when used with modal verbs such as \"can\", \"will\", \"must\".</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02073",N:"<div class=\"center\">jeg trenger</div>",E:"<div class=\"center\">I need</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\">Note how Norwegian requires the \"person\" (e.g. I, you, he etc.) to be present with the verb, like English and, for instance, French but unlike Italian or Spanish.</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02074",N:"<div class=\"center\">\xe5 ta</div>",E:"<div class=\"center\">to take</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\">Like in English, the infinitive is made of two parts, with \"to\" translated by <span class=\"italic\">\xe5</span>.</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02075",N:"<div class=\"center\">bussen</div>",E:"<div class=\"center\">the bus</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\"><p>The Norwegian equivalent of the singular definite article \"the\" goes at the end of the word it refers to.</p>This will be -EN (or -N) for masculine gender words, or -ET (or -T) for neuter gender words.</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02076",N:"<div class=\"center\">Jeg trenger \xe5 ta bussen</div>",E:"<div class=\"center\">I need to take the bus</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\">Just like in English, the verb <span class=\"italic\">\xe5 trenge</span> (to need) is not a modal verb, therefore it requires the verb that follows to be in its full infinitive form (i.e. \"to take\"/<span class=\"italic\">\xe5 ta</span>).</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02077",N:"<div class=\"center\">n\xe5r</div>",E:"<div class=\"center\">when</div>",D:"YOUR FIRST 100 STEPS",X:"",A:"N"},{DECK_ID:"Z02",ID:"Z02078",N:"<div class=\"center\">nummer</div>",E:"<div class=\"center\">number</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\">Remember that <b class=\"bold\">double consonants</b> (in this case MM) are mostly pronounced with a <b class=\"bold\">longer sound</b> (unlike in English).</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02079",N:"<div class=\"center\">tre</div>",E:"<div class=\"center\">three</div>",D:"YOUR FIRST 100 STEPS",X:"",A:"N"},{DECK_ID:"Z02",ID:"Z02080",N:"<div class=\"center\">N\xe5r kommer buss nummer tre?</div>",E:"<div class=\"center\">When does bus number three come?</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\"><p>Literally: when comes bus number three?</p>Remember that Norwegian does not require \"do\" as a help verb to make questions.</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02081",N:"<div class=\"center\">Forst\xe5r du?</div>",E:"<div class=\"center\">Do you understand?</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><p>Approximate pronunciation:</p>FOSH-TOR DOO</div>",A:"N"},{DECK_ID:"Z02",ID:"Z02082",N:"<div class=\"center\">jeg sier</div>",E:"<div class=\"center\">I say</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><p>Approximate pronunciation:</p>YAY SEER</div>",A:"N"},{DECK_ID:"Z02",ID:"Z02083",N:"<div class=\"center\">Forst\xe5r du hva jeg sier?</div>",E:"<div class=\"center\">Do you understand what I'm saying?</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\"><p>Literally: understand you what I say?</p>Note how Norwegian doesn't quite translate the continuous form with -ING of English, it just tends to use the present instead.</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02084",N:"<div class=\"center\">likte</div>",E:"<div class=\"center\">liked (past tense)</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\">Simple past and past participle forms of Norwegian verbs will often have a T or D towards the end, a bit like English has -ED.</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02085",N:"<div class=\"center\">maten</div>",E:"<div class=\"center\">the food</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\"><p>The Norwegian equivalent of the singular definite article \"the\" goes at the end of the word it refers to.</p>This will be -EN (or -N) for masculine gender words, or -ET (or -T) for neuter gender words.</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02086",N:"<div class=\"center\">Likte du maten?</div>",E:"<div class=\"center\">Did you like the food?</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\"><p>Literally: liked you the food?</p><p>The Norwegian equivalent of the singular definite article \"the\" goes at the end of the word it refers to.</p>This will be -EN (or -N) for masculine gender words, or -ET (or -T) for neuter gender words.</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02087",N:"<div class=\"center\">jeg synes</div>",E:"<div class=\"center\">I think<br><br>(meaning: \"I am of the opinion that\")</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\">A few verbs end in S even in the present tense, whereas most would end in R: <span class=\"italic\">er, har, g\xe5r, kommer</span>.</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02088",N:"<div class=\"center\">var</div>",E:"<div class=\"center\">was, were</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\"><p>Norwegian verbs do not change for the different subjects.</p><span class=\"italic\">var</span> covers both \"was\" and \"were\"</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02089",N:"<div class=\"center\">god</div>",E:"<div class=\"center\">good</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><p>Approximate pronunciation:</p>GOO (the D is silent)</div>",A:"N"},{DECK_ID:"Z02",ID:"Z02090",N:"<div class=\"center\">Jeg synes den var god</div>",E:"<div class=\"center\"><p>I think it was good</p>(\"it\" = the food)</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\"><p>This sentence is an answer to <span class=\"italic\">Likte du maten?</span>.</p> Therefore, \"it\" must be translated by <span class=\"italic\">den</span> (the masculine form of <span class=\"italic\">det</span>) because <span class=\"italic\">mat</span> is a masculine word.</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02091",N:"<div class=\"center\">hun</div>",E:"<div class=\"center\">she</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\"><p>Approximate pronunciation: HOON</p>In this case, the U sound is short even if it is followed by just one N.</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02092",N:"<div class=\"center\">sykepleier</div>",E:"<div class=\"center\">nurse</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\"><p>Approximate pronunciation:</p><p>SEEK EH PLAYER</p>The <b class=\"bold\">letter Y</b> is never pronounced like in the English words \"my\" or \"why\". It's rather an <b class=\"bold\">EE with rounded lips</b>.</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02093",N:"<div class=\"center\">han</div>",E:"<div class=\"center\">he</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\">In this case, the A sound is short even if it is followed by just one N.</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02094",N:"<div class=\"center\">l\xe6rer</div>",E:"<div class=\"center\">teacher</div>",D:"YOUR FIRST 100 STEPS",X:"",A:"N"},{DECK_ID:"Z02",ID:"Z02095",N:"<div class=\"center\">Hun er sykepleier og han er l\xe6rer</div>",E:"<div class=\"center\">She is a nurse and he is a teacher</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\">Remember that Y is pronounced like the E sound of \"be\" or \"me\" but with rounded lips.<br>This is somehow similar to the German \xdc.</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02096",N:"<div class=\"center\">de</div>",E:"<div class=\"center\">they</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\">Approximate pronunciation: DEE</div>",A:"N"},{DECK_ID:"Z02",ID:"Z02097",N:"<div class=\"center\">de jobber</div>",E:"<div class=\"center\">they work</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><p>Approximate pronunciation:</p>DEE YOBBER</div>",A:"N"},{DECK_ID:"Z02",ID:"Z02098",N:"<div class=\"center\">p\xe5</div>",E:"<div class=\"center\">at, on, in</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\">This preposition can have many meanings, learn to keep an eye on it.</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02099",N:"<div class=\"center\">skolen</div>",E:"<div class=\"center\">the school</div>",D:"YOUR FIRST 100 STEPS",X:"<div class=\"center\"><div class=\"left\"><p>The Norwegian equivalent of the singular definite article \"the\" goes at the end of the word it refers to.</p>This will be -EN (or -N) for masculine gender words, or -ET (or -T) for neuter gender words.</div></div>",A:"N"},{DECK_ID:"Z02",ID:"Z02100",N:"<div class=\"center\">De jobber p\xe5 skolen</div>",E:"<div class=\"center\">They work at the school</div>",D:"YOUR FIRST 100 STEPS",X:"",A:"N"},{DECK_ID:"A01",ID:"A01001",N:"<div class=\"center\">God morgen</div>",E:"<div class=\"center\">Good morning</div>",D:"EVERYDAY LIFE",X:"<div class=\"center\"><div class=\"left\"><p>Approximate pronunciation:</p><p>GOO MON</p>The word <span class=\"italic\">morgen</span> can be pronounced like \"MORGEN\" or in a contracted way, as \"MON\".</div></div>",A:"N"},{DECK_ID:"A01",ID:"A01002",N:"<div class=\"center\">God kveld</div>",E:"<div class=\"center\">Good evening</div>",D:"EVERYDAY LIFE",X:"<div class=\"center\"><p>Approximate pronunciation:</p>GOO KVELL</div>",A:"N"},{DECK_ID:"A01",ID:"A01003",N:"<div class=\"center\">Velkommen!</div>",E:"<div class=\"center\">Welcome!</div>",D:"EVERYDAY LIFE",X:"<div class=\"center\"><div class=\"left\">Remember that <b class=\"bold\">double consonants</b> (in this case MM) are mostly pronounced with a <b class=\"bold\">longer sound:  think of \"rooMMate\" or \"miDDay\" in English.</b> .</div></div>",A:"N"},{DECK_ID:"A01",ID:"A01004",N:"<div class=\"center\">Takk for sist!</div>",E:"<div class=\"center\">Thanks for the last time together</div>",D:"EVERYDAY LIFE",X:"<div class=\"center\"><div class=\"left\">A typical Scandinavian expression used on the back of a previously held get-together, invitation or celebration.</div></div>",A:"N"},{DECK_ID:"A01",ID:"A01005",N:"<div class=\"center\">Sk\xe5l!</div>",E:"<div class=\"center\">Cheers!</div>",D:"EVERYDAY LIFE",X:"<div class=\"center\">Used when having a toast</div>",A:"N"},{DECK_ID:"A01",ID:"A01006",N:"<div class=\"center\">Prosit!</div>",E:"<div class=\"center\">Bless you!</div>",D:"EVERYDAY LIFE",X:"<div class=\"center\">Used when somebody sneezes</div>",A:"N"},{DECK_ID:"A01",ID:"A01007",N:"<div class=\"center\">God ettermiddag</div>",E:"<div class=\"center\">Good afternoon</div>",D:"EVERYDAY LIFE",X:"<div class=\"center\"><div class=\"left\">Remember that <b class=\"bold\">double consonants</b> (in this case TT and DD) are mostly pronounced with a <b class=\"bold\">longer sound</b> (think of \"rooMMate\" or \"miDDay\" in English).</div></div>",A:"N"},{DECK_ID:"A01",ID:"A01008",N:"<div class=\"center\">God natt</div>",E:"<div class=\"center\">Good night</div>",D:"EVERYDAY LIFE",X:"<div class=\"center\"><p>Approximate pronunciation:</p>GOO NATT</div>",A:"N"},{DECK_ID:"A01",ID:"A01009",N:"<div class=\"center\">Vi snakkes!</div>",E:"<div class=\"center\">Talk to you later!</div>",D:"EVERYDAY LIFE",X:"<div class=\"center\"><div class=\"left\"><p>Literally: we (will) talk to each other.</p>The S at the end of the verb entails a reciprocal action (more on this later).</div></div>",A:"N"},{DECK_ID:"A01",ID:"A01010",N:"<div class=\"center\">Ha det bra!</div>",E:"<div class=\"center\">Good bye!</div>",D:"EVERYDAY LIFE",X:"<div class=\"center\"><div class=\"left\"><p>Literally: have it good.</p>The simple <span class=\"italic\">ha det!</span> can be used to the same effect.</div></div>",A:"N"},{DECK_ID:"A01",ID:"A01011",N:"<div class=\"center\">Bare hyggelig</div>",E:"<div class=\"center\">My pleasure / <br>Don't mention it</div>",D:"EVERYDAY LIFE",X:"<div class=\"center\"><div class=\"left\"><p>Another way to say \"you're welcome\".</p>Remember that the <b class=\"bold\">G is silent</b> in adjectives (and adverbs) that <b class=\"bold\">end in -IG</b>.</div></div>",A:"N"},{DECK_ID:"A01",ID:"A01012",N:"<div class=\"center\">Hvor bor du?</div>",E:"<div class=\"center\">Where do you live?</div>",D:"EVERYDAY LIFE",X:"<div class=\"center\"><div class=\"left\"><p>Literally: where live you?</p>Remember that Norwegian does not require the \"do\" as a help verb to make questions.</div></div>",A:"N"},{DECK_ID:"A01",ID:"A01013",N:"<div class=\"center\">Hvor ligger skattekontoret?</div>",E:"<div class=\"center\">Where is the tax office?</div>",D:"EVERYDAY LIFE",X:"<div class=\"center\"><div class=\"left\">The <span class=\"italic\">kontor</span> (office) of <span class=\"italic\">skatteetaten</span> (the state's tax authority) is one of the first stops for all expatriates in Norway.</div></div>",A:"N"},{DECK_ID:"A01",ID:"A01014",N:"<div class=\"center\">Hva koster det?</div>",E:"<div class=\"center\">How much does it cost?</div>",D:"EVERYDAY LIFE",X:"<div class=\"center\"><div class=\"left\"><p>Literally: what costs it?</p><p>Remember that Norwegian does not require the \"do\" as a help verb to make questions.</p><span class=\"italic\">Hvor mye koster det?</span> is also a valid phrasing.</div></div>",A:"N"},{DECK_ID:"A01",ID:"A01015",N:"<div class=\"center\">Kan jeg betale med kort?</div>",E:"<div class=\"center\">Can I pay by card?</div>",D:"EVERYDAY LIFE",X:"<div class=\"center\"><div class=\"left\">Remember: the verb that comes after a modal verb such as <span class=\"italic\">kan</span> needs to be in the bare infinitive (i.e. infinitive without <span class=\"italic\">\xe5</span>), just like in English.</div></div>",A:"N"},{DECK_ID:"A01",ID:"A01016",N:"<div class=\"center\">Vil du ha en pose?</div>",E:"<div class=\"center\">Would you like a bag?</div>",D:"EVERYDAY LIFE",X:"<div class=\"center\"><div class=\"left\"><p>Something you are likely to be asked when shopping. Literally:</p><p>\"want you have a bag?\"</p>Also, remember that the verb that comes after a modal verb such as <span class=\"italic\">vil</span> needs to be in the bare infinitive.</div></div>",A:"N"},{DECK_ID:"A01",ID:"A01017",N:"<div class=\"center\">Ha en fin dag!</div>",E:"<div class=\"center\">Have a nice day!</div>",D:"EVERYDAY LIFE",X:"<div class=\"center\"><div class=\"left\">This expression is constructed using the verb in the imperative form, which does not require the personal pronoun or any other subject, just like in English.</div></div>",A:"N"},{DECK_ID:"A01",ID:"A01018",N:"<div class=\"center\">Vil du ha kvittering?</div>",E:"<div class=\"center\">Would you like (the) receipt?</div>",D:"EVERYDAY LIFE",X:"<div class=\"center\"><div class=\"left\"><p>Something you are likely to be asked when shopping. Literally:</p><p>\"want you have receipt?\"</p>Also, remember that the verb that comes after a modal verb such as <span class=\"italic\">vil</span> needs to be in the bare infinitive.</div></div>",A:"N"},{DECK_ID:"A01",ID:"A01019",N:"<div class=\"center\">Har dere glutenfritt br\xf8d?</div>",E:"<div class=\"center\">Do you (guys) have gluten-free bread?</div>",D:"EVERYDAY LIFE",X:"<div class=\"center\"><div class=\"left\">Remember that <span class=\"italic\">dere</span> means \"you\" in the plural sense.</div></div>",A:"N"},{DECK_ID:"A01",ID:"A01020",N:"<div class=\"center\">Har dere halal kj\xf8tt?</div>",E:"<div class=\"center\">Do you (guys) have halal meat?</div>",D:"EVERYDAY LIFE",X:"<div class=\"center\"><div class=\"left\"><p>Remember that <span class=\"italic\">dere</span> means \"you\" in the plural sense.</p>Also, remember that the sound of KJ is like saying \"SH\" (as in \"she\") while you smile.</div></div>",A:"N"},{DECK_ID:"A01",ID:"A01021",N:"<div class=\"center\">Inneholder det n\xf8tter?</div>",E:"<div class=\"center\">Does it contain nuts?</div>",D:"EVERYDAY LIFE",X:"<div class=\"center\"><div class=\"left\"><p>Literally: contains it nuts?</p>Remember that Norwegian does not require the \"do\" as a help verb to make questions.</div></div>",A:"N"},{DECK_ID:"A01",ID:"A01022",N:"<div class=\"center\">N\xe5r stenger dere?</div>",E:"<div class=\"center\">When do you (guys) close?</div>",D:"EVERYDAY LIFE",X:"<div class=\"center\"><div class=\"left\"><p>Literally: when close you?</p>Remember that Norwegian does not require the \"do\" as a help verb to make questions.</div></div>",A:"N"},{DECK_ID:"A01",ID:"A01023",N:"<div class=\"center\">Kos deg!</div>",E:"<div class=\"center\">Enjoy yourself!</div>",D:"EVERYDAY LIFE",X:"<div class=\"center\"><div class=\"left\">The verb <span class=\"italic\">\xe5 kose seg</span> can translate as \"to have a good time\", \"to enjoy oneself\".</div></div>",A:"N"},{DECK_ID:"A01",ID:"A01024",N:"<div class=\"center\">Sov godt!</div>",E:"<div class=\"center\">Sleep well!</div>",D:"EVERYDAY LIFE",X:"<div class=\"center\"><div class=\"left\"><p>Approximate pronunciation: SOV GOT</p>Norwegian can create adverbs from the neuter form of adjectives (more on this soon).</div></div>",A:"N"},{DECK_ID:"A01",ID:"A01025",N:"<div class=\"center\">Takk for hjelpen!</div>",E:"<div class=\"center\">Thanks for the help!</div>",D:"EVERYDAY LIFE",X:"<div class=\"center\"><div class=\"left\">Most nouns belonging to the <span class=\"italic\">hankj\xf8nn</span> gender (i.e. masculine) would end in ER or R for the indefinite plural form, but <span class=\"italic\">takk</span> is an exception and doesn't change.</div></div>",A:"N"},{DECK_ID:"A01",ID:"A01026",N:"<div class=\"center\">Ellers takk!</div>",E:"<div class=\"center\"><p>No, thanks</p>Thanks anyway!</div>",D:"EVERYDAY LIFE",X:"<div class=\"center\">Literally: otherwise thanks</div>",A:"N"},{DECK_ID:"A01",ID:"A01027",N:"<div class=\"center\">Slapp av!</div>",E:"<div class=\"center\">Relax! / Take it easy!</div>",D:"EVERYDAY LIFE",X:"",A:"N"},{DECK_ID:"A01",ID:"A01028",N:"<div class=\"center\">Jeg har et jobbintervju i dag</div>",E:"<div class=\"center\">I have a job interview today</div>",D:"EVERYDAY LIFE",X:"",A:"N"},{DECK_ID:"A01",ID:"A01029",N:"<div class=\"center\">Vi var i parken i g\xe5r</div>",E:"<div class=\"center\">We were at the park yesterday</div>",D:"EVERYDAY LIFE",X:"",A:"N"},{DECK_ID:"A01",ID:"A01030",N:"<div class=\"center\">Han skal \xe5pne en bankkonto i morgen</div>",E:"<div class=\"center\">He will open a bank account tomorrow</div>",D:"EVERYDAY LIFE",X:"<div class=\"center\"><div class=\"left\">This example shows how the verb \"will\" in English (used to indicate a future event) is mostly translated with the Norwegian modal <span class=\"italic\">skal</span> and rather rarely with the Norwegian modal <span class=\"italic\">vil</span>.</div></div>",A:"N"},{DECK_ID:"A01",ID:"A01031",N:"<div class=\"center\">Hvordan st\xe5r det til?</div>",E:"<div class=\"center\">How is it going?</div>",D:"EVERYDAY LIFE",X:"<div class=\"center\"><div class=\"left\"><p>Yet another way of asking how somebody is.</p><span class=\"italic\">Hvordan g\xe5r det?</span> can also be used as a translation of \"how is it going?\".</div></div>",A:"N"},{DECK_ID:"A01",ID:"A01032",N:"<div class=\"center\">Vi vil gjerne ha et bord for to</div>",E:"<div class=\"center\">We'd like to have a table for two</div>",D:"EVERYDAY LIFE",X:"<div class=\"center\"><div class=\"left\"><p>The adverb <span class=\"italic\">gjerne</span> can translate to \"gladly\" or \"happily\".</p>Note that its G is silent, since it's followed by a J.</div></div>",A:"N"},{DECK_ID:"A01",ID:"A01033",N:"<div class=\"center\">Selv takk!</div>",E:"<div class=\"center\">Thanks to you!</div>",D:"EVERYDAY LIFE",X:"<div class=\"center\"><div class=\"left\"><p>Literally: self thanks</p>Used to thank back the person who has just thanked you, instead of saying <span class=\"italic\">v\xe6r s\xe5 god</span>.</div></div>",A:"N"},{DECK_ID:"A01",ID:"A01034",N:"<div class=\"center\">G\xe5r denne bussen til flyplassen?</div>",E:"<div class=\"center\">Is this bus going to the airport?</div>",D:"EVERYDAY LIFE",X:"<div class=\"center\"><div class=\"left\">Although the verb <span class=\"italic\">\xe5 g\xe5</span> cannot be used to describe people driving/flying/etc to a place, it can be used for vehicles going to a place, such as a bus in this case.</div></div>",A:"N"},{DECK_ID:"A01",ID:"A01035",N:"<div class=\"center\">Du trenger D-nummer for \xe5 f\xe5 skattekort</div>",E:"<div class=\"center\">You need a D-number to get a tax card/code</div>",D:"EVERYDAY LIFE",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">D-nummer</span> and the <span class=\"italic\">skattekort</span> are also important steps in the life of expatriates in Norway.</div></div>",A:"N"},{DECK_ID:"A01",ID:"A01036",N:"<div class=\"center\"><div class=\"left\">Vi tar en flaske vann med kullsyre og en flaske vann uten</div></div>",E:"<div class=\"center\"><div class=\"left\">We'll have a bottle of sparkling water and a bottle of still water</div></div>",D:"EVERYDAY LIFE",X:"<div class=\"center\"><div class=\"left\"><p>Literally: we take a bottle of water with carbonic acid and a bottle of water without (it).</p> <span class=\"italic\">Vann med kullsyre</span> is how you refer to carbonated/sparkling water in Norwegian.</div></div>",A:"N"},{DECK_ID:"A01",ID:"A01037",N:"<div class=\"center\">Jeg er lei for deg</div>",E:"<div class=\"center\">I'm sorry/saddened for you</div>",D:"EVERYDAY LIFE",X:"",A:"N"},{DECK_ID:"A01",ID:"A01038",N:"<div class=\"center\"><div class=\"left\">Hvor lang tid tar det \xe5 komme seg til sentralstasjonen?</div></div>",E:"<div class=\"center\"><div class=\"left\">How long does it take to get to the central station?</div></div>",D:"EVERYDAY LIFE",X:"<div class=\"center\"><div class=\"left\"><p>Literally: how much time does it take to come oneself to the central station?</p> Remember that the Norwegian equivalent of expressions such as \"how much\", \"how long\", etc requires <span class=\"italic\">hvor</span> (i.e. \"where\") rather than <span class=\"italic\">hvordan</span> (i.e. \"how\"), as a direct translation might make you think.</div></div>",A:"N"},{DECK_ID:"A01",ID:"A01039",N:"<div class=\"center\">Hun er lei av sin kj\xe6reste</div>",E:"<div class=\"center\"><div class=\"left\">She is tired of / bored of / fed up with her boyfriend</div></div>",D:"EVERYDAY LIFE",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">kj\xe6reste</span> (literally \"dearest\") means boyfriend/girlfriend</div></div>",A:"N"},{DECK_ID:"A01",ID:"A01040",N:"<div class=\"center\">N\xe5r kommer vi frem?</div>",E:"<div class=\"center\">When do we arrive?</div>",D:"EVERYDAY LIFE",X:"<div class=\"center\"><div class=\"left\"><p>Literally: \"when do we come forward?\"</p><p>A more specific (but less natural) way of asking the same would be:</p><span class=\"italic\">N\xe5r ankommer vi?</span></div></div>",A:"N"},{DECK_ID:"A02",ID:"A02001",N:"<div class=\"center\">null</div>",E:"<div class=\"center\"> 0</div>",D:"BASIC NUMBERS",X:"",A:"N"},{DECK_ID:"A02",ID:"A02002",N:"<div class=\"center\">\xe9n, ett</div>",E:"<div class=\"center\">1</div>",D:"BASIC NUMBERS",X:"<div class=\"center\"><div class=\"left\"><p>While <span class=\"italic\">en</span> and <span class=\"italic\">et</span> translate to \"a/an\", <span class=\"italic\">\xe9n</span> and <span class=\"italic\">ett</span> translate to \"one\", changing according to the gender of the noun they refer to.</p>When counting, <span class=\"italic\">\xe9n</span> is used:<br><span class=\"italic\">\xe9n, to, tre, fire</span></div></div>",A:"N"},{DECK_ID:"A02",ID:"A02003",N:"<div class=\"center\">to</div>",E:"<div class=\"center\">2</div>",D:"BASIC NUMBERS",X:"",A:"N"},{DECK_ID:"A02",ID:"A02004",N:"<div class=\"center\">tre</div>",E:"<div class=\"center\">3</div>",D:"BASIC NUMBERS",X:"",A:"N"},{DECK_ID:"A02",ID:"A02005",N:"<div class=\"center\">fire</div>",E:"<div class=\"center\">4</div>",D:"BASIC NUMBERS",X:"",A:"N"},{DECK_ID:"A02",ID:"A02006",N:"<div class=\"center\">fem</div>",E:"<div class=\"center\">5</div>",D:"BASIC NUMBERS",X:"",A:"N"},{DECK_ID:"A02",ID:"A02007",N:"<div class=\"center\">seks</div>",E:"<div class=\"center\">6</div>",D:"BASIC NUMBERS",X:"",A:"N"},{DECK_ID:"A02",ID:"A02008",N:"<div class=\"center\">sju<br><br>(syv)</div>",E:"<div class=\"center\">7</div>",D:"BASIC NUMBERS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">Syv</span> is a more conservative form which can still be used.</div></div>",A:"N"},{DECK_ID:"A02",ID:"A02009",N:"<div class=\"center\">\xe5tte</div>",E:"<div class=\"center\">8</div>",D:"BASIC NUMBERS",X:"",A:"N"},{DECK_ID:"A02",ID:"A02010",N:"<div class=\"center\">ni</div>",E:"<div class=\"center\">9</div>",D:"BASIC NUMBERS",X:"",A:"N"},{DECK_ID:"A02",ID:"A02011",N:"<div class=\"center\">ti</div>",E:"<div class=\"center\">10</div>",D:"BASIC NUMBERS",X:"",A:"N"},{DECK_ID:"A02",ID:"A02012",N:"<div class=\"center\">elleve</div>",E:"<div class=\"center\">11</div>",D:"BASIC NUMBERS",X:"<div class=\"center\">The second E is silent</div>",A:"N"},{DECK_ID:"A02",ID:"A02013",N:"<div class=\"center\">tolv</div>",E:"<div class=\"center\">12</div>",D:"BASIC NUMBERS",X:"<div class=\"center\"><div class=\"left\">The V is silent and the L is prolonged</div></div>",A:"N"},{DECK_ID:"A02",ID:"A02014",N:"<div class=\"center\">tretten</div>",E:"<div class=\"center\">13</div>",D:"BASIC NUMBERS",X:"<div class=\"center\"><div class=\"left\">Remember that <b class=\"bold\">double consonants</b> (in this case TT) are mostly pronounced with a <b class=\"bold\">longer sound</b> (think of \"rooMMate\" or \"miDDay\" in English).</div></div>",A:"N"},{DECK_ID:"A02",ID:"A02015",N:"<div class=\"center\">fjorten</div>",E:"<div class=\"center\">14</div>",D:"BASIC NUMBERS",X:"<div class=\"center\"><div class=\"left\">Pay attention to the RT cluster and its pronunciation.</div></div>",A:"N"},{DECK_ID:"A02",ID:"A02016",N:"<div class=\"center\">femten</div>",E:"<div class=\"center\">15</div>",D:"BASIC NUMBERS",X:"",A:"N"},{DECK_ID:"A02",ID:"A02017",N:"<div class=\"center\">seksten</div>",E:"<div class=\"center\">16</div>",D:"BASIC NUMBERS",X:"<div class=\"center\"><div class=\"left\">Note how the EK in <span class=\"italic\">seksten</span> is pronounced like the EG in <span class=\"italic\">jeg</span>.</div></div>",A:"N"},{DECK_ID:"A02",ID:"A02018",N:"<div class=\"center\">sytten</div>",E:"<div class=\"center\">17</div>",D:"BASIC NUMBERS",X:"<div class=\"center\"><div class=\"left\">Note that the Y in this number is effectively pronounced like a short \xd8.</div></div>",A:"N"},{DECK_ID:"A02",ID:"A02019",N:"<div class=\"center\">atten</div>",E:"<div class=\"center\">18</div>",D:"BASIC NUMBERS",X:"<div class=\"center\"><div class=\"left\">Remember that <b class=\"bold\">double consonants</b> (in this case TT) are mostly pronounced with a <b class=\"bold\">longer sound</b>.</div></div>",A:"N"},{DECK_ID:"A02",ID:"A02020",N:"<div class=\"center\">nitten</div>",E:"<div class=\"center\">19</div>",D:"BASIC NUMBERS",X:"<div class=\"center\"><div class=\"left\">Remember that <b class=\"bold\">double consonants</b> (in this case TT) are mostly pronounced with a <b class=\"bold\">longer sound</b>.</div></div>",A:"N"},{DECK_ID:"A02",ID:"A02021",N:"<div class=\"center\">tjue<br><br>(tyve)</div>",E:"<div class=\"center\">20</div>",D:"BASIC NUMBERS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Tyve</span> is a more conservative form which can still be used.</p> <p>Remember that the sound of TJ is <span class=\"italic\">similar</span> to the <b class=\"bold\">H</b> in \"<b class=\"bold\">h</b>ue\" and \"<b class=\"bold\">h</b>uge\".</p> Saying \"SH\" while smiling will get you close enough.</div></div>",A:"N"},{DECK_ID:"A02",ID:"A02022",N:"<div class=\"center\">tjue\xe9n</div>",E:"<div class=\"center\">21</div>",D:"BASIC NUMBERS",X:"<div class=\"center\"><div class=\"left\"><p>Numbers from 21 to 99 (excluding round figures) also have an \"unofficial\" reading which starts from the units and has <span class=\"italic\">og</span> in between:</p><span class=\"italic\">\xe9nogtjue</span></div></div>",A:"N"},{DECK_ID:"A02",ID:"A02023",N:"<div class=\"center\">tjueto</div>",E:"<div class=\"center\">22</div>",D:"BASIC NUMBERS",X:"<div class=\"center\"><div class=\"left\"><p>Numbers from 21 to 99 (excluding round figures) also have an \"unofficial\" reading which starts from the units and has <span class=\"italic\">og</span> in between:</p><span class=\"italic\">toogtjue</span></div></div>",A:"N"},{DECK_ID:"A02",ID:"A02024",N:"<div class=\"center\">tjuetre</div>",E:"<div class=\"center\">23</div>",D:"BASIC NUMBERS",X:"<div class=\"center\"><div class=\"left\"><p>Numbers from 21 to 99 (excluding round figures) also have an \"unofficial\" reading which starts from the units and has <span class=\"italic\">og</span> in between:</p><span class=\"italic\">treogtjue</span></div></div>",A:"N"},{DECK_ID:"A02",ID:"A02025",N:"<div class=\"center\">tretti<br><br>(tredve)</div>",E:"<div class=\"center\">30</div>",D:"BASIC NUMBERS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">Tredve</span> is an earlier, more conservative form which can still be found.</div></div>",A:"N"},{DECK_ID:"A02",ID:"A02026",N:"<div class=\"center\">tretti\xe9n</div>",E:"<div class=\"center\">31</div>",D:"BASIC NUMBERS",X:"<div class=\"center\"><div class=\"left\"><p>Numbers from 21 to 99 (excluding round figures) also have an \"unofficial\" reading which starts from the units and has <span class=\"italic\">og</span> in between:</p><p><span class=\"italic\">\xe9nogtretti</span></p>In the audio, this reading is combined with the earlier form: <span class=\"italic\">\xe9nogtredve</span></div></div>",A:"N"},{DECK_ID:"A02",ID:"A02027",N:"<div class=\"center\">f\xf8rti</div>",E:"<div class=\"center\">40</div>",D:"BASIC NUMBERS",X:"<div class=\"center\"><div class=\"left\">Pay attention to the sound of R & T when combined.</div></div>",A:"N"},{DECK_ID:"A02",ID:"A02028",N:"<div class=\"center\">f\xf8rtito</div>",E:"<div class=\"center\">42</div>",D:"BASIC NUMBERS",X:"<div class=\"center\"><div class=\"left\"><p>Numbers from 21 to 99 (excluding round figures) also have an \"unofficial\" reading which starts from the units and has <span class=\"italic\">og</span> in between:</p><span class=\"italic\">toogf\xf8rti</span></div></div>",A:"N"},{DECK_ID:"A02",ID:"A02029",N:"<div class=\"center\">femti</div>",E:"<div class=\"center\">50</div>",D:"BASIC NUMBERS",X:"",A:"N"},{DECK_ID:"A02",ID:"A02030",N:"<div class=\"center\">femtitre</div>",E:"<div class=\"center\">53</div>",D:"BASIC NUMBERS",X:"<div class=\"center\"><div class=\"left\"><p>Numbers from 21 to 99 (excluding round figures) also have an \"unofficial\" reading which starts from the units and has <span class=\"italic\">og</span> in between:</p><span class=\"italic\">treogfemti</span></div></div>",A:"N"},{DECK_ID:"A02",ID:"A02031",N:"<div class=\"center\">seksti</div>",E:"<div class=\"center\">60</div>",D:"BASIC NUMBERS",X:"",A:"N"},{DECK_ID:"A02",ID:"A02032",N:"<div class=\"center\">sekstifire</div>",E:"<div class=\"center\">64</div>",D:"BASIC NUMBERS",X:"<div class=\"center\"><div class=\"left\"><p>When the \"unofficial\" reading starts with <span class=\"italic\">fire</span> or <span class=\"italic\">\xe5tte</span>, the final E of either these unit numbers is not pronounced.</p><span class=\"italic\">fireogseksti</span> is read as if it was <span class=\"italic\">firogseksti</span></div></div>",A:"N"},{DECK_ID:"A02",ID:"A02033",N:"<div class=\"center\">sytti</div>",E:"<div class=\"center\">70</div>",D:"BASIC NUMBERS",X:"<div class=\"center\"><div class=\"left\">Note that the Y in this number is effectively pronounced like a short \xd8.</div></div>",A:"N"},{DECK_ID:"A02",ID:"A02034",N:"<div class=\"center\">syttifem</div>",E:"<div class=\"center\">75</div>",D:"BASIC NUMBERS",X:"<div class=\"center\"><div class=\"left\"><p>Numbers from 21 to 99 (excluding round figures) also have an \"unofficial\" reading which starts from the units and has <span class=\"italic\">og</span> in between:</p><p><span class=\"italic\">femogsytti</span></p>Also, remember that the Y in this number is effectively pronounced like a short \xd8.</div></div>",A:"N"},{DECK_ID:"A02",ID:"A02035",N:"<div class=\"center\">\xe5tti</div>",E:"<div class=\"center\">80</div>",D:"BASIC NUMBERS",X:"<div class=\"center\"><div class=\"left\">Remember that <b class=\"bold\">double consonants</b> (in this case TT) are mostly pronounced with a <b class=\"bold\">longer sound</b>.</div></div>",A:"N"},{DECK_ID:"A02",ID:"A02036",N:"<div class=\"center\">\xe5ttiseks</div>",E:"<div class=\"center\">86</div>",D:"BASIC NUMBERS",X:"<div class=\"center\"><div class=\"left\"><p>Numbers from 21 to 99 (excluding round figures) also have an \"unofficial\" reading which starts from the units and has <span class=\"italic\">og</span> in between:</p><span class=\"italic\">seksog\xe5tti</span></div></div>",A:"N"},{DECK_ID:"A02",ID:"A02037",N:"<div class=\"center\">nitti</div>",E:"<div class=\"center\">90</div>",D:"BASIC NUMBERS",X:"<div class=\"center\"><div class=\"left\">Remember that <b class=\"bold\">double consonants</b> (in this case TT) are mostly pronounced with a <b class=\"bold\">longer sound</b>.</div></div>",A:"N"},{DECK_ID:"A02",ID:"A02038",N:"<div class=\"center\">nitti\xe5tte</div>",E:"<div class=\"center\">98</div>",D:"BASIC NUMBERS",X:"<div class=\"center\"><div class=\"left\"><p>When the \"unofficial\" reading starts with <span class=\"italic\">fire</span> or <span class=\"italic\">\xe5tte</span>, the final E of either these unit numbers is not pronounced.</p><span class=\"italic\">\xe5tteognitti</span> is read as if it was <span class=\"italic\">\xe5ttognitti</span>.</div></div>",A:"N"},{DECK_ID:"A02",ID:"A02039",N:"<div class=\"center\">hundre</div>",E:"<div class=\"center\">100</div>",D:"BASIC NUMBERS",X:"<div class=\"center\"><div class=\"left\"><p>Note that <span class=\"italic\">hundre</span> is <span class=\"italic\">intetkj\xf8nn</span> and would require <span class=\"italic\">ett</span> in case you wanted to specify that it is \"<b class=\"bold\">one</b> hundred\".</p>The indefinite plural takes no ending.</div></div>",A:"N"},{DECK_ID:"A02",ID:"A02040",N:"<div class=\"center\">hundre og sju</div>",E:"<div class=\"center\">107</div>",D:"BASIC NUMBERS",X:"<div class=\"center\"><div class=\"left\">After the hundreds, <span class=\"italic\">og</span> is necessary.</div></div>",A:"N"},{DECK_ID:"A02",ID:"A02041",N:"<div class=\"center\">sju hundre og f\xf8rtifem</div>",E:"<div class=\"center\">745</div>",D:"BASIC NUMBERS",X:"<div class=\"center\"><div class=\"left\">After the hundreds, <span class=\"italic\">og</span> is necessary.</div></div>",A:"N"},{DECK_ID:"A02",ID:"A02042",N:"<div class=\"center\">tusen</div>",E:"<div class=\"center\">1 000</div>",D:"BASIC NUMBERS",X:"<div class=\"center\"><div class=\"left\"><p>Note that <span class=\"italic\">tusen</span> is <span class=\"italic\">intetkj\xf8nn</span> and would require <span class=\"italic\">ett</span> in case you wanted to specify that it is \"<b class=\"bold\">one</b> thousand\".</p>The indefinite plural takes no ending.</div></div>",A:"N"},{DECK_ID:"A02",ID:"A02043",N:"<div class=\"center\">to tusen og fjorten</div>",E:"<div class=\"center\">2014</div>",D:"BASIC NUMBERS",X:"<div class=\"center\"><div class=\"left\"><p>After the hundreds, <span class=\"italic\">og</span> is necessary.</p>Numbers referring to years, such as 2010 or 1983, can be read as <span class=\"italic\">tjueti</span> and <span class=\"italic\">nitten\xe5ttitre</span> for simplicity.</div></div>",A:"N"},{DECK_ID:"A02",ID:"A02044",N:"<div class=\"center\">ti tusen</div>",E:"<div class=\"center\">10 000</div>",D:"BASIC NUMBERS",X:"<div class=\"center\"><div class=\"left\">Numbers from ten thousand onwards must be written with a space between the thousands and the hundreds.</div></div>",A:"N"},{DECK_ID:"A02",ID:"A02045",N:"<div class=\"center\">tjue tusen fire hundre og f\xf8rtiseks</div>",E:"<div class=\"center\">20 446</div>",D:"BASIC NUMBERS",X:"<div class=\"center\"><div class=\"left\">Numbers from ten thousand onwards must be written with a space between the thousands and the hundreds.</div></div>",A:"N"},{DECK_ID:"A02",ID:"A02046",N:"<div class=\"center\">hundre tusen</div>",E:"<div class=\"center\">100 000</div>",D:"BASIC NUMBERS",X:"<div class=\"center\"><div class=\"left\">Numbers from ten thousand onwards must be written with a space between the thousands and the hundreds.</div></div>",A:"N"},{DECK_ID:"A02",ID:"A02047",N:"<div class=\"center\">tre hundre tusen</div>",E:"<div class=\"center\">300 000</div>",D:"BASIC NUMBERS",X:"",A:"N"},{DECK_ID:"A02",ID:"A02048",N:"<div class=\"center\">en/\xe9n million</div>",E:"<div class=\"center\"><p>1 000 000</p>(one million)</div>",D:"BASIC NUMBERS",X:"<div class=\"center\"><div class=\"left\"><p>Note how <span class=\"italic\">million</span> is <span class=\"italic\">hankj\xf8nn</span> and requires <span class=\"italic\">en/\xe9n</span> (unlike <span class=\"italic\">hundre</span> and <span class=\"italic\">tusen</span>, which are <span class=\"italic\">intetkj\xf8nn</span>).</p>Remember that <span class=\"italic\">en</span> translates \"a/an\", whilst <span class=\"italic\">\xe9n</span> translates \"one\".</div></div>",A:"N"},{DECK_ID:"A02",ID:"A02049",N:"<div class=\"center\">fire millioner</div>",E:"<div class=\"center\"><p>4 000 000</p>(four millions)</div>",D:"BASIC NUMBERS",X:"<div class=\"center\"><div class=\"left\">The indefinite plural for <span class=\"italic\">million</span> requires -ER</div></div>",A:"N"},{DECK_ID:"A02",ID:"A02050",N:"<div class=\"center\">en/\xe9n milliard</div>",E:"<div class=\"center\"><p>1 000 000 000</p>(one billion)</div>",D:"BASIC NUMBERS",X:"<div class=\"center\"><div class=\"left\"><p>Note how <span class=\"italic\">milliard</span> is <span class=\"italic\">hankj\xf8nn</span> and requires <span class=\"italic\">en/\xe9n</span> (unlike <span class=\"italic\">hundre</span> and <span class=\"italic\">tusen</span>, which are <span class=\"italic\">intetkj\xf8nn</span>).</p>Remember that <span class=\"italic\">en</span> translates \"a/an\", whilst <span class=\"italic\">\xe9n</span> translates \"one\".</div></div>",A:"N"},{DECK_ID:"A03",ID:"A03001",N:"<div class=\"center\">What are the two Norwegian <b class=\"bold\">genders</b>?</div>",E:"<div class=\"center\"><div class=\"left\"><p>There are two main genders (<span class=\"italic\">kj\xf8nn</span>):</p><p><span class=\"italic\">hankj\xf8nn:</span> <b class=\"boldItalic\">en mann</b> (a man)</p><span class=\"italic\">intetkj\xf8nn:</span> <b class=\"boldItalic green\">et barn</b> (a child)</div></div>",D:"TOP 50 NOUNS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Hankj\xf8nn</span> (literally: \"he-gender\") nouns are masculine and they require the indefinite article <b class=\"boldItalic\">en</b>.</p><span class=\"italic\">Intetkj\xf8nn</span> (literally: \"no-gender\") nouns are neuter and they require the indefinite article <b class=\"boldItalic green\">et</b>.</div></div>",A:"E"},{DECK_ID:"A03",ID:"A03002",N:"<div class=\"center\">What is the <b class=\"bold\">indefinite form</b> of nouns?</div>",E:"<div class=\"center\"><div class=\"left\">When referring to a generic object, person or animal, Norwegian uses the indefinite form of nouns, often preceded by the <b class=\"bold\">indefinite article</b>.<br>See the examples below.</div></div>",D:"TOP 50 NOUNS",X:"<div class=\"center\"><div class=\"left\"><p><b class=\"boldItalic\">en gutt</b> (a boy)</p><p><b class=\"boldItalic\">en bil</b> (a car)</p><p><b class=\"boldItalic green\">et hus</b> (a house)</p><b class=\"boldItalic green\">et nummer</b> (a number)</div></div>",A:"X"},{DECK_ID:"A03",ID:"A03003",N:"<div class=\"center\">What is the <b class=\"bold\">definite form</b> of nouns?</div>",E:"<div class=\"center\"><div class=\"left\">When referring to a specific instance of a noun, the<b class=\"bold\"> \"end article\" -EN</b> (or just -N) must be added at the end of <span class=\"italic\">hankj\xf8nn</span> nouns.<br>For <span class=\"italic\">intetkj\xf8nn</span>, the<b class=\"bold green\"> \"end article\"</b> is <b class=\"bold green\">-ET</b> (or just -T).<br>See the examples below, noting how the added T is <b class=\"bold green\">silent</b>.</div></div>",D:"TOP 50 NOUNS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">gutt</span><b class=\"boldItalic\">en</b> (the boy)</p><p><span class=\"italic\">bil</span><b class=\"boldItalic\">en</b> (the car)</p><p><span class=\"italic\">hus</span><b class=\"boldItalic green\">et</b> (the house)</p><span class=\"italic\">nummer</span><b class=\"boldItalic green\">et</b> (the number)</div></div>",A:"X"},{DECK_ID:"A03",ID:"A03004",N:"<div class=\"center\"><div class=\"left\">What are the <b class=\"bold\">plural forms</b> (indefinite and definite) of nouns?</div></div>",E:"<div class=\"center\"><div class=\"left\">Norwegian nouns change for the plural, producing an indefinite plural and a definite plural, usually with endings in, respectively, <b class=\"bold\">-ER and -ENE</b>.</div></div>",D:"TOP 50 NOUNS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">bil</span><b class=\"boldItalic\">er</b> (cars)&emsp;&emsp;&emsp;<span class=\"italic\">bil</span><b class=\"boldItalic\">ene</b> (the cars)</p><p><span class=\"italic\">hus</span> (houses)&emsp;&emsp;<span class=\"italic\">hus</span><b class=\"boldItalic green\">ene</b> (the houses)</p>Some <span class=\"italic\">intetkj\xf8nn</span> nouns (usually monosyllabic) do not take an ending for indefinite plural.</div></div>",A:"X"},{DECK_ID:"A03",ID:"A03005",N:"<div class=\"center\">en dag</div>",E:"<div class=\"center\">a day</div>",D:"TOP 50 NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>The other three forms are:</p><span class=\"italic\">dagen</span>&emsp;(the day)<br><span class=\"italic\">dager</span>&emsp;(days)<br><span class=\"italic\">dagene</span>&emsp;(the days)</div></div>",A:"N"},{DECK_ID:"A03",ID:"A03006",N:"<div class=\"center\">en mann</div>",E:"<div class=\"center\">a man</div>",D:"TOP 50 NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>Irregular. The other three forms are:</p><span class=\"italic\">mannen</span>&emsp;(the man)<br><span class=\"italic\">menn</span>&emsp;&emsp;(men)<br><span class=\"italic\">mennene</span>&emsp;(the men)</div></div>",A:"N"},{DECK_ID:"A03",ID:"A03007",N:"<div class=\"center\">et barn</div>",E:"<div class=\"center\">a child</div>",D:"TOP 50 NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>These are the other three forms, note that the definite plural ends in -A:</p><span class=\"italic\">barnet</span>&emsp;(the child)<br><span class=\"italic\">barn</span>&emsp;(children)<br><span class=\"italic\">barna</span>&emsp;(the children)</div></div>",A:"N"},{DECK_ID:"A03",ID:"A03008",N:"<div class=\"center\"><div class=\"left\">What is the third gender of Norwegian, the feminine (<span class=\"italic\">hunkj\xf8nn</span>)?</div></div>",E:"<div class=\"center\"><div class=\"left\"><p>It's a gender that can be used for certain masculine nouns. It requires the indefinite article <b class=\"bold\">ei</b>.</p><p>The definite singular takes <b class=\"bold\">-A</b> at the end.</p>Plural forms remain in -ER and -ENE.</div></div>",D:"TOP 50 NOUNS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">ei datter, dattera</span> (a daughter, the daughter)</p><p><span class=\"italic\">ei jente, jenta</span> (a girl, the girl)</p>The feminine gender is stylistic. It is never a mistake to use masculine instead.</div></div>",A:"X"},{DECK_ID:"A03",ID:"A03009",N:"<div class=\"center\">en kvinne</div>",E:"<div class=\"center\">a woman</div>",D:"TOP 50 NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>The other three forms are:</p><p><span class=\"italic\">kvinnen</span>&emsp;(the woman)<br><span class=\"italic\">kvinner</span>&emsp;(women)<br><span class=\"italic\">kvinnene</span>&emsp;(the women).</p>With feminine gender:<br><span class=\"italic\">ei kvinne, kvinna, kvinner, kvinnene</span></div></div>",A:"N"},{DECK_ID:"A03",ID:"A03010",N:"<div class=\"center\">et hus</div>",E:"<div class=\"center\">a house</div>",D:"TOP 50 NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>The other three forms are:</p><p><span class=\"italic\">huset</span>&emsp;(the house)<br><span class=\"italic\">hus</span>&emsp;(houses)<br><span class=\"italic\">husene</span>&emsp;(the houses)</p>Monosyllabic <span class=\"italic\">intetkj\xf8nn</span> nouns tend to remain unchanged for indefinite plural.</div></div>",A:"N"},{DECK_ID:"A03",ID:"A03011",N:"<div class=\"center\">en person</div>",E:"<div class=\"center\">a person</div>",D:"TOP 50 NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>The other three forms are:</p><span class=\"italic\">personen</span>&emsp;(the person)<br><span class=\"italic\">personer</span>&emsp;(people)<br><span class=\"italic\">personene</span>&emsp;(the people)</div></div>",A:"N"},{DECK_ID:"A03",ID:"A03012",N:"<div class=\"center\">mandag</div>",E:"<div class=\"center\">Monday</div>",D:"TOP 50 NOUNS",X:"<div class=\"center\">No uppercase initial in Norwegian</div>",A:"N"},{DECK_ID:"A03",ID:"A03013",N:"<div class=\"center\">tirsdag</div>",E:"<div class=\"center\">Tuesday</div>",D:"TOP 50 NOUNS",X:"<div class=\"center\">No uppercase initial in Norwegian</div>",A:"N"},{DECK_ID:"A03",ID:"A03014",N:"<div class=\"center\">onsdag</div>",E:"<div class=\"center\">Wednesday</div>",D:"TOP 50 NOUNS",X:"<div class=\"center\">No uppercase initial in Norwegian</div>",A:"N"},{DECK_ID:"A03",ID:"A03015",N:"<div class=\"center\">torsdag</div>",E:"<div class=\"center\">Thursday</div>",D:"TOP 50 NOUNS",X:"<div class=\"center\">No uppercase initial in Norwegian</div>",A:"N"},{DECK_ID:"A03",ID:"A03016",N:"<div class=\"center\">fredag</div>",E:"<div class=\"center\">Friday</div>",D:"TOP 50 NOUNS",X:"<div class=\"center\">No uppercase initial in Norwegian</div>",A:"N"},{DECK_ID:"A03",ID:"A03017",N:"<div class=\"center\">l\xf8rdag</div>",E:"<div class=\"center\">Saturday</div>",D:"TOP 50 NOUNS",X:"<div class=\"center\">No uppercase initial in Norwegian</div>",A:"N"},{DECK_ID:"A03",ID:"A03018",N:"<div class=\"center\">s\xf8ndag</div>",E:"<div class=\"center\">Sunday</div>",D:"TOP 50 NOUNS",X:"<div class=\"center\">No uppercase initial in Norwegian</div>",A:"N"},{DECK_ID:"A03",ID:"A03019",N:"<div class=\"center\">en jobb</div>",E:"<div class=\"center\">a job</div>",D:"TOP 50 NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>The other three forms are:</p><span class=\"italic\">jobben</span>&emsp;(the job)<br><span class=\"italic\">jobber</span>&emsp;(jobs)<br><span class=\"italic\">jobbene</span>&emsp;(the jobs)</div></div>",A:"N"},{DECK_ID:"A03",ID:"A03020",N:"<div class=\"center\">ei jente</div>",E:"<div class=\"center\">a girl</div>",D:"TOP 50 NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>Used preferably in feminine:</p><span class=\"italic\">jenta</span>&emsp;(the girl)<br><span class=\"italic\">jenter</span>&emsp;(girls)<br><span class=\"italic\">jentene</span>&emsp;(the girls)</div></div>",A:"N"},{DECK_ID:"A03",ID:"A03021",N:"<div class=\"center\">en gutt</div>",E:"<div class=\"center\">a boy</div>",D:"TOP 50 NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>The other three forms are:</p><p><span class=\"italic\">gutten</span>&emsp;(the boy)<br><span class=\"italic\">gutter</span>&emsp;(boys)<br><span class=\"italic\">guttene</span>&emsp;(the boys)</p>The variation <span class=\"italic\">gutta</span> is sometimes used for \"the boys\".</div></div>",A:"N"},{DECK_ID:"A03",ID:"A03022",N:"<div class=\"center\">en buss</div>",E:"<div class=\"center\">a bus</div>",D:"TOP 50 NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>The other three forms are:</p><span class=\"italic\">bussen</span>&emsp;(the bus)<br><span class=\"italic\">busser</span>&emsp;(buses)<br><span class=\"italic\">bussene</span>&emsp;(the buses)</div></div>",A:"N"},{DECK_ID:"A03",ID:"A03023",N:"<div class=\"center\">penger</div>",E:"<div class=\"center\">money</div>",D:"TOP 50 NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>Only used in the plural form, hence the -ER ending.</p>The definite plural form is <span class=\"italic\">pengene</span> (the money).</div></div>",A:"N"},{DECK_ID:"A03",ID:"A03024",N:"<div class=\"center\">et hjem</div>",E:"<div class=\"center\">a home</div>",D:"TOP 50 NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>The other three forms are:</p><p><span class=\"italic\">hjemmet</span>&emsp;(the home)<br><span class=\"italic\">hjem</span>&emsp;(homes)<br><span class=\"italic\">hjemmene</span>&emsp;(the homes)</p>The form <span class=\"italic\">hjemme</span> means \"at home\".</div></div>",A:"N"},{DECK_ID:"A03",ID:"A03025",N:"<div class=\"center\">en billett</div>",E:"<div class=\"center\">a ticket</div>",D:"TOP 50 NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>The other three forms are:</p><span class=\"italic\">billetten</span>&emsp;(the ticket)<br><span class=\"italic\">billetter</span>&emsp;(tickets)<br><span class=\"italic\">billettene</span>&emsp;(the tickets)</div></div>",A:"N"},{DECK_ID:"A03",ID:"A03026",N:"<div class=\"center\">en leilighet</div>",E:"<div class=\"center\">an apartment, a flat</div>",D:"TOP 50 NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>The other three forms are:</p><p><span class=\"italic\">leiligheten</span>&emsp;(the flat)<br><span class=\"italic\">leiligheter</span>&emsp;(flats)<br><span class=\"italic\">leilighetene</span>&emsp;(the flats).</p>Note that the G is silent.</div></div>",A:"N"},{DECK_ID:"A03",ID:"A03027",N:"<div class=\"center\">en venn</div>",E:"<div class=\"center\">a friend</div>",D:"TOP 50 NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>The other three forms are:</p><span class=\"italic\">vennen</span>&emsp;(the friend)<br><span class=\"italic\">venner</span>&emsp;(friends)<br><span class=\"italic\">vennene</span>&emsp;(the friends)</div></div>",A:"N"},{DECK_ID:"A03",ID:"A03028",N:"<div class=\"center\">et nummer</div>",E:"<div class=\"center\">a number</div>",D:"TOP 50 NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>Slightly irregular. The other three forms are:</p><span class=\"italic\">nummeret</span>&emsp;(the number)<br><span class=\"italic\">numre</span>&emsp;(numbers)<br><span class=\"italic\">numrene</span>&emsp;(the numbers)</div></div>",A:"N"},{DECK_ID:"A03",ID:"A03029",N:"<div class=\"center\">en frokost</div>",E:"<div class=\"center\">a breakfast</div>",D:"TOP 50 NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>The other three forms are:</p><span class=\"italic\">frokosten</span>&emsp;(the breakfast)<br><span class=\"italic\">frokoster</span>&emsp;(breakfasts)<br><span class=\"italic\">frokostene</span>&emsp;(the breakfasts)</div></div>",A:"N"},{DECK_ID:"A03",ID:"A03030",N:"<div class=\"center\">en lunsj</div>",E:"<div class=\"center\">a lunch</div>",D:"TOP 50 NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>The other three forms are:</p><span class=\"italic\">lunsjen</span>&emsp;(the lunch)<br><span class=\"italic\">lunsjer</span>&emsp;(lunches)<br><span class=\"italic\">lunsjene</span>&emsp;(the lunches)</div></div>",A:"N"},{DECK_ID:"A03",ID:"A03031",N:"<div class=\"center\">en middag</div>",E:"<div class=\"center\">a dinner</div>",D:"TOP 50 NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>The other three forms are:</p><span class=\"italic\">middagen</span>&emsp;(the dinner)<br><span class=\"italic\">middager</span>&emsp;(dinners)<br><span class=\"italic\">middagene</span>&emsp;(the dinners)</div></div>",A:"N"},{DECK_ID:"A03",ID:"A03032",N:"<div class=\"center\">en student</div>",E:"<div class=\"center\">a student</div>",D:"TOP 50 NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>The other three forms are:</p><span class=\"italic\">studenten</span>&emsp;(the student)<br><span class=\"italic\">studenter</span>&emsp;(students)<br><span class=\"italic\">studentene</span>&emsp;(the students)</div></div>",A:"N"},{DECK_ID:"A03",ID:"A03033",N:"<div class=\"center\">en l\xe6rer</div>",E:"<div class=\"center\">a teacher</div>",D:"TOP 50 NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>Slightly irregular. The other three forms are:</p><span class=\"italic\">l\xe6reren</span>&emsp;(the teacher)<br><span class=\"italic\">l\xe6rere</span>&emsp;(teachers)<br><span class=\"italic\">l\xe6rerne</span>&emsp;(the teachers)</div></div>",A:"N"},{DECK_ID:"A03",ID:"A03034",N:"<div class=\"center\">en skole</div>",E:"<div class=\"center\">a school</div>",D:"TOP 50 NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>The other three forms are:</p><span class=\"italic\">skolen</span>&emsp;(the school)<br><span class=\"italic\">skoler</span>&emsp;(schools)<br><span class=\"italic\">skolene</span>&emsp;(the schools)</div></div>",A:"N"},{DECK_ID:"A03",ID:"A03035",N:"<div class=\"center\">et tog</div>",E:"<div class=\"center\">a train</div>",D:"TOP 50 NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>The other three forms are:</p><p><span class=\"italic\">toget</span>&emsp;(the train)<br><span class=\"italic\">tog</span>&emsp;(trains)<br><span class=\"italic\">togene</span>&emsp;(the trains)</p>Monosyllabic <span class=\"italic\">intetkj\xf8nn</span> nouns tend to remain unchanged for indefinite plural.</div></div>",A:"N"},{DECK_ID:"A03",ID:"A03036",N:"<div class=\"center\">en sykkel</div>",E:"<div class=\"center\">a bicycle</div>",D:"TOP 50 NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>Slightly irregular. The other three forms are:</p><span class=\"italic\">sykkelen</span>&emsp;(the bicycle)<br><span class=\"italic\">sykler</span>&emsp;(bicycles)<br><span class=\"italic\">syklene</span>&emsp;(the bicycles)</div></div>",A:"N"},{DECK_ID:"A03",ID:"A03037",N:"<div class=\"center\">en bil</div>",E:"<div class=\"center\">a car, an automobile</div>",D:"TOP 50 NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>The other three forms are:</p><span class=\"italic\">bilen</span>&emsp;(the car)<br><span class=\"italic\">biler</span>&emsp;(cars)<br><span class=\"italic\">bilene</span>&emsp;(the cars)</div></div>",A:"N"},{DECK_ID:"A03",ID:"A03038",N:"<div class=\"center\">en trikk</div>",E:"<div class=\"center\">a tram, a streetcar</div>",D:"TOP 50 NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>The other three forms are:</p><span class=\"italic\">trikken</span>&emsp;(the tram)<br><span class=\"italic\">trikker</span>&emsp;(trams)<br><span class=\"italic\">trikkene</span>&emsp;(the trams)</div></div>",A:"N"},{DECK_ID:"A03",ID:"A03039",N:"<div class=\"center\">ei uke</div>",E:"<div class=\"center\">a week</div>",D:"TOP 50 NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>Used preferably in feminine:</p><span class=\"italic\">uka</span>&emsp;(the week)<br><span class=\"italic\">uker</span>&emsp;(weeks)<br><span class=\"italic\">ukene</span>&emsp;(the weeks)</div></div>",A:"N"},{DECK_ID:"A03",ID:"A03040",N:"<div class=\"center\">et \xe5r</div>",E:"<div class=\"center\">a year</div>",D:"TOP 50 NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>The other three forms are:</p><p><span class=\"italic\">\xe5ret</span>&emsp;(the year)<br><span class=\"italic\">\xe5r</span>&emsp;(years)<br><span class=\"italic\">\xe5rene</span>&emsp;(the years)</p>Monosyllabic <span class=\"italic\">intetkj\xf8nn</span> nouns tend to remain unchanged for indefinite plural.</div></div>",A:"N"},{DECK_ID:"A03",ID:"A03041",N:"<div class=\"center\">en time</div>",E:"<div class=\"center\">an hour</div>",D:"TOP 50 NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>The other three forms are:</p><span class=\"italic\">timen</span>&emsp;(the hour)<br><span class=\"italic\">timer</span>&emsp;(hours)<br><span class=\"italic\">timene</span>&emsp;(the hours)</div></div>",A:"N"},{DECK_ID:"A03",ID:"A03042",N:"<div class=\"center\">et minutt</div>",E:"<div class=\"center\">a minute</div>",D:"TOP 50 NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>The other three forms are:</p><span class=\"italic\">minuttet</span>&emsp;(the minute)<br><span class=\"italic\">minutter</span>&emsp;(minutes)<br><span class=\"italic\">minuttene</span>&emsp;(the minutes)</div></div>",A:"N"},{DECK_ID:"A03",ID:"A03043",N:"<div class=\"center\">en morgen</div>",E:"<div class=\"center\">a morning</div>",D:"TOP 50 NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>The other three forms are:</p><span class=\"italic\">morgenen</span>&emsp;(the morning)<br><span class=\"italic\">morgener</span>&emsp;(mornings)<br><span class=\"italic\">morgenene</span>&emsp;(the mornings)</div></div>",A:"N"},{DECK_ID:"A03",ID:"A03044",N:"<div class=\"center\">en ettermiddag</div>",E:"<div class=\"center\">an afternoon</div>",D:"TOP 50 NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>The other three forms are:</p><span class=\"italic\">ettermiddagen</span>&emsp;(the afternoon)<br><span class=\"italic\">ettermiddager</span>&emsp;(afternoons)<br><span class=\"italic\">ettermiddagene</span>&emsp;(the afternoons)</div></div>",A:"N"},{DECK_ID:"A03",ID:"A03045",N:"<div class=\"center\">en kveld</div>",E:"<div class=\"center\">an evening</div>",D:"TOP 50 NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>The other three forms are:</p><span class=\"italic\">kvelden</span>&emsp;(the evening)<br><span class=\"italic\">kvelder</span>&emsp;(evenings)<br><span class=\"italic\">kveldene</span>&emsp;(the evenings)</div></div>",A:"N"},{DECK_ID:"A03",ID:"A03046",N:"<div class=\"center\">en \xf8l</div>",E:"<div class=\"center\">a (glass of) beer</div>",D:"TOP 50 NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>The other three forms are:</p><span class=\"italic\">\xf8len</span>&emsp;(the beer)<br><span class=\"italic\">\xf8l</span>&emsp;(beers)<br><span class=\"italic\">\xf8lene</span>&emsp;(the beers)</div></div>",A:"N"},{DECK_ID:"A03",ID:"A03047",N:"<div class=\"center\">ei p\xf8lse</div>",E:"<div class=\"center\">a sausage, a w\xfcrstel</div>",D:"TOP 50 NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>Used preferably in feminine:</p><span class=\"italic\">p\xf8lsa</span>&emsp;(the sausage)<br><span class=\"italic\">p\xf8lser</span>&emsp;(sausages)<br><span class=\"italic\">p\xf8lsene</span>&emsp;(the sausages)</div></div>",A:"N"},{DECK_ID:"A03",ID:"A03048",N:"<div class=\"center\">mat</div>",E:"<div class=\"center\">food</div>",D:"TOP 50 NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>Uncountable noun, mostly used in singular.</p>The definite singular form is <span class=\"italic\">maten</span> (the food).</div></div>",A:"N"},{DECK_ID:"A03",ID:"A03049",N:"<div class=\"center\">et rom</div>",E:"<div class=\"center\">a room</div>",D:"TOP 50 NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>The other three forms are:</p><p><span class=\"italic\">rommet</span>&emsp;(the room)<br><span class=\"italic\">rom</span>&emsp;(rooms)<br><span class=\"italic\">rommene</span>&emsp;(the rooms)</p>Monosyllabic <span class=\"italic\">intetkj\xf8nn</span> nouns tend to remain unchanged for indefinite plural.</div></div>",A:"N"},{DECK_ID:"A03",ID:"A03050",N:"<div class=\"center\">en vei</div>",E:"<div class=\"center\">a road, a street, a way</div>",D:"TOP 50 NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>The other three forms are:</p><span class=\"italic\">veien</span>&emsp;(the road)<br><span class=\"italic\">veier</span>&emsp;(roads)<br><span class=\"italic\">veiene</span>&emsp;(the roads)</div></div>",A:"N"},{DECK_ID:"A03",ID:"A03051",N:"<div class=\"center\">en lege</div>",E:"<div class=\"center\">a doctor</div>",D:"TOP 50 NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>The other three forms are:</p><span class=\"italic\">legen</span>&emsp;(the doctor)<br><span class=\"italic\">leger</span>&emsp;(doctors)<br><span class=\"italic\">legene</span>&emsp;(the doctors)</div></div>",A:"N"},{DECK_ID:"A03",ID:"A03052",N:"<div class=\"center\">en by</div>",E:"<div class=\"center\">a town, a city</div>",D:"TOP 50 NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>The other three forms are:</p><span class=\"italic\">byen</span>&emsp;(the town)<br><span class=\"italic\">byer</span>&emsp;(towns)<br><span class=\"italic\">byene</span>&emsp;(the towns)</div></div>",A:"N"},{DECK_ID:"A03",ID:"A03053",N:"<div class=\"center\">et liv</div>",E:"<div class=\"center\">a life</div>",D:"TOP 50 NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>The other three forms are:</p><p><span class=\"italic\">livet</span>&emsp;(the life)<br><span class=\"italic\">liv</span>&emsp;(lives)<br><span class=\"italic\">livene</span>&emsp;(the lives)</p>Monosyllabic <span class=\"italic\">intetkj\xf8nn</span> nouns tend to remain unchanged for indefinite plural.</div></div>",A:"N"},{DECK_ID:"A03",ID:"A03054",N:"<div class=\"center\">tid</div>",E:"<div class=\"center\">time</div>",D:"TOP 50 NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>Uncountable noun, mostly used in singular.</p><p>The definite singular form is <span class=\"italic\">tiden</span> (the time) or <span class=\"italic\">tida</span> (<span class=\"italic\">hunkj\xf8nn</span>).</p>The D at the end is often, but not always, silent.</div></div>",A:"N"},{DECK_ID:"A03",ID:"A03055",N:"<div class=\"center\">et land</div>",E:"<div class=\"center\">a country, a land</div>",D:"TOP 50 NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>The other three forms are:</p><p><span class=\"italic\">landet</span>&emsp;(the country)<br><span class=\"italic\">land</span>&emsp;(countries)<br><span class=\"italic\">landene</span>&emsp;(the countries)</p>Monosyllabic <span class=\"italic\">intetkj\xf8nn</span> nouns tend to remain unchanged for indefinite plural.</div></div>",A:"N"},{DECK_ID:"A04",ID:"A04001",N:"<div class=\"center\"><div class=\"left\">What are the <b class=\"bold\">subject pronouns</b> (I, you, she etc) in Norwegian?</div></div>",E:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">jeg</span>&emsp;&emsp;&emsp;(I)<br><span class=\"italic\">du</span>&emsp;&emsp;&emsp;(you, singular)<br><span class=\"italic\">han</span>&ensp;&emsp;&emsp;(he)<br><span class=\"italic\">hun</span>&ensp;&emsp;&emsp;(she)<br><span class=\"italic\">den/det</span>&emsp;(it)</p><span class=\"italic\">vi</span>&emsp;&emsp;&emsp;&emsp;(we)<br><span class=\"italic\">dere</span>&emsp;&emsp;&ensp;(you, plural)<br><span class=\"italic\">de</span>&emsp;&emsp;&emsp;&ensp;(they)</div></div>",D:"TOP 40 VERBS",X:"<div class=\"center\"><div class=\"left\">Remember that <span class=\"italic\">de</span> is pronounced DEE and that the T at the end of <span class=\"italic\">det</span> is silent.</div></div>",A:"E"},{DECK_ID:"A04",ID:"A04002",N:"<div class=\"center\"><div class=\"left\">How many forms are there in the <b class=\"bold\">paradigm</b> of most Norwegian verbs?</div></div>",E:"<div class=\"center\"><div class=\"left\"><p>A bit like in English, the paradigm has <b class=\"bold\">four forms</b>:</p><p><span class=\"italic\">\xe5 spise, spiser, spiste, har spist</span></p>to eat, eat, ate, have eaten</div></div>",D:"TOP 40 VERBS",X:"<div class=\"center\"><div class=\"left\"><p>The forms are called: infinitive, present, simple past, present perfect.</p>Their Norwegian names are <span class=\"italic\">infinitiv, presens, preteritum, presens perfektum</span>.</div></div>",A:"E"},{DECK_ID:"A04",ID:"A04003",N:"<div class=\"center\">\xe5 v\xe6re<br>er<br>var<br>har v\xe6rt</div>",E:"<div class=\"center\">to be<br>am/are/is<br>was/were<br>have/has been</div>",D:"TOP 40 VERBS",X:"<div class=\"center\"><div class=\"left\">Note that although the last element of the paradigm in English is the past participle alone, for Norwegian we prefer to use the present perfect (i.e. have + past participle) to make you more acquainted with that tense.</div></div>",A:"N"},{DECK_ID:"A04",ID:"A04004",N:"<div class=\"center\">\xe5 ha<br>har<br>hadde<br>har hatt</div>",E:"<div class=\"center\">to have<br>have/has<br>had<br>have/has had</div>",D:"TOP 40 VERBS",X:"<div class=\"center\"><div class=\"left\">Note that although the last element of the paradigm in English is the past participle alone, for Norwegian we prefer to use the present perfect (i.e. have + past participle) to make you more acquainted with that tense.</div></div>",A:"N"},{DECK_ID:"A04",ID:"A04005",N:"<div class=\"center\"><div class=\"left\">How can you recognise the basic verb forms?</div></div>",E:"<div class=\"center\"><div class=\"left\"><p>The <b class=\"bold\">present tense</b> almost always <b class=\"bold\">ends in -R</b>.</p><p>The <b class=\"bold\">infinitive</b> is characterised by an <b class=\"bold\">\xe5</b> before, which is the \"to\" of English.</p>Finally, <b class=\"bold\">past forms</b> tend to have <b class=\"bold\">D</b> or <b class=\"bold\">T</b> in their last syllable.</div></div>",D:"TOP 40 VERBS",X:"<div class=\"center\"><div class=\"left\"><p>Present:<br><span class=\"italic\">Jeg </span><b class=\"boldItalic\">heter</b> Therese (My name is Therese)</p><p>Infinitive:<br><span class=\"italic\">Hun liker </span><b class=\"boldItalic\">\xe5 danse</b> (She likes to dance)</p>Simple past:<br><span class=\"italic\">Han </span><b class=\"boldItalic\">bodde</b> i Paris i fjor (He lived in Paris last year)</div></div>",A:"X"},{DECK_ID:"A04",ID:"A04006",N:"<div class=\"center\">What are modal verbs?</div>",E:"<div class=\"center\"><div class=\"left\"><p>They are verbs expressing intention, possibility, obligation etc.<br>Norwegian has five main modal verbs:</p><span class=\"italic\">skal</span>&nbsp;&nbsp; (shall/will)<br><span class=\"italic\">kan</span>&nbsp;&nbsp;&nbsp;(can)<br><span class=\"italic\">m\xe5</span>&nbsp;&nbsp;&nbsp;&nbsp;(must)<br><span class=\"italic\">vil</span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;(want to)<br><span class=\"italic\">b\xf8r</span>&nbsp;&nbsp;&nbsp;&nbsp;(ought to/should)</div></div>",D:"TOP 40 VERBS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">skal:</span><br><span class=\"italic\">Jeg skal flytte til Norge</span>&nbsp;&nbsp;&nbsp;(I'll move to Norway)</p><p><span class=\"italic\">kan:</span><br><span class=\"italic\">De kan gj\xf8re det</span>&nbsp;&nbsp;&nbsp;(They can do that)</p><span class=\"italic\">m\xe5:</span><br><span class=\"italic\">Vi m\xe5 stikke n\xe5</span>&nbsp;&nbsp;&nbsp;(We must leave now)</div></div>",A:"X"},{DECK_ID:"A04",ID:"A04007",N:"<div class=\"center\">kan, kunne</div>",E:"<div class=\"center\">can, could</div>",D:"TOP 40 VERBS",X:"<div class=\"center\"><div class=\"left\">Other tenses are possible for this Norwegian verb but we'll show them to you later, as they are not part of common usage.</div></div>",A:"N"},{DECK_ID:"A04",ID:"A04008",N:"<div class=\"center\">vil, ville</div>",E:"<div class=\"center\"><p>want, wanted</p>will, would</div>",D:"TOP 40 VERBS",X:"<div class=\"center\"><div class=\"left\"><p>The verb <span class=\"italic\">vil, ville</span> translates \"to want (to)\" and, rarely, the auxiliary \"will/would\":</p><p>I want to go home<br><span class=\"italic\">Jeg vil g\xe5 hjem</span></p>It would have been nice!<br><span class=\"italic\">Det ville ha v\xe6rt hyggelig!</span></div></div>",A:"N"},{DECK_ID:"A04",ID:"A04009",N:"<div class=\"center\">skal, skulle</div>",E:"<div class=\"center\">shall, should</div>",D:"TOP 40 VERBS",X:"<div class=\"center\"><div class=\"left\"><p>The verb <span class=\"italic\">skal, skulle</span> translates \"shall/will\" and \"should\":</p><p>I will go home soon<br><span class=\"italic\">Jeg skal g\xe5 hjem snart</span></p>We should do that<br><span class=\"italic\">Vi skulle gj\xf8re det</span></div></div>",A:"N"},{DECK_ID:"A04",ID:"A04010",N:"<div class=\"center\">m\xe5, m\xe5tte</div>",E:"<div class=\"center\">must/have to, had to</div>",D:"TOP 40 VERBS",X:"<div class=\"center\"><div class=\"left\">Note how the verb <span class=\"italic\">m\xe5</span> has its own simple past, whereas English uses \"had to\".</div></div>",A:"N"},{DECK_ID:"A04",ID:"A04011",N:"<div class=\"center\"><div class=\"left\">How can you identify the various verbal forms?</div></div>",E:"<div class=\"center\"><div class=\"left\">Their endings tend to have recurring letters, such as -ER or -R for the present, E or other vowels for the (bare) infinitive, and often D and T for the past forms.</div></div>",D:"TOP 40 VERBS",X:"<div class=\"center\"><div class=\"left\"><p><b class=\"bold\">Present</b>: mostly ends in <b class=\"bold\">-ER or -R</b><br><span class=\"italic\">er, har, gj\xf8r, bor, spiser, reiser</span></p><p><b class=\"bold\">Infinitive</b>: mostly ends in <b class=\"bold\">-E or a vowel</b><br><span class=\"italic\">v\xe6re, ha, gj\xf8re, bo, spise, reise</span></p><b class=\"bold\">Simple past</b>: often ends in <b class=\"bold\">-DE, -ET or -TE</b><br><span class=\"italic\">var, hadde, gjorde, snakket, spiste, reiste</span></div></div>",A:"X"},{DECK_ID:"A04",ID:"A04012",N:"<div class=\"center\">\xe5 vite<br>vet<br>visste<br>har visst</div>",E:"<div class=\"center\"><p>to know<br>knew<br>have known</p><div class=\"left\">(in the sense of having knowledge of something factual)</div></div>",D:"TOP 40 VERBS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Jeg vet ikke om det er gratis parkering</span></p><p>I don't know if there is free parking</p>Note that <span class=\"italic\">det er</span> (i.e. \"it is\") also means \"there is / there are\".</div></div>",A:"N"},{DECK_ID:"A04",ID:"A04013",N:"<div class=\"center\">\xe5 komme<br>kommer<br>kom<br>har kommet</div>",E:"<div class=\"center\">to come<br>came<br>have come</div>",D:"TOP 40 VERBS",X:"",A:"N"},{DECK_ID:"A04",ID:"A04014",N:"<div class=\"center\">\xe5 se<br>ser<br>s\xe5<br>har sett</div>",E:"<div class=\"center\">to see<br>saw<br>have seen</div>",D:"TOP 40 VERBS",X:"",A:"N"},{DECK_ID:"A04",ID:"A04015",N:"<div class=\"center\">\xe5 gj\xf8re<br>gj\xf8r<br>gjorde<br>har gjort</div>",E:"<div class=\"center\">to do<br>did<br>have done</div>",D:"TOP 40 VERBS",X:"<div class=\"center\"><div class=\"left\"><p>The verb <span class=\"italic\">\xe5 gj\xf8re</span> is not used as the auxiliary verb for negations and questions.</p>Remember that the initial G is silent when followed by a J.</div></div>",A:"N"},{DECK_ID:"A04",ID:"A04016",N:"<div class=\"center\">\xe5 ta<br>tar<br>tok<br>har tatt</div>",E:"<div class=\"center\">to take<br>took<br>have taken</div>",D:"TOP 40 VERBS",X:"",A:"N"},{DECK_ID:"A04",ID:"A04017",N:"<div class=\"center\">\xe5 f\xe5<br>f\xe5r<br>fikk<br>har f\xe5tt</div>",E:"<div class=\"center\"><p>to get, got, have got</p>also: may, to get to</div>",D:"TOP 40 VERBS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Jeg fikk svaret akkurat n\xe5</span><br>I got the answer just now</p><p><span class=\"italic\">F\xe5r jeg komme inn?</span><br>May I come in?</p><span class=\"italic\">Jeg fikk ikke sove</span><br>I didn't get to sleep</div></div>",A:"N"},{DECK_ID:"A04",ID:"A04018",N:"<div class=\"center\">\xe5 synes<br>synes<br>syntes<br>har syntes</div>",E:"<div class=\"center\">to think<br>thought<br>have thought</div>",D:"TOP 40 VERBS",X:"<div class=\"center\"><div class=\"left\"><p>Peculiar verb with -S ending. Used to express an opinion based on some evidence, an experience or a sensation:</p><span class=\"italic\">Jeg synes maten er god</span><br>(i.e. I have tasted the food and, in my opinion, it is good)</div></div>",A:"N"},{DECK_ID:"A04",ID:"A04019",N:"<div class=\"center\">\xe5 tro<br>tror<br>trodde<br>har trodd</div>",E:"<div class=\"center\">to believe<br>believed<br>have believed</div>",D:"TOP 40 VERBS",X:"<div class=\"center\"><div class=\"left\"><p>Used to express an opinion based on pure belief or speculation:</p><span class=\"italic\">Jeg tror at det er kaldt ute</span><br>(i.e. I have no way to know whether it's cold or not outside, but I believe it is)</div></div>",A:"N"},{DECK_ID:"A04",ID:"A04020",N:"<div class=\"center\">\xe5 g\xe5<br>g\xe5r<br>gikk<br>har g\xe5tt</div>",E:"<div class=\"center\">to go (by walking)<br>went<br>have gone</div>",D:"TOP 40 VERBS",X:"<div class=\"center\"><div class=\"left\">Note that the G in <span class=\"italic\">gikk</span> is basically pronounced as a J</div></div>",A:"N"},{DECK_ID:"A04",ID:"A04021",N:"<div class=\"center\">\xe5 si<br>sier<br>sa<br>har sagt</div>",E:"<div class=\"center\">to say<br>said<br>have said</div>",D:"TOP 40 VERBS",X:"<div class=\"center\"><div class=\"left\">Note that the G in <span class=\"italic\">sagt</span> is basically pronounced as a K</div></div>",A:"N"},{DECK_ID:"A04",ID:"A04022",N:"<div class=\"center\">\xe5 trenge<br>trenger<br>trengte<br>har trengt</div>",E:"<div class=\"center\">to need<br>needed<br>have needed</div>",D:"TOP 40 VERBS",X:"<div class=\"center\">Jeg trenger \xe5 spise</div>",A:"N"},{DECK_ID:"A04",ID:"A04023",N:"<div class=\"center\">\xe5 bli<br>blir<br>ble<br>har blitt</div>",E:"<div class=\"center\">to become<br>became<br>have become</div>",D:"TOP 40 VERBS",X:"<div class=\"center\"><div class=\"left\"><p>A very important verb used for passive constructions, with a meaning at times similar to \"to get\":</p><span class=\"italic\">Han ble drept</span><br>He got killed</div></div>",A:"N"},{DECK_ID:"A04",ID:"A04024",N:"<div class=\"center\">\xe5 gi<br>gir<br>gav<br>har gitt</div>",E:"<div class=\"center\">to give<br>gave<br>have given</div>",D:"TOP 40 VERBS",X:"<div class=\"center\"><div class=\"left\">The V in the <span class=\"italic\">preteritum</span> form is optional in both writing and pronunciation.</div></div>",A:"N"},{DECK_ID:"A04",ID:"A04025",N:"<div class=\"center\">\xe5 bo<br>bor<br>bodde<br>har bodd</div>",E:"<div class=\"center\"><p>to live<br>lived<br>have lived</p>(in the geographical sense)</div>",D:"TOP 40 VERBS",X:"<div class=\"center\"><div class=\"left\">The verb <span class=\"italic\">\xe5 bo</span> basically means \"to have residence\".</div></div>",A:"N"},{DECK_ID:"A04",ID:"A04026",N:"<div class=\"center\">\xe5 la<br>lar<br>lot<br>har latt</div>",E:"<div class=\"center\"><p>to let<br>let<br>have let</p>(as in \"to allow\")</div>",D:"TOP 40 VERBS",X:"<div class=\"center\"><div class=\"left\"><p>The verb <span class=\"italic\">\xe5 la</span> (to let) supports the bare infinitive (i.e. infinitive without <span class=\"italic\">\xe5</span>):</p><span class=\"italic\">La oss spise!</span><br>Let's eat!</div></div>",A:"N"},{DECK_ID:"A04",ID:"A04027",N:"<div class=\"center\">\xe5 like<br>liker<br>likte<br>har likt</div>",E:"<div class=\"center\">to like<br>liked<br>have liked</div>",D:"TOP 40 VERBS",X:"<div class=\"center\"><div class=\"left\"><p>Note that the expression \"to like very much\" is <span class=\"italic\">\xe5 like veldig godt</span> (i.e. to like very well):</p><span class=\"italic\">Jeg liker pizza veldig godt</span></div></div>",A:"N"},{DECK_ID:"A04",ID:"A04028",N:"<div class=\"center\">\xe5 dra<br>drar<br>dro<br>har dratt</div>",E:"<div class=\"center\"><p>to go, went, have gone<br>(by any means other than walking),</p>to leave, left, have left</div>",D:"TOP 40 VERBS",X:"<div class=\"center\"><div class=\"left\"><p>The verb <span class=\"italic\">\xe5 dra</span> must be used for \"going somewhere\" by means other than walking:<br><span class=\"italic\">Vi dro til Spania i oktober</span>.</p>It would be wrong to say:<br><span class=\"italic\">Vi gikk til Spania i oktober</span>.</div></div>",A:"N"},{DECK_ID:"A04",ID:"A04029",N:"<div class=\"center\">\xe5 holde<br>holder<br>holdt<br>har holdt</div>",E:"<div class=\"center\">to hold<br>held<br>have held</div>",D:"TOP 40 VERBS",X:"<div class=\"center\"><div class=\"left\">The D is silent and prolongs the L sound</div></div>",A:"N"},{DECK_ID:"A04",ID:"A04030",N:"<div class=\"center\">\xe5 vente<br>venter<br>ventet<br>har ventet</div>",E:"<div class=\"center\">to wait<br>waited<br>have waited</div>",D:"TOP 40 VERBS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">\xe5 vente</span> often requires the preposition <span class=\"italic\">p\xe5</span>:</p><p>Wait for me!</p><span class=\"italic\">Vent p\xe5 meg!</span></div></div>",A:"N"},{DECK_ID:"A04",ID:"A04031",N:"<div class=\"center\">\xe5 elske<br>elsker<br>elsket<br>har elsket</div>",E:"<div class=\"center\">to love<br>loved<br>have loved</div>",D:"TOP 40 VERBS",X:"",A:"N"},{DECK_ID:"A04",ID:"A04032",N:"<div class=\"center\">\xe5 burde<br>b\xf8r<br>burde<br>har burdet</div>",E:"<div class=\"center\">ought to, should</div>",D:"TOP 40 VERBS",X:"<div class=\"center\"><div class=\"left\"><p>This is a help verb that expresses a moral obligation or a duty:</p><span class=\"italic\">Du burde gj\xf8re leksene</span><br>You should be doing your homework</div></div>",A:"N"},{DECK_ID:"A04",ID:"A04033",N:"<div class=\"center\">\xe5 finne<br>finner<br>fant<br>har funnet</div>",E:"<div class=\"center\">to find, found, have found</div>",D:"TOP 40 VERBS",X:"",A:"N"},{DECK_ID:"A04",ID:"A04034",N:"<div class=\"center\">\xe5 spise<br>spiser<br>spiste<br>har spist</div>",E:"<div class=\"center\">to eat, ate, have eaten</div>",D:"TOP 40 VERBS",X:"",A:"N"},{DECK_ID:"A04",ID:"A04035",N:"<div class=\"center\">\xe5 drikke<br>drikker<br>drakk<br>har drukket</div>",E:"<div class=\"center\">to drink, drank, have drunk</div>",D:"TOP 40 VERBS",X:"",A:"N"},{DECK_ID:"A04",ID:"A04036",N:"<div class=\"center\">\xe5 forst\xe5<br>forst\xe5r<br>forstod<br>har forst\xe5tt</div>",E:"<div class=\"center\">to understand, understood, have understood</div>",D:"TOP 40 VERBS",X:"<div class=\"center\"><div class=\"left\">The D at the end of the <span class=\"italic\">preteritum</span> form is silent.</div></div>",A:"N"},{DECK_ID:"A04",ID:"A04037",N:"<div class=\"center\">\xe5 snakke<br>snakker<br>snakket<br>har snakket</div>",E:"<div class=\"center\">to speak, spoke, have spoken</div>",D:"TOP 40 VERBS",X:"<div class=\"center\"><div class=\"left\">This is the verb used for \"speaking a language\", \"talking <b class=\"bold\">about</b> something\", \"talking <b class=\"bold\">with</b> somebody\".</div></div>",A:"N"},{DECK_ID:"A04",ID:"A04038",N:"<div class=\"center\">\xe5 studere<br>studerer<br>studerte<br>har studert</div>",E:"<div class=\"center\">to study, studied, have studied</div>",D:"TOP 40 VERBS",X:"<div class=\"center\"><div class=\"left\">Pay attention to the sound of R & T when combined.</div></div>",A:"N"},{DECK_ID:"A04",ID:"A04039",N:"<div class=\"center\">\xe5 arbeide<br>arbeider<br>arbeidet<br>har arbeidet</div>",E:"<div class=\"center\">to work, worked, have worked</div>",D:"TOP 40 VERBS",X:"",A:"N"},{DECK_ID:"A04",ID:"A04040",N:"<div class=\"center\">\xe5 bety<br>betyr<br>betydde<br>har betydd</div>",E:"<div class=\"center\"><p>to mean, meant, have meant</p>(as in \"to signify\")</div>",D:"TOP 40 VERBS",X:"<div class=\"center\"><div class=\"left\"><p>This verb can be used if the subject is a thing.</p><p><span class=\"italic\">Hva betyr ordet \"dugnad\"?</span><br>What does the word \"dugnad\" mean?</p>When people mean something, you must use <span class=\"italic\">\xe5 mene, mener, mente, har ment</span>.</div></div>",A:"N"},{DECK_ID:"A04",ID:"A04041",N:"<div class=\"center\">\xe5 hjelpe<br>hjelper<br>hjalp<br>har hjulpet</div>",E:"<div class=\"center\">to help, helped, have helped</div>",D:"TOP 40 VERBS",X:"<div class=\"center\"><div class=\"left\">Remember that the initial H is silent when followed by a J.</div></div>",A:"N"},{DECK_ID:"A04",ID:"A04042",N:"<div class=\"center\">\xe5 huske<br>husker<br>husket<br>har husket</div>",E:"<div class=\"center\">to remember, remembered, have remembered</div>",D:"TOP 40 VERBS",X:"",A:"N"},{DECK_ID:"A04",ID:"A04043",N:"<div class=\"center\">\xe5 kj\xf8pe<br>kj\xf8per<br>kj\xf8pte<br>har kj\xf8pt</div>",E:"<div class=\"center\">to buy, bought, have bought</div>",D:"TOP 40 VERBS",X:"<div class=\"center\"><div class=\"left\"><p>Remember that the sound of KJ is <span class=\"italic\">similar</span> to the <b class=\"bold\">H</b> in \"<b class=\"bold\">h</b>ue\" and \"<b class=\"bold\">h</b>uge\".</p>This is NOT the same sound as SKJ and SJ, although even natives are at times imprecise about it and some dialects don't differentiate between them.</div></div>",A:"N"},{DECK_ID:"A04",ID:"A04044",N:"<div class=\"center\">\xe5 kjenne<br>kjenner<br>kjente<br>har kjent</div>",E:"<div class=\"center\"><p>to know, knew, have known</p>(in the sense of being acquainted with somebody)</div>",D:"TOP 40 VERBS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Jeg kjenner en venn av deg</span></p> <p>Remember that the sound of KJ is <span class=\"italic\">similar</span> to the <b class=\"bold\">H</b> in \"<b class=\"bold\">h</b>ue\" and \"<b class=\"bold\">h</b>uge\".</p> This is NOT the same sound as SKJ and SJ.</div></div>",A:"N"},{DECK_ID:"A04",ID:"A04045",N:"<div class=\"center\">\xe5 skje<br>skjer<br>skjedde<br>har skjedd</div>",E:"<div class=\"center\">to happen, happened, have happened</div>",D:"TOP 40 VERBS",X:"<div class=\"center\"><div class=\"left\">Remember that SKJ is basically pronounced like SH in \"she\" or \"sheep\".</div></div>",A:"N"},{DECK_ID:"A05",ID:"A05001",N:"<div class=\"center\">jeg</div>",E:"<div class=\"center\">I</div>",D:"TOP 45 INVARIABLES",X:"",A:"N"},{DECK_ID:"A05",ID:"A05002",N:"<div class=\"center\">du</div>",E:"<div class=\"center\">you (subject, singular)</div>",D:"TOP 45 INVARIABLES",X:"<div class=\"center\"><div class=\"left\">Note that this U sound in Norwegian has slightly rounded lips, so it's not the same as \"do\" in English.</div></div>",A:"N"},{DECK_ID:"A05",ID:"A05003",N:"<div class=\"center\">p\xe5</div>",E:"<div class=\"center\">on, at, in</div>",D:"TOP 45 INVARIABLES",X:"<div class=\"center\"><div class=\"left\">The meaning varies with the context, more on this later.</div></div>",A:"N"},{DECK_ID:"A05",ID:"A05004",N:"<div class=\"center\">i</div>",E:"<div class=\"center\">in, for</div>",D:"TOP 45 INVARIABLES",X:"<div class=\"center\"><div class=\"left\">The meaning varies with the context, more on this later.</div></div>",A:"N"},{DECK_ID:"A05",ID:"A05005",N:"<div class=\"center\">for</div>",E:"<div class=\"center\">for</div>",D:"TOP 45 INVARIABLES",X:"<div class=\"center\"><div class=\"left\">Do not mistake this for <span class=\"italic\">f\xf8r</span> (which means \"before\").</div></div>",A:"N"},{DECK_ID:"A05",ID:"A05006",N:"<div class=\"center\">og</div>",E:"<div class=\"center\">and</div>",D:"TOP 45 INVARIABLES",X:"<div class=\"center\"><p>Approximate pronunciation:</p>AW (the G is silent)</div>",A:"N"},{DECK_ID:"A05",ID:"A05007",N:"<div class=\"center\">han</div>",E:"<div class=\"center\">he</div>",D:"TOP 45 INVARIABLES",X:"<div class=\"center\"><div class=\"left\">The <b class=\"bold\">A is short</b> even if it's followed by a single N.</div></div>",A:"N"},{DECK_ID:"A05",ID:"A05008",N:"<div class=\"center\">hun</div>",E:"<div class=\"center\">she</div>",D:"TOP 45 INVARIABLES",X:"<div class=\"center\"><div class=\"left\">The <b class=\"bold\">U is short</b> even if it's followed by a single N.</div></div>",A:"N"},{DECK_ID:"A05",ID:"A05009",N:"<div class=\"center\">den/det</div>",E:"<div class=\"center\">it, that</div>",D:"TOP 45 INVARIABLES",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Den</span> must be used with <span class=\"italic\">hankj\xf8nn</span> and <span class=\"italic\">hunkj\xf8nn</span>.</p><p><span class=\"italic\">Det</span> must be used with <span class=\"italic\">intetkj\xf8nn</span>.</p>If not enough context is given, the tendency is to go with <span class=\"italic\">det</span>.</div></div>",A:"N"},{DECK_ID:"A05",ID:"A05010",N:"<div class=\"center\">eller</div>",E:"<div class=\"center\">or</div>",D:"TOP 45 INVARIABLES",X:"<div class=\"center\"><div class=\"left\">Also used as a \"filler\" or as a \"question tag\", a bit like \"though\" or \"like\" in English.</div></div>",A:"N"},{DECK_ID:"A05",ID:"A05011",N:"<div class=\"center\">men</div>",E:"<div class=\"center\">but</div>",D:"TOP 45 INVARIABLES",X:"<div class=\"center\"><div class=\"left\">Do not mistake this for <span class=\"italic\">menn</span> (which means \"men\").</div></div>",A:"N"},{DECK_ID:"A05",ID:"A05012",N:"<div class=\"center\">kanskje</div>",E:"<div class=\"center\">maybe</div>",D:"TOP 45 INVARIABLES",X:"<div class=\"center\"><p>Approximate pronunciation:</p>KAN-SHEH</div>",A:"N"},{DECK_ID:"A05",ID:"A05013",N:"<div class=\"center\">fra</div>",E:"<div class=\"center\">from</div>",D:"TOP 45 INVARIABLES",X:"<div class=\"center\"><div class=\"left\">Remember that the sound for the letter \"A\" comes from the back of your mouth in Norwegian.</div></div>",A:"N"},{DECK_ID:"A05",ID:"A05014",N:"<div class=\"center\">vi</div>",E:"<div class=\"center\">we</div>",D:"TOP 45 INVARIABLES",X:"",A:"N"},{DECK_ID:"A05",ID:"A05015",N:"<div class=\"center\">dere</div>",E:"<div class=\"center\">you (subject, plural)</div>",D:"TOP 45 INVARIABLES",X:"<div class=\"center\"><div class=\"left\">Remember that Norwegian differentiates between the \"singular you\" (<span class=\"italic\">du</span>) and the \"plural you\" (<span class=\"italic\">dere</span>).</div></div>",A:"N"},{DECK_ID:"A05",ID:"A05016",N:"<div class=\"center\">de</div>",E:"<div class=\"center\">they</div>",D:"TOP 45 INVARIABLES",X:"",A:"N"},{DECK_ID:"A05",ID:"A05017",N:"<div class=\"center\">hvem</div>",E:"<div class=\"center\">who</div>",D:"TOP 45 INVARIABLES",X:"<div class=\"center\"><div class=\"left\"><p>The H is silent in the HV cluster at the beginning of words.</p><p>Also, in this case, the E sound is short even if it is followed by just one M</p>In fact, the M can be pronounced as if it was a double M in case the word is stressed or emphasised within the sentence.</div></div>",A:"N"},{DECK_ID:"A05",ID:"A05018",N:"<div class=\"center\">n\xe5</div>",E:"<div class=\"center\">now</div>",D:"TOP 45 INVARIABLES",X:"",A:"N"},{DECK_ID:"A05",ID:"A05019",N:"<div class=\"center\">hvor</div>",E:"<div class=\"center\">where</div>",D:"TOP 45 INVARIABLES",X:"<div class=\"center\"><p>Approximate pronunciation:</p>VOOR</div>",A:"N"},{DECK_ID:"A05",ID:"A05020",N:"<div class=\"center\">hvorfor</div>",E:"<div class=\"center\">why</div>",D:"TOP 45 INVARIABLES",X:"<div class=\"center\"><p>Approximate pronunciation:</p>VOOR FOOR</div>",A:"N"},{DECK_ID:"A05",ID:"A05021",N:"<div class=\"center\">n\xe5r</div>",E:"<div class=\"center\">when</div>",D:"TOP 45 INVARIABLES",X:"",A:"N"},{DECK_ID:"A05",ID:"A05022",N:"<div class=\"center\">f\xf8r</div>",E:"<div class=\"center\">before</div>",D:"TOP 45 INVARIABLES",X:"<div class=\"center\"><div class=\"left\">Do not mistake this for <span class=\"italic\">for</span> (which means \"for\").</div></div>",A:"N"},{DECK_ID:"A05",ID:"A05023",N:"<div class=\"center\">etter</div>",E:"<div class=\"center\">after (preposition)</div>",D:"TOP 45 INVARIABLES",X:"",A:"N"},{DECK_ID:"A05",ID:"A05024",N:"<div class=\"center\">i dag</div>",E:"<div class=\"center\">today</div>",D:"TOP 45 INVARIABLES",X:"<div class=\"center\"><div class=\"left\">Norwegian uses <span class=\"italic\">i</span> to indicate the current or the next immediate instance of a certain time.<br>The noun is most often in the indefinite form.</div></div>",A:"N"},{DECK_ID:"A05",ID:"A05025",N:"<div class=\"center\">i morgen</div>",E:"<div class=\"center\">tomorrow</div>",D:"TOP 45 INVARIABLES",X:"<div class=\"center\"><div class=\"left\"><p>Norwegian uses <span class=\"italic\">i</span> to indicate the current or the next immediate instance of a certain time.<br>The noun is most often in the indefinite form.</p>Also, note the additional pronunciation in the audio file.</div></div>",A:"N"},{DECK_ID:"A05",ID:"A05026",N:"<div class=\"center\">i g\xe5r</div>",E:"<div class=\"center\">yesterday</div>",D:"TOP 45 INVARIABLES",X:"<div class=\"center\"><div class=\"left\">Norwegian uses <span class=\"italic\">i</span> to indicate the current or the next immediate instance of a certain time.<br>The noun is most often in the indefinite form.</div></div>",A:"N"},{DECK_ID:"A05",ID:"A05027",N:"<div class=\"center\">hvordan</div>",E:"<div class=\"center\">how</div>",D:"TOP 45 INVARIABLES",X:"<div class=\"center\"><div class=\"left\"><p>Approximate pronunciation: VOORDAN</p>The H is silent when the word begins with HV-.</div></div>",A:"N"},{DECK_ID:"A05",ID:"A05028",N:"<div class=\"center\">som</div>",E:"<div class=\"center\">who/which, like, such as</div>",D:"TOP 45 INVARIABLES",X:"<div class=\"center\"><div class=\"left\"><p>In this case, the O sound is short even if it is followed by just one M.</p>In fact, the M can be pronounced as if it was a double M in case the word is stressed or emphasised within the sentence.</div></div>",A:"N"},{DECK_ID:"A05",ID:"A05029",N:"<div class=\"center\">til</div>",E:"<div class=\"center\">to</div>",D:"TOP 45 INVARIABLES",X:"",A:"N"},{DECK_ID:"A05",ID:"A05030",N:"<div class=\"center\">av</div>",E:"<div class=\"center\">of, off, by</div>",D:"TOP 45 INVARIABLES",X:"",A:"N"},{DECK_ID:"A05",ID:"A05031",N:"<div class=\"center\">med</div>",E:"<div class=\"center\">with</div>",D:"TOP 45 INVARIABLES",X:"<div class=\"center\">The D is silent</div>",A:"N"},{DECK_ID:"A05",ID:"A05032",N:"<div class=\"center\">venstre</div>",E:"<div class=\"center\">left (direction)</div>",D:"TOP 45 INVARIABLES",X:"",A:"N"},{DECK_ID:"A05",ID:"A05033",N:"<div class=\"center\">h\xf8yre</div>",E:"<div class=\"center\">right (direction)</div>",D:"TOP 45 INVARIABLES",X:"",A:"N"},{DECK_ID:"A05",ID:"A05034",N:"<div class=\"center\">s\xe5</div>",E:"<div class=\"center\">so</div>",D:"TOP 45 INVARIABLES",X:"",A:"N"},{DECK_ID:"A05",ID:"A05035",N:"<div class=\"center\">ogs\xe5</div>",E:"<div class=\"center\">too, also</div>",D:"TOP 45 INVARIABLES",X:"<div class=\"center\"><div class=\"left\">The G is silent and lengthens the S sound.</div></div>",A:"N"},{DECK_ID:"A05",ID:"A05036",N:"<div class=\"center\">hvis</div>",E:"<div class=\"center\">if</div>",D:"TOP 45 INVARIABLES",X:"<div class=\"center\">The H is silent</div>",A:"N"},{DECK_ID:"A05",ID:"A05037",N:"<div class=\"center\">hvor mye</div>",E:"<div class=\"center\">how much</div>",D:"TOP 45 INVARIABLES",X:"<div class=\"center\"><div class=\"left\">Remember that \"how much\" translates as <span class=\"italic\">hvor mye</span>, not as <span class=\"italic\">hvordan mye</span>, as a direct translation would make you think.</div></div>",A:"N"},{DECK_ID:"A05",ID:"A05038",N:"<div class=\"center\">litt</div>",E:"<div class=\"center\">a little (of), a bit (of)</div>",D:"TOP 45 INVARIABLES",X:"<div class=\"center\"><p><span class=\"italic\">Jeg kan snakke litt norsk</span></p>I can speak a bit of Norwegian</div>",A:"N"},{DECK_ID:"A05",ID:"A05039",N:"<div class=\"center\">enn</div>",E:"<div class=\"center\">than</div>",D:"TOP 45 INVARIABLES",X:"",A:"N"},{DECK_ID:"A05",ID:"A05040",N:"<div class=\"center\">her</div>",E:"<div class=\"center\">here</div>",D:"TOP 45 INVARIABLES",X:"<div class=\"center\"><div class=\"left\">Note that this E is pronounced like an \xc6, since it's followed by R.</div></div>",A:"N"},{DECK_ID:"A05",ID:"A05041",N:"<div class=\"center\">der</div>",E:"<div class=\"center\">there</div>",D:"TOP 45 INVARIABLES",X:"<div class=\"center\"><div class=\"left\">Note that this E is pronounced like an \xc6, since it's followed by R.</div></div>",A:"N"},{DECK_ID:"A05",ID:"A05042",N:"<div class=\"center\">at</div>",E:"<div class=\"center\">that (conjunction)</div>",D:"TOP 45 INVARIABLES",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Jeg h\xe5per at du blir bedre</span></p>I hope that you get better/recover</div></div>",A:"N"},{DECK_ID:"A05",ID:"A05043",N:"<div class=\"center\">om</div>",E:"<div class=\"center\">about, if, whether</div>",D:"TOP 45 INVARIABLES",X:"<div class=\"center\"><div class=\"left\"><p>The meaning varies with the context, more on this later.</p> <p>Also, the O sound is short even if it is followed by just one M.</p> In fact, the M can be pronounced as if it was a double M in case the word is stressed or emphasised within the sentence.</div></div>",A:"N"},{DECK_ID:"A05",ID:"A05044",N:"<div class=\"center\">ved</div>",E:"<div class=\"center\">at, by</div>",D:"TOP 45 INVARIABLES",X:"<div class=\"center\">The D is silent</div>",A:"N"},{DECK_ID:"A05",ID:"A05045",N:"<div class=\"center\">fordi</div>",E:"<div class=\"center\">because</div>",D:"TOP 45 INVARIABLES",X:"",A:"N"},{DECK_ID:"A06",ID:"A06001",N:"<div class=\"center\"><div class=\"left\">How do <b class=\"bold\">adjectives change</b> according to the <b class=\"bold\">gender</b> of the nouns?</div></div>",E:"<div class=\"center\"><div class=\"left\">Norwegian adjectives cater for the <span class=\"italic\">hankj\xf8nn</span> (and <span class=\"italic\">hunkj\xf8nn</span>) by default and for the <span class=\"italic\">intetkj\xf8nn</span> by usually adding a T or two. <br>See the examples below.</div></div>",D:"TOP 20 ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">god, god<b class=\"boldItalic green\">t</b></span>&emsp;&emsp;(good)<br><span class=\"italic\">God dag!</span>&emsp;&emsp;(good day!/hello!)<br><span class=\"italic\">God<b class=\"boldItalic green\">t</b> nytt\xe5r!</span>&emsp;(Happy New Year!)</p><span class=\"italic\">ny, ny<b class=\"boldItalic green\">tt</b></span>&emsp;&emsp;&emsp;(new)<br><span class=\"italic\">en ny jobb</span>&emsp;&emsp;(a new job)<br><span class=\"italic\">et ny<b class=\"boldItalic green\">tt</b> hus</span>&emsp;&emsp;(a new house)</div></div>",A:"X"},{DECK_ID:"A06",ID:"A06002",N:"<div class=\"center\">What is the <b class=\"bold\">plural</b> form of <b class=\"bold\">adjectives</b>?</div>",E:"<div class=\"center\"><div class=\"left\">Norwegian adjectives also change for plural, usually by <b class=\"bold\">adding an E</b> at the end.<br>See the examples below.</div></div>",D:"TOP 20 ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">fin, fin</span><b class=\"boldItalic green\">t</b><span class=\"italic\">, fin</span><b class=\"boldItalic\">e</b>&emsp;&emsp;(nice)<br><span class=\"italic\">Disse husene er fine</span> (These houses are nice)</p><span class=\"italic\">god, god</span><b class=\"boldItalic green\">t</b><span class=\"italic\">, god</span><b class=\"boldItalic\">e</b>&emsp;&emsp;(good)<br><span class=\"italic\">Vi er gode venner</span> (We are good friends)</div></div>",A:"X"},{DECK_ID:"A06",ID:"A06003",N:"<div class=\"center\">grei, greit, greie</div>",E:"<div class=\"center\">right, ok, adequate</div>",D:"TOP 20 ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">Remember that the E in the EI cluster is pronounced like an \xc6.</div></div>",A:"N"},{DECK_ID:"A06",ID:"A06004",N:"<div class=\"center\">dyr, dyrt, dyre</div>",E:"<div class=\"center\">expensive</div>",D:"TOP 20 ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">Pay attention to the retroflexed sound of RT in <span class=\"italic\">dyrt</span></div></div>",A:"N"},{DECK_ID:"A06",ID:"A06005",N:"<div class=\"center\">billig, billig, billige</div>",E:"<div class=\"center\">cheap</div>",D:"TOP 20 ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p>Remember that the <b class=\"bold\">G is silent</b> in adjectives that <b class=\"bold\">end in -IG</b>.</p>Moreover, the <span class=\"italic\">intetkj\xf8nn</span> form doesn't take the -T at the end.</div></div>",A:"N"},{DECK_ID:"A06",ID:"A06006",N:"<div class=\"center\"><div class=\"left\">What happens when an adjective comes before a definite noun (e.g. the blonde boy)?</div></div>",E:"<div class=\"center\"><div class=\"left\"><p>1) The determiners <span class=\"italic\">den/det</span> or <span class=\"italic\">de</span> must precede the adjective</p><p>2) The adjective must be in the definite form (nearly always the same as plural)</p>See the examples below.</div></div>",D:"TOP 20 ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Gutt</span><b class=\"boldItalic\">en</b><span class=\"italic\"> er blond</span>&emsp;(the boy is blonde)<br><b class=\"boldItalic\">Den</b><span class=\"italic\"> blond</span><b class=\"boldItalic\">e</b><span class=\"italic\"> gutt</span><b class=\"boldItalic\">en</b><span class=\"italic\"> er her</span>&emsp;&emsp;(the blonde boy is here)</p><span class=\"italic\">Hus</span><b class=\"boldItalic green\">et</b><span class=\"italic\"> er r\xf8d</span><b class=\"boldItalic green\">t</b>&emsp;&emsp;(the house is red)<br><b class=\"boldItalic green\">Det</b><span class=\"italic\"> r\xf8d</span><b class=\"boldItalic green\">e</b><span class=\"italic\"> hus</span><b class=\"boldItalic green\">et</b><span class=\"italic\"> ble solgt</span>&emsp;&emsp;(the red house was sold)</div></div>",A:"X"},{DECK_ID:"A06",ID:"A06007",N:"<div class=\"center\">d\xe5rlig, d\xe5rlig, d\xe5rlige</div>",E:"<div class=\"center\">bad</div>",D:"TOP 20 ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p>Remember that the <b class=\"bold\">G is silent</b> in adjectives that <b class=\"bold\">end in -IG</b>.</p>Moreover, the <span class=\"italic\">intetkj\xf8nn</span> form doesn't take the -T.</div></div>",A:"N"},{DECK_ID:"A06",ID:"A06008",N:"<div class=\"center\">god, godt, gode</div>",E:"<div class=\"center\">good</div>",D:"TOP 20 ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">Remember that the <b class=\"bold\">D is silent</b> and the <b class=\"bold\">O becomes short</b> in the <span class=\"italic\">intetkj\xf8nn</span> form.</div></div>",A:"N"},{DECK_ID:"A06",ID:"A06009",N:"<div class=\"center\">ny, nytt, nye</div>",E:"<div class=\"center\">new</div>",D:"TOP 20 ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">Remember that <b class=\"bold\">monosyllabic adjectives ending in a single vowel</b> tend to take a <b class=\"bold\">double -TT</b> for the <span class=\"italic\">intetkj\xf8nn</span>.</div></div>",A:"N"},{DECK_ID:"A06",ID:"A06010",N:"<div class=\"center\">What is the comparative form of adjectives?</div>",E:"<div class=\"center\"><div class=\"left\">Just like English, Norwegian can have a comparative form of adjectives.<br>This tends to have an ending in <b class=\"bold\">-ERE</b> or <b class=\"bold\">-RE</b>, but there are irregularities.<br>See the examples below:</div></div>",D:"TOP 20 ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">billig, billig</span><b class=\"boldItalic\">ere</b>&nbsp;&nbsp;(cheap, cheaper)</p><p><span class=\"italic\">sen, sen</span><b class=\"boldItalic\">ere</b>&nbsp;&nbsp;(late, later)</p><p><span class=\"italic\">god, bed</span><b class=\"boldItalic\">re</b>&nbsp;&nbsp;(good, better)</p><span class=\"italic\">mye, me</span><b class=\"boldItalic\">r</b>&nbsp;&nbsp;&nbsp;(much, more)</div></div>",A:"X"},{DECK_ID:"A06",ID:"A06011",N:"<div class=\"center\">What is the superlative form of adjectives?</div>",E:"<div class=\"center\"><div class=\"left\">Just like English, Norwegian can have a superlative form of adjectives.<br>This tends to have an ending in <b class=\"bold\">-EST</b> or <b class=\"bold\">-ST</b>, but there are irregularities.<br>See the examples below:</div></div>",D:"TOP 20 ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">billig, billig</span><b class=\"boldItalic\">st</b>&nbsp;&nbsp;(cheap, cheapest)</p><p><span class=\"italic\">sen, sen</span><b class=\"boldItalic\">est</b>&nbsp;&nbsp;(late, latest)</p><p><span class=\"italic\">god, be</span><b class=\"boldItalic\">st</b>&nbsp;&nbsp;(good, best)</p><span class=\"italic\">mye, me</span><b class=\"boldItalic\">st</b>&nbsp;&nbsp;(much, most)</div></div>",A:"X"},{DECK_ID:"A06",ID:"A06012",N:"<div class=\"center\">dyrere, dyrest</div>",E:"<div class=\"center\">more expensive, most expensive</div>",D:"TOP 20 ADJECTIVES",X:"",A:"N"},{DECK_ID:"A06",ID:"A06013",N:"<div class=\"center\">verre, verst</div>",E:"<div class=\"center\">worse, worst</div>",D:"TOP 20 ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">Remember that RS is basically pronounced like the English SH in \"she\" or \"sheep\".</div></div>",A:"N"},{DECK_ID:"A06",ID:"A06014",N:"<div class=\"center\">tidlig, tidlig, tidlige</div>",E:"<div class=\"center\">early</div>",D:"TOP 20 ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p>Remember that the <b class=\"bold\">G is silent</b> in adjectives that <b class=\"bold\">end in -IG</b> and the <span class=\"italic\">intetkj\xf8nn</span> form doesn't take the -T.</p>In this case, the D can be silent or not.</div></div>",A:"N"},{DECK_ID:"A06",ID:"A06015",N:"<div class=\"center\">min, mitt, mine</div>",E:"<div class=\"center\">my</div>",D:"TOP 20 ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p>This possessive adjective changes according to the gender and number of the object of possession. It is most commonly put after the noun, which must be in definite form:</p><p><span class=\"italic\">bilen min</span>&emsp;&emsp;my car</p><span class=\"italic\">huset mitt</span>&emsp;&emsp;my house</div></div>",A:"N"},{DECK_ID:"A06",ID:"A06016",N:"<div class=\"center\">sen, sent, sene</div>",E:"<div class=\"center\">late</div>",D:"TOP 20 ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">The spelling <span class=\"italic\">sein, seint, seine</span> is also used, for comparative and superlative forms too (i.e. <span class=\"italic\">seinere, seinest</span>).</div></div>",A:"N"},{DECK_ID:"A06",ID:"A06017",N:"<div class=\"center\">din, ditt, dine</div>",E:"<div class=\"center\">your (singular)</div>",D:"TOP 20 ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p>The possessive adjective for \"you\" (singular) changes according to the gender and number of the object of possession. It is most commonly put after the noun, which must be in definite form:</p><p><span class=\"italic\">landet ditt</span>&emsp;&emsp;your land</p><span class=\"italic\">husene dine</span>&emsp;&emsp;your houses</div></div>",A:"N"},{DECK_ID:"A06",ID:"A06018",N:"<div class=\"center\">billigere, billigst</div>",E:"<div class=\"center\">cheaper, cheapest</div>",D:"TOP 20 ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">Note that the <b class=\"bold\">G is not silent</b> in the <b class=\"bold\">superlative</b> form of the adjectives that end in -IG, and it's in fact <b class=\"bold\">pronounced</b> as if it was a <b class=\"bold\">\"K\"</b>.</div></div>",A:"N"},{DECK_ID:"A06",ID:"A06019",N:"<div class=\"center\">bedre, best</div>",E:"<div class=\"center\">better, best</div>",D:"TOP 20 ADJECTIVES",X:"",A:"N"},{DECK_ID:"A06",ID:"A06020",N:"<div class=\"center\">sliten, slitent, slitne</div>",E:"<div class=\"center\">tired</div>",D:"TOP 20 ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">Adjectives that end in -EN lose their own E in the plural/definite, before adding the -E of the ending.</div></div>",A:"N"},{DECK_ID:"A06",ID:"A06021",N:"<div class=\"center\">senere, senest</div>",E:"<div class=\"center\">later, latest</div>",D:"TOP 20 ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p>The comparative form is often used on its own, meaning \"later\":</p><span class=\"italic\"><p>Jeg skal gj\xf8re det senere</p>Vi ses senere!</span></div></div>",A:"N"},{DECK_ID:"A06",ID:"A06022",N:"<div class=\"center\">gammel, gammelt, gamle</div>",E:"<div class=\"center\">old</div>",D:"TOP 20 ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">Note that the plural/definite form loses one M and the E.</div></div>",A:"N"},{DECK_ID:"A06",ID:"A06023",N:"<div class=\"center\">koselig, koselig, koselige</div>",E:"<div class=\"center\">cosy, lovely</div>",D:"TOP 20 ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p>Remember that the G in adjectives that end in -IG is silent.</p>Moreover, the <span class=\"italic\">intetkj\xf8nn</span> form doesn't take the -T.</div></div>",A:"N"},{DECK_ID:"A06",ID:"A06024",N:"<div class=\"center\">stor, stort, store</div>",E:"<div class=\"center\">big, large</div>",D:"TOP 20 ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">Pay attention to the retroflexed sound of RT in <span class=\"italic\">stort</span></div></div>",A:"N"},{DECK_ID:"A06",ID:"A06025",N:"<div class=\"center\">st\xf8rre, st\xf8rst</div>",E:"<div class=\"center\"><p>bigger, biggest</p>larger, largest</div>",D:"TOP 20 ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">This adjective is irregular in its comparative and superlative forms.</div></div>",A:"N"},{DECK_ID:"A06",ID:"A06026",N:"<div class=\"center\">liten, lite, lille/sm\xe5</div>",E:"<div class=\"center\">small, little</div>",D:"TOP 20 ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p>This highly irregular adjective has <span class=\"italic\">lille</span> for definite singular and <span class=\"italic\">sm\xe5</span> for plural:</p><p><span class=\"italic\">den lille gutten</span>&emsp;&emsp;&emsp;the little boy</p><p><di><span class=\"italic\">de sm\xe5 husene</span>&emsp;&emsp;&emsp;the small houses</p></div></div>",A:"N"},{DECK_ID:"A06",ID:"A06027",N:"<div class=\"center\">mindre, minst</div>",E:"<div class=\"center\"><p>smaller, smallest</p>less, least</div>",D:"TOP 20 ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">This adjective is irregular in its comparative and superlative forms.</div></div>",A:"N"},{DECK_ID:"A06",ID:"A06028",N:"<div class=\"center\">n\xe6r, n\xe6rt, n\xe6re</div>",E:"<div class=\"center\">near</div>",D:"TOP 20 ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">Pay attention to the retroflexed sound of RT in <span class=\"italic\">n\xe6rt</span></div></div>",A:"N"},{DECK_ID:"A06",ID:"A06029",N:"<div class=\"center\">varm, varmt, varme</div>",E:"<div class=\"center\">warm, hot</div>",D:"TOP 20 ADJECTIVES",X:"",A:"N"},{DECK_ID:"A06",ID:"A06030",N:"<div class=\"center\">kald, kaldt, kalde</div>",E:"<div class=\"center\">cold</div>",D:"TOP 20 ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">Remember that the D is silent and that the L is nearly a double L</div></div>",A:"N"},{DECK_ID:"A07",ID:"A07001",N:"<div class=\"center\">How do you create <br>a <b class=\"bold\">negative sentence</b>?</div>",E:"<div class=\"center\"><div class=\"left\">The equivalent of \"not\" is <b class=\"boldItalic\">ikke</b>.<br>It usually goes after the (first) verb.<br>There is no equivalent of the use of \"don't\" as a mandatory auxiliary to create a negative sentence. See below:</div></div>",D:"BASIC GRAMMAR REVIEW",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Vi trenger ikke hjelp</span><br>(We don't need help)</p><p><span class=\"italic\">Hun arbeider ikke her</span><br>(She doesn't work here)</p><span class=\"italic\">Jeg har ikke sett ham</span><br>(I haven't seen him)</div></div>",A:"X"},{DECK_ID:"A07",ID:"A07002",N:"<div class=\"center\">How do you create <b class=\"bold\">questions?</b></div>",E:"<div class=\"center\"><div class=\"left\">Questions require the the (first) <b class=\"bold\">verb</b> to be placed <b class=\"bold\">before the subject</b>.<br>Just like for negations, there is no equivalent of the use of \"do\" as a mandatory auxiliary to create questions.<br>See the examples below:</div></div>",D:"BASIC GRAMMAR REVIEW",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Er du sliten?</span> (Are you tired?)</p><p><span class=\"italic\">Trenger du hjelp?</span> (Do you need help?)</p><p><span class=\"italic\">Kan jeg si noe?</span> (Can I say something?)</p><span class=\"italic\">Har du sett \xc5se?</span> (Have you seen \xc5se?)</div></div>",A:"X"},{DECK_ID:"A07",ID:"A07003",N:"<div class=\"center\"><div class=\"left\"><p>Translate to Norwegian, paying attention to the rules:</p></div>a friend, a bus</div>",E:"<div class=\"center\">en venn, en buss</div>",D:"BASIC GRAMMAR REVIEW",X:"<div class=\"center\"><div class=\"left\"><p>The words <span class=\"italic\">venn</span> and <span class=\"italic\">buss</span> belong to the <span class=\"italic\">hankj\xf8nn</span> gender, so they require the indefinite article <span class=\"italic\">en</span>.</p>Unluckily, the gender needs to be learned by heart with the word most of the time.</div></div>",A:"E"},{DECK_ID:"A07",ID:"A07004",N:"<div class=\"center\"><div class=\"left\"><p>Translate to Norwegian, paying attention to the rules:</p></div>the house, the number</div>",E:"<div class=\"center\">hus<b class=\"bold green\">et</b>, nummer<b class=\"bold green\">et</b></div>",D:"BASIC GRAMMAR REVIEW",X:"<div class=\"center\"><div class=\"left\"><p>When referring to a specific and definite instance of an <span class=\"italic\">intetkj\xf8nn</span> noun, the \"end article\" -ET (or just -T if the noun naturally ends in -E) is added at the end, giving the definite form.</p>Remember that for <span class=\"italic\">intetkj\xf8nn</span> words, the -T you add is silent.</div></div>",A:"E"},{DECK_ID:"A07",ID:"A07005",N:"<div class=\"center\"><div class=\"left\"><p>Turn the following sentence into a question:</p></div><span class=\"italic\">Du trenger hjelp</span><br>(You need help)</div>",E:"<div class=\"center\"><span class=\"italic\">Trenger du hjelp?</span><br>(Do you need help?)</div>",D:"BASIC GRAMMAR REVIEW",X:"<div class=\"center\"><div class=\"left\"><p>Norwegian <b class=\"bold\">swaps subject and verb</b> to create a question.</p>Remember that there is no equivalent of the use of \"do\" as a mandatory auxiliary to create questions.</div></div>",A:"E"},{DECK_ID:"A07",ID:"A07006",N:"<div class=\"center\"><div class=\"left\"><p>Turn the following sentence into a negative one:</p></div><span class=\"italic\">Hun arbeider her</span><br>(She works here)</div>",E:"<div class=\"center\"><span class=\"italic\">Hun arbeider</span> <b class=\"boldItalic\">ikke</b><span class=\"italic\"> her</span><br>(She doesn't work here)</div>",D:"BASIC GRAMMAR REVIEW",X:"<div class=\"center\"><div class=\"left\"><p>The equivalent of \"not\" is <span class=\"italic\">ikke</span>.<br>It usually goes <b class=\"bold\">after the (first) verb</b> of a sentence.</p>There is no equivalent of the use of \"don't\" as a mandatory auxiliary to create a negative sentence.</div></div>",A:"E"},{DECK_ID:"A07",ID:"A07007",N:"<div class=\"center\">What about verbs ending in an S?</div>",E:"<div class=\"center\"><div class=\"left\">Some verbs end in an -S by default or because of a reflexive or reciprocal meaning.<br>See the examples below.</div></div>",D:"BASIC GRAMMAR REVIEW",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Jeg synes</span> (I think, ends in -S by default)</p><p><span class=\"italic\">Vi ses!</span> (See you!) (literally: we see each other)</p><span class=\"italic\">Vi kan m\xf8tes senere</span> (We can meet later) (literally: we can meet each other later)</div></div>",A:"X"},{DECK_ID:"A07",ID:"A07008",N:"<div class=\"center\"><div class=\"left\"><p>Translate to Norwegian, paying attention to the rules:</p></div>the boy, the car</div>",E:"<div class=\"center\">gutt<b class=\"bold\">en</b>, bil<b class=\"bold\">en</b></div>",D:"BASIC GRAMMAR REVIEW",X:"<div class=\"center\"><div class=\"left\">When referring to a specific and definite instance of a <span class=\"italic\">hankj\xf8nn</span> noun, the \"end article\" -EN (or just -N if the noun naturally ends in -E) is added at the end, giving the definite form.</div></div>",A:"E"},{DECK_ID:"A07",ID:"A07009",N:"<div class=\"center\"><div class=\"left\"><p>Translate to Norwegian, paying attention to the rules:</p></div>a room, a life</div>",E:"<div class=\"center\"><b class=\"bold green\">et</b> rom, <b class=\"bold green\">et</b> liv</div>",D:"BASIC GRAMMAR REVIEW",X:"<div class=\"center\"><div class=\"left\"><p>The words <span class=\"italic\">rom</span> and <span class=\"italic\">liv</span> belong to the <span class=\"italic\">intetkj\xf8nn</span> gender, so they require the indefinite article <span class=\"italic\">et</span>.</p>Unluckily, the gender needs to be learned by heart with the word most of the time.</div></div>",A:"E"},{DECK_ID:"A07",ID:"A07010",N:"<div class=\"center\"><div class=\"left\"><p>Translate to Norwegian, paying attention to the rules:</p></div>The house is red</div>",E:"<div class=\"center\">Hus<b class=\"bold green\">et</b> er r\xf8d<b class=\"bold green\">t</b></div>",D:"BASIC GRAMMAR REVIEW",X:"<div class=\"center\"><div class=\"left\">When indicating a specific instance of a noun, the <b class=\"bold green\">\"end article\" -ET</b> (or just -T) must be added at the end of the <span class=\"italic\">intetkj\xf8nn</span> noun, and the adjective after the verb will match the gender and number of the noun.</div></div>",A:"E"},{DECK_ID:"A07",ID:"A07011",N:"<div class=\"center\"><div class=\"left\">How many forms are there for most Norwegian nouns?</div></div>",E:"<div class=\"center\"><div class=\"left\">Every time you meet a new noun you have to learn its gender and its four forms:<br>indefinite singular, definite singular, indefinite plural and definite plural.</div></div>",D:"BASIC GRAMMAR REVIEW",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">en bil, bil</span><b class=\"boldItalic\">en</b><span class=\"italic\">, bil</span><b class=\"boldItalic\">er</b><span class=\"italic\">, bil</span><b class=\"boldItalic\">ene</b><br>(a car, the car, cars, the cars)</p><p><span class=\"italic\">et land, land</span><b class=\"boldItalic\">et</b><span class=\"italic\">, land, land</span><b class=\"boldItalic\">ene</b><br>(a land, the land, lands, the lands)</p>Remember that an <span class=\"italic\">intetkj\xf8nn</span> noun with more than one syllable will likely have the indefinite plural ending in -ER, like most <span class=\"italic\">hankj\xf8nn</span> nouns.</div></div>",A:"X"},{DECK_ID:"A07",ID:"A07012",N:"<div class=\"center\"><div class=\"left\"><p>Translate to Norwegian, paying attention to the rules:</p></div>cars, the cars</div>",E:"<div class=\"center\">bil<b class=\"bold\">er</b>, bil<b class=\"bold\">ene</b></div>",D:"BASIC GRAMMAR REVIEW",X:"<div class=\"center\"><div class=\"left\">Norwegian nouns change for the plural, producing an indefinite plural and a definite plural, usually with endings in -ER and -ENE.</div></div>",A:"E"},{DECK_ID:"A07",ID:"A07013",N:"<div class=\"center\"><div class=\"left\"><p>Turn the following sentence into a negative one:</p></div><span class=\"italic\">Vi trenger hjelp</span><br>(We need help)</div>",E:"<div class=\"center\"><span class=\"italic\">Vi trenger</span> <b class=\"boldItalic\">ikke</b><span class=\"italic\"> hjelp</span><br>(We don't need help)</div>",D:"BASIC GRAMMAR REVIEW",X:"<div class=\"center\"><div class=\"left\"><p>The equivalent of \"not\" is <span class=\"italic\">ikke</span>.<br>It usually goes after the (first) verb of a sentence.</p>There is no equivalent of the use of \"don't\" as a mandatory auxiliary to create a negative sentence.</div></div>",A:"E"},{DECK_ID:"A07",ID:"A07014",N:"<div class=\"center\"><div class=\"left\"><p>Turn the following sentence into a question:</p></div><span class=\"italic\">Jeg kan si noe</span><br>(I can say something)</div>",E:"<div class=\"center\"><span class=\"italic\">Kan jeg si noe?</span><br>(Can I say something?)</div>",D:"BASIC GRAMMAR REVIEW",X:"<div class=\"center\"><div class=\"left\"><p>Norwegian swaps subject and the first verb to create a question.</p>Remember that there is no equivalent of the use of \"do\" as a mandatory auxiliary to create questions.</div></div>",A:"E"},{DECK_ID:"A07",ID:"A07015",N:"<div class=\"center\"><div class=\"left\"><p>Translate to Norwegian, paying attention to the rules:</p></div>The boy is blonde</div>",E:"<div class=\"center\">Gutt<b class=\"bold\">en</b> er blond</div>",D:"BASIC GRAMMAR REVIEW",X:"<div class=\"center\"><div class=\"left\">When indicating a specific instance of a noun, the \"end article\" -EN (or just -N) must be added at the end of the <span class=\"italic\">hankj\xf8nn</span> noun, and the adjective after the verb will match the gender and number of the noun.</div></div>",A:"E"},{DECK_ID:"A07",ID:"A07016",N:"<div class=\"center\"><div class=\"left\">How do you create adverbs (e.g. quickly, truly, beautifully) from adjectives?</div></div>",E:"<div class=\"center\"><div class=\"left\">Adverbs work sometimes as the \"adjectives of verbs\". Because of this, Norwegian can create adverbs from the <span class=\"italic\">intetkj\xf8nn</span> form of adjectives, a bit like English adds -LY. See below:</div></div>",D:"BASIC GRAMMAR REVIEW",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">langsom, langsom</span><b class=\"boldItalic\">t</b> (slow, slowly)</p><span class=\"italic\">sikker, sikker</span><b class=\"boldItalic\">t</b> (certain, certainly)</div></div>",A:"X"},{DECK_ID:"A07",ID:"A07017",N:"<div class=\"center\"><div class=\"left\"><p>Provide the three forms of these two adjectives:</p></div><span class=\"italic\">dyr, varm</span></div>",E:"<div class=\"center\"><p>dyr, dyr<b class=\"bold\">t</b>, dyr<b class=\"bold\">e</b></p>varm, varm<b class=\"bold\">t</b>, varm<b class=\"bold\">e</b></div>",D:"BASIC GRAMMAR REVIEW",X:"<div class=\"center\"><div class=\"left\"><p>Norwegian adjectives have three basic forms:</p>- indefinite singular for <span class=\"italic\">hankj\xf8nn</span> and <span class=\"italic\">hunkj\xf8nn</span><br>- indefinite singular for <span class=\"italic\">intetkj\xf8nn</span><br>- definite singular and plural (for either gender)</div></div>",A:"E"},{DECK_ID:"A07",ID:"A07018",N:"<div class=\"center\"><div class=\"left\"><p>Turn the following sentence into a negative one:</p></div><span class=\"italic\">Jeg har sett ham</span><br>(I have seen him)</div>",E:"<div class=\"center\"><span class=\"italic\">Jeg har </span><b class=\"boldItalic\">ikke</b><span class=\"italic\"> sett ham</span><br>(I haven't seen him)</div>",D:"BASIC GRAMMAR REVIEW",X:"<div class=\"center\"><div class=\"left\"><p>The equivalent of \"not\" is <span class=\"italic\">ikke</span>.<br>It usually goes after the (first) verb of a sentence.</p>There is no equivalent of the use of \"don't\" as a mandatory auxiliary to create a negative sentence.</div></div>",A:"E"},{DECK_ID:"A07",ID:"A07019",N:"<div class=\"center\"><div class=\"left\"><p>Translate to Norwegian, paying attention to the rules:</p></div>images, the images</div>",E:"<div class=\"center\">bild<b class=\"bold\">er</b>, bild<b class=\"bold\">ene</b></div>",D:"BASIC GRAMMAR REVIEW",X:"<div class=\"center\"><div class=\"left\"><p>Norwegian nouns change for the plural, producing an indefinite plural and a definite plural, usually with endings in -ER and -ENE.</p>However, many monosyllabic  <span class=\"italic\">intetkj\xf8nn</span> nouns such as <span class=\"italic\">et land</span> or <span class=\"italic\">et hus</span> do not take an ending for indefinite plural.</div></div>",A:"E"},{DECK_ID:"A07",ID:"A07020",N:"<div class=\"center\"><div class=\"left\"><p>Turn the following sentence into a question:</p></div><span class=\"italic\">Du har sett \xc5se</span><br>(You have seen \xc5se)</div>",E:"<div class=\"center\"><span class=\"italic\">Har du sett \xc5se?</span><br>(Have you seen \xc5se?)</div>",D:"BASIC GRAMMAR REVIEW",X:"<div class=\"center\"><div class=\"left\"><p>Norwegian swaps subject and the (first) verb to create a question.</p>Remember that there is no equivalent of the use of \"do\" as a mandatory auxiliary to create questions.</div></div>",A:"E"},{DECK_ID:"A07",ID:"A07021",N:"<div class=\"center\"><div class=\"left\"><p>Provide the comparative form of these adjectives:</p></div><span class=\"italic\">billig, sen</span></div>",E:"<div class=\"center\">billig<b class=\"bold\">ere</b>, sen<b class=\"bold\">ere</b></div>",D:"BASIC GRAMMAR REVIEW",X:"<div class=\"center\"><div class=\"left\"><p>Just like English, Norwegian can have a comparative form for its adjectives. This tends to have an ending in <b class=\"bold\">-ERE</b> or <b class=\"bold\">-RE</b>.</p>The two adjectives used in the example show the regular pattern, in which -ERE is added.</div></div>",A:"E"},{DECK_ID:"A07",ID:"A07022",N:"<div class=\"center\"><div class=\"left\"><p>Translate to Norwegian, paying attention to the rules:</p></div>The blonde boy is here</div>",E:"<div class=\"center\"><b class=\"bold\">Den</b> blond<b class=\"bold\">e</b> gutt<b class=\"bold\">en</b> er her</div>",D:"BASIC GRAMMAR REVIEW",X:"<div class=\"center\"><div class=\"left\"><p>When an adjective comes before a definite noun:</p><p>1) The determiner <span class=\"italic\">den/det</span> or <span class=\"italic\">de</span> must precede the adjective</p>2) The adjective must be in the definite form (nearly always the same as plural)</div></div>",A:"E"},{DECK_ID:"A07",ID:"A07023",N:"<div class=\"center\"><div class=\"left\"><p>Provide the superlative form of these adjectives:</p></div><span class=\"italic\">billig, sen</span></div>",E:"<div class=\"center\">billig<b class=\"bold\">st</b>, sen<b class=\"bold\">est</b></div>",D:"BASIC GRAMMAR REVIEW",X:"<div class=\"center\"><div class=\"left\">Just like English, Norwegian can have a superlative form for its adjectives.<br>This tends to have an ending in <b class=\"bold\">-EST</b> or <b class=\"bold\">-ST</b>.</div></div>",A:"E"},{DECK_ID:"A07",ID:"A07024",N:"<div class=\"center\"><div class=\"left\"><p>Translate to Norwegian, paying attention to the rules:</p></div>The red house was sold</div>",E:"<div class=\"center\"><b class=\"bold\">Det</b> r\xf8d<b class=\"bold\">e</b> hus<b class=\"bold\">et</b> ble solgt</div>",D:"BASIC GRAMMAR REVIEW",X:"<div class=\"center\"><div class=\"left\"><p>When an adjective comes before a definite noun:</p><p>1) The determiner <span class=\"italic\">den/det</span> or <span class=\"italic\">de</span> must precede the adjective</p>2) The adjective must be in the definite form (nearly always the same as plural)</div></div>",A:"E"},{DECK_ID:"A07",ID:"A07025",N:"<div class=\"center\"><div class=\"left\">Turn the adjectives \"slow\" and \"certain\" (<span class=\"italic\">langsom</span> and <span class=\"italic\">sikker</span>) into the adverbs \"slowly\" and \"certainly\".</div></div>",E:"<div class=\"center\">langsom<b class=\"bold\">t</b>, sikker<b class=\"bold\">t</b></div>",D:"BASIC GRAMMAR REVIEW",X:"<div class=\"center\"><div class=\"left\">Norwegian can create adverbs from the <span class=\"italic\">intetkj\xf8nn</span> form of adjectives, a bit like English adds -LY.</div></div>",A:"E"},{DECK_ID:"A08",ID:"A08001",N:"<div class=\"center\">Hva er klokka?</div>",E:"<div class=\"center\">What's the time?</div>",D:"TELLING TIME",X:"<div class=\"center\"><div class=\"left\"><p>Literally: what is the clock?</p>The <span class=\"italic\">hunkj\xf8nn</span> word <span class=\"italic\">ei klokke</span> is used in its definite form (<span class=\"italic\">klokka</span>).</div></div>",A:"N"},{DECK_ID:"A08",ID:"A08002",N:"<div class=\"center\">klokka \xe5tte <br>(om morgenen)</div>",E:"<div class=\"center\">08:00</div>",D:"TELLING TIME",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Klokka</span> is the definite form of <span class=\"italic\">ei klokke</span> (<span class=\"italic\">hunkj\xf8nn</span> noun). It is used like \"o'clock\" in English.</p>The part in brackets is optional unless confusion may arise.</div></div>",A:"N"},{DECK_ID:"A08",ID:"A08003",N:"<div class=\"center\">kvart over fire <br>(om ettermiddagen)</div>",E:"<div class=\"center\">16:15</div>",D:"TELLING TIME",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">Over</span> is the equivalent of the English \"past\"</div></div>",A:"N"},{DECK_ID:"A08",ID:"A08004",N:"<div class=\"center\">halv seks <br>(om kvelden)</div>",E:"<div class=\"center\">17:30</div>",D:"TELLING TIME",X:"<div class=\"center\"><div class=\"left\">In Norwegian, 17:30 is called <span class=\"italic\">halv seks</span> (half six). This is because the counting starts from the current hour (five) and, from that perspective, it's as if we were halfway to get to six.</div></div>",A:"N"},{DECK_ID:"A08",ID:"A08005",N:"<div class=\"center\">kvart p\xe5 elleve <br>(om kvelden)</div>",E:"<div class=\"center\">22:45</div>",D:"TELLING TIME",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">P\xe5</span> is the equivalent of the English \"to\".</p>Also, the Norwegian <span class=\"italic\">kveld</span> (evening) extends up to midnight.</div></div>",A:"N"},{DECK_ID:"A08",ID:"A08006",N:"<div class=\"center\">Hvor mye er klokken?</div>",E:"<div class=\"center\"><p>What's the time?</p>(Literally: how much is the clock?)</div>",D:"TELLING TIME",X:"<div class=\"center\"><div class=\"left\"><p>Just another way of asking for the time.</p>The word <span class=\"italic\">klokke</span> is used in the <span class=\"italic\">hankj\xf8nn</span> gender in this instance, so the definite singular is <span class=\"italic\">klokken</span>.</div></div>",A:"N"},{DECK_ID:"A08",ID:"A08007",N:"<div class=\"center\">klokka ni <br>(om kvelden)</div>",E:"<div class=\"center\">21:00</div>",D:"TELLING TIME",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Klokka</span> is the definite form of <span class=\"italic\">ei klokke</span> (<span class=\"italic\">hunkj\xf8nn</span> noun). It is used like \"o'clock\" in English.</p>The part in brackets is optional unless confusion may arise.</div></div>",A:"N"},{DECK_ID:"A08",ID:"A08008",N:"<div class=\"center\">kvart over ni <br>(om morgenen)</div>",E:"<div class=\"center\">09:15</div>",D:"TELLING TIME",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">Over</span> is the equivalent of the English \"past\"</div></div>",A:"N"},{DECK_ID:"A08",ID:"A08009",N:"<div class=\"center\">kvart p\xe5 fire <br>(om ettermiddagen)</div>",E:"<div class=\"center\">15:45</div>",D:"TELLING TIME",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">P\xe5</span> is the equivalent of the English \"to\"</div></div>",A:"N"},{DECK_ID:"A08",ID:"A08010",N:"<div class=\"center\">halv elleve <br>(om formiddagen)</div>",E:"<div class=\"center\">10:30</div>",D:"TELLING TIME",X:"<div class=\"center\"><div class=\"left\"><p>In Norwegian, 10:30 is called <span class=\"italic\">halv elleve</span> (half eleven). This is because the counting starts from the current hour (ten) and, from that perspective, it's as if we were halfway to get to eleven.</p>Also, <span class=\"italic\">formiddagen</span> is used for the late morning, starting from 09:30 or 10:00 and until midday.</div></div>",A:"N"},{DECK_ID:"A08",ID:"A08011",N:"<div class=\"center\">klokken tre <br>(om ettermidagen)</div>",E:"<div class=\"center\">15:00</div>",D:"TELLING TIME",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Klokken</span> (i.e. the definite form for the male noun) can be used too, although <span class=\"italic\">klokka</span> is preferred.</p>The part in brackets is optional unless confusion may arise.</div></div>",A:"N"},{DECK_ID:"A08",ID:"A08012",N:"<div class=\"center\">fem over \xe5tte <br>(om morgenen)</div>",E:"<div class=\"center\">08:05</div>",D:"TELLING TIME",X:"",A:"N"},{DECK_ID:"A08",ID:"A08013",N:"<div class=\"center\">ti p\xe5 halv fire <br>(om ettermiddagen)</div>",E:"<div class=\"center\">15:20</div>",D:"TELLING TIME",X:"<div class=\"center\"><div class=\"left\">Times <b class=\"bold\">past</b> the quarter tend to become times <b class=\"bold\">to</b> the half.</div></div>",A:"N"},{DECK_ID:"A08",ID:"A08014",N:"<div class=\"center\">ti over halv tre <br>(om ettermiddagen)</div>",E:"<div class=\"center\">14:40</div>",D:"TELLING TIME",X:"<div class=\"center\"><div class=\"left\">Times between :31 and :44 (included) tend to become times <b class=\"bold\">past</b> the half.</div></div>",A:"N"},{DECK_ID:"A08",ID:"A08015",N:"<div class=\"center\">ti p\xe5 ti <br>(om kvelden)</div>",E:"<div class=\"center\">21:50</div>",D:"TELLING TIME",X:"<div class=\"center\"><div class=\"left\">Times past :45 tend to become times <b class=\"bold\">to</b> the next full hour.</div></div>",A:"N"},{DECK_ID:"A08",ID:"A08016",N:"<div class=\"center\">klokka to <br>(om natta)</div>",E:"<div class=\"center\">02:00</div>",D:"TELLING TIME",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Klokka</span> is the definite form of <span class=\"italic\">ei klokke</span> (<span class=\"italic\">hunkj\xf8nn</span> noun). It is used like \"o'clock\" in English.</p>The part in brackets is optional unless confusion may arise.</div></div>",A:"N"},{DECK_ID:"A08",ID:"A08017",N:"<div class=\"center\">midnatt</div>",E:"<div class=\"center\">00:00</div>",D:"TELLING TIME",X:"",A:"N"},{DECK_ID:"A08",ID:"A08018",N:"<div class=\"center\">halv ett <br>(om ettermiddagen)</div>",E:"<div class=\"center\">12:30</div>",D:"TELLING TIME",X:"<div class=\"center\"><div class=\"left\">In Norwegian, 12:30 is called <span class=\"italic\">halv ett</span> (half one). This is because the counting starts from the current hour (twelve) and, from that perspective, it's as if we were halfway to get to one.</div></div>",A:"N"},{DECK_ID:"A08",ID:"A08019",N:"<div class=\"center\">ti over ni <br>(om morgenen)</div>",E:"<div class=\"center\">09:10</div>",D:"TELLING TIME",X:"",A:"N"},{DECK_ID:"A08",ID:"A08020",N:"<div class=\"center\">fem over halv seks <br>(om morgenen)</div>",E:"<div class=\"center\">05:35</div>",D:"TELLING TIME",X:"<div class=\"center\"><div class=\"left\">Times between :31 and :44 (included) can be expressed as times <b class=\"bold\">past</b> the half.</div></div>",A:"N"},{DECK_ID:"A08",ID:"A08021",N:"<div class=\"center\">fem p\xe5 fire <br>(om natta)</div>",E:"<div class=\"center\">03:55</div>",D:"TELLING TIME",X:"<div class=\"center\"><div class=\"left\">Times past :45 tend to become times <b class=\"bold\">to</b> the next full hour.</div></div>",A:"N"},{DECK_ID:"A08",ID:"A08022",N:"<div class=\"center\">klokka tolv <br>(om ettermiddagen)</div>",E:"<div class=\"center\">12:00</div>",D:"TELLING TIME",X:"",A:"N"},{DECK_ID:"A08",ID:"A08023",N:"<div class=\"center\">kvart over elleve <br>(om formiddagen)</div>",E:"<div class=\"center\">11:15</div>",D:"TELLING TIME",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Over</span> is the equivalent of the English \"past\".</p><span class=\"italic\">Formiddagen</span> is used for the late morning, starting from 09:30 or 10:00 and until midday.</div></div>",A:"N"},{DECK_ID:"A08",ID:"A08024",N:"<div class=\"center\">kvart p\xe5 to <br>(om natta)</div>",E:"<div class=\"center\">01:45</div>",D:"TELLING TIME",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">P\xe5</span> is the equivalent of the English \"to\"</div></div>",A:"N"},{DECK_ID:"A08",ID:"A08025",N:"<div class=\"center\">halv tolv <br>(om formiddagen)</div>",E:"<div class=\"center\">11:30</div>",D:"TELLING TIME",X:"<div class=\"center\"><div class=\"left\">In Norwegian, 11:30 is called <span class=\"italic\">halv tolv</span> (half twelve). This is because the counting starts from the current hour (eleven) and, from that perspective, it's as if we were halfway to get to twelve.<br>Also, <span class=\"italic\">formiddagen</span> is used for the late morning, starting from 09:30 or 10:00 and until midday.</div></div>",A:"N"},{DECK_ID:"A08",ID:"A08026",N:"<div class=\"center\">fem p\xe5 halv elleve <br>(om kvelden)</div>",E:"<div class=\"center\">22:25</div>",D:"TELLING TIME",X:"<div class=\"center\"><div class=\"left\">Times <b class=\"bold\">past</b> the quarter tend to become times <b class=\"bold\">to</b> the half.</div></div>",A:"N"},{DECK_ID:"A08",ID:"A08027",N:"<div class=\"center\">sju null \xe9n</div>",E:"<div class=\"center\">07:01</div>",D:"TELLING TIME",X:"<div class=\"center\"><div class=\"left\"><p>Very specific times (e.g. train times) are most often expressed with the number for the hours (in 24h format) and the number for the minutes.</p>This time could also be <span class=\"italic\">ett over sju</span>.</div></div>",A:"N"},{DECK_ID:"A08",ID:"A08028",N:"<div class=\"center\">ni p\xe5 ett <br>(om natta)</div>",E:"<div class=\"center\">00:51</div>",D:"TELLING TIME",X:"<div class=\"center\"><div class=\"left\">Times past :45 tend to become times <b class=\"bold\">to</b> the next full hour.</div></div>",A:"N"},{DECK_ID:"A08",ID:"A08029",N:"<div class=\"center\">tjuetre f\xf8rtiseks <br>(om kvelden)</div>",E:"<div class=\"center\">23:46</div>",D:"TELLING TIME",X:"<div class=\"center\"><div class=\"left\"><p>Very specific times (e.g. train times) are most often expressed with the number for the hours and the number for the minutes.</p>Alternatively, this could be said as <span class=\"italic\">fjorten p\xe5 tolv</span>.</div></div>",A:"N"},{DECK_ID:"A08",ID:"A08030",N:"<div class=\"center\">ni trettini <br>(om formiddagen)</div>",E:"<div class=\"center\">09:39</div>",D:"TELLING TIME",X:"<div class=\"center\"><div class=\"left\"><p>Very specific times (e.g. train times) are most often expressed with the number for the hours and the number for the minutes.</p>Alternatively, this could be said as <span class=\"italic\">ni over halv ti</span>.</div></div>",A:"N"},{DECK_ID:"A08",ID:"A08031",N:"<div class=\"center\">ti sytten <br>(om formiddagen)</div>",E:"<div class=\"center\">10:17</div>",D:"TELLING TIME",X:"<div class=\"center\"><div class=\"left\"><p>Very specific times (e.g. train times) are most often expressed with the number for the hours and the number for the minutes.</p>Alternatively, this could be said as <span class=\"italic\">tretten p\xe5 halv elleve</span>.</div></div>",A:"N"},{DECK_ID:"A08",ID:"A08032",N:"<div class=\"center\">seksten tjuesju <br>(om ettermiddagen)</div>",E:"<div class=\"center\">16:27</div>",D:"TELLING TIME",X:"<div class=\"center\"><div class=\"left\"><p>Very specific times (e.g. train times) are most often expressed with the number for the hours and the number for the minutes.</p>Alternatively, this could be said as <span class=\"italic\">tre p\xe5 halv fem</span>.</div></div>",A:"N"},{DECK_ID:"A08",ID:"A08033",N:"<div class=\"center\">tre f\xf8rtito <br>(om natta)</div>",E:"<div class=\"center\">03:42</div>",D:"TELLING TIME",X:"<div class=\"center\"><div class=\"left\"><p>Very specific times (e.g. train times) are most often expressed with the number for the hours and the number for the minutes.</p>Alternatively, this could be said as <span class=\"italic\">atten p\xe5 fire</span>.</div></div>",A:"N"},{DECK_ID:"A08",ID:"A08034",N:"<div class=\"center\">nitten tjuetre <br>(om kvelden)</div>",E:"<div class=\"center\">19:23</div>",D:"TELLING TIME",X:"<div class=\"center\"><div class=\"left\"><p>Very specific times (e.g. train times) are most often expressed with the number for the hours and the number for the minutes.</p>Alternatively, this could be said as <span class=\"italic\">sju p\xe5 halv \xe5tte</span>.</div></div>",A:"N"},{DECK_ID:"A08",ID:"A08035",N:"<div class=\"center\">sytten trettifire <br>(om ettermiddagen)</div>",E:"<div class=\"center\">17:34</div>",D:"TELLING TIME",X:"<div class=\"center\"><div class=\"left\"><p>Very specific times (e.g. train times) are most often expressed with the number for the hours and the number for the minutes.</p>Alternatively, this could be said as <span class=\"italic\">fire over halv seks</span>.</div></div>",A:"N"},{DECK_ID:"A09",ID:"A09001",N:"<div class=\"center\">Jeg er syk</div>",E:"<div class=\"center\">I feel unwell</div>",D:"EMERGENCY SITUATIONS",X:"<div class=\"center\">Literally: I am sick</div>",A:"N"},{DECK_ID:"A09",ID:"A09002",N:"<div class=\"center\">Jeg har hodepine</div>",E:"<div class=\"center\">I have a headache</div>",D:"EMERGENCY SITUATIONS",X:"<div class=\"center\"><span class=\"italic\">Pine</span> means \"pain\"</div>",A:"N"},{DECK_ID:"A09",ID:"A09003",N:"<div class=\"center\">Jeg har tannpine</div>",E:"<div class=\"center\">I have toothache</div>",D:"EMERGENCY SITUATIONS",X:"<div class=\"center\"><span class=\"italic\">Pine</span> means \"pain\"</div>",A:"N"},{DECK_ID:"A09",ID:"A09004",N:"<div class=\"center\">Jeg bl\xf8r</div>",E:"<div class=\"center\">I am bleeding</div>",D:"EMERGENCY SITUATIONS",X:"<div class=\"center\"><div class=\"left\"><p>Literally: I bleed</p>Note how Norwegian doesn't quite translate the continuous form with -ING of English, it just tends to use the present instead.</div></div>",A:"N"},{DECK_ID:"A09",ID:"A09005",N:"<div class=\"center\">Jeg har vondt i magen</div>",E:"<div class=\"center\">I have a stomach-ache</div>",D:"EMERGENCY SITUATIONS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">Jeg har vondt i</span> means that a certain part of your body hurts.</div></div>",A:"N"},{DECK_ID:"A09",ID:"A09006",N:"<div class=\"center\">Jeg vil snakke med en lege</div>",E:"<div class=\"center\">I want to talk to a doctor</div>",D:"EMERGENCY SITUATIONS",X:"<div class=\"center\"><div class=\"left\"><p>Remember: the verb that comes after a modal verb such as <span class=\"italic\">vil</span> needs to be in the bare infinitive.</p>Moreover, <span class=\"italic\">vil</span> mostly translates as \"want to\". It rarely translates as \"will\" (i.e. future tense), despite the similar spelling.</div></div>",A:"N"},{DECK_ID:"A09",ID:"A09007",N:"<div class=\"center\">Jeg vil snakke med en tannlege</div>",E:"<div class=\"center\">I want to talk to a dentist</div>",D:"EMERGENCY SITUATIONS",X:"<div class=\"center\"><div class=\"left\"><p>Remember: the verb that comes after a modal verb such as <span class=\"italic\">vil</span> needs to be in the bare infinitive.</p>Moreover, <span class=\"italic\">vil</span> mostly translates as \"want to\". It rarely translates as \"will\" (i.e. future tense), despite the similar spelling.</div></div>",A:"N"},{DECK_ID:"A09",ID:"A09008",N:"<div class=\"center\">Jeg har feber</div>",E:"<div class=\"center\">I have a fever</div>",D:"EMERGENCY SITUATIONS",X:"<div class=\"center\"><div class=\"left\"><p>Literally: I have fever</p>Norwegian might omit the article (i.e. \"a\") whereas English has it.</div></div>",A:"N"},{DECK_ID:"A09",ID:"A09009",N:"<div class=\"center\">Kan du ringe ambulansen?</div>",E:"<div class=\"center\">Can you call the ambulance?</div>",D:"EMERGENCY SITUATIONS",X:"<div class=\"center\"><div class=\"left\">Remember: the verb that comes after a modal verb such as <span class=\"italic\">kan</span> needs to be in the bare infinitive (i.e. infinitive without <span class=\"italic\">\xe5</span>), just like in English.</div></div>",A:"N"},{DECK_ID:"A09",ID:"A09010",N:"<div class=\"center\">Jeg har blitt ranet</div>",E:"<div class=\"center\">I have been robbed</div>",D:"EMERGENCY SITUATIONS",X:"<div class=\"center\"><div class=\"left\"><p>Literally: I have become robbed.</p>The verb <span class=\"italic\">\xe5 bli</span> is used for passive constructions.</div></div>",A:"N"},{DECK_ID:"A09",ID:"A09011",N:"<div class=\"center\">Jeg har mistet telefonen min</div>",E:"<div class=\"center\">I have lost my phone</div>",D:"EMERGENCY SITUATIONS",X:"<div class=\"center\"><div class=\"left\">Remember how the most common use of possessive adjectives is with the definite noun first (the object of possession) and the possessive adjective after, matching the object in gender and number.</div></div>",A:"N"},{DECK_ID:"A09",ID:"A09012",N:"<div class=\"center\">Jeg har mistet lommeboka mi</div>",E:"<div class=\"center\">I have lost my wallet</div>",D:"EMERGENCY SITUATIONS",X:"<div class=\"center\"><div class=\"left\">Remember how the most common use of possessive adjectives is with the definite noun first (the object of possession) and the possessive adjective after, matching the object in gender and number.<br>In this case, the feminine version <span class=\"italic\">mi</span> is used.</div></div>",A:"N"},{DECK_ID:"A09",ID:"A09013",N:"<div class=\"center\">Jeg har mistet passet mitt</div>",E:"<div class=\"center\">I have lost my passport</div>",D:"EMERGENCY SITUATIONS",X:"<div class=\"center\"><div class=\"left\">Remember how the most common use of possessive adjectives is with the definite noun first (the object of possession) and the possessive adjective after, matching the object in gender and number.</div></div>",A:"N"},{DECK_ID:"A09",ID:"A09014",N:"<div class=\"center\">Jeg har blitt overfalt</div>",E:"<div class=\"center\">I have been assaulted</div>",D:"EMERGENCY SITUATIONS",X:"<div class=\"center\"><div class=\"left\"><p>Literally: I have become assaulted.</p>The verb <span class=\"italic\">\xe5 bli</span> is used for passive constructions.</div></div>",A:"N"},{DECK_ID:"A09",ID:"A09015",N:"<div class=\"center\">Hvor er politistasjonen?</div>",E:"<div class=\"center\">Where is the police station?</div>",D:"EMERGENCY SITUATIONS",X:"",A:"N"},{DECK_ID:"A09",ID:"A09016",N:"<div class=\"center\">Hvor er sykehuset?</div>",E:"<div class=\"center\">Where is the hospital?</div>",D:"EMERGENCY SITUATIONS",X:"",A:"N"},{DECK_ID:"A09",ID:"A09017",N:"<div class=\"center\">G\xe5 vekk!</div>",E:"<div class=\"center\">Leave me alone!</div>",D:"EMERGENCY SITUATIONS",X:"<div class=\"center\">Literally: go away</div>",A:"N"},{DECK_ID:"A09",ID:"A09018",N:"<div class=\"center\">Hjelp! Politi!</div>",E:"<div class=\"center\">Help! Police!</div>",D:"EMERGENCY SITUATIONS",X:"",A:"N"},{DECK_ID:"A09",ID:"A09019",N:"<div class=\"center\">Det brenner!</div>",E:"<div class=\"center\">There is a fire!</div>",D:"EMERGENCY SITUATIONS",X:"<div class=\"center\">Literally: it's burning!</div>",A:"N"},{DECK_ID:"A09",ID:"A09020",N:"<div class=\"center\">Det har v\xe6rt en ulykke</div>",E:"<div class=\"center\">There has been an accident</div>",D:"EMERGENCY SITUATIONS",X:"",A:"N"},{DECK_ID:"A10",ID:"A10001",N:"<div class=\"center\">How do you spell that in Norwegian?</div>",E:"<div class=\"center\">Hvordan staver du det p\xe5 norsk?</div>",D:"THE ALPHABET",X:"<div class=\"center\"><div class=\"left\"><p>Literally: how spell you it in Norwegian?</p>Remember that Norwegian does not require \"do\" as a help verb to make questions.</div></div>",A:"E"},{DECK_ID:"A10",ID:"A10002",N:"<div class=\"center\"><p>Provide the Norwegian name of the letter</p><span class=\"lg\">A</span></div>",E:"<div class=\"center\">a</div>",D:"THE ALPHABET",X:"<div class=\"center\"><div class=\"left\">Knowing the name of letters is important to spell information such as your name, surname and place of birth, or to be told how certain Norwegian words are spelled.</div></div>",A:"E"},{DECK_ID:"A10",ID:"A10003",N:"<div class=\"center\"><p>Provide the Norwegian name of the letter</p><span class=\"lg\">B</span></div>",E:"<div class=\"center\">be</div>",D:"THE ALPHABET",X:"",A:"E"},{DECK_ID:"A10",ID:"A10004",N:"<div class=\"center\"><p>Provide the Norwegian name of the letter</p><span class=\"lg\">C</span></div>",E:"<div class=\"center\">se</div>",D:"THE ALPHABET",X:"",A:"E"},{DECK_ID:"A10",ID:"A10005",N:"<div class=\"center\"><p>Provide the Norwegian name of the letter</p><span class=\"lg\">D</span></div>",E:"<div class=\"center\">de</div>",D:"THE ALPHABET",X:"",A:"E"},{DECK_ID:"A10",ID:"A10006",N:"<div class=\"center\"><p>Provide the Norwegian name of the letter</p><span class=\"lg\">E</span></div>",E:"<div class=\"center\">e</div>",D:"THE ALPHABET",X:"",A:"E"},{DECK_ID:"A10",ID:"A10007",N:"<div class=\"center\"><p>Provide the Norwegian name of the letter</p><span class=\"lg\">F</span></div>",E:"<div class=\"center\">eff</div>",D:"THE ALPHABET",X:"",A:"E"},{DECK_ID:"A10",ID:"A10008",N:"<div class=\"center\"><p>Provide the Norwegian name of the letter</p><span class=\"lg\">G</span></div>",E:"<div class=\"center\">ge</div>",D:"THE ALPHABET",X:"",A:"E"},{DECK_ID:"A10",ID:"A10009",N:"<div class=\"center\"><p>Provide the Norwegian name of the letter</p><span class=\"lg\">H</span></div>",E:"<div class=\"center\">h\xe5</div>",D:"THE ALPHABET",X:"",A:"E"},{DECK_ID:"A10",ID:"A10010",N:"<div class=\"center\"><p>Provide the Norwegian name of the letter</p><span class=\"lg\">I</span></div>",E:"<div class=\"center\">i</div>",D:"THE ALPHABET",X:"",A:"E"},{DECK_ID:"A10",ID:"A10011",N:"<div class=\"center\"><p>Provide the Norwegian name of the letter</p><span class=\"lg\">J</span></div>",E:"<div class=\"center\">jodd /<br>je</div>",D:"THE ALPHABET",X:"<div class=\"center\">The letter J has two names</div>",A:"E"},{DECK_ID:"A10",ID:"A10012",N:"<div class=\"center\"><p>Provide the Norwegian name of the letter</p><span class=\"lg\">K</span></div>",E:"<div class=\"center\">k\xe5</div>",D:"THE ALPHABET",X:"",A:"E"},{DECK_ID:"A10",ID:"A10013",N:"<div class=\"center\"><p>Provide the Norwegian name of the letter</p><span class=\"lg\">L</span></div>",E:"<div class=\"center\">ell</div>",D:"THE ALPHABET",X:"",A:"E"},{DECK_ID:"A10",ID:"A10014",N:"<div class=\"center\"><p>Provide the Norwegian name of the letter</p><span class=\"lg\">M</span></div>",E:"<div class=\"center\">emm</div>",D:"THE ALPHABET",X:"",A:"E"},{DECK_ID:"A10",ID:"A10015",N:"<div class=\"center\"><p>Provide the Norwegian name of the letter</p><span class=\"lg\">N</span></div>",E:"<div class=\"center\">enn</div>",D:"THE ALPHABET",X:"",A:"E"},{DECK_ID:"A10",ID:"A10016",N:"<div class=\"center\"><p>Provide the Norwegian name of the letter</p><span class=\"lg\">O</span></div>",E:"<div class=\"center\">o</div>",D:"THE ALPHABET",X:"",A:"E"},{DECK_ID:"A10",ID:"A10017",N:"<div class=\"center\"><p>Provide the Norwegian name of the letter</p><span class=\"lg\">P</span></div>",E:"<div class=\"center\">pe</div>",D:"THE ALPHABET",X:"",A:"E"},{DECK_ID:"A10",ID:"A10018",N:"<div class=\"center\"><p>Provide the Norwegian name of the letter</p><span class=\"lg\">Q</span></div>",E:"<div class=\"center\">ku</div>",D:"THE ALPHABET",X:"",A:"E"},{DECK_ID:"A10",ID:"A10019",N:"<div class=\"center\"><p>Provide the Norwegian name of the letter</p><span class=\"lg\">R</span></div>",E:"<div class=\"center\">err</div>",D:"THE ALPHABET",X:"",A:"E"},{DECK_ID:"A10",ID:"A10020",N:"<div class=\"center\"><p>Provide the Norwegian name of the letter</p><span class=\"lg\">S</span></div>",E:"<div class=\"center\">ess</div>",D:"THE ALPHABET",X:"",A:"E"},{DECK_ID:"A10",ID:"A10021",N:"<div class=\"center\"><p>Provide the Norwegian name of the letter</p><span class=\"lg\">T</span></div>",E:"<div class=\"center\">te</div>",D:"THE ALPHABET",X:"",A:"E"},{DECK_ID:"A10",ID:"A10022",N:"<div class=\"center\"><p>Provide the Norwegian name of the letter</p><span class=\"lg\">U</span></div>",E:"<div class=\"center\">u</div>",D:"THE ALPHABET",X:"",A:"E"},{DECK_ID:"A10",ID:"A10023",N:"<div class=\"center\"><p>Provide the Norwegian name of the letter</p><span class=\"lg\">V</span></div>",E:"<div class=\"center\">ve</div>",D:"THE ALPHABET",X:"",A:"E"},{DECK_ID:"A10",ID:"A10024",N:"<div class=\"center\"><p>Provide the Norwegian name of the letter</p><span class=\"lg\">W</span></div>",E:"<div class=\"center\">dobbelt ve</div>",D:"THE ALPHABET",X:"",A:"E"},{DECK_ID:"A10",ID:"A10025",N:"<div class=\"center\"><p>Provide the Norwegian name of the letter</p><span class=\"lg\">X</span></div>",E:"<div class=\"center\">eks</div>",D:"THE ALPHABET",X:"",A:"E"},{DECK_ID:"A10",ID:"A10026",N:"<div class=\"center\"><p>Provide the Norwegian name of the letter</p><span class=\"lg\">Y</span></div>",E:"<div class=\"center\">y</div>",D:"THE ALPHABET",X:"",A:"E"},{DECK_ID:"A10",ID:"A10027",N:"<div class=\"center\"><p>Provide the Norwegian name of the letter</p><span class=\"lg\">Z</span></div>",E:"<div class=\"center\">sett</div>",D:"THE ALPHABET",X:"",A:"E"},{DECK_ID:"A10",ID:"A10028",N:"<div class=\"center\"><p>Provide the Norwegian name of the letter</p><span class=\"lg\">\xc6</span></div>",E:"<div class=\"center\">\xe6</div>",D:"THE ALPHABET",X:"",A:"E"},{DECK_ID:"A10",ID:"A10029",N:"<div class=\"center\"><p>Provide the Norwegian name of the letter</p><span class=\"lg\">\xd8</span></div>",E:"<div class=\"center\">\xf8</div>",D:"THE ALPHABET",X:"",A:"E"},{DECK_ID:"A10",ID:"A10030",N:"<div class=\"center\"><p>Provide the Norwegian name of the letter</p><span class=\"lg\">\xc5</span></div>",E:"<div class=\"center\">\xe5</div>",D:"THE ALPHABET",X:"<div class=\"center\"><div class=\"left\"><p>This is the last letter of the Norwegian alphabet.</p>Therefore, expressions such as \"from A to Z\" become <span class=\"italic\">fra A til \xc5</span>.</div></div>",A:"E"},{DECK_ID:"A11",ID:"A11001",N:"<div class=\"center\">Vi bor der</div>",E:"<div class=\"center\">We live there</div>",D:"LISTENING PRACTICE",X:"",A:"N"},{DECK_ID:"A11",ID:"A11002",N:"<div class=\"center\">Hvem er du?</div>",E:"<div class=\"center\">Who are you?</div>",D:"LISTENING PRACTICE",X:"",A:"N"},{DECK_ID:"A11",ID:"A11003",N:"<div class=\"center\">Er du sliten?</div>",E:"<div class=\"center\">Are you tired?</div>",D:"LISTENING PRACTICE",X:"<div class=\"center\"><div class=\"left\">Note that the S in <span class=\"italic\">sliten</span> is essentially pronounced like the English \"SH\", because it's followed by an L.</div></div>",A:"N"},{DECK_ID:"A11",ID:"A11004",N:"<div class=\"center\">Vil du bli med?</div>",E:"<div class=\"center\">Do you want to join?</div>",D:"LISTENING PRACTICE",X:"<div class=\"center\"><div class=\"left\"><p>Literally: want you become with?</p>Remember that there is no equivalent of the use of \"do\" as a mandatory auxiliary to create questions.</div></div>",A:"N"},{DECK_ID:"A11",ID:"A11005",N:"<div class=\"center\">Beklager, jeg vet ikke.</div>",E:"<div class=\"center\">I'm sorry, I don't know.</div>",D:"LISTENING PRACTICE",X:"",A:"N"},{DECK_ID:"A11",ID:"A11006",N:"<div class=\"center\">Jeg vil spise n\xe5</div>",E:"<div class=\"center\">I want to eat now</div>",D:"LISTENING PRACTICE",X:"<div class=\"center\"><div class=\"left\"><p>Remember: the verb that comes after a modal verb such as <span class=\"italic\">vil</span> needs to be in the bare infinitive.</p>Moreover, <span class=\"italic\">vil</span> mostly translates as \"want to\". It rarely translates as \"will\" (i.e. future tense), despite the similar spelling.</div></div>",A:"N"},{DECK_ID:"A11",ID:"A11007",N:"<div class=\"center\">De er gode venner</div>",E:"<div class=\"center\">They are good friends</div>",D:"LISTENING PRACTICE",X:"<div class=\"center\"><div class=\"left\">Remember that the D in <span class=\"italic\">gode</span> is silent.</div></div>",A:"N"},{DECK_ID:"A11",ID:"A11008",N:"<div class=\"center\">Hvor gammel er du?</div>",E:"<div class=\"center\">How old are you?</div>",D:"LISTENING PRACTICE",X:"<div class=\"center\"><div class=\"left\">Remember that Norwegian equivalent of expressions such as \"how much\", \"how long\", \"how old\" etc requires <span class=\"italic\">hvor</span> (i.e. \"where\") rather than <span class=\"italic\">hvordan</span> (i.e. \"how\"), as a direct translation might make you think.</div></div>",A:"N"},{DECK_ID:"A11",ID:"A11009",N:"<div class=\"center\">Trenger du penger?</div>",E:"<div class=\"center\">Do you need money?</div>",D:"LISTENING PRACTICE",X:"<div class=\"center\"><div class=\"left\"><p>Literally: need you money?</p>Remember that there is no equivalent of the use of \"do\" as a mandatory auxiliary to create questions.</div></div>",A:"N"},{DECK_ID:"A11",ID:"A11010",N:"<div class=\"center\">Vi har ikke mye tid</div>",E:"<div class=\"center\">We don't have much time</div>",D:"LISTENING PRACTICE",X:"",A:"N"},{DECK_ID:"A11",ID:"A11011",N:"<div class=\"center\">Hva er klokka?</div>",E:"<div class=\"center\">What's the time?</div>",D:"LISTENING PRACTICE",X:"<div class=\"center\"><div class=\"left\"><p>This sentence is read in a dialect that pronounces <span class=\"italic\">hva</span> as \"ka\".</p>This can happen also for <span class=\"italic\">hvem</span> (which becomes \"kem\").</div></div>",A:"N"},{DECK_ID:"A11",ID:"A11012",N:"<div class=\"center\">Har du sett l\xe6reren?</div>",E:"<div class=\"center\">Have you seen the teacher?</div>",D:"LISTENING PRACTICE",X:"<div class=\"center\"><div class=\"left\">This sentence is also read in a dialect, but it affects mostly the \"melody\", not the actual sounds.</div></div>",A:"N"},{DECK_ID:"A11",ID:"A11013",N:"<div class=\"center\">Hun dro til byen i g\xe5r</div>",E:"<div class=\"center\">She went to town yesterday</div>",D:"LISTENING PRACTICE",X:"",A:"N"},{DECK_ID:"A11",ID:"A11014",N:"<div class=\"center\">Hvor er du? Er du i n\xe6rheten?</div>",E:"<div class=\"center\">Where are you? Are you near?</div>",D:"LISTENING PRACTICE",X:"<div class=\"center\"><div class=\"left\">The expression <span class=\"italic\">i n\xe6rheten</span> literally means \"in the vicinity\".</div></div>",A:"N"},{DECK_ID:"A11",ID:"A11015",N:"<div class=\"center\">Var du p\xe5 skolen i g\xe5r?</div>",E:"<div class=\"center\">Were you at the school yesterday?</div>",D:"LISTENING PRACTICE",X:"",A:"N"},{DECK_ID:"A11",ID:"A11016",N:"<div class=\"center\">Hva gj\xf8r du p\xe5 s\xf8ndag?</div>",E:"<div class=\"center\">What are you doing on Sunday?</div>",D:"LISTENING PRACTICE",X:"<div class=\"center\"><div class=\"left\"><p>This sentence is read in a dialect that pronounces <span class=\"italic\">hva</span> as \"ka\".</p>This can happen also for <span class=\"italic\">hvem</span> (which becomes \"kem\").</div></div>",A:"N"},{DECK_ID:"A11",ID:"A11017",N:"<div class=\"center\">Tusen takk for hjelpen!</div>",E:"<div class=\"center\">Thanks a lot for the help!</div>",D:"LISTENING PRACTICE",X:"",A:"N"},{DECK_ID:"A11",ID:"A11018",N:"<div class=\"center\">Hva skjer i byen i dag?</div>",E:"<div class=\"center\">What's happening in town today?</div>",D:"LISTENING PRACTICE",X:"<div class=\"center\"><div class=\"left\">Note that the variation <span class=\"italic\">p\xe5 byen</span> would be used for nightlife or evening events taking place in town.</div></div>",A:"N"},{DECK_ID:"A11",ID:"A11019",N:"<div class=\"center\">Hva vil du ha til middag?</div>",E:"<div class=\"center\">What do you want to have for dinner?</div>",D:"LISTENING PRACTICE",X:"<div class=\"center\"><div class=\"left\"><p>Remember: the verb that comes after a modal verb such as <span class=\"italic\">vil</span> needs to be in the bare infinitive.</p>Moreover, <span class=\"italic\">vil</span> mostly translates as \"want to\". It rarely translates as \"will\" (i.e. future tense), despite the similar spelling.</div></div>",A:"N"},{DECK_ID:"A11",ID:"A11020",N:"<div class=\"center\">Det er veldig kaldt i dag</div>",E:"<div class=\"center\">It's very cold today</div>",D:"LISTENING PRACTICE",X:"<div class=\"center\">Note that the D in <span class=\"italic\">kaldt</span> is silent.</div>",A:"N"},{DECK_ID:"A11",ID:"A11021",N:"<div class=\"center\">Bilen du vil kj\xf8pe er dyr</div>",E:"<div class=\"center\">The car you want to buy is expensive</div>",D:"LISTENING PRACTICE",X:"<div class=\"center\"><div class=\"left\"><p>Remember: the verb that comes after a modal verb such as <span class=\"italic\">vil</span> needs to be in the bare infinitive.</p>Moreover, <span class=\"italic\">vil</span> mostly translates as \"want to\". It rarely translates as \"will\" (i.e. future tense), despite the similar spelling.</div></div>",A:"N"},{DECK_ID:"A11",ID:"A11022",N:"<div class=\"center\">Jeg kan vente hvis du vil</div>",E:"<div class=\"center\">I can wait if you want</div>",D:"LISTENING PRACTICE",X:"<div class=\"center\"><div class=\"left\">Remember: the verb that comes after a modal verb such as <span class=\"italic\">kan</span> needs to be in the bare infinitive (i.e. infinitive without <span class=\"italic\">\xe5</span>), just like in English.</div></div>",A:"N"},{DECK_ID:"A11",ID:"A11023",N:"<div class=\"center\">Har du funnet en leilighet?</div>",E:"<div class=\"center\">Have you found an apartment?</div>",D:"LISTENING PRACTICE",X:"<div class=\"center\">This is read with a northern accent</div>",A:"N"},{DECK_ID:"A11",ID:"A11024",N:"<div class=\"center\">Hvorfor studerer du norsk?</div>",E:"<div class=\"center\">Why are you studying Norwegian?</div>",D:"LISTENING PRACTICE",X:"<div class=\"center\"><div class=\"left\">\"Why do you study Norwegian?\" would also be an acceptable translation.</div></div>",A:"N"},{DECK_ID:"A11",ID:"A11025",N:"<div class=\"center\">Mandag var verre enn i dag</div>",E:"<div class=\"center\">Monday was worse than today</div>",D:"LISTENING PRACTICE",X:"",A:"N"},{DECK_ID:"A11",ID:"A11026",N:"<div class=\"center\">Jeg liker \xe5 bo her i Norge</div>",E:"<div class=\"center\">I like to live here in Norway</div>",D:"LISTENING PRACTICE",X:"<div class=\"center\"><div class=\"left\">This is read with a northern accent: <span class=\"italic\">jeg</span> is basically reduced to <span class=\"italic\">\xe6</span> and the ER endings can be very open, almost \"ar\" as in the English words \"far\" or \"bar\".</div></div>",A:"N"},{DECK_ID:"A11",ID:"A11027",N:"<div class=\"center\">Hva sa du? <br>Jeg forstod ikke.</div>",E:"<div class=\"center\">What did you say? <br>I didn't understand.</div>",D:"LISTENING PRACTICE",X:"",A:"N"},{DECK_ID:"A11",ID:"A11028",N:"<div class=\"center\">Det er verre enn jeg trodde</div>",E:"<div class=\"center\">It's worse than I believed</div>",D:"LISTENING PRACTICE",X:"<div class=\"center\"><div class=\"left\">Note that the O in <span class=\"italic\">trodde</span> has the sound of the U in the English word \"pull\" rather than that of the O of \"not\", even though it's followed by two consonants.<br>This is because its root is <span class=\"italic\">\xe5 tro</span>.</div></div>",A:"N"},{DECK_ID:"A11",ID:"A11029",N:"<div class=\"center\">Jeg skal kj\xf8pe en ny sykkel</div>",E:"<div class=\"center\">I will buy a new bicycle</div>",D:"LISTENING PRACTICE",X:"<div class=\"center\"><div class=\"left\"><p>This is read with a northern accent.</p>Also, this example shows how the verb \"will\" in English (used to indicate a future event) is mostly translated with the Norwegian modal <span class=\"italic\">skal</span> and rather rarely with the Norwegian modal <span class=\"italic\">vil</span>.</div></div>",A:"N"},{DECK_ID:"A11",ID:"A11030",N:"<div class=\"center\">N\xe5r kan jeg snakke med deg?</div>",E:"<div class=\"center\">When can I talk to you?</div>",D:"LISTENING PRACTICE",X:"<div class=\"center\"><div class=\"left\">This is read with a northern accent, note how the EG ending of <span class=\"italic\">deg</span> becomes simply <span class=\"italic\">\xe6</span>.</div></div>",A:"N"},{DECK_ID:"A11",ID:"A11031",N:"<div class=\"center\">Han liker \xe5 snakke om jenter</div>",E:"<div class=\"center\">He likes to talk about girls</div>",D:"LISTENING PRACTICE",X:"",A:"N"},{DECK_ID:"A11",ID:"A11032",N:"<div class=\"center\">Hvordan sier du det p\xe5 norsk?</div>",E:"<div class=\"center\">How do you say that in Norwegian?</div>",D:"LISTENING PRACTICE",X:"",A:"N"},{DECK_ID:"A11",ID:"A11033",N:"<div class=\"center\">Hva vil du ha? Kaffe eller \xf8l?</div>",E:"<div class=\"center\">What do you want? Coffee or beer?</div>",D:"LISTENING PRACTICE",X:"<div class=\"center\"><div class=\"left\"><p>Remember: the verb that comes after a modal verb such as <span class=\"italic\">vil</span> needs to be in the bare infinitive.</p>Moreover, <span class=\"italic\">vil</span> mostly translates as \"want to\". It rarely translates as \"will\" (i.e. future tense), despite the similar spelling.</div></div>",A:"N"},{DECK_ID:"A11",ID:"A11034",N:"<div class=\"center\">Jeg synes at du er en god mann</div>",E:"<div class=\"center\">I think that you are a good man/husband</div>",D:"LISTENING PRACTICE",X:"<div class=\"center\"><div class=\"left\"><p>Note that when \"that\" is used as a conjunction, it is <span class=\"italic\">at</span> in Norwegian.</p>To tell the difference, if \"that\" can't quite be substituted by \"it\" (which is a pronoun), then it's probably being used as a conjunction.</div></div>",A:"N"},{DECK_ID:"A11",ID:"A11035",N:"<div class=\"center\">Det har blitt sent, jeg m\xe5 dra.</div>",E:"<div class=\"center\">It got late, I must leave.</div>",D:"LISTENING PRACTICE",X:"<div class=\"center\"><div class=\"left\">Remember that <span class=\"italic\">\xe5 dra</span> would cover \"to leave/to go\" in general, whereas <span class=\"italic\">\xe5 g\xe5</span> would imply leaving on foot.</div></div>",A:"N"},{DECK_ID:"A11",ID:"A11036",N:"<div class=\"center\">Jeg vet ikke hva de arbeider som</div>",E:"<div class=\"center\">I don't know what they work as</div>",D:"LISTENING PRACTICE",X:"",A:"N"},{DECK_ID:"A11",ID:"A11037",N:"<div class=\"center\">Jeg kan hjelpe deg med maten til lunsj</div>",E:"<div class=\"center\">I can help you with the food for lunch</div>",D:"LISTENING PRACTICE",X:"<div class=\"center\"><div class=\"left\">Remember: the verb that comes after a modal verb such as <span class=\"italic\">kan</span> needs to be in the bare infinitive.</div></div>",A:"N"},{DECK_ID:"A11",ID:"A11038",N:"<div class=\"center\">Beklager, jeg m\xe5 arbeide i kveld.</div>",E:"<div class=\"center\">I'm sorry, I have to work this evening.</div>",D:"LISTENING PRACTICE",X:"",A:"N"},{DECK_ID:"A11",ID:"A11039",N:"<div class=\"center\">Det blir kaldt p\xe5 fredag ogs\xe5</div>",E:"<div class=\"center\">It will be cold on Friday too</div>",D:"LISTENING PRACTICE",X:"<div class=\"center\"><div class=\"left\">Here is an example in which the English future with \"will\" can be translated simply with the present of <span class=\"italic\">\xe5 bli</span>.</div></div>",A:"N"},{DECK_ID:"A11",ID:"A11040",N:"<div class=\"center\">Vi kom tidlig, s\xe5 vi m\xe5tte vente.</div>",E:"<div class=\"center\">We came early, so we had to wait.</div>",D:"LISTENING PRACTICE",X:"<div class=\"center\"><div class=\"left\">Remember that the G at the end of adjectives and adverbs ending in IG is silent.</div></div>",A:"N"},{DECK_ID:"A11",ID:"A11041",N:"<div class=\"center\">De ga dere hva dere trengte</div>",E:"<div class=\"center\">They gave you what you needed</div>",D:"LISTENING PRACTICE",X:"",A:"N"},{DECK_ID:"A11",ID:"A11042",N:"<div class=\"center\">Vi blir i Stavanger i en uke</div>",E:"<div class=\"center\">We will stay in Stavanger for a week</div>",D:"LISTENING PRACTICE",X:"<div class=\"center\"><div class=\"left\">Remember that <span class=\"italic\">\xe5 bli</span> translates a number of verbs such as \"to become\", \"to get\", \"to stay\", \"to remain\".</div></div>",A:"N"},{DECK_ID:"A11",ID:"A11043",N:"<div class=\"center\">Hvem er gutten du snakket med?</div>",E:"<div class=\"center\">Who is the boy you talked with?</div>",D:"LISTENING PRACTICE",X:"<div class=\"center\"><div class=\"left\"><p>Remember that the D at the end of <span class=\"italic\">med</span> is silent.</p>This happens in many short words ending in D.</div></div>",A:"N"},{DECK_ID:"A11",ID:"A11044",N:"<div class=\"center\">Hva betyr det? Jeg husker ikke...</div>",E:"<div class=\"center\">What does it mean? I can't remember</div>",D:"LISTENING PRACTICE",X:"",A:"N"},{DECK_ID:"A11",ID:"A11045",N:"<div class=\"center\">Er du i byen? Skal vi ta en kaffe?</div>",E:"<div class=\"center\">Are you in town? Shall we take a coffee?</div>",D:"LISTENING PRACTICE",X:"",A:"N"},{DECK_ID:"A11",ID:"A11046",N:"<div class=\"center\">Hvem er hun? Hvor kommer hun fra?</div>",E:"<div class=\"center\">Who is she? Where is she from?</div>",D:"LISTENING PRACTICE",X:"<div class=\"center\"><div class=\"left\"><p>This sentence is read in a dialect that pronounces <span class=\"italic\">hvem</span> as \"kem\".</p>This can happen also for <span class=\"italic\">hva</span> (which becomes \"ka\").</div></div>",A:"N"},{DECK_ID:"A11",ID:"A11047",N:"<div class=\"center\">Det er litt dyrere enn jeg husket</div>",E:"<div class=\"center\">It's a bit more expensive than I remembered</div>",D:"LISTENING PRACTICE",X:"<div class=\"center\"><div class=\"left\">This is read with a northern accent in which the -ET endings of verbs can be pronounced (and even written) as -A.</div></div>",A:"N"},{DECK_ID:"A11",ID:"A11048",N:"<div class=\"center\">Jeg tror at du har kommet for sent</div>",E:"<div class=\"center\">I believe you've come too late</div>",D:"LISTENING PRACTICE",X:"<div class=\"center\"><div class=\"left\">Remember that \"too (much)\" is translated by <span class=\"italic\">for</span>.</div></div>",A:"N"},{DECK_ID:"A11",ID:"A11049",N:"<div class=\"center\">N\xe5r kommer de? Jeg kan ikke vente\u2026</div>",E:"<div class=\"center\">When are they coming? I cannot wait...</div>",D:"LISTENING PRACTICE",X:"<div class=\"center\"><div class=\"left\">Remember that <span class=\"italic\">ikke</span> has to go after the \"first verb\".<br>Therefore, in this case, it goes after the modal verb <span class=\"italic\">kan</span> and before <span class=\"italic\">vente</span>.</div></div>",A:"N"},{DECK_ID:"A11",ID:"A11050",N:"<div class=\"center\">Vil du snakke norsk eller engelsk?</div>",E:"<div class=\"center\">Do you want to speak Norwegian or English?</div>",D:"LISTENING PRACTICE",X:"<div class=\"center\"><div class=\"left\"><p>Remember: the verb that comes after a modal verb such as <span class=\"italic\">vil</span> needs to be in the bare infinitive.</p>Moreover, <span class=\"italic\">vil</span> mostly translates as \"want to\". It rarely translates as \"will\" (i.e. future tense), despite the similar spelling.</div></div>",A:"N"},{DECK_ID:"A11",ID:"A11051",N:"<div class=\"center\">Kjenner du gutten som var her f\xf8r?</div>",E:"<div class=\"center\">Do you know the guy that was here before?</div>",D:"LISTENING PRACTICE",X:"<div class=\"center\"><div class=\"left\"><p>Remember that <span class=\"italic\">\xe5 kjenne</span> means \"to know\" in the sense of \"to be acquainted with\".</p>Remember that the sound of KJ is <span class=\"italic\">similar</span> to the <b class=\"bold\">H</b> in \"<b class=\"bold\">h</b>ue\" and \"<b class=\"bold\">h</b>uge\".</div></div>",A:"N"},{DECK_ID:"A11",ID:"A11052",N:"<div class=\"center\">Jeg har f\xe5tt en jobb i dag, hurra!</div>",E:"<div class=\"center\">I've got a job today, hurrah!</div>",D:"LISTENING PRACTICE",X:"",A:"N"},{DECK_ID:"A11",ID:"A11053",N:"<div class=\"center\">Jeg liker hus bedre enn leiligheter</div>",E:"<div class=\"center\">I like houses better than apartments</div>",D:"LISTENING PRACTICE",X:"<div class=\"center\"><div class=\"left\">Remember that the indefinite plural of <span class=\"italic\">et hus</span> takes no ending.</div></div>",A:"N"},{DECK_ID:"A11",ID:"A11054",N:"<div class=\"center\">Hvorfor drikker du kaffe p\xe5 kvelden?</div>",E:"<div class=\"center\">Why do you drink coffee in the evening?</div>",D:"LISTENING PRACTICE",X:"",A:"N"},{DECK_ID:"A11",ID:"A11055",N:"<div class=\"center\">Jeg drar til Trondheim i morgen</div>",E:"<div class=\"center\">I'm going to Trondheim tomorrow</div>",D:"LISTENING PRACTICE",X:"<div class=\"center\"><div class=\"left\">This is read with a northern accent, note how <span class=\"italic\">jeg</span> becomes simply <span class=\"italic\">\xe6</span>.</div></div>",A:"N"},{DECK_ID:"A11",ID:"A11056",N:"<div class=\"center\">Vi kommer etter at vi har spist middag</div>",E:"<div class=\"center\">We come after we've had dinner</div>",D:"LISTENING PRACTICE",X:"",A:"N"},{DECK_ID:"A11",ID:"A11057",N:"<div class=\"center\">Hun jenta som drikker \xf8l bor her</div>",E:"<div class=\"center\">That girl who's drinking beer lives here</div>",D:"LISTENING PRACTICE",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">Han/hun</span> can be used as \"that\" when referring to people.</div></div>",A:"N"},{DECK_ID:"A11",ID:"A11058",N:"<div class=\"center\">Nei, jeg har ikke spist frokost i dag.</div>",E:"<div class=\"center\">No, I haven't eaten breakfast today.</div>",D:"LISTENING PRACTICE",X:"<div class=\"center\"><div class=\"left\">Remember that <span class=\"italic\">ikke</span> has to go after the \"first verb\".<br>Therefore, in this case, it goes after the help verb <span class=\"italic\">har</span> and before <span class=\"italic\">spist</span>.</div></div>",A:"N"},{DECK_ID:"A11",ID:"A11059",N:"<div class=\"center\">Vil du m\xf8te meg f\xf8r eller etter lunsj?</div>",E:"<div class=\"center\"><div class=\"left\">Do you want to meet (me) before or after lunch?</div></div>",D:"LISTENING PRACTICE",X:"<div class=\"center\"><div class=\"left\">Remember that <span class=\"italic\">\xe5 m\xf8te</span> requires an object (e.g. <span class=\"italic\">meg</span>) or, alternatively, the S ending of reciprocal forms.</div></div>",A:"N"},{DECK_ID:"A11",ID:"A11060",N:"<div class=\"center\">Leiligheten er stor men rommet er lite.</div>",E:"<div class=\"center\">The apartment is big, but the room is small.</div>",D:"LISTENING PRACTICE",X:"<div class=\"center\"><div class=\"left\">Note how the O in <span class=\"italic\">rommet</span> is pronounced like OO in \"hook\" in English, rather than the AW in \"law\", despite the latter being the more common sound for an O followed by two consonants.</div></div>",A:"N"},{DECK_ID:"A11",ID:"A11061",N:"<div class=\"center\">Jeg bor i n\xe6rheten av skolen.<br>Hvor bor du i byen?</div>",E:"<div class=\"center\">I live near the school.<br>Where in town do you live?</div>",D:"LISTENING PRACTICE",X:"<div class=\"center\"><div class=\"left\">The expression <span class=\"italic\">i n\xe6rheten</span> means \"in the vicinity\", \"in proximity\".</div></div>",A:"N"},{DECK_ID:"A11",ID:"A11062",N:"<div class=\"center\">Huset er veldig koselig, jeg liker det!</div>",E:"<div class=\"center\">The house is very cosy, I like it.</div>",D:"LISTENING PRACTICE",X:"<div class=\"center\"><div class=\"left\">This is read with a northern accent: <span class=\"italic\">jeg</span> is basically reduced to <span class=\"italic\">\xe6</span> and the ER endings can be very open, almost \"ar\" as in \"far\" or \"bar\".</div></div>",A:"N"},{DECK_ID:"A11",ID:"A11063",N:"<div class=\"center\">Vi kommer om en time hvis det er greit?</div>",E:"<div class=\"center\">We come in an hour if that's ok?</div>",D:"LISTENING PRACTICE",X:"<div class=\"center\"><div class=\"left\">The preposition <span class=\"italic\">om</span> is used to indicate a time that has to pass before something else can or will happen.</div></div>",A:"N"},{DECK_ID:"A11",ID:"A11064",N:"<div class=\"center\">Jeg vil kj\xf8pe en billett til Lillehammer</div>",E:"<div class=\"center\">I want to buy a ticket to Lillehammer</div>",D:"LISTENING PRACTICE",X:"<div class=\"center\"><div class=\"left\"><p>Remember: the verb that comes after a modal verb such as <span class=\"italic\">vil</span> needs to be in the bare infinitive.</p>Moreover, <span class=\"italic\">vil</span> mostly translates as \"want to\". It rarely translates as \"will\" (i.e. future tense), despite the similar spelling.</div></div>",A:"N"},{DECK_ID:"A11",ID:"A11065",N:"<div class=\"center\">Jeg holdt kaffen varm for deg, v\xe6r s\xe5 god!</div>",E:"<div class=\"center\">I kept the coffee warm for you, you're welcome.</div>",D:"LISTENING PRACTICE",X:"<div class=\"center\"><div class=\"left\">Remember that the simple past (<span class=\"italic\">preteritum</span>) of the verb <span class=\"italic\">\xe5 holde</span> is <span class=\"italic\">holdt</span> (same as the past participle).</div></div>",A:"N"},{DECK_ID:"A11",ID:"A11066",N:"<div class=\"center\">Vi spiser f\xf8r vi kommer og m\xf8ter dere</div>",E:"<div class=\"center\">We will eat before we come and meet you guys.</div>",D:"LISTENING PRACTICE",X:"",A:"N"},{DECK_ID:"A11",ID:"A11067",N:"<div class=\"center\">Ikke ta bussen, det er bedre med trikken.</div>",E:"<div class=\"center\">Don't take the bus, it's better with the tram.</div>",D:"LISTENING PRACTICE",X:"<div class=\"center\"><div class=\"left\"><p>When using the imperative like in this case (e.g. instructions and orders such as \"take!\" or \"don't take!\"), <span class=\"italic\">ikke</span> must go before the verb.</p>More on this in the \"Word order\" topic of the Intermediate section of Mj\xf8lnir.</div></div>",A:"N"},{DECK_ID:"A11",ID:"A11068",N:"<div class=\"center\">Har du forst\xe5tt hva de sa?</div>",E:"<div class=\"center\">Have you understood what they said?</div>",D:"LISTENING PRACTICE",X:"",A:"N"},{DECK_ID:"A11",ID:"A11069",N:"<div class=\"center\">Huset er gammelt og rommet er litt kaldt.</div>",E:"<div class=\"center\">The house is old and the room is a little cold.</div>",D:"LISTENING PRACTICE",X:"<div class=\"center\"><div class=\"left\">Note how the O in <span class=\"italic\">rommet</span> is pronounced like OO in \"hook\" in English, rather than the AW in \"law\", despite the latter being the more common sound for an O followed by two consonants.</div></div>",A:"N"},{DECK_ID:"A11",ID:"A11070",N:"<div class=\"center\">Den der er for dyr men denne er billigere.</div>",E:"<div class=\"center\">That one there is too expensive, but this is cheaper.</div>",D:"LISTENING PRACTICE",X:"<div class=\"center\"><div class=\"left\">Remember that the G in <span class=\"italic\">billigere</span> is silent, just like in the singular and plural forms of any adjective ending in -IG.</div></div>",A:"N"},{DECK_ID:"A11",ID:"A11071",N:"<div class=\"center\">De har to sm\xe5 barn som er p\xe5 to og fire \xe5r</div>",E:"<div class=\"center\">They have two small children <br>who are of two and four years of age</div>",D:"LISTENING PRACTICE",X:"<div class=\"center\"><div class=\"left\"><p>Remember that the adjective <span class=\"italic\">liten</span> differentiates between the plural form <span class=\"italic\">sm\xe5</span> and the definite singular <span class=\"italic\">lille</span>:</p><span class=\"italic\">liten, lite, lille/sm\xe5</span></div></div>",A:"N"},{DECK_ID:"A11",ID:"A11072",N:"<div class=\"center\">Vet du hva jenta heter?<br>Jeg husker ikke...</div>",E:"<div class=\"center\">Do you know what the girl is called?<br>I can't remember...</div>",D:"LISTENING PRACTICE",X:"",A:"N"},{DECK_ID:"A11",ID:"A11073",N:"<div class=\"center\">Jeg liker \xe5 arbeide her, det er mye \xe5 gj\xf8re.</div>",E:"<div class=\"center\">I like to work here, there is much to do.</div>",D:"LISTENING PRACTICE",X:"<div class=\"center\"><div class=\"left\">Note how <span class=\"italic\">liker</span>, not being a modal or auxiliary verb, requires the verb it refers to to have the full infinitive <span class=\"italic\">\xe5 arbeide</span>, just like English has \"I like <b class=\"bold\">to</b> work\".</div></div>",A:"N"},{DECK_ID:"A11",ID:"A11074",N:"<div class=\"center\">Jeg har sett legen f\xf8r, jeg tror hun bor der.</div>",E:"<div class=\"center\">I have seen the doctor before, I believe she lives there.</div>",D:"LISTENING PRACTICE",X:"<div class=\"center\"><div class=\"left\">Remember that <span class=\"italic\">\xe5 tro</span> implies a speculation or belief, whereas <span class=\"italic\">\xe5 synes</span> entails an opinion based on some kind of evidence or previous experience.</div></div>",A:"N"},{DECK_ID:"A11",ID:"A11075",N:"<div class=\"center\">Jeg burde studere n\xe5, <br>vi kan snakkes i morgen.</div>",E:"<div class=\"center\">I ought to study now, <br>we can talk (to each other) tomorrow.</div>",D:"LISTENING PRACTICE",X:"<div class=\"center\"><div class=\"left\"><p>Note how <span class=\"italic\">\xe5 burde</span> supports the bare infinitive, whereas its English equivalent \"ought\" doesn't.</p>Also, the verb after <span class=\"italic\">kan</span> is in the bare infinitive, but the -S is added for the reciprocal meaning.</div></div>",A:"N"},{DECK_ID:"A11",ID:"A11076",N:"<div class=\"center\">Ta veien til venstre og du vil finne skolen</div>",E:"<div class=\"center\">Take the street to the left and you will find the school</div>",D:"LISTENING PRACTICE",X:"<div class=\"center\"><div class=\"left\">The verb <span class=\"italic\">ta</span> is used in its imperative form here, which is most often the same as the bare infinitive, at least for verbs whose infinitive doesn't end in -E (more on this later).</div></div>",A:"N"},{DECK_ID:"A11",ID:"A11077",N:"<div class=\"center\">Kanskje vi kan ta bussen\u2026<br>Hva synes du?</div>",E:"<div class=\"center\">Maybe we can get the bus\u2026<br>What do you think?</div>",D:"LISTENING PRACTICE",X:"<div class=\"center\"><div class=\"left\">This sentence is read in a dialect that pronounces <span class=\"italic\">hva</span> as \"ka\".<br>Also, remember that the verb that comes after a modal verb (i.e. <span class=\"italic\">kan, skal, vil</span>) needs to be in the bare infinitive.</div></div>",A:"N"},{DECK_ID:"A11",ID:"A11078",N:"<div class=\"center\">Han synes at Norge er det beste landet \xe5 bo i.</div>",E:"<div class=\"center\">He thinks that Norway is the best country to live in.</div>",D:"LISTENING PRACTICE",X:"<div class=\"center\"><div class=\"left\">Remember that <span class=\"italic\">\xe5 synes</span> entails an opinion based on some kind of evidence or previous experience, whereas <span class=\"italic\">\xe5 tro</span> implies a speculation or belief.</div></div>",A:"N"},{DECK_ID:"A11",ID:"A11079",N:"<div class=\"center\">Kjenner du den gutten?<br>Kanskje jeg har m\xf8tt ham f\xf8r.</div>",E:"<div class=\"center\">Do you know that boy?<br>Maybe I have met him before.</div>",D:"LISTENING PRACTICE",X:"<div class=\"center\"><div class=\"left\"><p>Remember that the sound of KJ is <span class=\"italic\">similar</span> to the <b class=\"bold\">H</b> in \"<b class=\"bold\">h</b>ue\" and \"<b class=\"bold\">h</b>uge\".</p>This is NOT the same sound as SKJ and SJ (although even natives are at times imprecise about it).</div></div>",A:"N"},{DECK_ID:"A11",ID:"A11080",N:"<div class=\"center\">Jeg arbeider om ettermidagen, mandag til fredag</div>",E:"<div class=\"center\">I work in the afternoon, Monday to Friday</div>",D:"LISTENING PRACTICE",X:"",A:"N"},{DECK_ID:"A11",ID:"A11081",N:"<div class=\"center\">Vi ble sene fordi vi ikke kom i tide til toget</div>",E:"<div class=\"center\">We were late because <br>we didn't make it to the train on time</div>",D:"LISTENING PRACTICE",X:"<div class=\"center\"><div class=\"left\"><p>The sentence starting after the <span class=\"italic\">fordi</span> is the subordinate sentence.<br>Because of this and the fact that there is a single verb, <span class=\"italic\">ikke</span> goes before the verb.</p>More on this in the \"Word order\" topic of the Intermediate section of Mj\xf8lnir.</div></div>",A:"N"},{DECK_ID:"A11",ID:"A11082",N:"<div class=\"center\">Jeg tror det var Mari som ville snakke med deg</div>",E:"<div class=\"center\">I believe it was Mari who wanted to talk to you</div>",D:"LISTENING PRACTICE",X:"<div class=\"center\"><div class=\"left\">Remember that <span class=\"italic\">\xe5 tro</span> implies a speculation/belief, whereas <span class=\"italic\">\xe5 synes</span> entails an opinion based on some kind of evidence or previous experience.</div></div>",A:"N"},{DECK_ID:"A11",ID:"A11083",N:"<div class=\"center\">Hva er best?<br>Livet p\xe5 landet eller livet i byen?</div>",E:"<div class=\"center\">What's best?<br>Life in the countryside or life in the city?</div>",D:"LISTENING PRACTICE",X:"<div class=\"center\"><div class=\"left\">Remember that the T at the end of the definite form of <span class=\"italic\">intetkj\xf8nn</span> nouns is silent.</div></div>",A:"N"},{DECK_ID:"A11",ID:"A11084",N:"<div class=\"center\">Hvorfor er du s\xe5 sliten?<br>Hva gjorde du i g\xe5r kveld?</div>",E:"<div class=\"center\">How come you are so tired?<br>What did you do yesterday evening?</div>",D:"LISTENING PRACTICE",X:"<div class=\"center\"><div class=\"left\">Note that the standard pronunciation of <span class=\"italic\">gjorde</span> would require the D to be silent, but a dialect is being used here.</div></div>",A:"N"},{DECK_ID:"A11",ID:"A11085",N:"<div class=\"center\">N\xe5r vil barna spise?<br>Klokka seks eller klokka sju?</div>",E:"<div class=\"center\">When do the kids want to eat?<br>Six o'clock or seven o'clock?</div>",D:"LISTENING PRACTICE",X:"<div class=\"center\"><div class=\"left\"><p>Remember that <span class=\"italic\">barna</span> is the definite plural of <span class=\"italic\">et barn</span>.</p>The -A ending instead of the -ENE ending is a possible option for the definite plural of monosyllabic <span class=\"italic\">intetkj\xf8nn</span> nouns.</div></div>",A:"N"},{DECK_ID:"B01",ID:"B01001",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">virkeli<b class=\"bold\">g</b>, veldi<b class=\"bold\">g</b>, billi<b class=\"bold\">g</b>e</span></div>",E:"<div class=\"center\"><p>The letters in bold are</p><span class=\"lg\">[silent]</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">The final G is silent in the -IG ending of adjectives and adverbs.<br>This applies also to their plural and comparative forms (but not to the superlative).</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01002",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">live<b class=\"bold\">t</b>, huse<b class=\"bold\">t</b></span></div>",E:"<div class=\"center\"><p>The letters in bold are</p><span class=\"lg\">[silent]</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">The final T is silent when it's the end article -ET or -T, although it needs to be pronounced when the S-genitive is present (e.g. <span class=\"italic\">livets, husets</span>).</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01003",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\"><b class=\"bold\">sj</b>anse, <b class=\"bold\">sj</b>\xf8</span></div>",E:"<div class=\"center\"><p>The sound of the letters in bold is</p><span class=\"arialFont\">&#642;</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\"><p>SJ is always [<span class=\"arialFontNormal\"> &#642; </span>] and is very close to [<span class=\"arialFontNormal\"> &#643; </span>], which is \"SH\" in English.</p>The strange letters we are using in this topic belong to the International Phonetic Alphabet.<br>You don't have to learn them, but they can be a useful reference.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01004",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\"><b class=\"bold\">kj</b>enner, <b class=\"bold\">kj</b>\xe6re</span></div>",E:"<div class=\"center\"><p>The sound of the letters in bold is</p><span class=\"arialFont\">&#231;</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\"><p>KJ is [<span class=\"arialFontNormal\"> &#231; </span>] with any vowel that follows.<br>It is <span class=\"italic\">similar</span> to the <b class=\"bold\">H</b> in \"<b class=\"bold\">h</b>ue\" and \"<b class=\"bold\">h</b>uge\".</p>Also, note how our actor is repeating [<span class=\"arialFontNormal\"> &#231; </span>] between two \"A\"s to isolate the sound and give you extra clarity about it.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01005",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">O<b class=\"bold\">s</b>lo, <b class=\"bold\">s</b>likk, <b class=\"bold\">s</b>lippe</span></div>",E:"<div class=\"center\"><p>The sound of the letters in bold is</p><span class=\"arialFont\">&#642;</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">S becomes [<span class=\"arialFontNormal\"> &#642; </span>] in the SL cluster, while L maintains its sound.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01006",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\"><b class=\"bold\">o</b>g, f<b class=\"bold\">o</b>r, s<b class=\"bold\">o</b>m, j<b class=\"bold\">o</b>bb</span></div>",E:"<div class=\"center\"><p>The sound of the letters in bold is</p><span class=\"arialFont\">&#596;</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\"><p>This is one of the possible sounds of short O, in this case an allophone (i.e. identical sound) of short \xc5.</p><p>The other short sound that O can assume is [<span class=\"arialFontNormal\"> &#650; </span>].</p>Also, note how our actor is repeating [<span class=\"arialFontNormal\"> &#596; </span>] alone after the example words, to give you extra clarity about its sound.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01007",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">hv<b class=\"bold\">o</b>r, r<b class=\"bold\">o</b>m, f<b class=\"bold\">o</b>rdi</span></div>",E:"<div class=\"center\"><p>The sound of the letters in bold is</p><span class=\"arialFont\">&#650;</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\"><p>This is one of the possible sounds of short O, the other being [<span class=\"arialFontNormal\"> &#596; </span>].</p><p>It is the same sound as the OO in the English \"hook\".</p>Also, note how our actor is repeating [<span class=\"arialFontNormal\"> &#650; </span>] alone after the example words, to give you extra clarity about its sound.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01008",N:"<div class=\"center\">Read out, focusing on correct pronunciation:<br><span class=\"lg\">Oslo</span></div>",E:"<div class=\"center\"><span class=\"lg\"><b class=\"bold\">OS</b>l<b class=\"bold\">O</b></span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">The correct Norwegian pronunciation of the capital of Norway requires both O letters to be read as [<span class=\"arialFontNormal\"> &#650; </span>] (same as \"hook\" in English) and the S to be similar to \"SH\" in English, because it precedes an L.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01009",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">gje<b class=\"bold\">rn</b>e, J\xf8<b class=\"bold\">rn</b></span></div>",E:"<div class=\"center\"><p>The sound of the letters in bold is</p><span class=\"arialFont\">&#627;</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">This is the retroflexed [<span class=\"arialFontNormal\"> n </span>] for the RN cluster, short sound only.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01010",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">de<b class=\"bold\">t</b></span></div>",E:"<div class=\"center\"><p>The T in bold is</p><span class=\"lg\">[silent]</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">T is silent in this pronoun, unless followed by S for the possessive <span class=\"italic\">dets</span> (\"its\" in English).<br>The E is long.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01011",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">p<b class=\"bold\">e</b>rson, <b class=\"bold\">e</b>r</span></div>",E:"<div class=\"center\"><span class=\"arialFont\">&#230;(:)</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\"><p>E is pronounced [<span class=\"arialFontNormal\"> &#230; </span>] when followed by R, mostly inside a word or for the verb <span class=\"italic\">er</span>.</p><p>This does not apply to the ER ending of nouns (<span class=\"italic\">ubestemt flertall</span>) and verbs (<span class=\"italic\">presens</span>).</p>Also, note how our actor is repeating [<span class=\"arialFontNormal\"> &#230; </span>] alone (short and long) after the example words, to give you extra clarity about its sound.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01012",N:"<div class=\"center\">Read out, focusing on correct pronunciation:<br><span class=\"lg\">Jernbanetorget</span></div>",E:"<div class=\"center\"><span class=\"lg\">J<b class=\"bold\">ERN</b>banetorge<b class=\"bold\">(T)</b></span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">When you mention \"the Railway Square\" in Oslo, pay attention to the ERN cluster which requires both the E to be \xc6 and the RN to be a retroflexed N, plus the silent T at the end.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01013",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">no<b class=\"bold\">rs</b>k, e<b class=\"bold\">r s</b>\xe5</span></div>",E:"<div class=\"center\"><span class=\"arialFont\">&#642;</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">The sound of RS is [<span class=\"arialFontNormal\"> &#642; </span>], also across two separate words.<br>This sound can occasionally be long.<br>A degree of [<span class=\"arialFontNormal\"> &#638; </span>] sound can be maintained.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01014",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">n<b class=\"bold\">o</b>e, t<b class=\"bold\">o</b>, g<b class=\"bold\">o</b>d, <b class=\"bold\">o</b>rd</span></div>",E:"<div class=\"center\"><span class=\"arialFont\">&#117;:</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\"><p>This is the main sound of O when long.</p><p>It is the same sound of OO in the English word \"moon\" or UE in the English word \"blue\".</p>Also, note how our actor is repeating [<span class=\"arialFontNormal\"> &#117;: </span>] alone after the example words, to give you extra clarity about its sound.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01015",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">Ma<b class=\"bold\">g</b>ne, Ma<b class=\"bold\">g</b>nus, li<b class=\"bold\">g</b>ner</span></div>",E:"<div class=\"center\"><span class=\"arialFont\">&#331;:</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\"><p>This is the velar [<span class=\"arialFontNormal\"> n </span>] for the G in certain GN clusters.<br>The sound is long and the N after the G is pronounced too.</p>Also, note how our actor is repeating [<span class=\"arialFontNormal\"> &#331; </span>] between two \"A\"s to give you extra clarity about its sound.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01016",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">d\xe5<b class=\"bold\">rl</b>ig, fa<b class=\"bold\">rl</b>ig</span></div>",E:"<div class=\"center\"><span class=\"arialFont\">&#621;</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\"><p>This is the retroflexed L sound for the RL cluster.<br>Short sound only.</p>Also, note how our actor is repeating [<span class=\"arialFontNormal\"> &#621; </span>] between two \"A\"s to give you extra clarity about its sound.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01017",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">s<b class=\"bold\">\xe5</b>nn, <b class=\"bold\">\xe5</b>tte</span></div>",E:"<div class=\"center\"><span class=\"arialFont\">&#596;</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\"><p>This is the sound of \xc5 when short.</p>Also, note how our actor is repeating [<span class=\"arialFontNormal\"> &#596; </span>] alone after the example words, to give you extra clarity about its sound.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01018",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">v<b class=\"bold\">\xe5</b>t, m<b class=\"bold\">\xe5</b>, g<b class=\"bold\">\xe5</b>r, f<b class=\"bold\">\xe5</b>r</span></div>",E:"<div class=\"center\"><span class=\"arialFont\">&#111;:</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\"><p>This is the sound of \xc5 when long.</p>Also, note how our actor is repeating [<span class=\"arialFontNormal\"> &#111;: </span>] alone after the example words, to give you extra clarity about its sound.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01019",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">t<b class=\"bold\">o</b>g, l<b class=\"bold\">o</b>v, s<b class=\"bold\">o</b>ve</span></div>",E:"<div class=\"center\"><span class=\"arialFont\">&#111;:</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\"><p>The sound [<span class=\"arialFontNormal\"> &#111;: </span>] is typical (but not exclusive) of an O followed by G or V.</p>Be careful not to assume that these O followed by a single consonant must be read as [<span class=\"arialFontNormal\"> u: </span>] like in <span class=\"italic\">god</span> or <span class=\"italic\">to</span>, because the sound in the example words is in fact the same as long \xc5.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01020",N:"<div class=\"center\">Read out, focusing on correct pronunciation:<br><span class=\"lg\">Carl Berners Plass</span></div>",E:"<div class=\"center\"><span class=\"lg\">Ca<b class=\"bold\">RL</b> B<b class=\"bold\">ER</b>ne<b class=\"bold\">RS</b> Plass</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\"><p>The name of this square in Oslo is quite tricky.</p><p>The RL is the retroflexed L, the first E in <span class=\"italic\">Berners</span> works as an \xc6 and RS requires a sound very similar to \"SH\" in English.</p>The square is named after Norwegian politician and minister Carl Christian Berner.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01021",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">h<b class=\"bold\">u</b>n, k<b class=\"bold\">u</b>nne, <b class=\"bold\">u</b>nnskyld</span></div>",E:"<div class=\"center\"><span class=\"arialFont\">&#649;</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\"><p>This is a version of the [<span class=\"arialFontNormal\"> &#117; </span>] sound which is pronounced with slightly rounded lips and more centrally in your mouth.</p>Remember that the U in <span class=\"italic\">hun</span> is short despite being followed by one single consonant.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01022",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">s<b class=\"bold\">u</b>kker, b<b class=\"bold\">u</b>kk</span></div>",E:"<div class=\"center\"><span class=\"arialFont\">&#650;</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\"><p>This is one of the two sounds of short U, the other being [<span class=\"arialFontNormal\"> &#649; </span>].</p>It is the same sound as the OO in the English \"hook\" and it often happens before KK.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01023",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">go<b class=\"bold\">d</b>, r\xf8<b class=\"bold\">d</b></span></div>",E:"<div class=\"center\"><p>The letters in bold are</p><span class=\"lg\">[silent]</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">D is silent at the end of some short adjectives, also in their <span class=\"italic\">intetkj\xf8nn</span> and plural forms.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01024",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\"><b class=\"bold\">K</b>ina, <b class=\"bold\">k</b>ylling</span></div>",E:"<div class=\"center\"><span class=\"arialFont\">&#231;</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">This is the sound of K before I and Y.<br>Learn to differentiate it from [<span class=\"arialFontNormal\"> &#642; </span>].</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01025",N:"<div class=\"center\">Read out, focusing on correct pronunciation:<br><span class=\"lg\">Majorstuen</span></div>",E:"<div class=\"center\"><span class=\"lg\">Maj<b class=\"bold\">ORS</b>tuen</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">The stress in the name of this Oslo area is on the second syllable, with the O having the long sound of the English \"moon\" and the RS having basically the sound of \"SH\" in English.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01026",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">se<b class=\"bold\">lg</b>e, f\xf8<b class=\"bold\">lg</b>e</span></div>",E:"<div class=\"center\"><span class=\"arialFont\">l:</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><p><div class=\"left\">G is silent and prolongs the [<span class=\"arialFontNormal\"> l </span>] sound in the LG cluster of these words.</p>However, the most common sound for LG is simply that of L and the G for \"golf\".</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01027",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">e<b class=\"bold\">r d</b>u, bu<b class=\"bold\">rd</b>e</span></div>",E:"<div class=\"center\"><span class=\"arialFont\">&#598;(:)</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">This is the retroflexed [<span class=\"arialFontNormal\"> d </span>] for the RD cluster (also across separate words).<br>Short and long sound.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01028",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">s<b class=\"bold\">k</b>rive, i<b class=\"bold\">kk</b>e, fi<b class=\"bold\">kk</b></span></div>",E:"<div class=\"center\"><div class=\"arialFont supWrap\">k<div class=\"sup\">j</div>(:)</div></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">This is the soft [<span class=\"arialFontNormal\"> k </span>], pronounced in the front part of the mouth, hence the superscript [<span class=\"arialFontNormal\"> j </span>].<br>Short and long sound.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01029",N:"<div class=\"center\">Read out, focusing on correct pronunciation:<br><span class=\"lg\">Sognsvann</span></div>",E:"<div class=\"center\"><span class=\"lg\">So<b class=\"bold\">GN</b>svann</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\"><p>The GN cluster here has the same sound we have seen for names such as <span class=\"italic\">Magnus</span> or <span class=\"italic\">Magne</span>.</p>The G has the same sound as NG in the English \"ring\", but longer, while the N is just a normal one.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01030",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">t<b class=\"bold\">au</b>, s<b class=\"bold\">au</b></span></div>",E:"<div class=\"center\"><div class=\"arialFont supWrap\">&#230;<div class=\"sup\">&#649;</div></div></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">This is the diphthong of [<span class=\"arialFontNormal\"> \xe6 </span>] rising and rounding to [<span class=\"arialFontNormal\"> &#649; </span>].</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01031",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">sk\xe5<b class=\"bold\">l</b>, a<b class=\"bold\">ll</b>e</span></div>",E:"<div class=\"center\"><span class=\"arialFont\">&#619;(:)</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">L has a \"darker\" sound when it follows letters A, \xc5 and many instances of O.<br>Phonetically, this happens after [<span class=\"arialFontNormal\"> &#593; </span>], [<span class=\"arialFontNormal\"> &#593;: </span>], [<span class=\"arialFontNormal\"> &#111;: </span>] and [<span class=\"arialFontNormal\"> &#596; </span>].<br>Short and long sound.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01032",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">gje<b class=\"bold\">ld</b>e, kve<b class=\"bold\">ld</b>, me<b class=\"bold\">ld</b>te</span></div>",E:"<div class=\"center\"><span class=\"arialFont\">l:</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">D is silent and prolongs the [<span class=\"arialFontNormal\"> l </span>] sound in the LD cluster of certain words.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01033",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">me<b class=\"bold\">d</b>, ve<b class=\"bold\">d</b>, ne<b class=\"bold\">d</b></span></div>",E:"<div class=\"center\"><p>The letters in bold are</p><span class=\"lg\">[silent]</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">D is silent at the end of these words.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01034",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">lan<b class=\"bold\">d</b>, bor<b class=\"bold\">d</b></span></div>",E:"<div class=\"center\"><p>The letters in bold are</p><span class=\"lg\">[silent]</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">D is silent in some nouns ending in -ND and -RD (unless the S-genitive is present).</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01035",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">ho<b class=\"bold\">ld</b>e, ka<b class=\"bold\">ld</b>, ho<b class=\"bold\">ld</b>te</span></div>",E:"<div class=\"center\"><span class=\"arialFont\">&#619;:</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\"><p>D is silent and prolongs the [<span class=\"arialFontNormal\"> &#619; </span>] sound in the LD cluster of certain words.</p>Remember that [<span class=\"arialFontNormal\"> &#619; </span>] is the \"darker\" L sound that follows letters A, \xc5 and many instances of O.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01036",N:"<div class=\"center\">Read out, focusing on correct pronunciation:<br><span class=\"lg\">St. Hanshaugen</span></div>",E:"<div class=\"center\"><span class=\"lg\">Sankt Hansh<b class=\"bold\">AUG</b>en</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">The AU is the diphthong [<span class=\"arialFontNormal\"> \xe6 </span>] rising and rounding to [<span class=\"arialFontNormal\"> &#649; </span>].<br>The G is silent.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01037",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\"><b class=\"bold\">g</b>utt, <b class=\"bold\">g</b>reit,<br>ve<b class=\"bold\">gg</b>, li<b class=\"bold\">gg</b>er</span></div>",E:"<div class=\"center\"><div class=\"arialFont supWrap\">g<div class=\"sup\">j</div>(:)</div></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">This is the soft [<span class=\"arialFontNormal\"> g </span>], pronounced in the front part of the mouth, hence the superscript [<span class=\"arialFontNormal\"> j </span>].<br>Often found in connection with frontal vowels (<span class=\"italic\">gutt</span>) and in front of consonants (<span class=\"italic\">greit</span>). Short and long sound.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01038",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\"><b class=\"bold\">g</b>i, <b class=\"bold\">g</b>ikk</span></div>",E:"<div class=\"center\"><span class=\"arialFont\">j</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">G followed by I tends to have the [<span class=\"arialFontNormal\"> g </span>] sound (especially in loanwords), but in some words it is [<span class=\"arialFontNormal\"> j </span>].</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01039",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\"><b class=\"bold\">g</b>yldig, be<b class=\"bold\">g</b>ynne</span></div>",E:"<div class=\"center\"><span class=\"arialFont\">j</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">G has a [<span class=\"arialFontNormal\"> j </span>] sound when followed by Y (except in loanwords).</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01040",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\"><b class=\"bold\">tj</b>ue, <b class=\"bold\">tj</b>ern</span></div>",E:"<div class=\"center\"><span class=\"arialFont\">&#231;</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">TJ is pronounced [<span class=\"arialFontNormal\"> &#231; </span>] with any vowel, except for the word <span class=\"italic\">tjene</span> (and related words) which is [<span class=\"arialFontNormal\"> tje </span>], not [<span class=\"arialFontNormal\"> &#231;e </span>].</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01041",N:"<div class=\"center\">Read out, focusing on correct pronunciation:<br><span class=\"lg\">Stortinget</span></div>",E:"<div class=\"center\"><span class=\"lg\">St<b class=\"bold\">O</b>rtinge<b class=\"bold\">(T)</b></span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">The Norwegian parliament (literally \"the big council\") must be pronounced with a long O (just as you would for the adjective <span class=\"italic\">stor</span>) and the silent T at the end (it's the end article for the definite neuter noun).</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01042",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\"><b class=\"bold\">g</b>a, e<b class=\"bold\">gg</b>a</span></div>",E:"<div class=\"center\"><span class=\"arialFont\">g(:)</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">This is the standard sound for G, short and, rarely, long.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01043",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\"><b class=\"bold\">k</b>an, ja<b class=\"bold\">kk</b>a</span></div>",E:"<div class=\"center\"><span class=\"arialFont\">k(:)</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">This is the standard sound for K, short and long.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01044",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\"><b class=\"bold\">k</b>att, <b class=\"bold\">k</b>om, <b class=\"bold\">k</b>one</span></div>",E:"<div class=\"center\"><div class=\"arialFont supWrap\">k<div class=\"sup\">h</div></div></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">The sound [<span class=\"arialFontNormal\"> k </span>] can be aspirated in certain situations, hence the superscript [<span class=\"arialFontNormal\"> h </span>].<br>The degree of aspiration can vary.<br>This is mostly a short sound.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01045",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\"><b class=\"bold\">t</b>akk, na<b class=\"bold\">tt</b></span></div>",E:"<div class=\"center\"><div class=\"arialFont supWrap\">t<div class=\"sup\">h</div>(:)</div></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\"><p>The sound [<span class=\"arialFontNormal\"> t </span>] can be aspirated in certain situations, hence the superscript [<span class=\"arialFontNormal\"> h </span>].</p>The degree of aspiration can vary, it is usually less at the end of the word.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01046",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\"><b class=\"bold\">p</b>akke, la<b class=\"bold\">pp</b></span></div>",E:"<div class=\"center\"><div class=\"arialFont supWrap\">p<div class=\"sup\">h</div>(:)</div></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\"><p>The sound [<span class=\"arialFontNormal\"> p </span>] can be aspirated in certain situations, hence the superscript [<span class=\"arialFontNormal\"> h </span>].</p>The degree of aspiration can vary, it is usually less at the end of the word.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01047",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">ful<b class=\"bold\">g</b>te, sol<b class=\"bold\">g</b>te</span></div>",E:"<div class=\"center\"><div class=\"arialFont supWrap\">k<div class=\"sup\">j</div>(:)</div></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center flex\"><div class=\"left\">The G in the GTE ending of certain <span class=\"italic\">preteritum</span> forms is effectively pronounced as the soft K (i.e. K with superscript J).</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01048",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">se<b class=\"bold\">lv</b></span></div>",E:"<div class=\"center\"><span class=\"arialFont\">l:</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">V is silent and prolongs the [<span class=\"arialFontNormal\"> l </span>] sound in the LV ending of certain words.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01049",N:"<div class=\"center\">Read out, focusing on correct pronunciation:<br><span class=\"lg\">Torshov</span></div>",E:"<div class=\"center\"><span class=\"lg\">T<b class=\"bold\">ORS</b>hov</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\"><p>The stress in the name of this Oslo area is on the first syllable, with the O having the long sound of the English \"moon\" and the RS having basically the sound of \"SH\" in English.</p>The name comes from the Old Norse for \"Tor's shrine\".</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01050",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">bar<b class=\"bold\">e</b>, dett<b class=\"bold\">e</b></span></div>",E:"<div class=\"center\"><span class=\"arialFont\">&#601;</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">This is the sound for unstressed E, which appears often at the end of words.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01051",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">skriv<b class=\"bold\">e</b>r, jent<b class=\"bold\">e</b>r</span></div>",E:"<div class=\"center\"><span class=\"arialFont\">&#600;</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">This sound appears mostly in the -ER ending of verbs (<span class=\"italic\">presens</span>) and nouns (<span class=\"italic\">ubestemt flertall</span>).</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01052",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">s<b class=\"bold\">e</b>, h<b class=\"bold\">e</b>le, fl<b class=\"bold\">e</b>re</span></div>",E:"<div class=\"center\"><span class=\"arialFont\">&#101;:</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">This is the standard sound for a long E.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01053",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">m<b class=\"bold\">e</b>nn, <b class=\"bold\">e</b>tter</span></div>",E:"<div class=\"center\"><span class=\"arialFont\">&#603;</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">This is the standard sound for a short E.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01054",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">utsol<b class=\"bold\">g</b>t, \xf8dela<b class=\"bold\">g</b>t, sa<b class=\"bold\">g</b>t</span></div>",E:"<div class=\"center\"><div class=\"arialFont supWrap\">k<div class=\"sup\">j</div>(:)</div></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center flex\"><div class=\"left\">The G in the GT ending of certain past participles is effectively pronounced as a the soft K (i.e. K with superscript J).</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01055",N:"<div class=\"center\">Read out, focusing on correct pronunciation:<br><span class=\"lg\">Schous Plass</span></div>",E:"<div class=\"center\"><span class=\"lg\">S<b class=\"bold\">CHOU</b>s plass</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">This square in Oslo, named after merchant Christian Schou, has a peculiar looking name.<br>The CH is pronounced like a K and the OU is a different spelling of the AU diphthong of [<span class=\"arialFontNormal\"> \xe6 </span>] rising and rounding to [<span class=\"arialFontNormal\"> &#649; </span>].</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01056",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">ha<b class=\"bold\">lv</b>, to<b class=\"bold\">lv</b></span></div>",E:"<div class=\"center\"><span class=\"arialFont\">&#619;:</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\"><p>V is silent and prolongs the [<span class=\"arialFontNormal\"> &#619; </span>] sound in the LV ending of certain words.</p>Remember that [<span class=\"arialFontNormal\"> &#619; </span>] is the \"darker\" L sound that follows letters A, \xc5 and many instances of O.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01057",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">e<b class=\"bold\">nd</b>te, se<b class=\"bold\">nd</b>t, anve<b class=\"bold\">nd</b>t</span></div>",E:"<div class=\"center\"><span class=\"arialFont\">n:</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">D is silent and prolongs the [<span class=\"arialFontNormal\"> n </span>] sound in the ND cluster of certain words (especially past tenses of second conjugation verbs).</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01058",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">gutt<b class=\"bold\">en</b>,<b class=\"bold\"> </b>billett<b class=\"bold\">en</b>,<b class=\"bold\"> </b>nest<b class=\"bold\">en</b></span></div>",E:"<div class=\"center\"><span class=\"arialFont\">n&#809;</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">This is the syllabic [<span class=\"arialFontNormal\"> n </span>], it appears mostly when words ending in T receive the end article -EN.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01059",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">sna<b class=\"bold\">rt</b>, gjo<b class=\"bold\">rt</b></span></div>",E:"<div class=\"center\"><span class=\"arialFont\">&#648;(:)</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">This is the retroflexed [<span class=\"arialFontNormal\"> t </span>] for the RT cluster.<br>Short and long sound, some aspiration is possible.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01060",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">le<b class=\"bold\">ng</b>e, ma<b class=\"bold\">ng</b>e, dekni<b class=\"bold\">ng</b></span></div>",E:"<div class=\"center\"><span class=\"arialFont\">&#331;:</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">This is the velar [<span class=\"arialFontNormal\"> n </span>] for the NG cluster, the sound is long.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01061",N:"<div class=\"center\">Read out, focusing on correct pronunciation:<br><span class=\"lg\">Troms\xf8</span></div>",E:"<div class=\"center\"><span class=\"lg\">Tr<b class=\"bold\">O</b>ms\xf8</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">The name of the largest city in Northern Norway (<span class=\"italic\">Nord-Norge</span>) has the stress on the short O (i.e. same sound as \"hook\" in English) and some aspiration on the T.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01062",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">kan<b class=\"bold\">skj</b>e, <b class=\"bold\">skj</b>\xf8nne</span></div>",E:"<div class=\"center\"><span class=\"arialFont\">&#642;</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">SKJ is always [<span class=\"arialFontNormal\"> &#642; </span>] regardless of the vowel that follows.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01063",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\"><b class=\"bold\">sk</b>i, <b class=\"bold\">sk</b>ygge</span></div>",E:"<div class=\"center\"><span class=\"arialFont\">&#642;</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">SK is [<span class=\"arialFontNormal\"> &#642; </span>] before I and Y.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01064",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">sla<b class=\"bold\">g</b>s, vikti<b class=\"bold\">g</b>st</span></div>",E:"<div class=\"center\"><div class=\"arialFont supWrap\">k<div class=\"sup\">j</div>(:)</div></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center flex\"><div class=\"left\">The G followed by S in some words (such as the superlative form of adjectives ending in -IG) is effectively pronounced as a soft K (i.e. K with superscript J).</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01065",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">m\xf8<b class=\"bold\">t</b>er, m\xf8<b class=\"bold\">tt</b>e</span></div>",E:"<div class=\"center\"><span class=\"arialFont\">t(:)</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">This is the standard sound for T, short and long.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01066",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">dre<b class=\"bold\">p</b>e, sli<b class=\"bold\">pp</b>e</span></div>",E:"<div class=\"center\"><span class=\"arialFont\">p(:)</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">This is the standard sound for P, short and long.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01067",N:"<div class=\"center\">Read out, focusing on correct pronunciation:<br><span class=\"lg\">Nidaros Domkirke</span></div>",E:"<div class=\"center\"><span class=\"lg\">Nidaros Dom<b class=\"bold\">k</b>irke</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">Trondheim's cathedral has a K followed by I, which requires the [<span class=\"arialFontNormal\"> \xe7 </span>] sound normally found in the KJ cluster.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01068",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\"><b class=\"bold\">g</b>eni, <b class=\"bold\">g</b>enerell<b class=\"bold\"></b></span></div>",E:"<div class=\"center\"><span class=\"arialFont\">&#642;</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">This is the sound of G in loanwords containing GE.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01069",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">d<b class=\"bold\">u</b>, <b class=\"bold\">u</b>t, <b class=\"bold\">u</b>ten</span></div>",E:"<div class=\"center\"><span class=\"arialFont\">&#649;:</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\"><p>This is the rounded and central version of the [<span class=\"arialFontNormal\"> &#117; </span>] sound (long).</p>The U in <span class=\"italic\">du</span> would be short if unstressed within the sentence.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01070",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\"><b class=\"bold\">Eu</b>ropa</span></div>",E:"<div class=\"center\"><div class=\"arialFont supWrap\">&#230;<div class=\"sup\">&#649;</div></div></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">This is the diphthong of [<span class=\"arialFontNormal\"> \xe6 </span>] rising and rounding to [<span class=\"arialFontNormal\"> &#649; </span>].</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01071",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">h<b class=\"bold\">\xf8y</b>re, g<b class=\"bold\">\xf8y</b>, <b class=\"bold\">\xf8y</b>e</span></div>",E:"<div class=\"center\"><div class=\"arialFont supWrap\">&#339;<div class=\"sup\">&#655;</div></div></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">This is the diphthong of [<span class=\"arialFontNormal\"> &#339 </span>] rising to [<span class=\"arialFontNormal\"> &#655; </span>].</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01072",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">d<b class=\"bold\">\xf8g</b>n</span></div>",E:"<div class=\"center\"><div class=\"arialFont supWrap\">&#339;<div class=\"sup\">&#655;</div></div></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">This is the diphthong of [<span class=\"arialFontNormal\"> &#339 </span>] rising to [<span class=\"arialFontNormal\"> &#655; </span>].</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01073",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">konv<b class=\"bold\">oi</b>, b<b class=\"bold\">oi</b>kott</span></div>",E:"<div class=\"center\"><div class=\"arialFont supWrap\">&#596;<div class=\"sup\">&#655;</div></div></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">This is the diphthong of [<span class=\"arialFontNormal\"> &#596; </span>] rising to [<span class=\"arialFontNormal\"> &#655; </span>], used only in loanwords.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01074",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\"><b class=\"bold\">g</b>eit<b class=\"bold\"></b></span></div>",E:"<div class=\"center\"><span class=\"arialFont\">j</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\"><p>G is pronounced [<span class=\"arialFontNormal\"> j </span>] when followed by EI.</p>The male name <span class=\"italic\">Geir</span> is an exception and has the [<span class=\"arialFontNormal\"> g </span>] sound.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01075",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\"><b class=\"bold\">k</b>lem</span></div>",E:"<div class=\"center\"><div class=\"arialFont supWrap\">k<div class=\"sup\">jh</div></div></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">This is the soft and aspirated [<span class=\"arialFontNormal\"> k </span>], short sound only.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01076",N:"<div class=\"center\">Read out, focusing on correct pronunciation:<br><span class=\"lg\">Bod\xf8</span></div>",E:"<div class=\"center\"><span class=\"lg\">B<b class=\"bold\">O</b>d\xf8</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">The capital of the Nordland <span class=\"italic\">fylke</span> has the stress on the O, which is long (i.e. same sound as the OO in \"moon\").</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01077",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">o<b class=\"bold\">v</b>er, a<b class=\"bold\">vv</b>erge, lo<b class=\"bold\">vv</b>erk</span></div>",E:"<div class=\"center\"><span class=\"arialFont\">&#651;</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\"><p>This is the sound for V.</p>Note that VV is present mostly in composite words and it is pronounced as a single V.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01078",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">st\xf8<b class=\"bold\">v</b>el, na<b class=\"bold\">v</b>le</span></div>",E:"<div class=\"center\"><span class=\"arialFont\">&#651;:</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\"><p>The long sound [<span class=\"arialFontNormal\"> &#651;: </span>] is present in some specific situations, mostly in stressed syllables, even if it is not written as VV.</p>Consequently, the vowel preceding the sound will be short.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01079",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">Helleru<b class=\"bold\">d</b>,<b class=\"bold\"> </b>Mortensru<b class=\"bold\">d</b></span></div>",E:"<div class=\"center\"><p>The letters in bold are</p><span class=\"lg\">[silent]</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">D is silent in surnames and names of places ending in -RUD.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01080",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\"><b class=\"bold\">g</b>jennom, <b class=\"bold\">g</b>j\xf8r</span></div>",E:"<div class=\"center\"><p>The letters in bold are</p><span class=\"lg\">[silent]</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">G is silent in front of J.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01081",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">he<b class=\"bold\">l</b>e, e<b class=\"bold\">ll</b>er</span></div>",E:"<div class=\"center\"><span class=\"arialFont\">l(:)</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">This is the standard pronunciation for L, as opposed to the \"darker\" pronunciation in front of A, \xc5 and certain sounds of O.<br>Short or long sound.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01082",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">Mort<b class=\"bold\">en</b>, port<b class=\"bold\">en</b></span></div>",E:"<div class=\"center\"><span class=\"arialFont\">&#627;&#809;</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">This is the syllabic [<span class=\"arialFontNormal\"> &#627; </span>], it appears in the rare occasions when the end article -EN is preceded by retroflexed [<span class=\"arialFontNormal\"> t </span>] and [<span class=\"arialFontNormal\"> d </span>].</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01083",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">spennen<b class=\"bold\">d</b>e, tien<b class=\"bold\">d</b>e</span></div>",E:"<div class=\"center\"><p>The letters in bold are</p><span class=\"lg\">[silent]</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">D is silent in present participles and ordinal numbers.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01084",N:"<div class=\"center\">Read out, focusing on correct pronunciation:<br><span class=\"lg\">Sogn og Fjordane</span></div>",E:"<div class=\"center\"><span class=\"lg\">So<b class=\"bold\">GN</b> og Fj<b class=\"bold\">O</b>r<b class=\"bold\">D</b>ane</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\"><p>Literally \"Sogn and the fjords\", the correct pronunciation requires you to pay attention to the GN cluster, the long O and the silent D of <span class=\"italic\">fjord</span>.</p>As of 2017, <span class=\"italic\">Sogn og Fjordane</span> is the only <span class=\"italic\">fylke</span> in which all the <span class=\"italic\">kommune</span> have chosen <span class=\"italic\">nynorsk</span> as the written language (hence <span class=\"italic\">fjordane</span> and not <span class=\"italic\">fjordene</span>).</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01085",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">o<b class=\"bold\">g</b>, o<b class=\"bold\">g</b>s\xe5, \xf2<b class=\"bold\">g</b></span></div>",E:"<div class=\"center\"><p>The letters in bold are</p><span class=\"lg\">[silent]</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">G is always silent unless <span class=\"italic\">og</span> could be mistaken for <span class=\"italic\">\xe5</span>.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01086",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\"><b class=\"bold\">k</b>eivhendt</span></div>",E:"<div class=\"center\"><span class=\"arialFont\">&#231;</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">This is the sound of K before EI.<br>Learn to differentiate it from [<span class=\"arialFontNormal\"> &#642; </span>].</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01087",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\"><b class=\"bold\">sk</b>ei, <b class=\"bold\">sk</b>\xf8yte</span></div>",E:"<div class=\"center\"><span class=\"arialFont\">&#642;</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">SK is [<span class=\"arialFontNormal\"> &#642; </span>] before the diphthongs EI and \xd8Y.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01088",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\"><b class=\"bold\">a</b>lle, d<b class=\"bold\">a</b>g</span></div>",E:"<div class=\"center\"><span class=\"arialFont\">&#593;(:)</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">This is the sound for A, short and long.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01089",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">v<b class=\"bold\">\xe6</b>rt, l<b class=\"bold\">\xe6</b>re</span></div>",E:"<div class=\"center\"><span class=\"arialFont\">&#230;(:)</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">This is the sound for \xc6, short and long.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01090",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">f<b class=\"bold\">\xf8</b>r, pr<b class=\"bold\">\xf8</b>ve</span></div>",E:"<div class=\"center\"><span class=\"arialFont\">&#248;:</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">This is a rounded lips version of [<span class=\"arialFontNormal\"> &#101; </span>], which creates the standard sound for long \xd8.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01091",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">skj<b class=\"bold\">\xf8</b>nner, f<b class=\"bold\">\xf8</b>dt</span></div>",E:"<div class=\"center\"><span class=\"arialFont\">&#339;</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">This is a variation on the rounded lips version of [<span class=\"arialFontNormal\"> &#101; </span>], which creates the standard sound for short \xd8.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01092",N:"<div class=\"center\">Read out, focusing on correct pronunciation:<br><span class=\"lg\">\xc5lesund</span></div>",E:"<div class=\"center\"><span class=\"lg\"><b class=\"bold\">\xc5</b>lesun<b class=\"bold\">(D)</b></span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">The largest city in the <span class=\"italic\">M\xf8re og Romsdal</span> county has the stress on the long \xc5, whilst the D is silent.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01093",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">h<b class=\"bold\">ai</b>, k<b class=\"bold\">ai</b></span></div>",E:"<div class=\"center\"><div class=\"arialFont supWrap\">&#593;<div class=\"sup\">&#618;</div></div></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">This is the diphthong of [<span class=\"arialFontNormal\"> &#593; </span>] gliding to [<span class=\"arialFontNormal\"> &#618; </span>].</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01094",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">s<b class=\"bold\">i</b>den, t<b class=\"bold\">i</b>d</span></div>",E:"<div class=\"center\"><span class=\"arialFont\">&#105;:</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">This is the standard sound for a long I and, exceptionally, for the E in <span class=\"italic\">de</span>.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01095",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\"><b class=\"bold\">i</b>kke, l<b class=\"bold\">i</b>tt</span></div>",E:"<div class=\"center\"><span class=\"arialFont\">&#618;</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">This is the standard sound for a short I.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01096",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">h<b class=\"bold\">ei</b>, b<b class=\"bold\">ei</b>n, n<b class=\"bold\">ei</b></span></div>",E:"<div class=\"center\"><div class=\"arialFont supWrap\">&#230;<div class=\"sup\">&#618;</div></div></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">This is the diphthong of [<span class=\"arialFontNormal\"> \xe6 </span>] rising to [<span class=\"arialFontNormal\"> &#618; </span>].</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01097",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">j<b class=\"bold\">eg</b>, d<b class=\"bold\">eg</b>, r<b class=\"bold\">eg</b>n</span></div>",E:"<div class=\"center\"><div class=\"arialFont supWrap\">&#230;<div class=\"sup\">&#618;</div></div></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">This is the diphthong of [<span class=\"arialFontNormal\"> \xe6 </span>] rising to [<span class=\"arialFontNormal\"> &#618; </span>].</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01098",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\"><b class=\"bold\">h</b>vit, <b class=\"bold\">h</b>va, <b class=\"bold\">h</b>vor</span></div>",E:"<div class=\"center\"><p>The letters in bold are</p><span class=\"lg\">[silent]</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">H is silent in front of V.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01099",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">n<b class=\"bold\">y</b>, b<b class=\"bold\">y</b>, s<b class=\"bold\">y</b>nes</span></div>",E:"<div class=\"center\"><span class=\"arialFont\">&#121;:</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">This is the standard sound for a long Y, which is a rounded lips version of the sound [<span class=\"arialFontNormal\"> i: </span>].</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01100",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">n<b class=\"bold\">y</b>tt, unnsk<b class=\"bold\">y</b>ld</span></div>",E:"<div class=\"center\"><span class=\"arialFont\">&#655;</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">This is the standard sound for a short Y.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01101",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">s<b class=\"bold\">ek</b>sten</span></div>",E:"<div class=\"center\"><div class=\"arialFont supWrap\">&#230;<div class=\"sup\">&#618;</div></div></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\"><p>This is the diphthong of [<span class=\"arialFontNormal\"> \xe6 </span>] rising to [<span class=\"arialFontNormal\"> &#618; </span>].</p>This and <span class=\"italic\">sekstende</span> (16th) are the only occurrences of EK being pronounced this way.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01102",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\"><b class=\"bold\">b</b>all, jo<b class=\"bold\">bb</b>et</span></div>",E:"<div class=\"center\"><span class=\"arialFont\">b(:)</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">This is the sound for B, short and long.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01103",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">re<b class=\"bold\">d</b>e, re<b class=\"bold\">dd</b>e</span></div>",E:"<div class=\"center\"><span class=\"arialFont\">d(:)</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">This is the sound for D, short and long.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01104",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\"><b class=\"bold\">f</b>ar, tre<b class=\"bold\">ff</b>e</span></div>",E:"<div class=\"center\"><span class=\"arialFont\">f(:)</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">This is the sound for F, short and long.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01105",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\"><b class=\"bold\">h</b>ar, <b class=\"bold\">h</b>\xe5r</span></div>",E:"<div class=\"center\"><span class=\"arialFont\">h</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">H is pronounced like in English, unless followed by J or V (e.g. <span class=\"italic\">hjem, hvem</span>), in which case it is silent.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01106",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\"><b class=\"bold\">j</b>ente, <b class=\"bold\">j</b>a</span></div>",E:"<div class=\"center\"><span class=\"arialFont\">j</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">This is the sound for J.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01107",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">ti<b class=\"bold\">m</b>e, ko<b class=\"bold\">mm</b>er</span></div>",E:"<div class=\"center\"><span class=\"arialFont\">m(:)</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\"><p>This is the sound for M, short and long.</p>Remember that [<span class=\"arialFontNormal\"> m: </span>] cannot be written as MM at the end of a word.<br>It must be written as a single M even when the sound is long, for instance in <span class=\"italic\">et rom</span>.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01108",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">fi<b class=\"bold\">n</b>e, fi<b class=\"bold\">nn</b>er</span></div>",E:"<div class=\"center\"><span class=\"arialFont\">n(:)</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">This is the sound of N, short and long.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01109",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">ba<b class=\"bold\">r</b>e, sp\xf8<b class=\"bold\">rr</b>e</span></div>",E:"<div class=\"center\"><span class=\"arialFont\">&#638;(:)</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">This is the sound for R, short and long.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01110",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\"><b class=\"bold\">h</b>jem, <b class=\"bold\">h</b>jerne</span></div>",E:"<div class=\"center\"><p>The letters in bold are</p><span class=\"lg\">[silent]</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">H is silent in front of J.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01111",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">vi<b class=\"bold\">s</b>e, vi<b class=\"bold\">ss</b>e</span></div>",E:"<div class=\"center\"><span class=\"arialFont\">s(:)</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">This is the sound for S, note that it is never pronounced like Z in English.<br>Short and long sound.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01112",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\"><b class=\"bold\">ch</b>ampagne</span></div>",E:"<div class=\"center\"><span class=\"arialFont\">&#643;</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">In general, Norwegian will try to mimic the original sound of the language from which the word was borrowed, mostly English or French.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01113",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\"><b class=\"bold\">ch</b>ilensk, <b class=\"bold\">Tsj</b>ekkia</span></div>",E:"<div class=\"center\"><span class=\"arialFont\">t&#643;</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">In general, Norwegian will try to mimic the original sound of the language from which the word was borrowed, mostly English or French.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01114",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\"><b class=\"bold\">c</b>ello</span></div>",E:"<div class=\"center\"><span class=\"arialFont\">t&#643;</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">In general, Norwegian will try to mimic the original sound of the language from which the word was borrowed, mostly English or French.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01115",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\">Ale<b class=\"bold\">x</b>ander</span></div>",E:"<div class=\"center\"><span class=\"arialFont\">ks</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">X is pronounced as [<span class=\"arialFontNormal\"> ks </span>] when it's not an initial.<br>It is often written as KS already.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01116",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\"><b class=\"bold\">c</b>entimeter, <b class=\"bold\">sc</b>ene</span></div>",E:"<div class=\"center\"><span class=\"arialFont\">s</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">In general, Norwegian will try to mimic the original sound of the language from which the word was borrowed, mostly English or French.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01117",N:"<div class=\"center\">Read out, focusing on correct pronunciation:<br><span class=\"lg\">Nationaltheatret</span></div>",E:"<div class=\"center\"><span class=\"lg\">Na<b class=\"bold\">TIO</b>naltheatre<b class=\"bold\">(T)</b></span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">This landmark theater in Oslo has a non-Norwegian spelling.<br>However, the pronunciation follows what would be the proper Norwegian spelling <span class=\"italic\">nasjonalteatret</span> with the SJ giving the \"SH\" sound and the silent T at the end.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01118",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\"><b class=\"bold\">w</b>afer, <b class=\"bold\">w</b>att</span></div>",E:"<div class=\"center\"><span class=\"arialFont\">&#651;</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\"><p>The [<span class=\"arialFontNormal\"> &#651; </span>] sound is generally used over the original one.</p>The letter W (with the [<span class=\"arialFontNormal\"> &#651; </span>] sound) is also present in some Norwegian surnames such as <span class=\"italic\">Wang</span> and names such as <span class=\"italic\">Waldemar</span>.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01119",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\"><b class=\"bold\">x</b>ylofon</span></div>",E:"<div class=\"center\"><span class=\"arialFont\">s</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">X is pronounced as [<span class=\"arialFontNormal\"> s </span>] if it is an initial.</div></div>",A:"E"},{DECK_ID:"B01",ID:"B01120",N:"<div class=\"center\">Read out, focusing on the bold part(s):<br><span class=\"lg\"><b class=\"bold\">z</b>oologi, <b class=\"bold\">z</b>ulu</span></div>",E:"<div class=\"center\"><span class=\"arialFont\">s</span></div>",D:"INTERMEDIATE PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\"><p>Z is pronounced as [<span class=\"arialFontNormal\"> s </span>], not [<span class=\"arialFontNormal\"> z </span>] nor [<span class=\"arialFontNormal\"> ts </span>].</p> This is the last card of Intermediate  Pronunciation: consider adding Advanced Pronunciation to your topics already, if you want to complete this aspect of the language.</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02001",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">en eier</span> (an owner)</div>",E:"<div class=\"center\">en eier<br>eieren<br>eiere<br>eierne</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\">Nouns ending in -ER (in the indefinite singular form) and denoting a role, an occupation or a function have the indefinite plural in -ERE and the definite plural in -ERNE.</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02002",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">en morgen</span> (a morning)</div>",E:"<div class=\"center\">en morgen<br>morgenen<br>morgener<br>morgenene</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">Hankj\xf8nn</span> nouns ending in -EN (in the indefinite singular form) will maintain their ending as they change through the four forms.</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02003",N:"<div class=\"center\">What is the gender of nouns <br>ending in <b class=\"bold\">-HET</b>?</div>",E:"<div class=\"center\">It is <span class=\"italic\">hankj\xf8nn</span></div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">en nyhet</span>&ensp;&emsp;&emsp;(a piece of news)</p><p><span class=\"italic\">en sannhet</span>&ensp;&emsp;(a truth)</p><span class=\"italic\">en leilighet</span>&ensp;&emsp;(a flat/apartment)</div></div>",A:"X"},{DECK_ID:"B02",ID:"B02004",N:"<div class=\"center\">en m\xe5ned<br>m\xe5neden<br>m\xe5neder<br>m\xe5nedene</div>",E:"<div class=\"center\">a month</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\">Note the pronunciation, it is quite far from the spelling, as the D is pronounced as a T.</div></div>",A:"N"},{DECK_ID:"B02",ID:"B02005",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">et eksempel</span> (an example)</div>",E:"<div class=\"center\">et eksempel<br>eksempelet<br>eksempler<br>eksemplene</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Intetkj\xf8nn</span> nouns ending in -EL (in the indefinite singular form) drop the -E for both plural forms.</p>They used to drop the E also for the definite singular form, but a 2022 update by <span class=\"italic\">Spr\xe5kr\xe5det</span> has changed this.</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02006",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">en ting</span> (a thing)</div>",E:"<div class=\"center\">en ting<br>tingen<br>ting<br>tingene</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>This is an irregular <span class=\"italic\">hankj\xf8nn</span> noun whose <b class=\"bold\">indefinite plural doesn't take an ending</b>.</p>Moreover, please note that <span class=\"italic\">ting</span> can also be an <span class=\"italic\">intetkj\xf8nn</span> noun when it means \"an assembly\" (e.g. <span class=\"italic\">Stortinget</span>).</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02007",N:"<div class=\"center\">What is the gender of nouns <br>ending in <b class=\"bold\">-M\xc5L</b>?</div>",E:"<div class=\"center\">It is <span class=\"italic\">intetkj\xf8nn</span></div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">et sp\xf8rsm\xe5l</span>&ensp;&emsp;(a question)</p><p><span class=\"italic\">et form\xe5l</span>&ensp;&emsp;&emsp;(an objective)</p><span class=\"italic\">et morsm\xe5l</span>&ensp;&emsp;(a native language)</div></div>",A:"X"},{DECK_ID:"B02",ID:"B02008",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">en feil</span> (a mistake)</div>",E:"<div class=\"center\">en feil<br>feilen<br>feil<br>feilene</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\">Irregular, the <b class=\"bold\">indefinite plural doesn't take an ending</b>, as if it was a one-syllable <span class=\"italic\">intetkj\xf8nn</span> noun.</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02009",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">ei/en bok</span> (a book)</div>",E:"<div class=\"center\">ei/en bok<br>boka/boken<br>b\xf8ker<br>b\xf8kene</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\">Irregular, often used as feminine, although the masculine form cannot be considered incorrect.</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02010",N:"<div class=\"center\">et ord <br>ordet <br>ord <br>ordene</div>",E:"<div class=\"center\">a word</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\">Note the <b class=\"bold\">silent D</b> and the <b class=\"bold\">long sound of O</b>, despite it being followed by two consonants.</div></div>",A:"N"},{DECK_ID:"B02",ID:"B02011",N:"<div class=\"center\">et navn (p\xe5) <br>navnet <br>navn <br>navnene</div>",E:"<div class=\"center\">a name (of)</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\">Nidaros er det eldste navnet p\xe5 byen Trondheim</div></div>",A:"N"},{DECK_ID:"B02",ID:"B02012",N:"<div class=\"center\">What is the gender of nouns <br>ending in <b class=\"bold\">-NING</b>?</div>",E:"<div class=\"center\"><div class=\"left\">It is feminine by preference (i.e. <span class=\"italic\">ei</span> as indefinite article) but the use as masculine (i.e. <span class=\"italic\">en</span> as indefinite article) cannot be considered incorrect.</div></div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">ei mening</span>&ensp;&emsp;(an opinion)</p><p><span class=\"italic\">ei bygning</span>&ensp;&emsp;(a building)</p><span class=\"italic\">ei dekning</span>&ensp;&emsp;(a coverage)</div></div>",A:"X"},{DECK_ID:"B02",ID:"B02013",N:"<div class=\"center\">en del (av) <br>delen <br>deler <br>delene</div>",E:"<div class=\"center\">a part (of), a share (of)</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\">Skottland er en del av Storbritannia</div>",A:"N"},{DECK_ID:"B02",ID:"B02014",N:"<div class=\"center\">et spr\xe5k <br>spr\xe5ket <br>spr\xe5k <br>spr\xe5kene</div>",E:"<div class=\"center\">a language</div>",D:"INTERMEDIATE NOUNS",X:"",A:"N"},{DECK_ID:"B02",ID:"B02015",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">en arbeider</span> (a worker)</div>",E:"<div class=\"center\">en arbeider<br>arbeideren<br>arbeidere<br>arbeiderne</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\">Nouns ending in -ER (in the indefinite singular form) and denoting a role, an occupation or a function have the indefinite plural in -ERE and the definite plural in -ERNE.</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02016",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">et sted</span> (a place)</div>",E:"<div class=\"center\">et sted<br>stedet<br>steder<br>stedene</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">Intetkj\xf8nn</span> nouns made of one syllable wouldn't normally take an ending for indefinite plural, but <span class=\"italic\">et sted</span> is an exception and takes -ER.</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02017",N:"<div class=\"center\">What is the gender of nouns <br>ending in <b class=\"bold\">-GRAM</b>?</div>",E:"<div class=\"center\">It is <span class=\"italic\">intetkj\xf8nn</span></div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">et program</span>&ensp;&emsp;(a program)</p><span class=\"italic\">et diagram</span>&ensp;&emsp;(a diagram)</div></div>",A:"X"},{DECK_ID:"B02",ID:"B02018",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">en l\xe6rer</span> (a teacher)</div>",E:"<div class=\"center\">en l\xe6rer<br>l\xe6reren<br>l\xe6rere<br>l\xe6rerne</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\">Nouns ending in -ER (in the indefinite singular form) and denoting a role, an occupation or a function have the indefinite plural in -ERE and the definite plural in -ERNE.</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02019",N:"<div class=\"center\">ei lekse <br>leksa <br>lekser <br>leksene</div>",E:"<div class=\"center\">(a piece of) school homework</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\">Jeg m\xe5 gj\xf8re leksene mine</div>",A:"N"},{DECK_ID:"B02",ID:"B02020",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">en sko</span> (a shoe)</div>",E:"<div class=\"center\">en sko<br>skoen<br>sko<br>skoene</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\">Irregular, the indefinite plural doesn't take an ending, as if it was a one-syllable <span class=\"italic\">intetkj\xf8nn</span> noun.</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02021",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">en n\xf8kkel</span> (a key)</div>",E:"<div class=\"center\">en n\xf8kkel<br>n\xf8kkelen<br>n\xf8kler<br>n\xf8klene</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Hankj\xf8nn</span> nouns ending in -EL (in the indefinite singular form) will often drop E (if unstressed) for the plural forms.</p>Additionally, any double consonants will be reduced to one, to avoid having three consonants in a row (two of which being the same one).</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02022",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">et nummer</span> (a number)</div>",E:"<div class=\"center\">et nummer<br>nummeret<br>numre<br>numrene</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\">Some <span class=\"italic\">intetkj\xf8nn</span> nouns ending in -ER drop one of the double consonants and the E for the plural forms.</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02023",N:"<div class=\"center\">What is the gender of nouns <br>ending in <b class=\"bold\">-EM</b>?</div>",E:"<div class=\"center\">It is <span class=\"italic\">intetkj\xf8nn</span></div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">et problem</span>&ensp;&emsp;(a problem)</p><span class=\"italic\">et system</span>&ensp;&emsp;&ensp;(a system)</div></div>",A:"X"},{DECK_ID:"B02",ID:"B02024",N:"<div class=\"center\">en nordmann <br>nordmannen <br>nordmenn <br>nordmennene</div>",E:"<div class=\"center\">a Norwegian person</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Omtrent 150 000 nordmenn er bosatt i utlandet</span></p>This noun follows the same irregular pattern of <span class=\"italic\">en mann</span>.</div></div>",A:"N"},{DECK_ID:"B02",ID:"B02025",N:"<div class=\"center\">et bord <br>bordet <br>bord <br>bordene</div>",E:"<div class=\"center\">a table</div>",D:"INTERMEDIATE NOUNS",X:"",A:"N"},{DECK_ID:"B02",ID:"B02026",N:"<div class=\"center\">en nyhet <br>nyheten <br>nyheter <br>nyhetene</div>",E:"<div class=\"center\">a (piece of) news</div>",D:"INTERMEDIATE NOUNS",X:"",A:"N"},{DECK_ID:"B02",ID:"B02027",N:"<div class=\"center\">en gang <br>gangen <br>ganger <br>gangene</div>",E:"<div class=\"center\">a time, an instance, a hallway</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\">The expression <span class=\"italic\">en gang til</span> means \"once more\"</div></div>",A:"N"},{DECK_ID:"B02",ID:"B02028",N:"<div class=\"center\">en forskjell (mellom/p\xe5) <br>forskjellen <br>forskjeller <br>forskjellene</div>",E:"<div class=\"center\">a difference (between)</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Mellom</span> is used with <span class=\"italic\">bestemt</span> objects and measurable differences, <span class=\"italic\">p\xe5</span> is used with <span class=\"italic\">ubestemt</span> objects and significant differences in nature:</p><p><span class=\"italic\">Forskjellen mellom h\xf8ydene v\xe5re er liten</span></p><span class=\"italic\">Ser du forskjellen p\xe5 baseball og softball?</span></div></div>",A:"N"},{DECK_ID:"B02",ID:"B02029",N:"<div class=\"center\">en m\xe5te (p\xe5) <br>m\xe5ten <br>m\xe5ter <br>m\xe5tene</div>",E:"<div class=\"center\">a way (in which), a manner (in which)</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Fem m\xe5ter \xe5 unng\xe5 utroskap p\xe5</span><br>Five ways (in which) to avoid infidelity</p><span class=\"italic\">P\xe5 en m\xe5te</span><br>In a way</div></div>",A:"N"},{DECK_ID:"B02",ID:"B02030",N:"<div class=\"center\">ei krone <br>krona <br>kroner <br>kronene</div>",E:"<div class=\"center\">a krone</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\">Used mostly in feminine for the currency and in masculine for the ornament \"crown\".</div></div>",A:"N"},{DECK_ID:"B02",ID:"B02031",N:"<div class=\"center\">en butikk <br>butikken <br>butikker <br>butikkene</div>",E:"<div class=\"center\">a shop</div>",D:"INTERMEDIATE NOUNS",X:"",A:"N"},{DECK_ID:"B02",ID:"B02032",N:"<div class=\"center\">en pris (p\xe5) <br>prisen <br>priser <br>prisene</div>",E:"<div class=\"center\">a price (of)</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\">Prisen p\xe5 dressen var veldig h\xf8y</div>",A:"N"},{DECK_ID:"B02",ID:"B02033",N:"<div class=\"center\">et bel\xf8p <br>bel\xf8pet <br>bel\xf8p <br>bel\xf8pene</div>",E:"<div class=\"center\">a sum to be paid</div>",D:"INTERMEDIATE NOUNS",X:"",A:"N"},{DECK_ID:"B02",ID:"B02034",N:"<div class=\"center\">ei lommebok <br>lommeboka <br>lommeb\xf8ker <br>lommeb\xf8kene</div>",E:"<div class=\"center\">a wallet</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\">Might be preferred in feminine but the masculine form cannot be considered incorrect.</div></div>",A:"N"},{DECK_ID:"B02",ID:"B02035",N:"<div class=\"center\">(en) skatt <br>skatten</div>",E:"<div class=\"center\">taxation, tax</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\">Used predominantly in singular to indicate income tax on people, but can be plural for specific types of taxes.</div></div>",A:"N"},{DECK_ID:"B02",ID:"B02036",N:"<div class=\"center\">What is the gender of nouns <br>ending in <b class=\"bold\">-ELSE</b>?</div>",E:"<div class=\"center\">It is <span class=\"italic\">hankj\xf8nn</span></div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">en tillatelse</span>&ensp;&emsp;&emsp;(a permission)</p><p><span class=\"italic\">en f\xf8lelse</span>&ensp;&emsp;&ensp;&emsp;(a feeling)</p><span class=\"italic\">en avgj\xf8relse</span>&ensp;&emsp;(a decision)</div></div>",A:"X"},{DECK_ID:"B02",ID:"B02037",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">en hybel</span> (a bedsit)</div>",E:"<div class=\"center\">en hybel<br>hybelen<br>hybler<br>hyblene</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">Hankj\xf8nn</span> nouns ending in -EL (in the indefinite singular form) will often drop E (if unstressed) for the plural forms.</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02038",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">en alder</span> (an age)</div>",E:"<div class=\"center\">en alder<br>alderen<br>aldre<br>aldrene</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">Hankj\xf8nn</span> nouns ending in -ER (in the indefinite singular form) will often drop E (if unstressed) for the plural forms.</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02039",N:"<div class=\"center\">(p\xe5/ved) ei side <br>sida <br>sider <br>sidene</div>",E:"<div class=\"center\">(on) a page/(by) a side</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>Might be preferred in feminine but the masculine form cannot be considered incorrect:</p><span class=\"italic\"><p>Jeg s\xe5 en fin video p\xe5 nettsida di</p>Prinsen sitter ved siden av dronningen</span></div></div>",A:"N"},{DECK_ID:"B02",ID:"B02040",N:"<div class=\"center\">et problem <br>problemet <br>problemer <br>problemene</div>",E:"<div class=\"center\">a problem</div>",D:"INTERMEDIATE NOUNS",X:"",A:"N"},{DECK_ID:"B02",ID:"B02041",N:"<div class=\"center\">en grunn (for) <br>grunnen <br>grunner <br>grunnene</div>",E:"<div class=\"center\">a reason (for)</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">En grunn for bekymring</span><br>A reason to worry</p>The expression <span class=\"italic\">p\xe5 grunn av (pga)</span> means \"because of\".</div></div>",A:"N"},{DECK_ID:"B02",ID:"B02042",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">en regel</span> (a rule)</div>",E:"<div class=\"center\">en regel<br>regelen<br>regler<br>reglene</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">Hankj\xf8nn</span> nouns ending in -EL (in the indefinite singular form) will often drop E (if unstressed) for the plural forms.</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02043",N:"<div class=\"center\">et dyr <br>dyret <br>dyr <br>dyrene</div>",E:"<div class=\"center\">an animal</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">Intetkj\xf8nn</span> nouns made of one syllable tend not to take endings in the indefinite plural.</div></div>",A:"N"},{DECK_ID:"B02",ID:"B02044",N:"<div class=\"center\">en verden <br>verdenen <br>verdener <br>verdenene</div>",E:"<div class=\"center\">a world</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">Hankj\xf8nn</span> nouns ending in -EN (in the indefinite singular form) will maintain their ending as they change through the four forms.</div></div>",A:"N"},{DECK_ID:"B02",ID:"B02045",N:"<div class=\"center\">What is the gender of nouns <br>ending in <b class=\"bold\">-DOM</b>?</div>",E:"<div class=\"center\">It is <span class=\"italic\">hankj\xf8nn</span></div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">en sykdom</span>&ensp;&emsp;(a sickness)</p><p><span class=\"italic\">en eiendom</span>&ensp;&emsp;(a property)</p><p><span class=\"italic\">en ungdom</span>&ensp;&emsp;(a youth)</p>Note that these nouns will double the final M as they change to the various forms.</div></div>",A:"X"},{DECK_ID:"B02",ID:"B02046",N:"<div class=\"center\">et par <br>paret <br>par <br>parene</div>",E:"<div class=\"center\">a couple of, a pair of</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>Can be used with the preposition <span class=\"italic\">av</span>, especially with pronouns:</p><p><span class=\"italic\">Jeg kj\xf8pte et par av dem</span></p><span class=\"italic\">Jeg kj\xf8pte et par bukser</span></div></div>",A:"N"},{DECK_ID:"B02",ID:"B02047",N:"<div class=\"center\">et menneske <br>mennesket <br>mennesker <br>menneskene</div>",E:"<div class=\"center\">a human being, a person</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>This word is often used with high numbers or in a very general meaning as \"human beings\":</p><span class=\"italic\"><p>Fem millioner mennesker bor i Norge</p>Mennesker trenger mennesker</span></div></div>",A:"N"},{DECK_ID:"B02",ID:"B02048",N:"<div class=\"center\">et folk <br>folket <br>folk <br>folkene</div>",E:"<div class=\"center\">(a) people</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>This word is used as a collective noun, similar to \"gente/gens\" of some Latin languages or to indicate a people/nation. Almost always in <span class=\"italic\">ubestemt</span> form and never with numbers:</p><span class=\"italic\">Folk er rare<br>Det var mange folk p\xe5 toget<br>Samefolkets dag</span></div></div>",A:"N"},{DECK_ID:"B02",ID:"B02049",N:"<div class=\"center\">(en) hjelp <br>hjelpen</div>",E:"<div class=\"center\">help</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\">Used predominantly in singular</div>",A:"N"},{DECK_ID:"B02",ID:"B02050",N:"<div class=\"center\">en mening <br>meningen <br>meninger <br>meningene</div>",E:"<div class=\"center\">an opinion, a position</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\">Can be used in feminine as well</div>",A:"N"},{DECK_ID:"B02",ID:"B02051",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">et teater</span> (a theater)</div>",E:"<div class=\"center\">et teater<br>teateret<br>teatre<br>teatrene</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\"><p>Intetkj\xf8nn</span> nouns ending in -ER drop the E in their plural forms and end in -E and -ENE.</p>They used to drop the E also for the definite singular form, but a 2022 update by <span class=\"italic\">Spr\xe5kr\xe5det</span> has changed this.</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02052",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">et \xf8ye</span> (an eye)</div>",E:"<div class=\"center\">et \xf8ye<br>\xf8yet<br>\xf8yne<br>\xf8yene</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>Irregular, do not mistake it with <span class=\"italic\">ei/en \xf8y</span> which means \"an island\".</p>The definite plural form <span class=\"italic\">\xf8ynene</span> is also possible.</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02053",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">et varsel</span> (a notice)</div>",E:"<div class=\"center\">et varsel<br>varselet<br>varsler<br>varslene</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Intetkj\xf8nn</span> nouns ending in -EL (in the indefinite singular form) drop the -E for both plural forms.</p>They used to drop the E also for the definite singular form, but a 2022 update by <span class=\"italic\">Spr\xe5kr\xe5det</span> has changed this.</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02054",N:"<div class=\"center\">et tilbud <br>tilbudet <br>tilbud <br>tilbudene</div>",E:"<div class=\"center\">an offer, a supply (in economics)</div>",D:"INTERMEDIATE NOUNS",X:"",A:"N"},{DECK_ID:"B02",ID:"B02055",N:"<div class=\"center\">(et) innhold <br>innholdet</div>",E:"<div class=\"center\">a content</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\">Used predominantly in singular</div>",A:"N"},{DECK_ID:"B02",ID:"B02056",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">en takk</span> (a thank)</div>",E:"<div class=\"center\">en takk<br>takken<br>takk<br>takkene</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\">Irregular, the indefinite plural doesn't take an ending, as if it was a one-syllable <span class=\"italic\">intetkj\xf8nn</span> noun.</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02057",N:"<div class=\"center\">What is the gender of nouns <br>ending in <b class=\"bold\">-SJON</b>?</div>",E:"<div class=\"center\">It is <span class=\"italic\">hankj\xf8nn</span></div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">en nasjon</span>&ensp;&emsp;&ensp;&emsp;&ensp;(a nation)</p><span class=\"italic\">en informasjon</span>&ensp;&emsp;(a piece of information)</div></div>",A:"X"},{DECK_ID:"B02",ID:"B02058",N:"<div class=\"center\"><p>List the forms for:</p><span class=\"italic\">bukser</span> (trousers)</div>",E:"<div class=\"center\">bukser, buksene</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>Some nouns are almost always used in the plural.</p>The word <span class=\"italic\">briller</span> (glasses) is another example.</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02059",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">ei h\xe5nd</span> (a hand)</div>",E:"<div class=\"center\">ei h\xe5nd<br>h\xe5nda<br>hender<br>hendene</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\">Irregular, often used as feminine, although the masculine form cannot be considered incorrect.</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02060",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">en seddel</span> (a banknote)</div>",E:"<div class=\"center\">en seddel<br>seddelen<br>sedler<br>sedlene</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Hankj\xf8nn</span> nouns ending in -EL (in the indefinite singular form) will often drop E (if unstressed) for the plural forms.</p>Additionally, any double consonants will be reduced to one, to avoid having three consonants in a row (two of which being the same one).</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02061",N:"<div class=\"center\">et kort <br>kortet <br>kort <br>kortene</div>",E:"<div class=\"center\">a card</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\">Pay attention to the retroflexed sound of the RT cluster.</div></div>",A:"N"},{DECK_ID:"B02",ID:"B02062",N:"<div class=\"center\">et \xf8re <br>\xf8ret <br>\xf8re <br>\xf8rene</div>",E:"<div class=\"center\">an \xf8re</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\">The <span class=\"italic\">\xf8re</span> is the 100th part of the <span class=\"italic\">krone</span>.</div></div>",A:"N"},{DECK_ID:"B02",ID:"B02063",N:"<div class=\"center\">kontanter, kontantene</div>",E:"<div class=\"center\">cash</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>There exist also the adjective/adverb <span class=\"italic\">kontant, kontant, kontante</span> meaning \"in cash\".</p>The expression <span class=\"italic\">et kontant svar</span> means \"a very direct answer\".</div></div>",A:"N"},{DECK_ID:"B02",ID:"B02064",N:"<div class=\"center\">What is the gender of nouns <br>ending in <b class=\"bold\">-NAD</b>?</div>",E:"<div class=\"center\">It is <span class=\"italic\">hankj\xf8nn</span></div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">en s\xf8knad</span>&ensp;&emsp;(an application)</p><p><span class=\"italic\">en kostnad</span>&ensp;&emsp;(a cost)</p><span class=\"italic\">en merknad</span>&ensp;&emsp;(a comment)</div></div>",A:"X"},{DECK_ID:"B02",ID:"B02065",N:"<div class=\"center\">en dialekt <br>dialekten <br>dialekter <br>dialektene</div>",E:"<div class=\"center\">a dialect, an accent</div>",D:"INTERMEDIATE NOUNS",X:"",A:"N"},{DECK_ID:"B02",ID:"B02066",N:"<div class=\"center\">et bilde (av) <br>bildet <br>bilder <br>bildene</div>",E:"<div class=\"center\">an image (of), a photo (of)</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\">Det er et gammelt bilde av meg</div>",A:"N"},{DECK_ID:"B02",ID:"B02067",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">en hilsen</span> (a greeting, a regard)</div>",E:"<div class=\"center\">en hilsen<br>hilsenen<br>hilsener<br>hilsenene</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">Hankj\xf8nn</span> nouns ending in -EN (in the indefinite singular form) will maintain their ending as they change through the four forms.</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02068",N:"<div class=\"center\"><p>List the forms for:</p><span class=\"italic\">briller</span> (eye glasses)</div>",E:"<div class=\"center\">briller, brillene</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>Some nouns are almost always used in the plural.</p>The word <span class=\"italic\">lesebriller</span> can also be used.</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02069",N:"<div class=\"center\">What is the gender of nouns <br>ending in <b class=\"bold\">-ERI</b>?</div>",E:"<div class=\"center\">It is <span class=\"italic\">intetkj\xf8nn</span></div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">et batteri</span>&ensp;&emsp;(a battery)</p><p><span class=\"italic\">et vaskeri</span>&ensp;&emsp;(a laundrette)</p><span class=\"italic\">et tyveri</span>&ensp;&emsp;&emsp;(a theft)</div></div>",A:"X"},{DECK_ID:"B02",ID:"B02070",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">en sykkel</span> (a bicyle)</div>",E:"<div class=\"center\">en sykkel<br>sykkelen<br>sykler<br>syklene</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Hankj\xf8nn</span> nouns ending in -EL (in the indefinite singular form) will often drop E (if unstressed) for the plural forms.</p>Additionally, any double consonants will be reduced to one, to avoid having three consonants in a row (two of which being the same one).</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02071",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">en lighter</span> (a cigarette lighter)</div>",E:"<div class=\"center\">en lighter<br>lighteren<br>lightere<br>lighterne</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>Nouns ending in -ER and denoting a role, an occupation or a function have the indefinite plural in -ERE and the definite plural in -ERNE.</p>This direct loanword is pronounced like in English.</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02072",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">en spiller</span> (a player)</div>",E:"<div class=\"center\">en spiller<br>spilleren<br>spillere<br>spillerne</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\">Nouns ending in -ER and denoting a role, an occupation or a function have the indefinite plural in -ERE and the definite plural in -ERNE.</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02073",N:"<div class=\"center\"><div class=\"left\">What is the first way to agglutinate words together into a single <span class=\"italic\">sammensatt substantiv</span>?</div></div>",E:"<div class=\"center\"><div class=\"left\">The default approach is to simply put them together. The compound noun acquires the gender of the last noun.</div></div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><p>Examples:</p><span class=\"italic\">sommerferie, ordbok, Flytoget</span></div>",A:"X"},{DECK_ID:"B02",ID:"B02074",N:"<div class=\"center\">et sp\xf8rsm\xe5l (om) <br>sp\xf8rsm\xe5let <br>sp\xf8rsm\xe5l <br>sp\xf8rsm\xe5lene</div>",E:"<div class=\"center\">a question (about)</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\">Jeg vil gjerne stille et sp\xf8rsm\xe5l om grammatikk</div></div>",A:"N"},{DECK_ID:"B02",ID:"B02075",N:"<div class=\"center\">et svar (til) <br>svaret <br>svar <br>svarene</div>",E:"<div class=\"center\">an answer (to)</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Ministerens svar til presidenten var tydelig</span></p>However, note that \"an answer to a question\" is <span class=\"italic\">et svar <b class=\"bold\">p\xe5</b> et sp\xf8rsm\xe5l</span>.</div></div>",A:"N"},{DECK_ID:"B02",ID:"B02076",N:"<div class=\"center\">What is the gender of nouns <br>ending in <b class=\"bold\">-MENT</b>?</div>",E:"<div class=\"center\">It is <span class=\"italic\">intetkj\xf8nn</span></div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">et dokument</span>&ensp;&emsp;&emsp;(a document)</p><p><span class=\"italic\">et arrangement</span>&ensp;&emsp;(an arrangement)</p><span class=\"italic\">et kompliment</span>&ensp;&emsp;(a compliment)</div></div>",A:"X"},{DECK_ID:"B02",ID:"B02077",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">ei mor</span> (a mother)</div>",E:"<div class=\"center\">ei mor<br>mora<br>m\xf8dre<br>m\xf8drene</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\">Irregular, often used as feminine, although the masculine form cannot be considered incorrect.</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02078",N:"<div class=\"center\">en familie <br>familien <br>familier <br>familiene</div>",E:"<div class=\"center\">a family</div>",D:"INTERMEDIATE NOUNS",X:"",A:"N"},{DECK_ID:"B02",ID:"B02079",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">en far</span> (a father)</div>",E:"<div class=\"center\">en far<br>faren<br>fedre<br>fedrene</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\">Irregular</div>",A:"E"},{DECK_ID:"B02",ID:"B02080",N:"<div class=\"center\">en mobil(telefon) <br>mobilen <br>mobiler <br>mobilene</div>",E:"<div class=\"center\">a mobile(phone)</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\">The full word would be <span class=\"italic\">en mobiltelefon</span> but <span class=\"italic\">en mobil</span> is accepted too.</div></div>",A:"N"},{DECK_ID:"B02",ID:"B02081",N:"<div class=\"center\">en beskjed <br>beskjeden <br>beskjeder <br>beskjedene</div>",E:"<div class=\"center\">a notification, a heads-up, a note</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>The D is silent. Used in very common expressions regarding voicemail/answering machines or meet-ups:</p><p><span class=\"italic\">Hei! Dette er Gros telefonsvarer. Vennligst legg igjen en beskjed.</p>Bare gi beskjed hvis du ikke kommer, ok?</span></div></div>",A:"N"},{DECK_ID:"B02",ID:"B02082",N:"<div class=\"center\">(i) ei helg <br>helga <br>helger <br>helgene</div>",E:"<div class=\"center\">(at/in) a weekend</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>The word <span class=\"italic\">helg</span> requires the preposition <span class=\"italic\">i</span> before:</p><span class=\"italic\">Vi skal p\xe5 tur i helga</span></div></div>",A:"N"},{DECK_ID:"B02",ID:"B02083",N:"<div class=\"center\">et d\xf8gn <br>d\xf8gnet <br>d\xf8gn <br>d\xf8gnene</div>",E:"<div class=\"center\">a whole day, day & night, 24 hours</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\">V\xe5r kundeservice er \xe5pen d\xf8gnet rundt</div></div>",A:"N"},{DECK_ID:"B02",ID:"B02084",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">en meter</span> (a metre)</div>",E:"<div class=\"center\">en meter<br>meteren<br>meter<br>meterne</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\">Most nouns used for measurements and currency do not take endings for the indefinite plural.</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02085",N:"<div class=\"center\">et brev (fra) <br>brevet <br>brev <br>brevene</div>",E:"<div class=\"center\">a letter (from)</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\">Jeg fikk et brev fra mormor</div>",A:"N"},{DECK_ID:"B02",ID:"B02086",N:"<div class=\"center\">(en) post (til) <br>posten</div>",E:"<div class=\"center\">mail (for), the postal system</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>Used predominantly in singular</p><span class=\"italic\">Her, det er post til deg i dag!</span></div></div>",A:"N"},{DECK_ID:"B02",ID:"B02087",N:"<div class=\"center\">et stykke (av) <br>stykket <br>stykker <br>stykkene</div>",E:"<div class=\"center\">a piece (of), an item (of)</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\">V\xe6r forsiktig, et stykke av veien ikke er motorvei</div></div>",A:"N"},{DECK_ID:"B02",ID:"B02088",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">en artikkel</span> (an article)</div>",E:"<div class=\"center\">en artikkel<br>artikkelen<br>artikler<br>artiklene</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Hankj\xf8nn</span> nouns ending in -EL (in the indefinite singular form) will often drop E (if unstressed) for the plural forms.</p>Additionally, any double consonants will be reduced to one, to avoid having three consonants in a row (two of which being the same one).</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02089",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">et glass</span> (a glass)</div>",E:"<div class=\"center\">et glass<br>glasset<br>glass<br>glassene</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">Intetkj\xf8nn</span> nouns made of one syllable tend not to take endings in the indefinite plural.</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02090",N:"<div class=\"center\">What is the gender of nouns <br>ending in <b class=\"bold\">-TEK</b>?</div>",E:"<div class=\"center\">It is <span class=\"italic\">intetkj\xf8nn</span></div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">et apotek</span>&ensp;&emsp;&emsp;(a pharmacy)</p><span class=\"italic\">et bibliotek</span>&ensp;&emsp;(a library)</div></div>",A:"X"},{DECK_ID:"B02",ID:"B02091",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">et museum</span> (a museum)</div>",E:"<div class=\"center\">et museum<br>museet<br>museer<br>museene</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\">Nouns ending in -UM come from Latin and are all <span class=\"italic\">intetkj\xf8nn</span>.<br>They may have less used forms, different from those shown.</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02092",N:"<div class=\"center\">(et) v\xe6r <br>v\xe6ret</div>",E:"<div class=\"center\">weather</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\">Used predominantly in singular</div>",A:"N"},{DECK_ID:"B02",ID:"B02093",N:"<div class=\"center\">ei sol <br>sola <br>soler <br>solene</div>",E:"<div class=\"center\">a sun</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\">Often used in feminine, although the masculine form cannot be considered incorrect.</div></div>",A:"N"},{DECK_ID:"B02",ID:"B02094",N:"<div class=\"center\">(et) regn <br>regnet</div>",E:"<div class=\"center\">rain</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\">Used predominantly in singular</div>",A:"N"},{DECK_ID:"B02",ID:"B02095",N:"<div class=\"center\">en paraply <br>paraplyen <br>paraplyer <br>paraplyene</div>",E:"<div class=\"center\">an umbrella</div>",D:"INTERMEDIATE NOUNS",X:"",A:"N"},{DECK_ID:"B02",ID:"B02096",N:"<div class=\"center\"><p>List the most common forms for:</p><span class=\"italic\">sn\xf8</span> (snow)</div>",E:"<div class=\"center\">sn\xf8, sn\xf8en</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>Uncountable nouns are used almost always in the singular.</p>These include words for natural or atmospheric events (rain, ice, water) for some foods (rice, milk) and materials (sand, wool).</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02097",N:"<div class=\"center\">en vind <br>vinden <br>vinder <br>vindene</div>",E:"<div class=\"center\">a wind</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\">Note the silent D</div>",A:"N"},{DECK_ID:"B02",ID:"B02098",N:"<div class=\"center\">et papir <br>papiret <br>papirer <br>papirene</div>",E:"<div class=\"center\">paper, a piece of paper</div>",D:"INTERMEDIATE NOUNS",X:"",A:"N"},{DECK_ID:"B02",ID:"B02099",N:"<div class=\"center\">(et) vann <br>vannet <br>vann <br>vannene</div>",E:"<div class=\"center\">water, a lake</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\">Uncountable when meaning \"water\", countable when meaning \"lake\".</div></div>",A:"N"},{DECK_ID:"B02",ID:"B02100",N:"<div class=\"center\">(en) is <br>isen</div>",E:"<div class=\"center\">ice, an icecream</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\">Uncountable when meaning \"ice\", countable when being used as a shortening for \"icecream\".</div></div>",A:"N"},{DECK_ID:"B02",ID:"B02101",N:"<div class=\"center\">en plass <br>plassen <br>plasser <br>plassene</div>",E:"<div class=\"center\">a place, a circular square</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\">Hun har en plass i hjertet mitt</div>",A:"N"},{DECK_ID:"B02",ID:"B02102",N:"<div class=\"center\">(i/p\xe5) ei gate <br>gata <br>gater <br>gatene</div>",E:"<div class=\"center\">(in/on) a street</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>En dyr bil sto parkert i gata</p>En ung mann ble funnet med skader p\xe5 gata</div></div>",A:"N"},{DECK_ID:"B02",ID:"B02103",N:"<div class=\"center\">(p\xe5/ved) et torg <br>torget <br>torg <br>torgene</div>",E:"<div class=\"center\">(in/by) a square, a market place</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>Hun satte seg ned p\xe5 torget med en sigarett</p>Hotellet ligger ved torget</div></div>",A:"N"},{DECK_ID:"B02",ID:"B02104",N:"<div class=\"center\">en retning (av) <br>retningen <br>retninger <br>retningene</div>",E:"<div class=\"center\">a direction (of)</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>The preposition can be omitted:</p><span class=\"italic\">G\xe5 i retning (av) T-bane stasjonen</span></div></div>",A:"N"},{DECK_ID:"B02",ID:"B02105",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">et sentrum</span> (a city centre)</div>",E:"<div class=\"center\">et sentrum<br>sentrumet<br>sentre<br>sentrene</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>Nouns ending in -UM come from Latin and are all <span class=\"italic\">intetkj\xf8nn</span>.<br>They may have less used forms, different from those shown.</p>Note that <span class=\"italic\">et senter</span> is a different word altogether.</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02106",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">en st\xf8vel</span> (a boot)</div>",E:"<div class=\"center\">en st\xf8vel<br>st\xf8velen<br>st\xf8vler<br>st\xf8vlene</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">Hankj\xf8nn</span> nouns ending in -EL (in the indefinite singular form) will often drop E (if unstressed) for the plural forms.</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02107",N:"<div class=\"center\"><p>List the most common forms for:</p><span class=\"italic\">lykke</span> (luck)</div>",E:"<div class=\"center\">lykke, lykken</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>Uncountable nouns are used almost always in the singular.</p>These include words for abstract concepts such as doubt, trouble, trust, hate.</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02108",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">ei datter</span> (a daughter)</div>",E:"<div class=\"center\">ei datter<br>dattera<br>d\xf8tre<br>d\xf8trene</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\">Irregular, often used as feminine, although the masculine form cannot be considered incorrect.</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02109",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">ei s\xf8ster</span> (a sister)</div>",E:"<div class=\"center\">ei s\xf8ster<br>s\xf8stera<br>s\xf8stre<br>s\xf8strene</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\">Might be preferred in feminine but the masculine form cannot be considered incorrect.</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02110",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">en bror</span> (a brother)</div>",E:"<div class=\"center\">en bror<br>broren<br>br\xf8dre<br>br\xf8drene</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\">Irregular</div>",A:"E"},{DECK_ID:"B02",ID:"B02111",N:"<div class=\"center\"><div class=\"left\">What is the second way to agglutinate words together into a single <span class=\"italic\">sammensatt substantiv</span>?</div></div>",E:"<div class=\"center\"><div class=\"left\">Some nouns can be compounded by uniting them with an S. The compound noun acquires the gender of the last noun. This method is used when the first word ends in -DOM, -ELSE, -HET, -ING, -NAD, -SJON, -SKAP, -TET and such.</div></div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><p>Examples:</p><span class=\"italic\">arbeidsgiver, handelsmann, s\xf8knadsfrist, identitetskrise</span></div>",A:"X"},{DECK_ID:"B02",ID:"B02112",N:"<div class=\"center\">(ei) helse <br>helsa</div>",E:"<div class=\"center\">health</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\">Used predominantly in singular and feminine</div></div>",A:"N"},{DECK_ID:"B02",ID:"B02113",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">ei/en tann</span> (a tooth)</div>",E:"<div class=\"center\">ei/en tann<br>tanna/tannen<br>tenner<br>tennene</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\">Irregular, often used as feminine, although the masculine form cannot be considered incorrect.</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02114",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">et bein</span> (a leg, a bone)</div>",E:"<div class=\"center\">et bein<br>beinet<br>bein<br>beina</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Intetkj\xf8nn</span> nouns made of one syllable tend not to take endings in the indefinite plural.</p>Moreover, <span class=\"italic\">et bein</span> takes -A as definite plural, instead of -ENE.</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02115",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">en advarsel</span> (a warning)</div>",E:"<div class=\"center\">en advarsel<br>advarselen<br>advarsler<br>advarslene</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">Hankj\xf8nn</span> nouns ending in -EL (in the indefinite singular form) will often drop E (if unstressed) for the plural forms.</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02116",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">en sommer</span> (a summer)</div>",E:"<div class=\"center\">en sommer<br>sommeren<br>somre/sommere<br>somrene/sommerne</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Hankj\xf8nn</span> nouns ending in -ER (in the indefinite singular form) will often drop E (if unstressed) for the plural forms.</p>Additionally, any double consonants will be reduced to one, to avoid having three consonants in a row (two of which being the same one).</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02117",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">en vinter</span> (a winter)</div>",E:"<div class=\"center\">en vinter<br>vinteren<br>vintre<br>vintrene</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">Hankj\xf8nn</span> nouns ending in -ER (in the indefinite singular form) will often drop E (if unstressed) for the plural forms.</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02118",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">en kaf\xe9</span> (a caf\xe9, a bar)</div>",E:"<div class=\"center\">en kaf\xe9<br>kaf\xe9en<br>kaf\xe9er<br>kaf\xe9ene</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>Stressed -E at the end of the noun remains through the four forms.</p>The use of the accented \xc9 is not mandatory.</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02119",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">en liter</span> (a litre)</div>",E:"<div class=\"center\">en liter<br>literen<br>liter<br>literne</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\">Most nouns used for measurements and currency do not take endings for the indefinite plural.</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02120",N:"<div class=\"center\">en tjeneste (for) <br>tjenesten <br>tjenester <br>tjenestene</div>",E:"<div class=\"center\">a favour, a service (for)</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\">Vi har en gratis tjeneste for deg som vil selge boligen</div></div>",A:"N"},{DECK_ID:"B02",ID:"B02121",N:"<div class=\"center\">en konto <br>kontoen <br>kontoer <br>kontoene</div>",E:"<div class=\"center\">an account</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\">Jeg har ikke bankkonto i Norge enn\xe5</div></div>",A:"N"},{DECK_ID:"B02",ID:"B02122",N:"<div class=\"center\">en melding <br>meldingen <br>meldinger <br>meldingene</div>",E:"<div class=\"center\">a message</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\">The nouns ending in -ING can also be used in feminine, especially when speaking, just like the ones ending in -NING.</div></div>",A:"N"},{DECK_ID:"B02",ID:"B02123",N:"<div class=\"center\">en sak <br>saken <br>saker <br>sakene</div>",E:"<div class=\"center\">a case, a matter</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>Used for things such as a legal case in court, a case in a process such as an application for residency or benefits or, more informally, a person's matters.<br>It can mean \"things, stuff\" when used in plural:</p><span class=\"italic\">Jeg finner ikke sakene mine</span>.</div></div>",A:"N"},{DECK_ID:"B02",ID:"B02124",N:"<div class=\"center\">et sykehus <br>sykehuset <br>sykehus <br>sykehusene</div>",E:"<div class=\"center\">a hospital</div>",D:"INTERMEDIATE NOUNS",X:"",A:"N"},{DECK_ID:"B02",ID:"B02125",N:"<div class=\"center\">en innvandrer <br>innvandreren <br>innvandrere <br>innvandrerne</div>",E:"<div class=\"center\">an immigrant</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\">Nouns ending in -ER and denoting a role, an occupation or a function have the indefinite plural in -ERE and the definite plural in -ERNE.</div></div>",A:"N"},{DECK_ID:"B02",ID:"B02126",N:"<div class=\"center\">(i) en park <br>parken <br>parker <br>parkene</div>",E:"<div class=\"center\">(in) a park</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\">Vi sitter i parken, kom og finn oss!</div>",A:"N"},{DECK_ID:"B02",ID:"B02127",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">et tre</span> (a tree)</div>",E:"<div class=\"center\">et tre<br>treet<br>tr\xe6r<br>tr\xe6rne</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\">Irregular</div>",A:"E"},{DECK_ID:"B02",ID:"B02128",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">et tr\xf8bbel</span> (a trouble, problem)</div>",E:"<div class=\"center\">et tr\xf8bbel<br>tr\xf8bbelet<br>tr\xf8bler<br>tr\xf8blene</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Intetkj\xf8nn</span> nouns ending in -EL (in the indefinite singular form) drop the -E for both plural forms.</p>They used to drop the E also for the definite singular form, but a 2022 update by <span class=\"italic\">Spr\xe5kr\xe5det</span> has changed this.</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02129",N:"<div class=\"center\"><div class=\"left\">What is the third way to agglutinate words together into a single <span class=\"italic\">sammensatt substantiv</span>?</div></div>",E:"<div class=\"center\"><div class=\"left\">Some nouns are compounded by uniting them with an E. The compound noun acquires the gender of the last noun.<br>This method is used to break difficult consonant clusters and is often used when the first word is monosyllabic and/or indicating a person or an animal.</div></div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>Examples:</p><span class=\"italic\">lammestek, gutterom, fisketorg</span></div></div>",A:"X"},{DECK_ID:"B02",ID:"B02130",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">en genser</span> (a sweater)</div>",E:"<div class=\"center\">en genser<br>genseren<br>gensere<br>genserne</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\">Nouns ending in -ER and denoting a role, an occupation or a function have the indefinite plural in -ERE and the definite plural in -ERNE.</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02131",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">en fot</span> (a foot)</div>",E:"<div class=\"center\">en fot<br>foten<br>f\xf8tter<br>f\xf8ttene</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\">Irregular</div>",A:"E"},{DECK_ID:"B02",ID:"B02132",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">en id\xe9</span> (an idea)</div>",E:"<div class=\"center\">en id\xe9<br>id\xe9en<br>id\xe9er<br>id\xe9ene</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>Stressed -E at the end of the noun remains through the four forms.</p>The use of the accented \xc9 is not mandatory.</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02133",N:"<div class=\"center\">en lov <br>loven <br>lover <br>lovene</div>",E:"<div class=\"center\">a law</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>Often used as an adjective:</p><p><span class=\"italic\">Er det lov \xe5 grille i parken?</span></p>Is it allowed to barbeque in the park?</div></div>",A:"N"},{DECK_ID:"B02",ID:"B02134",N:"<div class=\"center\">en tillatelse (til) <br>tillatelsen <br>tillatelser <br>tillatelsene</div>",E:"<div class=\"center\">a permission (to), a permit (to)</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\">Jeg fikk tillatelse til \xe5 fiske i elva</div></div>",A:"N"},{DECK_ID:"B02",ID:"B02135",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">et kvarter</span> (a quarter)</div>",E:"<div class=\"center\">et kvarter<br>kvarteret<br>kvarter<br>kvarterene</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\">Because of its spelling, <span class=\"italic\">et kvarter</span> is basically an irregular <span class=\"italic\">intetkj\xf8nn</span> noun, because it cannot drop the E in its -ER ending.</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02136",N:"<div class=\"center\"><div class=\"left\">What is the fourth way to agglutinate words together into a single <span class=\"italic\">sammensatt substantiv</span>?</div></div>",E:"<div class=\"center\"><div class=\"left\">Some nouns can be compounded by uniting them with a dash. The compound noun acquires the gender of the last noun. This method is used for clarity, for instance to break triple consonants and if one word is an acronym.</div></div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>Examples:</p><span class=\"italic\">vill-laks, EU-medlemskap</span></div></div>",A:"X"},{DECK_ID:"B02",ID:"B02137",N:"<div class=\"center\">en pr\xf8ve (i) <br>pr\xf8ven <br>pr\xf8ver <br>pr\xf8vene</div>",E:"<div class=\"center\">a test (about/on), an exam (about/on)</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\">Jeg har en pr\xf8ve i samfunnsfag i morgen</div></div>",A:"N"},{DECK_ID:"B02",ID:"B02138",N:"<div class=\"center\">et \xf8yeblikk <br>\xf8yeblikket <br>\xf8yeblikk <br>\xf8yeblikkene</div>",E:"<div class=\"center\">an instant, the blink of an eye</div>",D:"INTERMEDIATE NOUNS",X:"",A:"N"},{DECK_ID:"B02",ID:"B02139",N:"<div class=\"center\">ei dame <br>dama <br>damer <br>damene</div>",E:"<div class=\"center\">a lady, a madame</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\">Might be preferred in feminine but the masculine form cannot be considered incorrect.</div></div>",A:"N"},{DECK_ID:"B02",ID:"B02140",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">en eksamen</span> (an exam)</div>",E:"<div class=\"center\">en eksamen<br>eksamenen<br>eksamener<br>eksamenene</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">Hankj\xf8nn</span> nouns ending in -EN (in the indefinite singular form) will maintain their ending as they change through the four forms.</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02141",N:"<div class=\"center\">en avtale <br>avtalen <br>avtaler <br>avtalene</div>",E:"<div class=\"center\">a deal, an agreement, an appointment</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\">Beklager, jeg har allerede en avtale med en venn i kveld.</div></div>",A:"N"},{DECK_ID:"B02",ID:"B02142",N:"<div class=\"center\">en masse <br>massen <br>masser <br>massene</div>",E:"<div class=\"center\">a mass of, a lot of</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>Can be used without the preposition <span class=\"italic\">av</span>:</p><span class=\"italic\">Det kom masse folk p\xe5 konserten</span></div></div>",A:"N"},{DECK_ID:"B02",ID:"B02143",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">ei natt</span> (a night)</div>",E:"<div class=\"center\">ei natt<br>natta<br>netter<br>nettene</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\">Irregular, often used as feminine, although the masculine form cannot be considered incorrect.</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02144",N:"<div class=\"center\">en fest <br>festen <br>fester <br>festene</div>",E:"<div class=\"center\">a party</div>",D:"INTERMEDIATE NOUNS",X:"",A:"N"},{DECK_ID:"B02",ID:"B02145",N:"<div class=\"center\">en drikk <br>drikken <br>drikker <br>drikkene</div>",E:"<div class=\"center\">a drink</div>",D:"INTERMEDIATE NOUNS",X:"",A:"N"},{DECK_ID:"B02",ID:"B02146",N:"<div class=\"center\">en ferie <br>ferien <br>ferier <br>feriene</div>",E:"<div class=\"center\">a holiday, a vacation</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>Mostly used in singular:</p><span class=\"italic\"><p>Jeg var p\xe5 sommerferie i Portugal</p>Han trenger \xe5 ta ferie</span></div></div>",A:"N"},{DECK_ID:"B02",ID:"B02147",N:"<div class=\"center\">et nett <br>nettet <br>nett <br>nettene</div>",E:"<div class=\"center\">a net</div>",D:"INTERMEDIATE NOUNS",X:"",A:"N"},{DECK_ID:"B02",ID:"B02148",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">et faktum</span> (a fact)</div>",E:"<div class=\"center\">et faktum<br>faktumet<br>fakta<br>faktaene</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\">Nouns ending in -UM come from Latin and are all <span class=\"italic\">intetkj\xf8nn</span>.<br>They may have less used forms, different from those shown.</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02149",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">et kne</span> (a knee)</div>",E:"<div class=\"center\">et kne<br>kneet<br>kn\xe6r<br>kn\xe6rne</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\">Irregular</div>",A:"E"},{DECK_ID:"B02",ID:"B02150",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">en finger</span> (a finger)</div>",E:"<div class=\"center\">en finger<br>fingeren<br>fingre<br>fingrene</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">Hankj\xf8nn</span> nouns ending in -ER (in the indefinite singular form) will often drop E (if unstressed) for the plural forms.</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02151",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">ei/en t\xe5</span> (a toe)</div>",E:"<div class=\"center\">ei/en t\xe5<br>t\xe5a/t\xe5en<br>t\xe6r<br>t\xe6rne</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\">Irregular, often used as feminine, although the masculine form cannot be considered incorrect.</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02152",N:"<div class=\"center\">(ei) framtid <br>framtida</div>",E:"<div class=\"center\">(a) future</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>Mostly used as singular and feminine.</p>Also possible as <span class=\"italic\">(en) fremtid, fremtiden</span> which is the more Danish/conservative spelling (hence the use of <span class=\"italic\">hankj\xf8nn</span>).</div></div>",A:"N"},{DECK_ID:"B02",ID:"B02153",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">ei/en strand</span> (a beach)</div>",E:"<div class=\"center\">ei/en strand<br>stranda/stranden<br>strender<br>strendene</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\">Irregular, often used as feminine, although the masculine form cannot be considered incorrect.</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02154",N:"<div class=\"center\">en kino <br>kinoen <br>kinoer <br>kinoene</div>",E:"<div class=\"center\">a cinema</div>",D:"INTERMEDIATE NOUNS",X:"",A:"N"},{DECK_ID:"B02",ID:"B02155",N:"<div class=\"center\">en film <br>filmen <br>filmer <br>filmene</div>",E:"<div class=\"center\">a film, a movie</div>",D:"INTERMEDIATE NOUNS",X:"",A:"N"},{DECK_ID:"B02",ID:"B02156",N:"<div class=\"center\">(en) kunst <br>kunsten</div>",E:"<div class=\"center\">art</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\">Used predominantly in singular</div>",A:"N"},{DECK_ID:"B02",ID:"B02157",N:"<div class=\"center\">en gave <br>gaven <br>gaver <br>gavene</div>",E:"<div class=\"center\">a present</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\">The regular <span class=\"italic\">hankj\xf8nn</span> noun <span class=\"italic\">en presang</span> can also be used.</div></div>",A:"N"},{DECK_ID:"B02",ID:"B02158",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">en dollar</span> (a dollar)</div>",E:"<div class=\"center\">en dollar<br>dollaren<br>dollar<br>dollarene</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\">Most nouns used for measurements and currency do not take endings for the indefinite plural.</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02159",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">et kammer</span> (a chamber)</div>",E:"<div class=\"center\">et kammer<br>kammeret<br>kamre<br>kamrene</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\">Some <span class=\"italic\">intetkj\xf8nn</span> nouns ending in -ER drop one of the double consonants and the E for the plural forms.</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02160",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">et passivum</span> (a liability)</div>",E:"<div class=\"center\">et passivum<br>passivumet<br>passivum/passivumer<br>passivuma/passivumene</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>Nouns ending in -UM come from Latin and are all <span class=\"italic\">intetkj\xf8nn</span>.</p>They may have less used forms, different from those shown, and when referring to financial accounting, the plural forms are <span class=\"italic\">passiva, passivaene</span>.</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02161",N:"<div class=\"center\">et r\xe5d (om) <br>r\xe5det <br>r\xe5d <br>r\xe5dene</div>",E:"<div class=\"center\">a counsel, an advice (about)</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">F\xe5 gratis r\xe5d om helsa di!</span><br>Get free advice on your health!</div></div>",A:"N"},{DECK_ID:"B02",ID:"B02162",N:"<div class=\"center\">en sjef (for) <br>sjefen <br>sjefer <br>sjefene</div>",E:"<div class=\"center\">a boss (of), a head (of)</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\">Sjefen for firmaet mitt heter Snorre</div>",A:"N"},{DECK_ID:"B02",ID:"B02163",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">et register</span> (a register)</div>",E:"<div class=\"center\">et register<br>registeret<br>registre<br>registrene</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\"><p>Intetkj\xf8nn</span> nouns ending in -ER drop the E in their plural forms and end in -E and -ENE.</p>They used to drop the E also for the definite singular form, but a 2022 updated by <span class=\"italic\">Spr\xe5kr\xe5det</span> has changed this.</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02164",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">en isbre</span> (a glacier)</div>",E:"<div class=\"center\">en isbre<br>isbreen<br>isbreer<br>isbreene</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\">Stressed -E at the end of the noun remains through the four forms.</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02165",N:"<div class=\"center\">et omr\xe5de <br>omr\xe5det <br>omr\xe5der <br>omr\xe5dene</div>",E:"<div class=\"center\">an area</div>",D:"INTERMEDIATE NOUNS",X:"",A:"N"},{DECK_ID:"B02",ID:"B02166",N:"<div class=\"center\">en endring <br>endringen <br>endringer <br>endringene</div>",E:"<div class=\"center\">a change, an alteration</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">Endring</span> is a bit more \"detached\" in meaning, whereas <span class=\"italic\">forandring</span> would imply a more active involvement and an agent.</div></div>",A:"N"},{DECK_ID:"B02",ID:"B02167",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">et lager</span> (a warehouse, a storage place)</div>",E:"<div class=\"center\">et lager<br>lageret<br>lagre<br>lagrene</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\"><p>Intetkj\xf8nn</span> nouns ending in -ER drop the E in their plural forms and end in -E and -ENE.</p>They used to drop the E also for the definite singular form, but a 2022 updated by <span class=\"italic\">Spr\xe5kr\xe5det</span> has changed this.</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02168",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">et fengsel</span> (a jail)</div>",E:"<div class=\"center\">et fengsel<br>fengselet<br>fengsler<br>fengslene</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Intetkj\xf8nn</span> nouns ending in -EL (in the indefinite singular form) drop the -E for both plural forms.</p>They used to drop the E also for the definite singular form, but a 2022 updated by <span class=\"italic\">Spr\xe5kr\xe5det</span> has changed this.</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02169",N:"<div class=\"center\">et lag <br>laget <br>lag <br>lagene</div>",E:"<div class=\"center\">a team</div>",D:"INTERMEDIATE NOUNS",X:"",A:"N"},{DECK_ID:"B02",ID:"B02170",N:"<div class=\"center\">en samboer <br>samboeren <br>samboere <br>samboerne</div>",E:"<div class=\"center\">a live-in partner</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\">Your <span class=\"italic\">samboer</span> is the boyfriend/girlfriend with whom you live, sharing an accommodation and living costs.</div></div>",A:"N"},{DECK_ID:"B02",ID:"B02171",N:"<div class=\"center\">en fyr <br>fyren <br>fyrer <br>fyrene</div>",E:"<div class=\"center\">a guy, a lighthouse</div>",D:"INTERMEDIATE NOUNS",X:"",A:"N"},{DECK_ID:"B02",ID:"B02172",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">et filter</span> (a filter)</div>",E:"<div class=\"center\">et filter<br>filteret<br>filtre<br>filtrene</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\"><p>Intetkj\xf8nn</span> nouns ending in -ER drop the E in their plural forms and end in -E and -ENE.</p>They used to drop the E also for the definite singular form, but a 2022 updated by <span class=\"italic\">Spr\xe5kr\xe5det</span> has changed this.</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02173",N:"<div class=\"center\">(et) politi <br>politiet</div>",E:"<div class=\"center\">the police</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\">Used predominantly in singular</div>",A:"N"},{DECK_ID:"B02",ID:"B02174",N:"<div class=\"center\">en prat <br>praten <br>prater <br>pratene</div>",E:"<div class=\"center\">a chat</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Kan vi ta en prat?</span></p>Can we have a chat?</div></div>",A:"N"},{DECK_ID:"B02",ID:"B02175",N:"<div class=\"center\">en skyld <br>skylden <br>skylder <br>skyldene</div>",E:"<div class=\"center\">a fault, a sake</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Det var ikke min skyld</span><br>It wasn't my fault</p><span class=\"italic\">Det gj\xf8r vi for sikkerhets skyld</span><br>We do that for the sake of safety</div></div>",A:"N"},{DECK_ID:"B02",ID:"B02176",N:"<div class=\"center\">en herre <br>herren <br>herrer <br>herrene</div>",E:"<div class=\"center\">a gentlemen, a lord, mr.</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>Note that it's used without the final E before a surname, although its use is very formal:</p><span class=\"italic\">Herr Svanevik er i ferd med \xe5 komme</span></div></div>",A:"N"},{DECK_ID:"B02",ID:"B02177",N:"<div class=\"center\">ei kone <br>kona <br>koner <br>konene</div>",E:"<div class=\"center\">a wife</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\">Strong preference for feminine use</div>",A:"N"},{DECK_ID:"B02",ID:"B02178",N:"<div class=\"center\">en kompis <br>kompisen <br>kompiser <br>kompisene</div>",E:"<div class=\"center\">a mate, a friend</div>",D:"INTERMEDIATE NOUNS",X:"",A:"N"},{DECK_ID:"B02",ID:"B02179",N:"<div class=\"center\">et selskap <br>selskapet <br>selskap <br>selskapene</div>",E:"<div class=\"center\">company, a company (i.e. a business)</div>",D:"INTERMEDIATE NOUNS",X:"",A:"N"},{DECK_ID:"B02",ID:"B02180",N:"<div class=\"center\">ei avis <br>avisa <br>aviser <br>avisene</div>",E:"<div class=\"center\">a newspaper</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\">Often used in feminine, although the masculine form cannot be considered incorrect.</div></div>",A:"N"},{DECK_ID:"B02",ID:"B02181",N:"<div class=\"center\">ei greie <br>greia <br>greier <br>greiene</div>",E:"<div class=\"center\">a thing, stuff</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\">Jeg vil helst glemme hele greia</div>",A:"N"},{DECK_ID:"B02",ID:"B02182",N:"<div class=\"center\">(en) natur <br>naturen</div>",E:"<div class=\"center\">nature</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\">Used predominantly in singular</div>",A:"N"},{DECK_ID:"B02",ID:"B02183",N:"<div class=\"center\">(et) hum\xf8r <br>hum\xf8ret</div>",E:"<div class=\"center\">mood</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\">Used predominantly in singular</div>",A:"N"},{DECK_ID:"B02",ID:"B02184",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">et offer</span> (a victim)</div>",E:"<div class=\"center\">et offer<br>offeret<br>ofre<br>ofrene</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\">Some <span class=\"italic\">intetkj\xf8nn</span> nouns ending in -ER drop one of the double consonants and the E for the plural forms.</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02185",N:"<div class=\"center\">(en) fred <br>freden</div>",E:"<div class=\"center\">peace</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\">Used predominantly in singular</div>",A:"N"},{DECK_ID:"B02",ID:"B02186",N:"<div class=\"center\">(en) bruk <br>bruken</div>",E:"<div class=\"center\">a use, a utilisation</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>It also means \"a farm\" when in <span class=\"italic\">intetkj\xf8nn</span></p><p>Often used in the indefinite form in certain expressions:</p><span class=\"italic\">\xe5 gj\xf8re bruk av, \xe5 ha bruk for</span></div></div>",A:"N"},{DECK_ID:"B02",ID:"B02187",N:"<div class=\"center\">en tur (p\xe5) <br>turen <br>turer <br>turene</div>",E:"<div class=\"center\">a trip (to), a walk (to)</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>Jeg likte v\xe5r lange tur p\xe5 fjellet</p>Ut p\xe5 tur, aldri sur!</div></div>",A:"N"},{DECK_ID:"B02",ID:"B02188",N:"<div class=\"center\">en reise <br>reisen <br>reiser <br>reisene</div>",E:"<div class=\"center\">a journey</div>",D:"INTERMEDIATE NOUNS",X:"",A:"N"},{DECK_ID:"B02",ID:"B02189",N:"<div class=\"center\">et m\xf8te <br>m\xf8tet <br>m\xf8ter <br>m\xf8tene</div>",E:"<div class=\"center\">a meeting</div>",D:"INTERMEDIATE NOUNS",X:"",A:"N"},{DECK_ID:"B02",ID:"B02190",N:"<div class=\"center\">en samtale <br>samtalen <br>samtaler <br>samtalene</div>",E:"<div class=\"center\">a conversation</div>",D:"INTERMEDIATE NOUNS",X:"",A:"N"},{DECK_ID:"B02",ID:"B02191",N:"<div class=\"center\">en tanke (om) <br>tanken <br>tanker <br>tankene</div>",E:"<div class=\"center\">a thought (about)</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\">Har du hatt en tanke om hva du vil ha til middag?</div></div>",A:"N"},{DECK_ID:"B02",ID:"B02192",N:"<div class=\"center\">en mulighet (for) <br>muligheten <br>muligheter <br>mulighetene</div>",E:"<div class=\"center\">a possibility (to)</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">En mulighet for \xe5 endre noe</span></p>The use with <span class=\"italic\">for</span> is a bit more about the present, <span class=\"italic\">til</span> can be used when hinting more to future possibilities.</div></div>",A:"N"},{DECK_ID:"B02",ID:"B02193",N:"<div class=\"center\">kl\xe6r, kl\xe6rne</div>",E:"<div class=\"center\">clothes</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\">Plural only</div>",A:"N"},{DECK_ID:"B02",ID:"B02194",N:"<div class=\"center\">en n\xf8d, n\xf8den</div>",E:"<div class=\"center\">an emergency</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>Mostly used as singular and often in agglutination:</p><span class=\"italic\">en n\xf8dsituasjon</span></div></div>",A:"N"},{DECK_ID:"B02",ID:"B02195",N:"<div class=\"center\">(p\xe5) en bunn <br>bunnen <br>bunner <br>bunnene</div>",E:"<div class=\"center\">(at) a bottom, (on) the inside</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Han er faktisk god p\xe5 bunnen</span></p>He is actually good down inside</div></div>",A:"N"},{DECK_ID:"B02",ID:"B02196",N:"<div class=\"center\">et lys <br>lyset <br>lys <br>lysene</div>",E:"<div class=\"center\">a light</div>",D:"INTERMEDIATE NOUNS",X:"",A:"N"},{DECK_ID:"B02",ID:"B02197",N:"<div class=\"center\">en konge (av) <br>kongen <br>konger <br>kongene</div>",E:"<div class=\"center\">a king (of)</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\">Kongen av Norge</div>",A:"N"},{DECK_ID:"B02",ID:"B02198",N:"<div class=\"center\">en myndighet <br>myndigheten <br>myndigheter <br>myndighetene</div>",E:"<div class=\"center\">an authority</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\">Ministeren lovet hjelp fra norske myndigheter</div></div>",A:"N"},{DECK_ID:"B02",ID:"B02199",N:"<div class=\"center\">et valg <br>valget <br>valg <br>valgene</div>",E:"<div class=\"center\">a choice, an election</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\">Vi har et valg mellom to ting</div>",A:"N"},{DECK_ID:"B02",ID:"B02200",N:"<div class=\"center\">(en) frihet (til) <br>friheten</div>",E:"<div class=\"center\">a freedom (to)</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>Used predominantly in singular</p><span class=\"italic\">Vi trenger friheten til \xe5 velge</span></div></div>",A:"N"},{DECK_ID:"B02",ID:"B02201",N:"<div class=\"center\">en krig (mellom) <br>krigen <br>kriger <br>krigene</div>",E:"<div class=\"center\">a war (between)</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\">En krig mellom to land</div>",A:"N"},{DECK_ID:"B02",ID:"B02202",N:"<div class=\"center\">(p\xe5) en topp <br>toppen <br>topper <br>toppene</div>",E:"<div class=\"center\">(at) a top</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\"><p>P\xe5 toppen av fjellet</p></span><p>Also used in figures of speech:</p><span class=\"italic\">Det er bare toppen!</span><br>That's the best! / That's so cool!</div></div>",A:"N"},{DECK_ID:"B02",ID:"B02203",N:"<div class=\"center\">en forklaring (p\xe5) <br>forklaringen <br>forklaringer <br>forklaringene</div>",E:"<div class=\"center\">an explanation (on/of)</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Vi fikk en forklaring p\xe5 mysteriet</span></p>The nouns ending in -ING can also be used in feminine, especially when speaking, just like the ones ending in -NING.</div></div>",A:"N"},{DECK_ID:"B02",ID:"B02204",N:"<div class=\"center\">(en) tvil (om) <br>tvilen</div>",E:"<div class=\"center\">a doubt (about)</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>Mostly used in singular as an uncountable thing:</p><span class=\"italic\">Jeg er i tvil om partneren min er tro</span></div></div>",A:"N"},{DECK_ID:"B02",ID:"B02205",N:"<div class=\"center\">en l\xf8gn <br>l\xf8gnen <br>l\xf8gner <br>l\xf8gnene</div>",E:"<div class=\"center\">a lie</div>",D:"INTERMEDIATE NOUNS",X:"",A:"N"},{DECK_ID:"B02",ID:"B02206",N:"<div class=\"center\">en farge <br>fargen <br>farger <br>fargene</div>",E:"<div class=\"center\">a colour</div>",D:"INTERMEDIATE NOUNS",X:"",A:"N"},{DECK_ID:"B02",ID:"B02207",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">et m\xf8nster</span> (a pattern)</div>",E:"<div class=\"center\">et m\xf8nster<br>m\xf8nsteret<br>m\xf8nstre<br>m\xf8nstrene</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\"><p>Intetkj\xf8nn</span> nouns ending in -ER drop the E in their plural forms and end in -E and -ENE.</p>They used to drop the E also for the definite singular form, but a 2022 updated by <span class=\"italic\">Spr\xe5kr\xe5det</span> has changed this.</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02208",N:"<div class=\"center\">en sannhet <br>sannheten <br>sannheter <br>sannhetene</div>",E:"<div class=\"center\">a truth</div>",D:"INTERMEDIATE NOUNS",X:"",A:"N"},{DECK_ID:"B02",ID:"B02209",N:"<div class=\"center\"><p>List the four forms for:</p><span class=\"italic\">et aktivum</span> (an asset)</div>",E:"<div class=\"center\">et aktivum<br>aktivumet<br>aktivum/aktivumer<br>aktivuma/aktivumene</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\"><p>Nouns ending in -UM come from Latin and are all <span class=\"italic\">intetkj\xf8nn</span>.</p>They may have less used forms, different from those shown, and when referring to financial accounting, the plural forms are <span class=\"italic\">aktiva, aktivaene</span>.</div></div>",A:"E"},{DECK_ID:"B02",ID:"B02210",N:"<div class=\"center\">en \xe5rsak (til) <br>\xe5rsaken <br>\xe5rsaker <br>\xe5rsakene</div>",E:"<div class=\"center\">a cause (of)</div>",D:"INTERMEDIATE NOUNS",X:"<div class=\"center\"><div class=\"left\">Dette er den vanlige \xe5rsaken til hjerteinfarkt</div></div>",A:"N"},{DECK_ID:"B03",ID:"B03001",N:"<div class=\"center\"><p>Translate using articles correctly:</p>Prices are rising</div>",E:"<div class=\"center\">Prisene stiger</div>",D:"ARTICLES & GENITIVE",X:"<div class=\"center\"><div class=\"left\">Abstract nouns used generically require the definite form in Norwegian.</div></div>",A:"E"},{DECK_ID:"B03",ID:"B03002",N:"<div class=\"center\"><p>Translate using the genitive correctly:</p>Sindre's car</div>",E:"<div class=\"center\">Sindres bil</div>",D:"ARTICLES & GENITIVE",X:"<div class=\"center\"><div class=\"left\">Norwegian has a genitive just like English.<br>It does not require an apostrophe.</div></div>",A:"E"},{DECK_ID:"B03",ID:"B03003",N:"<div class=\"center\"><p>Translate using articles correctly:</p>Alberto is a Spaniard</div>",E:"<div class=\"center\">Alberto er spanier</div>",D:"ARTICLES & GENITIVE",X:"<div class=\"center\"><div class=\"left\">Words describing a person's origins, culture, profession, creed, age etc do not require any article in Norwegian.</div></div>",A:"E"},{DECK_ID:"B03",ID:"B03004",N:"<div class=\"center\"><p>Translate using the genitive correctly:</p>Lars' bike</div>",E:"<div class=\"center\">Lars' sykkel</div>",D:"ARTICLES & GENITIVE",X:"<div class=\"center\"><div class=\"left\"><p>Nouns ending in S and other sibilant sounds add an apostrophe in order to express the genitive.</p>In these situations, it is advisable to pronounce the apostrophe as [ &#601;s ], as you would in English.</div></div>",A:"E"},{DECK_ID:"B03",ID:"B03005",N:"<div class=\"center\"><p>Translate using articles correctly:</p>I play the piano</div>",E:"<div class=\"center\">Jeg spiller piano</div>",D:"ARTICLES & GENITIVE",X:"<div class=\"center\"><div class=\"left\">Generic use of instruments or appliances requires the indefinite form (and no article) in Norwegian.</div></div>",A:"E"},{DECK_ID:"B03",ID:"B03006",N:"<div class=\"center\"><p>Translate using articles correctly:</p>So is life</div>",E:"<div class=\"center\">S\xe5nn er livet</div>",D:"ARTICLES & GENITIVE",X:"<div class=\"center\"><div class=\"left\">Abstract nouns used generically require the definite form in Norwegian.</div></div>",A:"E"},{DECK_ID:"B03",ID:"B03007",N:"<div class=\"center\"><p>Translate using the genitive correctly:</p>Norway's capital</div>",E:"<div class=\"center\">Norges hovedstad</div>",D:"ARTICLES & GENITIVE",X:"<div class=\"center\"><div class=\"left\">The genitive is routinely used for objects too.</div></div>",A:"E"},{DECK_ID:"B03",ID:"B03008",N:"<div class=\"center\"><p>Translate using articles correctly:</p>She doesn't have a car</div>",E:"<div class=\"center\">Hun har ikke bil</div>",D:"ARTICLES & GENITIVE",X:"<div class=\"center\"><div class=\"left\">Countable nouns used in a generic sense do not require any article in Norwegian.</div></div>",A:"E"},{DECK_ID:"B03",ID:"B03009",N:"<div class=\"center\"><p>Translate using articles correctly:</p>Picture of the year</div>",E:"<div class=\"center\">\xc5rets bilde</div>",D:"ARTICLES & GENITIVE",X:"<div class=\"center\"><div class=\"left\">The genitive is often tied to specific periods of time.</div></div>",A:"E"},{DECK_ID:"B03",ID:"B03010",N:"<div class=\"center\"><p>Translate using articles correctly:</p>Time flies</div>",E:"<div class=\"center\">Tiden flyr</div>",D:"ARTICLES & GENITIVE",X:"<div class=\"center\"><div class=\"left\">Abstract nouns used generically require the definite form in Norwegian.</div></div>",A:"E"},{DECK_ID:"B03",ID:"B03011",N:"<div class=\"center\"><p>Translate using articles correctly:</p>Nils is a teacher</div>",E:"<div class=\"center\">Nils er l\xe6rer</div>",D:"ARTICLES & GENITIVE",X:"<div class=\"center\"><div class=\"left\">Words describing a person's origins, culture, profession, creed, age etc do not require any article in Norwegian.</div></div>",A:"E"},{DECK_ID:"B03",ID:"B03012",N:"<div class=\"center\"><p>Translate using articles correctly:</p>We are watching TV</div>",E:"<div class=\"center\">Vi ser p\xe5 TV</div>",D:"ARTICLES & GENITIVE",X:"<div class=\"center\"><div class=\"left\">Generic use of instruments or appliances requires the indefinite form (and no article) in Norwegian.</div></div>",A:"E"},{DECK_ID:"B03",ID:"B03013",N:"<div class=\"center\"><p>Translate using the genitive correctly:</p>Today's lunch</div>",E:"<div class=\"center\">Dagens lunsj</div>",D:"ARTICLES & GENITIVE",X:"<div class=\"center\"><div class=\"left\">The genitive is often tied to specific periods of time.</div></div>",A:"E"},{DECK_ID:"B03",ID:"B03014",N:"<div class=\"center\"><p>Translate using articles correctly:</p>Eva is in town</div>",E:"<div class=\"center\">Eva er i byen</div>",D:"ARTICLES & GENITIVE",X:"<div class=\"center\"><div class=\"left\">Generic locations require the definite form in Norwegian.</div></div>",A:"E"},{DECK_ID:"B03",ID:"B03015",N:"<div class=\"center\"><p>Translate using articles correctly:</p>Idris is a muslim</div>",E:"<div class=\"center\">Idris er muslim</div>",D:"ARTICLES & GENITIVE",X:"<div class=\"center\"><div class=\"left\">Words describing a person's origins, culture, profession, creed, age etc do not require any article in Norwegian.</div></div>",A:"E"},{DECK_ID:"B03",ID:"B03016",N:"<div class=\"center\"><p>Translate using the genitive correctly:</p>Siv and H\xe5kon's cat</div>",E:"<div class=\"center\">Siv og H\xe5kons katt</div>",D:"ARTICLES & GENITIVE",X:"<div class=\"center\"><div class=\"left\">When stating multiple owners, the genitive is preferably put only on the last one of the list.</div></div>",A:"E"},{DECK_ID:"B03",ID:"B03017",N:"<div class=\"center\"><p>Translate using articles correctly:</p>The European Union</div>",E:"<div class=\"center\">Den europeiske union</div>",D:"ARTICLES & GENITIVE",X:"<div class=\"center\"><div class=\"left\">Names with an adjective and referring to a specific entity keep the noun in the indefinite form.<br>Moreover, only the determiner <span class=\"italic\">den/det, de</span> has the upper case initial.</div></div>",A:"E"},{DECK_ID:"B03",ID:"B03018",N:"<div class=\"center\"><p>Translate using the genitive correctly:</p>A three-month notice</div>",E:"<div class=\"center\">En tre m\xe5neders frist</div>",D:"ARTICLES & GENITIVE",X:"<div class=\"center\"><div class=\"left\"><p>Time can also be expressed with the genitive.</p>If you want to use a number, a hyphen is required:<p><span class=\"italic\">En 3-m\xe5naders frist</span></p></div></div>",A:"E"},{DECK_ID:"B03",ID:"B03019",N:"<div class=\"center\"><p>Translate using articles correctly:</p>Frode is a social-democrat</div>",E:"<div class=\"center\">Frode er sosialdemokrat</div>",D:"ARTICLES & GENITIVE",X:"<div class=\"center\"><div class=\"left\">Words describing a person's origins, culture, profession, creed, age etc do not require any article in Norwegian.</div></div>",A:"E"},{DECK_ID:"B03",ID:"B03020",N:"<div class=\"center\"><p>Translate using articles correctly:</p>The United Nations</div>",E:"<div class=\"center\">De forente nasjoner</div>",D:"ARTICLES & GENITIVE",X:"<div class=\"center\"><div class=\"left\">Names with an adjective and referring to a specific entity keep the noun in the indefinite form.<br>Moreover, only the determiner <span class=\"italic\">den/det, de</span> has the upper case initial.</div></div>",A:"E"},{DECK_ID:"B03",ID:"B03021",N:"<div class=\"center\"><p>Translate using the genitive correctly:</p>A two week holiday</div>",E:"<div class=\"center\">En to ukers ferie</div>",D:"ARTICLES & GENITIVE",X:"<div class=\"center\"><div class=\"left\">Time can also be expressed with the genitive.</div></div>",A:"E"},{DECK_ID:"B03",ID:"B03022",N:"<div class=\"center\"><p>Translate using articles correctly:</p>She listens to the radio</div>",E:"<div class=\"center\"><p>Hun h\xf8rer p\xe5 radio</p>Hun lytter til radio</div>",D:"ARTICLES & GENITIVE",X:"<div class=\"center\"><div class=\"left\">Generic use of instruments or appliances requires the indefinite form (and no article) in Norwegian.</div></div>",A:"E"},{DECK_ID:"B03",ID:"B03023",N:"<div class=\"center\"><p>Translate using articles correctly:</p>When I was a child</div>",E:"<div class=\"center\">Da jeg var barn</div>",D:"ARTICLES & GENITIVE",X:"<div class=\"center\"><div class=\"left\">Words describing a person's origins, culture, profession, creed, age etc do not require any article in Norwegian.</div></div>",A:"E"},{DECK_ID:"B03",ID:"B03024",N:"<div class=\"center\"><p>Translate using articles correctly:</p>They're expecting a child and seeking a flat</div>",E:"<div class=\"center\">De venter barn og leter etter leilighet</div>",D:"ARTICLES & GENITIVE",X:"<div class=\"center\"><div class=\"left\">Countable nouns used in a generic sense do not require any article in Norwegian.</div></div>",A:"E"},{DECK_ID:"B03",ID:"B03025",N:"<div class=\"center\"><p>Translate using articles correctly:</p>The United Arab Emirates</div>",E:"<div class=\"center\">De forente arabiske emirater</div>",D:"ARTICLES & GENITIVE",X:"<div class=\"center\"><div class=\"left\">Names with an adjective and referring to a specific entity keep the noun in the indefinite form.<br>Moreover, only the determiner <span class=\"italic\">den/det, de</span> has the upper case initial.</div></div>",A:"E"},{DECK_ID:"B04",ID:"B04001",N:"<div class=\"center\"><div class=\"left\">What are the main forms of a Norwegian verb, the so called <b class=\"bold\">paradigm</b>?</div></div>",E:"<div class=\"center\"><div class=\"left\">The main forms are <span class=\"italic\">infinitiv</span> (infinitive), <span class=\"italic\">presens</span> (present), <span class=\"italic\">preteritum</span> (simple past) and <span class=\"italic\">presens perfektum</span> (present perfect).</div></div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p>Example for the verb <span class=\"italic\">\xe5 f\xe5</span> (to get):</p><p><span class=\"italic\">\xe5 f\xe5, f\xe5r, fikk, har f\xe5tt</span></p>Note that the present needs to be specified because, unlike in English, it's not just the bare infinitive.</div></div>",A:"X"},{DECK_ID:"B04",ID:"B04002",N:"<div class=\"center\"><div class=\"left\">What are <b class=\"bold\">strong verbs</b> and <b class=\"bold green\">weak verbs</b> in Norwegian?</div></div>",E:"<div class=\"center\"><div class=\"left\"><p><b class=\"bold\">Strong</b> verbs are verbs whose various forms change in <b class=\"bold\">irregular</b> ways.</p><b class=\"bold green\">Weak</b> verbs are verbs that change following one of four <b class=\"bold green\">patterns</b> (more on this soon).</div></div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p>Example of strong verb, \"to drink, drank, drunk\":<br><span class=\"italic\">\xe5 drikke, drikker, drakk, har drukket</span></p>Example of weak verb, \"to like, liked, liked\":<br><span class=\"italic\">\xe5 like, liker, likte, har likt</span></div></div>",A:"X"},{DECK_ID:"B04",ID:"B04003",N:"<div class=\"center\">\xe5 kunne<br>kan<br>kunne<br>har kunnet</div>",E:"<div class=\"center\">can</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\">Jeg kan snakke litt norsk</div>",A:"N"},{DECK_ID:"B04",ID:"B04004",N:"<div class=\"center\"><div class=\"left\">How can you identify the <b class=\"bold\">weak verbs</b> of the <b class=\"bold\">first pattern</b>?</div></div>",E:"<div class=\"center\"><div class=\"left\"><p>The stem (i.e. the infinitive minus the E at the end) usually ends in <b class=\"bold\">two consonants</b>.</p>Loan-word verbs follow this pattern too.</div></div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p>\xe5 kaste, kast<b class=\"bold\">er</b>, kast<b class=\"bold\">et</b>, har kast<b class=\"bold\">et</b></p>\xe5 elske, elsk<b class=\"bold\">er</b>, elsk<b class=\"bold\">et</b>, har elsk<b class=\"bold\">et</b></div></div>",A:"X"},{DECK_ID:"B04",ID:"B04005",N:"<div class=\"center\"><div class=\"left\">How can you identify the <b class=\"bold\">weak verbs</b> of the <b class=\"bold\">second pattern</b>?</div></div>",E:"<div class=\"center\"><div class=\"left\">The stem (i.e. the infinitive minus the E at the end) usually ends in a <b class=\"bold\">long vowel</b> followed by a <b class=\"bold\">single consonant</b>. <br>Alternatively the stem ends in -LD, -ND, -LL, -MM, -NN.</div></div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p>\xe5 glemme, glemm<b class=\"bold\">er</b>, glem<b class=\"bold\">te</b>, har glem<b class=\"bold\">t</b></p><p>\xe5 bestille, bestill<b class=\"bold\">er</b>, bestil<b class=\"bold\">te</b>, har bestil<b class=\"bold\">t</b></p>\xe5 melde, meld<b class=\"bold\">er</b>, meld<b class=\"bold\">te</b>, har meld<b class=\"bold\">t</b></div></div>",A:"X"},{DECK_ID:"B04",ID:"B04006",N:"<div class=\"center\">\xe5 m\xe5tte<br>m\xe5<br>m\xe5tte<br>har m\xe5ttet</div>",E:"<div class=\"center\">must/have to</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\">Jeg m\xe5 spise n\xe5</div>",A:"N"},{DECK_ID:"B04",ID:"B04007",N:"<div class=\"center\">\xe5 ville<br>vil<br>ville<br>har villet</div>",E:"<div class=\"center\">to want (to), will</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p>Used as \"to want\":<br><span class=\"italic\">Vil du ha et glass vin?</span></p>Used as \"will\":<br><span class=\"italic\">Det vil bli mange folk p\xe5 m\xf8te</span></div></div>",A:"N"},{DECK_ID:"B04",ID:"B04008",N:"<div class=\"center\">\xe5 skulle<br>skal<br>skulle<br>har skullet</div>",E:"<div class=\"center\">shall, will</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><p>Skal vi dra?</p>Hun skulle hjelpe meg</div>",A:"N"},{DECK_ID:"B04",ID:"B04009",N:"<div class=\"center\"><div class=\"left\">How can you identify the <b class=\"bold\">weak verbs</b> of the <b class=\"bold\">third pattern</b>?</div></div>",E:"<div class=\"center\"><div class=\"left\">The stem (i.e. the infinitive minus the E at the end) usually ends in <b class=\"bold\">-G, -V or two vowels</b>.</div></div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p>\xe5 pr\xf8ve, pr\xf8v<b class=\"bold\">er</b>, pr\xf8v<b class=\"bold\">de</b>, har pr\xf8v<b class=\"bold\">d</b></p><p>\xe5 bygge, bygg<b class=\"bold\">er</b>, byg<b class=\"bold\">de</b>, har byg<b class=\"bold\">d</b></p>\xe5 greie, grei<b class=\"bold\">er</b>, grei<b class=\"bold\">de</b>, har grei<b class=\"bold\">d</b></div></div>",A:"X"},{DECK_ID:"B04",ID:"B04010",N:"<div class=\"center\"><div class=\"left\">How can you identify the <b class=\"bold\">weak verbs</b> of the <b class=\"bold\">fourth pattern</b>?</div></div>",E:"<div class=\"center\"><div class=\"left\">They are mostly monosyllabic, so the stem ends in a <b class=\"bold\">stressed vowel</b>.</div></div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p>\xe5 bo, bo<b class=\"bold\">r</b>, bo<b class=\"bold\">dde</b>, har bo<b class=\"bold\">dd</b></p>\xe5 skje, skje<b class=\"bold\">r</b>, skje<b class=\"bold\">dde</b>, har skje<b class=\"bold\">dd</b></div></div>",A:"X"},{DECK_ID:"B04",ID:"B04011",N:"<div class=\"center\"><p>Translate using the correct verb tense:</p>I eat dinner before 8 pm</div>",E:"<div class=\"center\">Jeg spiser middag f\xf8r \xe5tte p\xe5 kvelden</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">The present tense <span class=\"italic\">(presens)</span> usually adds an -R to the infinitive.</div></div>",A:"E"},{DECK_ID:"B04",ID:"B04012",N:"<div class=\"center\"><p>Translate using the correct verb tense:</p>I am eating dinner now</div>",E:"<div class=\"center\">Jeg spiser middag n\xe5</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">There is no present progressive form (e.g. \"I am eating\") in Norwegian, you must use the <span class=\"italic\">presens</span> instead.</div></div>",A:"E"},{DECK_ID:"B04",ID:"B04013",N:"<div class=\"center\">\xe5 tore<br>t\xf8r<br>turte<br>har turt</div>",E:"<div class=\"center\">to dare (to)</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Hun turte ikke svare</span></p>The <span class=\"italic\">preteritum</span> can also be spelt as <span class=\"italic\">torde</span>, the <span class=\"italic\">presens perfektum</span> as <span class=\"italic\">har tort</span>.</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04014",N:"<div class=\"center\"><p>Translate using the correct verb tense:</p>Egil was in Bergen on Tuesday</div>",E:"<div class=\"center\">Egil var i Bergen p\xe5 tirsdag</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p>The simple past <span class=\"italic\">(preteritum)</span> works very much like in English.</p>It is used for actions which were <b class=\"bold\">completed in the past</b> or that we want to link to a particular time in the past.</div></div>",A:"E"},{DECK_ID:"B04",ID:"B04015",N:"<div class=\"center\"><p>Translate using the correct verb tense:</p>She was walking slowly</div>",E:"<div class=\"center\">Hun gikk langsomt</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">There is no past progressive form (e.g. \"she was walking\") in Norwegian, you must use the <span class=\"italic\">preteritum</span> instead.</div></div>",A:"E"},{DECK_ID:"B04",ID:"B04016",N:"<div class=\"center\"><p>Translate using the correct verb tense:</p>We have been married for five years</div>",E:"<div class=\"center\">Vi har v\xe6rt gift i fem \xe5r</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">The present perfect <span class=\"italic\">(presens perfektum)</span> works very much like in English, using <span class=\"italic\">har</span> and the <span class=\"italic\">perfektum partisipp</span> of the verb.<br>It is used for <b class=\"bold\">actions which started in the past but that continue</b> (or whose implications continue) up to the present.</div></div>",A:"E"},{DECK_ID:"B04",ID:"B04017",N:"<div class=\"center\">\xe5 pleie<br>pleier<br>pleide<br>har pleid</div>",E:"<div class=\"center\">to use (to)</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p>The use of this verb is more restricted than its English equivalent, as it can be used only for actual instances and episodes (i.e. cannot be used over generic periods of time):</p><span class=\"italic\">Han pleide \xe5 spille tennis her</span></div></div>",A:"N"},{DECK_ID:"B04",ID:"B04018",N:"<div class=\"center\"><p>Translate using verbs correctly:</p><p>We let him go</p>(consider \"let\" to be in the past)</div>",E:"<div class=\"center\">Vi lot ham g\xe5</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p>The verb <span class=\"italic\">\xe5 la</span> (to let) supports the bare infinitive (i.e. infinitive without <span class=\"italic\">\xe5</span>).<br>Its paradigm is:</p><span class=\"italic\">\xe5 la, lar, lot, har latt</span></div></div>",A:"E"},{DECK_ID:"B04",ID:"B04019",N:"<div class=\"center\"><p>Translate using the correct verb tense:</p>I will go out this evening</div>",E:"<div class=\"center\">Jeg skal g\xe5 ut i kveld</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">The future (<span class=\"italic\">presens futurum</span>) with <span class=\"italic\">skal</span> is used for <b class=\"bold\">something that can be controlled and decided on</b>, such as a plan or an intention.</div></div>",A:"E"},{DECK_ID:"B04",ID:"B04020",N:"<div class=\"center\"><p>Translate using the correct verb tense:</p>It will be difficult to carry that out</div>",E:"<div class=\"center\">Det vil bli vanskelig \xe5 gjennomf\xf8re det</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">The future (<span class=\"italic\">presens futurum</span>) with <span class=\"italic\">vil</span> is used for <b class=\"bold\">something that will happen without interventions and/or no matter what</b>. It's quite high in register and doesn't quite overlap with \"will\".<br>In fact, remember that <span class=\"italic\">vil</span> usually translates \"want\" in English, which of course indicates a desire or a wish.</div></div>",A:"E"},{DECK_ID:"B04",ID:"B04021",N:"<div class=\"center\"><p>Translate using the correct verb tense:</p>Siv is going to ring you this evening</div>",E:"<div class=\"center\">Siv kommer til \xe5 ringe deg i kveld</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">The future with <span class=\"italic\">kommer til \xe5</span> represents a <b class=\"bold\">slightly informal tone</b>, often used instead of the future with <span class=\"italic\">vil</span> in spoken language.<br>It is also used <b class=\"bold\">for an event which is quite likely, but outside of our influence</b>.</div></div>",A:"E"},{DECK_ID:"B04",ID:"B04022",N:"<div class=\"center\">\xe5 st\xe5<br>st\xe5r<br>sto(d)<br>har st\xe5tt</div>",E:"<div class=\"center\">to stand</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p>This verb is also used to indicate an upright position:</p><p><span class=\"italic\">Flaska st\xe5r p\xe5 bordet</span></p>Also, <span class=\"italic\">\xe5 st\xe5 opp</span> means \"to get out of bed\", whereas <span class=\"italic\">\xe5 reise seg</span> means \"to stand up (from a sitting position)\".</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04023",N:"<div class=\"center\">\xe5 ligge<br>ligger<br>l\xe5<br>har ligget</div>",E:"<div class=\"center\">to lie, to be (in a place)</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p>This verb is often used with the meaning of \"to be (in a place)\" or to indicate a horizontal position.<br>This verb does not support an object (unlike <span class=\"italic\">\xe5 legge</span>):</p><span class=\"italic\"><p>Stavanger ligger p\xe5 Vestlandet</p>Katten ligger p\xe5 sofaen</span></div></div>",A:"N"},{DECK_ID:"B04",ID:"B04024",N:"<div class=\"center\">\xe5 sette<br>setter<br>satte<br>har satt</div>",E:"<div class=\"center\">to put, to set</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p>This verb is used to indicate the act of placing something upright:</p><p><span class=\"italic\">Jeg har satt vasen p\xe5 gulvet</span></p>Do not mistake this verb with <span class=\"italic\">\xe5 sitte, sitter, satt, har sittet</span> (to sit).</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04025",N:"<div class=\"center\">\xe5 legge<br>legger<br>la<br>har lagt</div>",E:"<div class=\"center\">to lay, to put down</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p>This is the verb used to indicate the act of placing something horizontally, so it requires an object.</p>When used with object pronouns (e.g. <span class=\"italic\">meg, deg, seg</span> etc.), this verb means \"to go to bed\".</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04026",N:"<div class=\"center\"><p>Translate using the correct verb tense:</p>I had prepared dinner before Erlend arrived</div>",E:"<div class=\"center\">Jeg hadde lagd middag f\xf8r Erlend kom</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">The past perfect (<span class=\"italic\">preteritum perfektum</span>) is used to indicate an <b class=\"bold\">event that has taken place before another</b>, more recent, past event.</div></div>",A:"E"},{DECK_ID:"B04",ID:"B04027",N:"<div class=\"center\"><p>Translate using the correct verb tense:</p>I got the job after I had learned Norwegian</div>",E:"<div class=\"center\">Jeg fikk jobben etter at jeg hadde l\xe6rt norsk</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">The past perfect (<span class=\"italic\">preteritum perfektum</span>) is used to indicate an <b class=\"bold\">event that has taken place before another</b>, more recent, past event.</div></div>",A:"E"},{DECK_ID:"B04",ID:"B04028",N:"<div class=\"center\">\xe5 l\xe6re<br>l\xe6rer<br>l\xe6rte<br>har l\xe6rt</div>",E:"<div class=\"center\">to learn</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p>This verb can also mean \"to teach\" if there is a clearly stated object or a reflexive pronoun:</p><span class=\"italic\"><p>Maria l\xe6rer norsk til innvandrere</p>Jeg l\xe6rte meg kinesisk</span></div></div>",A:"N"},{DECK_ID:"B04",ID:"B04029",N:"<div class=\"center\">\xe5 forklare<br>forklarer<br>forklarte<br>har forklart</div>",E:"<div class=\"center\">to explain</div>",D:"INTERMEDIATE VERBS",X:"",A:"N"},{DECK_ID:"B04",ID:"B04030",N:"<div class=\"center\">\xe5 oversette<br>oversetter<br>oversatte<br>har oversatt</div>",E:"<div class=\"center\">to translate</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\">Boka ble oversatt til norsk.</div>",A:"N"},{DECK_ID:"B04",ID:"B04031",N:"<div class=\"center\">\xe5 finnes<br>finnes / fins<br>fantes<br>har funnes</div>",E:"<div class=\"center\">to be found/to exist</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p>This is one of the verbs that normally has the -S ending otherwise typical of reflexive or reciprocal forms.<br><span class=\"italic\">\xc5 finnes</span> is used mostly with <span class=\"italic\">det</span>, with the meaning of \"there exist(s)\"):</p><span class=\"italic\">Det finnes ikke en kur</span></div></div>",A:"N"},{DECK_ID:"B04",ID:"B04032",N:"<div class=\"center\"><p>Translate using the correct verb tense:</p>Gro became ill the moment she had come home</div>",E:"<div class=\"center\">Gro ble syk med en gang hun hadde kommet hjem</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">The past perfect (<span class=\"italic\">preteritum perfektum</span>) is used to indicate an <b class=\"bold\">event that has taken place before another</b>, more recent, past event.</div></div>",A:"E"},{DECK_ID:"B04",ID:"B04033",N:"<div class=\"center\"><p>Translate using the correct verb tense:</p>She missed the train but could take the bus</div>",E:"<div class=\"center\">Hun mistet toget, men hun kunne ta bussen</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p>The <span class=\"italic\">preteritum futurum</span> (in this case, <span class=\"italic\">kunne</span>) is used to indicate an <b class=\"bold\">event that will take place after another event in the past</b>.</p>It translates the \"conditional\" and \"subjunctive\" of English and Latin languages.</div></div>",A:"E"},{DECK_ID:"B04",ID:"B04034",N:"<div class=\"center\">\xe5 sp\xf8rre<br>sp\xf8r<br>spurte<br>har spurt</div>",E:"<div class=\"center\">to ask (about something)</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><p>S\xf8stera mi spurte om deg</p>Jeg torde ikke sp\xf8rre</div>",A:"N"},{DECK_ID:"B04",ID:"B04035",N:"<div class=\"center\"><p>Translate using the correct verb tense:</p>She said that I should travel with them</div>",E:"<div class=\"center\">Hun sa at jeg skulle reise med dem</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p>The <span class=\"italic\">preteritum futurum</span> is used to indicate an <b class=\"bold\">event that will take place after another event in the past</b>.</p></div></div>",A:"E"},{DECK_ID:"B04",ID:"B04036",N:"<div class=\"center\">\xe5 be (om)<br>ber<br>ba(d)<br>har bedt</div>",E:"<div class=\"center\">to ask <br>(to do something or to have something)</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Han ba om et glass vann<br>De ba om \xe5 g\xe5 hjem<br>Hun ba meg (om) \xe5 ringe tilbake</span></p>If there is an object (e.g. <span class=\"italic\">meg</span>) straight after <span class=\"italic\">\xe5 be</span>, then <span class=\"italic\">om</span> can be omitted.</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04037",N:"<div class=\"center\">\xe5 stille<br>stiller<br>stilte<br>har stilt</div>",E:"<div class=\"center\">to ask a question<br> to stop, to set</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><p>Du kan vel stille et sp\xf8rsm\xe5l!</p>Legen klarte ikke \xe5 stille blodet</div>",A:"N"},{DECK_ID:"B04",ID:"B04038",N:"<div class=\"center\"><p>Translate using the correct verb tense:</p>We didn't expect that so many would come</div>",E:"<div class=\"center\">Vi forventet ikke at s\xe5 mange ville komme</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p>The <span class=\"italic\">preteritum futurum</span> is used to indicate an <b class=\"bold\">event that will take place after another event in the past</b>.</p>In this tense, <span class=\"italic\">ville</span> can imply a will or a wish.</div></div>",A:"E"},{DECK_ID:"B04",ID:"B04039",N:"<div class=\"center\"><p>Translate using the correct verb tense:</p>It could get difficult</div>",E:"<div class=\"center\">Det kunne bli vanskelig</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">When used with a modal verb such as <span class=\"italic\">kunne</span>, the <span class=\"italic\">preteritum futurum</span> can entail a possibility (similar to the \"conditional\" of other European languages).</div></div>",A:"E"},{DECK_ID:"B04",ID:"B04040",N:"<div class=\"center\"><p>Translate using the correct verb tense:</p>You should write to her</div>",E:"<div class=\"center\">Du burde skrive til henne</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">When used with a modal verb such as <span class=\"italic\">burde</span>, the <span class=\"italic\">preteritum futurum</span> can entail a suggestion (similar to the \"conditional\" of other European languages).</div></div>",A:"E"},{DECK_ID:"B04",ID:"B04041",N:"<div class=\"center\">\xe5 holde p\xe5 med<br>holder<br>holdt<br>har holdt</div>",E:"<div class=\"center\">to be doing<br>(as a general equivalent of the continuous form)</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Jeg holder p\xe5 med \xe5 lese norsk</span></p><p>I am studying Norwegian</p>This construction can be considered a substitute for the continuous forms in -ING that you can find in English.</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04042",N:"<div class=\"center\"><p>Translate using the reflexive/reciprocal verb form:</p>(We) see each other soon!</div>",E:"<div class=\"center\">Vi ses snart!</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">A few Norwegian verbs can add an -S at the end of the bare infinitive to give a reflexive/reciprocal meaning.<br>This happens mostly in present and future tenses.</div></div>",A:"E"},{DECK_ID:"B04",ID:"B04043",N:"<div class=\"center\">\xe5 miste<br>mister<br>mistet<br>har mistet</div>",E:"<div class=\"center\">to lose (i.e. to lose track of something)</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">F\xf8r eller senere mister jeg alltid paraplyen</span></p><span class=\"italic\">\xc5 miste</span> covers losing track of material things (keys, umbrella, passport, banknotes etc) and losing something you had before (feelings, health).</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04044",N:"<div class=\"center\">\xe5 tape<br>taper<br>tapte<br>har tapt</div>",E:"<div class=\"center\">to lose (i.e. the opposite of \"to win\", or a financial loss)</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Hvem vinner og hvem taper?</span></p><span class=\"italic\">\xc5 tape</span> is used in an abstract sense, for losing as in the opposite of winning and for losing money (in a financial sense).</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04045",N:"<div class=\"center\">\xe5 mangle<br>mangler<br>manglet<br>har manglet</div>",E:"<div class=\"center\">to lack, to miss</div>",D:"INTERMEDIATE VERBS",X:"",A:"N"},{DECK_ID:"B04",ID:"B04046",N:"<div class=\"center\">\xe5 savne<br>savner<br>savnet<br>har savnet</div>",E:"<div class=\"center\">to miss (emotionally)</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">The verb \"to miss\" in a concrete sense is <span class=\"italic\">\xe5 mangle</span></div></div>",A:"N"},{DECK_ID:"B04",ID:"B04047",N:"<div class=\"center\">\xe5 koste<br>koster<br>kostet<br>har kostet</div>",E:"<div class=\"center\">to cost<br>(just one item)</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\">Jakka i vinduet koster altfor mye</div>",A:"N"},{DECK_ID:"B04",ID:"B04048",N:"<div class=\"center\">\xe5 bli<br>blir<br>ble<br>har blitt <br>(used for a total)</div>",E:"<div class=\"center\">to cost <br>(the total cost of a few items)</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\">Det blir 345 kroner til sammen</div>",A:"N"},{DECK_ID:"B04",ID:"B04049",N:"<div class=\"center\"><p>Translate using the reflexive/reciprocal verb form:</p>We'll talk (to each other) tomorrow!</div>",E:"<div class=\"center\">Vi snakkes i morgen!</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">A few Norwegian verbs can add an -S at the end of the bare infinitive to give a reflexive/reciprocal meaning.<br>This happens mostly in present and future tenses.</div></div>",A:"E"},{DECK_ID:"B04",ID:"B04050",N:"<div class=\"center\">\xe5 mene<br>mener<br>mente<br>har ment</div>",E:"<div class=\"center\">to mean, to be of an opinion</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p>The verb <span class=\"italic\">\xe5 mene</span> is similar to <span class=\"italic\">\xe5 synes</span> but entails a stronger opinion.</p><p>Note that \"to mean/to signify\" is <span class=\"italic\">\xe5 bety</span> when used for things and not people:</p><span class=\"italic\">Hva betyr ordet \"bunad\"?</span></div></div>",A:"N"},{DECK_ID:"B04",ID:"B04051",N:"<div class=\"center\">\xe5 h\xf8re (p\xe5)<br>h\xf8rer<br>h\xf8rte<br>har h\xf8rt</div>",E:"<div class=\"center\">to hear, (to listen to)</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p>When used without prepositions, it means \"to hear\":<br><span class=\"italic\">H\xf8rer du noe?</span></p>When used with <span class=\"italic\">p\xe5</span>, it means \"to listen to\":<br><span class=\"italic\">H\xf8r p\xe5 meg!</span></div></div>",A:"N"},{DECK_ID:"B04",ID:"B04052",N:"<div class=\"center\">\xe5 lytte (p\xe5/til)<br>lytter<br>lyttet<br>har lyttet</div>",E:"<div class=\"center\">to listen (to)</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p>The preposition <span class=\"italic\">p\xe5</span> can be a bit more concrete, <span class=\"italic\">til</span> can be a bit more abstract (as in \"pay attention to\"):</p><span class=\"italic\"><p>Jeg lytter p\xe5 radioen</p>Politikeren lyttet til folk</span></div></div>",A:"N"},{DECK_ID:"B04",ID:"B04053",N:"<div class=\"center\">\xe5 fortelle<br>forteller<br>fortalte<br>har fortalt</div>",E:"<div class=\"center\">to tell, to recount</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">Using <span class=\"italic\">\xe5 fortelle</span> implies some sort of narrative compared to other verbs such as <span class=\"italic\">\xe5 snakke</span> or <span class=\"italic\">\xe5 si</span>.</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04054",N:"<div class=\"center\"><p>Translate using the reflexive/reciprocal verb form:</p>We can meet (each other) on Thursday</div>",E:"<div class=\"center\">Vi kan m\xf8tes p\xe5 torsdag</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">A few Norwegian verbs can add an -S at the end of the verb to give a reflexive/reciprocal meaning.<br>This happens mostly in present and future tenses.</div></div>",A:"E"},{DECK_ID:"B04",ID:"B04055",N:"<div class=\"center\"><div class=\"left\"><p>Translate using the passive construction with <span class=\"italic\">\xe5 bli</span> and the <span class=\"italic\">perfektum partisipp</span>:</p></div>The cake was eaten by Bente</div>",E:"<div class=\"center\">Kaka ble spist av Bente</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">This is the most used passive form, used especially for the past, for specific events and when the agent is specified.</div></div>",A:"E"},{DECK_ID:"B04",ID:"B04056",N:"<div class=\"center\"><div class=\"left\"><p>Translate using the passive construction with the S at the end of the verb:</p></div>The doors are being closed</div>",E:"<div class=\"center\">D\xf8rene lukkes</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">Used for ongoing, general events (i.e. present tense), for rules or after modal verbs.</div></div>",A:"E"},{DECK_ID:"B04",ID:"B04057",N:"<div class=\"center\"><div class=\"left\"><p>Translate using the passive construction with <span class=\"italic\">\xe5 v\xe6re</span> and the <span class=\"italic\">perfektum partisipp</span>:</p></div>The package is delivered</div>",E:"<div class=\"center\">Pakken er levert</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">Used mostly to highlight the results of the action and not the agent.</div></div>",A:"E"},{DECK_ID:"B04",ID:"B04058",N:"<div class=\"center\">\xe5 pr\xf8ve<br>pr\xf8ver<br>pr\xf8vde<br>har pr\xf8vd</div>",E:"<div class=\"center\">to try</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p>Kan du pr\xf8ve \xe5 gj\xf8re det?</p>Jeg skal pr\xf8ve denne smaken</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04059",N:"<div class=\"center\">\xe5 lykkes<br>lykkes<br>lyktes<br>har lyktes/lykkes</div>",E:"<div class=\"center\">to succeed</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p>This is one of the verbs that normally has the -S ending otherwise typical of reflexive or reciprocal forms.</p><span class=\"italic\">Det er mange grunner til at De Gr\xf8nne har lyktes</span></div></div>",A:"N"},{DECK_ID:"B04",ID:"B04060",N:"<div class=\"center\">\xe5 skrive<br>skriver<br>skrev<br>har skrevet</div>",E:"<div class=\"center\">to write</div>",D:"INTERMEDIATE VERBS",X:"",A:"N"},{DECK_ID:"B04",ID:"B04061",N:"<div class=\"center\">\xe5 lese<br>leser<br>leste<br>har lest</div>",E:"<div class=\"center\">to read, to study</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">Remember that the act of studying (i.e. reading, exercising, writing) is <span class=\"italic\">\xe5 gj\xf8re lekser</span> (i.e. to do homework) whereas <span class=\"italic\">\xe5 studere</span> is about longer term studies or simply being a student.</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04062",N:"<div class=\"center\">\xe5 dele<br>deler<br>delte<br>har delt</div>",E:"<div class=\"center\">to share, to divide</div>",D:"INTERMEDIATE VERBS",X:"",A:"N"},{DECK_ID:"B04",ID:"B04063",N:"<div class=\"center\">\xe5 slutte<br>slutter<br>sluttet<br>har sluttet</div>",E:"<div class=\"center\">to end, to stop, to finish</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p>Note that the prepositional verb <span class=\"italic\">\xe5 avslutte</span> means \"to complete\" and \"to terminate\" (the latter used in IT and user interface contexts).</p>It can also be a formal version of <span class=\"italic\">\xe5 slutte</span>.</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04064",N:"<div class=\"center\">\xe5 leie<br>leier<br>leide<br>har leid</div>",E:"<div class=\"center\">to rent</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">The verb \"to let\" (in the sense of letting property, vehicles etc) is <span class=\"italic\">\xe5 leie ut</span>.</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04065",N:"<div class=\"center\">\xe5 gidde<br>gidder<br>gadd<br>har giddet</div>",E:"<div class=\"center\">to be bothered to, to care</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Jeg gidder ikke st\xe5 i k\xf8 hele natta</p><p>Han gidder ikke endre utseende for \xe5 bli tatt p\xe5 alvor</span></p>This verb can support the bare infinitive (without <span class=\"italic\">\xe5</span>, like modal verbs) or the full infinitive.</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04066",N:"<div class=\"center\">\xe5 orke<br>orker<br>orket<br>har orket</div>",E:"<div class=\"center\">to stand, to have the energy (to)</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Jeg orker ikke g\xe5 p\xe5 skolen i dag!</span></p>This verb can support the bare infinitive (without <span class=\"italic\">\xe5</span>, like a modal verb does) or the full infinitive.</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04067",N:"<div class=\"center\"><div class=\"left\"><p>Translate using the passive construction with <span class=\"italic\">\xe5 bli</span> and the <span class=\"italic\">perfektum partisipp</span>:</p></div>The title was changed</div>",E:"<div class=\"center\">Tittelen ble endret</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">The most used passive form, especially for specific events and when the agent is specified.</div></div>",A:"E"},{DECK_ID:"B04",ID:"B04068",N:"<div class=\"center\"><div class=\"left\"><p>Translate using the passive construction with the S at the end of the verb:</p></div>Tore must be examined by the doctor</div>",E:"<div class=\"center\">Tore m\xe5 unders\xf8kes av legen</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">Used for ongoing, general events (i.e. present tense), for rules or after modal verbs.</div></div>",A:"E"},{DECK_ID:"B04",ID:"B04069",N:"<div class=\"center\"><div class=\"left\"><p>Translate using the passive construction with <span class=\"italic\">\xe5 v\xe6re</span> and the <span class=\"italic\">perfektum partisipp</span>:</p></div>The sausage is grilled</div>",E:"<div class=\"center\">P\xf8lsen er grillet</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">Used only to highlight the results of the action and not the agent.</div></div>",A:"E"},{DECK_ID:"B04",ID:"B04070",N:"<div class=\"center\">\xe5 \xe5pne<br>\xe5pner<br>\xe5pnet<br>har \xe5pnet</div>",E:"<div class=\"center\">to open</div>",D:"INTERMEDIATE VERBS",X:"",A:"N"},{DECK_ID:"B04",ID:"B04071",N:"<div class=\"center\">\xe5 lukke<br>lukker<br>lukket<br>har lukket</div>",E:"<div class=\"center\">to close</div>",D:"INTERMEDIATE VERBS",X:"",A:"N"},{DECK_ID:"B04",ID:"B04072",N:"<div class=\"center\">\xe5 stenge<br>stenger<br>stengte<br>har stengt</div>",E:"<div class=\"center\">to shut down, to close, to bar</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">Note that <span class=\"italic\">\xe5 stenge</span> is used for the closing time of shops, bars, public places etc.</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04073",N:"<div class=\"center\">\xe5 hete<br>heter<br>het<br>har hett</div>",E:"<div class=\"center\">to be called, to go by (a name)</div>",D:"INTERMEDIATE VERBS",X:"",A:"N"},{DECK_ID:"B04",ID:"B04074",N:"<div class=\"center\">\xe5 gjenta<br>gjentar<br>gjentok<br>har gjentatt</div>",E:"<div class=\"center\">to repeat</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Historien gjentar seg</span></p>(The) history repeats itself</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04075",N:"<div class=\"center\">\xe5 flytte (til)<br>flytter<br>flyttet<br>har flyttet</div>",E:"<div class=\"center\">to relocate (to), to move (to)</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p>Without the preposition <span class=\"italic\">til</span> and with a personal pronoun, it means \"to move\":</p><span class=\"italic\">Kan du flytte deg litt?</span></div></div>",A:"N"},{DECK_ID:"B04",ID:"B04076",N:"<div class=\"center\">\xe5 s\xf8ke (etter)<br>s\xf8ker<br>s\xf8kte<br>har s\xf8kt</div>",E:"<div class=\"center\">to search (for)</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">The verb <span class=\"italic\">\xe5 s\xf8ke</span> without <span class=\"italic\">etter</span> is mostly used as the \"search\" command in IT.</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04077",N:"<div class=\"center\">\xe5 skj\xf8nne<br>skj\xf8nner<br>skj\xf8nte<br>har skj\xf8nt</div>",E:"<div class=\"center\">to understand (informal/oral form)</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p>This is a synonym to <span class=\"italic\">\xe5 forst\xe5</span>, although considered more informal.</p><p>The main instance in which you must use <span class=\"italic\">\xe5 forst\xe5</span> and you cannot use <span class=\"italic\">\xe5 skj\xf8nne</span> is with languages:</p><span class=\"italic\">Jeg forst\xe5r tysk</span></div></div>",A:"N"},{DECK_ID:"B04",ID:"B04078",N:"<div class=\"center\"><div class=\"left\">Explain the construction of the imperative form (i.e. orders such as eat!, stop!, go!)</div></div>",E:"<div class=\"center\"><div class=\"left\">The construction is the bare infinitive minus the E, basically the stem of the verb.<br>If the verb is monosyllabic and ending in a vowel, the imperative is the same as the bare infinitive.</div></div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p>\xe5 spise / spis!</p><p>\xe5 stoppe / stopp!</p>\xe5 g\xe5 / g\xe5!</div></div>",A:"X"},{DECK_ID:"B04",ID:"B04079",N:"<div class=\"center\"><div class=\"left\"><p>Translate using the passive construction with <span class=\"italic\">\xe5 bli</span> and the <span class=\"italic\">perfektum partisipp</span>:</p></div>The house is going to be cleaned by professionals</div>",E:"<div class=\"center\">Huset kommer til \xe5 bli vasket av profesjonelle</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">The most used passive form, especially for specific events and when the agent is specified.</div></div>",A:"E"},{DECK_ID:"B04",ID:"B04080",N:"<div class=\"center\"><div class=\"left\"><p>Translate using the passive construction with the S at the end of the verb:</p></div>The food can be grilled outside</div>",E:"<div class=\"center\">Maten kan grilles ute</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">Used for ongoing, general events (i.e. present tense), for rules or after modal verbs.</div></div>",A:"E"},{DECK_ID:"B04",ID:"B04081",N:"<div class=\"center\"><div class=\"left\"><p>Translate using the passive construction with <span class=\"italic\">\xe5 v\xe6re</span> and the <span class=\"italic\">perfektum partisipp</span>:</p></div>The house is sold</div>",E:"<div class=\"center\">Huset er solgt</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">Used only to highlight the results of the action and not the agent.</div></div>",A:"E"},{DECK_ID:"B04",ID:"B04082",N:"<div class=\"center\">\xe5 sl\xe5 (p\xe5 / av)<br>sl\xe5r<br>slo<br>har sl\xe5tt</div>",E:"<div class=\"center\">to hit, (to switch on  /  off)</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p>When used with <span class=\"italic\">p\xe5</span> and <span class=\"italic\">av</span>, this verb means, \"to switch on\" and \"to switch off\" respectively.</p>When used with the S, it means \"to fight, to hit each other\".</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04083",N:"<div class=\"center\">\xe5 h\xe5pe<br>h\xe5per<br>h\xe5pet<br>har h\xe5pet</div>",E:"<div class=\"center\">to hope</div>",D:"INTERMEDIATE VERBS",X:"",A:"N"},{DECK_ID:"B04",ID:"B04084",N:"<div class=\"center\">\xe5 tenke (p\xe5)<br>tenker<br>tenkte<br>har tenkt</div>",E:"<div class=\"center\">to think (about), to ponder, to cogitate</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p>Mostly used with <span class=\"italic\">p\xe5</span>, sometimes with <span class=\"italic\">om</span> to express an opinion or a possibility (e.g. \"imagine if...\"):</p><span class=\"italic\">Hun tenker p\xe5 kj\xe6resten sin hele tiden<br>Hva tenker du om Norge?<br>Tenk om laget v\xe5rt hadde vunnet!</span></div></div>",A:"N"},{DECK_ID:"B04",ID:"B04085",N:"<div class=\"center\">\xe5 virke (p\xe5)<br>virker<br>virket<br>har virket</div>",E:"<div class=\"center\">to seem (to), to function, to work</div>",D:"INTERMEDIATE VERBS",X:"",A:"N"},{DECK_ID:"B04",ID:"B04086",N:"<div class=\"center\">\xe5 drive (med)<br>driver<br>drev<br>har drevet</div>",E:"<div class=\"center\">to run, to play (a sport), (to engage in)</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Han driver et IT-firma</span> / He runs an IT company</p><p><span class=\"italic\">Hun driver med h\xe5ndball</span> / She plays handball</p><span class=\"italic\">Hva driver du med?</span> / What are you doing? / What do you do?</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04087",N:"<div class=\"center\">\xe5 ringe<br>ringer<br>ringte<br>har ringt</div>",E:"<div class=\"center\">to call (with a telephone), to give a ring, to ring (a bell)</div>",D:"INTERMEDIATE VERBS",X:"",A:"N"},{DECK_ID:"B04",ID:"B04088",N:"<div class=\"center\">\xe5 bes\xf8ke<br>bes\xf8ker<br>bes\xf8kte<br>har bes\xf8kt</div>",E:"<div class=\"center\">to visit</div>",D:"INTERMEDIATE VERBS",X:"",A:"N"},{DECK_ID:"B04",ID:"B04089",N:"<div class=\"center\">\xe5 melde (om)<br>melder<br>meldte<br>har meldt</div>",E:"<div class=\"center\">to report (about), to announce</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p>Politiet melder om livsfarlig kj\xf8ring</p>Firmaet melder overskudd i andre kvartal</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04090",N:"<div class=\"center\">\xe5 \xf8nske<br>\xf8nsker<br>\xf8nsket<br>har \xf8nsket</div>",E:"<div class=\"center\">to wish, to want</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p>Often used with the object pronoun if there isn't a specific object:</p><p><span class=\"italic\">Alt jeg \xf8nsker meg</span></p>All I wish/want</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04091",N:"<div class=\"center\">\xe5 f\xf8lge<br>f\xf8lger<br>fulgte<br>har fulgt</div>",E:"<div class=\"center\">to follow, to accompany/walk</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Lars fulgte Lise hjem</span></p>Lars walked/accompanied Lise home</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04092",N:"<div class=\"center\">\xe5 selge<br>selger<br>solgte<br>har solgt</div>",E:"<div class=\"center\">to sell</div>",D:"INTERMEDIATE VERBS",X:"",A:"N"},{DECK_ID:"B04",ID:"B04093",N:"<div class=\"center\">\xe5 betale<br>betaler<br>betalte<br>har betalt</div>",E:"<div class=\"center\">to pay</div>",D:"INTERMEDIATE VERBS",X:"",A:"N"},{DECK_ID:"B04",ID:"B04094",N:"<div class=\"center\">\xe5 spille<br>spiller<br>spilte<br>har spilt</div>",E:"<div class=\"center\">to play (a game, a sport, a musical instrument)</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">The verb <span class=\"italic\">\xe5 leke, leker, lekte, har lekt</span> refers to young children's generic playing activities.</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04095",N:"<div class=\"center\">\xe5 glemme<br>glemmer<br>glemte<br>har glemt</div>",E:"<div class=\"center\">to forget</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p>It doesn't require a preposition, even when it may do so in English:</p><p><span class=\"italic\">Glem det!</span></p>Forget about that!</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04096",N:"<div class=\"center\"><div class=\"left\">Explain the construction of the imperative form (i.e. orders such as go!, eat!, stop!) of verbs whose stem ends in two or more consonants</div></div>",E:"<div class=\"center\"><div class=\"left\">To help clarity of pronunciation, they can either keep or drop the -E of the bare infinitive.</div></div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p>\xe5 endre / endr(e)!</p><p>\xe5 \xe5pne / \xe5pn(e)!</p>\xe5 behandle / behandl(e)!</div></div>",A:"X"},{DECK_ID:"B04",ID:"B04097",N:"<div class=\"center\"><div class=\"left\">Explain the construction of the imperative form (i.e. orders such as go!, eat!, stop!) of S-verbs such as <span class=\"italic\">\xe5 synes</span>, <span class=\"italic\">\xe5 lykkes</span> etc</div></div>",E:"<div class=\"center\"><div class=\"left\">S-verbs by nature to not lend themselves to imperative use, but for the sake of completion, here is how they would work:</div></div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><p>\xe5 synes / synes!</p>\xe5 lykkes / lykkes!</div>",A:"X"},{DECK_ID:"B04",ID:"B04098",N:"<div class=\"center\"><p>Translate using the correct verb tense:</p>I like to play football</div>",E:"<div class=\"center\">Jeg liker \xe5 spille fotball</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">The <span class=\"italic\">infinitiv</span> works very much like in English.<br>It represents the verb in its most pure and abstract form.</div></div>",A:"E"},{DECK_ID:"B04",ID:"B04099",N:"<div class=\"center\">\xe5 skifte<br>skifter<br>skiftet<br>har skiftet</div>",E:"<div class=\"center\">to change, to switch</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p>The verb <span class=\"italic\">\xe5 skifte</span> is to be used for changes within the same type of thing:</p><p><span class=\"italic\">Det er ok \xe5 skifte mening</span><br>It's ok to change opinion</p><span class=\"italic\">Jeg har skiftet til vinterdekk</span><br>I've switched to winter tires</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04100",N:"<div class=\"center\">\xe5 bytte<br>bytter<br>byttet<br>har byttet</div>",E:"<div class=\"center\">to swap, to substitute, to exchange a purchase</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p>The verb <span class=\"italic\">\xe5 bytte</span> is used for changes between two different things:</p><p><span class=\"italic\">Jeg byttet en vare hos butikken</span><br>I've exchanged a product at the shop</p><span class=\"italic\">Jeg byttet fly p\xe5 grunn av streiken</span><br>I changed flight because of the strike</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04101",N:"<div class=\"center\">\xe5 endre<br>endrer<br>endret<br>har endret</div>",E:"<div class=\"center\">to alter, to change</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">On top of <span class=\"italic\">\xe5 endre</span>, the verb <span class=\"italic\">\xe5 forandre</span> can also be used with the similar meaning of making changes to a certain thing (rather than swapping A with B), although the latter entails a more active meaning.</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04102",N:"<div class=\"center\">\xe5 lure (p\xe5)<br>lurer<br>lurte<br>har lurt</div>",E:"<div class=\"center\">to wonder, to ask oneself</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p>This verb (plus preposition) is a typical Norwegian construct, at times followed by <span class=\"italic\">om</span> (i.e.\"to wonder whether\").</p><span class=\"italic\"><p>Jeg lurer p\xe5 hva som vil skje</p>Jeg lurer p\xe5 om m\xf8tet ble avlyst</span></div></div>",A:"N"},{DECK_ID:"B04",ID:"B04103",N:"<div class=\"center\">\xe5 m\xf8te (p\xe5)<br>m\xf8ter<br>m\xf8tte<br>har m\xf8tt</div>",E:"<div class=\"center\">to meet, (to bump into)</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Jeg m\xf8tte p\xe5 en gammel venn i g\xe5r</span></p>I bumped into an old friend yesterday</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04104",N:"<div class=\"center\">\xe5 treffe<br>treffer<br>traff<br>har truffet</div>",E:"<div class=\"center\">to meet, to convene</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">No clear rule about the difference in use between <span class=\"italic\">\xe5 m\xf8te</span> and <span class=\"italic\">\xe5 treffe</span></div></div>",A:"N"},{DECK_ID:"B04",ID:"B04105",N:"<div class=\"center\">\xe5 svare (p\xe5)<br>svarer<br>svarte<br>har svart</div>",E:"<div class=\"center\">to answer (to)</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">Jeg svarte p\xe5 alle sp\xf8rsm\xe5lene i pr\xf8ven</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04106",N:"<div class=\"center\">\xe5 velge<br>velger<br>valgte<br>har valgt</div>",E:"<div class=\"center\">to choose, to select</div>",D:"INTERMEDIATE VERBS",X:"",A:"N"},{DECK_ID:"B04",ID:"B04107",N:"<div class=\"center\">\xe5 stemme<br>stemmer<br>stemte<br>har stemt</div>",E:"<div class=\"center\"><p>to fit, to stack up (in an abstract sense)</p>to vote (in an election)</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\">Du har rett, det stemmer!<br><br>Hvem stemte du p\xe5?</div>",A:"N"},{DECK_ID:"B04",ID:"B04108",N:"<div class=\"center\">\xe5 passe (p\xe5)<br>passer<br>passet<br>har passet</div>",E:"<div class=\"center\">to fit, to suit, (to mind, to watch out)</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Onsdag passer ikke for meg, jeg kan ikke bli med</span><br>Wednesday doesn't suit me, I can't come</p><p><span class=\"italic\">Pass p\xe5!</span> / Watch out!</p><span class=\"italic\">Jeg m\xe5 passe p\xe5 lillebroren min</span><br>I must look after my little brother</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04109",N:"<div class=\"center\"><div class=\"left\"><p>Translate using the appropriate verb with object pronoun:</p></div>Hurry up!</div>",E:"<div class=\"center\">Skynd deg!</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">Some verbs require the object pronoun and entail a reflexive action.<br>In this, Norwegian is similar to Latin languages.</div></div>",A:"E"},{DECK_ID:"B04",ID:"B04110",N:"<div class=\"center\"><p>Translate using the correct verb tense:</p>I need your help to solve the problem</div>",E:"<div class=\"center\">Jeg trenger din hjelp til \xe5 l\xf8se problemet</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">The <span class=\"italic\">infinitiv</span> works very much like in English, but be careful that Norwegian often needs the preposition <span class=\"italic\">til</span> (\"to\"), which English would include in the infinitive itself.</div></div>",A:"E"},{DECK_ID:"B04",ID:"B04111",N:"<div class=\"center\"><div class=\"left\"><p>Translate using the appropriate verb with object pronoun:</p></div>They are getting bored at work</div>",E:"<div class=\"center\">De kjeder seg p\xe5 jobb</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">Some verbs require the object pronoun and entail a reflexive action.<br>In this, Norwegian is similar to Latin languages.</div></div>",A:"E"},{DECK_ID:"B04",ID:"B04112",N:"<div class=\"center\">\xe5 jobbe<br>jobber<br>jobbet<br>har jobbet</div>",E:"<div class=\"center\">to work</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">The verb <span class=\"italic\">\xe5 arbeide, arbeider, arbeidet, har arbeidet</span> can also be used to a similar effect.</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04113",N:"<div class=\"center\"><div class=\"left\">How do you create the present participle (i.e. the -ING form of English verbs) in Norwegian?</div></div>",E:"<div class=\"center\"><div class=\"left\"><p>The <span class=\"italic\">presens partisipp</span> is usually created by adding -ENDE to the stem of the verb (the D is silent):</p>\xe5 l\xf8pe / l\xf8pende<br>\xe5 g\xe5 / g\xe5ende<br>\xe5 leve / levende</div></div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">The <span class=\"italic\">presens partisipp</span> works more as an adjective, rather than being the progressive form (with -ING) of the English verbs.</div></div>",A:"E"},{DECK_ID:"B04",ID:"B04114",N:"<div class=\"center\"><div class=\"left\"><p>Translate using the <span class=\"italic\">presens partisipp</span>:</p></div>The boy was sitting for three hours</div>",E:"<div class=\"center\">Gutten ble sittende i tre timer</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">The <span class=\"italic\">presens partisipp</span> is often used with <span class=\"italic\">\xe5 bli</span> to describe a continuous state.<br>The English \"stayed seated\" is also a possible translation of the Norwegian <span class=\"italic\">ble sittende</span>.</div></div>",A:"E"},{DECK_ID:"B04",ID:"B04115",N:"<div class=\"center\"><div class=\"left\"><p>Translate using the appropriate verb with object pronoun:</p></div>Get out!<br>(use <span class=\"italic\">du</span> as the pronoun)</div>",E:"<div class=\"center\">Kom deg ut!</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">Some verbs can add the object pronoun to entail a reflexive action.<br>In this, Norwegian is similar to Latin languages.</div></div>",A:"E"},{DECK_ID:"B04",ID:"B04116",N:"<div class=\"center\">\xe5 bruke<br>bruker<br>brukte<br>har brukt</div>",E:"<div class=\"center\">to use</div>",D:"INTERMEDIATE VERBS",X:"",A:"N"},{DECK_ID:"B04",ID:"B04117",N:"<div class=\"center\">\xe5 hente<br>henter<br>hentet<br>har hentet</div>",E:"<div class=\"center\">to bring, to fetch, to pick up</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">This verb requires movement from another location, it's not meant for proximity.</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04118",N:"<div class=\"center\">\xe5 slippe<br>slipper<br>slapp<br>har sluppet</div>",E:"<div class=\"center\"><p>to let go</p>to avoid, to break free from, to get away with</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p>The literal meaning is \"to let go\", but the verb has a number of related meanings:</p><p><span class=\"italic\">Jeg slapp fra ulykken uten skader</span><br>I walked away from the accident without wounds</p><span class=\"italic\">Han ble tatt for doping, men slapp straff</span><br>He got caught for doping, but avoided punishment</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04119",N:"<div class=\"center\">\xe5 f\xf8le<br>f\xf8ler<br>f\xf8lte<br>har f\xf8lt</div>",E:"<div class=\"center\">to feel</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p>This verb tends to require an object in Norwegian, so it needs an object pronoun when referring to people:</p><span class=\"italic\"><p>Hvordan f\xf8ler du deg i dag?</p>Jeg f\xf8ler meg bedre, takk.</span></div></div>",A:"N"},{DECK_ID:"B04",ID:"B04120",N:"<div class=\"center\">\xe5 sitte og <br>(sitter<br>satte<br>har satt)</div>",E:"<div class=\"center\">to do something (while sitting)</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Jeg sitter og leser avisa</span></p><p>I am (sitting and) reading the newspaper</p>This construction can be considered a substitute for the continuous forms with -ING of English and it's used for quite sedentary activities.</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04121",N:"<div class=\"center\">\xe5 ligge og <br>(ligger<br>l\xe5<br>har ligget)</div>",E:"<div class=\"center\">to do something (while lying down)</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Jeg ligger og slapper av</span></p><p>I am (lying down and) relaxing</p>This construction can be considered a substitute for the continuous forms with -ING of English.</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04122",N:"<div class=\"center\">\xe5 st\xe5 og  <br>(st\xe5r<br>stod<br>har st\xe5tt)</div>",E:"<div class=\"center\">to do something (while standing)</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Han st\xe5r og snakker i telefonen</span></p><p>He is (standing and) talking on the phone</p>This construction can be considered a substitute for the continuous forms with -ING of English.</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04123",N:"<div class=\"center\">\xe5 bekymre (seg for)<br>bekymrer<br>bekymret<br>har bekymret</div>",E:"<div class=\"center\">to worry (about)</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Jeg bekymrer meg for neste eksamen</span><br>I worry about the next exam</p><p>Note how the use of the <span class=\"italic\">bekymret</span> past participle as an adjective would only require <span class=\"italic\">for</span>:</p><span class=\"italic\">Jeg er bekymret for neste eksamen</span><br>I'm worried about the next exam</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04124",N:"<div class=\"center\">\xe5 se ut<br>ser ut<br>s\xe5 ut<br>har sett ut</div>",E:"<div class=\"center\">to look, to seem, to appear</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\">Han ser ut som en viking</div>",A:"N"},{DECK_ID:"B04",ID:"B04125",N:"<div class=\"center\">\xe5 l\xe5te<br>l\xe5ter<br>l\xe5t<br>har l\xe5tt</div>",E:"<div class=\"center\">to sound</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><p><span class=\"italic\">Det l\xe5ter bra!</span></p>It sounds good!</div>",A:"N"},{DECK_ID:"B04",ID:"B04126",N:"<div class=\"center\">\xe5 r\xf8re (seg)<br>r\xf8rer<br>r\xf8rte<br>har r\xf8rt</div>",E:"<div class=\"center\">to touch, to stir, (to move oneself)</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Jeg ble s\xe5 redd at jeg ikke kunne r\xf8re meg</span></p>I got so scared I couldn't move</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04127",N:"<div class=\"center\">\xe5 regne<br>regner<br>regnet<br>har regnet</div>",E:"<div class=\"center\">to rain, to calculate</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">Det regner ikke i dag<br><br>Vi m\xe5 regne ut hvor mye det koster til sammen</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04128",N:"<div class=\"center\"><div class=\"left\"><p>Translate using the <span class=\"italic\">presens partisipp</span>:</p></div>He came cycling</div>",E:"<div class=\"center\">Han kom syklende</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">The <span class=\"italic\">presens partisipp</span> is often used with movement verbs.</div></div>",A:"E"},{DECK_ID:"B04",ID:"B04129",N:"<div class=\"center\"><div class=\"left\"><p>Translate using the appropriate verb with object pronoun:</p></div>I'm going to bed, good night!</div>",E:"<div class=\"center\">Jeg legger meg, god natt!</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">Some verbs can add the object pronoun to entail a reflexive action.<br>In this, Norwegian is similar to Latin languages.</div></div>",A:"E"},{DECK_ID:"B04",ID:"B04130",N:"<div class=\"center\">\xe5 kj\xf8re<br>kj\xf8rer<br>kj\xf8rte<br>har kj\xf8rt</div>",E:"<div class=\"center\">to drive, to run</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p>This can be used in both the concrete meaning of driving a vehicle or in a more abstract way:</p><span class=\"italic\">\xe5 kj\xf8re en test, \xe5 kj\xf8re et program, \xe5 kj\xf8re studentene hardt </span></div></div>",A:"N"},{DECK_ID:"B04",ID:"B04131",N:"<div class=\"center\">\xe5 love<br>lover<br>lovte<br>har lovt</div>",E:"<div class=\"center\">to promise</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">The conjugation <span class=\"italic\">\xe5 love, lover, lovet, har lovet</span> is also possible.</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04132",N:"<div class=\"center\">\xe5 ordne<br>ordner<br>ordnet<br>har ordnet</div>",E:"<div class=\"center\">to fix, to sort out</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Jeg ordner ekstra stoler</span><br>I'll fix/get some more chairs</p><span class=\"italic\">Det ordner seg!</span><br>It'll sort itself out / It'll be alright</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04133",N:"<div class=\"center\"><p>\xe5 lage, lager, laget, har laget</p>\xe5 lage, lager, lagde, har lagd</div>",E:"<div class=\"center\">to make, to prepare</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p>This verb can follow either the first or the third pattern of weak verbs.</p>The expression <span class=\"italic\">\xe5 lage mat</span> is basically the translation of \"to cook\".</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04134",N:"<div class=\"center\">\xe5 sove<br>sover<br>sov<br>har sovet</div>",E:"<div class=\"center\">to sleep</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">Remember that \"to go to bed\" is <span class=\"italic\">\xe5 legge seg (legger, la, har lagt)</span>.</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04135",N:"<div class=\"center\">\xe5 tale<br>taler<br>talte<br>har talt</div>",E:"<div class=\"center\">to talk, to make a speech</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">Rather \"grand\" in meaning, it doesn't quite entail dialogue but rather one-way communication.</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04136",N:"<div class=\"center\">\xe5 bekrefte<br>bekrefter<br>bekreftet<br>har bekreftet</div>",E:"<div class=\"center\">to confirm</div>",D:"INTERMEDIATE VERBS",X:"",A:"N"},{DECK_ID:"B04",ID:"B04137",N:"<div class=\"center\">\xe5 kjennes<br>kjennes<br>kjentes<br>har kjentes</div>",E:"<div class=\"center\">to perceive/to feel</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p>When <span class=\"italic\">\xe5 kjenne</span> adds the -S at the end, it means \"to perceive\" and \"to feel\".</p><span class=\"italic\">Det kjennes trygt og godt</span></div></div>",A:"N"},{DECK_ID:"B04",ID:"B04138",N:"<div class=\"center\">\xe5 beskrive<br>beskriver<br>beskrev<br>har beskrevet</div>",E:"<div class=\"center\">to describe</div>",D:"INTERMEDIATE VERBS",X:"",A:"N"},{DECK_ID:"B04",ID:"B04139",N:"<div class=\"center\">\xe5 sende<br>sender<br>sendte<br>har sendt</div>",E:"<div class=\"center\">to send</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p>Also used as \"to pass\" in certain contexts:</p><p><span class=\"italic\">Kan du sende meg sm\xf8ret?</span></p>Can you pass me the butter?</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04140",N:"<div class=\"center\">\xe5 hate (at)<br>hater<br>hatet<br>har hatet</div>",E:"<div class=\"center\">to hate (when)</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">Note that the typical expression \"I hate it when\u2026\" would be <span class=\"italic\">jeg hater at\u2026</span> in Norwegian.</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04141",N:"<div class=\"center\">\xe5 si ifra<br>sier<br>sa<br>har sagt</div>",E:"<div class=\"center\">to tell, to notify, to let know, to warn</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Jeg sa ifra med en gang jeg ble syk</span><br>I notified (work) the moment I fell ill</p><span class=\"italic\">Si ifra n\xe5r du vil hentes!</span><br>Let me know when you want to be picked up</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04142",N:"<div class=\"center\">\xe5 mislykkes<br>mislykkes<br>mislyktes<br>har mislyktes/mislykkes</div>",E:"<div class=\"center\">to fail</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p>This is one of the verbs that normally has the -S ending otherwise typical of reflexive or reciprocal forms.<br>Here it also has the negative prefix \"mis\":</p><span class=\"italic\">Planen mislyktes</span></div></div>",A:"N"},{DECK_ID:"B04",ID:"B04143",N:"<div class=\"center\">\xe5 trives<br>triv(e)s<br>trivdes<br>har trivdes</div>",E:"<div class=\"center\">to thrive/enjoy oneself</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p>This is one of the verbs that normally has the -S ending otherwise typical of reflexive or reciprocal forms.</p><span class=\"italic\"><p>Han trives ikke s\xe5 godt med de teoretiske fagene</p>Jeg trives her i Norge</span></div></div>",A:"N"},{DECK_ID:"B04",ID:"B04144",N:"<div class=\"center\">\xe5 r\xf8yke<br>r\xf8yker<br>r\xf8ykte<br>har r\xf8ykt</div>",E:"<div class=\"center\">to smoke</div>",D:"INTERMEDIATE VERBS",X:"",A:"N"},{DECK_ID:"B04",ID:"B04145",N:"<div class=\"center\">\xe5 rekke<br>rekker<br>rakk<br>har rukket</div>",E:"<div class=\"center\">to catch in time, to manage</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Beklager, jeg rakk ikke toget</span></p>I'm sorry, I didn't catch the train (in time)</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04146",N:"<div class=\"center\">\xe5 n\xe5<br>n\xe5r<br>n\xe5dde<br>har n\xe5dd</div>",E:"<div class=\"center\">to achieve, to obtain, to reach</div>",D:"INTERMEDIATE VERBS",X:"",A:"N"},{DECK_ID:"B04",ID:"B04147",N:"<div class=\"center\">\xe5 eie<br>eier<br>eide<br>har eid</div>",E:"<div class=\"center\">to own</div>",D:"INTERMEDIATE VERBS",X:"",A:"N"},{DECK_ID:"B04",ID:"B04148",N:"<div class=\"center\">\xe5 hilse (fra)<br>hilser<br>hilste<br>har hilst</div>",E:"<div class=\"center\">to greet, (to pass on a greeting)</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Hils Lars fra meg!</span></p>Say \"hello\" to Lars from me!</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04149",N:"<div class=\"center\">\xe5 stikke<br>stikker<br>stakk<br>har stukket</div>",E:"<div class=\"center\"><p>(informal) to go away, to leave</p>(literally) to sting</div>",D:"INTERMEDIATE VERBS",X:"",A:"N"},{DECK_ID:"B04",ID:"B04150",N:"<div class=\"center\">\xe5 beh\xf8ve<br>beh\xf8ver<br>beh\xf8vde<br>har beh\xf8vd</div>",E:"<div class=\"center\">to need, to be in need of</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">The verb <span class=\"italic\">\xe5 beh\xf8ve</span> is a more formal version of <span class=\"italic\">\xe5 trenge</span>, which is used much more often.</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04151",N:"<div class=\"center\">\xe5 begynne<br>begynner<br>begynte<br>har begynt</div>",E:"<div class=\"center\">to begin, to start</div>",D:"INTERMEDIATE VERBS",X:"",A:"N"},{DECK_ID:"B04",ID:"B04152",N:"<div class=\"center\">\xe5 beklage (om)<br>beklager<br>beklaget<br>har beklaget</div>",E:"<div class=\"center\">to be sorry (about), to apologise (for)</div>",D:"INTERMEDIATE VERBS",X:"",A:"N"},{DECK_ID:"B04",ID:"B04153",N:"<div class=\"center\">\xe5 vokse<br>vokser<br>vokset<br>har vokset</div>",E:"<div class=\"center\">to grow (in size etc)</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\">Oslo har vokset mye</div>",A:"N"},{DECK_ID:"B04",ID:"B04154",N:"<div class=\"center\">\xe5 dyrke<br>dyrker<br>dyrket<br>har dyrket</div>",E:"<div class=\"center\">to cultivate, to grow</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">Jeg vil gjerne dyrke mine egne gulr\xf8tter</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04155",N:"<div class=\"center\">\xe5 klage (p\xe5)<br>klager<br>klagde<br>har klagd</div>",E:"<div class=\"center\">to complain (about)</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Gjestene klagde p\xe5 maten</span></p>The past forms <span class=\"italic\">klaget, har klaget</span> are also possible.</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04156",N:"<div class=\"center\">\xe5 sjekke<br>sjekker<br>sjekket<br>har sjekket</div>",E:"<div class=\"center\">to check</div>",D:"INTERMEDIATE VERBS",X:"",A:"N"},{DECK_ID:"B04",ID:"B04157",N:"<div class=\"center\">\xe5 handle (om)<br>handler<br>handlet<br>har handlet</div>",E:"<div class=\"center\">to do shopping, to make a transaction, (to be about)</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p>This is the verb form of the noun <span class=\"italic\">en handel</span> (a trade, a commerce), but it is mostly used with <span class=\"italic\">om</span>:</p><p><span class=\"italic\">Politikken handler om alt annet enn politikk</span></p>Politics are about anything other than politics</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04158",N:"<div class=\"center\">\xe5 bestille<br>bestiller<br>bestilte<br>har bestilt</div>",E:"<div class=\"center\">to order</div>",D:"INTERMEDIATE VERBS",X:"",A:"N"},{DECK_ID:"B04",ID:"B04159",N:"<div class=\"center\">\xe5 prate<br>prater<br>pratet<br>har pratet</div>",E:"<div class=\"center\">to chat</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">This verb is used to indicate informal, small-time conversation.</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04160",N:"<div class=\"center\">\xe5 skaffe<br>skaffer<br>skaffet<br>har skaffet</div>",E:"<div class=\"center\">to obtain, to get</div>",D:"INTERMEDIATE VERBS",X:"",A:"N"},{DECK_ID:"B04",ID:"B04161",N:"<div class=\"center\">\xe5 hende<br>hender<br>hendte<br>har hendt</div>",E:"<div class=\"center\">to happen, to occur</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">No clear rule about the difference in use between <span class=\"italic\">\xe5 skje</span> and <span class=\"italic\">\xe5 hende</span></div></div>",A:"N"},{DECK_ID:"B04",ID:"B04162",N:"<div class=\"center\">\xe5 merke<br>merker<br>merket<br>har merket</div>",E:"<div class=\"center\">to notice</div>",D:"INTERMEDIATE VERBS",X:"",A:"N"},{DECK_ID:"B04",ID:"B04163",N:"<div class=\"center\">\xe5 reise (seg)<br>reiser<br>reiste<br>har reist</div>",E:"<div class=\"center\">to travel, to raise, (to stand up)</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p>Used with the object pronoun, it means \"to stand up\":</p><p><span class=\"italic\">Jeg reiste meg fra stolen</span></p>I stood up from the chair</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04164",N:"<div class=\"center\">\xe5 foretrekke (framfor)<br>foretrekker<br>foretrakk<br>har foretrukket</div>",E:"<div class=\"center\">to prefer (to)</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Jeg foretrekker kylling fremfor fisk</span></p>Remember that <span class=\"italic\">frem</span> (and its compounds) is the more Danish/conservative spelling, whereas <span class=\"italic\">fram</span> (and its compounds) is the more progressive one.</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04165",N:"<div class=\"center\">\xe5 l\xe5ne<br>l\xe5ner<br>l\xe5nte<br>har l\xe5nt</div>",E:"<div class=\"center\">to lend, to borrow</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p>Kan du l\xe5ne meg tennisracketen din?</p><p>Jeg har aldri l\xe5nt penger til en venn</p>Noen norske ord er l\xe5nt fra engelsk</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04166",N:"<div class=\"center\">\xe5 tjene<br>tjener<br>tjente<br>har tjent</div>",E:"<div class=\"center\">to earn</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">Remember that the TJ cluster in this verb (and related words, such as <span class=\"italic\">tjeneste</span>) is read as a separate T and J and not like the the [ \xe7 ] sound in <span class=\"italic\">tjue</span>.</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04167",N:"<div class=\"center\">\xe5 l\xf8se<br>l\xf8ser<br>l\xf8ste<br>har l\xf8st</div>",E:"<div class=\"center\">to solve</div>",D:"INTERMEDIATE VERBS",X:"",A:"N"},{DECK_ID:"B04",ID:"B04168",N:"<div class=\"center\">\xe5 krangle<br>krangler<br>kranglet<br>har kranglet</div>",E:"<div class=\"center\">to quarrel, to argue</div>",D:"INTERMEDIATE VERBS",X:"",A:"N"},{DECK_ID:"B04",ID:"B04169",N:"<div class=\"center\">\xe5 lyve (for)<br>lyver<br>l\xf8y<br>har l\xf8yet</div>",E:"<div class=\"center\">to lie (to)</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p>This verb has alternate spellings:</p><span class=\"italic\">\xe5 ljuge, ljuger, l\xf8y, har l\xf8yet<br>\xe5 juge, juger, jugde, har jugd<br>\xe5 lyge, lyger, l\xf8y, har l\xf8yet</span></div></div>",A:"N"},{DECK_ID:"B04",ID:"B04170",N:"<div class=\"center\">\xe5 kreve<br>krever<br>krevde<br>har krevd</div>",E:"<div class=\"center\">to require, to demand</div>",D:"INTERMEDIATE VERBS",X:"",A:"N"},{DECK_ID:"B04",ID:"B04171",N:"<div class=\"center\">\xe5 vare<br>varer<br>varte<br>har vart</div>",E:"<div class=\"center\">to last, to take time</div>",D:"INTERMEDIATE VERBS",X:"",A:"N"},{DECK_ID:"B04",ID:"B04172",N:"<div class=\"center\">\xe5 late (som om)<br>later<br>lot<br>har latt</div>",E:"<div class=\"center\">to let, (to pretend)</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\">Lat som om du er ekspert!</div>",A:"N"},{DECK_ID:"B04",ID:"B04173",N:"<div class=\"center\">\xe5 snu<br>snur<br>snudde<br>har snudd</div>",E:"<div class=\"center\">to turn, to turn back, to reverse, to flip</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Vi m\xe5tte snu halvveis til hytta</span><br>We had to turn back halfway to the hut</p><span class=\"italic\">Jeg er flink til \xe5 snu pannekaker</span><br>I'm good at flipping pancakes</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04174",N:"<div class=\"center\"><p>\xe5 skylde, skylder, skyldte, har skyldt</p>\xe5 skyldes, skyldes, skyldtes, har skyldtes</div>",E:"<div class=\"center\"><p>to owe, to be in debt</p>(with S) to be due to</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p></p><p><span class=\"italic\">Kreft kan skyldes r\xf8yking</span></p>Cancer can be due to smoking</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04175",N:"<div class=\"center\">\xe5 vise<br>viser<br>viste<br>har vist</div>",E:"<div class=\"center\">to show</div>",D:"INTERMEDIATE VERBS",X:"",A:"N"},{DECK_ID:"B04",ID:"B04176",N:"<div class=\"center\">\xe5 l\xf8pe<br>l\xf8per<br>l\xf8p<br>har l\xf8pt</div>",E:"<div class=\"center\">to run</div>",D:"INTERMEDIATE VERBS",X:"",A:"N"},{DECK_ID:"B04",ID:"B04177",N:"<div class=\"center\">\xe5 kalle<br>kaller<br>kalte<br>har kalt</div>",E:"<div class=\"center\">to call</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">Note that when meaning \"to call by telephone\", you must use <span class=\"italic\">\xe5 ringe, ringer, ringte, har ringt</span>.</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04178",N:"<div class=\"center\">\xe5 bestemme (seg for)<br>bestemmer<br>bestemte<br>har bestemt</div>",E:"<div class=\"center\">to decide (to), to resolve</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Jeg bestemte meg for \xe5 dra p\xe5 festen</span></p>I decided to go to the party</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04179",N:"<div class=\"center\">\xe5 greie<br>greier<br>greide<br>har greid</div>",E:"<div class=\"center\">to manage, to be able to do</div>",D:"INTERMEDIATE VERBS",X:"",A:"N"},{DECK_ID:"B04",ID:"B04180",N:"<div class=\"center\">\xe5 pusse (opp)<br>pusser<br>pusset<br>har pusset</div>",E:"<div class=\"center\">to polish, to brush, (to tidy up)</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Ikke glem \xe5 pusse tennene!</span><br>Don't forget to brush your teeth!</p><span class=\"italic\">Jeg m\xe5 pusse opp rommet mitt</span><br>I have to tidy up my room</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04181",N:"<div class=\"center\">\xe5 stjele<br>stjeler<br>stjal<br>har stj\xe5let</div>",E:"<div class=\"center\">to steal</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">Remember that the TJ cluster in this verb is read as a separate T and J and not like the the [ \xe7 ] sound in <span class=\"italic\">tjue</span>.</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04182",N:"<div class=\"center\">\xe5 gjelde<br>gjelder<br>gjaldt<br>har gjeldt</div>",E:"<div class=\"center\">to concern, to pertain</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\">Klimaendringene gjelder oss alle</div>",A:"N"},{DECK_ID:"B04",ID:"B04183",N:"<div class=\"center\">\xe5 skade<br>skader<br>skadet<br>har skadet</div>",E:"<div class=\"center\">to hurt, to wound, to damage</div>",D:"INTERMEDIATE VERBS",X:"",A:"N"},{DECK_ID:"B04",ID:"B04184",N:"<div class=\"center\">\xe5 klare<br>klarer<br>klarte<br>har klart</div>",E:"<div class=\"center\">to manage, to succeed</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">The verb <span class=\"italic\">\xe5 greie, greier, greide, har greid</span> can be used to the same effect, but it's more colloquial.</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04185",N:"<div class=\"center\">\xe5 \xf8delegge<br>\xf8delegger<br>\xf8dela<br>har \xf8delagt</div>",E:"<div class=\"center\">to damage, to ruin</div>",D:"INTERMEDIATE VERBS",X:"",A:"N"},{DECK_ID:"B04",ID:"B04186",N:"<div class=\"center\">\xe5 lete etter<br>leter<br>lette<br>har lett</div>",E:"<div class=\"center\">to look for</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Jeg leter etter en ny leilighet</span></p>I'm looking for a new apartment</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04187",N:"<div class=\"center\">\xe5 skyte (p\xe5)<br>skyter<br>skj\xf8t<br>har skutt</div>",E:"<div class=\"center\">to shoot (to), to open gunfire (on)</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">De skj\xf8t p\xe5 hverandre</span></p>They shot at each other</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04188",N:"<div class=\"center\">\xe5 fryse<br>fryser<br>fr\xf8s<br>har frosset</div>",E:"<div class=\"center\">to freeze (i.e. to be very cold)</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">The verb changes to <span class=\"italic\">\xe5 fryse, fryser, fryste, har fryst</span> when used transitively (i.e. with an object) in the sense of \"to refrigerate something\".</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04189",N:"<div class=\"center\">\xe5 stave<br>staver<br>stavet<br>har stavet</div>",E:"<div class=\"center\">to spell</div>",D:"INTERMEDIATE VERBS",X:"",A:"N"},{DECK_ID:"B04",ID:"B04190",N:"<div class=\"center\">\xe5 trene<br>trener<br>trente<br>har trent</div>",E:"<div class=\"center\">to train, to get fit</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">Also possible as <span class=\"italic\">\xe5 trene, trener, trenet, har trenet</span>.</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04191",N:"<div class=\"center\">\xe5 rope (til/p\xe5)<br>roper<br>ropte<br>har ropt</div>",E:"<div class=\"center\">to shout (at/for), to call, to yell (at)</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">En full mann begynte \xe5 rope til meg</span><br>A drunken man began to shout at me</p><span class=\"italic\">Hun ropte p\xe5 hjelp, men ingen h\xf8rte</span><br>She shouted for help, but nobody heard (her)</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04192",N:"<div class=\"center\">\xe5 fortsette<br>fortsetter<br>fortsatte<br>har fortsatt</div>",E:"<div class=\"center\">to continue</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">Pay attention to the pronunciation: the RT is the retroflexed sound, the S is essentially the SH sound of English.</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04193",N:"<div class=\"center\">\xe5 smile (til)<br>smiler<br>smilte<br>har smilt</div>",E:"<div class=\"center\">to smile (to)</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\">Barnet smilte til meg</div>",A:"N"},{DECK_ID:"B04",ID:"B04194",N:"<div class=\"center\">\xe5 tvinge<br>tvinger<br>tvang<br>har tvunget</div>",E:"<div class=\"center\">to force, to urge</div>",D:"INTERMEDIATE VERBS",X:"",A:"N"},{DECK_ID:"B04",ID:"B04195",N:"<div class=\"center\">\xe5 frykte<br>frykter<br>fryktet<br>har fryktet</div>",E:"<div class=\"center\">to fear</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><p>Jeg frykter d\xf8den</p>De frykter det verste</div>",A:"N"},{DECK_ID:"B04",ID:"B04196",N:"<div class=\"center\">\xe5 vaske<br>vasker<br>vasket<br>har vasket</div>",E:"<div class=\"center\">to clean, to wash</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Jeg vasker meg etter trening</span><br>I shower/wash (myself) after training</p><span class=\"italic\">Kan du vaske opp?</span><br>Can you do the washing up?</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04197",N:"<div class=\"center\">\xe5 roe (seg)<br>roer<br>roet<br>har roet</div>",E:"<div class=\"center\">to calm, (to calm oneself)</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\">Trafikken har endelig roet seg</div>",A:"N"},{DECK_ID:"B04",ID:"B04198",N:"<div class=\"center\">\xe5 dreie (seg om)<br>dreier<br>dreide<br>har dreid</div>",E:"<div class=\"center\">to spin, to turn to, (to be about)</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Han dreide samtalen inn p\xe5 et nytt fag</span><br>He turned the conversation to a new topic</p><span class=\"italic\">Suksess dreier seg om hardt arbeid</span><br>Success is about hard work</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04199",N:"<div class=\"center\">\xe5 t\xe5le<br>t\xe5ler<br>t\xe5lte<br>har t\xe5lt</div>",E:"<div class=\"center\">to tolerate, to stand</div>",D:"INTERMEDIATE VERBS",X:"",A:"N"},{DECK_ID:"B04",ID:"B04200",N:"<div class=\"center\">\xe5 skynde seg<br>skynder<br>skyndte<br>har skyndt</div>",E:"<div class=\"center\">to hurry oneself, to rush oneself</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p>This verb requires to be used with the pronoun:</p><span class=\"italic\">Det er sent, vi m\xe5 skynde oss!</span></div></div>",A:"N"},{DECK_ID:"B04",ID:"B04201",N:"<div class=\"center\">\xe5 kjede (seg)<br>kjeder<br>kjedet<br>har kjedet</div>",E:"<div class=\"center\">to bore, (to get bored)</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Jeg kjedet meg forferdelig under talene</span><br>I get terribly bored during speeches</p><span class=\"italic\">Kjeder jeg deg med historien min?</span><br>Am I boring you with my story?</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04202",N:"<div class=\"center\">\xe5 kose seg<br>koser<br>koste<br>har kost</div>",E:"<div class=\"center\">to enjoy oneself, to have a good time</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\">Vi koste oss masse p\xe5 skitur!</div>",A:"N"},{DECK_ID:"B04",ID:"B04203",N:"<div class=\"center\">\xe5 slette<br>sletter<br>slettet<br>har slettet</div>",E:"<div class=\"center\">to delete</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p>This verbs is used especially for IT and data matters.</p>The verb <span class=\"italic\">\xe5 fjerne</span> can be used to a similar effect, but its meaning is closer to \"to remove\".</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04204",N:"<div class=\"center\">\xe5 avbryte<br>avbryter<br>avbr\xf8t<br>har avbrutt</div>",E:"<div class=\"center\">to interrupt, to cancel</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">The meaning \"to cancel\" is often used in the context of computers, smartphones and an information technology.</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04205",N:"<div class=\"center\">\xe5 tvile (p\xe5)<br>tviler<br>tvilte<br>har tvilt</div>",E:"<div class=\"center\">to doubt</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">Jeg tviler p\xe5 at Lars og Lise kommer f\xf8r kl. 7</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04206",N:"<div class=\"center\">\xe5 drepe<br>dreper<br>drepte<br>har drept</div>",E:"<div class=\"center\">to kill</div>",D:"INTERMEDIATE VERBS",X:"",A:"N"},{DECK_ID:"B04",ID:"B04207",N:"<div class=\"center\">\xe5 forberede<br>forbereder<br>forberedte<br>har forberedt</div>",E:"<div class=\"center\">to prepare</div>",D:"INTERMEDIATE VERBS",X:"",A:"N"},{DECK_ID:"B04",ID:"B04208",N:"<div class=\"center\">\xe5 le (av)<br>ler<br>lo<br>har ledd</div>",E:"<div class=\"center\">to laugh (about)</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\">Alle lo av meg</div>",A:"N"},{DECK_ID:"B04",ID:"B04209",N:"<div class=\"center\">\xe5 forvirre<br>forvirrer<br>forvirret<br>har forvirret</div>",E:"<div class=\"center\">to confuse</div>",D:"INTERMEDIATE VERBS",X:"",A:"N"},{DECK_ID:"B04",ID:"B04210",N:"<div class=\"center\">\xe5 angre (p\xe5)<br>angrer<br>angret<br>har angret</div>",E:"<div class=\"center\">to regret, (to have regrets about)</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p>The preposition <span class=\"italic\">p\xe5</span> may be used:</p><span class=\"italic\"><p>Jeg angrer ingenting</p>Jeg angrer ikke p\xe5 noe av det jeg har sagt</span></div></div>",A:"N"},{DECK_ID:"B04",ID:"B04211",N:"<div class=\"center\">\xe5 varsle<br>varsler<br>varslet<br>har varslet</div>",E:"<div class=\"center\">to alert, to warn, to message</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\">V\xe6rmeldingen varslet om regn.</div>",A:"N"},{DECK_ID:"B04",ID:"B04212",N:"<div class=\"center\">\xe5 skuffe<br>skuffer<br>skuffet<br>har skuffet</div>",E:"<div class=\"center\">to disappoint</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p>Often used with a passive construction and <span class=\"italic\">over</span>:</p><span class=\"italic\"><p>Jeg er litt skuffet over filmen</p>Hun er skuffet over meg</span></div></div>",A:"N"},{DECK_ID:"B04",ID:"B04213",N:"<div class=\"center\">\xe5 ane<br>aner<br>ante<br>har ant</div>",E:"<div class=\"center\">to have a clue, to sense</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Jeg aner ikke hva som er \xe5rsaken</span></p>I don't have a clue what is the reason</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04214",N:"<div class=\"center\">\xe5 plage<br>plager<br>plaget<br>har plaget</div>",E:"<div class=\"center\">to irritate, to aggravate</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Det plager meg \xe5 betale s\xe5 mye for \xe5 leie en leilighet</span></p>It bothers me to pay so much to rent an apartment</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04215",N:"<div class=\"center\">\xe5 d\xf8<br>d\xf8r<br>d\xf8de<br>har d\xf8dd</div>",E:"<div class=\"center\">to die</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\">Lars d\xf8de av hjertesvikt</div>",A:"N"},{DECK_ID:"B04",ID:"B04216",N:"<div class=\"center\">\xe5 bringe<br>bringer<br>brakte<br>har brakt</div>",E:"<div class=\"center\">to bring</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Ingen vet hva framtiden vil bringe</span></p>The use is mostly abstract and slightly formal.<br>For concrete situations you should use <span class=\"italic\">\xe5 ta med</span>.</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04217",N:"<div class=\"center\">\xe5 fors\xf8ke<br>fors\xf8ker<br>fors\xf8kte<br>har fors\xf8kt</div>",E:"<div class=\"center\">to attempt</div>",D:"INTERMEDIATE VERBS",X:"",A:"N"},{DECK_ID:"B04",ID:"B04218",N:"<div class=\"center\">\xe5 anta<br>antar<br>antok<br>har antatt</div>",E:"<div class=\"center\">to presume, to assume</div>",D:"INTERMEDIATE VERBS",X:"",A:"N"},{DECK_ID:"B04",ID:"B04219",N:"<div class=\"center\">\xe5 avslutte<br>avslutter<br>avsluttet<br>har avsluttet</div>",E:"<div class=\"center\">to close, to finish, to quit</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">De avsluttet samarbeidet p\xe5 en god m\xe5te.</div></div>",A:"N"},{DECK_ID:"B04",ID:"B04220",N:"<div class=\"center\">\xe5 anbefale<br>anbefaler<br>anbefalte<br>har anbefalt</div>",E:"<div class=\"center\">to recommend</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\">Hun anbefalte en tysk film.</div>",A:"N"},{DECK_ID:"B04",ID:"B04221",N:"<div class=\"center\">\xe5 unng\xe5<br>unng\xe5r<br>unngikk<br>har unng\xe5tt</div>",E:"<div class=\"center\">to avoid</div>",D:"INTERMEDIATE VERBS",X:"",A:"N"},{DECK_ID:"B04",ID:"B04222",N:"<div class=\"center\">\xe5 godta<br>godtar<br>godtok<br>har godtatt</div>",E:"<div class=\"center\">to accept</div>",D:"INTERMEDIATE VERBS",X:"",A:"N"},{DECK_ID:"B04",ID:"B04223",N:"<div class=\"center\">\xe5 dr\xf8mme<br>dr\xf8mmer<br>dr\xf8mte<br>har dr\xf8mt</div>",E:"<div class=\"center\">to dream</div>",D:"INTERMEDIATE VERBS",X:"",A:"N"},{DECK_ID:"B04",ID:"B04224",N:"<div class=\"center\">\xe5 motta<br>mottar<br>mottok<br>har mottat</div>",E:"<div class=\"center\">to receive</div>",D:"INTERMEDIATE VERBS",X:"",A:"N"},{DECK_ID:"B04",ID:"B04225",N:"<div class=\"center\">\xe5 kjenne igjen<br>kjenner<br>kjente<br>har kjent</div>",E:"<div class=\"center\">to recognise</div>",D:"INTERMEDIATE VERBS",X:"<div class=\"center\"><div class=\"left\">Jeg kjente henne igjen p\xe5 m\xe5ten hun lo.</div></div>",A:"N"},{DECK_ID:"B05",ID:"B05001",N:"<div class=\"center\"><p>Translate using adjectives correctly:</p>The old man goes home</div>",E:"<div class=\"center\">Den gamle mannen drar hjem</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">A definite noun with an adjective requires:<br>- the determiner <span class=\"italic\">den/det, de</span><br>- the adjective in the definite/plural form<br>- the noun in the definite form</div></div>",A:"E"},{DECK_ID:"B05",ID:"B05002",N:"<div class=\"center\"><p>List the three forms of this adjective:</p><span class=\"italic\">fri</span> (free from)</div>",E:"<div class=\"center\">fri (for), fritt, frie</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p>Monosyllabic adjectives ending in a single vowel take -TT for the <span class=\"italic\">intetkj\xf8nn</span> form.</p>Moreover, the preposition that goes with <span class=\"italic\">fri</span> when it comes to, for instance, food being free from certain ingredients is <span class=\"italic\">for</span>.</div></div>",A:"E"},{DECK_ID:"B05",ID:"B05003",N:"<div class=\"center\"><p>Translate these adjectives that start with U:</p><span class=\"italic\">umulig, uheldig, ulovlig</span></div>",E:"<div class=\"center\">impossible, unlucky, illegal</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p>The opposite of many adjectives can be created by adding a U at the beginning.</p>Unluckily there is no fixed rule as to which ones can and which ones cannot.</div></div>",A:"N"},{DECK_ID:"B05",ID:"B05004",N:"<div class=\"center\"><p>List the three forms of this adjective:</p><span class=\"italic\">hyggelig</span> (nice, cozy)</div>",E:"<div class=\"center\">hyggelig, hyggelig, hyggelige</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p>Adjectives ending in <b class=\"bold\">-IG skip the -T</b> for <span class=\"italic\">intetkj\xf8nn</span> form and the <b class=\"bold\">G is always silent</b>.</p>The adjective <span class=\"italic\">hyggelig</span> refers to feelings and atmosphere.</div></div>",A:"E"},{DECK_ID:"B05",ID:"B05005",N:"<div class=\"center\"><p>List the three forms of this adjective:</p><span class=\"italic\">bra</span> (good)</div>",E:"<div class=\"center\">bra, bra, bra</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\">Some adjectives never change</div>",A:"E"},{DECK_ID:"B05",ID:"B05006",N:"<div class=\"center\"><p>List the three forms of this adjective:</p><span class=\"italic\">norsk</span> (Norwegian)</div>",E:"<div class=\"center\">norsk, norsk, norske</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">Adjectives ending in <b class=\"bold\">-SK skip the -T</b> for the <span class=\"italic\">intetkj\xf8nn</span> form (unless monosyllabic and not referring to nationality).</div></div>",A:"E"},{DECK_ID:"B05",ID:"B05007",N:"<div class=\"center\"><p>Translate using adjectives correctly:</p>The new house is big</div>",E:"<div class=\"center\">Det nye huset er stort</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">Adjectives that come directly after the verb (i.e. predicate adjective in technical grammar terms) are always indefinite (whether singular or plural), even for definite nouns.</div></div>",A:"E"},{DECK_ID:"B05",ID:"B05008",N:"<div class=\"center\"><div class=\"left\"><p>Provide the comparative and superlative forms of this adjective:</p></div><span class=\"italic\">god</span> (good)</div>",E:"<div class=\"center\">god, bedre, best</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">This adjective is irregular in its comparative and superlative forms.</div></div>",A:"E"},{DECK_ID:"B05",ID:"B05009",N:"<div class=\"center\"><div class=\"left\"><p>Provide the comparative and superlative forms of this adjective:</p></div><span class=\"italic\">d\xe5rlig</span> (bad)</div>",E:"<div class=\"center\">d\xe5rlig, verre, verst</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">This adjective is irregular in its comparative and superlative forms.</div></div>",A:"E"},{DECK_ID:"B05",ID:"B05010",N:"<div class=\"center\"><p>Translate using the superlative correctly:</p>Red wine is best with steak</div>",E:"<div class=\"center\">R\xf8d vin er best til biff</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p>The superlative tends not to add an -E after <span class=\"italic\">\xe5 v\xe6re</span> or <span class=\"italic\">\xe5 bli</span> and when nothing else follows.</p>In this case, <span class=\"italic\">best</span> is used as a predicative.</div></div>",A:"E"},{DECK_ID:"B05",ID:"B05011",N:"<div class=\"center\"><p>Translate using the superlative correctly:</p>Magnus is the best chess player in the world</div>",E:"<div class=\"center\">Magnus er den beste sjakkspilleren i verden</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p>The superlative adds an -E when used as an adjective, in which case it is usually followed by a noun.<br>The predicative use could be:</p><span class=\"italic\">Magnus er best i sjakk</span></div></div>",A:"E"},{DECK_ID:"B05",ID:"B05012",N:"<div class=\"center\"><div class=\"left\"><p>Provide the comparative and superlative forms of this adjective:</p></div><span class=\"italic\">mye</span> (much)</div>",E:"<div class=\"center\">mye, mer, mest</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">This adjective is irregular in its comparative and superlative forms.</div></div>",A:"E"},{DECK_ID:"B05",ID:"B05013",N:"<div class=\"center\"><div class=\"left\"><p>Provide the comparative and superlative forms of this adjective:</p></div><span class=\"italic\">mange</span> (many)</div>",E:"<div class=\"center\">mange, flere, flest</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p>Irregular</p>Note that Norwegian keeps \"more\" and \"many\" separated (for uncountable and countable nouns) just as English does with \"less\" and \"few\".</div></div>",A:"E"},{DECK_ID:"B05",ID:"B05014",N:"<div class=\"center\"><div class=\"left\"><p>Provide the comparative and superlative forms of this adjective:</p></div><span class=\"italic\">f\xe5</span> (few)</div>",E:"<div class=\"center\">f\xe5, f\xe6rre, f\xe6rrest</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">This adjective is irregular in its comparative and superlative forms.</div></div>",A:"E"},{DECK_ID:"B05",ID:"B05015",N:"<div class=\"center\"><p>List the three forms of this adjective:</p><span class=\"italic\">sist</span> (last)</div>",E:"<div class=\"center\">sist, sist, siste</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p>This adjective is used to indicate the last instance of something that has now ended.</p><p><span class=\"italic\">I dag er min siste dag p\xe5 jobb, dersom flytter jeg til en annen by.</span></p>To indicate the most recent, past instance of something that hasn't ended, you must use the determiner <span class=\"italic\">forrige</span> (previous).</div></div>",A:"E"},{DECK_ID:"B05",ID:"B05016",N:"<div class=\"center\"><p>Translate using adjectives correctly:</p>The weather was better <b class=\"bold\">last</b> month</div>",E:"<div class=\"center\">V\xe6ret var bedre i <b class=\"bold\">forrige</b> m\xe5ned</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">One of the ways to translate \"last\" can be the determiner <span class=\"italic\">forrige</span>, which can be used with or without the <span class=\"italic\">den/det/de</span> (before) and the end article (on the noun it refers to).<br>It indicates the most recent instance of something in a series that hasn't ended, whereas <span class=\"italic\">siste</span> (last) indicates the last instance of something that has ended.</div></div>",A:"E"},{DECK_ID:"B05",ID:"B05017",N:"<div class=\"center\">forskjellig (fra),<br>forskjellig, forskjellige<br>mer forskjellig, mest forskjellig</div>",E:"<div class=\"center\">different (from)</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p>The adjective <span class=\"italic\">forskjellig</span> is often used to differentiate two parts of the subject or object:</p><span class=\"italic\"><p>Blues og jazz er forskjellig</p>Hun har \xf8yne med to forskjellige farger</span></div></div>",A:"N"},{DECK_ID:"B05",ID:"B05018",N:"<div class=\"center\">annerledes (enn)<br>annerledes, annerledes, <br>mer annerledes, mest annerledes</div>",E:"<div class=\"center\">dissimilar (from), other (than)</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p>The adjective <span class=\"italic\">annerledes</span> is often used alone or to differentiate the subject or object from something else, using <span class=\"italic\">enn</span>:</p><span class=\"italic\"><p>London er en klassisk destinasjon mens Edinburgh er litt annerledes</p>Pink Floyd er annerledes enn Metallica!</span></div></div>",A:"N"},{DECK_ID:"B05",ID:"B05019",N:"<div class=\"center\">allergisk (mot), <br>allergisk, allergiske, <br>mer allergisk, mest allergisk</div>",E:"<div class=\"center\">allergic (to)</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\">Dattera mi er allergisk mot katter</div>",A:"N"},{DECK_ID:"B05",ID:"B05020",N:"<div class=\"center\">lik,<br>likt, like<br>likere, likest</div>",E:"<div class=\"center\">similar, alike, same, identical</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p>Alle er like for loven</p><p>Alle dyr er like!</p>Denne er lik</div></div>",A:"N"},{DECK_ID:"B05",ID:"B05021",N:"<div class=\"center\"><div class=\"left\"><p>Provide the comparative and superlative forms of this adjective:</p></div><span class=\"italic\">viktig</span> (important)</div>",E:"<div class=\"center\">viktig, viktigere, viktigst</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p>Adjectives ending in -IG take just -ST for the superlative.</p>Also, remember that the G is not silent in the superlative form of the adjectives ending in -IG, and it's in fact pronounced as if it was a \"soft K\".</div></div>",A:"E"},{DECK_ID:"B05",ID:"B05022",N:"<div class=\"center\">lei (seg/av),<br>leit, leie,<br>mer lei, mest lei</div>",E:"<div class=\"center\">saddened, tired/bored of</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Jeg er lei meg for at katten min er syk</p><p>Pernille er lei av \xe5 ta ut s\xf8pla hele tida</span></p>Monosyllabic adjectives ending in a diphthong (mostly -EI) take single -T for the <span class=\"italic\">intetkj\xf8nn</span> form.</div></div>",A:"N"},{DECK_ID:"B05",ID:"B05023",N:"<div class=\"center\">klar (for/til),<br>klart, klare,<br>klarere, klarest</div>",E:"<div class=\"center\">ready (for), clear</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Mamma er klar for/til ferie!</span></p>In this case, <span class=\"italic\">for</span> would be more about the mental state and <span class=\"italic\">til</span> about having packed and being practically ready.</div></div>",A:"N"},{DECK_ID:"B05",ID:"B05024",N:"<div class=\"center\"><p>List the three forms of this adjective:</p><span class=\"italic\">ferdig</span> (done, completed)</div>",E:"<div class=\"center\">ferdig, ferdig, ferdige</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p>Adjectives ending in <b class=\"bold\">-IG skip the -T</b> for <span class=\"italic\">intetkj\xf8nn</span> form and the <b class=\"bold\">G is always silent</b>.<br>Often used with the preposition <span class=\"italic\">med</span>:</p><span class=\"italic\">L\xe6reren ble ferdig med timen ti minutter for tidlig</span></div></div>",A:"E"},{DECK_ID:"B05",ID:"B05025",N:"<div class=\"center\"><p>Translate using adjectives correctly:</p>It is <b class=\"bold\">over</b> between you and me</div>",E:"<div class=\"center\">Det er <b class=\"bold\">slutt</b> mellom deg og meg</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">The adjective <span class=\"italic\">slutt</span> is almost exclusively used as predicative (e.g. after <span class=\"italic\">\xe5 v\xe6re, \xe5 bli</span>), so you'll almost exclusively see it in the <span class=\"italic\">intetkj\xf8nn</span> form.<br>It is not used before nouns.</div></div>",A:"E"},{DECK_ID:"B05",ID:"B05026",N:"<div class=\"center\"><p>List the three forms of this adjective:</p><span class=\"italic\">hel</span> (whole, entire, complete)</div>",E:"<div class=\"center\">hel, helt, hele</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">hel, helt, hele</span> is to be used to indicate the entirety of a single countable noun:</p><p><span class=\"italic\">Et helt nytt liv</span></p>Note that <span class=\"italic\">en helt</span> means \"a hero\" (its E is short in sound, though).</div></div>",A:"E"},{DECK_ID:"B05",ID:"B05027",N:"<div class=\"center\">lang,<br>langt, lange<br>lengre, lengst</div>",E:"<div class=\"center\">long</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p>This adjective is irregular in its comparative and superlative forms.</p>Learn to distinguish it from the time adverb <span class=\"italic\">lenge, lenger, lengst</span> (i.e. \"for a long time\").</div></div>",A:"N"},{DECK_ID:"B05",ID:"B05028",N:"<div class=\"center\"><p>Translate using adjectives correctly:</p>The <b class=\"bold\">last</b> (and final) time it happened was in November 2010</div>",E:"<div class=\"center\"><b class=\"bold\">Siste</b> gang det skjedde var i november 2010<br>or<br><b class=\"bold\">Den siste</b> gang<b class=\"bold\">en</b> det skjedde var i november 2010</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p>Adjectives specifying order and position in a <span class=\"italic\">bestemt</span> context can be used with or without the determiner (before) and the end article (on the noun they refer to). Some of the most used are:</p><p><span class=\"italic\">midtre, nedre, siste, forrige, neste</span></p>The last two are in fact considered determiners.</div></div>",A:"E"},{DECK_ID:"B05",ID:"B05029",N:"<div class=\"center\"><div class=\"left\"><p>Provide the comparative and superlative forms of this adjective:</p></div><span class=\"italic\">sulten</span> (hungry)</div>",E:"<div class=\"center\">sulten, sultnere, sultnest</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">Adjectives ending in -EL, -EN, or -ER lose the E in the comparative and superlative forms.</div></div>",A:"E"},{DECK_ID:"B05",ID:"B05030",N:"<div class=\"center\"><p>List the three forms of this adjective:</p><span class=\"italic\">feil</span> (wrong)</div>",E:"<div class=\"center\">feil, feil, feil</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\">Some adjectives never change</div>",A:"E"},{DECK_ID:"B05",ID:"B05031",N:"<div class=\"center\">riktig,<br>riktig, riktige<br>riktigere, riktigst</div>",E:"<div class=\"center\">correct, right</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p>Can be used without determiner and end article on the noun:</p><span class=\"italic\">Vet du riktig svar p\xe5 sp\xf8rsm\xe5let?</span></div></div>",A:"N"},{DECK_ID:"B05",ID:"B05032",N:"<div class=\"center\"><p>Translate using adjectives correctly:</p>Eivind and Marte are married</div>",E:"<div class=\"center\">Eivind og Marte er gift</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">Some adjectives remain in the singular <span class=\"italic\">hankj\xf8nn</span> form in certain predicative expressions, regardless of the gender/number of the noun(s) they refer to.<br>Some of these include <span class=\"italic\">klar over, glad i</span> and <span class=\"italic\">lei av</span>.</div></div>",A:"E"},{DECK_ID:"B05",ID:"B05033",N:"<div class=\"center\">rund,<br>rundt, runde<br>rundere, rundest</div>",E:"<div class=\"center\">round, circular</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">The <span class=\"italic\">intetkj\xf8nn</span> form is the equivalent of the English adverb \"around\".</div></div>",A:"N"},{DECK_ID:"B05",ID:"B05034",N:"<div class=\"center\">kvitt,<br>kvitt, kvitt<br>(no comparative and superlative)</div>",E:"<div class=\"center\">rid of, liberated from</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p>Bli kvitt depresjonen ved hjelp av en psykolog</p>Han ble kvitt sine ekstra kilo</div></div>",A:"N"},{DECK_ID:"B05",ID:"B05035",N:"<div class=\"center\">enig i/med,<br>enig, enige<br>mer enig, mest enig</div>",E:"<div class=\"center\">in agreement about/with</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p>Note that <span class=\"italic\">enig i</span> refers to things, <span class=\"italic\">enig med</span> to people and <span class=\"italic\">\xe5 bli enige om</span> means \"to come to an agreement\":</p><span class=\"italic\">Jeg er enig i at vi m\xe5 endre holding<br>Pappa er enig med meg!<br>Vi ble enige om \xe5 slutte \xe5 krangle</span></div></div>",A:"N"},{DECK_ID:"B05",ID:"B05036",N:"<div class=\"center\"><div class=\"left\"><p>Provide the comparative and superlative forms of this adjective:</p></div><span class=\"italic\">morsom</span> (fun, enjoyable)</div>",E:"<div class=\"center\">morsom, morsommere, morsomst</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">Adjectives ending in -OM double the M for the comparative but add just -ST for the superlative.</div></div>",A:"E"},{DECK_ID:"B05",ID:"B05037",N:"<div class=\"center\">pen,<br>pent, pene<br>penere, penest</div>",E:"<div class=\"center\">pretty, beautiful</div>",D:"INTERMEDIATE ADJECTIVES",X:"",A:"N"},{DECK_ID:"B05",ID:"B05038",N:"<div class=\"center\">kj\xe6r,<br>kj\xe6rt, kj\xe6re<br>kj\xe6rere, kj\xe6rest</div>",E:"<div class=\"center\">dear</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">Used in the definite form as the \"dear\" at the beginning of letters and e-mails.</div></div>",A:"N"},{DECK_ID:"B05",ID:"B05039",N:"<div class=\"center\">ledig (for),<br>ledig, ledige<br>(mer ledig, mest ledig)</div>",E:"<div class=\"center\">available (for), vacant</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><p>Er denne sitteplassen ledig?</p>Er du ledig p\xe5 tirsdag?</div>",A:"N"},{DECK_ID:"B05",ID:"B05040",N:"<div class=\"center\">full (av),<br>fullt, fulle,<br>fullere, fullest</div>",E:"<div class=\"center\">full (of)</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Tanta mi er full av glede</span></p>Note that the <span class=\"italic\">intetkj\xf8nn</span> form maintains the double LL before adding the T.<br>This is an exception, as Norwegian spellings tend to avoid a double consonant followed by yet another consonant.</div></div>",A:"N"},{DECK_ID:"B05",ID:"B05041",N:"<div class=\"center\">tom (for),<br>tomt, tomme,<br>tommere, tommest</div>",E:"<div class=\"center\">empty (of), run out (of)</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\">Mobilen min gikk tom for batteri!</div>",A:"N"},{DECK_ID:"B05",ID:"B05042",N:"<div class=\"center\"><p>List the three forms of this adjective:</p><span class=\"italic\">frisk</span> (healthy)</div>",E:"<div class=\"center\">frisk, friskt, friske</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">Adjectives ending in -SK keep the -T for the <span class=\"italic\">intetkj\xf8nn</span> form if (and only if) they are monosyllabic and not referring to nationality.</div></div>",A:"E"},{DECK_ID:"B05",ID:"B05043",N:"<div class=\"center\"><p>Translate using adjectives correctly:</p>Cigarettes are expensive</div>",E:"<div class=\"center\">Sigaretter er dyrt</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p>Adjectives are used in the <span class=\"italic\">intetkj\xf8nn</span> form when there is an \"underlying verb\" that they refer to.<br>In this case, the underlying meaning is <span class=\"italic\">dyrt (\xe5 kj\xf8pe)</span>.</p>This often happens after <span class=\"italic\">\xe5 v\xe6re</span> and <span class=\"italic\">\xe5 bli</span> and when the adjective refers to an <span class=\"italic\">ubestemt</span> subject in a general sense.</div></div>",A:"E"},{DECK_ID:"B05",ID:"B05044",N:"<div class=\"center\">gratis,<br>gratis, gratis<br>(comparative and superlative<br> are not in use)</div>",E:"<div class=\"center\">free, without charge</div>",D:"INTERMEDIATE ADJECTIVES",X:"",A:"N"},{DECK_ID:"B05",ID:"B05045",N:"<div class=\"center\"><p>List the three forms of this adjective:</p><span class=\"italic\">felles</span> (communal)</div>",E:"<div class=\"center\">felles, felles, felles</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">Some adjectives, such as those ending in -S, never change.</div></div>",A:"E"},{DECK_ID:"B05",ID:"B05046",N:"<div class=\"center\"><p>Translate using adjectives correctly:</p>Running a marathon is tiring</div>",E:"<div class=\"center\">\xc5 l\xf8pe maraton er slitsomt</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p>Adjectives referring to a verb must be in <span class=\"italic\">intetkj\xf8nn</span></p>Also, note how the -ING form of English tends to be translated with the infinitive in Norwegian and rarely with an -ING form (in this case would be <span class=\"italic\">skig\xe5ing</span>).</div></div>",A:"E"},{DECK_ID:"B05",ID:"B05047",N:"<div class=\"center\"><p>Translate using ordinals correctly:</p>They live on the fourth floor</div>",E:"<div class=\"center\">De bor i fjerde etasje</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p>Ordinal numbers before a noun tend not to require either the determiner before or the end article on the noun.</p><p>They can be written as the number followed by a dot:</p></div><span class=\"italic\">4. etasje</span><br>(the D in <span class=\"italic\">fjerde</span> is silent).</div>",A:"E"},{DECK_ID:"B05",ID:"B05048",N:"<div class=\"center\"><div class=\"left\"><p>Provide the comparative and superlative forms of this adjective:</p></div><span class=\"italic\">langsom</span> (slow)</div>",E:"<div class=\"center\">langsom, langsommere, langsomst</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">Adjectives ending in -OM double the M for the comparative but add just -ST for the superlative.</div></div>",A:"E"},{DECK_ID:"B05",ID:"B05049",N:"<div class=\"center\">interessert (i),<br>interessert, interesserte,<br>mer interessert, mest interessert</div>",E:"<div class=\"center\">interested (in)</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\">Huseieren min er interessert i opera</div>",A:"N"},{DECK_ID:"B05",ID:"B05050",N:"<div class=\"center\">n\xf8dt til,<br>n\xf8dt, n\xf8dt,<br>(mer n\xf8dt, mest n\xf8dt)</div>",E:"<div class=\"center\">needed to, having to</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\">Jeg er n\xf8dt til \xe5 reise p\xe5 tirsdag</div>",A:"N"},{DECK_ID:"B05",ID:"B05051",N:"<div class=\"center\">daglig,<br>daglig, daglige<br>(mer daglig, mest daglig)</div>",E:"<div class=\"center\">daily</div>",D:"INTERMEDIATE ADJECTIVES",X:"",A:"N"},{DECK_ID:"B05",ID:"B05052",N:"<div class=\"center\">lett<br>lett, lette,<br>lettere, lettest</div>",E:"<div class=\"center\">easy, light</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><p>Jeg har lett for \xe5 gr\xe5te</p>Det var lett som en plett!</div>",A:"N"},{DECK_ID:"B05",ID:"B05053",N:"<div class=\"center\">vanskelig<br>vanskelig, vanskelige<br>vanskeligere, vanskeligst</div>",E:"<div class=\"center\">difficult</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Noen dialekter er vanskelig \xe5 forst\xe5</span></p>Remember that the G is not silent in the superlative form and is in fact pronounced as if it was a \"K\".</div></div>",A:"N"},{DECK_ID:"B05",ID:"B05054",N:"<div class=\"center\"><div class=\"left\"><p>Provide the comparative and superlative forms of this adjective:</p></div><span class=\"italic\">ung</span> (young)</div>",E:"<div class=\"center\">ung, yngre, yngst</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p>This adjective is irregular in its comparative and superlative forms.</p>Also, remember that the G is not silent in the superlative form of the adjectives ending in -IG, and it's in fact pronounced as if it was a \"soft K\".</div></div>",A:"E"},{DECK_ID:"B05",ID:"B05055",N:"<div class=\"center\"><p>Translate using adjectives correctly:</p>Norwegians are used to snow</div>",E:"<div class=\"center\">Nordmenn er vant til sn\xf8</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">Some adjectives remain in the singular <span class=\"italic\">hankj\xf8nn</span> form in certain expressions, regardless of the gender/number of the noun(s) they refer to.<br>Some of these include <span class=\"italic\">klar over, glad i</span> and <span class=\"italic\">lei av</span>.</div></div>",A:"E"},{DECK_ID:"B05",ID:"B05056",N:"<div class=\"center\"><p>List the three forms of this adjective:</p><span class=\"italic\">slags</span> (type of, kind of)</div>",E:"<div class=\"center\">slags, slags, slags</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p>Adjectives ending in -S tend not to change through the three forms.<br><span class=\"italic\">Slags</span> translates with the constructs \"kind of\" and \"type of\":</p><span class=\"italic\">Han er en slags IT tekniker</span></div></div>",A:"E"},{DECK_ID:"B05",ID:"B05057",N:"<div class=\"center\"><p>List the three forms of this adjective:</p><span class=\"italic\">gr\xe5</span> (grey)</div>",E:"<div class=\"center\">gr\xe5, gr\xe5tt, gr\xe5/gr\xe5e</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">This adjective takes the double -TT but can omit the -E in the plural/definite, just like <span class=\"italic\">bl\xe5</span> (blue).</div></div>",A:"E"},{DECK_ID:"B05",ID:"B05058",N:"<div class=\"center\"><p>List the three forms of this adjective:</p><span class=\"italic\">enkel</span> (simple, single)</div>",E:"<div class=\"center\">enkel, enkelt, enkle</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">Adjectives ending in -EL, -EN, or -ER lose the E in the plural/definite form.</div></div>",A:"E"},{DECK_ID:"B05",ID:"B05059",N:"<div class=\"center\"><div class=\"left\"><p>Provide the comparative and superlative forms of this adjective:</p></div><span class=\"italic\">gammel</span> (old)</div>",E:"<div class=\"center\">gammel, eldre, eldst</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">This adjective is irregular in its comparative and superlative forms.</div></div>",A:"E"},{DECK_ID:"B05",ID:"B05060",N:"<div class=\"center\"><p>List the three forms of this adjective:</p><span class=\"italic\">viss</span> (certain, determined)</div>",E:"<div class=\"center\">viss, visst, visse</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p>This adjective means \"some\" in the sense of \"certain\", \"some of them\":</p><span class=\"italic\"><p>Visse omr\xe5der av Oslo er farlige</p>Firenze var rik i en viss tidsperiode</span></div></div>",A:"E"},{DECK_ID:"B05",ID:"B05061",N:"<div class=\"center\"><p>Translate using ordinals correctly:</p>I'll leave on May 5</div>",E:"<div class=\"center\">Jeg drar femte mai</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p>Ordinal numbers before a noun tend not to require either the determiner before or the end article on the noun.</p><p>They can be written as the number followed by a dot:</p></div><span class=\"italic\">5. mai</span></div>",A:"E"},{DECK_ID:"B05",ID:"B05062",N:"<div class=\"center\"><p>Translate using S-genitive correctly:</p>Alexander's own flat is lovely</div>",E:"<div class=\"center\">Alexanders egen leilighet er koselig</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">egen, eget, egne</span> strengthens the possessive and must not be used in the definite form when between a possessive and a noun.</div></div>",A:"E"},{DECK_ID:"B05",ID:"B05063",N:"<div class=\"center\"><p>List the three forms of this adjective:</p><span class=\"italic\">interessant</span> (interesting)</div>",E:"<div class=\"center\">interessant, interessant, interessante</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p>Adjectives ending in -T remain unchanged in <span class=\"italic\">intetkj\xf8nn</span>.</p>Also, note the specific pronunciation of this word of foreign origin.</div></div>",A:"E"},{DECK_ID:"B05",ID:"B05064",N:"<div class=\"center\"><p>Translate using adjectives correctly:</p>The elderly ought to get help from the young</div>",E:"<div class=\"center\">De eldre burde f\xe5 hjelp av de unge</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">The so called \"nominalised adjectives\" require the adjective to be used in the plural/definite form (or comparative, like in this case) and with the determiner <span class=\"italic\">den/det, de</span>.</div></div>",A:"E"},{DECK_ID:"B05",ID:"B05065",N:"<div class=\"center\"><p>Translate using the adjective correctly:</p>I studied the whole day</div>",E:"<div class=\"center\">Jeg leste hele dagen</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p>Most often, <span class=\"italic\">hele</span> is not preceded by the determiner <span class=\"italic\">den/det, de</span> when used with a definite noun. Another example:</p><span class=\"italic\">Hele uka<br>Hele konserten</span></div></div>",A:"E"},{DECK_ID:"B05",ID:"B05066",N:"<div class=\"center\"><p>List the three forms of this adjective:</p><span class=\"italic\">trygg</span> (safe)</div>",E:"<div class=\"center\">trygg, trygt, trygge</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p>Most adjectives ending in a double consonant lose one of them to take the -T.</p>This is because Norwegian spellings tend to avoid a double consonant followed by yet another consonant.</div></div>",A:"E"},{DECK_ID:"B05",ID:"B05067",N:"<div class=\"center\"><p>Translate using adjectives correctly:</p>Fish is good</div>",E:"<div class=\"center\">Fisk er godt</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p>Adjectives are used in the <span class=\"italic\">intetkj\xf8nn</span> form when there is an \"underlying verb\" that they refer to.<br>In this case, the underlying meaning is <span class=\"italic\">godt (\xe5 spise)</span>.</p>This often happens after <span class=\"italic\">\xe5 v\xe6re</span> and <span class=\"italic\">\xe5 bli</span> and when the adjective refers to an <span class=\"italic\">ubestemt</span> subject in a general sense.</div></div>",A:"E"},{DECK_ID:"B05",ID:"B05068",N:"<div class=\"center\"><p>List the three forms of this adjective:</p><span class=\"italic\">snill</span> (kind)</div>",E:"<div class=\"center\">snill, snilt, snille</div>",D:"INTERMEDIATE ADJECTIVES",X:"",A:"E"},{DECK_ID:"B05",ID:"B05069",N:"<div class=\"center\">fin,<br>fint, fine<br>finere, finest</div>",E:"<div class=\"center\">fine, nice</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">The Norwegian <span class=\"italic\">fin</span> has pretty much the same variety of meanings as the English adjective \"fine\".</div></div>",A:"N"},{DECK_ID:"B05",ID:"B05070",N:"<div class=\"center\">hard,<br>hardt, harde<br>hardere, hardest</div>",E:"<div class=\"center\">hard, tough, strenuous</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">Used for somethig requiring significant, physical effort, whereas <span class=\"italic\">vanskelig</span> would be more about \"technical\" difficulty.</div></div>",A:"N"},{DECK_ID:"B05",ID:"B05071",N:"<div class=\"center\"><p>Translate using ordinals correctly:</p>He fought in the Second World War</div>",E:"<div class=\"center\">Han kjempet i (den) andre verdenskrig(en)</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">Ordinal numbers before a noun tend not to require either the determiner before or the end article on the noun.</div></div>",A:"E"},{DECK_ID:"B05",ID:"B05072",N:"<div class=\"center\">rik (p\xe5),<br>rikt, rike,<br>rikere, rikest</div>",E:"<div class=\"center\">rich (in), full (of)</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\">Appelsiner er rike p\xe5 vitaminer</div>",A:"N"},{DECK_ID:"B05",ID:"B05073",N:"<div class=\"center\">fattig,<br>fattig, fattige,<br>fattigere, fattigst</div>",E:"<div class=\"center\">poor, indigent, broke</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">Remember that the G is not silent the superlative form and is in fact pronounced as if it was a K.</div></div>",A:"N"},{DECK_ID:"B05",ID:"B05074",N:"<div class=\"center\"><p>List the three forms of this adjective:</p><span class=\"italic\">sulten</span> (hungry)</div>",E:"<div class=\"center\">sulten, sultent, sultne</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">Adjectives ending in -EL, -EN, or -ER lose the E in the plural/definite form.</div></div>",A:"E"},{DECK_ID:"B05",ID:"B05075",N:"<div class=\"center\">t\xf8rst,<br>t\xf8rst, t\xf8rste<br>t\xf8rstere, t\xf8rstest</div>",E:"<div class=\"center\">thirsty</div>",D:"INTERMEDIATE ADJECTIVES",X:"",A:"N"},{DECK_ID:"B05",ID:"B05076",N:"<div class=\"center\"><p>List the three forms of this adjective:</p><span class=\"italic\">mild</span> (mild)</div>",E:"<div class=\"center\">mild, mild, milde</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">Some adjectives ending in <b class=\"bold\">-D skip the -T</b> in the <span class=\"italic\">intetkj\xf8nn</span> form.</div></div>",A:"E"},{DECK_ID:"B05",ID:"B05077",N:"<div class=\"center\"><p>List the three forms of this adjective:</p><span class=\"italic\">sann</span> (true)</div>",E:"<div class=\"center\">sann, sant, sanne</div>",D:"INTERMEDIATE ADJECTIVES",X:"",A:"E"},{DECK_ID:"B05",ID:"B05078",N:"<div class=\"center\">m\xf8rk,<br>m\xf8rkt, m\xf8rke<br>m\xf8rkere, m\xf8rkest</div>",E:"<div class=\"center\">dark</div>",D:"INTERMEDIATE ADJECTIVES",X:"",A:"N"},{DECK_ID:"B05",ID:"B05079",N:"<div class=\"center\">lys,<br>lyst, lyse<br>lysere, lysest</div>",E:"<div class=\"center\">light, luminous, bright</div>",D:"INTERMEDIATE ADJECTIVES",X:"",A:"N"},{DECK_ID:"B05",ID:"B05080",N:"<div class=\"center\">vakker,<br>vakkert, vakre<br>vakrere, vakrest</div>",E:"<div class=\"center\">good-looking, beautiful</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p>This adjective is used mostly for qualities that can be sensed through sight or hearing:</p></div><span class=\"italic\">en vakker stemme</span> (a beautiful voice)</div>",A:"N"},{DECK_ID:"B05",ID:"B05081",N:"<div class=\"center\">sikker (p\xe5),<br>sikkert, sikre,<br>sikrere, sikrest</div>",E:"<div class=\"center\">sure (about/that)</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Farfar er sikker p\xe5 at han satte sykkelen p\xe5 plass</span></p>Remember that adjectives ending in -EL, -EN, or -ER lose the E and the double consonant in the plural/definite form.</div></div>",A:"N"},{DECK_ID:"B05",ID:"B05082",N:"<div class=\"center\">glad (for/i)<br>glad, glade,<br>gladere, gladest</div>",E:"<div class=\"center\">happy (about/fond of)</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Farmor er glad for min suksess</p><p>Hun er glad i hunden sin</span></p>Some adjectives ending in <b class=\"bold\">-D skip the -T</b> for the <span class=\"italic\">intetkj\xf8nn</span> form.</div></div>",A:"N"},{DECK_ID:"B05",ID:"B05083",N:"<div class=\"center\"><p>Translate using adjectives correctly:</p>The rich like to buy boats</div>",E:"<div class=\"center\">De rike liker \xe5 kj\xf8pe b\xe5ter</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">The so called \"nominalised adjectives\" require the adjective to be used in the plural/definite form and with the determiner <span class=\"italic\">den/det, de</span> before.</div></div>",A:"E"},{DECK_ID:"B05",ID:"B05084",N:"<div class=\"center\">sakte, sakte, sakte</div>",E:"<div class=\"center\">slow</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">This is a bit more colloquial and modern compared to <span class=\"italic\">langsom</span>.</div></div>",A:"N"},{DECK_ID:"B05",ID:"B05085",N:"<div class=\"center\"><p>List the three forms of this adjective:</p><span class=\"italic\">moden</span> (mature)</div>",E:"<div class=\"center\">moden, modent, modne</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">Adjectives ending in -EL, -EN, or -ER lose the E in the plural/definite form.</div></div>",A:"E"},{DECK_ID:"B05",ID:"B05086",N:"<div class=\"center\"><div class=\"left\"><p>Provide the comparative and superlative forms of this adjective:</p></div><span class=\"italic\">vanlig</span> (normal, usual)</div>",E:"<div class=\"center\">vanlig, vanligere, vanligst</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p>Adjectives ending in -IG take just -ST for the superlative.</p>Also, remember that the G is not silent in the superlative form of the adjectives ending in -IG, and it's in fact pronounced as if it was a \"soft K\".</div></div>",A:"E"},{DECK_ID:"B05",ID:"B05087",N:"<div class=\"center\">offentlig,<br>offentlig, offentlige<br>mer offentlig, mest offentlig</div>",E:"<div class=\"center\">public, in public view</div>",D:"INTERMEDIATE ADJECTIVES",X:"",A:"N"},{DECK_ID:"B05",ID:"B05088",N:"<div class=\"center\"><p>List the three forms of this adjective:</p><span class=\"italic\">ekte</span> (real, genuine)</div>",E:"<div class=\"center\">ekte, ekte, ekte</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">Adjectives ending in unstressed -E do not take any ending.</div></div>",A:"E"},{DECK_ID:"B05",ID:"B05089",N:"<div class=\"center\"><p>List the three forms of this adjective:</p><span class=\"italic\">oransje</span> (orange)</div>",E:"<div class=\"center\">oransje, oransje, oransje</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\">Some adjectives never change</div>",A:"E"},{DECK_ID:"B05",ID:"B05090",N:"<div class=\"center\">syk (av),<br>sykt, syke,<br>sykere, sykest</div>",E:"<div class=\"center\">sick (of), sickened (by)</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Ungen ble syk av alt sukkeret</span></p>Also spelled as <span class=\"italic\">sjuk, sjukt, sjuke, sjukere, sjukest</span></div></div>",A:"N"},{DECK_ID:"B05",ID:"B05091",N:"<div class=\"center\">mulig,<br>mulig, mulige<br>(mer mulig, mest mulig)</div>",E:"<div class=\"center\">possible</div>",D:"INTERMEDIATE ADJECTIVES",X:"",A:"N"},{DECK_ID:"B05",ID:"B05092",N:"<div class=\"center\"><p>List the three forms of this adjective:</p><span class=\"italic\">rett</span> (fair, right)</div>",E:"<div class=\"center\">rett, rett, rette</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p>Adjectives ending in -T remain unchanged in <span class=\"italic\">intetkj\xf8nn</span>.</p>Note that the expression \"to be right\" is translated as <span class=\"italic\">\xe5 ha rett</span> (to have right).</div></div>",A:"E"},{DECK_ID:"B05",ID:"B05093",N:"<div class=\"center\">kjent (med),<br>kjent, kjente,<br>mer kjent, mest kjent</div>",E:"<div class=\"center\">acquainted (with)</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\">I dag ble jeg kjent med en ny kollega</div>",A:"N"},{DECK_ID:"B05",ID:"B05094",N:"<div class=\"center\">dum,<br>dumt, dumme<br>dummere, dummest</div>",E:"<div class=\"center\">dumb, stupid, unwise</div>",D:"INTERMEDIATE ADJECTIVES",X:"",A:"N"},{DECK_ID:"B05",ID:"B05095",N:"<div class=\"center\">snar,<br>snart, snare<br>snarere, snarest</div>",E:"<div class=\"center\">quick, rapid</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">Note that the adverb <span class=\"italic\">snart</span> means \"soon\", so it's a time adverb.</div></div>",A:"N"},{DECK_ID:"B05",ID:"B05096",N:"<div class=\"center\">rask,<br>raskt, raske,<br>raskere, raskest</div>",E:"<div class=\"center\">speedy, fast</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Broren min er rask til \xe5 regne</span></p><p><span class=\"italic\">Rask</span> and <span class=\"italic\">snar</span> are virtually synonyms as adjectives.</p>However, as adverbs, <span class=\"italic\">raskt</span> means \"quickly\", whilst <span class=\"italic\">snart</span> means \"soon\".</div></div>",A:"N"},{DECK_ID:"B05",ID:"B05097",N:"<div class=\"center\"><p>List the three forms of this adjective:</p><span class=\"italic\">praktisk</span> (practical)</div>",E:"<div class=\"center\">praktisk, praktisk, praktiske</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">Adjectives ending in <b class=\"bold\">-SK skip the -T</b> for the <span class=\"italic\">intetkj\xf8nn</span> form (unless monosyllabic and not referring to nationality).</div></div>",A:"E"},{DECK_ID:"B05",ID:"B05098",N:"<div class=\"center\"><p>List the three forms of this adjective:</p><span class=\"italic\">rosa</span> (pink)</div>",E:"<div class=\"center\">rosa, rosa, rosa</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\">Some adjectives never change</div>",A:"E"},{DECK_ID:"B05",ID:"B05099",N:"<div class=\"center\"><div class=\"left\"><p>Provide the comparative and superlative forms of this adjective:</p></div><span class=\"italic\">travel</span> (busy)</div>",E:"<div class=\"center\">travel, travlere, travlest</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">Adjectives ending in -EL, -EN, or -ER lose the E in the comparative and superlative forms.</div></div>",A:"E"},{DECK_ID:"B05",ID:"B05100",N:"<div class=\"center\">n\xf8dvendig,<br>n\xf8dvendig, n\xf8dvendige<br>mer n\xf8dvendig, mest n\xf8dvendig</div>",E:"<div class=\"center\">necessary</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p>Er det n\xf8dvendig \xe5 pusse tennene?</p>Mamma sier det er n\xf8dvendig med god matpakke</div></div>",A:"N"},{DECK_ID:"B05",ID:"B05101",N:"<div class=\"center\">halv,<br>halvt, halve<br>(comparative and superlative<br> are not in use)</div>",E:"<div class=\"center\">half</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p>No preposition is used in Norwegian:</p><span class=\"italic\">Halve taket ble \xf8delagt</span><br>Half of the roof got damaged</div></div>",A:"N"},{DECK_ID:"B05",ID:"B05102",N:"<div class=\"center\">\xe5pen (for),<br>\xe5pent, \xe5pne<br>mer \xe5pen, mest \xe5pen</div>",E:"<div class=\"center\">open (to)</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\">Vi er \xe5pne for videre diskusjon</div>",A:"N"},{DECK_ID:"B05",ID:"B05103",N:"<div class=\"center\">opptatt med (av),<br>opptatt, opptatte,<br>mer opptatt, mest opptatt</div>",E:"<div class=\"center\">busy with, (interested in)</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p>Pappa er opptatt med jobben</p>Kusinen min er opptatt av mote og kl\xe6r</div></div>",A:"N"},{DECK_ID:"B05",ID:"B05104",N:"<div class=\"center\">samtidig,<br>samtidig, samtidige<br>(comparative and superlative<br> are not in use)</div>",E:"<div class=\"center\">simultaneous</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\">Often used as an adverb</div>",A:"N"},{DECK_ID:"B05",ID:"B05105",N:"<div class=\"center\">nylig,<br>nylig, nylige<br>nyligere, nyligst</div>",E:"<div class=\"center\">recent</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">Often used as an adverb meaning \"recently\"</div></div>",A:"N"},{DECK_ID:"B05",ID:"B05106",N:"<div class=\"center\">d\xf8d,<br>d\xf8dt, d\xf8de<br>(d\xf8dere, d\xf8dest)</div>",E:"<div class=\"center\">dead</div>",D:"INTERMEDIATE ADJECTIVES",X:"",A:"N"},{DECK_ID:"B05",ID:"B05107",N:"<div class=\"center\">gal (etter),<br>galt, gale,<br>galere, galest</div>",E:"<div class=\"center\">crazy (about), wrong</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p>Also spelled as <span class=\"italic\">g\xe6ren, g\xe6rent, g\xe6rne, g\xe6rnere, g\xe6rnest</span>:</p><span class=\"italic\"><p>Slik gj\xf8r du mannen gal etter deg</p>Hva er galt med det?</span></div></div>",A:"N"},{DECK_ID:"B05",ID:"B05108",N:"<div class=\"center\"><p>List the three forms of this adjective:</p><span class=\"italic\">bl\xe5</span> (blue)</div>",E:"<div class=\"center\">bl\xe5, bl\xe5tt, bl\xe5/bl\xe5e</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">This adjective takes the double -TT but can omit the -E in the plural/definite, just like <span class=\"italic\">gr\xe5</span> (grey).</div></div>",A:"E"},{DECK_ID:"B05",ID:"B05109",N:"<div class=\"center\"><p>List the three forms of this adjective:</p><span class=\"italic\">stille</span> (silent)</div>",E:"<div class=\"center\">stille, stille, stille</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">Adjectives ending in unstressed -E do not take any ending.</div></div>",A:"E"},{DECK_ID:"B05",ID:"B05110",N:"<div class=\"center\"><p>List the three forms of this adjective:</p><span class=\"italic\">sunn</span> (healthy)</div>",E:"<div class=\"center\">sunn, sunt, sunne</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p>Most adjectives ending in a double consonant lose one of them to take the -T.</p>This is because Norwegian spellings tend to avoid a double consonant followed by yet another consonant.</div></div>",A:"E"},{DECK_ID:"B05",ID:"B05111",N:"<div class=\"center\"><p>List the three forms of this adjective:</p><span class=\"italic\">skummel</span> (scary)</div>",E:"<div class=\"center\">skummel, skummelt, skumle</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">Note that the plural/definite form loses one M and the E, just like <span class=\"italic\">gammel, gammelt, gamle</span>.</div></div>",A:"E"},{DECK_ID:"B05",ID:"B05112",N:"<div class=\"center\">voksen,<br>voksent, voksne<br>mer voksen, mest voksen</div>",E:"<div class=\"center\">grown-up</div>",D:"INTERMEDIATE ADJECTIVES",X:"",A:"N"},{DECK_ID:"B05",ID:"B05113",N:"<div class=\"center\">vennlig (mot),<br>vennlig, vennlige<br>vennligere, vennligst</div>",E:"<div class=\"center\">friendly (with)</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">Skuespilleren er vennlig mot scenearbeideren</div></div>",A:"N"},{DECK_ID:"B05",ID:"B05114",N:"<div class=\"center\">tydelig,<br>tydelig, tydelige<br>tydeligere, tydeligst</div>",E:"<div class=\"center\">clear, evident</div>",D:"INTERMEDIATE ADJECTIVES",X:"",A:"N"},{DECK_ID:"B05",ID:"B05115",N:"<div class=\"center\">rar,<br>rart, rare<br>rarere, rarest</div>",E:"<div class=\"center\">strange, odd</div>",D:"INTERMEDIATE ADJECTIVES",X:"",A:"N"},{DECK_ID:"B05",ID:"B05116",N:"<div class=\"center\"><p>List the three forms of this adjective:</p><span class=\"italic\">flott</span> (elegant, beautiful)</div>",E:"<div class=\"center\">flott, flott, flotte</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">Adjectives ending in -T remain unchanged in <span class=\"italic\">intetkj\xf8nn</span>.</div></div>",A:"E"},{DECK_ID:"B05",ID:"B05117",N:"<div class=\"center\"><p>List the three forms of this adjective:</p><span class=\"italic\">tro</span> (loyal, faithful)</div>",E:"<div class=\"center\">tro, tro, tro</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\">Some adjectives never change</div>",A:"E"},{DECK_ID:"B05",ID:"B05118",N:"<div class=\"center\">tr\xf8tt<br>tr\xf8tt, tr\xf8tte, <br>tr\xf8ttere, tr\xf8ttest</div>",E:"<div class=\"center\">tired, drowsy</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p>Unlike <span class=\"italic\">sliten</span>, this adjective should be used only when indicating tiredness with a desire or a need to get some sleep.</p>It can also be spelled with an E instead of the \xd8: <span class=\"italic\">trett</span>.</div></div>",A:"N"},{DECK_ID:"B05",ID:"B05119",N:"<div class=\"center\"><p>List the three forms of this adjective:</p><span class=\"italic\">v\xe5ken</span> (awake)</div>",E:"<div class=\"center\">v\xe5ken, v\xe5kent, v\xe5kne</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">Adjectives ending in -EL, -EN, or -ER lose the E in the plural/definite form.</div></div>",A:"E"},{DECK_ID:"B05",ID:"B05120",N:"<div class=\"center\"><p>Translate using adjectives correctly:</p>We must set the lower limit</div>",E:"<div class=\"center\"><p>Vi m\xe5 sette <b class=\"bold\">nedre</b> grense</p>Vi m\xe5 sette <b class=\"bold\">den nedre</b> grens<b class=\"bold\">en</b></div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p>Adjectives specifying order and position in a <span class=\"italic\">bestemt</span> context can be used with or without the determiner (before) and the end article (on the noun they refer to). Some of the most used are:</p><p><span class=\"italic\">midtre, nedre, siste, forrige, neste</span></p>The last two are in fact considered determiners.</div></div>",A:"E"},{DECK_ID:"B05",ID:"B05121",N:"<div class=\"center\">lav,<br>lavt, lave<br>lavere, lavest</div>",E:"<div class=\"center\">low</div>",D:"INTERMEDIATE ADJECTIVES",X:"",A:"N"},{DECK_ID:"B05",ID:"B05122",N:"<div class=\"center\"><div class=\"left\"><p>Provide the comparative and superlative forms of this adjective:</p></div><span class=\"italic\">mager</span> (skinny, thin)</div>",E:"<div class=\"center\">mager, magrere, magrest</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">Adjectives ending in -EL, -EN, or -ER lose the E in the comparative and superlative forms.</div></div>",A:"E"},{DECK_ID:"B05",ID:"B05123",N:"<div class=\"center\">kort,<br>kort, korte<br>kortere, kortest</div>",E:"<div class=\"center\">short</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">Bear in mind that the noun <span class=\"italic\">et kort</span> means \"a card\" (as in \"bank card\" or \"credit card\").</div></div>",A:"N"},{DECK_ID:"B05",ID:"B05124",N:"<div class=\"center\">tynn,<br>tynt, tynne<br>tynnere, tynnest</div>",E:"<div class=\"center\">thin, slim</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">This is the adjective used also for food with low fat content, such as <span class=\"italic\">tynn melk</span> (skimmed milk).</div></div>",A:"N"},{DECK_ID:"B05",ID:"B05125",N:"<div class=\"center\">h\xf8y,<br>h\xf8yt, h\xf8ye<br>h\xf8yere, h\xf8yest</div>",E:"<div class=\"center\">high, tall</div>",D:"INTERMEDIATE ADJECTIVES",X:"",A:"N"},{DECK_ID:"B05",ID:"B05126",N:"<div class=\"center\"><p>List the three forms of this adjective:</p><span class=\"italic\">lilla</span> (lilac)</div>",E:"<div class=\"center\">lilla, lilla, lilla</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\">Some adjectives never change</div>",A:"E"},{DECK_ID:"B05",ID:"B05127",N:"<div class=\"center\">fet,<br>fett, fete<br>fetere, fetest</div>",E:"<div class=\"center\">fat, thick</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><p>Also spelled as:</p><span class=\"italic\"><p>feit, feitt, feite</p>feitere, feitest</span></div>",A:"N"},{DECK_ID:"B05",ID:"B05128",N:"<div class=\"center\">svak (for),<br>svakt, svake,<br>svakere, svakest</div>",E:"<div class=\"center\">weak (about)</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\">Far er svak for godteri.</div>",A:"N"},{DECK_ID:"B05",ID:"B05129",N:"<div class=\"center\">sterk,<br>sterkt, sterke<br>sterkere, sterkest</div>",E:"<div class=\"center\">strong, powerful, solid</div>",D:"INTERMEDIATE ADJECTIVES",X:"",A:"N"},{DECK_ID:"B05",ID:"B05130",N:"<div class=\"center\">farlig (for),<br>farlig, farlige<br>farligere, farligst</div>",E:"<div class=\"center\">dangerous (for)</div>",D:"INTERMEDIATE ADJECTIVES",X:"",A:"N"},{DECK_ID:"B05",ID:"B05131",N:"<div class=\"center\">merkelig,<br>merkelig, merkelige<br>merkeligere, merkeligst</div>",E:"<div class=\"center\">peculiar, noticeable</div>",D:"INTERMEDIATE ADJECTIVES",X:"",A:"N"},{DECK_ID:"B05",ID:"B05132",N:"<div class=\"center\"><p>Translate using adjectives correctly:</p>Go through the middle door</div>",E:"<div class=\"center\"><p>G\xe5 gjennom <b class=\"bold\">midtre</b> d\xf8r</p>G\xe5 gjennom <b class=\"bold\">den midtre</b> d\xf8r<b class=\"bold\">en</b></div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p>Adjectives specifying order and position in a <span class=\"italic\">bestemt</span> context can be used with or without the determiner (before) and the end article (on the noun they refer to). Some of the most used are:</p><p><span class=\"italic\">midtre, nedre, siste, forrige, neste</span></p>The last two are in fact considered determiners.</div></div>",A:"E"},{DECK_ID:"B05",ID:"B05133",N:"<div class=\"center\"><div class=\"left\"><p>Provide the comparative and superlative forms of this adjective:</p></div><span class=\"italic\">n\xe6r</span> (near)</div>",E:"<div class=\"center\">n\xe6r, n\xe6rmere, n\xe6rmest</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">This adjective is irregular in its comparative and superlative forms.</div></div>",A:"E"},{DECK_ID:"B05",ID:"B05134",N:"<div class=\"center\"><div class=\"left\"><p>Provide the comparative and superlative forms of this adjective:</p></div><span class=\"italic\">tung</span> (heavy)</div>",E:"<div class=\"center\">tung, tyngre, tyngst</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p>This adjective is irregular in its comparative and superlative forms.</p>Also, remember that the G is not silent in the superlative form of the adjectives ending in -IG, and it's in fact pronounced as if it was a \"soft K\".</div></div>",A:"E"},{DECK_ID:"B05",ID:"B05135",N:"<div class=\"center\">svart,<br>svart, svarte<br>svartere, svartest</div>",E:"<div class=\"center\">black</div>",D:"INTERMEDIATE ADJECTIVES",X:"",A:"N"},{DECK_ID:"B05",ID:"B05136",N:"<div class=\"center\">forsiktig (med),<br>forsiktig, forsiktige<br>forsiktigere, forsiktigst</div>",E:"<div class=\"center\">careful (about), attentive (to)</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">Man m\xe5 v\xe6re forsiktig med is p\xe5 gata</div></div>",A:"N"},{DECK_ID:"B05",ID:"B05137",N:"<div class=\"center\">alvorlig,<br>alvorlig, alvorlige<br>alvorligere, alvorligst</div>",E:"<div class=\"center\">serious, severe</div>",D:"INTERMEDIATE ADJECTIVES",X:"",A:"N"},{DECK_ID:"B05",ID:"B05138",N:"<div class=\"center\">trist,<br>trist, triste<br>tristere, tristest</div>",E:"<div class=\"center\">sad</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\">Du ser ganske trist ut</div>",A:"N"},{DECK_ID:"B05",ID:"B05139",N:"<div class=\"center\">sint (over/p\xe5),<br>sint, sinte,<br>sintere, sintest</div>",E:"<div class=\"center\">angry (about/with), enraged</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p>Note that <span class=\"italic\">sint over</span> refers to things, <span class=\"italic\">sint p\xe5</span> to people:</p><span class=\"italic\"><p>Sjefen er sint over at han ikke ble lyttet til</p>Broren min er sint p\xe5 meg</span></div></div>",A:"N"},{DECK_ID:"B05",ID:"B05140",N:"<div class=\"center\">gift (med),<br>gift, gifte,<br>(comparative and superlative<br> are not in use)</div>",E:"<div class=\"center\">married (to)</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">Mora mi har v\xe6rt gift med faren min i 30 \xe5r</div></div>",A:"N"},{DECK_ID:"B05",ID:"B05141",N:"<div class=\"center\">\xe6rlig (med),<br>\xe6rlig, \xe6rlige<br>\xe6rligere, \xe6rligst</div>",E:"<div class=\"center\">honest (about), candid (about)</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">Jeg er \xe6rlig med henhold til kvalifikasjonene mine</div></div>",A:"N"},{DECK_ID:"B05",ID:"B05142",N:"<div class=\"center\">flink (i/med/til),<br>flinkt, flinke,<br>flinkere, flinkest</div>",E:"<div class=\"center\">skilled (at), good (at)</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p>Note that <span class=\"italic\">flink i</span> refers to subjects and disciplines, <span class=\"italic\">flink med</span> supports an object and <span class=\"italic\">flink til</span> is for verbs:</p><span class=\"italic\">Min beste venn er flink i engelsk<br>S\xf8stera mi er flink med barna<br>L\xe6reren er flink til \xe5 hjelpe meg</span></div></div>",A:"N"},{DECK_ID:"B05",ID:"B05143",N:"<div class=\"center\">nyttig,<br>nyttig, nyttige<br>nyttigere, nyttigst</div>",E:"<div class=\"center\">useful, handy</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">Det er fint \xe5 forene det nyttige med det behagelige</div></div>",A:"N"},{DECK_ID:"B05",ID:"B05144",N:"<div class=\"center\">ren,<br>rent, rene<br>renere, renest</div>",E:"<div class=\"center\">clean, pure</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\">Det er ren idioti!</div>",A:"N"},{DECK_ID:"B05",ID:"B05145",N:"<div class=\"center\">vant (til),<br>vant, vante,<br>mer vant, mest vant</div>",E:"<div class=\"center\">used (to), accustomed (to)</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">Hun ble fort vant til det nye rommet sitt</div></div>",A:"N"},{DECK_ID:"B05",ID:"B05146",N:"<div class=\"center\">kjedelig,<br>kjedelig, kjedelige<br>kjedeligere, kjedeligst</div>",E:"<div class=\"center\">boring</div>",D:"INTERMEDIATE ADJECTIVES",X:"",A:"N"},{DECK_ID:"B05",ID:"B05147",N:"<div class=\"center\">fast,<br>fast, faste<br>fastere, fastest</div>",E:"<div class=\"center\">fixed, fastened, permanent</div>",D:"INTERMEDIATE ADJECTIVES",X:"",A:"N"},{DECK_ID:"B05",ID:"B05148",N:"<div class=\"center\">j\xe6vlig,<br>j\xe6vlig, j\xe6vlige<br>j\xe6vligere, j\xe6vligst</div>",E:"<div class=\"center\">bloody, fucking</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">The adjective <span class=\"italic\">j\xe6vla, j\xe6vla, j\xe6vla</span> is similar in meaning but it can only used before nouns, never as a predicative.</div></div>",A:"N"},{DECK_ID:"B05",ID:"B05149",N:"<div class=\"center\">lykkelig (over/for),<br>lykkelig, lykkelige<br>lykkeligere, lykkeligst</div>",E:"<div class=\"center\">happy (about/for)</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p>Note that <span class=\"italic\">lykkelig over</span> refers to things, <span class=\"italic\">lykkelig for</span> to people:</p><span class=\"italic\"><p>Jeg er lykkelig over at jeg fant katten min</p>Bestevenninna mi er lykkelig for meg</span></div></div>",A:"N"},{DECK_ID:"B05",ID:"B05150",N:"<div class=\"center\">lur,<br>lurt, lure<br>lurere, lurest</div>",E:"<div class=\"center\">clever, astute</div>",D:"INTERMEDIATE ADJECTIVES",X:"",A:"N"},{DECK_ID:"B05",ID:"B05151",N:"<div class=\"center\">sur (p\xe5),<br>surt, sure<br>surere, surest</div>",E:"<div class=\"center\">sour, (angry with)</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\">Kj\xe6resten min er litt sur p\xe5 meg</div>",A:"N"},{DECK_ID:"B05",ID:"B05152",N:"<div class=\"center\">s\xf8t,<br>s\xf8tt, s\xf8te<br>s\xf8tere, s\xf8test</div>",E:"<div class=\"center\">sweet, cute</div>",D:"INTERMEDIATE ADJECTIVES",X:"",A:"N"},{DECK_ID:"B05",ID:"B05153",N:"<div class=\"center\">v\xe5t,<br>v\xe5tt, v\xe5te<br>v\xe5tere, v\xe5test</div>",E:"<div class=\"center\">wet, soaked</div>",D:"INTERMEDIATE ADJECTIVES",X:"",A:"N"},{DECK_ID:"B05",ID:"B05154",N:"<div class=\"center\">t\xf8rr,<br>t\xf8rt, t\xf8rre<br>t\xf8rrere, t\xf8rrest</div>",E:"<div class=\"center\">dry</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">The Norwegian word for \"dried\" would be <span class=\"italic\">t\xf8rket</span>, the past participle of the verb <span class=\"italic\">\xe5 t\xf8rke, t\xf8rker, t\xf8rket, har t\xf8rket</span>.</div></div>",A:"N"},{DECK_ID:"B05",ID:"B05155",N:"<div class=\"center\">gravid,<br>gravid, gravide<br>(comparative and superlative<br> are not in use)</div>",E:"<div class=\"center\">pregnant</div>",D:"INTERMEDIATE ADJECTIVES",X:"",A:"N"},{DECK_ID:"B05",ID:"B05156",N:"<div class=\"center\">lovlig,<br>lovlig, lovlige<br>mer lovlig, mest lovlig</div>",E:"<div class=\"center\">legal, permitted, allowed</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p>Note that the noun <span class=\"italic\">lov</span> (i.e. \"law\") is often used instead of the adjective:</p></div><span class=\"italic\">Er det lov \xe5 spise her?</span><br>Is it permitted to eat here?</div>",A:"N"},{DECK_ID:"B05",ID:"B05157",N:"<div class=\"center\">redd (for),<br>redd, redde,<br>reddere, reddest</div>",E:"<div class=\"center\">scared (of)</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\">Mamma er redd for mus</div>",A:"N"},{DECK_ID:"B05",ID:"B05158",N:"<div class=\"center\">heldig (med/i),<br>heldig, heldige,<br>heldigere, heldigst</div>",E:"<div class=\"center\">lucky (with/at)</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Med</span> is to be used for specific instances, <span class=\"italic\">i</span> for recurrent situations:</p><span class=\"italic\"><p>Vi var heldige med vaeret</p>Jeg er vanligvis heldig i kortspill</span></div></div>",A:"N"},{DECK_ID:"B05",ID:"B05159",N:"<div class=\"center\">h\xf8flig (mot),<br>h\xf8flig, h\xf8flige<br>h\xf8fligere, h\xf8fligst</div>",E:"<div class=\"center\">polite (to/towards)</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">Sjefen er alltid h\xf8flig mot arbeiderne</div></div>",A:"N"},{DECK_ID:"B05",ID:"B05160",N:"<div class=\"center\">stolt (av/over),<br>stolt, stolte,<br>stoltere, stoltest</div>",E:"<div class=\"center\">proud (of)</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p>The preposition is <span class=\"italic\">av</span> when the object is people and <span class=\"italic\">over</span> when it is things or verbs:</p><span class=\"italic\"><p>Jeg er stolt av deg!</p>Hun var stolt over \xe5 ha fullf\xf8rt l\xf8pet</span></div></div>",A:"N"},{DECK_ID:"B05",ID:"B05161",N:"<div class=\"center\">streng (med),<br>strengt, strenge,<br>strengere, strengest</div>",E:"<div class=\"center\">strict (with), harsh</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\">Hun er streng med barna sine</div>",A:"N"},{DECK_ID:"B05",ID:"B05162",N:"<div class=\"center\">utrolig,<br>utrolig, utrolige<br>mer utrolig, mest utrolig</div>",E:"<div class=\"center\">unbelievable, incredible</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">Note that the positive form of the adjective, <span class=\"italic\">trolig</span> doesn't quite mean \"believable\", but rather \"likely\" and is often used as an adverb meaning \"probably\" or \"realistically\".</div></div>",A:"N"},{DECK_ID:"B05",ID:"B05163",N:"<div class=\"center\">deilig,<br>deilig, deilige<br>deiligere, deiligst</div>",E:"<div class=\"center\">delightful, delicious</div>",D:"INTERMEDIATE ADJECTIVES",X:"",A:"N"},{DECK_ID:"B05",ID:"B05164",N:"<div class=\"center\">nydelig,<br>nydelig, nydelige<br>nydeligere, nydeligst</div>",E:"<div class=\"center\">marvellous, beautiful, wonderful</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p>This adjective is often used for visuals and for food.</p>Do not mistake it for <span class=\"italic\">nylig</span> (recent).</div></div>",A:"N"},{DECK_ID:"B05",ID:"B05165",N:"<div class=\"center\">bekymret (for/over), <br>bekymret, bekymrede,<br>mer bekymret, mest bekymret</div>",E:"<div class=\"center\">worried (for/about)</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p>Er du bekymret for barna dine?</p>Jeg er sv\xe6rt bekymret over ekstremistene</div></div>",A:"N"},{DECK_ID:"B05",ID:"B05166",N:"<div class=\"center\">ensom,<br>ensomt, ensomme<br>ensommere, ensomst</div>",E:"<div class=\"center\">lonely</div>",D:"INTERMEDIATE ADJECTIVES",X:"",A:"N"},{DECK_ID:"B05",ID:"B05167",N:"<div class=\"center\">typisk (for),<br>typisk, typiske,<br>mer typisk, mest typisk</div>",E:"<div class=\"center\">typical (of)</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">H\xf8y fuktighet er typisk for oktober og november</div></div>",A:"N"},{DECK_ID:"B05",ID:"B05168",N:"<div class=\"center\">skitten,<br>skittent, skitne<br>skitnere, skitnest</div>",E:"<div class=\"center\">soiled, dirty (also in a figurative sense)</div>",D:"INTERMEDIATE ADJECTIVES",X:"",A:"N"},{DECK_ID:"B05",ID:"B05169",N:"<div class=\"center\">lat,<br>lat, late,<br>latere, latest</div>",E:"<div class=\"center\">lazy, idle</div>",D:"INTERMEDIATE ADJECTIVES",X:"",A:"N"},{DECK_ID:"B05",ID:"B05170",N:"<div class=\"center\">kvalm (av),<br>kvalmt, kvalme,<br>kvalmere, kvalmest</div>",E:"<div class=\"center\">sickened (by), disgusted (by)</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\">Morfar ble kvalm av lukten</div>",A:"N"},{DECK_ID:"B05",ID:"B05171",N:"<div class=\"center\">ordentlig,<br>ordentlig, ordentlige<br>(comparative and superlative<br> are not in use)</div>",E:"<div class=\"center\">proper</div>",D:"INTERMEDIATE ADJECTIVES",X:"",A:"N"},{DECK_ID:"B05",ID:"B05172",N:"<div class=\"center\">ryddig,<br>ryddig, ryddige<br>ryddigere, ryddigst</div>",E:"<div class=\"center\">tidy, orderly</div>",D:"INTERMEDIATE ADJECTIVES",X:"",A:"N"},{DECK_ID:"B05",ID:"B05173",N:"<div class=\"center\">p\xe5litelig,<br>p\xe5litelig, p\xe5litelige<br>mer p\xe5litelig, mest p\xe5litelig</div>",E:"<div class=\"center\">reliable, trustworthy, sound</div>",D:"INTERMEDIATE ADJECTIVES",X:"",A:"N"},{DECK_ID:"B05",ID:"B05174",N:"<div class=\"center\">vid,<br>vidt, vide<br>videre, videst</div>",E:"<div class=\"center\">wide, far, broad</div>",D:"INTERMEDIATE ADJECTIVES",X:"",A:"N"},{DECK_ID:"B05",ID:"B05175",N:"<div class=\"center\">smal,<br>smalt, smale<br>smalere, smalest</div>",E:"<div class=\"center\">narrow</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\">Du vil finne en smal gate</div>",A:"N"},{DECK_ID:"B05",ID:"B05176",N:"<div class=\"center\">trang,<br>trangt, trange<br>trangere, trangest</div>",E:"<div class=\"center\">tight</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\">Disse buksene er for trange</div>",A:"N"},{DECK_ID:"B05",ID:"B05177",N:"<div class=\"center\">hemmelig (for), <br>hemmelig, hemmelige, <br>mer hemmelig, mest hemmelig</div>",E:"<div class=\"center\">secret (from)</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">V\xe6r s\xe5 snill \xe5 hold det hemmelig for Malene! </div></div>",A:"N"},{DECK_ID:"B05",ID:"B05178",N:"<div class=\"center\">nysgjerrig (p\xe5), <br>nysgjerrig, nysgjerrige, <br>mer nysgjerrig, mest nysgjerrig</div>",E:"<div class=\"center\">curious (about)</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Jeg er nysgjerrig p\xe5 hva som skjedde med dere to i g\xe5r kveld</span></p>Pronounce this adjective as if the first G was a K, thus giving you the SKJ cluster: NY-SKJER-RI</div></div>",A:"N"},{DECK_ID:"B05",ID:"B05179",N:"<div class=\"center\">blid,<br>blidt, blide<br>blidere, blidest</div>",E:"<div class=\"center\">happy, merry</div>",D:"INTERMEDIATE ADJECTIVES",X:"<div class=\"center\"><div class=\"left\">The adjective <span class=\"italic\">blid</span> refers to outer appearance.</div></div>",A:"N"},{DECK_ID:"B05",ID:"B05180",N:"<div class=\"center\">rolig,<br>rolig, rolige, <br>roligere, roligst</div>",E:"<div class=\"center\">quiet, silent</div>",D:"INTERMEDIATE ADJECTIVES",X:"",A:"N"},{DECK_ID:"B06",ID:"B06001",N:"<div class=\"center\">min, mitt, mine</div>",E:"<div class=\"center\">my, mine</div>",D:"POSSESSIVES",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Min</span> and its variations cover both the possessive adjective (i.e. \"my\") and the possessive pronoun (i.e. \"mine\") of English.</p><span class=\"italic\">Mi</span> is the feminine form.</div></div>",A:"N"},{DECK_ID:"B06",ID:"B06002",N:"<div class=\"center\"><div class=\"left\"><p>Translate the sentence using possessives in the two possible ways:</p></div>My wife is a doctor</div>",E:"<div class=\"center\"><p>Kona mi er lege</p>Min kone er lege</div>",D:"POSSESSIVES",X:"<div class=\"center\"><div class=\"left\"><p>The first construction (definite noun + possessive) is the most common, colloquial and \"progressive\".</p>The second one (possessive + indefinite noun) is more formal, \"conservative\" and can be used to focus on the possessive.</div></div>",A:"E"},{DECK_ID:"B06",ID:"B06003",N:"<div class=\"center\">din, ditt, dine</div>",E:"<div class=\"center\">your, yours (singular)</div>",D:"POSSESSIVES",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Din</span> and its variations cover both the possessive adjective (i.e. \"your\") and the possessive pronoun (i.e. \"yours\") of English.</p><span class=\"italic\">Di</span> is the feminine form.</div></div>",A:"N"},{DECK_ID:"B06",ID:"B06004",N:"<div class=\"center\"><div class=\"left\"><p>Translate the sentence using possessives in the two possible ways:</p></div>My husband is an engineer</div>",E:"<div class=\"center\"><p>Mannen min er ingeni\xf8r</p>Min mann er ingeni\xf8r</div>",D:"POSSESSIVES",X:"<div class=\"center\"><div class=\"left\"><p>The first construction (definite noun + possessive) is the most common, colloquial and \"progressive\".</p>The second one (possessive + indefinite noun) is more formal, \"conservative\" and can be used to focus on the possessive.</div></div>",A:"E"},{DECK_ID:"B06",ID:"B06005",N:"<div class=\"center\"><div class=\"left\"><p>Translate using adjectives (and possessives) in the two possible ways:</p></div>My new guitar is a Gibson</div>",E:"<div class=\"center\"><p>Den nye gitaren min er en Gibson</p>Min nye gitar er en Gibson</div>",D:"POSSESSIVES",X:"<div class=\"center\"><div class=\"left\">When you choose the more conservative construction, the adjective that comes after the possessive takes the definite/plural form (the noun does not, however).</div></div>",A:"E"},{DECK_ID:"B06",ID:"B06006",N:"<div class=\"center\"><p>Translate using S-genitive correctly:</p>The director's secretary has gone for the day</div>",E:"<div class=\"center\">Direkt\xf8rens sekret\xe6r har g\xe5tt for dagen</div>",D:"POSSESSIVES",X:"<div class=\"center\"><div class=\"left\">Nouns with the \"S genitive\" work as possessives, so the noun that follows has to be in the indefinite form, much like in English.<br>But remember that there is no apostrophe between the noun and the S.</div></div>",A:"E"},{DECK_ID:"B06",ID:"B06007",N:"<div class=\"center\"><div class=\"left\"><p>Translate using adjectives (and possessives) in the two possible ways:</p></div>Your new neighbours are nice</div>",E:"<div class=\"center\"><p>De nye naboene dine er hyggelige</p>Dine nye naboer er hyggelige</div>",D:"POSSESSIVES",X:"<div class=\"center\"><div class=\"left\">When you choose the more conservative construction, the adjective that comes after the possessive takes the definite/plural form (the noun does not, however).</div></div>",A:"E"},{DECK_ID:"B06",ID:"B06008",N:"<div class=\"center\">hans, hans, hans</div>",E:"<div class=\"center\">his</div>",D:"POSSESSIVES",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">Hans</span> is both the possessive adjective and the possessive pronoun.</div></div>",A:"N"},{DECK_ID:"B06",ID:"B06009",N:"<div class=\"center\">hennes, hennes, hennes</div>",E:"<div class=\"center\">her, hers</div>",D:"POSSESSIVES",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">Hennes</span> is both the possessive adjective and the possessive pronoun.</div></div>",A:"N"},{DECK_ID:"B06",ID:"B06010",N:"<div class=\"center\">sin, sitt, sine</div>",E:"<div class=\"center\">his (own)<br>her (own)<br>its (own)<br>their (own)</div>",D:"POSSESSIVES",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Sin</span> and its variations are a different possessive adjective/pronoun that must be used in specific situations (more on this in the following cards of this topic).</p><span class=\"italic\">Si</span> is the feminine form.</div></div>",A:"N"},{DECK_ID:"B06",ID:"B06011",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>She went home with <b class=\"bold\">her</b> coat</div>",E:"<div class=\"center\"><p>Hun dro hjem med jakka <b class=\"bold\">si</b></p>Hun dro hjem med <b class=\"bold\">sin</b> jakke</div>",D:"POSSESSIVES",X:"<div class=\"center\"><div class=\"left\">\"His/her/its\" must be translated with <span class=\"italic\">sin</span> (and its variations) when the possessive refers to the <b class=\"bold\">object</b> of the sentence and the <b class=\"bold\">\"owner\" is the subject.</b><br>If the English version could work with \"his/her/its/their own\", then <span class=\"italic\">sin</span> (and variations) should be used.</div></div>",A:"E"},{DECK_ID:"B06",ID:"B06012",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>She went home with <b class=\"bold\">his</b> coat</div>",E:"<div class=\"center\"><p>Hun dro hjem med jakka <b class=\"bold\">hans</b></p>Hun dro hjem med <b class=\"bold\">hans</b> jakke</div>",D:"POSSESSIVES",X:"<div class=\"center\"><div class=\"left\">\"His/her\" must be translated with <span class=\"italic\">hans/hennes</span> when the possessive refers to the <b class=\"bold\">object</b> of the sentence but the <b class=\"bold\">\"owner\" is another entity, which is not the subject.</b></div></div>",A:"E"},{DECK_ID:"B06",ID:"B06013",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>The children are playing with <b class=\"bold\">their</b> dog</div>",E:"<div class=\"center\">Barna leker med hunden <b class=\"bold\">sin</b></div>",D:"POSSESSIVES",X:"<div class=\"center\"><div class=\"left\"><p>The Norwegian possessives must match the object of the possession in gender and in number.</p>So, even if the \"children\" are many, you use <span class=\"italic\">sin</span> (and not <span class=\"italic\">sine</span>) because there is only one dog.</div></div>",A:"E"},{DECK_ID:"B06",ID:"B06014",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>Magne gave me <b class=\"bold\">his</b> records</div>",E:"<div class=\"center\">Magne ga meg platene <b class=\"bold\">sine</b></div>",D:"POSSESSIVES",X:"<div class=\"center\"><div class=\"left\"><p>The Norwegian possessives must match the object of the possession in gender and in number.</p>So, even if \"Magne\" is just one person, you use <span class=\"italic\">sine</span> because the records are many.</div></div>",A:"E"},{DECK_ID:"B06",ID:"B06015",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p><b class=\"bold\">Her</b> husband is a celebrity in Norway</div>",E:"<div class=\"center\">Mannen <b class=\"bold\">hennes</b> er kjendis i Norge</div>",D:"POSSESSIVES",X:"<div class=\"center\"><div class=\"left\"><p>\"His/her\" must be translated with <span class=\"italic\">hans/hennes</span> when the possessive refers to the <b class=\"bold\">subject</b> of the sentence (i.e. <span class=\"italic\">mannen</span>).</p>Basically, the reflexive <span class=\"italic\">sin/sitt/sine</span> is never with the subject.</div></div>",A:"E"},{DECK_ID:"B06",ID:"B06016",N:"<div class=\"center\">v\xe5r, v\xe5rt, v\xe5re</div>",E:"<div class=\"center\">our, ours</div>",D:"POSSESSIVES",X:"",A:"N"},{DECK_ID:"B06",ID:"B06017",N:"<div class=\"center\">deres, deres, deres</div>",E:"<div class=\"center\"><p>your, yours (plural)</p>their, theirs</div>",D:"POSSESSIVES",X:"<div class=\"center\"><span class=\"italic\">deres</span> translates also \"their, theirs\"</div>",A:"N"},{DECK_ID:"B06",ID:"B06018",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p><b class=\"bold\">Their</b> products are better</div>",E:"<div class=\"center\"><p>Produktene <b class=\"bold\">deres</b> er bedre</p><b class=\"bold\">Deres</b> produkter er bedre</div>",D:"POSSESSIVES",X:"<div class=\"center\"><div class=\"left\"><p>\"His/her/their\" must be translated with <span class=\"italic\">hans/hennes/deres</span> when the possessive refers to the <b class=\"bold\">subject</b> of the sentence (i.e. <span class=\"italic\">produktene</span>).</p>Basically, the reflexive <span class=\"italic\">sin/sitt/sine</span> can never be with the subject.</div></div>",A:"E"},{DECK_ID:"B06",ID:"B06019",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>\xd8ystein visits <b class=\"bold\">his</b> friend Ragna</div>",E:"<div class=\"center\"><p>\xd8ystein bes\xf8ker venninna <b class=\"bold\">si</b> Ragna</p>\xd8ystein bes\xf8ker <b class=\"bold\">sin</b> venninne Ragna</div>",D:"POSSESSIVES",X:"<div class=\"center\"><div class=\"left\">\"His/her\" must be translated with <span class=\"italic\">sin</span> (and its variations) when the possessive refers to the <b class=\"bold\">object</b> of the sentence and the <b class=\"bold\">\"owner\" is the subject.</b></div></div>",A:"E"},{DECK_ID:"B06",ID:"B06020",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>\xd8ystein and <b class=\"bold\">his</b> friend Ragna visit J\xf8rn</div>",E:"<div class=\"center\"><p>\xd8ystein og venninna <b class=\"bold\">hans</b> Ragna bes\xf8ker J\xf8rn</p>\xd8ystein og <b class=\"bold\">hans</b> venninne Ragna bes\xf8ker J\xf8rn</div>",D:"POSSESSIVES",X:"<div class=\"center\"><div class=\"left\"><p>\"His/her\" must be translated with <span class=\"italic\">hans/hennes</span> when the possessive puts in relation <b class=\"bold\">two subjects</b> of the sentence, because <b class=\"bold\">the reflexive can never be with the subject</b>.</p>Note that in this case the possessive matches the owner in gender and number, not the object.</div></div>",A:"E"},{DECK_ID:"B06",ID:"B06021",N:"<div class=\"center\">deres, deres, deres</div>",E:"<div class=\"center\"><p>their, theirs</p>your, yours (plural)</div>",D:"POSSESSIVES",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">deres</span> translates also \"your, yours (plural)\"</div></div>",A:"N"},{DECK_ID:"B06",ID:"B06022",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>The employees are worried about <b class=\"bold\">their</b> jobs</div>",E:"<div class=\"center\">De ansatte er bekymret over jobbene <b class=\"bold\">sine</b></div>",D:"POSSESSIVES",X:"<div class=\"center\"><div class=\"left\">\"His/her/its\"/their must be translated with <span class=\"italic\">sin</span> (and its variations) when the possessive refers to the <b class=\"bold\">object</b> of the sentence and the <b class=\"bold\">\"owner\" is the subject.</b></div></div>",A:"E"},{DECK_ID:"B06",ID:"B06023",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>The employees are worried because they can lose <b class=\"bold\">their</b> jobs</div>",E:"<div class=\"center\">De ansatte er bekymret fordi de kan miste jobbene <b class=\"bold\">sine</b></div>",D:"POSSESSIVES",X:"<div class=\"center\"><div class=\"left\">In the subordinate clause (introduced by <span class=\"italic\">fordi</span>), \"the jobs\" are the <b class=\"bold\">object</b>, so the reflexive is to be used.</div></div>",A:"E"},{DECK_ID:"B06",ID:"B06024",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>The employees are worried because <b class=\"bold\">their</b> jobs are in danger</div>",E:"<div class=\"center\">De ansatte er bekymret fordi jobbene <b class=\"bold\">deres</b> er i fare</div>",D:"POSSESSIVES",X:"<div class=\"center\"><div class=\"left\">In the subordinate clause (introduced by <span class=\"italic\">fordi</span>), \"the jobs\" are the <b class=\"bold\">subject</b>, so <span class=\"italic\">hans/hennes/deres</span> is to be used.</div></div>",A:"E"},{DECK_ID:"B06",ID:"B06025",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>The boy I talked to gave me <b class=\"bold\">his</b> number</div>",E:"<div class=\"center\">Gutten jeg snakket med, ga meg nummeret <b class=\"bold\">sitt</b></div>",D:"POSSESSIVES",X:"<div class=\"center\"><div class=\"left\">\"His/her/its\" must be translated with <span class=\"italic\">sin</span> (and its variations) when the possessive refers to the <b class=\"bold\">object</b> of the sentence and the <b class=\"bold\">\"owner\" is the subject.</b></div></div>",A:"E"},{DECK_ID:"B06",ID:"B06026",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>My parents have sold <b class=\"bold\">their</b> house</div>",E:"<div class=\"center\">Foreldrene mine har solgt huset <b class=\"bold\">sitt</b></div>",D:"POSSESSIVES",X:"<div class=\"center\"><div class=\"left\"><p>The Norwegian possessives must match the object of the possession in gender and in number.</p>So, even if the parents are plural, you use <span class=\"italic\">sitt</span> because there is only one house (which is <span class=\"italic\">intetkj\xf8nn</span>).</div></div>",A:"E"},{DECK_ID:"B06",ID:"B06027",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p><b class=\"bold\">Our</b> old colleagues were very nice</div>",E:"<div class=\"center\">De gamle kollegaene <b class=\"bold\">v\xe5re</b> var veldig hyggelige</div>",D:"POSSESSIVES",X:"<div class=\"center\"><div class=\"left\"><p>The Norwegian possessives must match the object of the possession in gender and in number.</p>So, the combination of first person plural \"owner\" (implied by \"our\" in English) and plural object (\"colleague<b class=\"bold\">s</b>\") requires <span class=\"italic\">v\xe5re</span>.</div></div>",A:"E"},{DECK_ID:"B06",ID:"B06028",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>My sister and <b class=\"bold\">her</b> new boyfriend are going to the movies</div>",E:"<div class=\"center\">S\xf8stera mi og den nye kj\xe6resten <b class=\"bold\">hennes</b> drar p\xe5 kino</div>",D:"POSSESSIVES",X:"<div class=\"center\"><div class=\"left\"><p>\"His/her\" must be translated with <span class=\"italic\">hans/hennes</span> when the possessive puts in relation <b class=\"bold\">two subjects</b> of the sentence.</p>Note that in this case the possessive matches the owner in gender and number, not the object.</div></div>",A:"E"},{DECK_ID:"B06",ID:"B06029",N:"<div class=\"center\">dens, dens, dens</div>",E:"<div class=\"center\">its (for <span class=\"italic\">hankj\xf8nn</span> nouns)</div>",D:"POSSESSIVES",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">I dag snakker vi om melk og dens egenskaper</span></p>Today, we talk about milk and its characteristics</div></div>",A:"N"},{DECK_ID:"B06",ID:"B06030",N:"<div class=\"center\">dets, dets, dets</div>",E:"<div class=\"center\">its (for <span class=\"italic\">intetkj\xf8nn</span> nouns)</div>",D:"POSSESSIVES",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Landet og dets innbyggere</span></p>The country and its inhabitants</div></div>",A:"N"},{DECK_ID:"B06",ID:"B06031",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>Hey guys, <b class=\"bold\">your</b> things are all over the place!</div>",E:"<div class=\"center\">Hei dere! Tingene <b class=\"bold\">deres</b> ligger overalt!</div>",D:"POSSESSIVES",X:"<div class=\"center\"><div class=\"left\">The initial expression makes it clear that we are referring to a second person plural (i.e. \"you guys\"), so the possessive has to be be <span class=\"italic\">deres</span>, not <span class=\"italic\">dine</span>.</div></div>",A:"E"},{DECK_ID:"B06",ID:"B06032",N:"<div class=\"center\"><p>Translate focusing on the differences:</p>Yngvil arrived with her brother<br>Yngvil and her brother arrived</div>",E:"<div class=\"center\"><p>Yngvil kom med broren <b class=\"bold\">sin</b></p>Yngvil og broren <b class=\"bold\">hennes</b> kom</div>",D:"POSSESSIVES",X:"<div class=\"center\"><div class=\"left\"><p>In the first sentence you must use <span class=\"italic\">sin</span> because the brother is the \"object\" of the \"possession\".</p>In the second sentence you must use <span class=\"italic\">hennes</span> because the brother also performs the action of arriving, so he is the subject too.</div></div>",A:"E"},{DECK_ID:"B06",ID:"B06033",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p><b class=\"bold\">Our</b> new house and <b class=\"bold\">their</b> new houses are different</div>",E:"<div class=\"center\">Det nye huset <b class=\"bold\">v\xe5rt</b> og de nye husene <b class=\"bold\">deres</b> er forskjellige</div>",D:"POSSESSIVES",X:"<div class=\"center\"><div class=\"left\"><p>\"their\" must be translated with <span class=\"italic\">deres</span> when the possessive puts in relation <b class=\"bold\">two subjects</b> of the sentence.</p></div></div>",A:"E"},{DECK_ID:"B06",ID:"B06034",N:"<div class=\"center\"><p>Translate the genitive with the reflexive possessive:</p>Morten<b class=\"bold\">'s</b> friends</div>",E:"<div class=\"center\">Morten <b class=\"bold\">sine</b> venner</div>",D:"POSSESSIVES",X:"<div class=\"center\"><div class=\"left\"><p>Using <span class=\"italic\">sin/si/sitt/sine</span> instead of the genitive with S is a possibility in the spoken language.</p>Originally dialectal, this construction is now normal in colloquial Norwegian.</div></div>",A:"E"},{DECK_ID:"B06",ID:"B06035",N:"<div class=\"center\"><p>Translate the genitive with the reflexive possessive:</p>Johanne<b class=\"bold\">'s</b> house</div>",E:"<div class=\"center\">Johanne <b class=\"bold\">sitt</b> hus</div>",D:"POSSESSIVES",X:"<div class=\"center\"><div class=\"left\"><p>Using <span class=\"italic\">sin/si/sitt/sine</span> instead of the genitive with S is a possibility in the spoken language.</p>Originally dialectal, this construction is now normal in colloquial Norwegian.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07001",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p><b class=\"bold\">This</b> record is my favourite</div>",E:"<div class=\"center\"><b class=\"bold\">Denne</b> platen er min favoritt</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">denne/dette/disse</span> is used for something that is close or whose identity is obvious.</p>The definite form of the noun is needed.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07002",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p><b class=\"bold\">This</b> glass is mine</div>",E:"<div class=\"center\"><b class=\"bold\">Dette</b> glasset er mitt</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">denne/dette/disse</span> is used for something that is close or whose identity is obvious.</p>The definite form of the noun is needed.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07003",N:"<div class=\"center\">meg</div>",E:"<div class=\"center\">me</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Bli med meg!</span> (Come with me/Join me!)</p><p>Reflexive meaning is also possible:</p><span class=\"italic\">Jeg har f\xe5tt meg hund</span> (I have got myself a dog)</div></div>",A:"N"},{DECK_ID:"B07",ID:"B07004",N:"<div class=\"center\">deg</div>",E:"<div class=\"center\">you (object, singular)</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Jeg er glad i deg</span> (I like you)</p><p>Reflexive use is also possible:</p><span class=\"italic\">Finn deg en hobby!</span> (Find yourself a hobby!)</div></div>",A:"N"},{DECK_ID:"B07",ID:"B07005",N:"<div class=\"center\">selv</div>",E:"<div class=\"center\">self</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><p>Remember that the V is silent and prolongs the L.</p>The spelling <span class=\"italic\">sj\xf8l</span> is also possible, it is considered a bit more progressive.</div></div>",A:"N"},{DECK_ID:"B07",ID:"B07006",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>I don't like to talk about <b class=\"bold\">myself</b></div>",E:"<div class=\"center\">Jeg liker ikke \xe5 snakke om <b class=\"bold\">meg selv</b></div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\">Note that Norwegian always uses the object form to create the reflexive possessive (i.e. \"me-self\"), unlike English, which mostly uses the possessive form (i.e. \"my-self\", \"your-self\", \"our-selves\" etc).</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07007",N:"<div class=\"center\">ham</div>",E:"<div class=\"center\">him</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\">Cannot be used as a reflexive</div>",A:"N"},{DECK_ID:"B07",ID:"B07008",N:"<div class=\"center\">henne</div>",E:"<div class=\"center\">her (object)</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\">Cannot be used as a reflexive</div>",A:"N"},{DECK_ID:"B07",ID:"B07009",N:"<div class=\"center\">den, det</div>",E:"<div class=\"center\">it (object)</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\">Cannot be used as a reflexive</div>",A:"N"},{DECK_ID:"B07",ID:"B07010",N:"<div class=\"center\">seg</div>",E:"<div class=\"center\">(him/her/it/they)self</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><p>Used only as reflexive for third persons:</p><p><span class=\"italic\">Han vasket seg</span> (He washed himself)</p><span class=\"italic\">De lo seg i hjel</span><br>(They laughed themselves to death)</div></div>",A:"N"},{DECK_ID:"B07",ID:"B07011",N:"<div class=\"center\">oss</div>",E:"<div class=\"center\">us</div>",D:"PRONOUNS & DETERMINERS",X:"",A:"N"},{DECK_ID:"B07",ID:"B07012",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>We are afraid of being <b class=\"bold\">ourselves</b></div>",E:"<div class=\"center\">Vi er redd for \xe5 v\xe6re <b class=\"bold\">oss selv</b></div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\">Note that Norwegian always uses the object form to create the reflexive possessive (i.e. \"us-selves\"), unlike English, which mostly uses the possessive form (i.e. \"my-self\", \"your-self\", \"our-selves\" etc).</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07013",N:"<div class=\"center\">dere</div>",E:"<div class=\"center\">you (object, plural)</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\">Norwegian requires you to differentiate between the singular \"you\" and the plural \"you\".</div></div>",A:"N"},{DECK_ID:"B07",ID:"B07014",N:"<div class=\"center\">dem</div>",E:"<div class=\"center\">them</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">dem</span> with a capital D is used for the old-fashioned polite form, similar to the French \"vous\" and the Italian \"lei\" (although it is hardly used in Norwegian).</div></div>",A:"N"},{DECK_ID:"B07",ID:"B07015",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>She said it <b class=\"bold\">herself</b></div>",E:"<div class=\"center\">Hun sa det <b class=\"bold\">selv</b></div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">selv</span> is often used alone when it is clear what it refers to.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07016",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>War is the problem <b class=\"bold\">itself</b></div>",E:"<div class=\"center\">Krig er <b class=\"bold\">selve</b> problemet</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">selve</span> can be used to reinforce the idea expressed by the verb, with meanings covering \"itself\", \"the core of\", \"the essence of\".<br>Note that the noun it refers to must be in the definite form.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07017",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p><b class=\"bold\">Whose</b> dog is that?</div>",E:"<div class=\"center\"><p><b class=\"bold\">Hvem eier</b> denne hunden?</p><b class=\"bold\">Hvem sin</b> hund er den?</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><p>There is no direct translation of \"whose\" in everyday Norwegian.</p>The word <span class=\"italic\">hvis</span> was once used as a direct translation of \"whose\" in formal, written Norwegian.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07018",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p><b class=\"bold\">Which</b> flavour do you like?</div>",E:"<div class=\"center\"><b class=\"bold\">Hvilken</b> smak liker du?</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">hvilken</span> is mostly used as an interrogative pronoun meaning \"which, what\".</p>The noun to which it refers is always in the indefinite form.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07019",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p><b class=\"bold\">Which</b> tool should I use?</div>",E:"<div class=\"center\"><b class=\"bold\">Hvilket</b> verkt\xf8y b\xf8r jeg bruke?</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">hvilket</span> is the <span class=\"italic\">intetkj\xf8nn</span> form but the T at the end is pronounced, it is not silent.</p>The noun to which it refers is always in the indefinite form.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07020",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p><b class=\"bold\">Which</b> records are they playing?</div>",E:"<div class=\"center\"><b class=\"bold\">Hvilke</b> plater spiller de?</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">hvilke</span> is the plural form of <span class=\"italic\">hvilken/hvilket</span>.</p>The noun to which it refers is always in the indefinite form.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07021",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p><b class=\"bold\">These</b> clothes are expensive</div>",E:"<div class=\"center\"><b class=\"bold\">Disse</b> kl\xe6rne er dyre</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">denne/dette/disse</span> is used for something that is close or whose identity is obvious.</p>The definite form of the noun is needed.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07022",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>He was driving <b class=\"bold\">that</b> car</div>",E:"<div class=\"center\">Han kj\xf8rte <b class=\"bold\">den</b> bilen</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">den/det/de</span> is used for something far from you or anyway not in direct contact.</p>The definite form of the noun is needed.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07023",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>I have never heard about <b class=\"bold\">that</b> place</div>",E:"<div class=\"center\">Jeg har aldri h\xf8rt om <b class=\"bold\">det</b> stedet</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">den/det/de</span> is used for something far from you or anyway not in direct contact.</p>The definite form of the noun is needed.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07024",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p><b class=\"bold\">Those</b> courses are interesting</div>",E:"<div class=\"center\"><b class=\"bold\">De</b> kursene er interessante</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\">\"Those\" is translated with the personal pronoun <span class=\"italic\">de</span>, which also translates the English \"they\".</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07025",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>They have lived here for <b class=\"bold\">some</b> years</div>",E:"<div class=\"center\">De har bodd her i <b class=\"bold\">noen</b> \xe5r</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">noen</span> translates the English \"some\" for countable nouns.</p>Note how, in this case, it refers to an <span class=\"italic\">intetkj\xf8nn</span> countable noun.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07026",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>We have <b class=\"bold\">some</b> milk in the fridge</div>",E:"<div class=\"center\">Vi har <b class=\"bold\">noe</b> melk i kj\xf8leskapet</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">noe</span> translates the English \"some\" for uncountable nouns.<br>Using <span class=\"italic\">litt</span> is also possible.</p>Note also how, in this case, <span class=\"italic\">noe</span> refers to a <span class=\"italic\">hankj\xf8nn</span> uncountable noun.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07027",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>She will meet <b class=\"bold\">somebody</b></div>",E:"<div class=\"center\">Hun skal treffe <b class=\"bold\">noen</b></div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">noen</span> can be used as subject or object, with the meaning of \"somebody\" or \"anybody\".</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07028",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>I want to eat <b class=\"bold\">something</b></div>",E:"<div class=\"center\">Jeg vil spise <b class=\"bold\">noe</b></div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">noe</span> can be used as subject or object, in which case it means \"something\".</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07029",N:"<div class=\"center\"><p>Translate using adjectives correctly:</p>He's going to win next time</div>",E:"<div class=\"center\"><p>Han kommer til \xe5 vinne <b class=\"bold\">neste</b> gang</p>Han kommer til \xe5 vinne <b class=\"bold\">den neste</b> gang<b class=\"bold\">en</b></div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><p>Adjectives specifying order and position can be used with or without the determiner (before) and the end article (on the noun they refer to). Some of the most used are:</p><p><span class=\"italic\">midtre, nedre, siste, forrige, neste</span>. </p>The last two are in fact considered determiners.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07030",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>I have never got <b class=\"bold\">any</b> explanation</div>",E:"<div class=\"center\">Jeg har aldri f\xe5tt <b class=\"bold\">noen</b> forklaring</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">noen</span> translates the English \"any\" for countable nouns, just like it also translates \"some\" for countable nouns.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07031",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>Do you have <b class=\"bold\">any</b> hope of finding him?</div>",E:"<div class=\"center\">Har du <b class=\"bold\">noe</b> h\xe5p om \xe5 finne ham?</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">noe</span> translates the English \"any\" for uncountable nouns, just like it also translates \"some\" for uncountable nouns.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07032",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p><b class=\"bold\">Nobody</b> came to the party</div>",E:"<div class=\"center\"><b class=\"bold\">Ingen</b> kom til festen</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">ingen</span> can translate \"nobody\" as a pronoun.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07033",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p><b class=\"bold\">Nothing</b> is going to change</div>",E:"<div class=\"center\"><b class=\"bold\">Ingenting</b> kommer til \xe5 endre seg</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">ingenting</span> can translate \"nothing\" as a pronoun.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07034",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>I have <b class=\"bold\">no</b> job</div>",E:"<div class=\"center\">Jeg har <b class=\"bold\">ingen</b> jobb</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">Ingen</span> can translate \"no\" as an adjective for <span class=\"italic\">hankj\xf8nn</span> nouns.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07035",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>She has <b class=\"bold\">no</b> work to do</div>",E:"<div class=\"center\">Hun har <b class=\"bold\">ikke noe</b> arbeid \xe5 gj\xf8re</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><p>Unlike <span class=\"italic\">ingen</span>, <span class=\"italic\">ingenting</span> cannot work as an adjective, so <span class=\"italic\">ikke noe</span> must be used instead.</p>If you notice, <span class=\"italic\">ingenting</span> contains the noun <span class=\"italic\">ting</span>, which makes it a pronoun.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07036",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>It's <b class=\"bold\">no</b> problem</div>",E:"<div class=\"center\">Det er <b class=\"bold\">ikke noe</b> problem</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><p>Theoretically, the <span class=\"italic\">intetkj\xf8nn</span> form of <span class=\"italic\">ingen</span> is <span class=\"italic\">intet</span>.</p>However, it is far more common to use <span class=\"italic\">ikke noe</span> instead, like in the example.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07037",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>He has <b class=\"bold\">no</b> money</div>",E:"<div class=\"center\">Han har <b class=\"bold\">ingen</b> penger</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">Ingen</span> can translate \"no\" as an adjective for <span class=\"italic\">hankj\xf8nn</span> nouns, also for the plural.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07038",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>That doesn't have <b class=\"bold\">any</b> consequences</div>",E:"<div class=\"center\">Det har <b class=\"bold\">ikke noen</b> konsekvenser</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\">\"any\" (for countables) and \"anybody\" translate as <span class=\"italic\">ikke noen</span> or as <span class=\"italic\">ingen</span> in negative sentences</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07039",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>They don't have <b class=\"bold\">any</b> reasons to doubt you</div>",E:"<div class=\"center\">De har <b class=\"bold\">ikke noen</b> grunn til \xe5 tvile p\xe5 deg</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\">\"any\" (for countables) and \"anybody\" translate as <span class=\"italic\">ikke noen</span> or as <span class=\"italic\">ingen</span> in negative sentences</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07040",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>I earn <b class=\"bold\">nothing</b></div>",E:"<div class=\"center\">Jeg tjener <b class=\"bold\">ingenting</b></div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">ingenting</span> can translate \"nothing\" as a pronoun.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07041",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>It's disappointing that I haven't won <b class=\"bold\">anything</b></div>",E:"<div class=\"center\">Det er skuffende at jeg <b class=\"bold\">ikke</b> har vunnet <b class=\"bold\">noe</b></div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><p>In subordinate sentences, <span class=\"italic\">ikke noe</span> must be used all the time instead of <span class=\"italic\">ingenting</span>.</p>Note the position of <span class=\"italic\">ikke</span> due to the subordinate (introduced by <span class=\"italic\">at</span>), which also splits it from the <span class=\"italic\">noe</span>.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07042",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>H\xe5kon, <b class=\"bold\">who</b> is going to Bergen, takes the train</div>",E:"<div class=\"center\">H\xe5kon, <b class=\"bold\">som</b> skal til Bergen, tar toget</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">som</span> is the <b class=\"bold\">relative pronoun</b>, a pronoun that puts two sentences in <b class=\"bold\">relation</b>, such as \"who, that, which\".</p>Here it is used as a subject.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07043",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p><div class=\"left\">The places <b class=\"bold\">that</b> the train passes by are Geilo and Ustaoset</div></div>",E:"<div class=\"center\"><div class=\"left\">De stedene <b class=\"bold\">som</b> toget passerer, er Geilo og Ustaoset</div></div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">som</span> is the <b class=\"bold\">relative pronoun</b>, a pronoun that puts two sentences in <b class=\"bold\">relation</b>, such as \"who, that, which\".</p>Here it is used as an object. In this function, it can be omitted.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07044",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>It was me <b class=\"bold\">who</b> lost the keys</div>",E:"<div class=\"center\">Det var jeg <b class=\"bold\">som</b> mistet n\xf8klene</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">som</span> is the <b class=\"bold\">relative pronoun</b>, a pronoun that puts two sentences in <b class=\"bold\">relation</b>, such as \"who, that, which\".</p>Here it is used as a subject.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07045",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>We haven't met <b class=\"bold\">anybody</b></div>",E:"<div class=\"center\">Vi har <b class=\"bold\">ikke</b> m\xf8tt <b class=\"bold\">noen</b></div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\">When the construction would require <span class=\"italic\">ikke</span> and <span class=\"italic\">noen</span> (or <span class=\"italic\">noe</span>) to have other words between them, then you wouldn't be allowed to use <span class=\"italic\">ingen</span> or <span class=\"italic\">ingenting</span>.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07046",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>They saw <b class=\"bold\">nobody</b> and did <b class=\"bold\">nothing</b></div>",E:"<div class=\"center\"><p>De s\xe5 <b class=\"bold\">ingen</b> og gjorde <b class=\"bold\">ingenting</b></p>De s\xe5 <b class=\"bold\">ikke noen</b> og gjorde <b class=\"bold\">ikke noe</b></div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\">When the sentence uses single verbs, <span class=\"italic\">ingen/ingenting</span> and <span class=\"italic\">ikke noen/ikke noe</span> can be used interchangeably as objects.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07047",N:"<div class=\"center\"><p>Translate focusing on the words in bold:</p><b class=\"bold\">What</b> you see is <b class=\"bold\">what</b> you get</div>",E:"<div class=\"center\"><b class=\"bold\">Det</b> du ser er <b class=\"bold\">det</b> du f\xe5r</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\">Remember that \"what\" translates to <span class=\"italic\">hva</span> mostly in questions, otherwise it is common to use <span class=\"italic\">den/det</span>.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07048",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>There is so <b class=\"bold\">much</b> noise here</div>",E:"<div class=\"center\">Det er s\xe5 <b class=\"bold\">mye</b> br\xe5k her</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">mye</span> works like \"much\", for uncountable nouns. It is also an adverb.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07049",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>I ate <b class=\"bold\">most</b> of the food</div>",E:"<div class=\"center\">Jeg spiste <b class=\"bold\">det meste</b> av maten</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><p>The superlative of <span class=\"italic\">mye</span> is <span class=\"italic\">mest</span> and is often used with the determiner <span class=\"italic\">den/det, de</span> when referring to a noun.</p>The noun it refers to must be in the definite form.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07050",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>There are so <b class=\"bold\">many</b> people here</div>",E:"<div class=\"center\">Det er s\xe5 <b class=\"bold\">mange</b> mennesker her</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">mange</span> works like \"many\", for countable nouns.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07051",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p><b class=\"bold\">Most</b> Norwegians like to ski</div>",E:"<div class=\"center\"><b class=\"bold\">De fleste</b> nordmenn liker \xe5 g\xe5 p\xe5 ski</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\">The superlative of <span class=\"italic\">mange</span> is <span class=\"italic\">flest</span> and is often used with the determiner <span class=\"italic\">de</span> and the definite form when referring to a noun.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07052",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>I have <b class=\"bold\">a little</b> time right now</div>",E:"<div class=\"center\">Jeg har <b class=\"bold\">litt</b> tid akkurat n\xe5</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">litt</span> (invariable and mostly used as an adverb) works like \"a little\", \"a bit\", for uncountable nouns.</p>Don't mistake <span class=\"italic\">litt</span> for <span class=\"italic\">lite</span>, which has a slightly negative meaning (i.e. \"very little\", \"hardly any\").</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07053",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>I have <b class=\"bold\">little</b> time right now</div>",E:"<div class=\"center\">Jeg har <b class=\"bold\">lite</b> tid akkurat n\xe5</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">lite</span> (which is the <span class=\"italic\">intetkj\xf8nn</span> form of the adjective <span class=\"italic\">liten</span>) works like \"little\", \"not much of\", for uncountable nouns.</p>Don't mistake <span class=\"italic\">lite</span> for <span class=\"italic\">litt</span>, which has a positive meaning (i.e. \"quite a bit\", \"a little\").</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07054",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p><b class=\"bold\">Few</b> people live on Svalbard</div>",E:"<div class=\"center\"><b class=\"bold\">F\xe5</b> mennesker bor p\xe5 Svalbard</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">f\xe5</span> works like \"few\", for countable nouns. <br>It is the same word as the verb <span class=\"italic\">\xe5 f\xe5</span>.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07055",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>I have <b class=\"bold\">another</b> job now</div>",E:"<div class=\"center\">Jeg har en <b class=\"bold\">annen</b> jobb n\xe5</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><p>The Norwegian equivalent of \"(an)other, others\" (in the sense of \"a different one\") is <span class=\"italic\">annen, anna, annet, andre</span>.</p>In <span class=\"italic\">annet</span>, the E is silent and the T is pronounced.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07056",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>What's <b class=\"bold\">another</b> word for \"castle\"?</div>",E:"<div class=\"center\">Hva er et <b class=\"bold\">annet</b> ord for \"slott\"?</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><p>The Norwegian equivalent of \"(an)other, others\" (in the sense of \"a different one\") is <span class=\"italic\">annen, anna, annet, andre</span>.</p>In <span class=\"italic\">annet</span>, the E is silent and the T is pronounced.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07057",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>Shall we check <b class=\"bold\">other</b> shops too?</div>",E:"<div class=\"center\">Skal vi sjekke <b class=\"bold\">andre</b> butikker ogs\xe5?</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><p>The Norwegian equivalent of \"(an)other, others\" (in the sense of \"a different one\") is <span class=\"italic\">annen, anna, annet, andre</span>.</p>When referring to a plural noun, the plural form <span class=\"italic\">andre</span> must be used.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07058",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>We drank <b class=\"bold\">all</b> the milk</div>",E:"<div class=\"center\">Vi drakk <b class=\"bold\">all</b> melken</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">all</span> translates \"all\" for <span class=\"italic\">hankj\xf8nn</span> uncountable nouns, usually in their definite form.</p>The <span class=\"italic\">intetkj\xf8nn</span> form is <span class=\"italic\">alt</span>.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07059",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p><b class=\"bold\">All</b> milk contains calcium</div>",E:"<div class=\"center\"><b class=\"bold\">All</b> melk inneholder kalk</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">all/alt</span> is to be used for uncountable nouns according to gender.</p>Note that this example refers to all milk in general as a substance, and therefore <span class=\"italic\">melk</span> is in its indefinite form.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07060",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>She did <b class=\"bold\">all</b> the work</div>",E:"<div class=\"center\">Hun gjorde <b class=\"bold\">alt</b> arbeidet</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">alt</span> translates \"all\" for <span class=\"italic\">intetkj\xf8nn</span> uncountable nouns, usually in their definite form.</p>The <span class=\"italic\">hankj\xf8nn</span> form is <span class=\"italic\">all</span>.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07061",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>I forgot <b class=\"bold\">everything</b></div>",E:"<div class=\"center\">Jeg glemte <b class=\"bold\">alt</b></div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">alt</span> can mean \"everything\" when it stands alone as subject or object</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07062",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>I've tidied up in <b class=\"bold\">both</b> cupboards</div>",E:"<div class=\"center\">Jeg har ryddet opp i <b class=\"bold\">begge</b> skapene</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\">When \"both\" is used without \"and\", Norwegian uses <span class=\"italic\">begge</span>, which in this case is an adjective.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07063",N:"<div class=\"center\"><p>Translate focusing on the words in bold:</p><b class=\"bold\">Both</b> Magnus <b class=\"bold\">and</b> Hannah <br>are sports practitioners</div>",E:"<div class=\"center\"><b class=\"bold\">B\xe5de</b> Magnus <b class=\"bold\">og</b> Hannah <br>er idrettsut\xf8vere</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\">When \"both\" is used with \"and\" (i.e. as a conjunction), Norwegian uses <span class=\"italic\">b\xe5de</span> and <span class=\"italic\">og</span>.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07064",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>It has to be done in one way or <b class=\"bold\">another</b></div>",E:"<div class=\"center\">Det m\xe5 gj\xf8res p\xe5 \xe9n eller <b class=\"bold\">annen</b> m\xe5te</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><p>The Norwegian equivalent of \"(an)other, others\" (in the sense of \"a different one\") is <span class=\"italic\">annen, anna, annet, andre</span>.</p>In <span class=\"italic\">annet</span>, the E is silent and the T is pronounced.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07065",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p><b class=\"bold\">Everything</b> is fine</div>",E:"<div class=\"center\"><b class=\"bold\">Alt</b> er bra</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">alt</span> can mean \"everything\" when it stands alone as subject or object</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07066",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>I've tidied up in <b class=\"bold\">both</b></div>",E:"<div class=\"center\">Jeg har ryddet opp i <b class=\"bold\">begge</b></div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\">When \"both\" is used without \"and\", Norwegian uses <span class=\"italic\">begge</span>, which in this case is a pronoun.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07067",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>- Red wine or white wine? <br>- <b class=\"bold\">Both</b>, please.</div>",E:"<div class=\"center\">- R\xf8dvin eller hvitvin? <br>- <b class=\"bold\">Begge deler</b>, takk.</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">begge deler</span> can be used for two objects (not people) in the indefinite form and for things that have been mentioned before.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07068",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>I moved from one house to <b class=\"bold\">another</b></div>",E:"<div class=\"center\">Jeg flyttet fra et hus til et <b class=\"bold\">annet</b></div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><p>The Norwegian equivalent of \"(an)other, others\" (in the sense of \"a different one\") is <span class=\"italic\">annen, anna, annet, andre</span>.</p>In <span class=\"italic\">annet</span>, the E is silent and the T is pronounced.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07069",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>I have paid <b class=\"bold\">all</b> the bills</div>",E:"<div class=\"center\">Jeg har betalt <b class=\"bold\">alle</b> regningene</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">alle</span> is used to cover a group of countable nouns</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07070",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>Have you asked the <b class=\"bold\">others</b>?</div>",E:"<div class=\"center\">Har du spurt de <b class=\"bold\">andre</b>?</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><p>The Norwegian equivalent of \"(an)other, others\" (in the sense of \"a different one\") is <span class=\"italic\">annen, anna, annet, andre</span>.</p>In <span class=\"italic\">annet</span>, the E is silent and the T is pronounced.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07071",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p><b class=\"bold\">Everybody</b> is welcome</div>",E:"<div class=\"center\"><b class=\"bold\">Alle</b> er velkomne</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">alle</span> can mean \"everybody\" when it stands alone as subject or object.</p>Note that it's a plural pronoun (hence the plural <span class=\"italic\">velkomne</span>), unlike in English, where it takes verbs in the singular (e.g. all <b class=\"bold\">is</b> well).</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07072",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p><div class=\"left\">What about Kari and Sigrid?<br>I have seen <b class=\"bold\">both (of them)</b> at the office.</div></div>",E:"<div class=\"center\"><div class=\"left\">Hva med Kari og Sigrid?<br>Jeg har sett <b class=\"bold\">begge to</b> p\xe5 kontoret.</div></div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">begge to</span> must be used for people and can be used for objects too.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07073",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p><div class=\"left\"><b class=\"bold\">Both</b> Danish, Norwegian and Swedish are Scandinavian languages</div></div>",E:"<div class=\"center\"><div class=\"left\"><b class=\"bold\">B\xe5de</b> dansk, norsk og svensk er skandinaviske spr\xe5k</div></div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">b\xe5de</span> and <span class=\"italic\">og</span> can be used for more than two items</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07074",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p><b class=\"bold\">One</b> shall never say never</div>",E:"<div class=\"center\"><b class=\"bold\">Man</b> skal aldri si aldri</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">man</span> works as \"one\", as an impersonal, generic subject.</p>Do not mistake it for <span class=\"italic\">mann</span> which means \"man\".</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07075",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p><b class=\"bold\">You</b> can say that!<br>(meaning: \"you are right!\")</div>",E:"<div class=\"center\">Det kan <b class=\"bold\">man</b> si!</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">man</span> works as \"one\" or \"you\" as an impersonal, generic subject.</p>Do not mistake it for <span class=\"italic\">mann</span> which means \"man\".</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07076",N:"<div class=\"center\"><p>Translate focusing on the words in bold:</p>What is good for <b class=\"bold\">one</b> <br>is bad for another</div>",E:"<div class=\"center\">Hva som er bra for <b class=\"bold\">en</b> <br>er d\xe5rlig for en annen</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><p>The word <span class=\"italic\">en</span> (normally used as the <span class=\"italic\">hankj\xf8nn</span> indefinite article) is also the version of \"one\" to be used as an object.</p>As such, it is often preceded by a preposition.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07077",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p><b class=\"bold\">One's</b> words can be misunderstood</div>",E:"<div class=\"center\"><b class=\"bold\">Ens</b> ord kan bli misforst\xe5tt</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">En</span> used as a pronoun can take the genitive, whereas <span class=\"italic\">man</span> may not.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07078",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>They live in the <b class=\"bold\">same</b> building as us</div>",E:"<div class=\"center\">De bor i <b class=\"bold\">samme</b> bygning som oss</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">samme</span> means \"(the) same\".<br>It never changes and it can be used alone or with <span class=\"italic\">den/det</span> but <b class=\"bold\">not</b> with <span class=\"italic\">en/ei/et</span>.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07079",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>It's <b class=\"bold\">the same</b></div>",E:"<div class=\"center\">Det er det <b class=\"bold\">samme</b></div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">samme</span> means \"(the) same\".<br>It never changes and it can be used alone or with <span class=\"italic\">den/det</span> but <b class=\"bold\">not</b> with <span class=\"italic\">en/ei/et</span>.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07080",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>Nynorsk is not <b class=\"bold\">the same</b> as bokm\xe5l</div>",E:"<div class=\"center\">Nynorsk er ikke det <b class=\"bold\">samme</b> som bokm\xe5l</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">samme</span> means \"(the) same\".<br>It never changes and it can be used alone or with <span class=\"italic\">den/det</span> but <b class=\"bold\">not</b> with <span class=\"italic\">en/ei/et</span>.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07081",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>I had a teacher <b class=\"bold\">like that</b> last year</div>",E:"<div class=\"center\">Jeg hadde en <b class=\"bold\">s\xe5nn</b> l\xe6rer i fjor</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">s\xe5nn, s\xe5nt, s\xe5nne</span> translates a number of expressions:</p><p>\"such (as), like that, in that way, that kind of\".</p>It is used mostly in spoken language.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07082",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>I have never ever seen <br><b class=\"bold\">such</b> a dress before</div>",E:"<div class=\"center\">Jeg har ikke noensinne sett <br>en <b class=\"bold\">slik</b> kjole f\xf8r</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">slik, slikt, slike</span> translates a number of expressions:</p><p>\"such (as), like that, in that way, that kind of\".</p>It is considered more formal than <span class=\"italic\">s\xe5nn, s\xe5nt, s\xe5nne</span>.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07083",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p><b class=\"bold\">Such</b> is life</div>",E:"<div class=\"center\"><b class=\"bold\">S\xe5nn</b> er livet</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><p>In this case <span class=\"italic\">s\xe5nn</span> is an adverb meaning \"so, such, in this way\".</p>Unlike most adverbs coming from an adjective, this one uses the <span class=\"italic\">hankj\xf8nn</span> form, not the <span class=\"italic\">intetkj\xf8nn</span> form.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07084",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>I phone my boyfriend/girlfriend <b class=\"bold\">every</b> day</div>",E:"<div class=\"center\">Jeg ringer kj\xe6resten min <b class=\"bold\">hver</b> dag</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">hver/hvert</span> means \"each\", \"every\".</p>There is no plural.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07085",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>Do it <b class=\"bold\">like this</b></div>",E:"<div class=\"center\">Gj\xf8r det <b class=\"bold\">slik</b></div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><p>In this case <span class=\"italic\">slik</span> is an adverb meaning \"so, such, in this way\".</p>Unlike most adverbs coming from an adjective, this one uses the <span class=\"italic\">hankj\xf8nn</span> form, not the <span class=\"italic\">intetkj\xf8nn</span> form.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07086",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>Who can like <b class=\"bold\">such</b> a person?</div>",E:"<div class=\"center\">Hvem kan like et <b class=\"bold\">s\xe5nt</b> menneske?</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">s\xe5nn, s\xe5nt, s\xe5nne</span> translates a number of expressions:</p>\"such (as), like that, in that way, that kind of\".</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07087",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>Why do you say <b class=\"bold\">such</b> things to me?</div>",E:"<div class=\"center\">Hvorfor sier du <b class=\"bold\">s\xe5nne</b> ting til meg?</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">s\xe5nn, s\xe5nt, s\xe5nne</span> translates a number of expressions:</p>\"such (as), like that, in that way, that kind of\".</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07088",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>It can happen <b class=\"bold\">any</b> moment</div>",E:"<div class=\"center\">Det kan skje <b class=\"bold\">hvert</b> \xf8yeblikk</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">hver, hvert</span> means \"each\", \"every\" or \"any\".</p>There is no plural.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07089",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>Things <b class=\"bold\">like those</b> make me stronger</div>",E:"<div class=\"center\"><b class=\"bold\">Slike</b> ting gj\xf8r meg sterkere</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">slik, slikt, slike</span> translates a number of expressions:</p><p>\"such (as), like that, in that way, that kind of\".</p>It is considered more formal than <span class=\"italic\">s\xe5nn, s\xe5nt, s\xe5nne</span>.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07090",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p><b class=\"bold\">This is how</b> you save money <br>on your summer holiday</div>",E:"<div class=\"center\"><b class=\"bold\">Slik</b> sparer du penger <br>p\xe5 din sommerferie</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\">When used at the beginning of a sentence, <span class=\"italic\">s\xe5nn/slik</span> is an adverb which can translate as \"this is how\".</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07091",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>We like <b class=\"bold\">each other</b></div>",E:"<div class=\"center\">Vi liker <b class=\"bold\">hverandre</b></div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\">Note that the pronoun <span class=\"italic\">hverandre</span> can be the object but not the subject of a sentence.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07092",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p><div class=\"left\">They have two cats: <b class=\"bold\">one</b> is a Norwegian forest cat</div></div>",E:"<div class=\"center\"><div class=\"left\">De har to katter: <b class=\"bold\">den ene</b> er en norsk skogkatt</div></div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">ene</span> can be considered the definite form of <span class=\"italic\">en/et</span>.</p>It is used to indicate a specific item out of two or more.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07093",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>I have lost <b class=\"bold\">one of the</b> gloves<br>(Literally: I have lost the one glove)</div>",E:"<div class=\"center\">Jeg har mistet <b class=\"bold\">den ene</b> hansken</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">ene</span> can be considered the definite form of <span class=\"italic\">en/et</span>.</p>It is used to indicate a specific item out of two or more.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07094",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>Something to <b class=\"bold\">(each and) everyone</b>'s taste</div>",E:"<div class=\"center\">Noe for <b class=\"bold\">enhver</b> smak</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><p>The determiner <span class=\"italic\">enhver, ethvert</span> translate as \"each and everyone\", \"everyone\", \"any\" and \"every\" when you want to really include every instance or variation.</p>Due to its meaning, there is no plural form.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07095",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>She is <b class=\"bold\">the only one</b> who likes jazz</div>",E:"<div class=\"center\">Hun er <b class=\"bold\">den eneste</b> som liker jazz</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">eneste</span> is the superlative form of <span class=\"italic\">ene</span>. It is preceded by the determiner <span class=\"italic\">den/det, de</span> and translates as \"the only\".</p>Do not mistake it for <span class=\"italic\">bare</span> or <span class=\"italic\">kun</span>, which are adverbs.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07096",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>The reigning champion, <b class=\"bold\">as such</b>, was the favourite</div>",E:"<div class=\"center\">Den regjerende mesteren, <b class=\"bold\">som s\xe5dan</b>, var favoritten</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\">The determiner <span class=\"italic\">s\xe5dan, s\xe5dant, s\xe5danne</span> translate as \"as such\", \"suchlike\", \"thereof\" and is often used with <span class=\"italic\">som</span></div>.</div>",A:"E"},{DECK_ID:"B07",ID:"B07097",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p><b class=\"bold\">Each and every</b> contribution makes a difference</div>",E:"<div class=\"center\"><b class=\"bold\">Ethvert</b> bidrag gj\xf8r en forskjell</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><p>The determiner <span class=\"italic\">enhver, ethvert</span> translates as \"each and everyone\", \"everyone\", \"any\" and \"every\" when you want to really include every instance or variation.</p>Due to its meaning, there is no plural form.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07098",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p><div class=\"left\">He got injured to <b class=\"bold\">one of the</b> eyes<br>(Literally: He got injured to the one eye)</div></div>",E:"<div class=\"center\">Han ble skadet i <b class=\"bold\">det ene</b> \xf8yet</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">ene</span> can be considered the definite form of <span class=\"italic\">en/et</span>.</p>It is used to indicate a specific item out of two or more.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07099",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>Those are <b class=\"bold\">the only</b> books I bought</div>",E:"<div class=\"center\">Disse er <b class=\"bold\">de eneste</b> b\xf8kene jeg kj\xf8pte</div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">eneste</span> is the superlative form of <span class=\"italic\">ene</span>. It is preceded by the determiner <span class=\"italic\">den/det, de</span> and translates as \"the only\".</p>Do not mistake it for <span class=\"italic\">bare</span> or <span class=\"italic\">kun</span>, which are adverbs.</div></div>",A:"E"},{DECK_ID:"B07",ID:"B07100",N:"<div class=\"center\"><p>Translate focusing on the word in bold:</p>She likes sci-fi, dystopia and <b class=\"bold\">suchlikes</b></div>",E:"<div class=\"center\">Hun liker sci-fi, dystopi og <b class=\"bold\">s\xe5dant</b></div>",D:"PRONOUNS & DETERMINERS",X:"<div class=\"center\"><div class=\"left\"><p>The determiner <span class=\"italic\">s\xe5dan, s\xe5dant, s\xe5danne</span> translate as \"as such\", \"suchlike\", \"thereof\" and is often used with <span class=\"italic\">som</span>.</p>In the case of the example above, <span class=\"italic\">s\xe5nt</span> could have been used too.</div>.</div>",A:"E"},{DECK_ID:"B08",ID:"B08001",N:"<div class=\"center\">f\xf8rst/f\xf8rste</div>",E:"<div class=\"center\">1st</div>",D:"NUMBERS & ORDINALS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Hvem kom f\xf8rst?</span></p><p>It can be used with or without the determiner (before) and the end article (on the noun it refers to):</p><span class=\"italic\">Det var f\xf8rste gang jeg gjorde det</span>.</div></div>",A:"N"},{DECK_ID:"B08",ID:"B08002",N:"<div class=\"center\">andre</div>",E:"<div class=\"center\">2nd</div>",D:"NUMBERS & ORDINALS",X:"<div class=\"center\"><div class=\"left\"><p>Ordinal numbers before a noun tend not to require either the determiner before or the end article on the noun:</p><p><span class=\"italic\">Vi bor p\xe5 andre etasje</span></p>Ordinals can be written as the number followed by a dot (<span class=\"italic\">2. etasje</span>) and <span class=\"italic\">andre</span> is also the definite/plural of <span class=\"italic\">annen</span> (meaning \"other\").</div></div>",A:"N"},{DECK_ID:"B08",ID:"B08003",N:"<div class=\"center\">tredje</div>",E:"<div class=\"center\">3rd</div>",D:"NUMBERS & ORDINALS",X:"",A:"N"},{DECK_ID:"B08",ID:"B08004",N:"<div class=\"center\">fjerde</div>",E:"<div class=\"center\">4th</div>",D:"NUMBERS & ORDINALS",X:"<div class=\"center\"><div class=\"left\"><p>Remember that the ER cluster requires the E to be pronounced as if it was \xc6.</p>Moreover, the D is essentially silent.</div></div>",A:"N"},{DECK_ID:"B08",ID:"B08005",N:"<div class=\"center\">femte</div>",E:"<div class=\"center\">5th</div>",D:"NUMBERS & ORDINALS",X:"",A:"N"},{DECK_ID:"B08",ID:"B08006",N:"<div class=\"center\"><p>tjue</p>(tyve)</div>",E:"<div class=\"center\">20</div>",D:"NUMBERS & ORDINALS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">Tyve</span> is a more conservative form which can still be used.</div></div>",A:"N"},{DECK_ID:"B08",ID:"B08007",N:"<div class=\"center\">sjette</div>",E:"<div class=\"center\">6th</div>",D:"NUMBERS & ORDINALS",X:"",A:"N"},{DECK_ID:"B08",ID:"B08008",N:"<div class=\"center\">tjuesju</div>",E:"<div class=\"center\">27</div>",D:"NUMBERS & ORDINALS",X:"<div class=\"center\"><div class=\"left\"><p>Numbers from 21 to 99 (excluding round figures) also have an \"unofficial\" reading which starts from the units and has <span class=\"italic\">og</span> in between:</p></div><p><span class=\"italic\">syvogtyve</span></p><div class=\"left\">This is more common in certain dialects and among older generations.</div></div>",A:"N"},{DECK_ID:"B08",ID:"B08009",N:"<div class=\"center\"><p>sjuende</p>(syvende)</div>",E:"<div class=\"center\">7th</div>",D:"NUMBERS & ORDINALS",X:"<div class=\"center\">The D in the -ENDE ending is silent</div>",A:"N"},{DECK_ID:"B08",ID:"B08010",N:"<div class=\"center\"><p>tretti</p>(tredve)</div>",E:"<div class=\"center\">30</div>",D:"NUMBERS & ORDINALS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">Tredve</span> is an earlier, more conservative form which can still be found.</div></div>",A:"N"},{DECK_ID:"B08",ID:"B08011",N:"<div class=\"center\">\xe5ttende</div>",E:"<div class=\"center\">8th</div>",D:"NUMBERS & ORDINALS",X:"<div class=\"center\">The D in the -ENDE ending is silent</div>",A:"N"},{DECK_ID:"B08",ID:"B08012",N:"<div class=\"center\">tretti\xe5tte</div>",E:"<div class=\"center\">38</div>",D:"NUMBERS & ORDINALS",X:"<div class=\"center\"><div class=\"left\"><p>When the \"unofficial\" reading starts with <span class=\"italic\">fire</span> or <span class=\"italic\">\xe5tte</span>, the final E of either these unit numbers is not pronounced.</p><span class=\"italic\">\xe5tteogtretti</span> is read as if it was <span class=\"italic\">\xe5ttogtretti</span></div></div>",A:"N"},{DECK_ID:"B08",ID:"B08013",N:"<div class=\"center\">niende</div>",E:"<div class=\"center\">9th</div>",D:"NUMBERS & ORDINALS",X:"<div class=\"center\">The D in the -ENDE ending is silent</div>",A:"N"},{DECK_ID:"B08",ID:"B08014",N:"<div class=\"center\">f\xf8rtifire</div>",E:"<div class=\"center\">44</div>",D:"NUMBERS & ORDINALS",X:"<div class=\"center\"><div class=\"left\"><p>When the \"unofficial\" reading starts with <span class=\"italic\">fire</span> or <span class=\"italic\">\xe5tte</span>, the final E of either these unit numbers is not pronounced.</p><span class=\"italic\">fireogf\xf8rti</span> is read as if it was <span class=\"italic\">firogf\xf8rti</span></div></div>",A:"N"},{DECK_ID:"B08",ID:"B08015",N:"<div class=\"center\">tiende</div>",E:"<div class=\"center\">10th</div>",D:"NUMBERS & ORDINALS",X:"<div class=\"center\">The D in the -ENDE ending is silent</div>",A:"N"},{DECK_ID:"B08",ID:"B08016",N:"<div class=\"center\">ellevte</div>",E:"<div class=\"center\">11th</div>",D:"NUMBERS & ORDINALS",X:"<div class=\"center\"><div class=\"left\">Note that the V is pronounced like an F</div></div>",A:"N"},{DECK_ID:"B08",ID:"B08017",N:"<div class=\"center\"><p>f\xf8rtiseks</p>(seksogf\xf8rti)</div>",E:"<div class=\"center\">46</div>",D:"NUMBERS & ORDINALS",X:"<div class=\"center\"><div class=\"left\">To provide you with a more complete learning experience, we have decided to give you the audio of the \"unofficial\" reading for this number.</div></div>",A:"N"},{DECK_ID:"B08",ID:"B08018",N:"<div class=\"center\">tolvte</div>",E:"<div class=\"center\">12th</div>",D:"NUMBERS & ORDINALS",X:"<div class=\"center\"><div class=\"left\">Note that the V is silent and prolongs the sound of the L.</div></div>",A:"N"},{DECK_ID:"B08",ID:"B08019",N:"<div class=\"center\">trettende</div>",E:"<div class=\"center\">13th</div>",D:"NUMBERS & ORDINALS",X:"<div class=\"center\">The D in the -ENDE ending is silent</div>",A:"N"},{DECK_ID:"B08",ID:"B08020",N:"<div class=\"center\">fjortende</div>",E:"<div class=\"center\">14th</div>",D:"NUMBERS & ORDINALS",X:"<div class=\"center\">The D in the -ENDE ending is silent</div>",A:"N"},{DECK_ID:"B08",ID:"B08021",N:"<div class=\"center\">femtende</div>",E:"<div class=\"center\">15th</div>",D:"NUMBERS & ORDINALS",X:"<div class=\"center\">The D in the -ENDE ending is silent</div>",A:"N"},{DECK_ID:"B08",ID:"B08022",N:"<div class=\"center\">femti</div>",E:"<div class=\"center\">50</div>",D:"NUMBERS & ORDINALS",X:"",A:"N"},{DECK_ID:"B08",ID:"B08023",N:"<div class=\"center\">sekstende</div>",E:"<div class=\"center\">16th</div>",D:"NUMBERS & ORDINALS",X:"<div class=\"center\"><div class=\"left\">Note how the EK in <span class=\"italic\">sekstende</span> is pronounced like the EG in <span class=\"italic\">jeg</span>.</div></div>",A:"N"},{DECK_ID:"B08",ID:"B08024",N:"<div class=\"center\"><p>femtifem</p>(femogfemti)</div>",E:"<div class=\"center\">55</div>",D:"NUMBERS & ORDINALS",X:"<div class=\"center\"><div class=\"left\">To provide you with a more complete learning experience, we have decided to give you the audio of the \"unofficial\" reading for this number.</div></div>",A:"N"},{DECK_ID:"B08",ID:"B08025",N:"<div class=\"center\">syttende</div>",E:"<div class=\"center\">17th</div>",D:"NUMBERS & ORDINALS",X:"<div class=\"center\"><div class=\"left\">Remember that the Y in <span class=\"italic\">sytten</span>, <span class=\"italic\">sytti</span> and their derivatives is pronounced as if it was an \xd8.</div></div>",A:"N"},{DECK_ID:"B08",ID:"B08026",N:"<div class=\"center\">attende</div>",E:"<div class=\"center\">18th</div>",D:"NUMBERS & ORDINALS",X:"<div class=\"center\">The D in the -ENDE ending is silent</div>",A:"N"},{DECK_ID:"B08",ID:"B08027",N:"<div class=\"center\">seksti</div>",E:"<div class=\"center\">60</div>",D:"NUMBERS & ORDINALS",X:"",A:"N"},{DECK_ID:"B08",ID:"B08028",N:"<div class=\"center\">nittende</div>",E:"<div class=\"center\">19th</div>",D:"NUMBERS & ORDINALS",X:"<div class=\"center\">The D in the -ENDE ending is silent</div>",A:"N"},{DECK_ID:"B08",ID:"B08029",N:"<div class=\"center\"><p>sekstisju</p>(sjuogseksti)</div>",E:"<div class=\"center\">67</div>",D:"NUMBERS & ORDINALS",X:"<div class=\"center\"><div class=\"left\">To provide you with a more complete learning experience, we have decided to give you the audio of the \"unofficial\" reading for this number.</div></div>",A:"N"},{DECK_ID:"B08",ID:"B08030",N:"<div class=\"center\"><p>tjuende</p>(tyvende)</div>",E:"<div class=\"center\">20th</div>",D:"NUMBERS & ORDINALS",X:"<div class=\"center\">The D in the -ENDE ending is silent</div>",A:"N"},{DECK_ID:"B08",ID:"B08031",N:"<div class=\"center\">tjuef\xf8rste</div>",E:"<div class=\"center\">21st</div>",D:"NUMBERS & ORDINALS",X:"<div class=\"center\"><div class=\"left\"><p>The \"unofficial\" reading for numbers from 21 to 99 (excluding round figures) applies also to their ordinals:</p>\xe9nogtjuende</div></div>",A:"N"},{DECK_ID:"B08",ID:"B08032",N:"<div class=\"center\">sytti</div>",E:"<div class=\"center\">70</div>",D:"NUMBERS & ORDINALS",X:"<div class=\"center\"><div class=\"left\">Remember that the Y in <span class=\"italic\">sytten</span>, <span class=\"italic\">sytti</span> and their derivatives is pronounced as if it was an \xd8.</div></div>",A:"N"},{DECK_ID:"B08",ID:"B08033",N:"<div class=\"center\">tjueandre</div>",E:"<div class=\"center\">22nd</div>",D:"NUMBERS & ORDINALS",X:"<div class=\"center\"><div class=\"left\"><p>The \"unofficial\" reading for numbers from 21 to 99 (excluding round figures) applies also to their ordinals:</p>toogtjuende</div></div>",A:"N"},{DECK_ID:"B08",ID:"B08034",N:"<div class=\"center\">tjuetredje</div>",E:"<div class=\"center\">23rd</div>",D:"NUMBERS & ORDINALS",X:"<div class=\"center\"><div class=\"left\"><p>The \"unofficial\" reading for numbers from 21 to 99 (excluding round figures) applies also to their ordinals:</p>treogtjuende</div></div>",A:"N"},{DECK_ID:"B08",ID:"B08035",N:"<div class=\"center\"><p>syttisju</p>(sjuogsytti)</div>",E:"<div class=\"center\">77</div>",D:"NUMBERS & ORDINALS",X:"<div class=\"center\"><div class=\"left\"><p>To provide you with a more complete learning experience, we have decided to give you the audio of the \"unofficial\" reading for this number.</p>Also, remember that the Y in <span class=\"italic\">sytten</span>, <span class=\"italic\">sytti</span> and their derivatives is pronounced as if it was an \xd8.</div></div>",A:"N"},{DECK_ID:"B08",ID:"B08036",N:"<div class=\"center\">\xe5tti</div>",E:"<div class=\"center\">80</div>",D:"NUMBERS & ORDINALS",X:"",A:"N"},{DECK_ID:"B08",ID:"B08037",N:"<div class=\"center\">tjuefjerde</div>",E:"<div class=\"center\">24th</div>",D:"NUMBERS & ORDINALS",X:"",A:"N"},{DECK_ID:"B08",ID:"B08038",N:"<div class=\"center\"><p>\xe5ttito</p>(toog\xe5tti)</div>",E:"<div class=\"center\">82</div>",D:"NUMBERS & ORDINALS",X:"<div class=\"center\"><div class=\"left\">To provide you with a more complete learning experience, we have decided to give you the audio of the \"unofficial\" reading for this number.</div></div>",A:"N"},{DECK_ID:"B08",ID:"B08039",N:"<div class=\"center\">tjuefemte</div>",E:"<div class=\"center\">25th</div>",D:"NUMBERS & ORDINALS",X:"",A:"N"},{DECK_ID:"B08",ID:"B08040",N:"<div class=\"center\">nitti</div>",E:"<div class=\"center\">90</div>",D:"NUMBERS & ORDINALS",X:"",A:"N"},{DECK_ID:"B08",ID:"B08041",N:"<div class=\"center\"><p>trettiende</p>(tredevte)</div>",E:"<div class=\"center\">30th</div>",D:"NUMBERS & ORDINALS",X:"<div class=\"center\"><div class=\"left\"><p>The form <span class=\"italic\">tredevte</span> is sometimes used because <span class=\"italic\">trettiende</span> may be confused with <span class=\"italic\">trettende</span>.</p>It is pronounced with a long D, while the V is pronounced like an F.</div></div>",A:"N"},{DECK_ID:"B08",ID:"B08042",N:"<div class=\"center\"><p>nittien</p>(\xe9nognitti)</div>",E:"<div class=\"center\">91</div>",D:"NUMBERS & ORDINALS",X:"<div class=\"center\"><div class=\"left\">To provide you with a more complete learning experience, we have decided to give you the audio of the \"unofficial\" reading for this number.</div></div>",A:"N"},{DECK_ID:"B08",ID:"B08043",N:"<div class=\"center\">trettif\xf8rste</div>",E:"<div class=\"center\">31st</div>",D:"NUMBERS & ORDINALS",X:"",A:"N"},{DECK_ID:"B08",ID:"B08044",N:"<div class=\"center\">hundre</div>",E:"<div class=\"center\">100</div>",D:"NUMBERS & ORDINALS",X:"<div class=\"center\"><div class=\"left\"><p>Note that <span class=\"italic\">hundre</span> is <span class=\"italic\">intetkj\xf8nn</span> and would require <span class=\"italic\">ett</span> in case you wanted to specify that it is \"<b class=\"bold\">one</b> hundred\".</p>The indefinite plural takes no ending.</div></div>",A:"N"},{DECK_ID:"B08",ID:"B08045",N:"<div class=\"center\">f\xf8rtiende</div>",E:"<div class=\"center\">40th</div>",D:"NUMBERS & ORDINALS",X:"<div class=\"center\">The D in the -ENDE ending is silent</div>",A:"N"},{DECK_ID:"B08",ID:"B08046",N:"<div class=\"center\">f\xf8rtiandre</div>",E:"<div class=\"center\">42nd</div>",D:"NUMBERS & ORDINALS",X:"",A:"N"},{DECK_ID:"B08",ID:"B08047",N:"<div class=\"center\">hundre og atten</div>",E:"<div class=\"center\">118</div>",D:"NUMBERS & ORDINALS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">Og</span> is required between the hundreds and the tens or units.</div></div>",A:"N"},{DECK_ID:"B08",ID:"B08048",N:"<div class=\"center\">femtiende</div>",E:"<div class=\"center\">50th</div>",D:"NUMBERS & ORDINALS",X:"<div class=\"center\">The D in the -ENDE ending is silent</div>",A:"N"},{DECK_ID:"B08",ID:"B08049",N:"<div class=\"center\">femtitredje</div>",E:"<div class=\"center\">53rd</div>",D:"NUMBERS & ORDINALS",X:"",A:"N"},{DECK_ID:"B08",ID:"B08050",N:"<div class=\"center\">sekstiende</div>",E:"<div class=\"center\">60th</div>",D:"NUMBERS & ORDINALS",X:"<div class=\"center\">The D in the -ENDE ending is silent</div>",A:"N"},{DECK_ID:"B08",ID:"B08051",N:"<div class=\"center\">sekstifjerde</div>",E:"<div class=\"center\">64th</div>",D:"NUMBERS & ORDINALS",X:"",A:"N"},{DECK_ID:"B08",ID:"B08052",N:"<div class=\"center\">tohundre</div>",E:"<div class=\"center\">200</div>",D:"NUMBERS & ORDINALS",X:"",A:"N"},{DECK_ID:"B08",ID:"B08053",N:"<div class=\"center\">syttiende</div>",E:"<div class=\"center\">70th</div>",D:"NUMBERS & ORDINALS",X:"<div class=\"center\"><div class=\"left\">Remember that the Y in <span class=\"italic\">sytten</span>, <span class=\"italic\">sytti</span> and their derivatives is pronounced as if it was an \xd8.</div></div>",A:"N"},{DECK_ID:"B08",ID:"B08054",N:"<div class=\"center\">syttifemte</div>",E:"<div class=\"center\">75th</div>",D:"NUMBERS & ORDINALS",X:"<div class=\"center\"><div class=\"left\">Remember that the Y in <span class=\"italic\">sytten</span>, <span class=\"italic\">sytti</span> and their derivatives is pronounced as if it was an \xd8.</div></div>",A:"N"},{DECK_ID:"B08",ID:"B08055",N:"<div class=\"center\">\xe5ttiende</div>",E:"<div class=\"center\">80th</div>",D:"NUMBERS & ORDINALS",X:"<div class=\"center\">The D in the -ENDE ending is silent</div>",A:"N"},{DECK_ID:"B08",ID:"B08056",N:"<div class=\"center\">\xe5ttisjette</div>",E:"<div class=\"center\">86th</div>",D:"NUMBERS & ORDINALS",X:"",A:"N"},{DECK_ID:"B08",ID:"B08057",N:"<div class=\"center\">trehundre og sekstiseks</div>",E:"<div class=\"center\">366</div>",D:"NUMBERS & ORDINALS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">Og</span> is required between the hundreds and the tens or units.</div></div>",A:"N"},{DECK_ID:"B08",ID:"B08058",N:"<div class=\"center\">nittiende</div>",E:"<div class=\"center\">90th</div>",D:"NUMBERS & ORDINALS",X:"<div class=\"center\">The D in the -ENDE ending is silent</div>",A:"N"},{DECK_ID:"B08",ID:"B08059",N:"<div class=\"center\">nittisjuende</div>",E:"<div class=\"center\">97th</div>",D:"NUMBERS & ORDINALS",X:"<div class=\"center\">The D in the -ENDE ending is silent</div>",A:"N"},{DECK_ID:"B08",ID:"B08060",N:"<div class=\"center\">firehundre og syttisju</div>",E:"<div class=\"center\">477</div>",D:"NUMBERS & ORDINALS",X:"<div class=\"center\"><div class=\"left\">Remember that the Y in <span class=\"italic\">sytten</span>, <span class=\"italic\">sytti</span> and their derivatives is pronounced as if it was an \xd8.</div></div>",A:"N"},{DECK_ID:"B08",ID:"B08061",N:"<div class=\"center\">tusen</div>",E:"<div class=\"center\">1 000</div>",D:"NUMBERS & ORDINALS",X:"<div class=\"center\"><div class=\"left\"><p>Note that <span class=\"italic\">tusen</span> is <span class=\"italic\">intetkj\xf8nn</span> and would require <span class=\"italic\">ett</span> in case you wanted to specify that it is \"<b class=\"bold\">one</b> thousand\".</p>The indefinite plural takes no ending.</div></div>",A:"N"},{DECK_ID:"B08",ID:"B08062",N:"<div class=\"center\">seks tusen sju hundre og \xe5ttini</div>",E:"<div class=\"center\">6 789</div>",D:"NUMBERS & ORDINALS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">Og</span> is required between the hundreds and the tens or units.</div></div>",A:"N"},{DECK_ID:"B08",ID:"B08063",N:"<div class=\"center\">ti tusen</div>",E:"<div class=\"center\">10 000</div>",D:"NUMBERS & ORDINALS",X:"<div class=\"center\"><div class=\"left\">Numbers from ten thousand onwards must be written with a space between the thousands and the hundreds</div></div>",A:"N"},{DECK_ID:"B08",ID:"B08064",N:"<div class=\"center\">syttiseks tusen fem hundre og f\xf8rtitre</div>",E:"<div class=\"center\">76 543</div>",D:"NUMBERS & ORDINALS",X:"<div class=\"center\"><div class=\"left\"><p>Numbers from ten thousand onwards must be written with a space between the thousands and the hundreds.</p>Also, remember that the Y in <span class=\"italic\">sytten</span>, <span class=\"italic\">sytti</span> and their derivatives is pronounced as if it was an \xd8.</div></div>",A:"N"},{DECK_ID:"B08",ID:"B08065",N:"<div class=\"center\">hundre tusen</div>",E:"<div class=\"center\">100 000</div>",D:"NUMBERS & ORDINALS",X:"",A:"N"},{DECK_ID:"B08",ID:"B08066",N:"<div class=\"center\">\xe5tte hundre og syttiseks tusen fem hundre og f\xf8rtitre</div>",E:"<div class=\"center\">876 543</div>",D:"NUMBERS & ORDINALS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Og</span> is required between the hundreds and the tens or units, but also between the hundreds of thousands and the tens or units of thousands, like in this number.</p>Also, remember that the Y in <span class=\"italic\">sytten</span>, <span class=\"italic\">sytti</span> and their derivatives is pronounced as if it was an \xd8.</div></div>",A:"N"},{DECK_ID:"B08",ID:"B08067",N:"<div class=\"center\">hundrede</div>",E:"<div class=\"center\">100th</div>",D:"NUMBERS & ORDINALS",X:"",A:"N"},{DECK_ID:"B08",ID:"B08068",N:"<div class=\"center\">hundre og niende</div>",E:"<div class=\"center\">109th</div>",D:"NUMBERS & ORDINALS",X:"<div class=\"center\">The D in the -ENDE ending is silent</div>",A:"N"},{DECK_ID:"B08",ID:"B08069",N:"<div class=\"center\">en/\xe9n million</div>",E:"<div class=\"center\">1 000 000</div>",D:"NUMBERS & ORDINALS",X:"<div class=\"center\"><div class=\"left\">Note how <span class=\"italic\">million</span> is <span class=\"italic\">hankj\xf8nn</span> and requires <span class=\"italic\">en/\xe9n</span> (unlike <span class=\"italic\">hundre</span> and <span class=\"italic\">tusen</span>, which are <span class=\"italic\">intetkj\xf8nn</span>).</div></div>",A:"N"},{DECK_ID:"B08",ID:"B08070",N:"<div class=\"center\">ni millioner ett tusen to hundre og trettifire</div>",E:"<div class=\"center\">9 001 234</div>",D:"NUMBERS & ORDINALS",X:"",A:"N"},{DECK_ID:"B08",ID:"B08071",N:"<div class=\"center\">tohundrede</div>",E:"<div class=\"center\">200th</div>",D:"NUMBERS & ORDINALS",X:"",A:"N"},{DECK_ID:"B08",ID:"B08072",N:"<div class=\"center\">sju hundre og syttifemte</div>",E:"<div class=\"center\">775th</div>",D:"NUMBERS & ORDINALS",X:"<div class=\"center\"><div class=\"left\">Remember that the Y in <span class=\"italic\">sytten</span>, <span class=\"italic\">sytti</span> and their derivatives is pronounced as if it was an \xd8.</div></div>",A:"N"},{DECK_ID:"B08",ID:"B08073",N:"<div class=\"center\">en/\xe9n milliard</div>",E:"<div class=\"center\">1 000 000 000</div>",D:"NUMBERS & ORDINALS",X:"<div class=\"center\"><div class=\"left\">Note how <span class=\"italic\">milliard</span> is <span class=\"italic\">hankj\xf8nn</span> and requires <span class=\"italic\">en/\xe9n</span> (unlike <span class=\"italic\">hundre</span> and <span class=\"italic\">tusen</span>, which are <span class=\"italic\">intetkj\xf8nn</span>).</div></div>",A:"N"},{DECK_ID:"B08",ID:"B08074",N:"<div class=\"center\">fem milliarder tolv millioner og syttini tusen</div>",E:"<div class=\"center\">5 012 079 000</div>",D:"NUMBERS & ORDINALS",X:"<div class=\"center\"><div class=\"left\">Remember that the Y in <span class=\"italic\">sytten</span>, <span class=\"italic\">sytti</span> and their derivatives is pronounced as if it was an \xd8.</div></div>",A:"N"},{DECK_ID:"B08",ID:"B08075",N:"<div class=\"center\">tusende</div>",E:"<div class=\"center\">1 000th</div>",D:"NUMBERS & ORDINALS",X:"<div class=\"center\">The D in the -ENDE ending is silent</div>",A:"N"},{DECK_ID:"B08",ID:"B08076",N:"<div class=\"center\">fem tusen og f\xf8rste</div>",E:"<div class=\"center\">5 001st</div>",D:"NUMBERS & ORDINALS",X:"",A:"N"},{DECK_ID:"B08",ID:"B08077",N:"<div class=\"center\">ti tusende</div>",E:"<div class=\"center\">10 000th</div>",D:"NUMBERS & ORDINALS",X:"<div class=\"center\">The D in the -ENDE ending is silent</div>",A:"N"},{DECK_ID:"B08",ID:"B08078",N:"<div class=\"center\">hundre tusende</div>",E:"<div class=\"center\">100 000th</div>",D:"NUMBERS & ORDINALS",X:"<div class=\"center\">The D in the -ENDE ending is silent</div>",A:"N"},{DECK_ID:"B08",ID:"B08079",N:"<div class=\"center\">millionte</div>",E:"<div class=\"center\">millionth</div>",D:"NUMBERS & ORDINALS",X:"",A:"N"},{DECK_ID:"B08",ID:"B08080",N:"<div class=\"center\">milliardte</div>",E:"<div class=\"center\">billionth</div>",D:"NUMBERS & ORDINALS",X:"",A:"N"},{DECK_ID:"B09",ID:"B09001",N:"<div class=\"center\"><p>What is the meaning of</p><p><span class=\"italic\">trygt</span></p>when it's used as an adverb?</div>",E:"<div class=\"center\">It means \"safely\"</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\"><p>Adverbs, the words that describe an action rather than an object, can come from the <span class=\"italic\">intetkj\xf8nn</span> form of the adjective:</p><p><span class=\"italic\">Faren min kj\xf8rer trygt</span></p>Note how the G is pronounced as K.</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09002",N:"<div class=\"center\"><p>Provide the Norwegian equivalent of:</p>often, more often, most often</div>",E:"<div class=\"center\">ofte, oftere, oftest</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\">Some adverbs can have a comparative and superlative grade just like adjectives</div></div>",A:"E"},{DECK_ID:"B09",ID:"B09003",N:"<div class=\"center\"><p>Provide the Norwegian equivalent of:</p>luckily</div>",E:"<div class=\"center\">heldigvis</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\">Adverbs can sometimes be created by <b class=\"bold\">adding -VIS</b> to an adjective, especially if the adjective ends in -IG.</div></div>",A:"E"},{DECK_ID:"B09",ID:"B09004",N:"<div class=\"center\">her, hit</div>",E:"<div class=\"center\">here</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Her</span> refers to a static position, <span class=\"italic\">hit</span> entails movement from one place to another. See the difference:</p><p><span class=\"italic\">Hun bor her</span></p><span class=\"italic\">Kom hit!</span></div></div>",A:"N"},{DECK_ID:"B09",ID:"B09005",N:"<div class=\"center\"><p>What is the meaning of</p><p><span class=\"italic\">bra</span></p>when it's used as an adverb?</div>",E:"<div class=\"center\">It means \"well\"</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\"><p>Adverbs, the words that describe an action rather than an object, can come from the <span class=\"italic\">intetkj\xf8nn</span> form of the adjective. In this case, <span class=\"italic\">bra</span> doesn't change with gender, so the adverbial form is still <span class=\"italic\">bra</span>:</p><span class=\"italic\">Det g\xe5r bra</span></div></div>",A:"N"},{DECK_ID:"B09",ID:"B09006",N:"<div class=\"center\"><p>Provide the Norwegian equivalent of:</p>gladly, rather, ideally</div>",E:"<div class=\"center\">gjerne, heller, helst</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\">The adverb <span class=\"italic\">gjerne</span> has specific comparative and superlative forms</div></div>",A:"E"},{DECK_ID:"B09",ID:"B09007",N:"<div class=\"center\"><p>Provide the Norwegian equivalent of:</p>usually / normally</div>",E:"<div class=\"center\">vanligvis</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\">Adverbs can sometimes be created by <b class=\"bold\">adding -VIS</b> to an adjective, especially if the adjective ends in -IG.</div></div>",A:"E"},{DECK_ID:"B09",ID:"B09008",N:"<div class=\"center\">der, dit</div>",E:"<div class=\"center\">there</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Der</span> refers to a static position, <span class=\"italic\">dit</span> entails movement from one place to another. See the difference:</p><p><span class=\"italic\">Huset v\xe5rt ligger der</span></p><span class=\"italic\">Ikke g\xe5 dit!</span></div></div>",A:"N"},{DECK_ID:"B09",ID:"B09009",N:"<div class=\"center\"><p>What is the meaning of</p><p><span class=\"italic\">effektivt</span></p>when it's used as an adverb?</div>",E:"<div class=\"center\">It means \"efficiently\"</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\"><p>Adverbs, the words that describe an action rather than an object, can come from the <span class=\"italic\">intetkj\xf8nn</span> form of the adjective:</p><span class=\"italic\">Hun studerer norsk effektivt</span></div></div>",A:"N"},{DECK_ID:"B09",ID:"B09010",N:"<div class=\"center\"><p>Provide the Norwegian equivalent of:</p>quickly, more quickly, most quickly</div>",E:"<div class=\"center\">fort, fortere, fortest</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\">Some adverbs can have a comparative and superlative grade just like adjectives</div></div>",A:"E"},{DECK_ID:"B09",ID:"B09011",N:"<div class=\"center\">ute, ut</div>",E:"<div class=\"center\">out</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Ute</span> refers to a static position, <span class=\"italic\">ut</span> entails movement from one place to another. See the difference:</p><p><span class=\"italic\">Katten v\xe5r er alltid ute om natta</span></p><span class=\"italic\">Jeg har lyst til \xe5 g\xe5 ut</span></div></div>",A:"N"},{DECK_ID:"B09",ID:"B09012",N:"<div class=\"center\">inne, inn</div>",E:"<div class=\"center\">in/inside</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Inne</span> refers to a static position, <span class=\"italic\">inn</span> entails movement from one place to another. See the difference:</p><p><span class=\"italic\">Jeg sitter inne veldig ofte</span></p><span class=\"italic\">Bare g\xe5 inn!</span></div></div>",A:"N"},{DECK_ID:"B09",ID:"B09013",N:"<div class=\"center\">n\xe5r, da</div>",E:"<div class=\"center\">when, then</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Da</span> (then) is used to indicate one-off events in the past or repeated events in circumstances or a period that has ended for good.</p><p><span class=\"italic\">N\xe5r</span> (when) is used in all other occasions (including the future). Remember this rule:</p><span class=\"italic\">Den gang: da. Hver gang: n\xe5r.</span></div></div>",A:"N"},{DECK_ID:"B09",ID:"B09014",N:"<div class=\"center\">lite</div>",E:"<div class=\"center\">little, scarcely, hardly anything</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Lite</span> (the <span class=\"italic\">intetkj\xf8nn</span> form of the adjective <span class=\"italic\">liten</span>) indicates a lesser quantity than <span class=\"italic\">litt</span>, which means \"a bit, a little\".<br>It must be used with uncountable nouns:</p><span class=\"italic\">Det er lite vi kan gj\xf8re med det</span></div></div>",A:"N"},{DECK_ID:"B09",ID:"B09015",N:"<div class=\"center\">mye</div>",E:"<div class=\"center\">much, a lot</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Mye</span> is often an adjective or a noun, but can also be an adverb:</p><span class=\"italic\">Han jobber mye og sover mye</span>.</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09016",N:"<div class=\"center\">veldig / sv\xe6rt / meget</div>",E:"<div class=\"center\">very</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">Veldig</span> is the most commonly used, <span class=\"italic\">sv\xe6rt</span> and <span class=\"italic\">meget</span> are considered more formal, even refined.</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09017",N:"<div class=\"center\">aldri</div>",E:"<div class=\"center\">never</div>",D:"ADVERBS",X:"",A:"N"},{DECK_ID:"B09",ID:"B09018",N:"<div class=\"center\">alltid</div>",E:"<div class=\"center\">always</div>",D:"ADVERBS",X:"",A:"N"},{DECK_ID:"B09",ID:"B09019",N:"<div class=\"center\">igjen</div>",E:"<div class=\"center\">again, left, back</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\"><p>The adverb <span class=\"italic\">igjen</span> can also cover \"back\" and \"left\":</p><span class=\"italic\"><p>Han fikk penger igjen p\xe5 skatten</p>Jeg hadde to eksamenssp\xf8rsm\xe5l igjen</span></div></div>",A:"N"},{DECK_ID:"B09",ID:"B09020",N:"<div class=\"center\">iblant, tidvis</div>",E:"<div class=\"center\">sometimes</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\"><p>The expressions <span class=\"italic\">av og til</span> and <span class=\"italic\">noen ganger</span> are also common ways of translating the English adverb.</p>Note that <span class=\"italic\">iblant</span> is written without a space, unlike expressions such as <span class=\"italic\">i dag</span> or <span class=\"italic\">i fjor</span>.</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09021",N:"<div class=\"center\">bare</div>",E:"<div class=\"center\">just, simply, only</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\"><p>Hallo! Det er bare meg!</p><p>Bare si det!</p>Det er bare ett av problemene mine</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09022",N:"<div class=\"center\">kun</div>",E:"<div class=\"center\">only, exclusively</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\"><p>Compared to <span class=\"italic\">bare</span>, <span class=\"italic\">kun</span> is used with numbers or to expresses exclusivity:</p><span class=\"italic\"><p>Tilbud! Kun 100 kroner!</p>Toaletten er kun for kunder</span></div></div>",A:"N"},{DECK_ID:"B09",ID:"B09023",N:"<div class=\"center\">helt</div>",E:"<div class=\"center\">totally, completely, wholly</div>",D:"ADVERBS",X:"<div class=\"center\">Det er helt umulig</div>",A:"N"},{DECK_ID:"B09",ID:"B09024",N:"<div class=\"center\">uten</div>",E:"<div class=\"center\">without</div>",D:"PREPOSITIONS",X:"<div class=\"center\"><div class=\"left\"><p>Jeg kan ikke leve uten kaffe</p>Han snakker uten \xe5 tenke</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09025",N:"<div class=\"center\">hvor lenge</div>",E:"<div class=\"center\">how long (time)</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\"><p>Remember that \"how long\" translates as <span class=\"italic\">hvor lenge</span>, not as <span class=\"italic\">hvordan lenge</span>.</p><p><span class=\"italic\">Hvor lenge var du der?</span></p>You can also use <span class=\"italic\">hvor lang tid</span>.</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09026",N:"<div class=\"center\">ganske, noks\xe5</div>",E:"<div class=\"center\">quite</div>",D:"ADVERBS",X:"",A:"N"},{DECK_ID:"B09",ID:"B09027",N:"<div class=\"center\">tilbake</div>",E:"<div class=\"center\">back</div>",D:"ADVERBS",X:"",A:"N"},{DECK_ID:"B09",ID:"B09028",N:"<div class=\"center\">nesten</div>",E:"<div class=\"center\">almost, nearly</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Jeg er nesten ferdig</span></p><p><span class=\"italic\">Han hadde nesten glemt bursdagen min!</span></p>Do not confuse <span class=\"italic\">nesten</span> with <span class=\"italic\">neste</span> (which means \"next\").</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09029",N:"<div class=\"center\">borte, bort</div>",E:"<div class=\"center\">away</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Borte</span> refers to a static position, <span class=\"italic\">bort</span> entails movement from one place to another. See the difference:</p><p><span class=\"italic\">Vi er borte hjemmefra</span></p><span class=\"italic\">Vi reiser bort neste uke</span></div></div>",A:"N"},{DECK_ID:"B09",ID:"B09030",N:"<div class=\"center\">over</div>",E:"<div class=\"center\">over, more than</div>",D:"PREPOSITIONS",X:"<div class=\"center\"><div class=\"left\"><p>Sommeren er over</p>Det kostet oss over fem tusen kroner</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09031",N:"<div class=\"center\">n\xe6r</div>",E:"<div class=\"center\">nearby, near, closely</div>",D:"ADVERBS",X:"<div class=\"center\">Vi bor n\xe6r sentrum</div>",A:"N"},{DECK_ID:"B09",ID:"B09032",N:"<div class=\"center\">enda</div>",E:"<div class=\"center\">yet/still, even, even though</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Enda</span> is both a \"time adverb\" meaning \"yet\", a \"grade adverb\" meaning \"even\" and a subjunction meaning \"even though\":</p><span class=\"italic\"><p>Jeg er ikke klar enda</p><p>Utstillingen var enda bedre enn jeg hadde forventet</p>Vi gikk en tur enda det var veldig kaldt</span></div></div>",A:"N"},{DECK_ID:"B09",ID:"B09033",N:"<div class=\"center\">enn\xe5</div>",E:"<div class=\"center\">yet/still (in the present)</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Enn\xe5</span> is strictly a \"time adverb\" referring to the present, do not confuse it with <span class=\"italic\">enda</span>, which has other meanings too.</p><span class=\"italic\">Jeg har enn\xe5 ikke sett filmen</span></div></div>",A:"N"},{DECK_ID:"B09",ID:"B09034",N:"<div class=\"center\">hos</div>",E:"<div class=\"center\">at somebody's house/premises</div>",D:"PREPOSITIONS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">Hos</span> is basically the equivalent of the French \"chez\"</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09035",N:"<div class=\"center\">hjemme, hjem</div>",E:"<div class=\"center\">at home, home</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Hjemme</span> refers to a static position, <span class=\"italic\">hjem</span> entails movement from one place to another. See the difference:</p><p><span class=\"italic\">Jeg er hjemme</span></p><span class=\"italic\">De m\xe5tte dra hjem</span></div></div>",A:"N"},{DECK_ID:"B09",ID:"B09036",N:"<div class=\"center\">mer</div>",E:"<div class=\"center\">more</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Mer</span> is often a comparative adjective, but can also be an adverb:</p><span class=\"italic\">Erlend er mer eller mindre ferdig med universitetet</span>.</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09037",N:"<div class=\"center\">nok</div>",E:"<div class=\"center\">enough, probably</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\"><p>The adverb <span class=\"italic\">nok</span> can also translate \"probably\":</p><span class=\"italic\"><p>Lars er nok litt skuffet</p>Det kommer nok til \xe5 sn\xf8 i natt</span></div></div>",A:"N"},{DECK_ID:"B09",ID:"B09038",N:"<div class=\"center\">virkelig, egentlig</div>",E:"<div class=\"center\">really</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">Egentlig</span> can also mean something like \"strictly speaking\", \"actually\".</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09039",N:"<div class=\"center\">siden</div>",E:"<div class=\"center\">since</div>",D:"PREPOSITIONS",X:"<div class=\"center\"><div class=\"left\">Jeg har bodd i Norge siden to tusen og elleve</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09040",N:"<div class=\"center\">for [\u2026] siden</div>",E:"<div class=\"center\">ago</div>",D:"PREPOSITIONS",X:"<div class=\"center\"><div class=\"left\"><p>Do not forget <span class=\"italic\">for</span> before the time unit (whether it's years, months, weeks, days, hours etc).</p><span class=\"italic\">Jeg flyttet til Norge for to \xe5r siden</span></div></div>",A:"N"},{DECK_ID:"B09",ID:"B09041",N:"<div class=\"center\">mens</div>",E:"<div class=\"center\">while</div>",D:"SUBJUNCTIONS",X:"",A:"N"},{DECK_ID:"B09",ID:"B09042",N:"<div class=\"center\">unna</div>",E:"<div class=\"center\">away from, away</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Unna</span> is often used for set expressions, with other adverbs or with measurements:</p><span class=\"italic\"><p>\xe5 holde seg unna</p><p>langt unna</p>5 kilometer unna</span></div></div>",A:"N"},{DECK_ID:"B09",ID:"B09043",N:"<div class=\"center\">noensinne</div>",E:"<div class=\"center\">ever</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Det var den verste festen jeg noensinne har v\xe6rt p\xe5</span></p><p>Note that Norwegian might prefer other constructions for negations and questions:</p><p>Don't ever call me again<br><span class=\"italic\">Aldri ring meg igjen</span></p>Have you ever been there?<br><span class=\"italic\">Har du noen gang v\xe6rt der?</span></div></div>",A:"N"},{DECK_ID:"B09",ID:"B09044",N:"<div class=\"center\">hvor mange</div>",E:"<div class=\"center\">how many</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\"><p>Remember that \"how many\" translates as <span class=\"italic\">hvor mange</span>, not as <span class=\"italic\">hvordan mange</span>.</p><span class=\"italic\">Hvor mange glass drakk du?</span></div></div>",A:"N"},{DECK_ID:"B09",ID:"B09045",N:"<div class=\"center\">etter at</div>",E:"<div class=\"center\">after that</div>",D:"SUBJUNCTIONS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Etter at</span> is a subjunction and tends to be followed by a subject and a verb:</p><p><span class=\"italic\">Jeg legger meg etter at jeg har lest i boka mi</span></p><p>Students might expect <span class=\"italic\">etter</span> alone to be enough in this case, but the <span class=\"italic\">at</span> is necessary.</p>This is because <span class=\"italic\">etter</span>, when alone, is a preposition so it cannot be followed by a whole sentence.</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09046",N:"<div class=\"center\">etterp\xe5</div>",E:"<div class=\"center\">afterwards</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Etterp\xe5</span> is an adverb. It's usually at the beginning of a sentence (therefore it must be followed by a verb and then a subject) or at the end of one:</p><span class=\"italic\">Hun gikk p\xe5 kino. Etterp\xe5 bes\xf8kte hun en venn.<br><br>Hva skal vi gj\xf8re etterp\xe5?</span></div></div>",A:"N"},{DECK_ID:"B09",ID:"B09047",N:"<div class=\"center\">i kveld</div>",E:"<div class=\"center\">this evening</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\"><p>Norwegian tends to use <span class=\"italic\">i</span> to indicate the current or the next immediate instance of a certain time.</p>The noun indicating the time period is <span class=\"italic\">often</span> (but not always) in the indefinite form.</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09048",N:"<div class=\"center\">likevel, allikevel</div>",E:"<div class=\"center\">all the same, nevertheless</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\">Aasmund har spist mye, men er likevel sulten</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09049",N:"<div class=\"center\">i \xe5r</div>",E:"<div class=\"center\">this year</div>",D:"ADVERBS",X:"",A:"N"},{DECK_ID:"B09",ID:"B09050",N:"<div class=\"center\">i fjor</div>",E:"<div class=\"center\">last year, last year's</div>",D:"ADVERBS",X:"<div class=\"center\"><p>I fjor vinter var det ganske kaldt</p>I fjor dro vi til Hellas</div>",A:"N"},{DECK_ID:"B09",ID:"B09051",N:"<div class=\"center\">derfor</div>",E:"<div class=\"center\">therefore, consequently, hence</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\"><p>Just like in English, this term connects a cause with an effect (in this order).</p>It can be used at the beginning of a sentence, meaning something like \"this is the reason why\" or \"because of this\".</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09052",N:"<div class=\"center\">uansett</div>",E:"<div class=\"center\">anyway, regardless, no matter what</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\">Jeg vil kj\xf8pe en Tesla bil, uansett hva den koster.</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09053",N:"<div class=\"center\">b\xe5de [\u2026] og</div>",E:"<div class=\"center\">both [\u2026] and</div>",D:"CONJUNCTIONS",X:"<div class=\"center\"><div class=\"left\">When \"both\" is used with \"and\", Norwegian uses <span class=\"italic\">b\xe5de</span> and <span class=\"italic\">og</span>.</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09054",N:"<div class=\"center\">i uka</div>",E:"<div class=\"center\">this week</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\">Remember that <span class=\"italic\">uka</span> is the singular definite form of the feminine</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09055",N:"<div class=\"center\">denne m\xe5neden</div>",E:"<div class=\"center\">this month</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\">Unlike <span class=\"italic\">dag</span>, <span class=\"italic\">uke</span> and <span class=\"italic\">\xe5r</span>, the current instance of the month is indicated with <span class=\"italic\">denne</span> rather than <span class=\"italic\">i</span>.</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09056",N:"<div class=\"center\">allerede</div>",E:"<div class=\"center\">already</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Alt</span> can be used to a similar effect:</p><span class=\"italic\">Er du her alt?</span></div></div>",A:"N"},{DECK_ID:"B09",ID:"B09057",N:"<div class=\"center\">gjennom</div>",E:"<div class=\"center\">through, via</div>",D:"PREPOSITIONS",X:"",A:"N"},{DECK_ID:"B09",ID:"B09058",N:"<div class=\"center\">sjelden</div>",E:"<div class=\"center\">rarely, seldom</div>",D:"ADVERBS",X:"",A:"N"},{DECK_ID:"B09",ID:"B09059",N:"<div class=\"center\">fortsatt, fremdeles</div>",E:"<div class=\"center\">still (adverb), yet</div>",D:"ADVERBS",X:"<div class=\"center\"><span class=\"italic\">Han er fortsatt opptatt</span><br>He is still busy</div>",A:"N"},{DECK_ID:"B09",ID:"B09060",N:"<div class=\"center\">vel</div>",E:"<div class=\"center\">well</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Vel</span> has a number of additional functions:</p><span class=\"italic\"><p>A: Vi er ferdige\u2026<br>B: Ja vel</p>Hun tjener vel 400 000</span></div></div>",A:"N"},{DECK_ID:"B09",ID:"B09061",N:"<div class=\"center\">like</div>",E:"<div class=\"center\">equally, just as</div>",D:"ADVERBS",X:"<div class=\"center\">De er like gamle</div>",A:"N"},{DECK_ID:"B09",ID:"B09062",N:"<div class=\"center\">sammen</div>",E:"<div class=\"center\">together</div>",D:"ADVERBS",X:"",A:"N"},{DECK_ID:"B09",ID:"B09063",N:"<div class=\"center\">i like m\xe5te</div>",E:"<div class=\"center\">likewise, in the same way</div>",D:"ADVERBS",X:"<div class=\"center\"><p>A: Godt nytt \xe5r!</p>B: Takk og i like m\xe5te!</div>",A:"N"},{DECK_ID:"B09",ID:"B09064",N:"<div class=\"center\">nettopp / akkurat</div>",E:"<div class=\"center\">exactly, precisely</div>",D:"ADVERBS",X:"",A:"N"},{DECK_ID:"B09",ID:"B09065",N:"<div class=\"center\">enten [\u2026] eller</div>",E:"<div class=\"center\">either [\u2026] or</div>",D:"CONJUNCTIONS",X:"",A:"N"},{DECK_ID:"B09",ID:"B09066",N:"<div class=\"center\">hverken [\u2026] eller</div>",E:"<div class=\"center\">neither [\u2026] nor</div>",D:"CONJUNCTIONS",X:"<div class=\"center\"><div class=\"left\">This can also be written without the H</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09067",N:"<div class=\"center\">heller</div>",E:"<div class=\"center\">either (following a negation)</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\"><p>A: Harald vil ikke komme<br>B: Ikke jeg heller</p>Helene var ikke glad, men heller ikke trist.</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09068",N:"<div class=\"center\">ellers</div>",E:"<div class=\"center\">otherwise</div>",D:"ADVERBS",X:"",A:"N"},{DECK_ID:"B09",ID:"B09069",N:"<div class=\"center\">heller ikke</div>",E:"<div class=\"center\">not even</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\"><p>Det var heller ikke vanskelig</p>Heller ikke s\xf8stera mi husket bursdagen min</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09070",N:"<div class=\"center\">mot</div>",E:"<div class=\"center\">against, towards</div>",D:"PREPOSITIONS",X:"<div class=\"center\"><div class=\"left\">Remember that the O has the long sound</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09071",N:"<div class=\"center\">dessverre</div>",E:"<div class=\"center\">unfortunately</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\"><p>This adverb can also be used as a means to say \"I'm sorry\" when having to give a negative answer to a request:</p><span class=\"italic\">A: Har dere den svarte jakka som er p\xe5 tilbud? <br>B: Dessverre! Vi solgte den siste for en time siden.</span></div></div>",A:"N"},{DECK_ID:"B09",ID:"B09072",N:"<div class=\"center\">altfor</div>",E:"<div class=\"center\">far too</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\"><p>Instead of <span class=\"italic\">altfor</span>, you can use <span class=\"italic\">for</span> alone, for less emphasis</p><span class=\"italic\">Det er for mye</span><br>It's too much</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09073",N:"<div class=\"center\">blant</div>",E:"<div class=\"center\">among</div>",D:"PREPOSITIONS",X:"<div class=\"center\"><div class=\"left\">Also used with an \"i\" at the front with the meaning of \"sometimes\".</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09074",N:"<div class=\"center\"><p>Provide the Norwegian equivalent of:</p>naturally</div>",E:"<div class=\"center\">naturligvis</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\">Adverbs can sometimes be created by <b class=\"bold\">adding -VIS</b> to an adjective, especially if the adjective ends in -IG.</div></div>",A:"E"},{DECK_ID:"B09",ID:"B09075",N:"<div class=\"center\">fjernt, langt borte</div>",E:"<div class=\"center\">far, far away</div>",D:"ADVERBS",X:"",A:"N"},{DECK_ID:"B09",ID:"B09076",N:"<div class=\"center\">f\xf8rst</div>",E:"<div class=\"center\">firstly, first</div>",D:"ADVERBS",X:"",A:"N"},{DECK_ID:"B09",ID:"B09077",N:"<div class=\"center\">faktisk</div>",E:"<div class=\"center\">actually, as a matter of fact, really</div>",D:"ADVERBS",X:"",A:"N"},{DECK_ID:"B09",ID:"B09078",N:"<div class=\"center\">delvis</div>",E:"<div class=\"center\">partially, in part</div>",D:"ADVERBS",X:"<div class=\"center\">Leiligheten er delvis m\xf8blert</div>",A:"N"},{DECK_ID:"B09",ID:"B09079",N:"<div class=\"center\">oppe, opp</div>",E:"<div class=\"center\">up</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Oppe</span> refers to a static position, <span class=\"italic\">opp</span> entails movement from one place to another. See the difference:</p><p><span class=\"italic\">Vi bor der oppe</span></p><span class=\"italic\">Vi er p\xe5 vei opp</span>.</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09080",N:"<div class=\"center\">nede, ned</div>",E:"<div class=\"center\">down</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Nede</span> refers to a static position, <span class=\"italic\">ned</span> entails movement from one place to another. See the difference:</p><p><span class=\"italic\">Ungene er nede i kjelleren</span></p><span class=\"italic\">Kom ned, det er farlig!</span></div></div>",A:"N"},{DECK_ID:"B09",ID:"B09081",N:"<div class=\"center\">mellom</div>",E:"<div class=\"center\">between</div>",D:"PREPOSITIONS",X:"",A:"N"},{DECK_ID:"B09",ID:"B09082",N:"<div class=\"center\">lenge<br>lenger<br>lengst</div>",E:"<div class=\"center\">for (a) long (time)<br>for longer<br>for (the) longest (time)</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\"><p>This adverb has comparative and superlative forms: <span class=\"italic\">lenger, lengst</span>.</p>Do not mistake it with the adjective <span class=\"italic\">lang/langt/lange, lengre, lengst</span> which refers to spatial length.</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09083",N:"<div class=\"center\">alene</div>",E:"<div class=\"center\">alone, by oneself</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Jeg bor alene</p><p>Han jobber best alene</span></p>Note that the adjective for \"lonely, solitary\" is <span class=\"italic\">ensom</span>.</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09084",N:"<div class=\"center\">liksom</div>",E:"<div class=\"center\">like, in the same way as</div>",D:"CONJUNCTIONS",X:"<div class=\"center\"><div class=\"left\">This is also used as a \"non-word\" in spoken language, a bit like \"like\" in English, often pronounced as <span class=\"italic\">lissom</span>.</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09085",N:"<div class=\"center\">jo</div>",E:"<div class=\"center\">yes (answering a negation)</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\">A: Det var ikke en d\xe5rlig film<br>B: Jo, den var veldig d\xe5rlig!</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09086",N:"<div class=\"center\"><p>Provide the Norwegian equivalent of:</p>probably, likely</div>",E:"<div class=\"center\">sannsynligvis</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\">The adverb <span class=\"italic\">trolig</span> can be used to the same effect.</div></div>",A:"E"},{DECK_ID:"B09",ID:"B09087",N:"<div class=\"center\">for mye</div>",E:"<div class=\"center\">too much</div>",D:"ADVERBS",X:"",A:"N"},{DECK_ID:"B09",ID:"B09088",N:"<div class=\"center\">veldig mye</div>",E:"<div class=\"center\">very much</div>",D:"ADVERBS",X:"",A:"N"},{DECK_ID:"B09",ID:"B09089",N:"<div class=\"center\">for lite</div>",E:"<div class=\"center\">too little</div>",D:"ADVERBS",X:"",A:"N"},{DECK_ID:"B09",ID:"B09090",N:"<div class=\"center\">veldig lite</div>",E:"<div class=\"center\">very little</div>",D:"ADVERBS",X:"",A:"N"},{DECK_ID:"B09",ID:"B09091",N:"<div class=\"center\">forresten</div>",E:"<div class=\"center\">by the way, after all</div>",D:"ADVERBS",X:"",A:"N"},{DECK_ID:"B09",ID:"B09092",N:"<div class=\"center\">snart</div>",E:"<div class=\"center\">soon</div>",D:"ADVERBS",X:"",A:"N"},{DECK_ID:"B09",ID:"B09093",N:"<div class=\"center\">for tiden / for tida</div>",E:"<div class=\"center\">for the time being, for now</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Jeg er syk s\xe5 jeg kan ikke arbeide for tida</span></p>Note how the D is silent in <span class=\"italic\">tida</span> but not in <span class=\"italic\">tiden</span>.</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09094",N:"<div class=\"center\">ved siden av</div>",E:"<div class=\"center\">besides, by the side of, next to</div>",D:"ADVERBS",X:"<div class=\"center\">Han sto ved siden av meg</div>",A:"N"},{DECK_ID:"B09",ID:"B09095",N:"<div class=\"center\">dessuten</div>",E:"<div class=\"center\">moreover</div>",D:"ADVERBS",X:"",A:"N"},{DECK_ID:"B09",ID:"B09096",N:"<div class=\"center\">om [\u2026] eller</div>",E:"<div class=\"center\">whether [\u2026] or</div>",D:"CONJUNCTIONS",X:"<div class=\"center\"><div class=\"left\">The word <span class=\"italic\">hvorvidt</span> can be used instead of <span class=\"italic\">om</span>.</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09097",N:"<div class=\"center\">omtrent</div>",E:"<div class=\"center\">around, approximately</div>",D:"PREPOSITIONS",X:"<div class=\"center\"><div class=\"left\">The word <span class=\"italic\">cirka</span> can be used to the same effect.</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09098",N:"<div class=\"center\"><p>framme, fram / </p>fremme, frem</div>",E:"<div class=\"center\">ahead, forward</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Framme</span> refers to a static position, <span class=\"italic\">fram</span> entails movement from one place to another:</p><p><span class=\"italic\">Jeg liker \xe5 sitte framme i bilen</span></p><p><span class=\"italic\">G\xe5 fram, ikke tilbake!</span></p>Note that <span class=\"italic\">fram</span> is the more progressive spelling, whereas <span class=\"italic\">frem</span> is the more Danish/conservative spelling.</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09099",N:"<div class=\"center\">forbi</div>",E:"<div class=\"center\">past, by</div>",D:"PREPOSITIONS",X:"<div class=\"center\"><div class=\"left\">Vi gikk forbi butikken, uten \xe5 legge merke til den.</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09100",N:"<div class=\"center\">selv om</div>",E:"<div class=\"center\">even if, although, even though</div>",D:"SUBJUNCTIONS",X:"",A:"N"},{DECK_ID:"B09",ID:"B09101",N:"<div class=\"center\">foran</div>",E:"<div class=\"center\">in front of</div>",D:"PREPOSITIONS",X:"",A:"N"},{DECK_ID:"B09",ID:"B09102",N:"<div class=\"center\">overalt</div>",E:"<div class=\"center\">everywhere</div>",D:"ADVERBS",X:"",A:"N"},{DECK_ID:"B09",ID:"B09103",N:"<div class=\"center\">innen</div>",E:"<div class=\"center\">before, within</div>",D:"PREPOSITIONS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">Innen</span> is used only for time expressions, otherwise \"within\" must be translated as <span class=\"italic\">innenfor</span> for position and space.</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09104",N:"<div class=\"center\">alts\xe5</div>",E:"<div class=\"center\">thus, so, too</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\">The adverb <span class=\"italic\">alts\xe5</span> is also used as a \"non-word\" or an intensifier similar to \"too\", \"as well\".</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09105",N:"<div class=\"center\">under</div>",E:"<div class=\"center\">under, below, during</div>",D:"PREPOSITIONS",X:"<div class=\"center\"><div class=\"left\">Also used as \"during\", referring to the duration of events.</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09106",N:"<div class=\"center\"><p>Provide the Norwegian equivalent of:</p>hopefully</div>",E:"<div class=\"center\">forh\xe5pentligvis</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\">Adverbs can sometimes be created by <b class=\"bold\">adding -VIS</b> to an adjective, especially if the adjective ends in -IG.</div></div>",A:"E"},{DECK_ID:"B09",ID:"B09107",N:"<div class=\"center\">i overmorgen</div>",E:"<div class=\"center\">the day after tomorrow</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\"><p>Norwegian tends to use <span class=\"italic\">i</span> to indicate the current or the next immediate instance of a certain time.</p>The noun indicating the time period is <span class=\"italic\">often</span> (but not always) in the indefinite form.</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09108",N:"<div class=\"center\">i forg\xe5rs</div>",E:"<div class=\"center\">the day before yesterday</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\"><p>Norwegian tends to use <span class=\"italic\">i</span> to indicate the current or the next immediate instance of a certain time.</p>The noun indicating the time period is <span class=\"italic\">often</span> (but not always) in the indefinite form.</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09109",N:"<div class=\"center\">i morges</div>",E:"<div class=\"center\">this morning</div>",D:"ADVERBS",X:"",A:"N"},{DECK_ID:"B09",ID:"B09110",N:"<div class=\"center\">slik at / s\xe5nn at</div>",E:"<div class=\"center\">so that</div>",D:"CONJUNCTIONS",X:"",A:"N"},{DECK_ID:"B09",ID:"B09111",N:"<div class=\"center\">til slutt</div>",E:"<div class=\"center\">in the end, ultimately, at last</div>",D:"ADVERBS",X:"",A:"N"},{DECK_ID:"B09",ID:"B09112",N:"<div class=\"center\">som om</div>",E:"<div class=\"center\">as if</div>",D:"SUBJUNCTIONS",X:"",A:"N"},{DECK_ID:"B09",ID:"B09113",N:"<div class=\"center\">selvf\xf8lgelig</div>",E:"<div class=\"center\">of course, certainly</div>",D:"ADVERBS",X:"",A:"N"},{DECK_ID:"B09",ID:"B09114",N:"<div class=\"center\">vekk</div>",E:"<div class=\"center\">away, afar</div>",D:"ADVERBS",X:"",A:"N"},{DECK_ID:"B09",ID:"B09115",N:"<div class=\"center\">bak</div>",E:"<div class=\"center\">behind, back</div>",D:"PREPOSITIONS",X:"",A:"N"},{DECK_ID:"B09",ID:"B09116",N:"<div class=\"center\">endelig</div>",E:"<div class=\"center\">finally, at last</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\">This is an adjective but it's most often used as an adverb.</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09117",N:"<div class=\"center\">i det hele tatt</div>",E:"<div class=\"center\">at all</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\"><p>The expression <span class=\"italic\">i det hele tatt</span> is a specific construction:</p><span class=\"italic\">Det stemmer ikke i det hele tatt</span></div></div>",A:"N"},{DECK_ID:"B09",ID:"B09118",N:"<div class=\"center\">samt</div>",E:"<div class=\"center\">together with, as well as</div>",D:"CONJUNCTIONS",X:"<div class=\"center\"><div class=\"left\">Kommunen vil fokusere p\xe5 \xe5 redusere avfall samt \xe5 forbedre sorteringen.</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09119",N:"<div class=\"center\">til tross for</div>",E:"<div class=\"center\">in spite of</div>",D:"PREPOSITIONS",X:"",A:"N"},{DECK_ID:"B09",ID:"B09120",N:"<div class=\"center\">jo [\u2026] desto</div>",E:"<div class=\"center\">the [more/less\u2026], the [more/less\u2026]</div>",D:"SUBJUNCTIONS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Jo mer du prater, desto mindre h\xf8rer jeg p\xe5</span></p><p>The following can be used to the same effect:<br><span class=\"italic\">jo [\u2026] dess, dess [\u2026] dess, desto [\u2026] desto</span>.</p>Basically, any combination of <span class=\"italic\">jo, dess, desto</span> is allowed.</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09121",N:"<div class=\"center\">til sammen</div>",E:"<div class=\"center\">altogether</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\">Det blir sjuhundre kroner til sammen</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09122",N:"<div class=\"center\">s\xe6rlig</div>",E:"<div class=\"center\">especially</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\">V\xe6ret var bra i sommer, s\xe6rlig i juli</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09123",N:"<div class=\"center\">imidlertid</div>",E:"<div class=\"center\">however</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\">Note that <span class=\"italic\">imidlertid</span> is not a time expression despite containing the word <span class=\"italic\">tid</span>.</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09124",N:"<div class=\"center\">skikkelig</div>",E:"<div class=\"center\">very, incredibly (slang)</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\">Originally an adjective meaning \"decent, ordinary\", it is used colloquially with the meaning og \"very, incredibly, really\".</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09125",N:"<div class=\"center\">ovenfor</div>",E:"<div class=\"center\">above, higher up</div>",D:"PREPOSITIONS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Hun bor i leiligheten ovenfor</span></p>Not to be confused with <span class=\"italic\">ove<b class=\"bold\">r</b>for</span>, which means \"opposite to, against\".</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09126",N:"<div class=\"center\">underveis</div>",E:"<div class=\"center\">in progress, underway</div>",D:"ADVERBS",X:"",A:"N"},{DECK_ID:"B09",ID:"B09127",N:"<div class=\"center\">utenfor</div>",E:"<div class=\"center\">outside of</div>",D:"PREPOSITIONS",X:"<div class=\"center\"><div class=\"left\">Hallo? Jeg st\xe5r utenfor inngangsd\xf8ra</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09128",N:"<div class=\"center\">nemlig</div>",E:"<div class=\"center\">namely, precisely, i.e.</div>",D:"ADVERBS",X:"",A:"N"},{DECK_ID:"B09",ID:"B09129",N:"<div class=\"center\">ut( )over</div>",E:"<div class=\"center\">beyond, throughout</div>",D:"PREPOSITIONS",X:"<div class=\"center\"><div class=\"left\"><p>Han er klok utover det vanlige</p>Det regnet mye utover sommeren</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09130",N:"<div class=\"center\">dersom</div>",E:"<div class=\"center\">in case, if</div>",D:"SUBJUNCTIONS",X:"",A:"N"},{DECK_ID:"B09",ID:"B09131",N:"<div class=\"center\">langs</div>",E:"<div class=\"center\">along, by</div>",D:"PREPOSITIONS",X:"",A:"N"},{DECK_ID:"B09",ID:"B09132",N:"<div class=\"center\">ille, verre, verst</div>",E:"<div class=\"center\">badly</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Han synger ille og danser enda verre</span></p>He sings badly and dances even worse</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09133",N:"<div class=\"center\">dermed</div>",E:"<div class=\"center\">with that, thus</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\">Klokka slo tolv og dermed var det lunsjtid!</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09134",N:"<div class=\"center\">tross</div>",E:"<div class=\"center\">despite</div>",D:"PREPOSITIONS",X:"<div class=\"center\"><div class=\"left\"><p>Tross alle venskeligehetene, klarte hun det</p><p>Jeg var p\xe5 jobb til tross for streiken</p>Jeg gikk p\xe5 tur til tross for at jeg var ganske sliten</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09135",N:"<div class=\"center\">herfra</div>",E:"<div class=\"center\">from here</div>",D:"ADVERBS",X:"",A:"N"},{DECK_ID:"B09",ID:"B09136",N:"<div class=\"center\">i hjel</div>",E:"<div class=\"center\">to death</div>",D:"ADVERBS",X:"<div class=\"center\">Hun kommer til \xe5 fryse i hjel</div>",A:"N"},{DECK_ID:"B09",ID:"B09137",N:"<div class=\"center\">if\xf8lge</div>",E:"<div class=\"center\">according to</div>",D:"PREPOSITIONS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">If\xf8lge ekspertene vil prisene fortsette \xe5 stige</span></p>Note how this example is one of the instances in which you can use <span class=\"italic\">vil</span> for the future, to describe something outside of anyone's control.</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09138",N:"<div class=\"center\">deretter</div>",E:"<div class=\"center\">subsequently, afterwards</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\">Jeg f\xf8lte meg d\xe5rlig, og deretter kastet jeg opp.</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09139",N:"<div class=\"center\">jammen</div>",E:"<div class=\"center\">truly, in all honesty, come on</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\"><p>Dette er jammen ikke min feil!</p><p>Det er jammen ikke lett \xe5 v\xe6re ung i dag!</p>Jammen kan vi ikke pr\xf8ve i hvert fall?</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09140",N:"<div class=\"center\">ettersom</div>",E:"<div class=\"center\">as a consequence of, due to, since</div>",D:"SUBJUNCTIONS",X:"<div class=\"center\"><div class=\"left\"><p>It is similar to <span class=\"italic\">fordi</span> in meaning but it's considered a bit more elegant:</p><span class=\"italic\">Ettersom jeg er en god kunde, f\xe5r jeg rabatt.</span></div></div>",A:"N"},{DECK_ID:"B09",ID:"B09141",N:"<div class=\"center\">overfor</div>",E:"<div class=\"center\">opposite to, face to face, against</div>",D:"PREPOSITIONS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Han satt rett overfor meg</p><p>Regjeringen st\xe5r overfor noen utfordringer</span></p>Not to be confused with <span class=\"italic\">ove<b class=\"bold\">n</b>for</span> which means \"above, higher up\"</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09142",N:"<div class=\"center\">neppe</div>",E:"<div class=\"center\">probably not</div>",D:"ADVERBS",X:"<div class=\"center\"><p><span class=\"italic\">Han kommer neppe</span></p>Probably he is not coming</div>",A:"N"},{DECK_ID:"B09",ID:"B09143",N:"<div class=\"center\">p\xe5 tide</div>",E:"<div class=\"center\">timely, about time to</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\">N\xe5 er det p\xe5 tide \xe5 at jeg l\xe6rer meg norsk seri\xf8st</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09144",N:"<div class=\"center\">n\xe5 for tida</div>",E:"<div class=\"center\">for the time being</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\"><p>This expression is used for shorter periods of time.</p>For longer ones, <span class=\"italic\">n\xe5tildags</span> (\"nowadays\") would be better.</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09145",N:"<div class=\"center\">istedenfor / i stedet for</div>",E:"<div class=\"center\">instead of</div>",D:"PREPOSITIONS",X:"<div class=\"center\"><div class=\"left\">Note that the agglutinated spelling is preferred with N, the separated one with T.</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09146",N:"<div class=\"center\">for \xf8vrig</div>",E:"<div class=\"center\">besides, moreover</div>",D:"ADVERBS",X:"",A:"N"},{DECK_ID:"B09",ID:"B09147",N:"<div class=\"center\">i motsetning til</div>",E:"<div class=\"center\">contrary to, in contrast to</div>",D:"ADVERBS",X:"",A:"N"},{DECK_ID:"B09",ID:"B09148",N:"<div class=\"center\">omkring</div>",E:"<div class=\"center\">around, circa</div>",D:"PREPOSITIONS",X:"",A:"N"},{DECK_ID:"B09",ID:"B09149",N:"<div class=\"center\">selvsagt</div>",E:"<div class=\"center\">evidently, obviously, of course</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\">Remember that the G in the GT ending of certain past participles is effectively pronounced as a the soft K (i.e. K with superscript J).</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09150",N:"<div class=\"center\">imot</div>",E:"<div class=\"center\">against</div>",D:"PREPOSITIONS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Imot</span> is the \"movement\" version of <span class=\"italic\">mot</span>, although the distinction between the two is not as strict as with the other adverbs:</p><span class=\"italic\"><p>Han sitter mot et tre</p>Han satte seg imot et tre</span></div></div>",A:"N"},{DECK_ID:"B09",ID:"B09151",N:"<div class=\"center\">aller</div>",E:"<div class=\"center\">very, the very</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\">Britene var blant de aller f\xf8rste som utforsket Antarktika, men Roald Amundsen n\xe5dde Sydpolen f\xf8rst</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09152",N:"<div class=\"center\">slett ikke</div>",E:"<div class=\"center\">absolutely not</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\">De har slett ikke v\xe6rt vennlig mot oss</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09153",N:"<div class=\"center\">litt etter litt</div>",E:"<div class=\"center\">little by little, gradually</div>",D:"ADVERBS",X:"",A:"N"},{DECK_ID:"B09",ID:"B09154",N:"<div class=\"center\">derimot</div>",E:"<div class=\"center\">conversely, on the contrary</div>",D:"ADVERBS",X:"<div class=\"center\"><div class=\"left\">Han var irriterende, men kj\xe6resten hans, derimot, var hyggelig</div></div>",A:"N"},{DECK_ID:"B09",ID:"B09155",N:"<div class=\"center\">utenat</div>",E:"<div class=\"center\">by heart</div>",D:"ADVERBS",X:"<div class=\"center\">Jeg kan denne sangen utenat</div>",A:"N"},{DECK_ID:"B10",ID:"B10001",N:"<div class=\"center\">I live <b class=\"bold\">in</b> Oslo now</div>",E:"<div class=\"center\">Jeg bor <b class=\"bold\">i</b> Oslo n\xe5</div>",D:"PREPOSITIONS IN USE",X:"",A:"E"},{DECK_ID:"B10",ID:"B10002",N:"<div class=\"center\">She lived abroad <b class=\"bold\">for</b> three years</div>",E:"<div class=\"center\">Hun bodde i utlandet <b class=\"bold\">i</b> tre \xe5r</div>",D:"PREPOSITIONS IN USE",X:"<div class=\"center\"><div class=\"left\">The use of <span class=\"italic\">i</span> to express a continuous length of time (whereas English would have \"for\") is a typical pitfall, learn to recognise it and to use it correctly.</div></div>",A:"E"},{DECK_ID:"B10",ID:"B10003",N:"<div class=\"center\">I'll be done <b class=\"bold\">in</b> five minutes</div>",E:"<div class=\"center\">Jeg blir ferdig <b class=\"bold\">om</b> fem minutter</div>",D:"PREPOSITIONS IN USE",X:"<div class=\"center\"><div class=\"left\">In this case, <span class=\"italic\">om</span> is used to indicate a time which will have to elapse before something else happens.<br>Learn this well, as you might be tempted to use <span class=\"italic\">i</span>.</div></div>",A:"E"},{DECK_ID:"B10",ID:"B10004",N:"<div class=\"center\">The difference <b class=\"bold\">between</b> A and B</div>",E:"<div class=\"center\">Forskjellen <b class=\"bold\">mellom</b>/p\xe5 A og B</div>",D:"PREPOSITIONS IN USE",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Mellom</span> is used with <span class=\"italic\">bestemt</span> and measurable differences, <span class=\"italic\">p\xe5</span> is used with <span class=\"italic\">ubestemt</span> and significant differences in nature:</p><p><span class=\"italic\">Forskjellen mellom h\xf8ydene v\xe5re er liten</span></p><span class=\"italic\">Ser du forskjellen p\xe5 baseball og softball?</span></div></div>",A:"E"},{DECK_ID:"B10",ID:"B10005",N:"<div class=\"center\">I agree <b class=\"bold\">with</b> you</div>",E:"<div class=\"center\">Jeg er enig <b class=\"bold\">med</b> deg</div>",D:"PREPOSITIONS IN USE",X:"<div class=\"center\"><div class=\"left\">Remember that the D at the end of <span class=\"italic\">med</span> is silent</div></div>",A:"E"},{DECK_ID:"B10",ID:"B10006",N:"<div class=\"center\"><b class=\"bold\">For</b> example</div>",E:"<div class=\"center\"><b class=\"bold\">For</b> eksempel</div>",D:"PREPOSITIONS IN USE",X:"",A:"E"},{DECK_ID:"B10",ID:"B10007",N:"<div class=\"center\">I'm <b class=\"bold\">on</b> the way</div>",E:"<div class=\"center\">Jeg er <b class=\"bold\">p\xe5</b> vei</div>",D:"PREPOSITIONS IN USE",X:"",A:"E"},{DECK_ID:"B10",ID:"B10008",N:"<div class=\"center\">We come <b class=\"bold\">from</b> the United Kingdom</div>",E:"<div class=\"center\">Vi kommer <b class=\"bold\">fra</b> Storbritannia</div>",D:"PREPOSITIONS IN USE",X:"<div class=\"center\"><div class=\"left\">Although <span class=\"italic\">Storbritannia</span> should theoretically indicate only the island of Great Britain, it is the actual translation of \"United Kingdom\".</div></div>",A:"E"},{DECK_ID:"B10",ID:"B10009",N:"<div class=\"center\">The newspaper lies <b class=\"bold\">on</b> the table</div>",E:"<div class=\"center\">Avisa ligger <b class=\"bold\">p\xe5</b> bordet</div>",D:"PREPOSITIONS IN USE",X:"<div class=\"center\"><div class=\"left\">Remember that <span class=\"italic\">\xe5 ligge</span> is used to indicate the position of things that would be lying down.</div></div>",A:"E"},{DECK_ID:"B10",ID:"B10010",N:"<div class=\"center\">We'll go <b class=\"bold\">to</b> Denmark</div>",E:"<div class=\"center\">Vi skal dra <b class=\"bold\">til</b> Danmark</div>",D:"PREPOSITIONS IN USE",X:"<div class=\"center\"><div class=\"left\">Remember that <span class=\"italic\">\xe5 g\xe5</span> means \"to go (on foot), to walk\", therefore <span class=\"italic\">\xe5 dra</span> must be used for anything other than travel by mere walking.</div></div>",A:"E"},{DECK_ID:"B10",ID:"B10011",N:"<div class=\"center\"><div class=\"left\"><b class=\"bold\">According to</b> the law, you must have a certificate</div></div>",E:"<div class=\"center\"><b class=\"bold\">If\xf8lge</b> loven m\xe5 du ha sertifikat</div>",D:"PREPOSITIONS IN USE",X:"<div class=\"center\"><div class=\"left\">Note the inversion of main verb and subject because the prepositional sentence (<span class=\"italic\">if\xf8lge loven</span>) is used at the beginning (this is the V2 rule).<br>Also, no indefinite article for <span class=\"italic\">sertifikat</span> as it's meant in a generic sense.</div></div>",A:"E"},{DECK_ID:"B10",ID:"B10012",N:"<div class=\"center\">I'll go <b class=\"bold\">by</b> eight</div>",E:"<div class=\"center\">Jeg skal dra <b class=\"bold\">innen</b> kl. 8</div>",D:"PREPOSITIONS IN USE",X:"",A:"E"},{DECK_ID:"B10",ID:"B10013",N:"<div class=\"center\">Obtain your goal <b class=\"bold\">through</b> effective training</div>",E:"<div class=\"center\">Oppn\xe5 m\xe5let ditt <b class=\"bold\">gjennom</b> effektiv trening</div>",D:"PREPOSITIONS IN USE",X:"<div class=\"center\"><div class=\"left\"><p>The verb <span class=\"italic\">\xe5 oppn\xe5</span> means \"to obtain, to achieve\" in an abstract sense.</p>For both abstract and physical meaning, you can use <span class=\"italic\">\xe5 n\xe5</span>.</div></div>",A:"E"},{DECK_ID:"B10",ID:"B10014",N:"<div class=\"center\">The bird flew <b class=\"bold\">over</b> the tree</div>",E:"<div class=\"center\">Fuglen fl\xf8y <b class=\"bold\">over</b> treet</div>",D:"PREPOSITIONS IN USE",X:"",A:"E"},{DECK_ID:"B10",ID:"B10015",N:"<div class=\"center\">The football world cup was won <b class=\"bold\">by</b> Germany</div>",E:"<div class=\"center\"><div class=\"left\">Verdensmesterskapet i fotball ble vunnet <b class=\"bold\">av</b> Tyskland</div></div>",D:"PREPOSITIONS IN USE",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">VM</span> is the typical Norwegian shortening for <span class=\"italic\">verdensmesterskapet</span>, the \"world cup\" of sport events and such.</div></div>",A:"E"},{DECK_ID:"B10",ID:"B10016",N:"<div class=\"center\">I'm ok! What <b class=\"bold\">about</b> you?</div>",E:"<div class=\"center\">Jeg har det bra. Hva <b class=\"bold\">med</b> deg?</div>",D:"PREPOSITIONS IN USE",X:"<div class=\"center\"><div class=\"left\">Remember that the D at the end of <span class=\"italic\">med</span> is silent</div></div>",A:"E"},{DECK_ID:"B10",ID:"B10017",N:"<div class=\"center\">Wait <b class=\"bold\">until</b> the summer!</div>",E:"<div class=\"center\">Vent <b class=\"bold\">til</b> sommeren!</div>",D:"PREPOSITIONS IN USE",X:"",A:"E"},{DECK_ID:"B10",ID:"B10018",N:"<div class=\"center\">We'll have dinner <b class=\"bold\">at</b> the Midtb\xf8's</div>",E:"<div class=\"center\">Vi skal p\xe5 middag <b class=\"bold\">hos</b> familien Midtb\xf8</div>",D:"PREPOSITIONS IN USE",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">Hos</span> is basically the equivalent of the French \"chez\"</div></div>",A:"E"},{DECK_ID:"B10",ID:"B10019",N:"<div class=\"center\">How do you say that <b class=\"bold\">in</b> Norwegian?</div>",E:"<div class=\"center\">Hvordan sier man det <b class=\"bold\">p\xe5</b> norsk?</div>",D:"PREPOSITIONS IN USE",X:"<div class=\"center\"><div class=\"left\">Literally, this would translate to \"How does one say that on Norwegian?\".</div></div>",A:"E"},{DECK_ID:"B10",ID:"B10020",N:"<div class=\"center\">I am a student <b class=\"bold\">at</b> the University of Oslo</div>",E:"<div class=\"center\">Jeg er student <b class=\"bold\">ved</b> Universitet i Oslo</div>",D:"PREPOSITIONS IN USE",X:"<div class=\"center\"><div class=\"left\">Remember that the D at the end of <span class=\"italic\">ved</span> is silent</div></div>",A:"E"},{DECK_ID:"B10",ID:"B10021",N:"<div class=\"center\">She comes <b class=\"bold\">in</b> ten minutes</div>",E:"<div class=\"center\">Hun kommer <b class=\"bold\">om</b> ti minutter</div>",D:"PREPOSITIONS IN USE",X:"<div class=\"center\"><div class=\"left\">Remember that <span class=\"italic\">om</span> is used to indicate a time which will have to elapse before something else happens.<br>Learn this well, as you might be tempted to use <span class=\"italic\">i</span>.</div></div>",A:"E"},{DECK_ID:"B10",ID:"B10022",N:"<div class=\"center\">The house is <b class=\"bold\">by</b> the sea</div>",E:"<div class=\"center\">Huset ligger <b class=\"bold\">ved</b> sj\xf8en</div>",D:"PREPOSITIONS IN USE",X:"<div class=\"center\"><div class=\"left\">Remember that the D at the end of <span class=\"italic\">ved</span> is silent</div></div>",A:"E"},{DECK_ID:"B10",ID:"B10023",N:"<div class=\"center\">The research <b class=\"bold\">behind</b> the findings is good</div>",E:"<div class=\"center\">Forskningen <b class=\"bold\">bak</b> funnene er god</div>",D:"PREPOSITIONS IN USE",X:"",A:"E"},{DECK_ID:"B10",ID:"B10024",N:"<div class=\"center\">We're staying here <b class=\"bold\">until</b> 10 o'clock</div>",E:"<div class=\"center\">Vi blir her <b class=\"bold\">til</b> kl. 10</div>",D:"PREPOSITIONS IN USE",X:"<div class=\"center\"><div class=\"left\">The verb <span class=\"italic\">\xe5 bli</span> means also \"to remain\", \"to stay\".</div></div>",A:"E"},{DECK_ID:"B10",ID:"B10025",N:"<div class=\"center\">A friend <b class=\"bold\">of</b> mine</div>",E:"<div class=\"center\">En venn <b class=\"bold\">av</b> meg</div>",D:"PREPOSITIONS IN USE",X:"",A:"E"},{DECK_ID:"B10",ID:"B10026",N:"<div class=\"center\">It happened <b class=\"bold\">during</b> the war</div>",E:"<div class=\"center\">Det skjedde <b class=\"bold\">under</b> krigen</div>",D:"PREPOSITIONS IN USE",X:"<div class=\"center\"><div class=\"left\">Whilst <span class=\"italic\">under</span> is used for an event, <span class=\"italic\">i l\xf8pet av</span> is used for a period of time.</div></div>",A:"E"},{DECK_ID:"B10",ID:"B10027",N:"<div class=\"center\">The house is <b class=\"bold\">for</b> sale</div>",E:"<div class=\"center\">Huset er <b class=\"bold\">til</b> salgs</div>",D:"PREPOSITIONS IN USE",X:"<div class=\"center\"><div class=\"left\">Note how the G is pronounced as a K because it precedes an S.</div></div>",A:"E"},{DECK_ID:"B10",ID:"B10028",N:"<div class=\"center\">They agreed <b class=\"bold\">about</b> leaving early</div>",E:"<div class=\"center\">De ble enige <b class=\"bold\">om</b> \xe5 stikke tidlig</div>",D:"PREPOSITIONS IN USE",X:"<div class=\"center\"><div class=\"left\">Do not mistake <span class=\"italic\">\xe5 stikke</span> (a colloquial verb meaning \"to leave\") with <span class=\"italic\">et stykke</span> (a piece).</div></div>",A:"E"},{DECK_ID:"B10",ID:"B10029",N:"<div class=\"center\"><div class=\"left\">We walked <b class=\"bold\">around</b> the building three times</div></div>",E:"<div class=\"center\"><div class=\"left\">Vi gikk <b class=\"bold\">rundt</b> bygningen tre ganger</div></div>",D:"PREPOSITIONS IN USE",X:"",A:"E"},{DECK_ID:"B10",ID:"B10030",N:"<div class=\"center\"><div class=\"left\">You must have a licence <b class=\"bold\">to</b> become a taxi owner</div></div>",E:"<div class=\"center\">Du m\xe5 ha bevilgning <b class=\"bold\">for \xe5</b> bli drosjeeier</div>",D:"PREPOSITIONS IN USE",X:"",A:"E"},{DECK_ID:"B10",ID:"B10031",N:"<div class=\"center\">The cat lies <b class=\"bold\">under</b> the table</div>",E:"<div class=\"center\">Katten ligger <b class=\"bold\">under</b> bordet</div>",D:"PREPOSITIONS IN USE",X:"",A:"E"},{DECK_ID:"B10",ID:"B10032",N:"<div class=\"center\">I found my card <b class=\"bold\">among</b> the products in the bag</div>",E:"<div class=\"center\">Jeg fant kortet mitt <b class=\"bold\">blant</b> varene i posen</div>",D:"PREPOSITIONS IN USE",X:"",A:"E"},{DECK_ID:"B10",ID:"B10033",N:"<div class=\"center\">Marit sat <b class=\"bold\">at</b> the table</div>",E:"<div class=\"center\">Marit satt <b class=\"bold\">ved</b> bordet</div>",D:"PREPOSITIONS IN USE",X:"<div class=\"center\"><div class=\"left\">Remember that the D at the end of <span class=\"italic\">ved</span> is silent</div></div>",A:"E"},{DECK_ID:"B10",ID:"B10034",N:"<div class=\"center\">The flat is <b class=\"bold\">above</b> the bank</div>",E:"<div class=\"center\">Leiligheten er <b class=\"bold\">ovenfor</b> banken</div>",D:"PREPOSITIONS IN USE",X:"",A:"E"},{DECK_ID:"B10",ID:"B10035",N:"<div class=\"center\">They travelled <b class=\"bold\">via</b> Kastrup</div>",E:"<div class=\"center\">De reiste <b class=\"bold\">via</b> Kastrup</div>",D:"PREPOSITIONS IN USE",X:"",A:"E"},{DECK_ID:"B10",ID:"B10036",N:"<div class=\"center\">\"Hunger\" is a novel <b class=\"bold\">by</b> Knut Hamsun</div>",E:"<div class=\"center\">\"Sult\" er en roman <b class=\"bold\">av</b> Knut Hamsun</div>",D:"PREPOSITIONS IN USE",X:"",A:"E"},{DECK_ID:"B10",ID:"B10037",N:"<div class=\"center\"><b class=\"bold\">In</b> a way, you are wrong</div>",E:"<div class=\"center\"><b class=\"bold\">P\xe5</b> en m\xe5te, tar du feil</div>",D:"PREPOSITIONS IN USE",X:"<div class=\"center\"><div class=\"left\">Note the inversion of main verb and subject because the prepositional sentence (<span class=\"italic\">p\xe5 en m\xe5te</span>) is used at the beginning (this is the V2 rule).</div></div>",A:"E"},{DECK_ID:"B10",ID:"B10038",N:"<div class=\"center\">Come <b class=\"bold\">to</b> papa!</div>",E:"<div class=\"center\">Kom <b class=\"bold\">til</b> pappa!</div>",D:"PREPOSITIONS IN USE",X:"",A:"E"},{DECK_ID:"B10",ID:"B10039",N:"<div class=\"center\">I don't have a reason <b class=\"bold\">to</b> suspect anybody</div>",E:"<div class=\"center\">Jeg har ikke grunn <b class=\"bold\">til \xe5</b> mistenke noen</div>",D:"PREPOSITIONS IN USE",X:"",A:"E"},{DECK_ID:"B10",ID:"B10040",N:"<div class=\"center\">It can be solved <b class=\"bold\">with</b> the help of the teacher</div>",E:"<div class=\"center\">Det kan l\xf8ses <b class=\"bold\">ved</b> hjelp av l\xe6reren</div>",D:"PREPOSITIONS IN USE",X:"<div class=\"center\"><div class=\"left\">Remember that the D at the end of <span class=\"italic\">ved</span> is silent</div></div>",A:"E"},{DECK_ID:"B10",ID:"B10041",N:"<div class=\"center\">See you <b class=\"bold\">towards</b> the end of the day</div>",E:"<div class=\"center\">Vi ses <b class=\"bold\">mot</b> slutten av dagen</div>",D:"PREPOSITIONS IN USE",X:"<div class=\"center\"><div class=\"left\">Remember that the O in <span class=\"italic\">mot</span> has the long sound.</div></div>",A:"E"},{DECK_ID:"B10",ID:"B10042",N:"<div class=\"center\">The aim <b class=\"bold\">of</b> the law is to hinder imports</div>",E:"<div class=\"center\">M\xe5let <b class=\"bold\">med</b> loven er \xe5 hindre import</div>",D:"PREPOSITIONS IN USE",X:"<div class=\"center\"><div class=\"left\">Remember that the D at the end of <span class=\"italic\">med</span> is silent</div></div>",A:"E"},{DECK_ID:"B10",ID:"B10043",N:"<div class=\"center\">They met <b class=\"bold\">at</b> the annual market</div>",E:"<div class=\"center\">De m\xf8ttes <b class=\"bold\">p\xe5</b> det \xe5rlige markedet</div>",D:"PREPOSITIONS IN USE",X:"",A:"E"},{DECK_ID:"B10",ID:"B10044",N:"<div class=\"center\">You have to arrive <b class=\"bold\">by</b> March 10</div>",E:"<div class=\"center\">Du m\xe5 komme <b class=\"bold\">innen</b> 10. mars</div>",D:"PREPOSITIONS IN USE",X:"",A:"E"},{DECK_ID:"B10",ID:"B10045",N:"<div class=\"center\"><div class=\"left\"><b class=\"bold\">According to</b> what the police say, it was murder</div></div>",E:"<div class=\"center\"><b class=\"bold\">Etter</b> det politiet sier, var den mord</div>",D:"PREPOSITIONS IN USE",X:"<div class=\"center\"><div class=\"left\">Note the inversion of main verb and subject because the prepositional sentence (<span class=\"italic\">etter det politiet sier</span>) is used at the beginning (this is the V2 rule).</div></div>",A:"E"},{DECK_ID:"B10",ID:"B10046",N:"<div class=\"center\">A house <b class=\"bold\">of</b> medium size</div>",E:"<div class=\"center\">Et hus <b class=\"bold\">av</b> middels st\xf8rrelse</div>",D:"PREPOSITIONS IN USE",X:"",A:"E"},{DECK_ID:"B10",ID:"B10047",N:"<div class=\"center\">Don't be mean <b class=\"bold\">towards</b> the cat!</div>",E:"<div class=\"center\">Ikke v\xe6r slem <b class=\"bold\">mot</b> katten!</div>",D:"PREPOSITIONS IN USE",X:"<div class=\"center\"><div class=\"left\">Remember that the O in <span class=\"italic\">mot</span> has the long sound.</div></div>",A:"E"},{DECK_ID:"B10",ID:"B10048",N:"<div class=\"center\">I need <b class=\"bold\">to</b> talk to you</div>",E:"<div class=\"center\">Jeg har behov <b class=\"bold\">for</b> \xe5 snakke med deg</div>",D:"PREPOSITIONS IN USE",X:"",A:"E"},{DECK_ID:"B10",ID:"B10049",N:"<div class=\"center\">It happened <b class=\"bold\">over</b> three days ago</div>",E:"<div class=\"center\">Det skjedde for <b class=\"bold\">over</b> tre dager siden</div>",D:"PREPOSITIONS IN USE",X:"",A:"E"},{DECK_ID:"B10",ID:"B10050",N:"<div class=\"center\">She gave me an explanation <b class=\"bold\">about</b> that</div>",E:"<div class=\"center\">Hun ga meg en forklaring <b class=\"bold\">om</b> dette</div>",D:"PREPOSITIONS IN USE",X:"",A:"E"},{DECK_ID:"B10",ID:"B10051",N:"<div class=\"center\">The car is ready <b class=\"bold\">for</b> use</div>",E:"<div class=\"center\">Bilen er klar <b class=\"bold\">til</b> bruk</div>",D:"PREPOSITIONS IN USE",X:"",A:"E"},{DECK_ID:"B10",ID:"B10052",N:"<div class=\"center\"><b class=\"bold\">On</b> Friday we are staying at home</div>",E:"<div class=\"center\"><b class=\"bold\">P\xe5</b> fredag blir vi hjemme</div>",D:"PREPOSITIONS IN USE",X:"<div class=\"center\"><div class=\"left\">Note the inversion of main verb and subject because the prepositional sentence (<span class=\"italic\">p\xe5 fredag</span>) is used at the beginning (this is the V2 rule).</div></div>",A:"E"},{DECK_ID:"B10",ID:"B10053",N:"<div class=\"center\"><b class=\"bold\">At</b> the beginning she liked him</div>",E:"<div class=\"center\"><b class=\"bold\">I</b> begynnelsen likte hun ham</div>",D:"PREPOSITIONS IN USE",X:"<div class=\"center\"><div class=\"left\">Note the inversion of main verb and subject because the prepositional sentence (<span class=\"italic\">i begynnelsen</span>) is used at the beginning (this is the V2 rule).</div></div>",A:"E"},{DECK_ID:"B10",ID:"B10054",N:"<div class=\"center\">Are you going to eat <b class=\"bold\">at</b> five?</div>",E:"<div class=\"center\">Kommer du til \xe5 spise <b class=\"bold\">ved</b> fem tiden?</div>",D:"PREPOSITIONS IN USE",X:"<div class=\"center\"><div class=\"left\">Remember that the D at the end of <span class=\"italic\">ved</span> is silent</div></div>",A:"E"},{DECK_ID:"B10",ID:"B10055",N:"<div class=\"center\">He fought <b class=\"bold\">against</b> the Germans</div>",E:"<div class=\"center\">Han kjempet <b class=\"bold\">mot</b> tyskerne</div>",D:"PREPOSITIONS IN USE",X:"<div class=\"center\"><div class=\"left\">Remember that the O in <span class=\"italic\">mot</span> has the long sound.</div></div>",A:"E"},{DECK_ID:"B10",ID:"B10056",N:"<div class=\"center\">I studied <b class=\"bold\">for</b> four hours</div>",E:"<div class=\"center\">Jeg leste <b class=\"bold\">i</b> fire timer</div>",D:"PREPOSITIONS IN USE",X:"<div class=\"center\"><div class=\"left\"><p>Remember that Norwegian uses <span class=\"italic\">i</span> for an elapsed, continuous time.</p>Also, <span class=\"italic\">\xe5 lese</span> refers to the act of studying, whereas <span class=\"italic\">\xe5 studere</span> has a more general meaning of attending university.</div></div>",A:"E"},{DECK_ID:"B10",ID:"B10057",N:"<div class=\"center\">Jakob fought <b class=\"bold\">against</b> Bodil in the final</div>",E:"<div class=\"center\">Jakob kjempet <b class=\"bold\">mot</b> Bodil i finalen</div>",D:"PREPOSITIONS IN USE",X:"<div class=\"center\"><div class=\"left\">Remember that the O in <span class=\"italic\">mot</span> has the long sound.</div></div>",A:"E"},{DECK_ID:"B10",ID:"B10058",N:"<div class=\"center\">She had saved up much <b class=\"bold\">through</b> the years</div>",E:"<div class=\"center\">Hun hadde spart opp mye <b class=\"bold\">gjennom</b> \xe5rene</div>",D:"PREPOSITIONS IN USE",X:"",A:"E"},{DECK_ID:"B10",ID:"B10059",N:"<div class=\"center\">The daughter <b class=\"bold\">of</b> the author is seventeen</div>",E:"<div class=\"center\">Dattera <b class=\"bold\">til</b> forfatteren er sytten</div>",D:"PREPOSITIONS IN USE",X:"",A:"E"},{DECK_ID:"B10",ID:"B10060",N:"<div class=\"center\">We ski <b class=\"bold\">in</b> the winter</div>",E:"<div class=\"center\">Vi g\xe5r p\xe5 ski <b class=\"bold\">om</b> vinteren</div>",D:"PREPOSITIONS IN USE",X:"<div class=\"center\"><div class=\"left\">Norwegian uses \"to go on skis\" rather than \"to ski\", whilst <span class=\"italic\">om</span> is used to describe an habitual time or recurrent occasion (<span class=\"italic\">p\xe5</span> can be used to the same effect).</div></div>",A:"E"},{DECK_ID:"B10",ID:"B10061",N:"<div class=\"center\"><b class=\"bold\">At</b> the same moment</div>",E:"<div class=\"center\"><b class=\"bold\">I</b> samme \xf8yeblikk</div>",D:"PREPOSITIONS IN USE",X:"",A:"E"},{DECK_ID:"B10",ID:"B10062",N:"<div class=\"center\">Are you strong enough <b class=\"bold\">to</b> say \"no\" to that?</div>",E:"<div class=\"center\">Er du sterk nok <b class=\"bold\">til</b> \xe5 si \"nei\" til det?</div>",D:"PREPOSITIONS IN USE",X:"",A:"E"},{DECK_ID:"B10",ID:"B10063",N:"<div class=\"center\">I have experience <b class=\"bold\">in</b> HTML5</div>",E:"<div class=\"center\">Jeg har erfaring <b class=\"bold\">i</b> HTML5</div>",D:"PREPOSITIONS IN USE",X:"<div class=\"center\">You could also use <span class=\"italic\">med</span></div>",A:"E"},{DECK_ID:"B10",ID:"B10064",N:"<div class=\"center\">I'm yearning <b class=\"bold\">for</b> the spring</div>",E:"<div class=\"center\">Jeg lengter <b class=\"bold\">etter</b> v\xe5ren</div>",D:"PREPOSITIONS IN USE",X:"",A:"E"},{DECK_ID:"B10",ID:"B10065",N:"<div class=\"center\">Jan walked <b class=\"bold\">across</b> the street</div>",E:"<div class=\"center\">Jan gikk <b class=\"bold\">over</b> gaten</div>",D:"PREPOSITIONS IN USE",X:"",A:"E"},{DECK_ID:"B10",ID:"B10066",N:"<div class=\"center\">She was kept <b class=\"bold\">from</b> coming</div>",E:"<div class=\"center\">Hun var forhindret <b class=\"bold\">fra</b> \xe5 komme</div>",D:"PREPOSITIONS IN USE",X:"",A:"E"},{DECK_ID:"B10",ID:"B10067",N:"<div class=\"center\">The teacher is strict <b class=\"bold\">about</b> grammar</div>",E:"<div class=\"center\">L\xe6reren er streng <b class=\"bold\">med</b> grammatikken</div>",D:"PREPOSITIONS IN USE",X:"<div class=\"center\"><div class=\"left\">Remember that the D at the end of <span class=\"italic\">med</span> is silent</div></div>",A:"E"},{DECK_ID:"B10",ID:"B10068",N:"<div class=\"center\">We will call (by phone) <b class=\"bold\">for</b> a taxi</div>",E:"<div class=\"center\">Vi skal ringe <b class=\"bold\">etter</b> en taxi</div>",D:"PREPOSITIONS IN USE",X:"",A:"E"},{DECK_ID:"B10",ID:"B10069",N:"<div class=\"center\"><b class=\"bold\">Between</b> the two of us, it was done poorly</div>",E:"<div class=\"center\"><b class=\"bold\">Mellom</b> oss sagt, det var d\xe5rlig gjort</div>",D:"PREPOSITIONS IN USE",X:"",A:"E"},{DECK_ID:"B10",ID:"B10070",N:"<div class=\"center\">It's a display <b class=\"bold\">of</b> gratitude</div>",E:"<div class=\"center\">Det er et bevis <b class=\"bold\">p\xe5</b> takknemlighet</div>",D:"PREPOSITIONS IN USE",X:"",A:"E"},{DECK_ID:"B10",ID:"B10071",N:"<div class=\"center\">There isn't any sign <b class=\"bold\">of</b> life</div>",E:"<div class=\"center\">Det er ikke noe tegn <b class=\"bold\">til</b> liv</div>",D:"PREPOSITIONS IN USE",X:"",A:"E"},{DECK_ID:"B10",ID:"B10072",N:"<div class=\"center\">A development <b class=\"bold\">within</b> Norwegian theatre</div>",E:"<div class=\"center\">En utvikling <b class=\"bold\">innen(for)</b> norsk teater</div>",D:"PREPOSITIONS IN USE",X:"<div class=\"center\">The <span class=\"italic\">for</span> part is optional</div>",A:"E"},{DECK_ID:"B10",ID:"B10073",N:"<div class=\"center\">She is good <b class=\"bold\">at</b> English</div>",E:"<div class=\"center\">Hun er god <b class=\"bold\">i</b> engelsk</div>",D:"PREPOSITIONS IN USE",X:"",A:"E"},{DECK_ID:"B10",ID:"B10074",N:"<div class=\"center\">They will be sorted <b class=\"bold\">by</b> initial</div>",E:"<div class=\"center\">De skal sorteres <b class=\"bold\">etter</b> forbokstav</div>",D:"PREPOSITIONS IN USE",X:"<div class=\"center\"><div class=\"left\">Note the use of the S for the passive</div></div>",A:"E"},{DECK_ID:"B10",ID:"B10075",N:"<div class=\"center\">An order <b class=\"bold\">of</b> the new products</div>",E:"<div class=\"center\">En bestilling <b class=\"bold\">p\xe5</b> de nye produktene</div>",D:"PREPOSITIONS IN USE",X:"",A:"E"},{DECK_ID:"B10",ID:"B10076",N:"<div class=\"center\">The rain hit <b class=\"bold\">against</b> the window</div>",E:"<div class=\"center\">Regnet slo <b class=\"bold\">mot</b> vinduet</div>",D:"PREPOSITIONS IN USE",X:"<div class=\"center\"><div class=\"left\">Remember that the O in <span class=\"italic\">mot</span> has the long sound.</div></div>",A:"E"},{DECK_ID:"B10",ID:"B10077",N:"<div class=\"center\">Thoughts <b class=\"bold\">around</b> this and that</div>",E:"<div class=\"center\">Refleksjoner <b class=\"bold\">omkring</b> l\xf8st og fast</div>",D:"PREPOSITIONS IN USE",X:"",A:"E"},{DECK_ID:"B10",ID:"B10078",N:"<div class=\"center\">I'll sleep <b class=\"bold\">at</b> Karianne's</div>",E:"<div class=\"center\">Jeg skal sove <b class=\"bold\">hos</b> Karianne</div>",D:"PREPOSITIONS IN USE",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">Hos</span> is basically the equivalent of the French \"chez\"</div></div>",A:"E"},{DECK_ID:"B10",ID:"B10079",N:"<div class=\"center\">The team is ready <b class=\"bold\">for</b> the final</div>",E:"<div class=\"center\">Laget er klart <b class=\"bold\">for</b> finalen</div>",D:"PREPOSITIONS IN USE",X:"",A:"E"},{DECK_ID:"B10",ID:"B10080",N:"<div class=\"center\"><b class=\"bold\">During</b> the trip, we bought a new suitcase</div>",E:"<div class=\"center\"><b class=\"bold\">Under</b> reisen kj\xf8pte vi en ny koffert</div>",D:"PREPOSITIONS IN USE",X:"<div class=\"center\"><div class=\"left\">Note the inversion of main verb and subject because the prepositional sentence (<span class=\"italic\">under reisen</span>) is used at the beginning (this is the V2 rule).</div></div>",A:"E"},{DECK_ID:"B11",ID:"B11001",N:"<div class=\"center\"><p><b class=\"bold\">Continued time (for how long?)</b></p>We\u2019ll be in Lofoten <b class=\"bold\">for</b> two weeks</div>",E:"<div class=\"center\">Vi blir i Lofoten <b class=\"bold\">i</b> to uker</div>",D:"COMPLEMENTS",X:"<div class=\"center\"><div class=\"left\">The use of <span class=\"italic\">i</span> to express a continuous length of time (whereas English would have \"for\") is a typical pitfall, learn to recognise it and to use it correctly.</div></div>",A:"E"},{DECK_ID:"B11",ID:"B11002",N:"<div class=\"center\"><p><b class=\"bold\">Determined time (how long ago?)</b></p>I went to Spain for the first time ten years <b class=\"bold\">ago</b></div>",E:"<div class=\"center\">Jeg dro til Spania f\xf8rste gang <b class=\"bold\">for</b> ti \xe5r <b class=\"bold\">siden</b></div>",D:"COMPLEMENTS",X:"<div class=\"center\"><div class=\"left\">Do not forget <span class=\"italic\">for</span> before the time unit (whether it's years, months, weeks, days, hours etc).</div></div>",A:"E"},{DECK_ID:"B11",ID:"B11003",N:"<div class=\"center\"><p><b class=\"bold\">Determined time (in what time?)</b></p>I\u2019ll be ready for the trip <b class=\"bold\">in</b> a week</div>",E:"<div class=\"center\">Jeg blir klar for turen <b class=\"bold\">om</b> ei uke</div>",D:"COMPLEMENTS",X:"<div class=\"center\"><div class=\"left\">In this case, <span class=\"italic\">om</span> is used to indicate a time which will have to elapse before something else happens.<br>Learn this well, as you might be tempted to use <span class=\"italic\">i</span>.</div></div>",A:"E"},{DECK_ID:"B11",ID:"B11004",N:"<div class=\"center\"><p><b class=\"bold\">Specification (whose? of what?)</b></p>The daughter <b class=\"bold\">of</b> a friend</div>",E:"<div class=\"center\">Dattera <b class=\"bold\">til</b> en venn</div>",D:"COMPLEMENTS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">til</span> is used in certain cases to describe the relationship, in this case a close, blood relation.</p>Otherwise, <span class=\"italic\">av</span> would be used (e.g. <span class=\"italic\">en venn av en venn</span>).</div></div>",A:"E"},{DECK_ID:"B11",ID:"B11005",N:"<div class=\"center\"><p><b class=\"bold\">Comparison</b></p>Her apartment is <b class=\"bold\">as</b> big <b class=\"bold\">as</b> yours</div>",E:"<div class=\"center\">Leiligheten hennes er <b class=\"bold\">like</b> stor <b class=\"bold\">som</b> din</div>",D:"COMPLEMENTS",X:"<div class=\"center\"><div class=\"left\"><p>The \"as [\u2026] as\" construction is translated by <span class=\"italic\">like [\u2026] som</span>. An adjective is required after <span class=\"italic\">like</span>.</p>Variations include <span class=\"italic\">akkurat [\u2026] som, n\xf8yaktig [\u2026] som, p\xe5 prikken [\u2026] som</span>.</div></div>",A:"E"},{DECK_ID:"B11",ID:"B11006",N:"<div class=\"center\"><p><b class=\"bold\">Location (in what place?)</b></p>I\u2019m <b class=\"bold\">in</b> my room</div>",E:"<div class=\"center\">Jeg er <b class=\"bold\">p\xe5</b> rommet mitt</div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11007",N:"<div class=\"center\"><p><b class=\"bold\">Comparison</b></p>He is <b class=\"bold\">as</b> strong <b class=\"bold\">as</b> you</div>",E:"<div class=\"center\">Han er <b class=\"bold\">like</b> sterk <b class=\"bold\">som</b> deg</div>",D:"COMPLEMENTS",X:"<div class=\"center\"><div class=\"left\">Instead of <span class=\"italic\">som deg</span> it is also possible to use <span class=\"italic\">som du er</span>.</div></div>",A:"E"},{DECK_ID:"B11",ID:"B11008",N:"<div class=\"center\"><p><b class=\"bold\">Comparison</b></p>Your shirt has the <b class=\"bold\">same</b> colour <b class=\"bold\">as</b> mine</div>",E:"<div class=\"center\">Skjorta di har <b class=\"bold\">samme</b> farge <b class=\"bold\">som</b> mi</div>",D:"COMPLEMENTS",X:"<div class=\"center\"><div class=\"left\">The \"same [\u2026] as\" construction is translated by <span class=\"italic\">samme [\u2026] som</span> if the term of comparison is a noun, not an adjective.</div></div>",A:"E"},{DECK_ID:"B11",ID:"B11009",N:"<div class=\"center\"><p><b class=\"bold\">Continued time (since when?)</b></p>I\u2019ve been living in Norway <b class=\"bold\">since</b> 2011</div>",E:"<div class=\"center\">Jeg har bodd i Norge <b class=\"bold\">siden</b> to tusen og elleve</div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11010",N:"<div class=\"center\"><p><b class=\"bold\">Continued time (for how long?)</b></p>He studied <b class=\"bold\">until</b> eleven at night</div>",E:"<div class=\"center\">Han studerte <b class=\"bold\">til</b> elleve p\xe5 kvelden</div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11011",N:"<div class=\"center\"><p><b class=\"bold\">Comparison</b></p>Marit has curly hair <b class=\"bold\">like</b> you have</div>",E:"<div class=\"center\">Marit har kr\xf8llete h\xe5r <b class=\"bold\">som</b> du har</div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11012",N:"<div class=\"center\"><p><b class=\"bold\">Comparison</b></p>Arne and Kyrre are <b class=\"bold\">just as</b> old</div>",E:"<div class=\"center\">Arne og Kyrre er <b class=\"bold\">like</b> gamle</div>",D:"COMPLEMENTS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">like</span> can work by itself, meaning \"equally, just as\".</p>As a side note, the name Kyrre can be pronounced also with K having the [ \xe7 ] sound of KJ.</div></div>",A:"E"},{DECK_ID:"B11",ID:"B11013",N:"<div class=\"center\"><p><b class=\"bold\">Determined time (when?)</b></p>I'm going to take holidays <b class=\"bold\">in</b> August</div>",E:"<div class=\"center\">Jeg kommer til \xe5 ta ferie <b class=\"bold\">i</b> august</div>",D:"COMPLEMENTS",X:"<div class=\"center\"><div class=\"left\">Remember that days of the week and months of the year have a lower case initial in Norwegian.</div></div>",A:"E"},{DECK_ID:"B11",ID:"B11014",N:"<div class=\"center\"><p><b class=\"bold\">Recurrent time (usually when?)</b></p><b class=\"bold\">By</b> night, a few (people) are afraid of the dark</div>",E:"<div class=\"center\"><b class=\"bold\">Om</b> kvelden er noen f\xe5 redd for m\xf8rket</div>",D:"COMPLEMENTS",X:"<div class=\"center\"><div class=\"left\"><p>Remember that <span class=\"italic\">f\xe5</span> also means \"few\".</p><span class=\"italic\">P\xe5</span> can also be used instead of <span class=\"italic\">om</span>.</div></div>",A:"E"},{DECK_ID:"B11",ID:"B11015",N:"<div class=\"center\"><p><b class=\"bold\">Specification (whose? of what?)</b></p>Ingunn\u2019<b class=\"bold\">s</b> book</div>",E:"<div class=\"center\">Ingunn<b class=\"bold\">s</b> bok</div>",D:"COMPLEMENTS",X:"<div class=\"center\"><div class=\"left\"><p>One of the options to communicate belonging and possession is the S at the end of the name.<br>No apostrophe is needed unless the noun itself ends in S or an S-like sound:</p><span class=\"italic\">Marx' skrifter</span></div></div>",A:"E"},{DECK_ID:"B11",ID:"B11016",N:"<div class=\"center\"><p><b class=\"bold\">Location (in what place?)</b></p>She was <b class=\"bold\">at</b> school this morning</div>",E:"<div class=\"center\">Hun var <b class=\"bold\">p\xe5</b> skolen i dag tidlig</div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11017",N:"<div class=\"center\"><p><b class=\"bold\">Determined time (when?)</b></p>Can you wake me up <b class=\"bold\">before</b> 07:00?</div>",E:"<div class=\"center\">Kan du vekke meg <b class=\"bold\">f\xf8r</b> sju?</div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11018",N:"<div class=\"center\"><p><b class=\"bold\">Determined time (when?)</b></p>P\xe5l arrived one hour <b class=\"bold\">earlier</b></div>",E:"<div class=\"center\">P\xe5l kom \xe9n time <b class=\"bold\">tidligere</b></div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11019",N:"<div class=\"center\"><p><b class=\"bold\">Length of time<br>(how long does/did it take?)</b></p>I drove to Sandefjord <b class=\"bold\">in</b> one hour</div>",E:"<div class=\"center\">Jeg kj\xf8rte til Sandefjord <b class=\"bold\">p\xe5</b> \xe9n time</div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11020",N:"<div class=\"center\"><p><b class=\"bold\">Location (in what place?)</b></p>I\u2019m <b class=\"bold\">at</b> work</div>",E:"<div class=\"center\">Jeg er <b class=\"bold\">p\xe5</b> jobb</div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11021",N:"<div class=\"center\"><p><b class=\"bold\">Location (in what place?)</b></p>I\u2019m <b class=\"bold\">in</b> the office</div>",E:"<div class=\"center\">Jeg er <b class=\"bold\">p\xe5</b> kontoret</div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11022",N:"<div class=\"center\"><p><b class=\"bold\">Comparison</b></p>Your socks are not <b class=\"bold\">identical</b></div>",E:"<div class=\"center\">Sokkene dine er ikke <b class=\"bold\">like</b></div>",D:"COMPLEMENTS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">like</span> translates \"similar, identical, the same\"</div></div>",A:"E"},{DECK_ID:"B11",ID:"B11023",N:"<div class=\"center\"><p><b class=\"bold\">Comparison</b></p>My brother has the <b class=\"bold\">same</b> bike <b class=\"bold\">as</b> you</div>",E:"<div class=\"center\">Broren min har <b class=\"bold\">samme</b> sykkel <b class=\"bold\">som</b> du har</div>",D:"COMPLEMENTS",X:"<div class=\"center\"><div class=\"left\">The \"same [\u2026] as\" construction is translated by <span class=\"italic\">samme [\u2026] som</span> if the term of comparison is a noun, not an adjective.</div></div>",A:"E"},{DECK_ID:"B11",ID:"B11024",N:"<div class=\"center\"><p><b class=\"bold\">Comparison</b></p>I kept going <b class=\"bold\">as</b> long <b class=\"bold\">as</b> possible</div>",E:"<div class=\"center\">Jeg fortsatte <b class=\"bold\">s\xe5</b> lenge <b class=\"bold\">som</b> mulig</div>",D:"COMPLEMENTS",X:"<div class=\"center\"><div class=\"left\"><p>The example refers to a length of the time, because <span class=\"italic\">lenge</span> is used.</p>For a distance, <span class=\"italic\">s\xe5 langt som mulig</span> must be used.</div></div>",A:"E"},{DECK_ID:"B11",ID:"B11025",N:"<div class=\"center\"><p><b class=\"bold\">Location (in what place?)</b></p>I live <b class=\"bold\">in</b> Oslo</div>",E:"<div class=\"center\">Jeg bor <b class=\"bold\">i</b> Oslo</div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11026",N:"<div class=\"center\"><p><b class=\"bold\">Recurrent time (usually when?)</b></p>I always go to the gym <b class=\"bold\">on</b> Wednesdays</div>",E:"<div class=\"center\">Jeg drar alltid p\xe5 trening <b class=\"bold\">p\xe5</b> onsdager</div>",D:"COMPLEMENTS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">Om</span> can be used instead of <span class=\"italic\">p\xe5</span>, but it requires the definite form (e.g. <span class=\"italic\">om onsdagene</span>).</div></div>",A:"E"},{DECK_ID:"B11",ID:"B11027",N:"<div class=\"center\"><p><b class=\"bold\">Continued time (for how long?)</b></p>I\u2019ll remember this day <b class=\"bold\">forever</b></div>",E:"<div class=\"center\">Jeg kommer til \xe5 huske denne dagen <b class=\"bold\">for alltid</b></div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11028",N:"<div class=\"center\"><p><b class=\"bold\">Movement to location (to what place?)</b></p>I must go <b class=\"bold\">to</b> the hospital</div>",E:"<div class=\"center\">Jeg m\xe5 <b class=\"bold\">til</b> sykehuset</div>",D:"COMPLEMENTS",X:"<div class=\"center\"><div class=\"left\">Verbs of movement such as <span class=\"italic\">g\xe5, dra, reise, fly</span> can be skipped if the meaning is obvious and there is an auxiliary verb (e.g. <span class=\"italic\">skal, m\xe5, vil</span>).</div></div>",A:"E"},{DECK_ID:"B11",ID:"B11029",N:"<div class=\"center\"><p><b class=\"bold\">Movement to location (to what place?)</b></p>She\u2019s going <b class=\"bold\">to</b> the hairdresser</div>",E:"<div class=\"center\">Hun skal <b class=\"bold\">til</b> fris\xf8ren</div>",D:"COMPLEMENTS",X:"<div class=\"center\"><div class=\"left\">Verbs of movement such as <span class=\"italic\">g\xe5, dra, reise, fly</span> can be skipped if the meaning is obvious and there is an auxiliary verb (e.g. <span class=\"italic\">skal, m\xe5, vil</span>).</div></div>",A:"E"},{DECK_ID:"B11",ID:"B11030",N:"<div class=\"center\"><p><b class=\"bold\">Comparison</b></p>You must do <b class=\"bold\">as</b> I say</div>",E:"<div class=\"center\">Du m\xe5 gj\xf8re <b class=\"bold\">som</b> jeg sier</div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11031",N:"<div class=\"center\"><p><b class=\"bold\">Comparison</b></p>I\u2019m not <b class=\"bold\">as</b> capable <b class=\"bold\">as</b> you</div>",E:"<div class=\"center\">Jeg er ikke <b class=\"bold\">s\xe5</b> flink <b class=\"bold\">som</b> du</div>",D:"COMPLEMENTS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">S\xe5</span> can be used as an alternative to <span class=\"italic\">like</span></div></div>",A:"E"},{DECK_ID:"B11",ID:"B11032",N:"<div class=\"center\"><p><b class=\"bold\">Partition (among whom/what?)</b></p>One <b class=\"bold\">of</b> us must go back</div>",E:"<div class=\"center\">\xc9n <b class=\"bold\">av</b> oss m\xe5 g\xe5 tilbake</div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11033",N:"<div class=\"center\"><p><b class=\"bold\">Comparison</b></p>He\u2019s acting <b class=\"bold\">as if</b> he is drunk</div>",E:"<div class=\"center\">Han later <b class=\"bold\">som om</b> han er full</div>",D:"COMPLEMENTS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">som om</span> is the expression that translates \"as if\"</div></div>",A:"E"},{DECK_ID:"B11",ID:"B11034",N:"<div class=\"center\"><p><b class=\"bold\">Comparison</b></p>H\xe5kon\u2019s stereo sounds <b class=\"bold\">different</b></div>",E:"<div class=\"center\">H\xe5kons stereoanlegg h\xf8res <b class=\"bold\">annerledes</b> ut</div>",D:"COMPLEMENTS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Annerledes</span> often translates \"different\" as an adverb or when there is no other term of comparison.<br>It could be translated colloquially as \"something else\":</p>H\xe5kon\u2019s stereo sounds like something else</div></div>",A:"E"},{DECK_ID:"B11",ID:"B11035",N:"<div class=\"center\"><p><b class=\"bold\">Partition (among whom/what?)</b></p>The most part <b class=\"bold\">of</b> teachers is on strike</div>",E:"<div class=\"center\">Flesteparten <b class=\"bold\">av</b> l\xe6rerne er i streik</div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11036",N:"<div class=\"center\"><p><b class=\"bold\">Denomination</b></p>The Kingdom <b class=\"bold\">of</b> Norway</div>",E:"<div class=\"center\">Kongeriket Norge</div>",D:"COMPLEMENTS",X:"<div class=\"center\"><div class=\"left\">When expressing \"denomination\", the <span class=\"italic\">av</span> becomes implicit.</div></div>",A:"E"},{DECK_ID:"B11",ID:"B11037",N:"<div class=\"center\"><p><b class=\"bold\">Denomination</b></p>He was known by the name <b class=\"bold\">of</b> Lasse</div>",E:"<div class=\"center\">Han var kjent under navnet Lasse</div>",D:"COMPLEMENTS",X:"<div class=\"center\"><div class=\"left\">When expressing \"denomination\", the <span class=\"italic\">av</span> becomes implicit.</div></div>",A:"E"},{DECK_ID:"B11",ID:"B11038",N:"<div class=\"center\"><p><b class=\"bold\">Term (to whom? to what?)</b></p>She smiled <b class=\"bold\">to</b> me</div>",E:"<div class=\"center\">Hun smilte <b class=\"bold\">til</b> meg</div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11039",N:"<div class=\"center\"><p><b class=\"bold\">Term (to whom? to what?)</b></p>Look <b class=\"bold\">at</b> me!</div>",E:"<div class=\"center\">Se <b class=\"bold\">p\xe5</b> meg!</div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11040",N:"<div class=\"center\"><p><b class=\"bold\">Agent (by whom? by what?)</b></p>This spelling mistake was done <b class=\"bold\">by</b> Arne</div>",E:"<div class=\"center\">Denne skrivefeilen ble gjort <b class=\"bold\">av</b> Arne</div>",D:"COMPLEMENTS",X:"<div class=\"center\"><span class=\"italic\">Av</span> translates also as \"by\"</div>",A:"E"},{DECK_ID:"B11",ID:"B11041",N:"<div class=\"center\"><p><b class=\"bold\">Origin (from where? from what?)</b></p>I got a job offer <b class=\"bold\">from</b> the bank</div>",E:"<div class=\"center\">Jeg fikk et jobbtilbud <b class=\"bold\">fra</b> banken</div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11042",N:"<div class=\"center\"><p><b class=\"bold\">Cause (for what reason? why?)</b></p>We won\u2019t leave <b class=\"bold\">because of</b> the bad weather</div>",E:"<div class=\"center\">Vi reiser ikke herfra <b class=\"bold\">p\xe5 grunn av</b> v\xe6ret</div>",D:"COMPLEMENTS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">p\xe5 grunn av</span> is a very used expression in Norwegian, meaning \"because of\".</div></div>",A:"E"},{DECK_ID:"B11",ID:"B11043",N:"<div class=\"center\"><p><b class=\"bold\">Cause (for what reason? why?)</b></p>Thanks <b class=\"bold\">for</b> writing</div>",E:"<div class=\"center\">Takk <b class=\"bold\">for</b> at du skrev</div>",D:"COMPLEMENTS",X:"<div class=\"center\"><div class=\"left\">Literally: thanks for the fact that you wrote</div></div>",A:"E"},{DECK_ID:"B11",ID:"B11044",N:"<div class=\"center\"><p><b class=\"bold\">Quantity/measurement</b></p>Trondheim is <b class=\"bold\">more or less</b> 600 kilometres far</div>",E:"<div class=\"center\"><div class=\"left\">Trondheim er <b class=\"bold\">mer eller mindre</b> seks hundre kilometer unna</div></div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11045",N:"<div class=\"center\"><p><b class=\"bold\">Quantity/measurement</b></p>Petrol costs 15 <span class=\"italic\">kroner</span> <b class=\"bold\">per</b> litre</div>",E:"<div class=\"center\">Bensin koster femten kroner <b class=\"bold\">per</b> liter</div>",D:"COMPLEMENTS",X:"<div class=\"center\"><div class=\"left\">As alternative, the definite form of the measurement unit (in this case <span class=\"italic\">literen</span>) can be used instead of <span class=\"italic\">per liter</span>.</div></div>",A:"E"},{DECK_ID:"B11",ID:"B11046",N:"<div class=\"center\"><p><b class=\"bold\">Purpose & end (with what purpose?)</b></p>This tool is useful <b class=\"bold\">for</b> many tasks</div>",E:"<div class=\"center\">Dette verkt\xf8yet er nyttig <b class=\"bold\">til</b> mange oppgaver</div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11047",N:"<div class=\"center\"><p><b class=\"bold\">Comparison</b></p><b class=\"bold\">The more</b> you talk, <b class=\"bold\">the less</b> I listen</div>",E:"<div class=\"center\"><b class=\"bold\">Jo mer</b> du prater,<br><b class=\"bold\">desto mindre</b> h\xf8rer jeg p\xe5</div>",D:"COMPLEMENTS",X:"<div class=\"center\"><div class=\"left\">Note the inversion of main verb and subject because the subordinate clause (<span class=\"italic\">jo mer du prater</span>) is used at the beginning (this is the V2 rule).</div></div>",A:"E"},{DECK_ID:"B11",ID:"B11048",N:"<div class=\"center\"><p><b class=\"bold\">Comparison</b></p>She is <b class=\"bold\">as</b> nice <b class=\"bold\">as</b> she is beautiful</div>",E:"<div class=\"center\">Hun er <b class=\"bold\">like</b> snill <b class=\"bold\">som</b> hun er vakker</div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11049",N:"<div class=\"center\"><p><b class=\"bold\">Comparison</b></p><b class=\"bold\">The more</b> you train,<br><b class=\"bold\">the stronger</b> you get</div>",E:"<div class=\"center\"><b class=\"bold\">Jo mer</b> du trener,<br><b class=\"bold\">desto sterkere</b> blir du</div>",D:"COMPLEMENTS",X:"<div class=\"center\"><div class=\"left\">Note the inversion of main verb and subject because the subordinate clause (<span class=\"italic\">jo mer du trener</span>) is used at the beginning</div></div>",A:"E"},{DECK_ID:"B11",ID:"B11050",N:"<div class=\"center\"><p><b class=\"bold\">Length of time<br>(how long does/did it take?)</b></p>You can\u2019t cook potatoes <b class=\"bold\">in</b> five minutes!</div>",E:"<div class=\"center\">Du kan ikke koke poteter <b class=\"bold\">p\xe5</b> fem minutter</div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11051",N:"<div class=\"center\"><p><b class=\"bold\">Means & instrument <br>(with the help of what?)</b></p>The boss came to the office <b class=\"bold\">by</b> car</div>",E:"<div class=\"center\">Sjefen kom til kontoret <b class=\"bold\">i</b> bil</div>",D:"COMPLEMENTS",X:"<div class=\"center\"><div class=\"left\">The preposition <span class=\"italic\">med</span> can also be used in this case.</div></div>",A:"E"},{DECK_ID:"B11",ID:"B11052",N:"<div class=\"center\"><p><b class=\"bold\">Way & manner (how? in what way?)</b></p>This was done <b class=\"bold\">in</b> Randi\u2019s way</div>",E:"<div class=\"center\">Dette ble gjort <b class=\"bold\">p\xe5</b> Randis m\xe5te</div>",D:"COMPLEMENTS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">P\xe5 en m\xe5te</span> is also a useful expression meaning \"in a way\", \"somehow\".</div></div>",A:"E"},{DECK_ID:"B11",ID:"B11053",N:"<div class=\"center\"><p><b class=\"bold\">Limitation (limited to what?)</b></p>I am <b class=\"bold\">good at</b> listening</div>",E:"<div class=\"center\">Jeg er <b class=\"bold\">god til</b> \xe5 lytte</div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11054",N:"<div class=\"center\"><p><b class=\"bold\">Topic (regarding what?)</b></p>I read a good article <b class=\"bold\">on</b> solar energy</div>",E:"<div class=\"center\">Jeg leste en bra artikkel <b class=\"bold\">om</b> solenergi</div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11055",N:"<div class=\"center\"><p><b class=\"bold\">Exclamations</b></p><b class=\"bold\">What a</b> nightmare of a road!</div>",E:"<div class=\"center\"><b class=\"bold\">For et</b> mareritt av en vei!</div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11056",N:"<div class=\"center\"><p><b class=\"bold\">Exclamations</b></p><b class=\"bold\">What a</b> shame!</div>",E:"<div class=\"center\"><b class=\"bold\">Det var</b> synd!</div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11057",N:"<div class=\"center\"><p><b class=\"bold\">Exclamations</b></p>Poor you!</div>",E:"<div class=\"center\">Stakkars deg!</div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11058",N:"<div class=\"center\"><p><b class=\"bold\">Length of time<br>(how long does/did it take?)</b></p>The ferry to Gothenburg <b class=\"bold\">takes</b> six hours</div>",E:"<div class=\"center\">Fergen til G\xf8teborg <b class=\"bold\">tar</b> seks timer</div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11059",N:"<div class=\"center\"><p><b class=\"bold\">Determined time (when?)</b></p>He was born <b class=\"bold\">in</b> 1983</div>",E:"<div class=\"center\">Han ble f\xf8dt <b class=\"bold\">i</b> nitten \xe5ttitre</div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11060",N:"<div class=\"center\"><p><b class=\"bold\">Recurrent time (usually when?)</b></p>I often feel lazy <b class=\"bold\">in</b> the morning(s)</div>",E:"<div class=\"center\">Jeg f\xf8ler meg ofte lat <b class=\"bold\">om</b> morgenen/ene</div>",D:"COMPLEMENTS",X:"<div class=\"center\"><span class=\"italic\">P\xe5</span> can also be used instead of <span class=\"italic\">om</span>.</div>",A:"E"},{DECK_ID:"B11",ID:"B11061",N:"<div class=\"center\"><p><b class=\"bold\">Determined time (when?)</b></p><b class=\"bold\">This coming Friday</b> I'll meet a friend</div>",E:"<div class=\"center\"><b class=\"bold\">N\xe5 p\xe5 fredag</b> skal jeg treffe en venn</div>",D:"COMPLEMENTS",X:"<div class=\"center\"><div class=\"left\">When you need to refer to the next instance of a day in the week, ideally you should use <span class=\"italic\">n\xe5 p\xe5</span>.</div></div>",A:"E"},{DECK_ID:"B11",ID:"B11062",N:"<div class=\"center\"><p><b class=\"bold\">Determined time (when?)</b></p>He\u2019s often worried <b class=\"bold\">before</b> an exam</div>",E:"<div class=\"center\">Han er ofte bekymret <b class=\"bold\">f\xf8r</b> en eksamen</div>",D:"COMPLEMENTS",X:"<div class=\"center\"><div class=\"left\">Remember that <span class=\"italic\">en eksamen</span> is one of those <span class=\"italic\">hankj\xf8nn</span> words that already ends in -EN in the <span class=\"italic\">ubestemt</span> form.</div></div>",A:"E"},{DECK_ID:"B11",ID:"B11063",N:"<div class=\"center\"><p><b class=\"bold\">Determined time (when?)</b></p>I will come to visit you <b class=\"bold\">after</b> Easter</div>",E:"<div class=\"center\">Jeg kommer og bes\xf8ker deg <b class=\"bold\">etter</b> p\xe5ske</div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11064",N:"<div class=\"center\"><p><b class=\"bold\">Determined time (at what time?)</b></p>The document will be ready <b class=\"bold\">at</b> five</div>",E:"<div class=\"center\">Dokumentet kommer til \xe5 v\xe6re klart <b class=\"bold\">til</b> fem</div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11065",N:"<div class=\"center\"><p><b class=\"bold\">Continued time (for how long?)</b></p>I lived in England <b class=\"bold\">for</b> six years</div>",E:"<div class=\"center\">Jeg bodde i England <b class=\"bold\">i</b> seks \xe5r</div>",D:"COMPLEMENTS",X:"<div class=\"center\"><div class=\"left\">The use of <span class=\"italic\">i</span> to express a continuous length of time (whereas English would have \"for\") is a typical pitfall, learn to recognise it and to use it correctly.</div></div>",A:"E"},{DECK_ID:"B11",ID:"B11066",N:"<div class=\"center\"><p><b class=\"bold\">Continued time (for how long?)</b></p>I\u2019ve been worried <b class=\"bold\">the whole day</b></div>",E:"<div class=\"center\">Jeg har v\xe6rt bekymret <b class=\"bold\">hele dagen</b></div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11067",N:"<div class=\"center\"><p><b class=\"bold\">Continued time (for how long?)</b></p>They\u2019ve been living together <b class=\"bold\">ever since</b></div>",E:"<div class=\"center\">De har bodd sammen <b class=\"bold\">siden</b></div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11068",N:"<div class=\"center\"><p><b class=\"bold\">Location (in what place?)</b></p>He is <b class=\"bold\">at</b> the university this afternoon</div>",E:"<div class=\"center\">Han er <b class=\"bold\">p\xe5</b> universitetet i ettermiddag</div>",D:"COMPLEMENTS",X:"<div class=\"center\"><div class=\"left\">Expression like \"this year\", \"this afternoon\", \"tonight\" are often in the <span class=\"italic\">ubestemt</span> form in Norwegian (i.e. no end article): <span class=\"italic\">i \xe5r, i ettermiddag, i natt</span>.</div></div>",A:"E"},{DECK_ID:"B11",ID:"B11069",N:"<div class=\"center\"><p><b class=\"bold\">Location (in what place?)</b></p>I\u2019m <b class=\"bold\">at</b> the hospital</div>",E:"<div class=\"center\">Jeg er <b class=\"bold\">p\xe5</b> sykehuset</div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11070",N:"<div class=\"center\"><p><b class=\"bold\">Location (in what place?)</b></p>I was born <b class=\"bold\">in</b> France</div>",E:"<div class=\"center\">Jeg ble f\xf8dt <b class=\"bold\">i</b> Frankrike</div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11071",N:"<div class=\"center\"><p><b class=\"bold\">Location (in what place?)</b></p>I\u2019m <b class=\"bold\">at</b> the movies</div>",E:"<div class=\"center\">Jeg er <b class=\"bold\">p\xe5</b> kino</div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11072",N:"<div class=\"center\"><p><b class=\"bold\">Location (in what place?)</b></p>I\u2019m <b class=\"bold\">at</b> the gym</div>",E:"<div class=\"center\">Jeg er <b class=\"bold\">p\xe5</b> treningssenteret</div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11073",N:"<div class=\"center\"><p><b class=\"bold\">Specification (whose? of what?)</b></p>The latest movie <b class=\"bold\">by</b> Tarantino</div>",E:"<div class=\"center\">Tarantino<b class=\"bold\">s</b> siste film</div>",D:"COMPLEMENTS",X:"<div class=\"center\"><div class=\"left\">One of the options to communicate belonging and possession is the S at the end of the name. No apostrophe is needed.</div></div>",A:"E"},{DECK_ID:"B11",ID:"B11074",N:"<div class=\"center\"><p><b class=\"bold\">Specification (whose? of what?)</b></p>A friend <b class=\"bold\">of</b> mine</div>",E:"<div class=\"center\">En venn <b class=\"bold\">av</b> meg</div>",D:"COMPLEMENTS",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">av</span> (which can be roughly translated as \"of\") is an option for specification</div></div>",A:"E"},{DECK_ID:"B11",ID:"B11075",N:"<div class=\"center\"><p><b class=\"bold\">Partition (among whom/what?)</b></p><b class=\"bold\">Among</b> the boys, Jakob is the strongest</div>",E:"<div class=\"center\"><b class=\"bold\">Blant</b> guttene er Jakob den sterkeste</div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11076",N:"<div class=\"center\"><p><b class=\"bold\">Term (to whom? to what?)</b></p>He gave his old skis <b class=\"bold\">to</b> Arne</div>",E:"<div class=\"center\">Han ga de gamle skiene sine <b class=\"bold\">til</b> Arne</div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11077",N:"<div class=\"center\"><p><b class=\"bold\">Term (to whom? to what?)</b></p>The person <b class=\"bold\">to</b> whom we assigned the task is good</div>",E:"<div class=\"center\">Personen vi ga oppgaven <b class=\"bold\">til</b> er dyktig</div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11078",N:"<div class=\"center\"><p><b class=\"bold\">Agent (by whom? by what?)</b></p>The painting was bought <b class=\"bold\">by</b> Granpa</div>",E:"<div class=\"center\">Maleriet ble kj\xf8pt <b class=\"bold\">av</b> bestefar</div>",D:"COMPLEMENTS",X:"<div class=\"center\"><span class=\"italic\">av</span> translates also \"by\"</div>",A:"E"},{DECK_ID:"B11",ID:"B11079",N:"<div class=\"center\"><p><b class=\"bold\">Cause (for what reason? why?)</b></p>I'm doing this <b class=\"bold\">for</b> your sake</div>",E:"<div class=\"center\">Jeg gj\xf8r det <b class=\"bold\">for</b> din skyld</div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11080",N:"<div class=\"center\"><p><b class=\"bold\">Quality (characterised, made by what?)</b></p>This tool is made <b class=\"bold\">of</b> stainless steel</div>",E:"<div class=\"center\">Dette verkt\xf8yet er laget <b class=\"bold\">av</b> rustfritt st\xe5l</div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11081",N:"<div class=\"center\"><p><b class=\"bold\">Quantity/measurement</b></p>It\u2019s 100 kroner a <b class=\"bold\">piece</b></div>",E:"<div class=\"center\">Det koster ett hundre kroner <b class=\"bold\">stykket</b></div>",D:"COMPLEMENTS",X:"<div class=\"center\"><div class=\"left\">As alternative, <span class=\"italic\">per stykk</span> can be used instead of the definite form of the measurement unit (in this case, <span class=\"italic\">stykket</span>).</div></div>",A:"E"},{DECK_ID:"B11",ID:"B11082",N:"<div class=\"center\"><p><b class=\"bold\">Purpose & end (with what purpose?)</b></p>We are working <b class=\"bold\">to</b> prepare the exhibition</div>",E:"<div class=\"center\">Vi jobber <b class=\"bold\">med</b> \xe5 forberede utstillingen</div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11083",N:"<div class=\"center\"><p><b class=\"bold\">Means & instrument <br>(with the help of what?)</b></p>I\u2019ll let you have the cheque <b class=\"bold\">by</b> mail</div>",E:"<div class=\"center\">Jeg sender sjekken til deg <b class=\"bold\">i</b> posten</div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11084",N:"<div class=\"center\"><p><b class=\"bold\">Means & instrument <br>(with the help of what?)</b></p>I can pay you <b class=\"bold\">via</b> internet banking</div>",E:"<div class=\"center\">Jeg kan betale deg <b class=\"bold\">via</b> nettbanken</div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11085",N:"<div class=\"center\"><p><b class=\"bold\">Way & manner (how? in what way?)</b></p>They listened <b class=\"bold\">in</b> silence</div>",E:"<div class=\"center\">De lyttet <b class=\"bold\">i</b> stillhet</div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11086",N:"<div class=\"center\"><p><b class=\"bold\">Limitation (limited to what?)</b></p>She is good <b class=\"bold\">at</b> maths</div>",E:"<div class=\"center\">Hun er flink <b class=\"bold\">i</b> matte</div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11087",N:"<div class=\"center\"><p><b class=\"bold\">Limitation (limited to what?)</b></p><b class=\"bold\">In my opinion</b> you are wrong</div>",E:"<div class=\"center\"><b class=\"bold\">Etter min mening</b> tar du feil</div>",D:"COMPLEMENTS",X:"<div class=\"center\"><div class=\"left\">Remember that <span class=\"italic\">\xe5 mene</span> (and related words) translates as \"to be of the opinion of\", not only \"to mean\".</div></div>",A:"E"},{DECK_ID:"B11",ID:"B11088",N:"<div class=\"center\"><p><b class=\"bold\">Topic (regarding what?)</b></p>He\u2019s always talking <b class=\"bold\">about</b> football</div>",E:"<div class=\"center\">Han snakker alltid <b class=\"bold\">om</b> fotball</div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11089",N:"<div class=\"center\"><p><b class=\"bold\">Exclamations</b></p><b class=\"bold\">You</b> bloody idiot!</div>",E:"<div class=\"center\"><b class=\"bold\">Din</b> j\xe6vla idiot!</div>",D:"COMPLEMENTS",X:"<div class=\"center\">Literally: <b class=\"bold\">your</b> bloody idiot</div>",A:"E"},{DECK_ID:"B11",ID:"B11090",N:"<div class=\"center\"><p><b class=\"bold\">Determined time (at what time?)</b></p>She met me at 17:00 <b class=\"bold\">this afternoon</b></div>",E:"<div class=\"center\">Hun traff meg klokka fem <b class=\"bold\">i</b> ettermiddag</div>",D:"COMPLEMENTS",X:"<div class=\"center\"><div class=\"left\">Remember that <span class=\"italic\">i</span> followed by a time period such as <span class=\"italic\">morgen, dag, \xe5r</span> tends to refer to the current or next possible instance.</div></div>",A:"E"},{DECK_ID:"B11",ID:"B11091",N:"<div class=\"center\"><p><b class=\"bold\">Determined time (when?)</b></p>See you <b class=\"bold\">in</b> October!</div>",E:"<div class=\"center\">Vi ses <b class=\"bold\">i</b> oktober</div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11092",N:"<div class=\"center\"><p><b class=\"bold\">Determined time (when?)</b></p>Mari was born three years <b class=\"bold\">after</b> Kari</div>",E:"<div class=\"center\">Mari ble f\xf8dt tre \xe5r <b class=\"bold\">etter</b> Kari</div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11093",N:"<div class=\"center\"><p><b class=\"bold\">Determined time (by what time?)</b></p>The document will be ready <b class=\"bold\">by</b> five</div>",E:"<div class=\"center\">Dokumentet kommer til \xe5 v\xe6re klart <b class=\"bold\">innen</b> fem</div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11094",N:"<div class=\"center\"><p><b class=\"bold\">Continued time (for how long?)</b></p>She went to the gym <b class=\"bold\">for</b> two hours</div>",E:"<div class=\"center\">Hun dro p\xe5 treningsstudioet <b class=\"bold\">i</b> to timer</div>",D:"COMPLEMENTS",X:"<div class=\"center\"><div class=\"left\">The use of <span class=\"italic\">i</span> to express a continuous length of time (whereas English would have \"for\") is a typical pitfall, learn to recognise it and to use it correctly.</div></div>",A:"E"},{DECK_ID:"B11",ID:"B11095",N:"<div class=\"center\"><p><b class=\"bold\">Continued time (for how long?)</b></p>Karl has had the sandals <b class=\"bold\">for</b> many years</div>",E:"<div class=\"center\">Karl har hatt sandalene <b class=\"bold\">i</b> mange \xe5r</div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11096",N:"<div class=\"center\"><p><b class=\"bold\">Location (in what place?)</b></p>My flat is <b class=\"bold\">in</b> J\xf8rgen L\xf8vlands gate</div>",E:"<div class=\"center\">Leiligheten min ligger <b class=\"bold\">i</b> J\xf8rgen L\xf8vlands gate</div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11097",N:"<div class=\"center\"><p><b class=\"bold\">Location (in what place?)</b></p>Oslo is <b class=\"bold\">by</b> the sea</div>",E:"<div class=\"center\">Oslo ligger <b class=\"bold\">ved</b> havet</div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11098",N:"<div class=\"center\"><p><b class=\"bold\">Specification (whose? of what?)</b></p>The Rolling Stones<b class=\"bold\">'</b> first album</div>",E:"<div class=\"center\">The Rolling Stones<b class=\"bold\">\u2019</b> f\xf8rste album</div>",D:"COMPLEMENTS",X:"<div class=\"center\"><div class=\"left\"><p>One of the options to communicate belonging and possession is the S at the end of the name.</p>No apostrophe is needed unless the noun itself ends in S, in which case the apostrophe can be used.</div></div>",A:"E"},{DECK_ID:"B11",ID:"B11099",N:"<div class=\"center\"><p><b class=\"bold\">Partition (among whom/what?)</b></p>Can you give me <b class=\"bold\">some of</b> your records?</div>",E:"<div class=\"center\">Kan du gi meg <b class=\"bold\">noen av</b> platene dine?</div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11100",N:"<div class=\"center\"><p><b class=\"bold\">Denomination</b></p>The Pacific Ocean</div>",E:"<div class=\"center\">Stillehavet</div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11101",N:"<div class=\"center\"><p><b class=\"bold\">Term (to whom? to what?)</b></p>This cat <b class=\"bold\">belongs to</b> Berit</div>",E:"<div class=\"center\">Katten <b class=\"bold\">tilh\xf8rer</b> Berit</div>",D:"COMPLEMENTS",X:"<div class=\"center\"><div class=\"left\"><p>Note how the verb <span class=\"italic\">tilh\xf8rer</span> already includes <span class=\"italic\">til</span>, being one of those \"prepositional verbs\" (<span class=\"italic\">sammensatte verb</span>).</p>It conjugates just like <span class=\"italic\">h\xf8re</span>, but with <span class=\"italic\">til</span> in front.</div></div>",A:"E"},{DECK_ID:"B11",ID:"B11102",N:"<div class=\"center\"><p><b class=\"bold\">Agent (by whom? by what?)</b></p>The South Pole was first reached <b class=\"bold\">by</b> Amundsen</div>",E:"<div class=\"center\">S\xf8rpolen ble f\xf8rst n\xe5dd <b class=\"bold\">av</b> Amundsen</div>",D:"COMPLEMENTS",X:"<div class=\"center\"><span class=\"italic\">av</span> translates also \"by\"</div>",A:"E"},{DECK_ID:"B11",ID:"B11103",N:"<div class=\"center\"><p><b class=\"bold\">Cause (for what reason? why?)</b></p>She turned white <b class=\"bold\">because of</b> the fear</div>",E:"<div class=\"center\">Hun ble hvit <b class=\"bold\">av</b> frykt</div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11104",N:"<div class=\"center\"><p><b class=\"bold\">Quality (characterised, made by what?)</b></p>He is a consultant <b class=\"bold\">of</b> great experience</div>",E:"<div class=\"center\">Han er en konsulent <b class=\"bold\">med</b> mye erfaring</div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11105",N:"<div class=\"center\"><p><b class=\"bold\">Quantity/measurement</b></p>This dumbbell weighs <b class=\"bold\">about</b> ten kilos</div>",E:"<div class=\"center\">Denne manualen veier <b class=\"bold\">omtrent</b> ti kilo</div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11106",N:"<div class=\"center\"><p><b class=\"bold\">Purpose & end (with what purpose?)</b></p>A cure <b class=\"bold\">against</b> cancer</div>",E:"<div class=\"center\">En kur <b class=\"bold\">mot</b> kreft</div>",D:"COMPLEMENTS",X:"<div class=\"center\"><div class=\"left\">Remember that the O in <span class=\"italic\">mot</span> has the long sound.</div></div>",A:"E"},{DECK_ID:"B11",ID:"B11107",N:"<div class=\"center\"><p><b class=\"bold\">Exclamations</b></p><b class=\"bold\">So</b> nice to see you!</div>",E:"<div class=\"center\"><b class=\"bold\">S\xe5</b> hyggelig \xe5 se deg!</div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11108",N:"<div class=\"center\"><p><b class=\"bold\">Exclamations</b></p>Lucky you!</div>",E:"<div class=\"center\">S\xe5 heldig du er! /<br>Heldiggris!</div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11109",N:"<div class=\"center\"><p><b class=\"bold\">Continued time (for how long?)</b></p>We waited <b class=\"bold\">for over</b> an hour</div>",E:"<div class=\"center\">Vi ventet <b class=\"bold\">i over</b> en time</div>",D:"COMPLEMENTS",X:"<div class=\"center\"><div class=\"left\">The use of <span class=\"italic\">i</span> to express a continuous length of time (whereas English would have \"for\") is a typical pitfall, learn to recognise it and to use it correctly.</div></div>",A:"E"},{DECK_ID:"B11",ID:"B11110",N:"<div class=\"center\"><p><b class=\"bold\">Continued time (for how long?)</b></p>I will work <b class=\"bold\">for</b> an hour when I\u2019ll have eaten</div>",E:"<div class=\"center\">Jeg skal arbeide <b class=\"bold\">i</b> en time n\xe5r jeg har spist</div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11111",N:"<div class=\"center\"><p><b class=\"bold\">Movement from, through place</b></p>The thieves came in <b class=\"bold\">through</b> the window</div>",E:"<div class=\"center\">Tyvene kom inn <b class=\"bold\">gjennom</b> vinduet</div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11112",N:"<div class=\"center\"><p><b class=\"bold\">Figurative movement</b></p>I\u2019m going <b class=\"bold\">through</b> a tough period</div>",E:"<div class=\"center\">Jeg g\xe5r <b class=\"bold\">gjennom</b> en t\xf8ff tid</div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11113",N:"<div class=\"center\"><p><b class=\"bold\">Specification (whose? of what?)</b></p>Kr\xe5kes\xf8lv\u2019<b class=\"bold\">s</b> latest tour</div>",E:"<div class=\"center\">Kr\xe5kes\xf8lv<b class=\"bold\">s</b> siste turn\xe9</div>",D:"COMPLEMENTS",X:"<div class=\"center\"><div class=\"left\"><p>One of the options to communicate belonging and possession is the S at the end of the name.</p>No apostrophe is needed unless the noun itself ends in -S.</div></div>",A:"E"},{DECK_ID:"B11",ID:"B11114",N:"<div class=\"center\"><p><b class=\"bold\">Quantity/measurement</b></p>I need a <b class=\"bold\">one litre</b> jug for the wine</div>",E:"<div class=\"center\">Jeg trenger en mugge <b class=\"bold\">p\xe5 \xe9n liter</b> til vinen</div>",D:"COMPLEMENTS",X:"",A:"E"},{DECK_ID:"B11",ID:"B11115",N:"<div class=\"center\"><p><b class=\"bold\">Purpose & end (with what purpose?)</b></p>Life is <b class=\"bold\">to be lived</b></div>",E:"<div class=\"center\">Livet skal <b class=\"bold\">leves</b></div>",D:"COMPLEMENTS",X:"<div class=\"center\"><div class=\"left\">Note the use of the passive with S and of the definite for <span class=\"italic\">live</span>.</div></div>",A:"E"},{DECK_ID:"B12",ID:"B12001",N:"<div class=\"center\"><div class=\"left\">What are the elements that influence the word order when making affirmations, negations and questions?</div></div>",E:"<div class=\"center\"><div class=\"left\">The elements are:<br>- an adverb or prepositional expression at the beginning of the sentence<br>- subordinate clauses and their position<br>- whether subjects and objects are pronouns or not<br>- whether the verb is \"single\" or not</div></div>",D:"WORD ORDER & SYNTAX",X:"<div class=\"center\"><div class=\"left\">A single verb is a verb in a tense such as <span class=\"italic\">presens</span> or <span class=\"italic\">preteritum</span>, which is therefore \"alone\", instead of working with the auxiliaries such as <span class=\"italic\">har, hadde</span> or with modals such as <span class=\"italic\">skal, vil, kan, m\xe5</span> etc.</div></div>",A:"E"},{DECK_ID:"B12",ID:"B12002",N:"<div class=\"center\"><p>Compare the Norwegian equivalent of:</p>It rains a lot in Bergen<br>In Bergen, it rains a lot</div>",E:"<div class=\"center\"><p><span class=\"red\">Det</span> <span class=\"teal\">regner</span> mye i Bergen</p>I Bergen <span class=\"teal\">regner</span> <span class=\"red\">det</span> mye</div>",D:"WORD ORDER & SYNTAX",X:"<div class=\"center\"><div class=\"left\"><p>In Norwegian, when an adverb or prepositional expression is put first in the sentence, subject and verb get swapped (i.e. V2 rule).</p>See how <span class=\"italic\">det regner mye</span> becomes <span class=\"italic\">regner det mye</span> in the second sentence. </div></div>",A:"E"},{DECK_ID:"B12",ID:"B12003",N:"<div class=\"center\"><p>Translate this exchange to Norwegian:</p><div class=\"left\">A: Does she have cash?<br>B: No, she doesn't.</div></div>",E:"<div class=\"center\"><div class=\"left\">A: Har hun kontanter?<br>B: Nei, det har ho ikkje.</div></div>",D:"WORD ORDER & SYNTAX",X:"<div class=\"center\"><div class=\"left\"><p>\"Short answers\" mirroring their question and starting with <span class=\"italic\">\xe5 v\xe6re</span> or <span class=\"italic\">\xe5 ha</span> will usually put the object <span class=\"italic\">det</span> at the beginning, followed by the (first) verb and then the subject.</p>Also, note the use of <span class=\"italic\">ho</span>, a dialectal form of <span class=\"italic\">hun</span>.</div></div>",A:"E"},{DECK_ID:"B12",ID:"B12004",N:"<div class=\"center\"><p>Compare the Norwegian equivalent of:</p>Arne normally uses only Visa<br>Normally, Arne uses only Visa</div>",E:"<div class=\"center\"><p><span class=\"red\">Arne</span> <span class=\"teal\">bruker</span> vanligvis bare Visa</p>Vanligvis <span class=\"teal\">bruker</span> <span class=\"red\">Arne</span> bare Visa</div>",D:"WORD ORDER & SYNTAX",X:"<div class=\"center\"><div class=\"left\"><p>In Norwegian, when an adverb or prepositional expression is put first in the sentence, subject and verb get swapped (i.e. V2 rule).</p>See how <span class=\"italic\">Arne bruker</span> becomes <span class=\"italic\">bruker Arne</span> in the second sentence. </div></div>",A:"E"},{DECK_ID:"B12",ID:"B12005",N:"<div class=\"center\"><p>Compare the Norwegian equivalent of:</p>I want to go out even though it rains<br>Even though it rains, I want to go out</div>",E:"<div class=\"center\"><p><span class=\"red\">Jeg</span> <span class=\"teal\">vil</span> <span class=dodgerBlue>g\xe5</span> ut selv om det regner</p>Selv om det regner, <span class=\"teal\">vil</span> <span class=\"red\">jeg</span> <span class=dodgerBlue>g\xe5</span> ut</div>",D:"WORD ORDER & SYNTAX",X:"<div class=\"center\"><div class=\"left\"><p>If a subordinate clause is placed before the main clause, then the subordinate works as a prepositional expression for the main clause, so subject and verb get swapped.</p>Remember that the subordinate clause is \"the bit that doesn't make sense alone\". It is always followed by a comma or a full stop.</div></div>",A:"E"},{DECK_ID:"B12",ID:"B12006",N:"<div class=\"center\"><p>Compare the Norwegian equivalent of:</p>Bodil gave him that<br>Bodil gave that to Ove</div>",E:"<div class=\"center\"><p>Bodil ga <span class=royalRed>ham</span> <span class=burntOrange>den</span></p>Bodil ga <span class=burntOrange>den</span> <span class=royalRed>til Ove</span></div>",D:"WORD ORDER & SYNTAX",X:"<div class=\"center\"><div class=\"left\"><p>Like in English, if the indirect object of the sentence (i.e. the answer to the \"to what?/to whom?\" question) is a pronoun, it tends to go first.</p>If a preposition such as <span class=\"italic\">til</span> is used for the indirect object, then it will go after the direct object.</div></div>",A:"E"},{DECK_ID:"B12",ID:"B12007",N:"<div class=\"center\"><p>Compare the Norwegian equivalent of:</p>It doesn't rain a lot in Bergen<br>In Bergen, it doesn't rain a lot</div>",E:"<div class=\"center\"><p><span class=\"red\">Det</span> <span class=\"teal\">regner</span> <span class=blueViolet>ikke</span> mye i Bergen</p>I Bergen <span class=\"teal\">regner</span> <span class=\"red\">det</span> <span class=blueViolet>ikke</span> mye</div>",D:"WORD ORDER & SYNTAX",X:"<div class=\"center\"><div class=\"left\"><p>In Norwegian, when an adverb or prepositional expression is put first in a <b class=\"bold\">negative</b> sentence, subject and verb get swapped and <span class=\"italic\">ikke</span> goes after the subject.</p>See how <span class=\"italic\">det regner ikke mye</span> becomes <span class=\"italic\">regner det ikke mye</span> in the second sentence. </div></div>",A:"E"},{DECK_ID:"B12",ID:"B12008",N:"<div class=\"center\"><p>Compare the Norwegian equivalent of:</p>Unluckily I'm not home right now<br>Unluckily, Oda is not home right now</div>",E:"<div class=\"center\"><p>Dessverre er <span class=\"red\">jeg</span> <span class=blueViolet>ikkje</span><br> hjemme akkurat n\xe5</p>Dessverre er <span class=blueViolet>ikkje</span> <span class=\"red\">Oda</span><br> hjemme akkurat n\xe5</div>",D:"WORD ORDER & SYNTAX",X:"<div class=\"center\"><div class=\"left\">When subject and verb are swapped for the reasons we have seen before and the sentence is negative, <span class=\"italic\">ikke</span> will mostly go after the subject if this is a pronoun.<br>However, it will go before the subject if the subject is a noun (e.g. a teacher, a cat, Oda).</div></div>",A:"E"},{DECK_ID:"B12",ID:"B12009",N:"<div class=\"center\"><p>Translate, paying attention <br>to word order:</p>I don't want to go out,<br>even though it doesn't rain</div>",E:"<div class=\"center\">Jeg <span class=\"teal\">vil</span> <span class=blueViolet>ikkje</span> g\xe5 ut,<br>selv om det <span class=blueViolet>ikkje</span> <span class=\"teal\">regner</span></div>",D:"WORD ORDER & SYNTAX",X:"<div class=\"center\"><div class=\"left\"><p>The first part (i.e. the main clause) works normally.</p>However, the second is a subordinate therefore <span class=\"italic\">ikke</span> \"jumps ahead\" and goes after the subject and before the verb.</div></div>",A:"E"},{DECK_ID:"B12",ID:"B12010",N:"<div class=\"center\"><p>Translate, paying attention <br>to word order:</p>Even though it doesn't rain,<br>I don't want to go out</div>",E:"<div class=\"center\">Selv om <span class=\"red\">det</span> <span class=blueViolet>ikke</span> regner,<br>vil <span class=\"red\">jeg</span> <span class=blueViolet>ikke</span> g\xe5 ut.</div>",D:"WORD ORDER & SYNTAX",X:"<div class=\"center\"><div class=\"left\"><p>If the subordinate is placed before the main clause, then in both clauses <span class=\"italic\">ikke</span> \"jumps ahead\" and goes after the subject.</p>Moreover, subject and verb are swapped in the main clause (which comes second in this example).</div></div>",A:"E"},{DECK_ID:"B12",ID:"B12011",N:"<div class=\"center\"><p>Compare the Norwegian equivalent of:</p>I was not at work yesterday<br>Yesterday, I was not at work</div>",E:"<div class=\"center\"><p><span class=\"red\">Jeg</span> <span class=\"teal\">var</span> <span class=blueViolet>ikke</span> p\xe5 jobb i g\xe5r</p>I g\xe5r <span class=\"teal\">var</span> <span class=\"red\">jeg</span> <span class=blueViolet>ikke</span> p\xe5 jobb</div>",D:"WORD ORDER & SYNTAX",X:"<div class=\"center\"><div class=\"left\">The first sentence works like in English.<br>In the second one, because <span class=\"italic\">i g\xe5r</span> (i.e. an adverb or a time/prepositional expression) is put at the beginning, then the verb comes before the subject and <span class=\"italic\">ikke</span> goes after the subject pronoun.</div></div>",A:"E"},{DECK_ID:"B12",ID:"B12012",N:"<div class=\"center\"><p>Translate this exchange to Norwegian:</p><div class=\"left\">A: Is it cold outside?<br>B: Yes, it is.</div></div>",E:"<div class=\"center\"><div class=\"left\">A: Er det kaldt ute?<br>B: Ja, det er det.</div></div>",D:"WORD ORDER & SYNTAX",X:"<div class=\"center\"><div class=\"left\">\"Short answers\" to questions whose subject is <span class=\"italic\">den/det</span> usually put the object <span class=\"italic\">den/det</span> at the beginning, followed by the (first) verb and then the subject.</div></div>",A:"E"},{DECK_ID:"B12",ID:"B12013",N:"<div class=\"center\"><p>Translate, paying attention <br>to word order:</p>\xd8yvind doesn't see her</div>",E:"<div class=\"center\">\xd8yvind ser henne ikke</div>",D:"WORD ORDER & SYNTAX",X:"<div class=\"center\"><div class=\"left\"><p>In a negative sentence with pronouns being objects of a single verb, <span class=\"italic\">ikke</span> follows the object pronoun.</p>The sentence <span class=\"italic\">\xd8yvind ser ikke henne</span> would mean that he sees others, but not the \"her\" that was being implied.</div></div>",A:"E"},{DECK_ID:"B12",ID:"B12014",N:"<div class=\"center\"><p>Compare the Norwegian equivalent of:</p>I didn't send her that<br>I haven't sent her that</div>",E:"<div class=\"center\"><p>Jeg sendte <span class=burntOrange>henne</span> <span class=royalRed>den</span> <span class=blueViolet>ikke</span></p>Jeg har <span class=blueViolet>ikke</span> sendt <span class=burntOrange>henne</span> <span class=royalRed>den</span></div>",D:"WORD ORDER & SYNTAX",X:"<div class=\"center\"><div class=\"left\"><p>In the first, <span class=\"italic\">ikke</span> goes after the last pronoun (which is the direct object) because the verb has no auxiliaries.</p>In the second sentence, the presence of a verb with an auxiliary (i.e. <span class=\"italic\">har</span>) overrides the previous rule and <span class=\"italic\">ikke</span> is after the auxiliary.</div></div>",A:"E"},{DECK_ID:"B12",ID:"B12015",N:"<div class=\"center\"><p>Translate, paying attention <br>to word order:</p>Is the girl called Solveig?<br>Does she speak Norwegian?</div>",E:"<div class=\"center\">Heter jenta Solveig?<br>Snakker hun norsk?</div>",D:"WORD ORDER & SYNTAX",X:"<div class=\"center\"><div class=\"left\">These are two standard questions, so the subject follows the only verb (or the modal/auxiliary verb if there is one).</div></div>",A:"E"},{DECK_ID:"B12",ID:"B12016",N:"<div class=\"center\"><p>Compare the Norwegian equivalent of:</p>I didn't give you that<br>I didn't give you a hug</div>",E:"<div class=\"center\"><p>Eg gav <span class=burntOrange>deg</span> <span class=royalRed>den</span> <span class=blueViolet>ikkje</span></p>Eg gav <span class=burntOrange>deg</span> <span class=blueViolet>ikkje</span> <span class=royalRed>en klem</span></div>",D:"WORD ORDER & SYNTAX",X:"<div class=\"center\"><div class=\"left\"><p>In the first, <span class=\"italic\">ikke</span> goes after the last pronoun (which is the direct object) because the verb has no auxiliaries.</p><p>The second would be the same, but because the direct object is not a pronoun, <span class=\"italic\">ikke</span> goes before it (and after <span class=\"italic\">deg</span>, the indirect pronoun).</p>Also, mind the dialectal forms: <span class=\"italic\">eg</span> and <span class=\"italic\">ikkje</span></div></div>",A:"E"},{DECK_ID:"B12",ID:"B12017",N:"<div class=\"center\"><p>Translate, paying attention <br>to word order:</p>Have you sent the e-mail to your colleague?</div>",E:"<div class=\"center\">Har du sendt e-posten til kollegaen din?</div>",D:"WORD ORDER & SYNTAX",X:"<div class=\"center\"><div class=\"left\"><p>This question is standard too but it's worth noting that if direct and indirect objects are not pronouns, the tendency (especially orally) is to use a preposition and to put the direct first and then the indirect one.</p>However, this is not a strict rule.</div></div>",A:"E"},{DECK_ID:"B12",ID:"B12018",N:"<div class=\"center\"><p>Translate, paying attention <br>to word order:</p>Will you prepare the food while I take a shower?</div>",E:"<div class=\"center\">Kommer du til \xe5 lage mat mens jeg tar en dusj?</div>",D:"WORD ORDER & SYNTAX",X:"<div class=\"center\"><div class=\"left\">Having the subordinate before the main clause in a question is not something that written language would allow.<br>Therefore, the subordinate goes at the end and the whole question remains quite straightforward.</div></div>",A:"E"},{DECK_ID:"B12",ID:"B12019",N:"<div class=\"center\"><p>Translate this exchange to Norwegian:</p><div class=\"left\">A: Do you work here?<br>B: No, I don't.</div></div>",E:"<div class=\"center\"><div class=\"left\">A: Jobber du her?<br>B: Nei, det gj\xf8r jeg ikkje.</div></div>",D:"WORD ORDER & SYNTAX",X:"<div class=\"center\"><div class=\"left\">\"Short answers\" in which you want to use <span class=\"italic\">\xe5 gj\xf8re</span> to indicate the question's verb usually put the object <span class=\"italic\">det</span> at the beginning, followed by the (first) verb and then the subject.<br>This applies also to auxiliaries such as <span class=\"italic\">skal, m\xe5, b\xf8r, kan</span> etc.</div></div>",A:"E"},{DECK_ID:"B12",ID:"B12020",N:"<div class=\"center\"><p>Translate, paying attention <br>to word order:</p>Isn't the girl called Solveig?<br>Doesn't she speak Norwegian?</div>",E:"<div class=\"center\">Heter <span class=blueViolet>ikke</span> <span class=\"red\">jenta</span> Solveig?<br>Snakker <span class=\"red\">hun</span> <span class=blueViolet>ikke</span> norsk?</div>",D:"WORD ORDER & SYNTAX",X:"<div class=\"center\"><div class=\"left\">In negative questions, when there is a single verb and the subject is <b class=\"bold\">not</b> a pronoun (e.g. <span class=\"italic\">jenta</span>), <span class=\"italic\">ikke</span> comes before the subject (first sentence in the example).<br>If the subject is a pronoun, <span class=\"italic\">ikke</span> comes after.</div></div>",A:"E"},{DECK_ID:"B12",ID:"B12021",N:"<div class=\"center\"><p>Translate, paying attention <br>to word order:</p>Can we not train outside tomorrow?</div>",E:"<div class=\"center\">Kan vi ikke trene ute i morgen?</div>",D:"WORD ORDER & SYNTAX",X:"<div class=\"center\"><div class=\"left\">This is a regular negative question, with <span class=\"italic\">ikke</span> following the subject, which is a pronoun.</div></div>",A:"E"},{DECK_ID:"B12",ID:"B12022",N:"<div class=\"center\"><p>Translate, paying attention <br>to word order:</p>Didn't Kjetil go to Troms\xf8 yesterday?</div>",E:"<div class=\"center\">Dro ikke Kjetil til Troms\xf8 i g\xe5r?</div>",D:"WORD ORDER & SYNTAX",X:"<div class=\"center\"><div class=\"left\">In negative questions, if there is a single verb and the subject (i.e. Kjetil) is not a pronoun, the <span class=\"italic\">ikke</span> will jump in front of the subject.</div></div>",A:"E"},{DECK_ID:"B12",ID:"B12023",N:"<div class=\"center\"><p>Translate, paying attention <br>to word order:</p>Is Jan not happy when Mia doesn't come for a visit?</div>",E:"<div class=\"center\">Er ikkje Jan lykkelig n\xe5r ikkje Mia kommer p\xe5 bes\xf8k?</div>",D:"WORD ORDER & SYNTAX",X:"<div class=\"center\"><div class=\"left\"><p>In negative questions, if there is a single verb and the subject (i.e. Jan, Mia) is not a pronoun, the <span class=\"italic\">ikke</span> will jump in front of the subject.</p>Also, written language will tend to require the subordinate to go after the main clause in questions.</div></div>",A:"E"},{DECK_ID:"B12",ID:"B12024",N:"<div class=\"center\"><p>Translate, paying attention <br>to word order:</p>Doesn't it rain a lot in Bergen?</div>",E:"<div class=\"center\">Regner det ikke mye i Bergen?</div>",D:"WORD ORDER & SYNTAX",X:"<div class=\"center\"><div class=\"left\">In negative questions, if the subject is a pronoun, <span class=\"italic\">ikke</span> will go after it.</div></div>",A:"E"},{DECK_ID:"B12",ID:"B12025",N:"<div class=\"center\"><p>Translate, paying attention <br>to word order:</p>Will you not miss me when I'm not here?</div>",E:"<div class=\"center\">Kommer du ikke til \xe5 savne meg n\xe5r jeg ikke er her?</div>",D:"WORD ORDER & SYNTAX",X:"<div class=\"center\"><div class=\"left\"><p>In negative questions, if there is a single verb and the subject (i.e. du, jeg) is a pronoun, the <span class=\"italic\">ikke</span> will go after the subject.</p>Also, written language will tend to require the subordinate to go after the main clause in questions.</div></div>",A:"E"},{DECK_ID:"B12",ID:"B12026",N:"<div class=\"center\"><p>Translate, paying attention <br>to word order:</p>Did you not phone her yesterday?</div>",E:"<div class=\"center\">Ringte du henne ikke i g\xe5r?</div>",D:"WORD ORDER & SYNTAX",X:"<div class=\"center\"><div class=\"left\">Another case of negative question in which both pronouns (i.e. subject and object) are in front of the <span class=\"italic\">ikke</span>.</div></div>",A:"E"},{DECK_ID:"B12",ID:"B12027",N:"<div class=\"center\"><p>Translate, paying attention <br>to word order:</p>Didn't Bodil give him that?</div>",E:"<div class=\"center\">Ga ikke Bodil ham den?</div>",D:"WORD ORDER & SYNTAX",X:"<div class=\"center\"><div class=\"left\">In this negative question, the \"noun subject\" (i.e. Bodil) rule has priority over the rule that would want pronoun objects to be before the <span class=\"italic\">ikke</span>.<br>Because of this, <span class=\"italic\">ikke</span> goes before \"Bodil\".</div></div>",A:"E"},{DECK_ID:"B12",ID:"B12028",N:"<div class=\"center\"><p>Translate this exchange to Norwegian:</p><div class=\"left\">A: See you tomorrow!<br>B: Yes, we will!</div></div>",E:"<div class=\"center\"><div class=\"left\">A: Vi ses i morgen!<br>B: Ja, det gj\xf8r vi!</div></div>",D:"WORD ORDER & SYNTAX",X:"<div class=\"center\"><div class=\"left\">\"Short answers\" in which you want to use <span class=\"italic\">\xe5 gj\xf8re</span> to indicate the question's verb usually put the object <span class=\"italic\">det</span> at the beginning, followed by the (first) verb and then the subject.<br>This applies also to auxiliaries such as <span class=\"italic\">skal, m\xe5, b\xf8r, kan</span> etc.</div></div>",A:"E"},{DECK_ID:"B12",ID:"B12029",N:"<div class=\"center\"><p>Translate, paying attention <br>to word order:</p>Tomorrow we can train outside</div>",E:"<div class=\"center\">I morgen kan vi trene ute</div>",D:"WORD ORDER & SYNTAX",X:"<div class=\"center\"><div class=\"left\">Starting the sentence with an adverb or prepositional expression such as <span class=\"italic\">i morgen</span> requires subject and (auxiliary/modal) verb to swap in position.</div></div>",A:"E"},{DECK_ID:"B12",ID:"B12030",N:"<div class=\"center\"><p>Translate, paying attention <br>to word order:</p>They didn't tell that to Erik</div>",E:"<div class=\"center\">De fortalte det ikke til Erik</div>",D:"WORD ORDER & SYNTAX",X:"<div class=\"center\"><div class=\"left\"><p>In this negative sentence, <span class=\"italic\">ikke</span> normally goes after the last pronoun (i.e. <span class=\"italic\">det</span>).</p>Note that <span class=\"italic\">de fortalte ikke det til Erik</span> is also possible and means \"they haven't told <b class=\"bold\">that</b> to Erik, (but they have told him another thing)\".</div></div>",A:"E"},{DECK_ID:"B12",ID:"B12031",N:"<div class=\"center\"><p>Compare the Norwegian equivalent of:</p>Yesterday, he wasn't at work<br>Yesterday, Erik wasn't at work</div>",E:"<div class=\"center\"><p>I g\xe5r var <span class=\"red\">han</span> <span class=blueViolet>ikke</span> p\xe5 jobb</p>I g\xe5r var <span class=blueViolet>ikke</span> <span class=\"red\">Erik</span> p\xe5 jobb</div>",D:"WORD ORDER & SYNTAX",X:"<div class=\"center\"><div class=\"left\"><p>Both start with a prepositional expression.</p><p>In the first, the subject is <b class=\"bold\">a pronoun</b>, so <span class=\"italic\">ikke</span> goes <b class=\"bold\">after</b> the subject.</p>In the second, the subject is <b class=\"bold\">not a pronoun</b>, so <span class=\"italic\">ikke</span> goes <b class=\"bold\">before</b> the subject.</div></div>",A:"E"},{DECK_ID:"B12",ID:"B12032",N:"<div class=\"center\"><p>Translate, paying attention <br>to word order:</p>Bodil didn't give him that</div>",E:"<div class=\"center\">Bodil ga ham den ikkje</div>",D:"WORD ORDER & SYNTAX",X:"<div class=\"center\"><div class=\"left\"><p>In this negative sentence, indirect (i.e. <span class=\"italic\">ham</span>) and direct (i.e. <span class=\"italic\">den</span>) objects are pronouns, therefore they come before the <span class=\"italic\">ikke</span>.</p>Note that <span class=\"italic\">Bodil ga ikke ham den</span> is also possible but means \"Bodil didn't give <b class=\"bold\">him</b> that, (but she gave it to somebody else)\".</div></div>",A:"E"},{DECK_ID:"B12",ID:"B12033",N:"<div class=\"center\"><p>Translate, paying attention <br>to word order:</p>You don't owe her any favours</div>",E:"<div class=\"center\">Du skylder henne ikke noen tjenester</div>",D:"WORD ORDER & SYNTAX",X:"<div class=\"center\"><div class=\"left\"><p>In this negative sentence, <span class=\"italic\">ikke</span> normally goes after the last pronoun (i.e. <span class=\"italic\">henne</span>).</p>Different positions of <span class=\"italic\">ikke</span> are possible, but would carry more specific meanings.</div></div>",A:"E"},{DECK_ID:"B12",ID:"B12034",N:"<div class=\"center\"><p>Translate, paying attention <br>to word order:</p>Yesterday, Kjetil went to Troms\xf8</div>",E:"<div class=\"center\">I g\xe5r dro Kjetil til Troms\xf8</div>",D:"WORD ORDER & SYNTAX",X:"<div class=\"center\"><div class=\"left\">Starting the sentence with an adverb or prepositional expression such as <span class=\"italic\">i g\xe5r</span> requires subject and (auxiliary/modal) verb to swap in position.</div></div>",A:"E"},{DECK_ID:"B12",ID:"B12035",N:"<div class=\"center\"><p>Translate, paying attention <br>to word order:</p>Didn't they tell that to Erik?</div>",E:"<div class=\"center\">Fortalte de det ikke til Erik?</div>",D:"WORD ORDER & SYNTAX",X:"<div class=\"center\"><div class=\"left\"><p>In this negative question, <span class=\"italic\">ikke</span> normally goes after the last pronoun (i.e. <span class=\"italic\">det</span>).</p>Different positions of <span class=\"italic\">ikke</span> are possible, but would carry more specific meanings.</div></div>",A:"E"},{DECK_ID:"B12",ID:"B12036",N:"<div class=\"center\"><p>Compare the Norwegian equivalent of:</p>We can change the plans if it rains<br>If it rains, we can change the plans</div>",E:"<div class=\"center\"><p><span class=\"red\">Vi</span> <span class=\"teal\">kan</span> <span class=dodgerBlue>endre</span> planene hvis det regner</p>Hvis det regner, <span class=\"teal\">kan</span> <span class=\"red\">vi</span> <span class=dodgerBlue>endre</span> planene</div>",D:"WORD ORDER & SYNTAX",X:"<div class=\"center\"><div class=\"left\">The first sentence works like in English.<br>In the second one, because <span class=\"italic\">hvis det regner</span> (i.e. the subordinate clause, the bit that \"doesn't make sense alone\") is put at the beginning, then the verb comes before the subject in the main clause. It is always followed by a comma or a full stop.</div></div>",A:"E"},{DECK_ID:"B12",ID:"B12037",N:"<div class=\"center\"><p>Translate, paying attention <br>to word order:</p>Doesn't Arne normally use only Visa?</div>",E:"<div class=\"center\">Bruker ikke Arne vanligvis bare Visa?</div>",D:"WORD ORDER & SYNTAX",X:"<div class=\"center\"><div class=\"left\">In negative questions, if there is a single verb and the subject (i.e. Arne) is not a pronoun, the <span class=\"italic\">ikke</span> will jump in front of the subject.</div></div>",A:"E"},{DECK_ID:"B12",ID:"B12038",N:"<div class=\"center\"><p>Translate, paying attention <br>to word order:</p>When Mia comes for a visit, Jan is happy</div>",E:"<div class=\"center\">N\xe5r Mia kommer p\xe5 bes\xf8k, er Jan lykkelig</div>",D:"WORD ORDER & SYNTAX",X:"<div class=\"center\"><div class=\"left\">In this example, the subordinate clause is put first, therefore the subject and the verb in the ensuing main clause are swapped.</div></div>",A:"E"},{DECK_ID:"B12",ID:"B12039",N:"<div class=\"center\"><p>Translate, paying attention <br>to word order:</p>Don't you owe her a favour?</div>",E:"<div class=\"center\">Skylder du henne ikke en tjeneste?</div>",D:"WORD ORDER & SYNTAX",X:"<div class=\"center\"><div class=\"left\"><p>In this negative question, <span class=\"italic\">ikke</span> normally goes after the last pronoun (i.e. <span class=\"italic\">henne</span>).</p>Different positions of <span class=\"italic\">ikke</span> are possible, but would carry more specific meanings.</div></div>",A:"E"},{DECK_ID:"B12",ID:"B12040",N:"<div class=\"center\"><p>Translate, paying attention <br>to word order:</p>Yesterday, Kjetil didn't go to Mo i Rana</div>",E:"<div class=\"center\">I g\xe5r dro ikke Kjetil til Mo i Rana</div>",D:"WORD ORDER & SYNTAX",X:"<div class=\"center\"><div class=\"left\"><p>An initial adverb or prepositional expression such as <span class=\"italic\">i g\xe5r</span> requires subject and (auxiliary/modal) verb to swap in position.</p>Additionally, the negative nature of the sentence and the fact that the subject (i.e. Kjetil) is not a pronoun make <span class=\"italic\">ikke</span> \"jump ahead\", before the subject.</div></div>",A:"E"},{DECK_ID:"B12",ID:"B12041",N:"<div class=\"center\"><p>Translate, paying attention <br>to word order:</p>Normally Arne doesn't use only Visa</div>",E:"<div class=\"center\">Vanligvis bruker ikkje Arne bare Visa</div>",D:"WORD ORDER & SYNTAX",X:"<div class=\"center\"><div class=\"left\"><p>An initial adverb such as <span class=\"italic\">vanligvis</span> requires subject and (auxiliary/modal) verb to swap in position.</p>Additionally, the negative nature of the sentence, the single verb and the fact that the subject (i.e. Arne) is not a pronoun make <span class=\"italic\">ikke</span> \"jump ahead\", before the subject.</div></div>",A:"E"},{DECK_ID:"B12",ID:"B12042",N:"<div class=\"center\"><p>Translate, paying attention <br>to word order:</p>When Mia doesn't come for a visit, Jan is not happy</div>",E:"<div class=\"center\">N\xe5r ikke Mia kommer p\xe5 bes\xf8k, er ikke Jan lykkelig</div>",D:"WORD ORDER & SYNTAX",X:"<div class=\"center\"><div class=\"left\"><p>Putting the subordinate clause first requires subject and (auxiliary/modal) verb to swap in position.</p>Additionally, the negative nature of the sentence and the fact that the subjects (i.e. Mia, Jan) are not a pronouns make <span class=\"italic\">ikke</span> \"jump ahead\", before each subject.</div></div>",A:"E"},{DECK_ID:"B12",ID:"B12043",N:"<div class=\"center\"><p>Compare the Norwegian of:</p>The concert was cancelled because the singer was sick<br>Because the singer was sick, the concert was cancelled</div>",E:"<div class=\"center\"><p><span class=\"red\">Konserten</span> <span class=\"teal\">ble</span> <span class=dodgerBlue>avlyst</span> fordi sangeren var syk</p>Fordi sangeren var syk, <span class=\"teal\">ble</span> <span class=\"red\">konserten</span> <span class=dodgerBlue>avlyst</span></div>",D:"WORD ORDER & SYNTAX",X:"<div class=\"center\"><div class=\"left\">The first sentence works like in English.<br>In the second one, because <span class=\"italic\">fordi sangeren var syk</span> (i.e. the subordinate clause, the bit that \"doesn't make sense alone\") is put at the beginning, then the verb comes before the subject in the main clause. It is always followed by a comma or a full stop.</div></div>",A:"E"},{DECK_ID:"B12",ID:"B12044",N:"<div class=\"center\"><p>Translate, paying attention <br>to word order:</p>While you take a shower, I'm going to prepare the food</div>",E:"<div class=\"center\">Mens du tar en dusj, kommer jeg til \xe5 lage mat</div>",D:"WORD ORDER & SYNTAX",X:"<div class=\"center\"><div class=\"left\">In an affirmative sentence with a subordinate clause placed before the main clause, the subject and verb get swapped in the main clause.<br>Effectively, the subordinate clause worked as a prepositional expression for the main clause.</div></div>",A:"E"},{DECK_ID:"B12",ID:"B12045",N:"<div class=\"center\"><p>Compare the Norwegian equivalent of:</p>I didn't ask you to come<br>I haven't asked you to come</div>",E:"<div class=\"center\"><p>Jeg <span class=\"teal\">ba</span> <span class=burntOrange>deg</span> <span class=blueViolet>ikke</span> om \xe5 komme</p>Jeg <span class=\"teal\">har</span> <span class=blueViolet>ikke</span> <span class=dodgerBlue>bedt</span> <span class=burntOrange>deg</span> om \xe5 komme</div>",D:"WORD ORDER & SYNTAX",X:"<div class=\"center\"><div class=\"left\"><p>In the first, <span class=\"italic\">ikke</span> goes after the last pronoun (which is the object) because the verb is \"single\".</p>In the second, the presence of a verb with an auxiliary (i.e. <span class=\"italic\">har</span>) overrides the previous rule and <span class=\"italic\">ikke</span> is after the auxiliary.</div></div>",A:"E"},{DECK_ID:"B12",ID:"B12046",N:"<div class=\"center\"><p>Translate, paying attention <br>to word order:</p>I will not give her the money</div>",E:"<div class=\"center\">Jeg skal ikke gi henne pengene</div>",D:"WORD ORDER & SYNTAX",X:"<div class=\"center\"><div class=\"left\">The presence of a modal+verb requires the <span class=\"italic\">ikke</span> to come after the modal verb, overriding what would be the expectation of <span class=\"italic\">ikke</span> coming after the last pronoun in the sentence (which would happen in case of a \"single\" verb).</div></div>",A:"E"},{DECK_ID:"B12",ID:"B12047",N:"<div class=\"center\"><p>Translate, paying attention <br>to word order:</p>His mum didn't give him the packed lunch</div>",E:"<div class=\"center\">Mora hans ga ham ikke matpakka</div>",D:"WORD ORDER & SYNTAX",X:"<div class=\"center\"><div class=\"left\"><p>In this negative sentence, <span class=\"italic\">ikke</span> normally goes after the last pronoun (i.e. <span class=\"italic\">ham</span>).</p>Different positions of <span class=\"italic\">ikke</span> are possible, but would carry more specific meanings.</div></div>",A:"E"},{DECK_ID:"B12",ID:"B12048",N:"<div class=\"center\"><p>Compare the Norwegian equivalent of:</p>I didn't tell her that<br>I haven't told her that</div>",E:"<div class=\"center\"><p>Jeg fortalte <span class=burntOrange>henne</span> <span class=royalRed>det</span> <span class=blueViolet>ikke</span></p>Jeg har <span class=blueViolet>ikke</span> fortalt <span class=burntOrange>henne</span> <span class=royalRed>det</span></div>",D:"WORD ORDER & SYNTAX",X:"<div class=\"center\"><div class=\"left\">Here you can see how \"single verbs\" allow the <span class=\"italic\">ikke</span> to go later in the sentence, whereas \"non-single verbs\" (e.g. <span class=\"italic\">har fortalt, skal gi, kommer til \xe5</span> etc.) require the <span class=\"italic\">ikke</span> to be straight after the first verb.</div></div>",A:"E"},{DECK_ID:"B12",ID:"B12049",N:"<div class=\"center\"><p>Compare the Norwegian equivalent of:</p>We can change plans if it doesn't rain<br>If it doesn't rain, we can change plans</div>",E:"<div class=\"center\"><p><span class=\"red\">Vi</span> <span class=\"teal\">kan</span> <span class=dodgerBlue>endre</span> plana hvis det ikkje regner</p>Hvis det ikkje regner, <span class=\"teal\">kan</span> <span class=\"red\">vi</span> <span class=dodgerBlue>endre</span> plana</div>",D:"WORD ORDER & SYNTAX",X:"<div class=\"center\"><div class=\"left\"><p>In a subordinate clause such as <span class=\"italic\">hvis det regner</span>, <span class=\"italic\">ikke</span> is placed between the subject and the verb, rather than following the verb.</p>Moreover, in the second case, because the subordinate is first, the main clause has subject and verb swapped.</div></div>",A:"E"},{DECK_ID:"B12",ID:"B12050",N:"<div class=\"center\"><p>Translate, paying attention <br>to word order:</p>I'm leaving because I don't want to meet him</div>",E:"<div class=\"center\">Jeg drar fordi jeg ikke vil treffe ham</div>",D:"WORD ORDER & SYNTAX",X:"<div class=\"center\"><div class=\"left\"><p>The first sentence (i.e. the main clause) works normally.</p>However, the second is a subordinate, therefore <span class=\"italic\">ikke</span> \"jumps ahead\" and goes after the subject and before the verbs.</div></div>",A:"E"},{DECK_ID:"B13",ID:"B13001",N:"<div class=\"center\">\xe5 bli n\xf8dt til<br>blir<br>ble<br>har blitt</div>",E:"<div class=\"center\">to have (to), to be required to</div>",D:"EXPRESSIONS",X:"<div class=\"center\"><div class=\"left\"><p>This is a common construction used to express a necessity.</p><span class=\"italic\">Vi ble n\xf8dt til \xe5 stenge butikken</span><br>We had to close the shop</div></div>",A:"N"},{DECK_ID:"B13",ID:"B13002",N:"<div class=\"center\">en gang til</div>",E:"<div class=\"center\">once more, yet another time</div>",D:"EXPRESSIONS",X:"",A:"N"},{DECK_ID:"B13",ID:"B13003",N:"<div class=\"center\">\xe5 ha r\xe5d til</div>",E:"<div class=\"center\">to afford, to be able to afford</div>",D:"EXPRESSIONS",X:"<div class=\"center\"><div class=\"left\">Used only for things of material value, not in a figurative sense.</div></div>",A:"N"},{DECK_ID:"B13",ID:"B13004",N:"<div class=\"center\">\xe5 bli med</div>",E:"<div class=\"center\">to join (friends, company)</div>",D:"EXPRESSIONS",X:"<div class=\"center\">Vi skal p\xe5 kino, vil du bli med?</div>",A:"N"},{DECK_ID:"B13",ID:"B13005",N:"<div class=\"center\">etter min mening</div>",E:"<div class=\"center\">in my opinion</div>",D:"EXPRESSIONS",X:"",A:"N"},{DECK_ID:"B13",ID:"B13006",N:"<div class=\"center\">faen!</div>",E:"<div class=\"center\">fuck!</div>",D:"EXCLAMATIONS",X:"<div class=\"center\"><div class=\"left\"><p>Anger, frustration</p><p>It is an invariable noun meaning \"(the) devil\".</p>It is a rather strong expression (stronger than \"damn\" in English), so it can't be used lightly in professional or formal situations.</div></div>",A:"N"},{DECK_ID:"B13",ID:"B13007",N:"<div class=\"center\">\xe5 glede seg til noe</div>",E:"<div class=\"center\">to look forward to something</div>",D:"EXPRESSIONS",X:"<div class=\"center\"><div class=\"left\"><p>This expression is more personal and entails emotions.</p>A more formal way of saying it is <span class=\"italic\">\xe5 se fram/frem til noe</span>.</div></div>",A:"N"},{DECK_ID:"B13",ID:"B13008",N:"<div class=\"center\">\xe5 v\xe6re i ferd med</div>",E:"<div class=\"center\"><p>to be about to</p>to be in the process of<br>(for short term things)</div>",D:"EXPRESSIONS",X:"<div class=\"center\"><div class=\"left\">Dette er i ferd med \xe5 bli et stort problem</div></div>",A:"N"},{DECK_ID:"B13",ID:"B13009",N:"<div class=\"center\">kr</div>",E:"<div class=\"center\">ei krone, krona, kroner, kronene</div>",D:"SHORTENINGS",X:"<div class=\"center\"><div class=\"left\">The sign for the Norwegian currency, often used in feminine.</div></div>",A:"N"},{DECK_ID:"B13",ID:"B13010",N:"<div class=\"center\">Takk skal du ha!</div>",E:"<div class=\"center\">Thanks (to you)!</div>",D:"EXPRESSIONS",X:"<div class=\"center\">Stronger than just <span class=\"italic\">takk</span></div>",A:"N"},{DECK_ID:"B13",ID:"B13011",N:"<div class=\"center\">\xe5 kjenne igjen</div>",E:"<div class=\"center\">to recognise</div>",D:"EXPRESSIONS",X:"<div class=\"center\"><div class=\"left\"><p>Kjenner du igjen denne norske skuespilleren?</p>Firmaet kjenner seg ikke igjen i kritikken</div></div>",A:"N"},{DECK_ID:"B13",ID:"B13012",N:"<div class=\"center\">sk\xe5l!</div>",E:"<div class=\"center\">cheers!</div>",D:"EXCLAMATIONS",X:"<div class=\"center\">Exclamation used for toasts</div>",A:"N"},{DECK_ID:"B13",ID:"B13013",N:"<div class=\"center\">\xe5 v\xe6re vant til</div>",E:"<div class=\"center\">to be used to</div>",D:"EXPRESSIONS",X:"",A:"N"},{DECK_ID:"B13",ID:"B13014",N:"<div class=\"center\">\xe5 hilse p\xe5 noen</div>",E:"<div class=\"center\">to say hello to</div>",D:"EXPRESSIONS",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Har du hilset p\xe5 den nye kollegaen?</span></p>Have you said hello to the new colleague?</div></div>",A:"N"},{DECK_ID:"B13",ID:"B13015",N:"<div class=\"center\">pga.</div>",E:"<div class=\"center\">p\xe5 grunn av</div>",D:"SHORTENINGS",X:"<div class=\"center\"><p>because of</p>(Literally: on grounds of)</div>",A:"N"},{DECK_ID:"B13",ID:"B13016",N:"<div class=\"center\">i hvert fall</div>",E:"<div class=\"center\">in any/every case, at least</div>",D:"EXPRESSIONS",X:"",A:"N"},{DECK_ID:"B13",ID:"B13017",N:"<div class=\"center\">mvh</div>",E:"<div class=\"center\">med vennlig hilsen</div>",D:"SHORTENINGS",X:"<div class=\"center\"><p>kind regards</p>(Literally: with a friendly salutation)</div>",A:"N"},{DECK_ID:"B13",ID:"B13018",N:"<div class=\"center\">rett og slett</div>",E:"<div class=\"center\">simply</div>",D:"EXPRESSIONS",X:"<div class=\"center\"><p><span class=\"italic\">Det er rett og slett uakseptabelt</span></p>It's simply unacceptable</div>",A:"N"},{DECK_ID:"B13",ID:"B13019",N:"<div class=\"center\">osv.</div>",E:"<div class=\"center\">og s\xe5 videre</div>",D:"SHORTENINGS",X:"<div class=\"center\"><p>etc, and so on</p>(Literally: and so further)</div>",A:"N"},{DECK_ID:"B13",ID:"B13020",N:"<div class=\"center\">Det er i orden</div>",E:"<div class=\"center\"><p>it's ok</p>it's fine</div>",D:"EXPRESSIONS",X:"",A:"N"},{DECK_ID:"B13",ID:"B13021",N:"<div class=\"center\">\xe5 ha rett</div>",E:"<div class=\"center\">to be right</div>",D:"EXPRESSIONS",X:"<div class=\"center\"><div class=\"left\">Norwegian uses the verb \"to have\" rather than \"to be\", just like some Latin languages do.</div></div>",A:"N"},{DECK_ID:"B13",ID:"B13022",N:"<div class=\"center\">Slapp av!</div>",E:"<div class=\"center\">Relax!</div>",D:"EXPRESSIONS",X:"",A:"N"},{DECK_ID:"B13",ID:"B13023",N:"<div class=\"center\">\xe5 ta feil (av)</div>",E:"<div class=\"center\">to be wrong (about)</div>",D:"EXPRESSIONS",X:"",A:"N"},{DECK_ID:"B13",ID:"B13024",N:"<div class=\"center\">Gratulerer!</div>",E:"<div class=\"center\">Congratulations!</div>",D:"EXPRESSIONS",X:"<div class=\"center\"><div class=\"left\"><p>An expression such as:</p><p><span class=\"italic\">Gratulerer med dagen!</span></p>is used for occasions such as birthdays or the National Day (May 17) and it's the present form of the verb <span class=\"italic\">\xe5 gratulere</span>.</div></div>",A:"N"},{DECK_ID:"B13",ID:"B13025",N:"<div class=\"center\">kl.</div>",E:"<div class=\"center\">klokken/klokka</div>",D:"SHORTENINGS",X:"<div class=\"center\"><div class=\"left\">Used before a number, to specify a time.</div></div>",A:"N"},{DECK_ID:"B13",ID:"B13026",N:"<div class=\"center\">nr.</div>",E:"<div class=\"center\">nummer</div>",D:"SHORTENINGS",X:"<div class=\"center\">Number</div>",A:"N"},{DECK_ID:"B13",ID:"B13027",N:"<div class=\"center\">\xe5 sette pris p\xe5 noe</div>",E:"<div class=\"center\">to value something,<br>to appreciate something</div>",D:"EXPRESSIONS",X:"",A:"N"},{DECK_ID:"B13",ID:"B13028",N:"<div class=\"center\">Det ordner seg!</div>",E:"<div class=\"center\">It's alright!<br>It's ok!</div>",D:"EXPRESSIONS",X:"<div class=\"center\"><div class=\"left\"><p>This expression is only used in the third person singular, with pronouns such as <span class=\"italic\">det</span> or <span class=\"italic\">alt</span>:</p><span class=\"italic\">Null stress, det ordner seg!</span><br>(No worries, it's going to be alright!)</div></div>",A:"N"},{DECK_ID:"B13",ID:"B13029",N:"<div class=\"center\">Skjerp deg!</div>",E:"<div class=\"center\">Sharpen up!<br>Get a grip!<br>Get your shit together!</div>",D:"EXPRESSIONS",X:"<div class=\"center\"><div class=\"left\">Typical Norwegian expression used to reproach somebody</div></div>",A:"N"},{DECK_ID:"B13",ID:"B13030",N:"<div class=\"center\">Herregud!</div>",E:"<div class=\"center\">Good Lord!</div>",D:"EXCLAMATIONS",X:"",A:"N"},{DECK_ID:"B13",ID:"B13031",N:"<div class=\"center\">t.o.m.</div>",E:"<div class=\"center\">til og med</div>",D:"SHORTENINGS",X:"<div class=\"center\"><div class=\"left\">When used with dates, it means \"up to and including\".</div></div>",A:"N"},{DECK_ID:"B13",ID:"B13032",N:"<div class=\"center\">f.o.m.</div>",E:"<div class=\"center\">fra og med</div>",D:"SHORTENINGS",X:"<div class=\"center\"><div class=\"left\">When used with dates, it means \"from and including\".</div></div>",A:"N"},{DECK_ID:"B13",ID:"B13033",N:"<div class=\"center\">av og til</div>",E:"<div class=\"center\">now and then, sometimes</div>",D:"EXPRESSIONS",X:"",A:"N"},{DECK_ID:"B13",ID:"B13034",N:"<div class=\"center\">i alle fall</div>",E:"<div class=\"center\">in all cases, at least</div>",D:"EXPRESSIONS",X:"",A:"N"},{DECK_ID:"B13",ID:"B13035",N:"<div class=\"center\">\xe5 ha det travelt</div>",E:"<div class=\"center\">to be busy, to be hectic</div>",D:"EXPRESSIONS",X:"",A:"N"},{DECK_ID:"B13",ID:"B13036",N:"<div class=\"center\">fy!</div>",E:"<div class=\"center\">uff/bad!</div>",D:"EXCLAMATIONS",X:"<div class=\"center\">Shock or disapproval</div>",A:"N"},{DECK_ID:"B13",ID:"B13037",N:"<div class=\"center\">\xe5 pante flasker og drikkebokser</div>",E:"<div class=\"center\">to get a refund for bottles and cans</div>",D:"EXPRESSIONS",X:"<div class=\"center\"><div class=\"left\">The verb <span class=\"italic\">\xe5 pante</span> is the action of returning empty containers to special machines in supermarkets to receive a cash voucher.<br>It is a policy to incentivise and organise recycling of PET bottles and aluminium cans.</div></div>",A:"N"},{DECK_ID:"B13",ID:"B13038",N:"<div class=\"center\">Godt \xe5 vite!</div>",E:"<div class=\"center\">Good to know!</div>",D:"EXPRESSIONS",X:"<div class=\"center\"><div class=\"left\">Not how the adjective referring to the verb is in <span class=\"italic\">intetkj\xf8nn</span></div></div>",A:"N"},{DECK_ID:"B13",ID:"B13039",N:"<div class=\"center\">ved hjelp av</div>",E:"<div class=\"center\">with the help of</div>",D:"EXPRESSIONS",X:"",A:"N"},{DECK_ID:"B13",ID:"B13040",N:"<div class=\"center\">til fots</div>",E:"<div class=\"center\">on foot, by walking</div>",D:"EXPRESSIONS",X:"",A:"N"},{DECK_ID:"B13",ID:"B13041",N:"<div class=\"center\">m/</div>",E:"<div class=\"center\">med</div>",D:"SHORTENINGS",X:"",A:"N"},{DECK_ID:"B13",ID:"B13042",N:"<div class=\"center\">for godt</div>",E:"<div class=\"center\">for good, permanently</div>",D:"EXPRESSIONS",X:"",A:"N"},{DECK_ID:"B13",ID:"B13043",N:"<div class=\"center\">bl.a</div>",E:"<div class=\"center\">blant annet</div>",D:"SHORTENINGS",X:"<div class=\"center\">among other things</div>",A:"N"},{DECK_ID:"B13",ID:"B13044",N:"<div class=\"center\">\xe5 melde seg p\xe5</div>",E:"<div class=\"center\">to sign up for</div>",D:"EXPRESSIONS",X:"",A:"N"},{DECK_ID:"B13",ID:"B13045",N:"<div class=\"center\">i l\xf8pet av</div>",E:"<div class=\"center\">during, in the course of</div>",D:"EXPRESSIONS",X:"",A:"N"},{DECK_ID:"B13",ID:"B13046",N:"<div class=\"center\">med en gang</div>",E:"<div class=\"center\">at once, straight away</div>",D:"EXPRESSIONS",X:"",A:"N"},{DECK_ID:"B13",ID:"B13047",N:"<div class=\"center\">s.u.</div>",E:"<div class=\"center\">svar utbes</div>",D:"SHORTENINGS",X:"<div class=\"center\"><p>please reply, RSVP</p>(Literally: answer requested)</div>",A:"N"},{DECK_ID:"B13",ID:"B13048",N:"<div class=\"center\">Kom igjen!</div>",E:"<div class=\"center\">Come on!</div>",D:"EXPRESSIONS",X:"<div class=\"center\"><div class=\"left\">Used to cheer on and motivate people, especially in competitions.</div></div>",A:"N"},{DECK_ID:"B13",ID:"B13049",N:"<div class=\"center\">\xe5 pusse tennene</div>",E:"<div class=\"center\">to brush (one's) teeth</div>",D:"EXPRESSIONS",X:"",A:"N"},{DECK_ID:"B13",ID:"B13050",N:"<div class=\"center\">\xe5 gi bort</div>",E:"<div class=\"center\">to give away for free</div>",D:"EXPRESSIONS",X:"<div class=\"center\"><div class=\"left\">In classified ads, the <span class=\"italic\">gis bort</span> section is for items the owner is willing to \"give away for free\" as long as the interested person comes and collects it.</div></div>",A:"N"},{DECK_ID:"B13",ID:"B13051",N:"<div class=\"center\">vha.</div>",E:"<div class=\"center\">ved hjelp av</div>",D:"SHORTENINGS",X:"<div class=\"center\">with the help of</div>",A:"N"},{DECK_ID:"B13",ID:"B13052",N:"<div class=\"center\">av g\xe5rde</div>",E:"<div class=\"center\">away, off</div>",D:"EXPRESSIONS",X:"<div class=\"center\">De stjal en bil og kj\xf8rte av g\xe5rde</div>",A:"N"},{DECK_ID:"B13",ID:"B13053",N:"<div class=\"center\">\xe5 legge merke til</div>",E:"<div class=\"center\">to notice, to take notice</div>",D:"EXPRESSIONS",X:"<div class=\"center\">Literally: \"to lay notice to\"</div>",A:"N"},{DECK_ID:"B13",ID:"B13054",N:"<div class=\"center\">\xe5 f\xe5 lov til</div>",E:"<div class=\"center\">to be allowed to, to receive permission to</div>",D:"EXPRESSIONS",X:"",A:"N"},{DECK_ID:"B13",ID:"B13055",N:"<div class=\"center\">\xe5 drite i noe</div>",E:"<div class=\"center\">to not give a shit about something</div>",D:"EXPRESSIONS",X:"",A:"N"},{DECK_ID:"B13",ID:"B13056",N:"<div class=\"center\">\xe5 ta vare p\xe5</div>",E:"<div class=\"center\">to take care of</div>",D:"EXPRESSIONS",X:"",A:"N"},{DECK_ID:"B13",ID:"B13057",N:"<div class=\"center\">\xe5 finne sted</div>",E:"<div class=\"center\">to take place, to happen</div>",D:"EXPRESSIONS",X:"",A:"N"},{DECK_ID:"B13",ID:"B13058",N:"<div class=\"center\">ti stille!</div>",E:"<div class=\"center\">keep quiet!</div>",D:"EXCLAMATIONS",X:"<div class=\"center\"><div class=\"left\"><p>Request for complete silence, stronger than <span class=\"italic\">v\xe6r stille</span>, but still acceptable.</p>It comes from the verb <span class=\"italic\">\xe5 tie</span>.</div></div>",A:"N"},{DECK_ID:"B13",ID:"B13059",N:"<div class=\"center\">\xe5 f\xe5 til<br>f\xe5r<br>fikk<br>har f\xe5tt</div>",E:"<div class=\"center\"><p>to get (to do)</p>to make (someone or something) do</div>",D:"EXPRESSIONS",X:"<div class=\"center\"><div class=\"left\"><p>Hva f\xe5r deg til \xe5 synes det?</p>Det fikk meg til \xe5 le</div></div>",A:"N"},{DECK_ID:"B13",ID:"B13060",N:"<div class=\"center\">det sp\xf8rs om</div>",E:"<div class=\"center\"><p>it depends on whether</p>it's a question of</div>",D:"EXPRESSIONS",X:"<div class=\"center\"><div class=\"left\">Det sp\xf8rs om du er erfaren nok for jobben</div></div>",A:"N"},{DECK_ID:"B13",ID:"B13061",N:"<div class=\"center\">\xe5 sl\xe5 seg ned</div>",E:"<div class=\"center\">to settle down, to sit down</div>",D:"EXPRESSIONS",X:"",A:"N"},{DECK_ID:"B13",ID:"B13062",N:"<div class=\"center\">p\xe5 egen h\xe5nd</div>",E:"<div class=\"center\">by oneself, single handedly</div>",D:"EXPRESSIONS",X:"",A:"N"},{DECK_ID:"B13",ID:"B13063",N:"<div class=\"center\">Er dere klar over det?</div>",E:"<div class=\"center\">Are you (guys) aware of that?</div>",D:"EXPRESSIONS",X:"<div class=\"center\"><div class=\"left\">Note how the adjective <span class=\"italic\">klar</span> remains in singular in this specific expression.</div></div>",A:"N"},{DECK_ID:"B13",ID:"B13064",N:"<div class=\"center\">med det samme</div>",E:"<div class=\"center\">straight away</div>",D:"EXPRESSIONS",X:"",A:"N"},{DECK_ID:"B13",ID:"B13065",N:"<div class=\"center\">evt.</div>",E:"<div class=\"center\">eventuelt</div>",D:"SHORTENINGS",X:"<div class=\"center\"><div class=\"left\">Used as \"any other business\" in the agendas of meetings and similar situations</div></div>",A:"N"},{DECK_ID:"B13",ID:"B13066",N:"<div class=\"center\">for det meste</div>",E:"<div class=\"center\">mostly, for the most</div>",D:"EXPRESSIONS",X:"",A:"N"},{DECK_ID:"B13",ID:"B13067",N:"<div class=\"center\">det tar lang tid</div>",E:"<div class=\"center\">it takes a long time</div>",D:"EXPRESSIONS",X:"",A:"N"},{DECK_ID:"B13",ID:"B13068",N:"<div class=\"center\">\xe5 legge vekt p\xe5</div>",E:"<div class=\"center\">to underline, to stress</div>",D:"EXPRESSIONS",X:"",A:"N"},{DECK_ID:"B13",ID:"B13069",N:"<div class=\"center\">Jeg f\xe5r ikke sove</div>",E:"<div class=\"center\">I can't (get to) sleep</div>",D:"EXPRESSIONS",X:"<div class=\"center\"><div class=\"left\">This is one of the nuances in meaning of <span class=\"italic\">\xe5 f\xe5</span></div></div>",A:"N"},{DECK_ID:"B13",ID:"B13070",N:"<div class=\"center\">d.d.</div>",E:"<div class=\"center\">dags dato</div>",D:"SHORTENINGS",X:"<div class=\"center\">today, today's date</div>",A:"N"},{DECK_ID:"B13",ID:"B13071",N:"<div class=\"center\">til \xe5 begynne med</div>",E:"<div class=\"center\">to begin with</div>",D:"EXPRESSIONS",X:"",A:"N"},{DECK_ID:"B13",ID:"B13072",N:"<div class=\"center\">som regel</div>",E:"<div class=\"center\">as a rule</div>",D:"EXPRESSIONS",X:"",A:"N"},{DECK_ID:"B13",ID:"B13073",N:"<div class=\"center\">f\xf8rst og fremst</div>",E:"<div class=\"center\">first and foremost</div>",D:"EXPRESSIONS",X:"",A:"N"},{DECK_ID:"B13",ID:"B13074",N:"<div class=\"center\">ca.</div>",E:"<div class=\"center\">cirka</div>",D:"SHORTENINGS",X:"<div class=\"center\">Same as \"circa\" in English</div>",A:"N"},{DECK_ID:"B13",ID:"B13075",N:"<div class=\"center\">\xe5 sette preg p\xe5</div>",E:"<div class=\"center\">to influence, to leave one's mark</div>",D:"EXPRESSIONS",X:"<div class=\"center\"><div class=\"left\">Det danske spr\xe5ket har satt preg p\xe5 bokm\xe5l</div></div>",A:"N"},{DECK_ID:"B13",ID:"B13076",N:"<div class=\"center\">i de fleste tilfellene</div>",E:"<div class=\"center\">in most cases</div>",D:"EXPRESSIONS",X:"",A:"N"},{DECK_ID:"B13",ID:"B13077",N:"<div class=\"center\">\xe5 komme i gang</div>",E:"<div class=\"center\">to begin, to get started</div>",D:"EXPRESSIONS",X:"",A:"N"},{DECK_ID:"B13",ID:"B13078",N:"<div class=\"center\">au!</div>",E:"<div class=\"center\">ouch!</div>",D:"EXCLAMATIONS",X:"<div class=\"center\">Expression of pain</div>",A:"N"},{DECK_ID:"B13",ID:"B13079",N:"<div class=\"center\">\xe5 gj\xf8re en innsats</div>",E:"<div class=\"center\">to make an effort</div>",D:"EXPRESSIONS",X:"",A:"N"},{DECK_ID:"B13",ID:"B13080",N:"<div class=\"center\">\xe5 v\xe6re p\xe5 utkikk etter</div>",E:"<div class=\"center\">to be looking for</div>",D:"EXPRESSIONS",X:"",A:"N"},{DECK_ID:"B13",ID:"B13081",N:"<div class=\"center\">\xe5 ha bruk for</div>",E:"<div class=\"center\">to have use for</div>",D:"EXPRESSIONS",X:"",A:"N"},{DECK_ID:"B13",ID:"B13082",N:"<div class=\"center\">for min del</div>",E:"<div class=\"center\">for one, in my opinion</div>",D:"EXPRESSIONS",X:"",A:"N"},{DECK_ID:"B13",ID:"B13083",N:"<div class=\"center\">f.eks.</div>",E:"<div class=\"center\">for eksempel</div>",D:"SHORTENINGS",X:"<div class=\"center\">for example, e.g.</div>",A:"N"},{DECK_ID:"B13",ID:"B13084",N:"<div class=\"center\">p\xe5 papiret</div>",E:"<div class=\"center\">on paper, theoretically</div>",D:"EXPRESSIONS",X:"",A:"N"},{DECK_ID:"B13",ID:"B13085",N:"<div class=\"center\">\xe5 g\xe5 til fots</div>",E:"<div class=\"center\">to go on foot, to stroll</div>",D:"EXPRESSIONS",X:"",A:"N"},{DECK_ID:"B13",ID:"B13086",N:"<div class=\"center\">Gleder du deg?<br>Gleder dere dere?</div>",E:"<div class=\"center\">Are you enjoying yourself?<br>Are you (guys) enjoying yourselves?</div>",D:"EXPRESSIONS",X:"<div class=\"center\"><div class=\"left\">Please note how the two <span class=\"italic\">dere</span> are pronounced as <span class=\"italic\">dokke(r)</span>, with a northern dialect.</div></div>",A:"N"},{DECK_ID:"B13",ID:"B13087",N:"<div class=\"center\">\xe5 holde p\xe5 sitt<br>holder<br>holdt<br>har holdt</div>",E:"<div class=\"center\">to stick to one's guns</div>",D:"EXPRESSIONS",X:"",A:"N"},{DECK_ID:"B13",ID:"B13088",N:"<div class=\"center\">huff\u2026</div>",E:"<div class=\"center\">ugh\u2026</div>",D:"EXCLAMATIONS",X:"<div class=\"center\">Irritation and/or fatigue</div>",A:"N"},{DECK_ID:"B13",ID:"B13089",N:"<div class=\"center\">h\xe6?</div>",E:"<div class=\"center\">uh?</div>",D:"EXCLAMATIONS",X:"<div class=\"center\">What?</div>",A:"N"},{DECK_ID:"B13",ID:"B13090",N:"<div class=\"center\">isj! / \xe6sj!</div>",E:"<div class=\"center\">bleah!<br>yuk!</div>",D:"EXCLAMATIONS",X:"<div class=\"center\">Disgust, repulsion</div>",A:"N"},{DECK_ID:"B14",ID:"B14001",N:"<div class=\"center\">Kan du andre spr\xe5k? Hvilke?</div>",E:"<div class=\"center\">Can you (speak) other languages?<br>Which ones?</div>",D:"INTERMEDIATE LISTENING",X:"<div class=\"center\"><div class=\"left\">Remember how certain verbs can be omitted when there is a modal such as <span class=\"italic\">kan</span>, <span class=\"italic\">skal</span>, <span class=\"italic\">vil</span> etc, if the meaning of the omitted verb is obvious from the context.</div></div>",A:"N"},{DECK_ID:"B14",ID:"B14002",N:"<div class=\"center\">Det er akkurat samme dato som da vi dro sist</div>",E:"<div class=\"center\">It's exactly the same date as when we went last time</div>",D:"INTERMEDIATE LISTENING",X:"<div class=\"center\"><div class=\"left\"><p>Remember that <span class=\"italic\">da</span> (then) is used to indicate one-off events in the past or repeated events in circumstances or a period that has ended for good. <span class=\"italic\">N\xe5r</span> (when) is used in all other occasions (including the future). Remember the rule:</p><span class=\"italic\">Den gang: da. Hver gang: n\xe5r.</span></div></div>",A:"N"},{DECK_ID:"B14",ID:"B14003",N:"<div class=\"center\">Det s\xe5 ut som nokke var galt,<br>men jeg turte ikke si nokke.</div>",E:"<div class=\"center\">It looked like something was wrong<br>but I didn't dare to say anything</div>",D:"INTERMEDIATE LISTENING",X:"<div class=\"center\"><div class=\"left\">This is spoken in a dialect in which <span class=\"italic\">noe</span> becomes <span class=\"italic\">nokke</span>.</div></div>",A:"N"},{DECK_ID:"B14",ID:"B14004",N:"<div class=\"center\">S\xe5 du hva som skjedde?<br>Var det noen der?</div>",E:"<div class=\"center\">Did you see what happened?<br>Was there somebody there?</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14005",N:"<div class=\"center\">Jeg liker skoene dine veldig godt!<br>Hvor kj\xf8pte du dem?</div>",E:"<div class=\"center\">I like your shoes a lot!<br>Where did you buy them?</div>",D:"INTERMEDIATE LISTENING",X:"<div class=\"center\"><div class=\"left\">Remember that \"to like very much\" is translated as <span class=\"italic\">\xe5 like veldig godt</span>, not as <span class=\"italic\">\xe5 like veldig mye</span>.</div></div>",A:"N"},{DECK_ID:"B14",ID:"B14006",N:"<div class=\"center\">Jeg er helt ferdig.<br>Jeg bare g\xe5r og legger meg, jeg.</div>",E:"<div class=\"center\">I'm done with everything.<br>I'm just going to bed.</div>",D:"INTERMEDIATE LISTENING",X:"<div class=\"center\"><div class=\"left\">In spoken language, it can happen that the speaker will throw an extra <span class=\"italic\">jeg</span> at the end of the sentence.</div></div>",A:"N"},{DECK_ID:"B14",ID:"B14007",N:"<div class=\"center\">Det er en grunn til at vi st\xe5r her n\xe5,<br>og ikke der borte\u2026 er det ikke det?</div>",E:"<div class=\"center\">There is a reason why<br> we are standing here and <br>not there\u2026 isn't there?</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14008",N:"<div class=\"center\">Nei, det gj\xf8r ingenting alts\xe5</div>",E:"<div class=\"center\">No, it doesn't matter.</div>",D:"INTERMEDIATE LISTENING",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">Alts\xe5</span> is often used as a \"non-word\" when speaking, learn to recognise it.</div></div>",A:"N"},{DECK_ID:"B14",ID:"B14009",N:"<div class=\"center\">Jeg er redd jeg har <br>d\xe5rlige nyheter til deg</div>",E:"<div class=\"center\">I'm afraid I have bad news for you</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14010",N:"<div class=\"center\">Faen, jeg m\xe5 gj\xf8re det slutt <br>med Edna, jeg.</div>",E:"<div class=\"center\">Damn, I must end it with Edna.</div>",D:"INTERMEDIATE LISTENING",X:"<div class=\"center\"><div class=\"left\">In spoken language, it can happen that the speaker will throw an extra <span class=\"italic\">jeg</span> at the end of the sentence.</div></div>",A:"N"},{DECK_ID:"B14",ID:"B14011",N:"<div class=\"center\">G\xe5r det bra om jeg setter p\xe5 radioen, eller?</div>",E:"<div class=\"center\">Is it ok if I turn on the radio, right?</div>",D:"INTERMEDIATE LISTENING",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">Eller</span> is often used as a \"non-word\" when speaking, especially at the end of a question.</div></div>",A:"N"},{DECK_ID:"B14",ID:"B14012",N:"<div class=\"center\"><div class=\"left\"><p>\u2013 Alt skal bli bra.</p>\u2013 Hva mener du?</div></div>",E:"<div class=\"center\"><div class=\"left\"><p>\u2013 Everything is going to be ok.</p>\u2013 How do you mean?</div></div>",D:"INTERMEDIATE LISTENING",X:"<div class=\"center\"><div class=\"left\">The dialect used in the second line is one of those in which some words starting with HV (e.g. <span class=\"italic\">hva, hvem, hvor</span>) are pronounced with a K instead.</div></div>",A:"N"},{DECK_ID:"B14",ID:"B14013",N:"<div class=\"center\">Som den gangen du trodde Svein faktisk var Ove!</div>",E:"<div class=\"center\">Like that time you believed that Svein was actually Ove!</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14014",N:"<div class=\"center\">Den fargen der\u2026 Jeg vet ikkje helt, jeg.</div>",E:"<div class=\"center\">That colour there\u2026 I don\u2019t really know.</div>",D:"INTERMEDIATE LISTENING",X:"<div class=\"center\"><div class=\"left\"><p>The variation <span class=\"italic\">ikkje</span> is typical of <span class=\"italic\">nynorsk</span>.</p>The pronoun <span class=\"italic\">jeg</span> is repeated at the end as a filler-word.</div></div>",A:"N"},{DECK_ID:"B14",ID:"B14015",N:"<div class=\"center\">Kan du forklare hva faen det er som har skjedd her?</div>",E:"<div class=\"center\">Can you explain what the heck it is that's happened here?</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14016",N:"<div class=\"center\"><div class=\"left\"><p>\u2013 Sa du noe, Line?</p>\u2013 Nei, jeg sa ingenting.</div></div>",E:"<div class=\"center\"><div class=\"left\"><p>\u2013 Did you say something, Line?</p>\u2013 No, I didn't say anything.</div></div>",D:"INTERMEDIATE LISTENING",X:"<div class=\"center\"><div class=\"left\">Note how it is very possible in Norwegian to basically say \"I said nothing\", whereas English might tend to say \"I didn\u2019t say anything\".</div></div>",A:"N"},{DECK_ID:"B14",ID:"B14017",N:"<div class=\"center\">Jeg glemte lommeboka mi hjemme,<br>kunne du betalt for meg?</div>",E:"<div class=\"center\">I forgot my wallet at home,<br>could you pay for me?</div>",D:"INTERMEDIATE LISTENING",X:"<div class=\"center\"><div class=\"left\">Note that whilst English has \"could you pay\", (spoken) Norwegian has <span class=\"italic\">kunne du betalt</span>, which is basically \"could you <b class=\"bold\">paid</b>\".<br>Although <span class=\"italic\">kunne du betale</span> would be the most correct form, the use we have shown is acceptable.</div></div>",A:"N"},{DECK_ID:"B14",ID:"B14018",N:"<div class=\"center\">Vi er enig med deg, det vet du.</div>",E:"<div class=\"center\">We agree with you, you know that.</div>",D:"INTERMEDIATE LISTENING",X:"<div class=\"center\"><div class=\"left\">Some adjectives remain in the singular <span class=\"italic\">hankj\xf8nn</span> form in certain expressions, regardless of the gender/number of the noun(s) they refer to.<br>Some of these include <span class=\"italic\">klar over, enig med</span> and <span class=\"italic\">lei av</span>.</div></div>",A:"N"},{DECK_ID:"B14",ID:"B14019",N:"<div class=\"center\">Du har spurt meg om <br>ka jeg er bekymret for\u2026</div>",E:"<div class=\"center\">You have asked <br>what I am worried about\u2026</div>",D:"INTERMEDIATE LISTENING",X:"<div class=\"center\"><div class=\"left\">The dialect used in the second line is one of those in which some words starting with HV (e.g. <span class=\"italic\">hva, hvem, hvor</span>) are pronounced with a K instead.</div></div>",A:"N"},{DECK_ID:"B14",ID:"B14020",N:"<div class=\"center\">Har det skjedd noe, eller?</div>",E:"<div class=\"center\">Has something happened, or what?</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14021",N:"<div class=\"center\"><div class=\"left\"><p>\u2013 Kjekt \xe5 sj\xe5 deg!</p>\u2013 Ja, i like m\xe5te!</div></div>",E:"<div class=\"center\"><div class=\"left\"><p>\u2013 Nice to see you!</p>\u2013 Yes, in the same way!</div></div>",D:"INTERMEDIATE LISTENING",X:"<div class=\"center\"><div class=\"left\">The word <span class=\"italic\">\xe5 sj\xe5</span> is the <span class=\"italic\">nynorsk</span> version of <span class=\"italic\">\xe5 se</span></div></div>",A:"N"},{DECK_ID:"B14",ID:"B14022",N:"<div class=\"center\">Hvem er daglig leder her?<br>Kan jeg f\xe5 snakke med ham eller henne?</div>",E:"<div class=\"center\">Who is the manager here?<br>Can I get to talk to him or her?</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14023",N:"<div class=\"center\">Hun er lei av \xe5 be om unnskyldninger<br>for at du ikke er med.</div>",E:"<div class=\"center\">She is tired of apologising<br>because you are not (present) with (her).</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14024",N:"<div class=\"center\">Jeg er ikke helt sikkert p\xe5 om <br>vi kjem til \xe5 sj\xe5 hverandre i morgen, da.</div>",E:"<div class=\"center\">I'm not completely sure whether we are going to see each other tomorrow, then.</div>",D:"INTERMEDIATE LISTENING",X:"<div class=\"center\"><div class=\"left\">The word <span class=\"italic\">kjem</span> is the <span class=\"italic\">nynorsk</span> version of <span class=\"italic\">kommer</span>, whereas <span class=\"italic\">\xe5 sj\xe5</span> is the <span class=\"italic\">nynorsk</span> version of <span class=\"italic\">\xe5 se</span>.</div></div>",A:"N"},{DECK_ID:"B14",ID:"B14025",N:"<div class=\"center\">Sjekket du \xe5pningstida <br>p\xe5 hjemmesida deres?</div>",E:"<div class=\"center\">Did you check the opening times <br>on their homepage?</div>",D:"INTERMEDIATE LISTENING",X:"<div class=\"center\"><div class=\"left\"><p>Remember that the -A ending for nouns is a possible alternative to the -ENE ending of the definite plural.</p>Note that the audio features a dialect from Nord Tr\xf8ndelag, but we provided a <span class=\"italic\">bokm\xe5l</span> trascription for it.</div></div>",A:"N"},{DECK_ID:"B14",ID:"B14026",N:"<div class=\"center\">Er det trygt der du bor?</div>",E:"<div class=\"center\">Is it safe where you live?</div>",D:"INTERMEDIATE LISTENING",X:"<div class=\"center\"><div class=\"left\">Note how \"where\" can be translated by <span class=\"italic\">der</span> (rather than <span class=\"italic\">hvor</span>) when the meaning is close to \"in the place where\".</div></div>",A:"N"},{DECK_ID:"B14",ID:"B14027",N:"<div class=\"center\">Hva er det du holder p\xe5 med?</div>",E:"<div class=\"center\">What are you doing?</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14028",N:"<div class=\"center\">Vi kunne kanskje g\xe5 ut en kveld?</div>",E:"<div class=\"center\">Maybe we could go out one evening?</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14029",N:"<div class=\"center\">Det er mennesker som ikke er <br>i stand til \xe5 f\xe5 en god jobb</div>",E:"<div class=\"center\">There are people who are not <br>in the condition to get a good job</div>",D:"INTERMEDIATE LISTENING",X:"<div class=\"center\"><div class=\"left\">Remember that <span class=\"italic\">det er</span> covers both \"there is\" and \"there are\".</div></div>",A:"N"},{DECK_ID:"B14",ID:"B14030",N:"<div class=\"center\">Jeg vet ikkje hvor sent, men\u2026<br>Ikkje sitt oppe, er du snill.</div>",E:"<div class=\"center\">I don't know how late, but\u2026<br>Don't stay up, please.</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14031",N:"<div class=\"center\">Det er kriminelt om du ikke lar andre f\xe5 h\xf8re deg synge. Jeg mener det.</div>",E:"<div class=\"center\">It\u2019s a crime if you don't let others hear you sing. I mean it.</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14032",N:"<div class=\"center\">Jeg var den siste som var <br>borti ballen f\xf8r den gikk ut</div>",E:"<div class=\"center\">I was the last to touch <br>the ball before it went out</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14033",N:"<div class=\"center\"><div class=\"left\"><p>\u2013 Ta med noen av vennene dine.</p>\u2013 Ja, for all del.</div></div>",E:"<div class=\"center\"><div class=\"left\"><p>\u2013 Bring some of your friends.</p> \u2013 Yes, by all means.</div></div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14034",N:"<div class=\"center\">Du\u2026 vi snakkes, ikke sant?</div>",E:"<div class=\"center\">Hey\u2026 talk later, right?</div>",D:"INTERMEDIATE LISTENING",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">Du</span> can be used as a way to really catch the other person's attention before speaking.</div></div>",A:"N"},{DECK_ID:"B14",ID:"B14035",N:"<div class=\"center\">Hva er det du pr\xf8ver \xe5 si for nokke?</div>",E:"<div class=\"center\">What are you trying to say?</div>",D:"INTERMEDIATE LISTENING",X:"<div class=\"center\"><div class=\"left\">This is spoken in a dialect in which <span class=\"italic\">noe</span> becomes <span class=\"italic\">nokke</span>.</div></div>",A:"N"},{DECK_ID:"B14",ID:"B14036",N:"<div class=\"center\">Litt senere, dro vi tilbake hjem\u2026</div>",E:"<div class=\"center\">A little later, we went back home\u2026</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14037",N:"<div class=\"center\">Nei, moren min har ikke sagt noe om det.<br>Hun vet nemlig ikke noe om det.</div>",E:"<div class=\"center\">No, my mother hasn't said anything about that. Actually, she doesn't know anything about that.</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14038",N:"<div class=\"center\">Er du ikke glad i meg lenger, er det det?</div>",E:"<div class=\"center\">Don't you love me anymore?<br>Is that what it is?</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14039",N:"<div class=\"center\">Bare h\xf8r p\xe5 meg, ok?<br>Laget kommer ikke til \xe5 tape denne kampen.</div>",E:"<div class=\"center\">Just listen to me, ok?<br>The team is not going to lose this match.</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14040",N:"<div class=\"center\">Jeg kommer litt seint hjem i dag.<br>Du m\xe5 nok spise middag alene, s\xf8rry.</div>",E:"<div class=\"center\">I'm coming home a bit late today.<br>You'll have to have dinner alone, sorry.</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14041",N:"<div class=\"center\">S\xe5 tok hun handa mi i si</div>",E:"<div class=\"center\">And then she took my hand in hers</div>",D:"INTERMEDIATE LISTENING",X:"<div class=\"center\"><div class=\"left\">The word <span class=\"italic\">handa</span> is a dialectal form of what would normally be <span class=\"italic\">h\xe5nda</span>.</div></div>",A:"N"},{DECK_ID:"B14",ID:"B14042",N:"<div class=\"center\">Du kjem p\xe5 l\xf8rdag, ikke sant?</div>",E:"<div class=\"center\">You're coming on Saturday, aren't you?</div>",D:"INTERMEDIATE LISTENING",X:"<div class=\"center\"><div class=\"left\">The word <span class=\"italic\">kjem</span> is the <span class=\"italic\">nynorsk</span> version of <span class=\"italic\">kommer</span>.</div></div>",A:"N"},{DECK_ID:"B14",ID:"B14043",N:"<div class=\"center\">Men hva er det du vil? <br>Jeg skj\xf8nner ikke, jeg\u2026</div>",E:"<div class=\"center\">But what is it that you want? <br>I don't understand\u2026</div>",D:"INTERMEDIATE LISTENING",X:"<div class=\"center\"><div class=\"left\">In spoken language, it can happen that the speaker will throw an extra <span class=\"italic\">jeg</span> at the end of the sentence.</div></div>",A:"N"},{DECK_ID:"B14",ID:"B14044",N:"<div class=\"center\">Og ingenting kunne noensinne bli det samme igjen etter det</div>",E:"<div class=\"center\">And nothing could ever be the same again after that</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14045",N:"<div class=\"center\">Har du kontanter? <br>De tar ikke kort.</div>",E:"<div class=\"center\">Do you have cash? <br>They don't take cards.</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14046",N:"<div class=\"center\">Han snakker veldig raskt og<br>med rar dialekt jeg ikke skj\xf8nner mye av.</div>",E:"<div class=\"center\">He speaks really fast and<br>with a strange accent I can't understand much of.</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14047",N:"<div class=\"center\">Kan du skru av tv-en n\xe5r du g\xe5r hjemmefra, er den grei?</div>",E:"<div class=\"center\">Can you turn off the TV when you leave the house, is that ok?</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14048",N:"<div class=\"center\">Hva er det du driver med?</div>",E:"<div class=\"center\">What is it that you do?</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14049",N:"<div class=\"center\">Kan du sende meg bildene fra festen?</div>",E:"<div class=\"center\">Can you send me the photos from the party?</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14050",N:"<div class=\"center\">Jeg vet ikke helt hva greia med ham er\u2026<br>Det virker som han er travlere enn vanlig\u2026</div>",E:"<div class=\"center\">I don't quite know what's the thing with him\u2026 It seems like he is busier than usual.</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14051",N:"<div class=\"center\">Hva drev du med p\xe5 90-tallet?</div>",E:"<div class=\"center\">What were you doing in the 90s?</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14052",N:"<div class=\"center\">Sist jeg h\xf8rte nokke fra ham var for sju m\xe5neder siden </div>",E:"<div class=\"center\">Last I heard a word from him was seven months ago</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14053",N:"<div class=\"center\">Hei. N\xe5 har du kommet til St\xe5les mobilsvar.</div>",E:"<div class=\"center\">Hi. This is St\xe5le's answering machine.</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14054",N:"<div class=\"center\">Det er ikke noe galt med maten her</div>",E:"<div class=\"center\">There is nothing wrong with the food here</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14055",N:"<div class=\"center\">Hun ble derfor r\xe5det til \xe5 ikke bes\xf8ke ham</div>",E:"<div class=\"center\">Therefore, she was advised not to visit him.</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14056",N:"<div class=\"center\">Hva er det du mener, egentlig? <br>Hva er det du vil?</div>",E:"<div class=\"center\">What do you actually mean? <br>What is it that you want?</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14057",N:"<div class=\"center\">Bare legg igjen en beskjed <br>hvis han ikke svarer</div>",E:"<div class=\"center\">Just leave a message <br>if he doesn't answer</div>",D:"INTERMEDIATE LISTENING",X:"<div class=\"center\"><div class=\"left\">Note that <span class=\"italic\">\xe5 gi (noen) beskjed</span> can be a good translation of \"to let (somebody) know\", typical when planning something with others.</div></div>",A:"N"},{DECK_ID:"B14",ID:"B14058",N:"<div class=\"center\">Du vet\u2026 Det er ikkje sunt \xe5 r\xf8yke.</div>",E:"<div class=\"center\">You know, it's not healthy to smoke.</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14059",N:"<div class=\"center\">Hun t\xf8r skifte mening, og det t\xf8r ikke du.</div>",E:"<div class=\"center\">She dares to change opinion, but you don't.</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14060",N:"<div class=\"center\">Du kan vel sitte ved bordet <br>og spille kort med oss</div>",E:"<div class=\"center\">You can well sit at the table <br>and play cards with us</div>",D:"INTERMEDIATE LISTENING",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">Du kan vel</span> could be translated more idiomatically as \"you might as well\".</div></div>",A:"N"},{DECK_ID:"B14",ID:"B14061",N:"<div class=\"center\">Farfaren min var tysk og <br>farmora mi var norsk</div>",E:"<div class=\"center\">My paternal grandfather was German and my paternal grandmother was Norwegian.</div>",D:"INTERMEDIATE LISTENING",X:"<div class=\"center\"><div class=\"left\">Note that Norwegian can agglutinate <span class=\"italic\">far</span> and <span class=\"italic\">mor</span> in four combinations to indicate paternal and maternal grandfathers and grandmothers.</div></div>",A:"N"},{DECK_ID:"B14",ID:"B14062",N:"<div class=\"center\">Flott! Bra gjort!</div>",E:"<div class=\"center\">Beautiful! Well done!</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14063",N:"<div class=\"center\">\xc5lreit. S\xe5 er det et d\xe5rlig eksempel,<br>men det forandrer ingenting.</div>",E:"<div class=\"center\">Alright. That's a bad example,<br>but it doesn't change anything.</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14064",N:"<div class=\"center\">Ikke bekymr deg over det,<br>de to tingene er like lette \xe5 gj\xf8re</div>",E:"<div class=\"center\">Don't worry about it,<br>those two things are equally easy to do.</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14065",N:"<div class=\"center\"><div class=\"left\"><p>\u2013 Hva driver du med?</p>\u2013 Jeg jobber i en matbutikk i sentrum.</div></div>",E:"<div class=\"center\"><div class=\"left\"><p>\u2013 What do you do?</p>\u2013 I work in a food shop in the city centre.</div></div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14066",N:"<div class=\"center\">Hun ser ham ikke s\xe5 ofte\u2026<br>Det er ikke s\xe5 farlig.</div>",E:"<div class=\"center\">She doesn't see him so often\u2026<br>It's not really important.</div>",D:"INTERMEDIATE LISTENING",X:"<div class=\"center\"><div class=\"left\">The expression <span class=\"italic\">ikke s\xe5 farlig</span> means \"not so important\", although it would literally mean \"not so dangerous\".</div></div>",A:"N"},{DECK_ID:"B14",ID:"B14067",N:"<div class=\"center\">Pass p\xe5, det er glatt!</div>",E:"<div class=\"center\">Watch out, it's icy!</div>",D:"INTERMEDIATE LISTENING",X:"<div class=\"center\"><div class=\"left\">Remember that the verb <span class=\"italic\">\xe5 passe</span> with the preposition <span class=\"italic\">p\xe5</span> means \"to watch out for\".</div></div>",A:"N"},{DECK_ID:"B14",ID:"B14068",N:"<div class=\"center\">Vi m\xe5 dra f\xf8r klokken 11,<br>ellers kommer vi til \xe5 v\xe6re seine.</div>",E:"<div class=\"center\">We must leave before 11 o'clock,<br>otherwise we'll be late.</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14069",N:"<div class=\"center\">Hvis du liker \xe5 g\xe5 p\xe5 ski,<br>er vinteren bedre enn sommeren</div>",E:"<div class=\"center\">If you like to ski,<br>the winter is better than the summer.</div>",D:"INTERMEDIATE LISTENING",X:"<div class=\"center\"><div class=\"left\">Note that because the subordinate clause (here it is given away by the <span class=\"italic\">hvis</span>) is before the main clause, then subject and verb in the main clause are swapped (i.e. V2 rule).</div></div>",A:"N"},{DECK_ID:"B14",ID:"B14070",N:"<div class=\"center\">Han blir sint n\xe5r han ikke blir tatt p\xe5 alvor</div>",E:"<div class=\"center\">He gets angry when he's not taken seriously</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14071",N:"<div class=\"center\">S\xe5 lurte jeg bare p\xe5 om du\u2026<br>vil g\xe5 p\xe5 date med meg?</div>",E:"<div class=\"center\">So I was just wondering if you\u2026<br> would like to go on a date with me?</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14072",N:"<div class=\"center\">F\xf8rst og fremst, ro deg ned.<br>Og som jeg har sagt, jeg har ingenting imot deg.</div>",E:"<div class=\"center\">First and foremost, please calm down.<br>And as I have said, I have nohing against you.</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14073",N:"<div class=\"center\">Jeg har sendt ham en melding,<br>men han har ikke svart enn\xe5.</div>",E:"<div class=\"center\">I have sent him a message,<br>but he hasn't replied yet.</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14074",N:"<div class=\"center\">Det er helt idiotisk og det vet du!</div>",E:"<div class=\"center\">It's pure idiocy, and you know it!</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14075",N:"<div class=\"center\">Unnskyld, jeg gikk meg bort,<br>kunne du vise meg hvor Frognerveien er?</div>",E:"<div class=\"center\">I'm sorry, I got lost, could you please show me where is Frognerveien?</div>",D:"INTERMEDIATE LISTENING",X:"<div class=\"center\"><div class=\"left\"><p>This is spoken in a dialect in which <span class=\"italic\">hvor</span> becomes <span class=\"italic\">kor</span>.</p>The expression <span class=\"italic\">\xe5 g\xe5 seg bort</span> means \"to get lost\".</div></div>",A:"N"},{DECK_ID:"B14",ID:"B14076",N:"<div class=\"center\">Hva gj\xf8r du ellers? <br>Om kvelden.</div>",E:"<div class=\"center\">What do you do, otherwise? <br>In the evening.</div>",D:"INTERMEDIATE LISTENING",X:"<div class=\"center\"><div class=\"left\">This is spoken in a dialect in which <span class=\"italic\">hva</span> becomes <span class=\"italic\">ka</span>.</div></div>",A:"N"},{DECK_ID:"B14",ID:"B14077",N:"<div class=\"center\">Du f\xe5r ikkje lov uansett</div>",E:"<div class=\"center\">You are not allowed anyway</div>",D:"INTERMEDIATE LISTENING",X:"<div class=\"center\"><div class=\"left\">Note how <span class=\"italic\">\xe5 f\xe5 lov (til)</span> means \"to be allowed (to)\", \"to get the permission (to)\".</div></div>",A:"N"},{DECK_ID:"B14",ID:"B14078",N:"<div class=\"center\">Kan du jobbe lovlig i Norge?</div>",E:"<div class=\"center\">Can you work legally in Norway?</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14079",N:"<div class=\"center\">Jeg kjem litt sent i dag. <br>Blir n\xf8dt til \xe5 jobbe seint.</div>",E:"<div class=\"center\">I'm coming a bit late today. <br>I have to work (until) late.</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14080",N:"<div class=\"center\">Du tar ting litt for gitt.<br>Husk at du ikke har arbeidet her lenge.</div>",E:"<div class=\"center\">You take things a bit for given.<br>Remember that you haven't worked here long.</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14081",N:"<div class=\"center\">Jeg tar Norskpr\xf8ve 2 neste m\xe5ned</div>",E:"<div class=\"center\">I'm taking the \"Norskpr\xf8ve 2\" next month</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14082",N:"<div class=\"center\">Jeg flyttet nylig til Norge,<br>for mindre enn to m\xe5neder siden.</div>",E:"<div class=\"center\">I moved to Norway recently,<br>less than two months ago.</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14083",N:"<div class=\"center\">Vi kan slippe \xe5 betale s\xe5 mye</div>",E:"<div class=\"center\">We can avoid paying so much</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14084",N:"<div class=\"center\">Men nei\u2026 Det her er for mye allerede!<br>Ta litt tilbake, du er altfor snill.</div>",E:"<div class=\"center\">But no\u2026 that's too much already!<br>Get some back, you are too kind.</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14085",N:"<div class=\"center\">Han hadde en avtale med noen<br>som bare var her denne helgen.</div>",E:"<div class=\"center\">He had an appointment with somebody<br>who was only here this weekend.</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14086",N:"<div class=\"center\">Hva er det du er redd for?</div>",E:"<div class=\"center\">What are you scared of?</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14087",N:"<div class=\"center\">Du kan jo ikke regne med at jeg kan <br>eller at jeg vil komme p\xe5 festen</div>",E:"<div class=\"center\">You can't just count on the fact that I can or that I want to come to the party.</div>",D:"INTERMEDIATE LISTENING",X:"<div class=\"center\"><div class=\"left\">The expression <span class=\"italic\">\xe5 regne med at</span> can translate as \"to count on the fact that\", \"to assume\".</div></div>",A:"N"},{DECK_ID:"B14",ID:"B14088",N:"<div class=\"center\"><div class=\"left\"><p>\u2013 Du har snart bursdag, du.</p>\u2013 Ja, det har jeg.</div></div>",E:"<div class=\"center\"><div class=\"left\"><p>\u2013 You are having your birthday soon.</p>\u2013 Yes, I have.</div></div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14089",N:"<div class=\"center\">Det er bare det at jeg trenger <br>en ferie bort fra Oslo</div>",E:"<div class=\"center\">It's just that I need <br>a holiday away from Oslo</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14090",N:"<div class=\"center\">Et par av venninnene dine er ganske hyggelige. Og s\xf8te, ogs\xe5.</div>",E:"<div class=\"center\">A couple of your (female) friends were quite friendly. And cute, too.</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14091",N:"<div class=\"center\">Bare \xe5 sette seg i bilen, <br>s\xe5 kj\xf8rer vi til Ikea</div>",E:"<div class=\"center\">We just have to get in the car, <br>so we can drive to Ikea.</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14092",N:"<div class=\"center\">Selv om jeg har skrudd lyden p\xe5 tv-en helt ned, kan jeg fortsatt h\xf8re nokke.</div>",E:"<div class=\"center\">Even though I have turned the TV down completely, I can still hear something</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14093",N:"<div class=\"center\">Hvor ble det av ham <br>ved slutten av festen?</div>",E:"<div class=\"center\">What happened to him <br>at the end of the party?</div>",D:"INTERMEDIATE LISTENING",X:"<div class=\"center\"><div class=\"left\">The expression <span class=\"italic\">hvor ble det av (noen/noe)</span> means \"what happened to (somebody/something)\", \"what became of (somebody/something)\".</div></div>",A:"N"},{DECK_ID:"B14",ID:"B14094",N:"<div class=\"center\">Hva er jeg redd for? M\xf8rke.<br>Og deg, n\xe5r du er s\xe5nn som n\xe5.</div>",E:"<div class=\"center\">What am I scared of? Darkness.<br>And you, when you are like now.</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14095",N:"<div class=\"center\">Du har ikke sendt e-posten enn\xe5, har du?</div>",E:"<div class=\"center\">You haven't sent the e-mail yet, have you?</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14096",N:"<div class=\"center\">Jeg kjenner ham fra f\xf8r,<br>vi m\xf8ttes i fjor.</div>",E:"<div class=\"center\">I know him from before,<br> we got to know each other last year.</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14097",N:"<div class=\"center\">Har du lyst til \xe5 g\xe5 p\xe5 kino?<br>Det er en film jeg vil gjerne se.</div>",E:"<div class=\"center\">Do you fancy going to the cinema?<br>There is a movie I would like to see.</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14098",N:"<div class=\"center\">Geir ble ordentlig sint da <br>han fikk h\xf8re sannheten</div>",E:"<div class=\"center\">Geir became properly angry when <br>he got to hear the truth</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14099",N:"<div class=\"center\">Han sa i g\xe5r at alt skulle ordne seg</div>",E:"<div class=\"center\">Yesterday he said that everything is going to be alright</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14100",N:"<div class=\"center\">Jeg var der alts\xe5, men jeg kunne ikke kjenne igjen noen.</div>",E:"<div class=\"center\">I was there, but I couldn't recognise anybody.</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14101",N:"<div class=\"center\">Hun har sv\xe6rt merkelige meninger om<br>mange forskjellige ting.</div>",E:"<div class=\"center\">She has very strange opinions about<br>many different things.</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14102",N:"<div class=\"center\">Roald, hils p\xe5 Vigdis.</div>",E:"<div class=\"center\">Roald, say hello to Vigdis.</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14103",N:"<div class=\"center\">Hun trenger ikke \xe5 ha det fint hele tida.<br>Men en gang iblant.</div>",E:"<div class=\"center\">She doesn't need to have a good time all the time. But once in a while.</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14104",N:"<div class=\"center\">Sjefen min er en god leder,<br>teamet mitt setter pris p\xe5 ham.</div>",E:"<div class=\"center\">My boss is a good leader,<br>my team really values him.</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14105",N:"<div class=\"center\">Beklager at jeg ikke har v\xe6rt s\xe5 mye hjemme i det siste.</div>",E:"<div class=\"center\">I am sorry that I haven't been very much<br>at home as of late.</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14106",N:"<div class=\"center\">Skal vi ikke legge all <br>den gamle dritten bak oss?</div>",E:"<div class=\"center\">Shall we not put <br>all that old shit behind us?</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14107",N:"<div class=\"center\"><div class=\"left\"><p>\u2013 Vetle, ta deg noe \xe5 drikke.</p>\u2013 Takk.</div></div>",E:"<div class=\"center\"><div class=\"left\"><p>\u2013 Vetle, get yourself something to drink.</p> \u2013 Thanks.</div></div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14108",N:"<div class=\"center\">Det handler om penger, som alltid.</div>",E:"<div class=\"center\">It's about money, like always.</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14109",N:"<div class=\"center\">Snart kommer han til \xe5 spille dritbra fotball igjen</div>",E:"<div class=\"center\">Soon he is going to play really good football again</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14110",N:"<div class=\"center\">Sp\xf8rs om ikke maten her er litt verre enn vi trodde</div>",E:"<div class=\"center\">I wonder if the food here is not<br>a little worse than we believed.</div>",D:"INTERMEDIATE LISTENING",X:"<div class=\"center\"><div class=\"left\"><span class=\"italic\">(Det) sp\xf8rs</span> is an expression meaning \"I wonder\" or \"it's a question of\".</div></div>",A:"N"},{DECK_ID:"B14",ID:"B14111",N:"<div class=\"center\">Det kan godt hende at de sier<br> \"ikkje\" p\xe5 Vestlandet</div>",E:"<div class=\"center\">It can easily happen that they say<br> \"ikkje\" in western Norway</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14112",N:"<div class=\"center\">Den restauranten er skikkelig bra <br>og ikkje for dyr</div>",E:"<div class=\"center\">That restaurant is really, really good, <br>and not too expensive.</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14113",N:"<div class=\"center\">Jeg for min del er helt sikker p\xe5 at<br>hele greia ble lagd p\xe5 forh\xe5nd.</div>",E:"<div class=\"center\">Personally I am completely sure that<br>the whole thing was prepared beforehand.</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14114",N:"<div class=\"center\">Dagen etter ba han henne om <br>\xe5 reise bort med ham.</div>",E:"<div class=\"center\">The day after he asked her to go<br>on a trip away with him.</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14115",N:"<div class=\"center\">Kom igjen, det er ikke s\xe5 ille.<br>Jeg mener, det kunne ha v\xe6rt verre!</div>",E:"<div class=\"center\">Come on, it's not that bad.<br>I mean, it could have been worse!</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14116",N:"<div class=\"center\">Jeg har v\xe6rt i d\xe5rlig hum\xf8r hele dagen</div>",E:"<div class=\"center\">I've been in a bad mood for the whole day</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14117",N:"<div class=\"center\">Jeg skal passe p\xe5 deg. Jeg lover.</div>",E:"<div class=\"center\">I'm going to look after you. I promise.</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14118",N:"<div class=\"center\">Skal vi gj\xf8re noe i kveld, eller?</div>",E:"<div class=\"center\">Shall we do something tonight?</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14119",N:"<div class=\"center\">Vi kan for eksempel g\xe5 en tur.<br>Det er jo det jeg vil.</div>",E:"<div class=\"center\">We could go for a walk/trip for example.<br>That's what I want.</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14120",N:"<div class=\"center\">Jeg vet ikke\u2026 Jeg tror han lyver\u2026</div>",E:"<div class=\"center\">I don't know\u2026 I think he's lying\u2026</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14121",N:"<div class=\"center\">Koss g\xe5r det?</div>",E:"<div class=\"center\">How is it going?</div>",D:"INTERMEDIATE LISTENING",X:"<div class=\"center\"><div class=\"left\">The word <span class=\"italic\">koss</span> is a dialectal form for <span class=\"italic\">hvordan</span>.</div></div>",A:"N"},{DECK_ID:"B14",ID:"B14122",N:"<div class=\"center\">Jeg ser endlig lyset i enden av tunnelen</div>",E:"<div class=\"center\">I can finally see the light <br>at the end of the tunnel</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14123",N:"<div class=\"center\">Han stod der og lot som om <br>det ikke var hans feil</div>",E:"<div class=\"center\">He stood there and pretended <br>that it wasn't his fault</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14124",N:"<div class=\"center\">Det er neppe mitt problem</div>",E:"<div class=\"center\">That's not quite my problem</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14125",N:"<div class=\"center\">Du gir oss ikkje noe valg<br>n\xe5r du stikker av p\xe5 den m\xe5ten der.</div>",E:"<div class=\"center\">You don't give us any choice<br>when you go away in that way.</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14126",N:"<div class=\"center\">Jeg har ombestemt meg.<br>Jeg har ikke lyst til \xe5 skaffe det likevel.</div>",E:"<div class=\"center\">I have changed my mind.<br>I don't fancy getting it anyway.</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14127",N:"<div class=\"center\">Kom igjen! Ikke v\xe6r kjip!</div>",E:"<div class=\"center\">Come on! Don't be lame!</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14128",N:"<div class=\"center\">Herregud, jeg hadde ikke noe annet valg<br>enn \xe5 g\xe5 p\xe5 date med ham.</div>",E:"<div class=\"center\">Good lord, I had no choice<br>other than to go on a date with him.</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14129",N:"<div class=\"center\">Vet du hva problemet ditt er?<br>Du greier jo aldri \xe5 si hva du mener.</div>",E:"<div class=\"center\">Do you know what's your problem?<br>You never manage to say what you mean.</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14130",N:"<div class=\"center\">Du vet, de aller fleste er lei av det der.</div>",E:"<div class=\"center\">You know, most (people) are very tired of that.</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14131",N:"<div class=\"center\">Det er da det gjelder \xe5 skjerpe seg</div>",E:"<div class=\"center\">That's when it comes down to getting a grip on yourself</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14132",N:"<div class=\"center\">Jeg pr\xf8vde \xe5 si det i stad, <br>men jeg klarte det ikke.</div>",E:"<div class=\"center\">I tried to say it (when we were) <br>in town, but I couldn't.</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14133",N:"<div class=\"center\">Jeg har ordnet og vasket litt. <br>M\xe5tte jo det.</div>",E:"<div class=\"center\">I have tidied up and cleaned a little. <br>Had to do it.</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14134",N:"<div class=\"center\">Jeg kjeder meg innmari p\xe5 de forelesningene</div>",E:"<div class=\"center\">I get impossibly bored during these lectures</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14135",N:"<div class=\"center\">Ro deg ned! Bare ro deg ned, du!</div>",E:"<div class=\"center\">Calm down! You just calm down, ok?!</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14136",N:"<div class=\"center\">Som jeg ville si f\xf8r jeg ble avbrutt av deg,<br>kan vi ikke gj\xf8re det\u2026</div>",E:"<div class=\"center\">Like I wanted to say before I was interrupted by you,<br>we cannot do that\u2026</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14137",N:"<div class=\"center\">Hun lo av buksene mine.<br>Det var ganske dumt av henne.</div>",E:"<div class=\"center\">She laughed about my trousers.<br>It was pretty stupid of her.</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14138",N:"<div class=\"center\">Hun tvilte p\xe5 at dette var sant,<br>og ville se det med egne \xf8yne.</div>",E:"<div class=\"center\">She doubted that it was true<br>and wanted to see it with her own eyes.</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14139",N:"<div class=\"center\">Jeg aner ikke hva du snakker om\u2026</div>",E:"<div class=\"center\">I have no clue what you are talking about\u2026</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"B14",ID:"B14140",N:"<div class=\"center\">Jeg antar han er syk, <br>men ingen vet helt sikkert.</div>",E:"<div class=\"center\">I assume that he's sick, <br>but nobody knows for sure.</div>",D:"INTERMEDIATE LISTENING",X:"",A:"N"},{DECK_ID:"C01",ID:"C01001",N:"<div class=\"center\">What are the two tones (<span class=\"italic\">tonemer</span>) <br>of spoken Norwegian?</div>",E:"<div class=\"center\"><div class=\"left\"><p>Spoken Norwegian requires you to produce two different \"pitch patterns\" when pronouncing the stressed syllables of a word: <span class=dodgerBlue>tone 1</span> and <span class=royalRed>tone 2</span>.</p> These tones affect the stressed syllable in two different ways.</div></div>",D:"ADVANCED PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\"><p>Listen to these examples:</p></div><p><span class=dodgerBlue>\xb9hjem</span>met&emsp;&emsp;&emsp;the home<br><span class=royalRed>\xb2hjem</span>me&emsp;&emsp;&emsp;at home</p><div class=\"left\"><p>The first word has <span class=dodgerBlue>tone 1</span> (ascending pitch) in the first syllable, the second has <span class=royalRed>tone 2</span> (ascending then descending pitch), also in the first syllable.</p> <p>The tone (which is basically how you \"sing\" the word) is the only thing that allows distinguishing certain words in speech and is an integral part of how natives speak.</p> This said, they vary from dialect to dialect and foreigners can certainly be excused for not learning to produce them.</div></div>",A:"X"},{DECK_ID:"C01",ID:"C01002",N:"<div class=\"center\">Press here to listen to the two words <br>and identify the two pitch accents</div>",E:"<div class=\"center\"><span class=dodgerBlue>\xb9b\xf8n</span>der&emsp;&emsp;&emsp;peasants<br><br><span class=royalRed>\xb2b\xf8n</span>ner&emsp;&emsp;&emsp;beans</div>",D:"ADVANCED PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\"><p>Comparing words identical in pronunciation but featuring the two different pitch accents is a good way to learn to recognise them first, which in turn helps producing them.</p> <p>Please note that the syllable after the one with the tone takes the pitch further up.</p> So the two syllables of the first word are \"<span class=dodgerBlue>up</span>\u2013up\", whilst the two of the second word are \"<span class=royalRed>updown</span>\u2013up\".</div></div>",A:"N"},{DECK_ID:"C01",ID:"C01003",N:"<div class=\"center\">Read out the following word:<br><span class=\"lg\">annen</span></div>",E:"<div class=\"center\"><div class=\"arialFont supWrap\">[&ensp; <div class=\"sup\">2</div>&#593;&#720;&#593;n ]</div></div>",D:"ADVANCED PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">As you can see and hear, the pronunciation is basically a very long A followed by N.</div></div>",A:"E"},{DECK_ID:"C01",ID:"C01004",N:"<div class=\"center\">How can I learn when to produce <span class=dodgerBlue>tone 1</span> <br>and when to produce <span class=royalRed>tone 2</span>?</div>",E:"<div class=\"center\"><div class=\"left\"><p>There is a helpful basic rule for <span class=royalRed>tone 2</span>.</p> Most words that have two syllables and end with -E (in writing) require <span class=royalRed>tone 2</span>. <p>See the examples below.</p></div></div>",D:"ADVANCED PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\"><p>Verbs (except prepositional verbs):<br>(\xe5) <span class=royalRed>\xb2kas</span>te, <span class=royalRed>\xb2del</span>te, <span class=royalRed>\xb2byg</span>de, <span class=royalRed>\xb2trod</span>de</p> <p>Nouns of all genders:<br>(en) <span class=royalRed>\xb2ti</span>me, (ei) <span class=royalRed>\xb2jen</span>te, (et) <span class=royalRed>\xb2bil</span>de</p> <p>Adjectives in the definite/plural form:<br><span class=royalRed>\xb2fi</span>ne, <span class=royalRed>\xb2fri</span>e, <span class=royalRed>\xb2la</span>ve, <span class=royalRed>\xb2r\xf8</span>de</p> <p>Other 2-syllable words:<br><span class=royalRed>\xb2de</span>re, <span class=royalRed>\xb2ba</span>re</p> We will mostly focus on the rules for <span class=royalRed>tone 2</span>, which means that, by subtraction, any other situation will require <span class=dodgerBlue>tone 1</span>.</div></div>",A:"X"},{DECK_ID:"C01",ID:"C01005",N:"<div class=\"center\">Press here to listen to the two words <br>and identify the two pitch accents</div>",E:"<div class=\"center\"><span class=royalRed>\xb2ly</span>se&emsp;&emsp;&emsp;(to) shine<br><br><span class=dodgerBlue>\xb9ly</span>set&emsp;&emsp;&emsp;the light</div>",D:"ADVANCED PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\"><p>The first word has the \"updown\u2013up\" <span class=royalRed>tone 2</span> typical of two-syllable words ending in -E, the second has the more straightforward <span class=dodgerBlue>tone 1</span> because it's originally a one-syllable word to which the definite ending -ET has been added.</p> Also, bear in mind that the pitch-accents of dialects from western and northern Norway are different from the ones you are hearing here.</div></div>",A:"N"},{DECK_ID:"C01",ID:"C01006",N:"<div class=\"center\">What are some notable exceptions to the \"two syllables and ending in -E\" rule?</div>",E:"<div class=\"center\"><div class=\"left\"><p>The exceptions are:</p>1) the two words for \"left\" and \"right\"<br>2) some loanwords<br>3) some irregular comparatives</div></div>",D:"ADVANCED PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\"><p>Listen to the actual words:</p><p>1) <span class=dodgerBlue>\xb9ven</span>stre, <span class=dodgerBlue>\xb9h\xf8y</span>re</p> <p>2) (en) <span class=dodgerBlue>\xb9ak</span>sje, (en) <span class=dodgerBlue>\xb9kaf</span>fe, (en) <span class=dodgerBlue>\xb9ord</span>re</p> 3) <span class=dodgerBlue>\xb9be</span>dre, <span class=dodgerBlue>\xb9fle</span>re, <span class=dodgerBlue>\xb9el</span>dre, <span class=dodgerBlue>\xb9st\xf8r</span>re etc </div></div>",A:"X"},{DECK_ID:"C01",ID:"C01007",N:"<div class=\"center\">Read out the following name:<br><span class=\"lg\">Roald</span></div>",E:"<div class=\"center\"><div class=\"arialFont supWrap\">[&ensp; <div class=\"sup\">2</div>&#638;&#117;&#720;&#593;&#619;&#720; ]</div></div>",D:"ADVANCED PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\"><p>The final D is silent and prolongs the L.</p> Please note that the IPA transcription attempts to be specific to what our actor said, rather than trying to define a universal standard for how that word should be pronounced.</div></div>",A:"E"},{DECK_ID:"C01",ID:"C01008",N:"<div class=\"center\">What are the tone rules for weak verbs?</div>",E:"<div class=\"center\"><div class=\"left\"><p>The various forms of weak verbs will have <span class=royalRed>tone 2</span> as long as they have 2-syllables.</p>Consequently, past participles of patterns 2, 3 and 4, plus infinitive and present forms of pattern 4, will generally have <span class=dodgerBlue>tone 1</span> instead.</div></div>",D:"ADVANCED PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\"><p>(\xe5) <span class=royalRed>\xb2kas</span>te, <span class=royalRed>\xb2kas</span>ter, <span class=royalRed>\xb2kas</span>tet, (har) <span class=royalRed>\xb2kas</span>tet</p> <p>(\xe5) <span class=royalRed>\xb2de</span>le, <span class=royalRed>\xb2de</span>ler, <span class=royalRed>\xb2del</span>te, (har) <span class=dodgerBlue>\xb9delt</span></p> <p>(\xe5) <span class=royalRed>\xb2byg</span>ge, <span class=royalRed>\xb2byg</span>ger, <span class=royalRed>\xb2byg</span>de, (har) <span class=dodgerBlue>\xb9bygd</span></p>(\xe5) <span class=dodgerBlue>\xb9bo</span>, <span class=dodgerBlue>\xb9bor</span>, <span class=royalRed>\xb2bod</span>de, (har) <span class=dodgerBlue>\xb9bodd</span></div></div>",A:"X"},{DECK_ID:"C01",ID:"C01009",N:"<div class=\"center\">Press here to listen to the two words <br>and identify the two pitch accents</div>",E:"<div class=\"center\"><span class=dodgerBlue>\xb9hjem</span>met&emsp;&emsp;&emsp;the home<br><br><span class=royalRed>\xb2hjem</span>me&emsp;&emsp;&emsp;at home</div>",D:"ADVANCED PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\"><p>The first word has the more straightforward <span class=dodgerBlue>tone 1</span> (because it's originally a one-syllable word to which the definite ending -(M)ET has been added), the second has the \"updown\u2013up\" <span class=royalRed>tone 2</span> (because of the two-syllable with -E ending rule).</p> <p>A general note: the dialects of eastern Norway are called \"low-tone dialects\", whilst the other ones (west coast and north) are called \"high-tone dialects\" and have different pitch variations for the two tones.</p> However, even within these two groups there can be further minor variations.</div></div>",A:"N"},{DECK_ID:"C01",ID:"C01010",N:"<div class=\"center\">What are the tone rules for <br>strong verbs?</div>",E:"<div class=\"center\"><div class=\"left\">Strong verbs will tend to have <span class=royalRed>tone 2</span> for their infinitives and past participles (the latter if they have two syllables), and <span class=dodgerBlue>tone 1</span> for present and simple past.</div></div>",D:"ADVANCED PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\"><p>(\xe5) <span class=royalRed>\xb2skri</span>ve, <span class=dodgerBlue>\xb9skri</span>ver, <span class=dodgerBlue>\xb9skrev</span>, (har) <span class=royalRed>\xb2skre</span>vet</p> <p>(\xe5) <span class=royalRed>\xb2fin</span>ne, <span class=dodgerBlue>\xb9fin</span>ner, <span class=dodgerBlue>\xb9fant</span>, (har) <span class=royalRed>\xb2fun</span>net</p></div></div>",A:"X"},{DECK_ID:"C01",ID:"C01011",N:"<div class=\"center\">What are the tone rules for <br>monosyllabic nouns?</span></div>",E:"<div class=\"center\"><div class=\"left\"><p>Monosyllabic <span class=\"italic\">hankj\xf8nn</span> and <span class=\"italic\">hunkj\xf8nn</span> nouns tend to have <span class=royalRed>tone 2</span> for their plural forms in -ER and -ENE.</p> Their singular forms, as well as all the forms of monosyllabic <span class=\"italic\">intetkj\xf8nn</span> nouns have <span class=dodgerBlue>tone 1</span>, unless bisyllabic and ending in -E.</div></div>",D:"ADVANCED PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\"><p>(en) <span class=dodgerBlue>\xb9del</span>, <span class=dodgerBlue>\xb9de</span>len, <span class=royalRed>\xb2de</span>ler, <span class=royalRed>\xb2de</span>lene</p> <p>(ei) <span class=dodgerBlue>\xb9sol</span>, <span class=dodgerBlue>\xb9so</span>la, <span class=royalRed>\xb2so</span>ler, <span class=royalRed>\xb2so</span>lene</p> <p>(et) <span class=dodgerBlue>\xb9tog</span>, <span class=dodgerBlue>\xb9to</span>get, <span class=dodgerBlue>\xb9tog</span>, <span class=dodgerBlue>\xb9to</span>gene</p> Nouns of two syllables (e.g. <span class=\"italic\">en m\xe5ned</span>, <span class=\"italic\">ei hustru</span>, <span class=\"italic\">et bilde</span>) have <span class=royalRed>tone 2</span> on all forms.</div></div>",A:"X"},{DECK_ID:"C01",ID:"C01012",N:"<div class=\"center\">Press here to listen to the two words <br>and identify the two pitch accents</div>",E:"<div class=\"center\"><span class=royalRed>\xb2hjem</span>me&emsp;&emsp;&emsp;at home<br><br><span class=dodgerBlue>\xb9hjem</span>met&emsp;&emsp;&emsp;the home</div>",D:"ADVANCED PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">The first word has the \"updown\u2013up\" <span class=royalRed>tone 2</span> because of the two-syllable with -E ending rule, the second has the more straightforward <span class=dodgerBlue>tone 1</span> because it's originally a one-syllable word to which the definite ending -(M)ET has been added.</div></div>",A:"N"},{DECK_ID:"C01",ID:"C01013",N:"<div class=\"center\">Read out the following word:<br><span class=\"lg\">min</span></div>",E:"<div class=\"center\"><div class=\"arialFont supWrap\">[&ensp; <div class=\"sup\">1</div>m&#618;n&#720; ], [ m&#618;n ]</div></div>",D:"ADVANCED PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">When <span class=\"italic\">min</span> is stressed in a sentence (first sound and transcription on the left), it has \"tone\" and can have a long  N.</div></div>",A:"E"},{DECK_ID:"C01",ID:"C01014",N:"<div class=\"center\">What are the tone rules for adjectives?</div>",E:"<div class=\"center\"><div class=\"left\"><p>Adjectives have mostly <span class=royalRed>tone 2</span> in their plural/definite, comparative, and definite superlative forms.</p> The other forms have <span class=dodgerBlue>tone 1</span>.</div></div>",D:"ADVANCED PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\"><p><span class=dodgerBlue>\xb9full</span>, <span class=dodgerBlue>\xb9fullt</span>, <span class=royalRed>\xb2ful</span>le<br><span class=royalRed>\xb2ful</span>lere, <span class=dodgerBlue>\xb9ful</span>lest, <span class=royalRed>\xb2ful</span>leste</p> Remember: 2-syllable comparatives that are irregular or have a vowel change (<span class=dodgerBlue>\xb9be</span>dre, <span class=dodgerBlue>\xb9fle</span>re, <span class=dodgerBlue>\xb9el</span>dre, <span class=dodgerBlue>\xb9yng</span>re, <span class=dodgerBlue>\xb9st\xf8r</span>re etc) are an exception to the main rule and take <span class=dodgerBlue>tone 1</span>.</div></div>",A:"X"},{DECK_ID:"C01",ID:"C01015",N:"<div class=\"center\">Read out the following word:<br><span class=\"lg\">tusen</span></div>",E:"<div class=\"center\"><div class=\"arialFont supWrap\">[&ensp; <div class=\"sup\">1</div>t<div class=\"sup\">h</div>&#649;&#720;sn&#809; ]</div></div>",D:"ADVANCED PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">The E is basically skipped and the final N is syllabic (which is marked by the vertical line below the letter itself).</div></div>",A:"E"},{DECK_ID:"C01",ID:"C01016",N:"<div class=\"center\">Read out the following name:<br><span class=\"lg\">Jostein</span></div>",E:"<div class=\"center\"><div class=\"arialFont supWrap\">[&ensp; <div class=\"sup\">2</div>j&#650;st&#230;<div class=\"sup\">&#618;</div>n ]</div></div>",D:"ADVANCED PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">The O has the seconday sound of a short O.</div></div>",A:"E"},{DECK_ID:"C01",ID:"C01017",N:"<div class=\"center\">What are the tone rules for <br>adjectives ending in -IG?</div>",E:"<div class=\"center\"><div class=\"left\">Two-syllable adjectives ending in -IG take <span class=royalRed>tone 2</span> in their first two forms too.</div></div>",D:"ADVANCED PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\"><p><span class=royalRed>\xb2vik</span>tig, <span class=royalRed>\xb2vik</span>tig, <span class=royalRed>\xb2vik</span>tige, <br><span class=royalRed>\xb2vik</span>tigere, <span class=dodgerBlue>\xb9vik</span>tigst, <span class=royalRed>\xb2vik</span>tigste</p> <p><span class=royalRed>\xb2van</span>lig, <span class=royalRed>\xb2van</span>lig, <span class=royalRed>\xb2van</span>lige, <br><span class=royalRed>\xb2van</span>ligere, <span class=dodgerBlue>\xb9van</span>ligst, <span class=royalRed>\xb2van</span>ligste</p> Adjectives in -IG of more than two syllables such as \"<span class=dodgerBlue>\xb9van</span>skelig\" or \"<span class=dodgerBlue>\xb9hyg</span>gelig\" work as standard adjectives, and so does \"for<span class=dodgerBlue>\xb9skjel</span>lig\" (because it starts with a preposition).</div></div>",A:"X"},{DECK_ID:"C01",ID:"C01018",N:"<div class=\"center\">Press here to listen to the two words <br>and identify the two pitch accents</div>",E:"<div class=\"center\"><span class=dodgerBlue>\xb9gra</span>ver&emsp;&emsp;&emsp;(I) dig<br><br><span class=royalRed>\xb2gra</span>ver&emsp;&emsp;&emsp;graves</div>",D:"ADVANCED PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">The first word has the more straightforward <span class=dodgerBlue>tone 1</span> because it's the present tense of what was originally a strong verb (in fact the <span class=\"italic\">preteritum</span> can be <span class=\"italic\">grov</span> as well as <span class=\"italic\">gravde</span>), the second has the \"updown\u2013up\" <span class=royalRed>tone 2</span> because it's a plural noun.</div></div>",A:"N"},{DECK_ID:"C01",ID:"C01019",N:"<div class=\"center\">What are the tone rules for <br>adjectives ending in -ISK?</div>",E:"<div class=\"center\"><div class=\"left\"><p>The stressed syllable is the second to last, and the tone is 1.</p> <p>So if they have two syllables, it\u2019s <span class=dodgerBlue>tone 1</span> on the first, if they have three it\u2019s <span class=dodgerBlue>tone 1</span> on the second.</p> See the examples below:</div></div>",D:"ADVANCED PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\"><p><span class=dodgerBlue>\xb9fak</span>tisk, <span class=dodgerBlue>\xb9fak</span>tisk, <span class=dodgerBlue>\xb9fak</span>tiske</p> <p>his<span class=dodgerBlue>\xb9tor</span>isk, his<span class=dodgerBlue>\xb9tor</span>isk, his<span class=dodgerBlue>\xb9tor</span>iske</p> <p>skandi<span class=dodgerBlue>\xb9na</span>visk, skandi<span class=dodgerBlue>\xb9na</span>visk, skandi<span class=dodgerBlue>\xb9na</span>viske</p> Remember that these adjectives don\u2019t take -T for <span class=\"italic\">intetkj\xf8nn</span> (because they are not monosyllabic and might refer to nationalities, unlike <span class=\"italic\">frisk</span>) and create the comparative and superlative with <span class=\"italic\">mer</span> and <span class=\"italic\">mest</span>.</div></div>",A:"X"},{DECK_ID:"C01",ID:"C01020",N:"<div class=\"center\">Press here to listen to the two words <br>and identify the two pitch accents</div>",E:"<div class=\"center\"><span class=royalRed>\xb2gra</span>ver&emsp;&emsp;&emsp;graves<br><br><span class=dodgerBlue>\xb9gra</span>ver&emsp;&emsp;&emsp;(I) dig</div>",D:"ADVANCED PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">The first word has the \"updown\u2013up\" <span class=royalRed>tone 2</span> because it's a plural noun, the second has the more straightforward <span class=dodgerBlue>tone 1</span> because it's the present tense of what was originally a strong verb (in fact the <span class=\"italic\">preteritum</span> can be <span class=\"italic\">grov</span> as well as <span class=\"italic\">gravde</span>).</div></div>",A:"N"},{DECK_ID:"C01",ID:"C01021",N:"<div class=\"center\">What are the tone rules for <br>the so called \"prepositional verbs\"?</div>",E:"<div class=\"center\"><div class=\"left\">They mostly take <span class=dodgerBlue>tone 1</span> on their stressed syllable, although the ones whose preposition is <span class=\"italic\">fore-</span> and <span class=\"italic\">over-</span> take <span class=royalRed>tone 2</span>.</div></div>",D:"ADVANCED PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\"> <p>(\xe5) be<span class=dodgerBlue>\xb9vi</span>se, be<span class=dodgerBlue>\xb9vi</span>ser, be<span class=dodgerBlue>\xb9vis</span>te, (har) be<span class=dodgerBlue>\xb9vist</span></p>but</p><p>(\xe5) <span class=royalRed>\xb2fo</span>reg\xe5, <span class=royalRed>\xb2fo</span>reg\xe5r, <span class=royalRed>\xb2fo</span>regikk, (har) <span class=royalRed>\xb2fo</span>reg\xe5tt</p> (\xe5) <span class=royalRed>\xb2o</span>verta, <span class=royalRed>\xb2o</span>vertar, <span class=royalRed>\xb2o</span>vertok, (har) <span class=royalRed>\xb2o</span>vertatt</div></div>",A:"X"},{DECK_ID:"C01",ID:"C01022",N:"<div class=\"center\">Read out the following name:<br><span class=\"lg\">Ragnhild</span></div>",E:"<div class=\"center\"><div class=\"arialFont supWrap\">[&ensp; <div class=\"sup\">2</div>&#638;&#593;&#331;&#720;nh&#618;l&#720; ]</div></div>",D:"ADVANCED PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">The G of the GN cluster acquires the velar sound, and the final D is silent.</div></div>",A:"E"},{DECK_ID:"C01",ID:"C01023",N:"<div class=\"center\">Read out the following word:<br><span class=\"lg\">olje</span></div>",E:"<div class=\"center\"><div class=\"arialFont supWrap\">[&ensp; <div class=\"sup\">2</div>&#596;&#619;&#720;j&#601; ]</div></div>",D:"ADVANCED PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">The L can be pronounced with a long sound, which might surprise some learners, since it is followed by a J.</div></div>",A:"E"},{DECK_ID:"C01",ID:"C01024",N:"<div class=\"center\">Read out the following name:<br><span class=\"lg\">Trond</span></div>",E:"<div class=\"center\"><div class=\"arialFont supWrap\">[&ensp; <div class=\"sup\">1</div>t<div class=\"sup\">h</div>&#638;&#650;n&#720; ]</div></div>",D:"ADVANCED PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">The O has the seconday sound of a short O, and the final D is silent.</div></div>",A:"E"},{DECK_ID:"C01",ID:"C01025",N:"<div class=\"center\">Press here to listen to the two words <br>and identify the two pitch accents</div>",E:"<div class=\"center\"><span class=dodgerBlue>\xb9gra</span>ver&emsp;&emsp;&emsp;(I) dig<br><br><span class=royalRed>\xb2gra</span>ver&emsp;&emsp;&emsp;graves</div>",D:"ADVANCED PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">The first word has the more straightforward <span class=dodgerBlue>tone 1</span> because it's the present tense of what was originally a strong verb (in fact the <span class=\"italic\">preteritum</span> can be <span class=\"italic\">grov</span> as well as <span class=\"italic\">gravde</span>), the second has the \"updown\u2013up\" <span class=royalRed>tone 2</span> because it's a plural noun.</div></div>",A:"N"},{DECK_ID:"C01",ID:"C01026",N:"<div class=\"center\">Press here to listen to the two words <br>and identify the two pitch accents</div>",E:"<div class=\"center\"><span class=royalRed>\xb2b\xf8</span>ker&emsp;&emsp;&emsp;beeches<br><br><span class=dodgerBlue>\xb9b\xf8</span>ker&emsp;&emsp;&emsp;books</div>",D:"ADVANCED PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">The first word has the \"updown\u2013up\" <span class=royalRed>tone 2</span>, the second has the more straightforward <span class=dodgerBlue>tone 1</span>.</div></div>",A:"N"},{DECK_ID:"C01",ID:"C01027",N:"<div class=\"center\">Read out the following word:<br><span class=\"lg\">annet</span></div>",E:"<div class=\"center\"><div class=\"arialFont supWrap\">[&ensp; <div class=\"sup\">2</div>&#593;&#720;&#593;nt ]</div></div>",D:"ADVANCED PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">Similarly to <span class=\"italic\">annen</span>, the pronunciation of <span class=\"italic\">annet</span> can be a very long A, followed by NT.</div></div>",A:"E"},{DECK_ID:"C01",ID:"C01028",N:"<div class=\"center\">Press here to listen to the two words <br>and identify the two pitch accents</div>",E:"<div class=\"center\"><span class=royalRed>\xb2b\xf8</span>ker&emsp;&emsp;&emsp;beeches<br><br><span class=dodgerBlue>\xb9b\xf8</span>ker&emsp;&emsp;&emsp;books</div>",D:"ADVANCED PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">The first word has the \"updown\u2013up\" <span class=royalRed>tone 2</span>, the second has the more straightforward <span class=dodgerBlue>tone 1</span>.</div></div>",A:"N"},{DECK_ID:"C01",ID:"C01029",N:"<div class=\"center\">Read out the following word:<br><span class=\"lg\">grunn</span></div>",E:"<div class=\"center\"><div class=\"arialFont supWrap\">[&ensp; <div class=\"sup\">1</div>g<div class=\"sup\">j</div>&#638;&#649;n&#720; ]</div></div>",D:"ADVANCED PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">Note the soft G with the superscript J</div></div>",A:"E"},{DECK_ID:"C01",ID:"C01030",N:"<div class=\"center\">Press here to listen to the two words <br>and identify the two pitch accents</div>",E:"<div class=\"center\"><span class=dodgerBlue>\xb9b\xf8</span>ker&emsp;&emsp;&emsp;books<br><br><span class=royalRed>\xb2b\xf8</span>ker&emsp;&emsp;&emsp;beeches</div>",D:"ADVANCED PRONUNCIATION",X:"<div class=\"center\"><div class=\"left\">The first word has the more straightforward <span class=dodgerBlue>tone 1</span>, the second has the \"updown\u2013up\" <span class=royalRed>tone 2</span>.</div></div>",A:"N"},{DECK_ID:"C03",ID:"C03001",N:"<div class=\"center\">Provide the main tenses of<br><br><span class=\"italic\">\xe5 la</span><br><br>(include the imperative)</div>",E:"<div class=\"center\">lar<br>lot<br>har latt<br>la!</div>",D:"L-VERBS",X:"<div class=\"center\"><div class=\"left\"><p>to let, to allow: <br><span class=\"italic\">de lot fangen g\xe5</span></p><p>to let (cohortative): <br><span class=\"italic\">la oss begynne!</span></p><p>to stop, to let go (with <span class=\"italic\">v\xe6re</span>): <br><span class=\"italic\">jeg kunne ikke la v\xe6re \xe5 le</span></p></div></div>",A:"E"},{DECK_ID:"C03",ID:"C03002",N:"<div class=\"center\">Provide the main tenses of<br><br><span class=\"italic\">\xe5 late</span><br><br>(include the imperative)</div>",E:"<div class=\"center\">later<br>lot<br>har latt<br>lat!</div>",D:"L-VERBS",X:"<div class=\"center\"><div class=\"left\"><p>to pretend: <br><span class=\"italic\">lat som om du kjenner ham!</span></p><p>to seem (like): <br><span class=\"italic\">han later til \xe5 v\xe6re flink</span></p><p>to leave/abandon: <br><span class=\"italic\">han lot etter seg en stor formue</span></p></div></div>",A:"E"},{DECK_ID:"C03",ID:"C03003",N:"<div class=\"center\">Provide the main tenses of<br><br><span class=\"italic\">\xe5 ligge</span><br><br>(include the imperative)</div>",E:"<div class=\"center\">ligger<br>l\xe5<br>har ligget<br>ligg!</div>",D:"L-VERBS",X:"<div class=\"center\"><div class=\"left\"><p>to lie (down) <br>[intransitive]: <br><span class=\"italic\">boka ligger p\xe5 bordet</span></p><p>to be, to be found: <br><span class=\"italic\">Stavanger ligger i vest</span></p></div></div>",A:"E"},{DECK_ID:"C03",ID:"C03004",N:"<div class=\"center\">Provide the main tenses of<br><br><span class=\"italic\">\xe5 legge</span><br><br>(include the imperative)</div>",E:"<div class=\"center\">legger<br>la<br>har lagt<br>legg!</div>",D:"L-VERBS",X:"<div class=\"center\"><div class=\"left\"><p>to lay <br>[transitive]: <br><span class=\"italic\">jeg har lagt dukken p\xe5 bordet</span></p><p>to go to bed: <br><span class=\"italic\">jeg legger meg</span></p></div></div>",A:"E"},{DECK_ID:"C03",ID:"C03005",N:"<div class=\"center\">Provide the main tenses of<br><br><span class=\"italic\">\xe5 le</span><br><br>(include the imperative)</div>",E:"<div class=\"center\">ler<br>lo<br>har ledd<br>le!</div>",D:"L-VERBS",X:"<div class=\"center\"><div class=\"left\"><p>to laugh: <br><span class=\"italic\">Dette m\xe5 ikke bli noe man ler av</span></p></div></div>",A:"E"},{DECK_ID:"C03",ID:"C03006",N:"<div class=\"center\">Provide the main tenses of<br><br><span class=\"italic\">\xe5 lage</span><br><br>(include the imperative)</div>",E:"<div class=\"center\">lager<br>laget<br>har laget<br>lag!</div>",D:"L-VERBS",X:"<div class=\"center\"><div class=\"left\"><p>to create, to prepare: <br><span class=\"italic\">hun laget dette mesterverket</span></p><p>to cook, to prepare food: <br><span class=\"italic\">det var jeg som laget kaken</span></p><p>to turn out, to go: <br><span class=\"italic\">det lager seg bra for dem</span></p></div></div>",A:"E"},{DECK_ID:"C03",ID:"C03007",N:"<div class=\"center\">Provide the main tenses of<br><br><span class=\"italic\">\xe5 lyve</span><br><br>(include the imperative)</div>",E:"<div class=\"center\">lyver<br>l\xf8y<br>har l\xf8yet<br>lyv!</div>",D:"L-VERBS",X:"<div class=\"center\"><div class=\"left\"><p>to tell a lie: <br><span class=\"italic\">ikke lyv for meg!</span></p><p>to lie about oneself: <br><span class=\"italic\">han l\xf8y p\xe5 seg en MBA</span></p><p>alternative spellings: <br><span class=\"italic\">\xe5 juge, \xe5 ljuge, \xe5 lyge</span></p></div></div>",A:"E"},{DECK_ID:"C03",ID:"C03008",N:"<div class=\"center\"><div class=\"left\">Provide the main tenses (including the imperative) of the Norwegian for:</div><br>to let, to allow</div>",E:"<div class=\"center\">\xe5 la<br>lar<br>lot<br>har latt<br>la!</div>",D:"L-VERBS",X:"<div class=\"center\">De lot fangen g\xe5</div>",A:"E"},{DECK_ID:"C03",ID:"C03009",N:"<div class=\"center\"><div class=\"left\">Provide the main tenses (including the imperative) of the Norwegian for:</div><br>to let (cohortative)</div>",E:"<div class=\"center\">\xe5 la<br>lar<br>lot<br>har latt<br>la!</div>",D:"L-VERBS",X:"<div class=\"center\">La oss begynne!</div>",A:"E"},{DECK_ID:"C03",ID:"C03010",N:"<div class=\"center\"><div class=\"left\">Provide the main tenses (including the imperative) of the Norwegian for:</div><br>to stop, to let go</div>",E:"<div class=\"center\">\xe5 la v\xe6re<br>lar<br>lot<br>har latt<br>la!</div>",D:"L-VERBS",X:"<div class=\"center\">Jeg kunne ikke la v\xe6re \xe5 le</div>",A:"E"},{DECK_ID:"C03",ID:"C03011",N:"<div class=\"center\"><div class=\"left\">Provide the main tenses (including the imperative) of the Norwegian for:</div><br>to pretend (as if)</div>",E:"<div class=\"center\">\xe5 late (som om)<br>later<br>lot<br>har latt<br>lat!</div>",D:"L-VERBS",X:"<div class=\"center\">Lat som om du kjenner ham!</div>",A:"E"},{DECK_ID:"C03",ID:"C03012",N:"<div class=\"center\"><div class=\"left\">Provide the main tenses (including the imperative) of the Norwegian for:</div><br>to seem (like)</div>",E:"<div class=\"center\">\xe5 late til<br>later<br>lot<br>har latt<br>lat!</div>",D:"L-VERBS",X:"<div class=\"center\">Han later til \xe5 v\xe6re flink</div>",A:"E"},{DECK_ID:"C03",ID:"C03013",N:"<div class=\"center\"><div class=\"left\">Provide the main tenses (including the imperative) of the Norwegian for:</div><br>to leave/abandon</div>",E:"<div class=\"center\">\xe5 late etter<br>later<br>lot<br>har latt<br>lat!</div>",D:"L-VERBS",X:"<div class=\"center\">Han lot etter seg en stor formue</div>",A:"E"},{DECK_ID:"C03",ID:"C03014",N:"<div class=\"center\"><div class=\"left\">Provide the main tenses (including the imperative) of the Norwegian for:</div><br>to lie (down) <br>[intransitive]</div>",E:"<div class=\"center\">\xe5 ligge<br>ligger<br>l\xe5<br>har ligget<br>ligg!</div>",D:"L-VERBS",X:"<div class=\"center\">Boka ligger p\xe5 bordet</div>",A:"E"},{DECK_ID:"C03",ID:"C03015",N:"<div class=\"center\"><div class=\"left\">Provide the main tenses (including the imperative) of the Norwegian for:</div><br>to be, to be found</div>",E:"<div class=\"center\">\xe5 ligge<br>ligger<br>l\xe5<br>har ligget<br>ligg!</div>",D:"L-VERBS",X:"<div class=\"center\">Stavanger ligger i vest</div>",A:"E"},{DECK_ID:"C03",ID:"C03016",N:"<div class=\"center\"><div class=\"left\">Provide the main tenses (including the imperative) of the Norwegian for:</div><br>to lay <br>[transitive]</div>",E:"<div class=\"center\">\xe5 legge<br>legger<br>la<br>har lagt<br>legg!</div>",D:"L-VERBS",X:"<div class=\"center\">Jeg har lagt dukken p\xe5 bordet</div>",A:"E"},{DECK_ID:"C03",ID:"C03017",N:"<div class=\"center\"><div class=\"left\">Provide the main tenses (including the imperative) of the Norwegian for:</div><br>to go to bed</div>",E:"<div class=\"center\">\xe5 legge seg<br>legger<br>la<br>har lagt<br>legg!</div>",D:"L-VERBS",X:"<div class=\"center\">Jeg legger meg</div>",A:"E"},{DECK_ID:"C03",ID:"C03018",N:"<div class=\"center\"><div class=\"left\">Provide the main tenses (including the imperative) of the Norwegian for:</div><br>to laugh</div>",E:"<div class=\"center\">\xe5 le<br>ler<br>lo<br>har ledd<br>le!</div>",D:"L-VERBS",X:"<div class=\"center\">Dette m\xe5 ikke bli et land man ler av</div>",A:"E"},{DECK_ID:"C03",ID:"C03019",N:"<div class=\"center\"><div class=\"left\">Provide the main tenses (including the imperative) of the Norwegian for:</div><br>to create, to prepare</div>",E:"<div class=\"center\">\xe5 lage<br>lager<br>laget<br>har laget<br>lag!</div>",D:"L-VERBS",X:"<div class=\"center\">Hun laget dette mesterverket</div>",A:"E"},{DECK_ID:"C03",ID:"C03020",N:"<div class=\"center\"><div class=\"left\">Provide the main tenses (including the imperative) of the Norwegian for:</div><br>to cook, to prepare food</div>",E:"<div class=\"center\">\xe5 lage<br>lager<br>laget<br>har laget<br>lag!</div>",D:"L-VERBS",X:"<div class=\"center\">Det var jeg som laget kaken</div>",A:"E"},{DECK_ID:"C03",ID:"C03021",N:"<div class=\"center\"><div class=\"left\">Provide the main tenses (including the imperative) of the Norwegian for:</div><br>to turn out, to go</div>",E:"<div class=\"center\">\xe5 lage seg<br>lager<br>laget<br>har laget<br>lag!</div>",D:"L-VERBS",X:"<div class=\"center\">Det lager seg bra for dem</div>",A:"E"},{DECK_ID:"C03",ID:"C03022",N:"<div class=\"center\"><div class=\"left\">Provide the main tenses (including the imperative) of the Norwegian for:</div><br>to (tell a) lie</div>",E:"<div class=\"center\">\xe5 lyve<br>lyver<br>l\xf8y<br>har l\xf8yet<br>lyv!</div>",D:"L-VERBS",X:"<div class=\"center\">Ikke lyv for meg!</div>",A:"E"},{DECK_ID:"C03",ID:"C03023",N:"<div class=\"center\"><div class=\"left\">Provide the main tenses (including the imperative) of the Norwegian for:</div><br>to lie about oneself</div>",E:"<div class=\"center\">\xe5 lyve p\xe5 seg<br>lyver<br>l\xf8y<br>har l\xf8yet<br>lyv!</div>",D:"L-VERBS",X:"<div class=\"center\">Han l\xf8y p\xe5 seg en MBA</div>",A:"E"},{DECK_ID:"C03",ID:"C03024",N:"<div class=\"center\">Identify the verb and the tense:<br><br><span class=\"italic\">lot</span></div>",E:"<div class=\"center\">It is the <span class=\"italic\">preteritum</span> of <span class=\"italic\">\xe5 la</span> and <span class=\"italic\">\xe5 late</span></div>",D:"L-VERBS",X:"",A:"N"},{DECK_ID:"C03",ID:"C03025",N:"<div class=\"center\">Identify the verb and the tense:<br><br><span class=\"italic\">har latt</span></div>",E:"<div class=\"center\"><div class=\"left\">It is the <span class=\"italic\">presens perfektum</span> of <span class=\"italic\">\xe5 la</span> and <span class=\"italic\">\xe5 late</span></div></div>",D:"L-VERBS",X:"",A:"N"},{DECK_ID:"C03",ID:"C03026",N:"<div class=\"center\">Identify the verb and the tense:<br><br><span class=\"italic\">lar</span></div>",E:"<div class=\"center\">It is the <span class=\"italic\">presens</span> of <span class=\"italic\">\xe5 la</span></div>",D:"L-VERBS",X:"",A:"N"},{DECK_ID:"C03",ID:"C03027",N:"<div class=\"center\">Identify the verb and the tense:<br><br><span class=\"italic\">later</span></div>",E:"<div class=\"center\">It is the <span class=\"italic\">presens</span> of <span class=\"italic\">\xe5 late</span></div>",D:"L-VERBS",X:"",A:"N"},{DECK_ID:"C03",ID:"C03028",N:"<div class=\"center\">Identify the verb and the tense:<br><br><span class=\"italic\">l\xe5</span></div>",E:"<div class=\"center\">It is the <span class=\"italic\">preteritum</span> of <span class=\"italic\">\xe5 ligge</span></div>",D:"L-VERBS",X:"",A:"N"},{DECK_ID:"C03",ID:"C03029",N:"<div class=\"center\">Identify the verb and the tense:<br><br><span class=\"italic\">har ligget</span></div>",E:"<div class=\"center\">It is the <span class=\"italic\">presens perfektum</span> of <span class=\"italic\">\xe5 ligge</span></div>",D:"L-VERBS",X:"",A:"N"},{DECK_ID:"C03",ID:"C03030",N:"<div class=\"center\">Identify the verb and the tense:<br><br><span class=\"italic\">la</span></div>",E:"<div class=\"center\"><div class=\"left\">It is the <span class=\"italic\">preteritum</span> of <span class=\"italic\">\xe5 legge</span> and <span class=\"italic\">imperativ</span> of <span class=\"italic\">\xe5 la</span></div></div>",D:"L-VERBS",X:"",A:"N"},{DECK_ID:"C03",ID:"C03031",N:"<div class=\"center\">Identify the verb and the tense:<br><br><span class=\"italic\">har lagt</span></div>",E:"<div class=\"center\">It is the <span class=\"italic\">presens perfektum</span> of <span class=\"italic\">\xe5 legge</span></div>",D:"L-VERBS",X:"",A:"N"},{DECK_ID:"C03",ID:"C03032",N:"<div class=\"center\">Identify the verb and the tense:<br><br><span class=\"italic\">lo</span></div>",E:"<div class=\"center\">It is the <span class=\"italic\">preteritum</span> of <span class=\"italic\">\xe5 le</span></div>",D:"L-VERBS",X:"",A:"N"},{DECK_ID:"C03",ID:"C03033",N:"<div class=\"center\">Identify the verb and the tense:<br><br><span class=\"italic\">har ledd</span></div>",E:"<div class=\"center\">It is the <span class=\"italic\">presens perfektum</span> of <span class=\"italic\">\xe5 le</span></div>",D:"L-VERBS",X:"",A:"N"},{DECK_ID:"C03",ID:"C03034",N:"<div class=\"center\">Identify the verb and the tense:<br><br><span class=\"italic\">l\xf8y</span></div>",E:"<div class=\"center\">It is the <span class=\"italic\">preteritum</span> of <span class=\"italic\">\xe5 lyve</span></div>",D:"L-VERBS",X:"",A:"N"},{DECK_ID:"C03",ID:"C03035",N:"<div class=\"center\">Identify the verb and the tense:<br><br><span class=\"italic\">har l\xf8yet</span></div>",E:"<div class=\"center\">It is the <span class=\"italic\">presens perfektum</span> of <span class=\"italic\">\xe5 lyve</span></div>",D:"L-VERBS",X:"",A:"N"},{DECK_ID:"C03",ID:"C03036",N:"<div class=\"center\">Identify the verb and the tense:<br><br><span class=\"italic\">laget</span></div>",E:"<div class=\"center\"><div class=\"left\">It is the <span class=\"italic\">preteritum</span> and <span class=\"italic\">perfektum partisipp</span> of <span class=\"italic\">\xe5 lage</span></div></div>",D:"L-VERBS",X:"",A:"N"},{DECK_ID:"C03",ID:"C03037",N:"<div class=\"center\">What is the <span class=\"italic\">preteritum</span> of <br><span class=\"italic\">\xe5 la</span> and <span class=\"italic\">\xe5 late</span> ?</div>",E:"<div class=\"center\">lot</div>",D:"L-VERBS",X:"",A:"E"},{DECK_ID:"C03",ID:"C03038",N:"<div class=\"center\">What is the <span class=\"italic\">presens perfektum</span> of <br><span class=\"italic\">\xe5 la</span> and <span class=\"italic\">\xe5 late</span> ?</div>",E:"<div class=\"center\">har latt</div>",D:"L-VERBS",X:"",A:"E"},{DECK_ID:"C03",ID:"C03039",N:"<div class=\"center\">What is the <span class=\"italic\">presens</span> of <br><span class=\"italic\">\xe5 la</span> ?</div>",E:"<div class=\"center\">lar</div>",D:"L-VERBS",X:"",A:"E"},{DECK_ID:"C03",ID:"C03040",N:"<div class=\"center\">What is the <span class=\"italic\">presens</span> of <br><span class=\"italic\">\xe5 late</span> ?</div>",E:"<div class=\"center\">later</div>",D:"L-VERBS",X:"",A:"E"},{DECK_ID:"C03",ID:"C03041",N:"<div class=\"center\">What is the <span class=\"italic\">preteritum</span> of <br><span class=\"italic\">\xe5 ligge</span> ?</div>",E:"<div class=\"center\">l\xe5</div>",D:"L-VERBS",X:"",A:"E"},{DECK_ID:"C03",ID:"C03042",N:"<div class=\"center\">What is the <span class=\"italic\">presens perfektum</span> of <br><span class=\"italic\">\xe5 ligge</span> ?</div>",E:"<div class=\"center\">har ligget</div>",D:"L-VERBS",X:"",A:"E"},{DECK_ID:"C03",ID:"C03043",N:"<div class=\"center\">What is the <span class=\"italic\">preteritum</span> of <br><span class=\"italic\">\xe5 legge</span> ?</div>",E:"<div class=\"center\">la</div>",D:"L-VERBS",X:"",A:"E"},{DECK_ID:"C03",ID:"C03044",N:"<div class=\"center\">What is the <span class=\"italic\">presens perfektum</span> of <br><span class=\"italic\">\xe5 legge</span> ?</div>",E:"<div class=\"center\">har lagt</div>",D:"L-VERBS",X:"<div class=\"center\"><div class=\"left\">Remember that the <b class=\"bold\">G</b> in <span class=\"italic\">lagt</span> is pronounced like a (soft) <b class=\"bold\">K</b>.</div></div>",A:"E"},{DECK_ID:"C03",ID:"C03045",N:"<div class=\"center\">What is the <span class=\"italic\">preteritum</span> of <br><span class=\"italic\">\xe5 le</span> ?</div>",E:"<div class=\"center\">lo</div>",D:"L-VERBS",X:"",A:"E"},{DECK_ID:"C03",ID:"C03046",N:"<div class=\"center\">What is the <span class=\"italic\">presens perfektum</span> of <br><span class=\"italic\">\xe5 le</span> ?</div>",E:"<div class=\"center\">har ledd</div>",D:"L-VERBS",X:"",A:"E"},{DECK_ID:"C03",ID:"C03047",N:"<div class=\"center\">What is the <span class=\"italic\">preteritum</span> of <br><span class=\"italic\">\xe5 lyve</span> ?</div>",E:"<div class=\"center\">l\xf8y</div>",D:"L-VERBS",X:"",A:"E"},{DECK_ID:"C03",ID:"C03048",N:"<div class=\"center\">What is the <span class=\"italic\">presens perfektum</span> of <br><span class=\"italic\">\xe5 lyve</span> ?</div>",E:"<div class=\"center\">har l\xf8yet</div>",D:"L-VERBS",X:"",A:"E"},{DECK_ID:"C03",ID:"C03049",N:"<div class=\"center\">What is the <span class=\"italic\">preteritum</span> and <span class=\"italic\">presens perfektum</span> of <br><span class=\"italic\">\xe5 lage</span> ?</div>",E:"<div class=\"center\">har laget</div>",D:"L-VERBS",X:"",A:"E"},{DECK_ID:"C03",ID:"C03050",N:"<div class=\"center\">What is the <span class=\"italic\">imperativ</span> of <br><span class=\"italic\">\xe5 late</span> ?</div>",E:"<div class=\"center\">lat!</div>",D:"L-VERBS",X:"",A:"E"},{DECK_ID:"C10",ID:"C10001",N:"<div class=\"center\">en beskjed<br><br>beskjeden, beskjeder, beskjedene</div>",E:"<div class=\"center\">a message</div>",D:"PREPOSITIONAL NOUNS",X:"<div class=\"center\"><div class=\"left\">Vi m\xe5 f\xe5 eller gi beskjed om eventuelle endringer i kontaktinformasjon</div></div>",A:"N"},{DECK_ID:"C10",ID:"C10002",N:"<div class=\"center\">en oppgave<br><br>oppgaven, oppgaver, oppgavene</div>",E:"<div class=\"center\">an assignment, a task</div>",D:"PREPOSITIONAL NOUNS",X:"<div class=\"center\"><div class=\"left\">Jeg er nesten ferdig med oppgaven til kurset mitt</div></div>",A:"N"},{DECK_ID:"C10",ID:"C10003",N:"<div class=\"center\">et foredrag<br><br>foredraget, foredrag, foredragene</div>",E:"<div class=\"center\">a lecture, a talk</div>",D:"PREPOSITIONAL NOUNS",X:"<div class=\"center\"><div class=\"left\">Et foredrag om sosiale medier og digital strategi</div></div>",A:"N"},{DECK_ID:"C10",ID:"C10004",N:"<div class=\"center\">en avskjed<br><br>avskjeden, avskjeder, avskjedene</div>",E:"<div class=\"center\">a dismissal, a farewell</div>",D:"PREPOSITIONAL NOUNS",X:"<div class=\"center\"><div class=\"left\">Han fikk avskjed p\xe5 grunn av seksuell trakassering<br><br>Avkjedens time</div></div>",A:"N"},{DECK_ID:"C10",ID:"C10005",N:"<div class=\"center\">en bistand<br><br>bistanden, bistander, bistandene</div>",E:"<div class=\"center\">an aid, a support</div>",D:"PREPOSITIONAL NOUNS",X:"<div class=\"center\"><div class=\"left\">Norge er et av f\xe5 land som gir mer enn FNs bistandsm\xe5l<br><br>Det er ikke for seint for \xe5 s\xf8ke juridisk bistand</div></div>",A:"N"},{DECK_ID:"C10",ID:"C10006",N:"<div class=\"center\">en omgang<br><br>omgangen, omganger, omgangene</div>",E:"<div class=\"center\">a time, a round, <br>half-time of a sport event</div>",D:"PREPOSITIONAL NOUNS",X:"<div class=\"center\"><div class=\"left\">Laget ledet 2-0 etter f\xf8rste omgang<br><br>Han tok seg en omgang p\xe5 gulvet mens han tenkte</div></div>",A:"N"},{DECK_ID:"C10",ID:"C10007",N:"<div class=\"center\">en adgang<br><br>adgangen, adganger, adgangene</div>",E:"<div class=\"center\">an admission, an entrance</div>",D:"PREPOSITIONAL NOUNS",X:"<div class=\"center\"><div class=\"left\">Hvis du ikke har studentkort, f\xe5r du ikke adgang til universitetet<br><br>Adgang forbudt</div></div>",A:"N"},{DECK_ID:"C10",ID:"C10008",N:"<div class=\"center\">en oppf\xf8rsel<br><br>oppf\xf8rselen, oppf\xf8rsler, oppf\xf8rslene</div>",E:"<div class=\"center\">a behaviour, a conduct</div>",D:"PREPOSITIONAL NOUNS",X:"<div class=\"center\"><div class=\"left\">Han beklaget oppf\xf8rselen som fikk ham sparket som daglig leder</div></div>",A:"N"},{DECK_ID:"C10",ID:"C10009",N:"<div class=\"center\">en innsats<br><br>innsatsen, innsatser, innsatsene</div>",E:"<div class=\"center\">a contribution, an effort, a bet, a stake</div>",D:"PREPOSITIONAL NOUNS",X:"<div class=\"center\"><div class=\"left\">Takk for innsatsen du gjorde til prosjektet!<br><br>Innsatsen var p\xe5 5000 kroner</div></div>",A:"N"},{DECK_ID:"C10",ID:"C10010",N:"<div class=\"center\">et vedlegg<br><br>vedlegget, vedlegg, vedleggene</div>",E:"<div class=\"center\">an attachment</div>",D:"PREPOSITIONAL NOUNS",X:"<div class=\"center\"><div class=\"left\">Unng\xe5 \xe5 glemme vedlegg</div></div>",A:"N"},{DECK_ID:"C10",ID:"C10011",N:"<div class=\"center\">et bidrag<br><br>bidraget, bidrag, bidragene</div>",E:"<div class=\"center\">(a) support, a contribution</div>",D:"PREPOSITIONAL NOUNS",X:"<div class=\"center\"><div class=\"left\">Min far nekter \xe5 betale barnebidrag til meg<br><br>Regjeringen fremskynder bidrag til Middelhavet</div></div>",A:"N"},{DECK_ID:"C10",ID:"C10012",N:"<div class=\"center\">et fritak<br><br>fritaket, fritak, fritakene</div>",E:"<div class=\"center\">an exemption</div>",D:"PREPOSITIONAL NOUNS",X:"<div class=\"center\"><div class=\"left\">Du kan f\xe5 fritak fra eksamen hvis du har l\xe6revansker</div></div>",A:"N"},{DECK_ID:"C10",ID:"C10013",N:"<div class=\"center\">et tilskudd<br><br>tilskuddet, tilskudd, tilskuddene</div>",E:"<div class=\"center\">a grant, an addition</div>",D:"PREPOSITIONAL NOUNS",X:"<div class=\"center\"><div class=\"left\">Kommunen kan gi tilskudd til ulike form\xe5l og m\xe5lgrupper<br><br>Hun kom med et interessant tilskudd i debatten om sm\xe5 barns l\xe6ring</div></div>",A:"N"},{DECK_ID:"C10",ID:"C10014",N:"<div class=\"center\">en p\xe5stand<br><br>p\xe5standen, p\xe5stander, p\xe5standene</div>",E:"<div class=\"center\">an assertion, a claim</div>",D:"PREPOSITIONAL NOUNS",X:"<div class=\"center\"><div class=\"left\">AD benekter p\xe5standen om at selskapet hindrer det gr\xf8nne skiftet</div></div>",A:"N"},{DECK_ID:"C10",ID:"C10015",N:"<div class=\"center\">et innslag<br><br>innslaget, innslag, innslagene</div>",E:"<div class=\"center\">an insert, a perforation</div>",D:"PREPOSITIONAL NOUNS",X:"<div class=\"center\"><div class=\"left\">Jeg s\xe5 et TV2-innslag om det norske monarkiet<br><br>Et bokm\xe5l med sterke innslag av dialekt</div></div>",A:"N"},{DECK_ID:"C10",ID:"C10016",N:"<div class=\"center\">et innlegg<br><br>innlegget, innlegg, innleggene</div>",E:"<div class=\"center\">a post, a message</div>",D:"PREPOSITIONAL NOUNS",X:"<div class=\"center\"><div class=\"left\">Her er innlegget som bidro til bloggkrigen </div></div>",A:"N"},{DECK_ID:"C10",ID:"C10017",N:"<div class=\"center\">en advarsel<br><br>advarselen, advarsler, advarslene</div>",E:"<div class=\"center\">a warning, a notification</div>",D:"PREPOSITIONAL NOUNS",X:"<div class=\"center\"><div class=\"left\">En advarsel om falsk e-post</div></div>",A:"N"},{DECK_ID:"C10",ID:"C10018",N:"<div class=\"center\">en ettersp\xf8rsel<br><br>ettersp\xf8rselen, ettersp\xf8rsler, ettersp\xf8rslene</div>",E:"<div class=\"center\">a demand <br>(in the market sense)</div>",D:"PREPOSITIONAL NOUNS",X:"<div class=\"center\"><div class=\"left\">Tilbud og ettersp\xf8rsel<br><br>Ettersp\xf8rsel etter IT-utviklere er h\xf8y</div></div>",A:"N"},{DECK_ID:"C10",ID:"C10019",N:"<div class=\"center\">en bestand<br><br>bestanden, bestander, bestandene</div>",E:"<div class=\"center\">a population, (a) livestock</div>",D:"PREPOSITIONAL NOUNS",X:"<div class=\"center\"><div class=\"left\">Tunfisk i Middelhavet er en truet bestand</div></div>",A:"N"},{DECK_ID:"C10",ID:"C10020",N:"<div class=\"center\">en befatning<br><br>befatningen, befatninger, befatningene</div>",E:"<div class=\"center\">a dealing, an involvement</div>",D:"PREPOSITIONAL NOUNS",X:"<div class=\"center\"><div class=\"left\">Den tiltalte nektet enhver befatning med saken</div></div>",A:"N"},{DECK_ID:"C10",ID:"C10021",N:"<div class=\"center\">en foresp\xf8rsel<br><br>foresp\xf8rselen, foresp\xf8rsler, foresp\xf8rslene</div>",E:"<div class=\"center\">a request, a demand</div>",D:"PREPOSITIONAL NOUNS",X:"<div class=\"center\"><div class=\"left\">Hun sendte meg en venneforesp\xf8rsel p\xe5 Facebook</div></div>",A:"N"},{DECK_ID:"C10",ID:"C10022",N:"<div class=\"center\">en motgang<br><br>motgangen, motganger, motgangene</div>",E:"<div class=\"center\">a hindrance, a bad time</div>",D:"PREPOSITIONAL NOUNS",X:"<div class=\"center\"><div class=\"left\">Vi har snudd motgang til medgang<br><br>Vi m\xe5 holde sammen i medgang og motgang</div></div>",A:"N"},{DECK_ID:"C10",ID:"C10023",N:"<div class=\"center\">et avslag<br><br>avslaget, avslag, avslagene</div>",E:"<div class=\"center\">a refusal, a reduction</div>",D:"PREPOSITIONAL NOUNS",X:"<div class=\"center\"><div class=\"left\">Jeg fikk blankt avslag p\xe5 den nye s\xf8knaden<br><br>Vi ble n\xf8dt til \xe5 gi 10% avslag i prisen</div></div>",A:"N"},{DECK_ID:"C10",ID:"C10024",N:"<div class=\"center\">et fradrag<br><br>fradraget, fradrag, fradragene</div>",E:"<div class=\"center\">a (tax) deduction</div>",D:"PREPOSITIONAL NOUNS",X:"<div class=\"center\"><div class=\"left\">Folk med hjemmekontor kan f\xe5 et fradrag p\xe5 1600 kroner per \xe5r</div></div>",A:"N"},{DECK_ID:"C10",ID:"C10025",N:"<div class=\"center\">et gjensyn<br><br>gjensynet, gjensyn, gjensynene</div>",E:"<div class=\"center\">a revisitation, a reunion,<br>the act of seeing each other again</div>",D:"PREPOSITIONAL NOUNS",X:"<div class=\"center\"><div class=\"left\">P\xe5 gjensyn!<br><br>Det var et hyggelig gjensyn da vi m\xf8ttes i h\xf8st</div></div>",A:"N"},{DECK_ID:"C10",ID:"C10026",N:"<div class=\"center\">et hensyn<br><br>hensynet, hensyn, hensynene</div>",E:"<div class=\"center\">(a) regard, (a) tact, a consideration</div>",D:"PREPOSITIONAL NOUNS",X:"<div class=\"center\"><div class=\"left\">Hensynet til de ansatte er viktig<br><br>Takk for at du viste hensyn</div></div>",A:"N"},{DECK_ID:"C10",ID:"C10027",N:"<div class=\"center\">en tilstand<br><br>tilstanden, tilstander, tilstandene</div>",E:"<div class=\"center\">a condition, a state</div>",D:"PREPOSITIONAL NOUNS",X:"<div class=\"center\"><div class=\"left\">Forhandlingenes tilstand forverret seg<br><br>Dattera hennes ble f\xf8dt med en sjelden tilstand<br><br>Han ble tatt for kj\xf8ring i p\xe5virket tilstand</div></div>",A:"N"},{DECK_ID:"C10",ID:"C10028",N:"<div class=\"center\">et unntak<br><br>unntaket, unntak, unntakene</div>",E:"<div class=\"center\">an exception</div>",D:"PREPOSITIONAL NOUNS",X:"<div class=\"center\"><div class=\"left\">Unntaket som bekrefter regelen<br><br>Alle i klassen, med unntak av \xe9n, ble invitert i bursdag</div></div>",A:"N"},{DECK_ID:"C10",ID:"C10029",N:"<div class=\"center\">et tilsyn<br><br>tilsynet, tilsyn, tilsynene</div>",E:"<div class=\"center\">a control, a surveillance</div>",D:"PREPOSITIONAL NOUNS",X:"<div class=\"center\"><div class=\"left\">Disse selskapene er under tilsyn av Finanstilsynet</div></div>",A:"N"},{DECK_ID:"C10",ID:"C10030",N:"<div class=\"center\">et beslag<br><br>beslaget, beslag, beslagene</div>",E:"<div class=\"center\">a confiscation</div>",D:"PREPOSITIONAL NOUNS",X:"<div class=\"center\"><div class=\"left\">Det siste \xe5ret har det v\xe6rt rekordbeslag av narkotika </div></div>",A:"N"},{DECK_ID:"C11",ID:"C11001",N:"<div class=\"center\">\xe5 unng\xe5<br>unng\xe5r<br>unngikk<br>har unng\xe5tt</div>",E:"<div class=\"center\">to avoid</div>",D:"PREPOSITIONAL VERBS",X:"<div class=\"center\"><div class=\"left\">Hun unng\xe5r \xf8yekontakt<br><br>Han unng\xe5r \xe5 snakke om ulykken</div></div>",A:"N"},{DECK_ID:"C11",ID:"C11002",N:"<div class=\"center\">\xe5 motta<br>mottar<br>mottok<br>har mottatt</div>",E:"<div class=\"center\">to receive</div>",D:"PREPOSITIONAL VERBS",X:"<div class=\"center\"><div class=\"left\">Jeg har ikke mottatt pakken enn\xe5<br><br>De d\xe5rlige nyhetene ble mottatt med sorg</div></div>",A:"N"},{DECK_ID:"C11",ID:"C11003",N:"<div class=\"center\">\xe5 avslutte<br>avslutter<br>avsluttet<br>har avsluttet</div>",E:"<div class=\"center\">to stop, to finish, to settle, to complete</div>",D:"PREPOSITIONAL VERBS",X:"<div class=\"center\"><div class=\"left\">Er det p\xe5 tide \xe5 avslutte forholdet?<br><br>Vi syntes saken var avsluttet<br><br>Kan du avslutte programmet som har hengt seg opp?</div></div>",A:"N"},{DECK_ID:"C11",ID:"C11004",N:"<div class=\"center\">\xe5 tilpasse (seg)<br>tilpasser<br>tilpasset<br>har tilpasset</div>",E:"<div class=\"center\">to adapt (to), to accommodate, <br>to adjust (to)</div>",D:"PREPOSITIONAL VERBS",X:"<div class=\"center\"><div class=\"left\">Den kan v\xe6re vanskelig \xe5 tilpasse seg en ny kultur<br><br>Firmaet skal tilpasse sortimentet etter det kundene vil ha</div></div>",A:"N"},{DECK_ID:"C11",ID:"C11005",N:"<div class=\"center\">\xe5 oppleve<br>opplever<br>opplevde<br>har opplevd</div>",E:"<div class=\"center\">to experience</div>",D:"PREPOSITIONAL VERBS",X:"<div class=\"center\"><div class=\"left\">Det \xe5 v\xe6re innvandrer opplevde jeg som vanskelig i begynnelsen</div></div>",A:"N"},{DECK_ID:"C11",ID:"C11006",N:"<div class=\"center\">\xe5 anta<br>antar<br>antok<br>har antatt</div>",E:"<div class=\"center\">to assume, to suppose</div>",D:"PREPOSITIONAL VERBS",X:"<div class=\"center\"><div class=\"left\">Problemet er st\xf8rre enn vi f\xf8rst antok<br><br>Jeg antar det er varmt p\xe5 Kanari\xf8yene i mars</div></div>",A:"N"},{DECK_ID:"C11",ID:"C11007",N:"<div class=\"center\">\xe5 innse<br>innser<br>inns\xe5<br>har innsett</div>",E:"<div class=\"center\">to realise</div>",D:"PREPOSITIONAL VERBS",X:"<div class=\"center\"><div class=\"left\">Jeg inns\xe5 tabben for sent<br><br>Han har ikke innsett det enn\xe5</div></div>",A:"N"},{DECK_ID:"C11",ID:"C11008",N:"<div class=\"center\">\xe5 ang\xe5<br>ang\xe5r<br>angikk<br>har ang\xe5tt</div>",E:"<div class=\"center\">to concern</div>",D:"PREPOSITIONAL VERBS",X:"<div class=\"center\"><div class=\"left\">Debatten angikk oss alle</div></div>",A:"N"},{DECK_ID:"C11",ID:"C11009",N:"<div class=\"center\">\xe5 uttale<br>uttaler<br>uttalte<br>har uttalt</div>",E:"<div class=\"center\">to pronounce</div>",D:"PREPOSITIONAL VERBS",X:"<div class=\"center\"><div class=\"left\">Hvordan uttaler man navnet ditt?</div></div>",A:"N"},{DECK_ID:"C11",ID:"C11010",N:"<div class=\"center\">\xe5 fors\xf8ke<br>fors\xf8ker<br>fors\xf8kte<br>har fors\xf8kt</div>",E:"<div class=\"center\">to try, to attempt</div>",D:"PREPOSITIONAL VERBS",X:"<div class=\"center\"><div class=\"left\">Tilgang mislyktes, fors\xf8k igjen<br><br>Tyvene fors\xf8kte \xe5 stikke av</div></div>",A:"N"},{DECK_ID:"C11",ID:"C11011",N:"<div class=\"center\">\xe5 tilby (seg)<br>tilbyr<br>tilb\xf8d<br>har tilbudt</div>",E:"<div class=\"center\">to offer, (to put oneself forward)</div>",D:"PREPOSITIONAL VERBS",X:"<div class=\"center\"><div class=\"left\">Vi tilbyr programvarer til Norges laveste priser!<br><br>Hun ofte tilbyr seg \xe5 hjelpe</div></div>",A:"N"},{DECK_ID:"C11",ID:"C11012",N:"<div class=\"center\">\xe5 bidra<br>bidrar<br>bidro(g)<br>har bidratt</div>",E:"<div class=\"center\">to contribute (to/with)</div>",D:"PREPOSITIONAL VERBS",X:"<div class=\"center\"><div class=\"left\">Ekte medier kan ofte bidra til falske nyheter<br><br>Norge bidrar med 10 millioner til de jordskjelvrammede</div></div>",A:"N"},{DECK_ID:"C11",ID:"C11013",N:"<div class=\"center\">\xe5 beskrive<br>beskriver<br>beskrev<br>har beskrevet</div>",E:"<div class=\"center\">to describe</div>",D:"PREPOSITIONAL VERBS",X:"<div class=\"center\"><div class=\"left\">Kan du beskrive det du f\xf8ler?</div></div>",A:"N"},{DECK_ID:"C11",ID:"C11014",N:"<div class=\"center\">\xe5 forsikre<br>forsikrer<br>forsikret<br>har forsikret</div>",E:"<div class=\"center\">to insure, to assure</div>",D:"PREPOSITIONAL VERBS",X:"<div class=\"center\"><div class=\"left\">Det er dyrt \xe5 forsikre bilen<br><br>De forsikret meg at det ikke ville skje igjen</div></div>",A:"N"},{DECK_ID:"C11",ID:"C11015",N:"<div class=\"center\">\xe5 tilgi<br>tilgir<br>tilga(v)<br>har tilgitt</div>",E:"<div class=\"center\">to forgive</div>",D:"PREPOSITIONAL VERBS",X:"<div class=\"center\"><div class=\"left\">Du kan ikke alltid tilgi det vonde noen har gjort mot deg</div></div>",A:"N"},{DECK_ID:"C11",ID:"C11016",N:"<div class=\"center\">\xe5 forandre<br>forandrer<br>forandret<br>har forandret</div>",E:"<div class=\"center\">to alter, to change</div>",D:"PREPOSITIONAL VERBS",X:"<div class=\"center\"><div class=\"left\">Jimi Hendrix forandret gitarmusikk for alltid<br><br>Jeg kommer ikke til \xe5 forandre mening</div></div>",A:"N"},{DECK_ID:"C11",ID:"C11017",N:"<div class=\"center\">\xe5 tilh\xf8re<br>tilh\xf8rer<br>tilh\xf8rte<br>har tilh\xf8rt</div>",E:"<div class=\"center\">to belong to</div>",D:"PREPOSITIONAL VERBS",X:"<div class=\"center\"><div class=\"left\">Jan Mayen er en \xf8y som tilh\xf8rer Norge</div></div>",A:"N"},{DECK_ID:"C11",ID:"C11018",N:"<div class=\"center\">\xe5 anse (for)<br>anser<br>ans\xe5<br>har ansett</div>",E:"<div class=\"center\">to consider (as), to regard (as)</div>",D:"PREPOSITIONAL VERBS",X:"<div class=\"center\"><div class=\"left\">Jeg anser meg selv for \xe5 v\xe6re i god fysisk form<br><br>De anser saken som avsluttet</div></div>",A:"N"},{DECK_ID:"C11",ID:"C11019",N:"<div class=\"center\">\xe5 angripe<br>angriper<br>angrep<br>har angrepet</div>",E:"<div class=\"center\">to assault, to attack</div>",D:"PREPOSITIONAL VERBS",X:"<div class=\"center\"><div class=\"left\">En journalist ble angrepet og skadet i Bergen</div></div>",A:"N"},{DECK_ID:"C11",ID:"C11020",N:"<div class=\"center\">\xe5 anmelde<br>anmelder<br>anmeldte<br>har anmeldt</div>",E:"<div class=\"center\">to report, to denounce</div>",D:"PREPOSITIONAL VERBS",X:"<div class=\"center\"><div class=\"left\">Norsk Friluftsliv vil anmelde akt\xf8rer som krever betaling for \xe5 kunne bruke skil\xf8yper</div></div>",A:"N"},{DECK_ID:"C11",ID:"C11021",N:"<div class=\"center\">\xe5 foresl\xe5<br>foresl\xe5r<br>foreslo<br>har foresl\xe5tt</div>",E:"<div class=\"center\">to propose, to suggest</div>",D:"PREPOSITIONAL VERBS",X:"<div class=\"center\"><div class=\"left\">Kan du foresl\xe5 et nytt tidspunkt for m\xf8tet?</div></div>",A:"N"},{DECK_ID:"C11",ID:"C11022",N:"<div class=\"center\">\xe5 p\xe5virke<br>p\xe5virker<br>p\xe5virket<br>har p\xe5virket</div>",E:"<div class=\"center\">to influence, to affect</div>",D:"PREPOSITIONAL VERBS",X:"<div class=\"center\"><div class=\"left\">Valget ble p\xe5virket av sosiale medier<br><br>Kj\xf8ring i p\xe5virket tilstand er en forbrytelse</div></div>",A:"N"},{DECK_ID:"C11",ID:"C11023",N:"<div class=\"center\">\xe5 avbryte<br>avbryter<br>avbr\xf8t<br>har avbrutt</div>",E:"<div class=\"center\">to cancel, to interrupt</div>",D:"PREPOSITIONAL VERBS",X:"<div class=\"center\"><div class=\"left\">Kan vi avbryte utskriftsjobben?<br><br>Hun avbr\xf8t meg tre ganger i debatten</div></div>",A:"N"},{DECK_ID:"C11",ID:"C11024",N:"<div class=\"center\">\xe5 godkjenne<br>godkjenner<br>godkjente<br>har godkjent</div>",E:"<div class=\"center\">to accept, to authorise, to approve</div>",D:"PREPOSITIONAL VERBS",X:"<div class=\"center\"><div class=\"left\">Kode godkjent<br><br>Senatet i USA godkjente Montenegros NATO-s\xf8knad i fjor</div></div>",A:"N"},{DECK_ID:"C11",ID:"C11025",N:"<div class=\"center\">\xe5 utsette (for)<br>utsetter<br>utsatte<br>har utsatt</div>",E:"<div class=\"center\">to postpone, <br>(to expose to, to be a victim of)</div>",D:"PREPOSITIONAL VERBS",X:"<div class=\"center\"><div class=\"left\">Jeg utsetter alltid \xe5 st\xe5 opp<br><br>Hackere utsatte parlamentet for et cyberangrep p\xe5 torsdag</div></div>",A:"N"},{DECK_ID:"C11",ID:"C11026",N:"<div class=\"center\">\xe5 innr\xf8mme<br>innr\xf8mmer<br>innr\xf8mte<br>har innr\xf8mt</div>",E:"<div class=\"center\">to admit, to acknowledge</div>",D:"PREPOSITIONAL VERBS",X:"<div class=\"center\"><div class=\"left\">Han innr\xf8mte skyld i ulykken</div></div>",A:"N"},{DECK_ID:"C11",ID:"C11027",N:"<div class=\"center\">\xe5 avgj\xf8re<br>avgj\xf8r<br>avgjorde<br>har avgjort</div>",E:"<div class=\"center\">to decide, to resolve</div>",D:"PREPOSITIONAL VERBS",X:"<div class=\"center\"><div class=\"left\">Hvilke faktorer avgj\xf8r om man er lykkelig eller ikke?<br><br>Haaland avgjorde kampen med sitt m\xe5l</div></div>",A:"N"},{DECK_ID:"C11",ID:"C11028",N:"<div class=\"center\">\xe5 p\xe5st\xe5<br>p\xe5st\xe5r<br>p\xe5sto(d)<br>har p\xe5st\xe5tt</div>",E:"<div class=\"center\">to claim</div>",D:"PREPOSITIONAL VERBS",X:"<div class=\"center\"><div class=\"left\">Folk p\xe5st\xe5r at Norge har g\xe5tt i feil retning<br><br>Hun p\xe5stod at hun fikk sparken ulovlig</div></div>",A:"N"},{DECK_ID:"C11",ID:"C11029",N:"<div class=\"center\">\xe5 bevise<br>beviser<br>beviste<br>har bevist</div>",E:"<div class=\"center\">to prove, to show, to demonstrate</div>",D:"PREPOSITIONAL VERBS",X:"<div class=\"center\"><div class=\"left\">Det beviser ingenting<br><br>Dokumentet beviser at du har rett til helsehjelp </div></div>",A:"N"},{DECK_ID:"C11",ID:"C11030",N:"<div class=\"center\">\xe5 tiltrekke<br>tiltrekker<br>tiltrakk<br>har tiltrukket</div>",E:"<div class=\"center\">to attract, to draw</div>",D:"PREPOSITIONAL VERBS",X:"<div class=\"center\"><div class=\"left\">Han tiltrakk seg mye oppmerksomhet<br><br>London tiltrekker mange eiendomsinvestorer</div></div>",A:"N"},{DECK_ID:"C12",ID:"C12001",N:"<div class=\"center\">en sykepleier<br><br>sykepleieren, sykepleiere, sykepleierne</div>",E:"<div class=\"center\">a nurse</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">Behandlingen ble utf\xf8rt av en erfaren sykepleier med mange \xe5rs praksis.</span></p> Bear in mind that, according to the official <span class=\"italic\">bokm\xe5l</span> dictionary, this noun can only be used as <span class=\"italic\">hankj\xf8nn</span>, likely due to its -ER ending.</div></div>",A:"N"},{DECK_ID:"C12",ID:"C12002",N:"<div class=\"center\">et luftr\xf8r<br><br>luftr\xf8ret, luftr\xf8r, luftr\xf8rene</div>",E:"<div class=\"center\">a trachea (windpipe)</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\">En alvorlig infeksjon i luftr\xf8ret kan f\xf8re til pustevansker.</div></div>",A:"N"},{DECK_ID:"C12",ID:"C12003",N:"<div class=\"center\">livstruende<br>livstruende, livstruende<br>mer livstruende, mest livstruende</div>",E:"<div class=\"center\">life-threatening</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\">En kraftig allergisk reaksjon kan v\xe6re livstruende uten rask medisinsk hjelp.</div></div>",A:"N"},{DECK_ID:"C12",ID:"C12004",N:"<div class=\"center\">Kan du puste dypt inn og ut?</div>",E:"<div class=\"center\">Can you take a deep breath, in and out?</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\">We have included a number of listening exercises in this topic, based on sentences that you are likely to hear or speak in a medical environment.</div></div>",A:"N"},{DECK_ID:"C12",ID:"C12005",N:"<div class=\"center\">\xe5 overv\xe5ke<br>overv\xe5ker<br>overv\xe5ket<br>har overv\xe5ket</div>",E:"<div class=\"center\">to monitor</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\">Legene overv\xe5ker pasientens hjertefrekvens etter operasjonen.</div></div>",A:"N"},{DECK_ID:"C12",ID:"C12006",N:"<div class=\"center\"><p>(et) blodtrykk</p> blodtrykket</div>",E:"<div class=\"center\">(a) blood pressure</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\"><p><span class=\"italic\">H\xf8yt blodtrykk kan \xf8ke risikoen for hjerneslag og hjerteinfarkt.</span></p> Nouns such as this are unlikely to be used in the plural, but we have included the indefinite article so that you can work on remembering their gender, which is needed for the definite singular version of it anyway.</div></div>",A:"N"},{DECK_ID:"C12",ID:"C12007",N:"<div class=\"center\">en legevakt<br><br>legevakten, legevakter, legevaktene</div>",E:"<div class=\"center\"><p>an emergency room (ER)</p>accident & emergency (A&E)</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\">A <span class=\"italic\">legevakt</span> (literally \"doctor guard/warden\") is an out-of-hours doctor service that is usually not part of a hospital.</span></div></div>",A:"N"},{DECK_ID:"C12",ID:"C12008",N:"<div class=\"center\">Vennligst ta en k\xf8lapp og sett deg i venterommet.</div>",E:"<div class=\"center\">Please take a ticket and sit in the waiting room.</div>",D:"HEALTH & MEDICINE",X:"",A:"N"},{DECK_ID:"C12",ID:"C12009",N:"<div class=\"center\">bevisstl\xf8s<br>bevisstl\xf8st, bevisstl\xf8se<br>mer bevisstl\xf8s, mest bevisstl\xf8s</div>",E:"<div class=\"center\">unconscious</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\">Pasienten ble funnet bevisstl\xf8s og ble raskt fraktet til akuttmottaket.</div></div>",A:"N"},{DECK_ID:"C12",ID:"C12010",N:"<div class=\"center\">HIV / AIDS</div>",E:"<div class=\"center\">HIV/AIDS</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\">Familiarise yourself with how the acronyms for the Human Immunodeficiency Virus and for the Acquired Immunodeficiency Syndrome are pronounced in Norwegian.</div></div>",A:"N"},{DECK_ID:"C12",ID:"C12011",N:"<div class=\"center\">\xe5 gj\xf8re vondt<br>gj\xf8r vondt<br>gjorde vondt<br>har gjort vondt</div>",E:"<div class=\"center\">to hurt, to be painful</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\">Si fra hvis det begynner \xe5 gj\xf8re mer vondt.</div></div>",A:"N"},{DECK_ID:"C12",ID:"C12012",N:"<div class=\"center\">et akuttmottak<br><br>akuttmottaket, akuttmottak, akuttmottakene</div>",E:"<div class=\"center\">an emergency department</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\">The <span class=\"italic\">akuttmottak</span> is the ER (emergency room) or A&E (accident & emergency), usually part of a broader hospital.</span></div></div>",A:"N"},{DECK_ID:"C12",ID:"C12013",N:"<div class=\"center\">G\xe5r det greit med spr\xf8yter?</div>",E:"<div class=\"center\">Are you ok with needles?</div>",D:"HEALTH & MEDICINE",X:"",A:"N"},{DECK_ID:"C12",ID:"C12014",N:"<div class=\"center\">\xe5 m\xe5le blodtrykk<br>m\xe5ler blodtrykk<br>m\xe5lte blodtrykk<br>har m\xe5lt blodtrykk</div>",E:"<div class=\"center\">to measure blood pressure</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\">Legen ba pasienten om \xe5 slappe av i fem minutter f\xf8r han begynte \xe5 m\xe5le blodtrykket.</div></div>",A:"N"},{DECK_ID:"C12",ID:"C12015",N:"<div class=\"center\"><p>pustevansker</p> pustevanskene</div>",E:"<div class=\"center\">breathing difficulties</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\">Astma kan f\xf8re til pustevansker, spesielt under anstrengelse.</div></div>",A:"N"},{DECK_ID:"C12",ID:"C12016",N:"<div class=\"center\">et hjerteinfarkt<br><br>hjerteinfarktet, hjerteinfarkt, hjerteinfarktene</div>",E:"<div class=\"center\">a heart attack</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\">Siden moren min har hatt et hjerteinfarkt, m\xe5 hun ta medisiner for \xe5 forebygge et nytt.</div></div>",A:"N"},{DECK_ID:"C12",ID:"C12017",N:"<div class=\"center\">Hvordan f\xf8ler du deg?</div>",E:"<div class=\"center\">How do you feel?</div>",D:"HEALTH & MEDICINE",X:"",A:"N"},{DECK_ID:"C12",ID:"C12018",N:"<div class=\"center\">smertefull<br>smertefullt, smertefulle<br>mer smertefull, mest smertefull</div>",E:"<div class=\"center\">painful</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\">Dette er en smertefull prosedyre, men vi gir deg lokalbed\xf8velse.</div></div>",A:"N"},{DECK_ID:"C12",ID:"C12019",N:"<div class=\"center\">et hjerneslag<br><br>hjerneslaget, hjerneslag, hjerneslagene</div>",E:"<div class=\"center\">a stroke</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\">Onkelen min fikk et hjerneslag, og vi m\xe5tte l\xe6re oss hvordan vi kunne hjelpe ham hjemme.</div></div>",A:"N"},{DECK_ID:"C12",ID:"C12020",N:"<div class=\"center\">et blodsukkerniv\xe5<br><br>blodsukkerniv\xe5et, blodsukkerniv\xe5, blodsukkerniv\xe5ene</div>",E:"<div class=\"center\">a blood sugar level</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\">Et ustabilt blodsukkerniv\xe5 kan f\xf8re til alvorlige komplikasjoner for personer med diabetes.</div></div>",A:"N"},{DECK_ID:"C12",ID:"C12021",N:"<div class=\"center\">\xe5 henvise<br>henviser<br>henviste<br>har henvist</div>",E:"<div class=\"center\">to refer (to a specialist)</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\">Pasienten ble henvist til sykehuset for en grundigere unders\xf8kelse.</div></div>",A:"N"},{DECK_ID:"C12",ID:"C12022",N:"<div class=\"center\">Hvor har du vondt?</div>",E:"<div class=\"center\">Where does it hurt?</div>",D:"HEALTH & MEDICINE",X:"",A:"N"},{DECK_ID:"C12",ID:"C12023",N:"<div class=\"center\">en mandel<br><br>mandelen, mandler, mandlene</div>",E:"<div class=\"center\">a tonsil</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\">Barn med kroniske halsbetennelser f\xe5r ofte fjernet mandlene kirurgisk.</div></div>",A:"N"},{DECK_ID:"C12",ID:"C12024",N:"<div class=\"center\">smittsom<br>smittsomt, smittsomme<br>mer smittsom, mest smittsom</div>",E:"<div class=\"center\">contagious</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\">Noen bakterielle infeksjoner er mindre smittsomme enn virussykdommer.</div></div>",A:"N"},{DECK_ID:"C12",ID:"C12025",N:"<div class=\"center\">en/ei avdeling<br><br>avdelingen/avdelinga, avdelinger, avdelingene</div>",E:"<div class=\"center\">a department</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\">Sykehuset har en spesialisert avdeling for hjertepasienter.</div></div>",A:"N"},{DECK_ID:"C12",ID:"C12026",N:"<div class=\"center\">Har du noen allergier?</div>",E:"<div class=\"center\">Do you have any allergies?</div>",D:"HEALTH & MEDICINE",X:"",A:"N"},{DECK_ID:"C12",ID:"C12027",N:"<div class=\"center\"><p>(en) bl\xf8dning</p> bl\xf8dningen</div>",E:"<div class=\"center\">(a) bleeding</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\">Kirurgen klarte \xe5 stoppe bl\xf8dningen under operasjonen.</div></div>",A:"N"},{DECK_ID:"C12",ID:"C12028",N:"<div class=\"center\">en lege<br><br>legen, leger, legene</div>",E:"<div class=\"center\">a doctor</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\">Legen forklarte hvordan medisinen skulle tas for best effekt.</div></div>",A:"N"},{DECK_ID:"C12",ID:"C12029",N:"<div class=\"center\">en/ei intensivavdeling<br><br>intensivavdelingen/intensivavdelinga, intensivavdelinger, intensivavdelingene</div>",E:"<div class=\"center\">an intensive care unit (ICU)</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\">Pasienten ble lagt inn p\xe5 intensivavdelingen etter operasjonen.</div></div>",A:"N"},{DECK_ID:"C12",ID:"C12030",N:"<div class=\"center\">Gj\xf8r det vondt her?</div>",E:"<div class=\"center\">Does it hurt here?</div>",D:"HEALTH & MEDICINE",X:"",A:"N"},{DECK_ID:"C12",ID:"C12031",N:"<div class=\"center\"><p>(en) hud</p> huden</div>",E:"<div class=\"center\">(a) skin</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\">Hudsykdommer som eksem og psoriasis krever spesialbehandling.</div></div>",A:"N"},{DECK_ID:"C12",ID:"C12032",N:"<div class=\"center\">en/ei lunge<br><br>lungen/lunga, lunger, lungene</div>",E:"<div class=\"center\">a lung</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\">Vi ser en infeksjon i den h\xf8yre lungen din, s\xe5 vi starter antibiotika med en gang.</div></div>",A:"N"},{DECK_ID:"C12",ID:"C12033",N:"<div class=\"center\">en mage<br><br>magen, mager, magene</div>",E:"<div class=\"center\">a stomach</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\">Ultralyden viser ingen tegn til bl\xf8dning i magen, men vi holder deg til observasjon.</div></div>",A:"N"},{DECK_ID:"C12",ID:"C12034",N:"<div class=\"center\">Jeg skal sende en henvisning til en spesialist.</div>",E:"<div class=\"center\">I will send a referral to a specialist.</div>",D:"HEALTH & MEDICINE",X:"",A:"N"},{DECK_ID:"C12",ID:"C12035",N:"<div class=\"center\">et slag per minutt<br><br>slaget per minutt, slag per minutt</div>",E:"<div class=\"center\">a beat per minute</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\">Pulsen din ligger p\xe5 85 slag per minutt, som er innenfor normalen.</div></div>",A:"N"},{DECK_ID:"C12",ID:"C12036",N:"<div class=\"center\">en ryggrad<br><br>ryggraden, ryggrader, ryggradene</div>",E:"<div class=\"center\">a spine</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\">Ryggraden din ser fin ut p\xe5 r\xf8ntgen, men vi anbefaler fysioterapi for smertene.</div></div>",A:"N"},{DECK_ID:"C12",ID:"C12037",N:"<div class=\"center\">\xe5 forverre<br>forverrer<br>forverret<br>har forverret</div>",E:"<div class=\"center\">to worsen</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\">Unng\xe5 tunge l\xf8ft, ellers kan du forverre tilstanden.</div></div>",A:"N"},{DECK_ID:"C12",ID:"C12038",N:"<div class=\"center\">en streptokokkinfeksjon<br><br>streptokokkinfeksjonen, streptokokkinfeksjoner, streptokokkinfeksjonene</div>",E:"<div class=\"center\">a strep infection</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\">Hvis du har tilbakevendende streptokokkinfeksjoner, kan vi vurdere \xe5 fjerne mandlene.</div></div>",A:"N"},{DECK_ID:"C12",ID:"C12039",N:"<div class=\"center\">en resept<br><br>resepten, resepter, reseptene</div>",E:"<div class=\"center\">a prescription</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\">Denne medisinen er reseptbelagt, s\xe5 du m\xe5 f\xe5 en ny resept av legen f\xf8rst.</div></div>",A:"N"},{DECK_ID:"C12",ID:"C12040",N:"<div class=\"center\">Hvem er din n\xe6rmeste p\xe5r\xf8rende?</div>",E:"<div class=\"center\">Who is your next of kin?</div>",D:"HEALTH & MEDICINE",X:"",A:"N"},{DECK_ID:"C12",ID:"C12041",N:"<div class=\"center\">et r\xf8ntgen<br><br>r\xf8ntgenet</div>",E:"<div class=\"center\">an X-ray</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\">Vi tar et r\xf8ntgen av foten din for \xe5 sjekke om det er brudd.</div></div>",A:"N"},{DECK_ID:"C12",ID:"C12042",N:"<div class=\"center\">en blodpr\xf8ve<br><br>blodpr\xf8ven, blodpr\xf8ver, blodpr\xf8vene</div>",E:"<div class=\"center\">a blood test</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\">Blodpr\xf8ven viser at jernniv\xe5et ditt er litt lavt.</div></div>",A:"N"},{DECK_ID:"C12",ID:"C12043",N:"<div class=\"center\">en spr\xf8yte<br><br>spr\xf8yten, spr\xf8yter, spr\xf8ytene</div>",E:"<div class=\"center\">a syringe</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\">Barnet gruet seg litt til spr\xf8yten, men det gikk helt fint.</div></div>",A:"N"},{DECK_ID:"C12",ID:"C12044",N:"<div class=\"center\">(en) gips<br><br>gipsen</div>",E:"<div class=\"center\">a cast</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\">Barnet var nerv\xf8st for \xe5 f\xe5 gips, men vi forklarte at det ikke ville gj\xf8re vondt.</div></div>",A:"N"},{DECK_ID:"C12",ID:"C12045",N:"<div class=\"center\">Vi m\xe5 m\xe5le blodtrykket ditt.</div>",E:"<div class=\"center\">We need to measure your blood pressure.</div>",D:"HEALTH & MEDICINE",X:"",A:"N"},{DECK_ID:"C12",ID:"C12046",N:"<div class=\"center\">\xe5 injisere<br>injiserer<br>injiserte<br>har injisert</div>",E:"<div class=\"center\">to inject</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\">Har du f\xe5tt injisert denne typen medisin f\xf8r?</div></div>",A:"N"},{DECK_ID:"C12",ID:"C12047",N:"<div class=\"center\">\xe5 desinfisere<br>desinfiserer<br>desinfiserte<br>har desinfisert</div>",E:"<div class=\"center\">to disinfect</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\">Husk \xe5 desinfisere hendene f\xf8r du setter spr\xf8yten.</div></div>",A:"N"},{DECK_ID:"C12",ID:"C12048",N:"<div class=\"center\">\xe5 gipse<br>gipser<br>gipset<br>har gipset</div>",E:"<div class=\"center\">to put in a cast</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\">Vi m\xe5 gipse armen din for \xe5 stabilisere bruddet.</div></div>",A:"N"},{DECK_ID:"C12",ID:"C12049",N:"<div class=\"center\">\xe5 bandasjere<br>bandasjerer<br>bandasjerte<br>har bandasjert</div>",E:"<div class=\"center\">to bandage</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\">Kan du hjelpe meg med \xe5 bandasjere foten? Jeg klarer det ikke selv.</div></div>",A:"N"},{DECK_ID:"C12",ID:"C12050",N:"<div class=\"center\">Hva er blodtypen din?</div>",E:"<div class=\"center\">What is your blood type?</div>",D:"HEALTH & MEDICINE",X:"",A:"N"},{DECK_ID:"C12",ID:"C12051",N:"<div class=\"center\">\xe5 gi medisin<br>gir medisin<br>gav medisin<br>har gitt medisin</div>",E:"<div class=\"center\">to administer medicine</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\">Jeg gir medisinen intraven\xf8st siden pasienten ikke klarer \xe5 svelge tabletter.</div></div>",A:"N"},{DECK_ID:"C12",ID:"C12052",N:"<div class=\"center\">en n\xf8dsituasjon<br><br>n\xf8dsituasjonen, n\xf8dsituasjoner, n\xf8dsituasjonene</div>",E:"<div class=\"center\">an emergency</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\">Vet du hvem jeg skal kontakte i en n\xf8dsituasjon?</div></div>",A:"N"},{DECK_ID:"C12",ID:"C12053",N:"<div class=\"center\">\xe5 unders\xf8ke<br>unders\xf8ker<br>unders\xf8kte<br>har unders\xf8kt</div>",E:"<div class=\"center\">to examine</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\">Vi b\xf8r unders\xf8ke dette n\xe6rmere med en MR-unders\xf8kelse.</div></div>",A:"N"},{DECK_ID:"C12",ID:"C12054",N:"<div class=\"center\">en hjerne<br><br>hjernen, hjerner, hjernene</div>",E:"<div class=\"center\">a brain</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\">En skade p\xe5 hjernen kan p\xe5virke b\xe5de bevegelse og spr\xe5k.</div></div>",A:"N"},{DECK_ID:"C12",ID:"C12055",N:"<div class=\"center\">Jeg skal ta en blodpr\xf8ve n\xe5.</div>",E:"<div class=\"center\">I will take a blood test now.</div>",D:"HEALTH & MEDICINE",X:"",A:"N"},{DECK_ID:"C12",ID:"C12056",N:"<div class=\"center\">et hjerte<br><br>hjertet, hjerter, hjertene</div>",E:"<div class=\"center\">a heart</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\">Pasienten klaget over brystsmerter, s\xe5 vi sjekker hjertet med en gang.</div></div>",A:"N"},{DECK_ID:"C12",ID:"C12057",N:"<div class=\"center\">\xe5 bl\xf8<br>bl\xf8r<br>bl\xf8dde<br>har bl\xf8dd</div>",E:"<div class=\"center\">to bleed</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\">Hvis det fortsetter \xe5 bl\xf8, m\xe5 vi sy s\xe5ret.</div></div>",A:"N"},{DECK_ID:"C12",ID:"C12058",N:"<div class=\"center\">en pasient<br><br>pasienten, pasienter, pasientene</div>",E:"<div class=\"center\">a patient</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\">Har pasienten f\xe5tt medisinen sin i dag?</div></div>",A:"N"},{DECK_ID:"C12",ID:"C12059",N:"<div class=\"center\">et sykehus<br><br>sykehuset, sykehus, sykehusene</div>",E:"<div class=\"center\">a hospital</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\">Hvilket sykehus ble han kj\xf8rt til etter ulykken?</div></div>",A:"N"},{DECK_ID:"C12",ID:"C12060",N:"<div class=\"center\">Du m\xe5 faste f\xf8r denne testen.</div>",E:"<div class=\"center\">You need to fast before this test.</div>",D:"HEALTH & MEDICINE",X:"",A:"N"},{DECK_ID:"C12",ID:"C12061",N:"<div class=\"center\">en fastlege<br><br>fastlegen, fastleger, fastlegene</div>",E:"<div class=\"center\">a general practitioner (GP)</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\">Fastlegen kan henvise deg til en spesialist om n\xf8dvendig.</div></div>",A:"N"},{DECK_ID:"C12",ID:"C12062",N:"<div class=\"center\">hovent<br>hovent, hovne<br>mer hovent, mest hovent</div>",E:"<div class=\"center\">swollen</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\">Foten din er veldig hoven, har du skadet deg?</div></div>",A:"N"},{DECK_ID:"C12",ID:"C12063",N:"<div class=\"center\">betent<br>betent, betente<br>mer betent, mest betent</div>",E:"<div class=\"center\">inflamed</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\">Du har en betent akillessene, s\xe5 vi m\xe5 redusere belastningen.</div></div>",A:"N"},{DECK_ID:"C12",ID:"C12064",N:"<div class=\"center\">infisert<br>infisert, infiserte<br>mer infisert, mest infisert</div>",E:"<div class=\"center\">infected</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\">Hvis s\xe5ret blir r\xf8dt, varmt og hovent, kan det bety at det er infisert.</div></div>",A:"N"},{DECK_ID:"C12",ID:"C12065",N:"<div class=\"center\">Vennligst ta av deg toppen/skjorten.</div>",E:"<div class=\"center\">Please take your top (or shirt) off.</div>",D:"HEALTH & MEDICINE",X:"",A:"N"},{DECK_ID:"C12",ID:"C12066",N:"<div class=\"center\"><p>(en) matforgiftning</p> matforgiftningen</div>",E:"<div class=\"center\">(a) food poisoning</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\">Matforgiftning g\xe5r som regel over av seg selv, men hold deg hydrert.</div></div>",A:"N"},{DECK_ID:"C12",ID:"C12067",N:"<div class=\"center\">en infeksjon<br><br>infeksjonen, infeksjoner, infeksjonene</div>",E:"<div class=\"center\">an infection</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\">Pasienten har en alvorlig infeksjon og trenger antibiotika umiddelbart.</div></div>",A:"N"},{DECK_ID:"C12",ID:"C12068",N:"<div class=\"center\"><p>(en) sepsis</p> sepsisen</div>",E:"<div class=\"center\">(a) sepsis</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\">Sepsis er en alvorlig tilstand som krever rask behandling.</div></div>",A:"N"},{DECK_ID:"C12",ID:"C12069",N:"<div class=\"center\">en puls<br><br>pulsen</div>",E:"<div class=\"center\">a pulse</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\">Hvis pulsen blir uregelmessig, b\xf8r vi gj\xf8re en EKG.</div></div>",A:"N"},{DECK_ID:"C12",ID:"C12070",N:"<div class=\"center\">Bruker du noen faste medisiner?</div>",E:"<div class=\"center\">Do you take any regular medications?</div>",D:"HEALTH & MEDICINE",X:"",A:"N"},{DECK_ID:"C12",ID:"C12071",N:"<div class=\"center\">(en) hjertefrekvens<br><br>hjertefrekvensen</div>",E:"<div class=\"center\">a heart rate</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\">Vi m\xe5ler hjertefrekvensen for \xe5 se hvordan hjertet jobber under belastning.</div></div>",A:"N"},{DECK_ID:"C12",ID:"C12072",N:"<div class=\"center\">(en) kusma<br><br>kusmaen</div>",E:"<div class=\"center\">mumps</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\">Har du hatt kusma f\xf8r, eller er du vaksinert?</div></div>",A:"N"},{DECK_ID:"C12",ID:"C12073",N:"<div class=\"center\">r\xf8de hunder<br><br>r\xf8de hundene</div>",E:"<div class=\"center\">rubella</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\">Vaksinasjon har nesten utryddet r\xf8de hunder i mange land.</div></div>",A:"N"},{DECK_ID:"C12",ID:"C12074",N:"<div class=\"center\"><p>vannkopper</p> vannkoppene</div>",E:"<div class=\"center\">chickenpox</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\">Hvis du f\xe5r vannkopper som voksen, kan det bli mer alvorlig.</div></div>",A:"N"},{DECK_ID:"C12",ID:"C12075",N:"<div class=\"center\">N\xe5r begynte symptomene dine?</div>",E:"<div class=\"center\">When did your symptoms start?</div>",D:"HEALTH & MEDICINE",X:"",A:"N"},{DECK_ID:"C12",ID:"C12076",N:"<div class=\"center\">meslinger<br><br>meslingene</div>",E:"<div class=\"center\">measles</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\">Meslinger kan gi alvorlige komplikasjoner, spesielt hos sm\xe5 barn.</div></div>",A:"N"},{DECK_ID:"C12",ID:"C12077",N:"<div class=\"center\">(en) skarlagensfeber<br><br>skarlagensfeberen</div>",E:"<div class=\"center\">scarlet fever</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\">Skarlagensfeber gir ofte s\xe5r hals og r\xf8dt utslett.</div></div>",A:"N"},{DECK_ID:"C12",ID:"C12078",N:"<div class=\"center\">en smerte<br><br>smerte, smerter, smertene</div>",E:"<div class=\"center\">a pain</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\">Hvis smerten blir verre, kan vi justere medisindosen.</div></div>",A:"N"},{DECK_ID:"C12",ID:"C12079",N:"<div class=\"center\"><p>(en) epilepsi</p> epilepsien</div>",E:"<div class=\"center\">(an) epilepsy</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\">Pasienten fikk et epileptisk anfall, vi m\xe5 overv\xe5ke ham videre.</div></div>",A:"N"},{DECK_ID:"C12",ID:"C12080",N:"<div class=\"center\">Du m\xe5 ta denne medisinen hver dag.</div>",E:"<div class=\"center\">You must take this medicine every day.</div>",D:"HEALTH & MEDICINE",X:"",A:"N"},{DECK_ID:"C12",ID:"C12081",N:"<div class=\"center\">(en) kreft<br><br>kreften</div>",E:"<div class=\"center\">a cancer</div>",D:"HEALTH & MEDICINE",X:"<div class=\"center\"><div class=\"left\">Tidlig oppdagelse av kreft \xf8ker sjansene for vellykket behandling.</div></div>",A:"N"},{DECK_ID:"C12",ID:"C12082",N:"<div class=\"center\">et hode<br><br>hodet, hoder, hodene</div>",E:"<div class=\"center\">a head</div>",D:"HEALTH & MEDICINE",X:"",A:"N"},{DECK_ID:"C12",ID:"C12083",N:"<div class=\"center\">en/ei unders\xf8kelse<br><br>unders\xf8kelsen/unders\xf8kelsa, unders\xf8kelser, unders\xf8kelsene</div>",E:"<div class=\"center\">an examination</div>",D:"HEALTH & MEDICINE",X:"",A:"N"},{DECK_ID:"C12",ID:"C12084",N:"<div class=\"center\">\xe5 behandle<br>behandler<br>behandlet<br>har behandlet</div>",E:"<div class=\"center\">to treat</div>",D:"HEALTH & MEDICINE",X:"",A:"N"},{DECK_ID:"C12",ID:"C12085",N:"<div class=\"center\">Jeg skal forklare behandlingsplanen din.</div>",E:"<div class=\"center\">I will explain your treatment plan.</div>",D:"HEALTH & MEDICINE",X:"",A:"N"},{DECK_ID:"C12",ID:"C12086",N:"<div class=\"center\">akutt<br>akutt, akutte<br>mer akutt, mest akutt</div>",E:"<div class=\"center\">acute</div>",D:"HEALTH & MEDICINE",X:"",A:"N"},{DECK_ID:"C12",ID:"C12087",N:"<div class=\"center\">en/ei behandling<br><br>behandlingen/behandlinga, behandlinger, behandlingene</div>",E:"<div class=\"center\">a treatment</div>",D:"HEALTH & MEDICINE",X:"",A:"N"},{DECK_ID:"C12",ID:"C12088",N:"<div class=\"center\">\xe5 smitte<br>smitter<br>smitet<br>har smittet</div>",E:"<div class=\"center\">to infect / transmit</div>",D:"HEALTH & MEDICINE",X:"",A:"N"},{DECK_ID:"C12",ID:"C12089",N:"<div class=\"center\">mild<br>mildt, milde<br>mildere, mildest</div>",E:"<div class=\"center\">mild</div>",D:"HEALTH & MEDICINE",X:"",A:"N"},{DECK_ID:"C12",ID:"C12090",N:"<div class=\"center\">\xe5 puste<br>puster<br>pustet<br>har pustet</div>",E:"<div class=\"center\">to breathe</div>",D:"HEALTH & MEDICINE",X:"",A:"N"},{DECK_ID:"C12",ID:"C12091",N:"<div class=\"center\">Du kan kle p\xe5 deg n\xe5.</div>",E:"<div class=\"center\">You can get dressed now.</div>",D:"HEALTH & MEDICINE",X:"",A:"N"},{DECK_ID:"C12",ID:"C12092",N:"<div class=\"center\">moderat<br>moderat, moderate<br>mer moderat, mest moderat</div>",E:"<div class=\"center\">moderate</div>",D:"HEALTH & MEDICINE",X:"",A:"N"},{DECK_ID:"C12",ID:"C12093",N:"<div class=\"center\">et bein<br><br>beinet, bein, beina</div>",E:"<div class=\"center\">a bone</div>",D:"HEALTH & MEDICINE",X:"",A:"N"},{DECK_ID:"C12",ID:"C12094",N:"<div class=\"center\">\xf8m<br>\xf8mt, \xf8mme<br>mer \xf8m, mest \xf8m</div>",E:"<div class=\"center\">tender</div>",D:"HEALTH & MEDICINE",X:"",A:"N"},{DECK_ID:"C12",ID:"C12095",N:"<div class=\"center\">\xe5 besvime<br>besvimer<br>besvimte<br>har besvimt</div>",E:"<div class=\"center\">to faint</div>",D:"HEALTH & MEDICINE",X:"",A:"N"},{DECK_ID:"C12",ID:"C12096",N:"<div class=\"center\">Har du hatt noen tidligere operasjoner?</div>",E:"<div class=\"center\">Have you had any previous surgeries?</div>",D:"HEALTH & MEDICINE",X:"",A:"N"},{DECK_ID:"C12",ID:"C12097",N:"<div class=\"center\">nummen<br>nummert, numne<br>mer nummen, mest nummen</div>",E:"<div class=\"center\">numb</div>",D:"HEALTH & MEDICINE",X:"",A:"N"},{DECK_ID:"C12",ID:"C12098",N:"<div class=\"center\">svimmel<br>svimmelt, svimle<br>mer svimmel, mest svimmel</div>",E:"<div class=\"center\">dizzy</div>",D:"HEALTH & MEDICINE",X:"",A:"N"},{DECK_ID:"C12",ID:"C12099",N:"<div class=\"center\">kvalm<br>kvalmt, kvalme<br>kvalmere, kvalmest</div>",E:"<div class=\"center\">nauseous</div>",D:"HEALTH & MEDICINE",X:"",A:"N"},{DECK_ID:"C12",ID:"C12100",N:"<div class=\"center\">en klinikk<br><br>klinikken, klinikker, klinikkene</div>",E:"<div class=\"center\">a clinic</div>",D:"HEALTH & MEDICINE",X:"",A:"N"},{DECK_ID:"C12",ID:"C12101",N:"<div class=\"center\">en graviditetstest<br><br>graviditetstesten, graviditetstester, graviditetstestene</div>",E:"<div class=\"center\">a pregnancy test</div>",D:"HEALTH & MEDICINE",